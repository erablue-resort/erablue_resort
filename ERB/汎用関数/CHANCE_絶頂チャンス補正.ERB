;=====================================================================
; 絶頂チャンス補正（仕様変更サンプル）
;   前ターンに絶頂させた相手の「マイナス補正」を一定割合カットするための
;   カット率計算のみを提供する。
;   実際の相殺（マイナス補正の積算と適用）は COM353_SUB(ARG) 内で行う。
;   → 補正を他ERBに重複して置かないこと。
;
;   カット率 = 50% + 5%*(絶頂部位数-1) + 5%*(強絶頂だった部位数)   (上限95%)
;   対象部位 : C / B / V / A / S の5部位限定
;   強絶頂   : 前ターン○絶頂 >= 2 （超強絶対以上も強絶対として1回だけ加算）
;=====================================================================


;---------------------------------------------------------------------
; 前ターンに絶頂した CBVAS 部位数
;---------------------------------------------------------------------
@絶頂チャンス_部位数(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 計
計 = 0
SIF TCVAR:対象キャラ:前ターンＣ絶頂 > 0
	計 ++
SIF TCVAR:対象キャラ:前ターンＢ絶頂 > 0
	計 ++
SIF TCVAR:対象キャラ:前ターンＶ絶頂 > 0
	計 ++
SIF TCVAR:対象キャラ:前ターンＡ絶頂 > 0
	計 ++
SIF TCVAR:対象キャラ:前ターンＳ絶頂 > 0
	計 ++
RETURNF 計

;---------------------------------------------------------------------
; 前ターンに「強絶頂以上」だった CBVAS 部位数
;---------------------------------------------------------------------
@絶頂チャンス_強部位数(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 計
計 = 0
SIF TCVAR:対象キャラ:前ターンＣ絶頂 >= 2
	計 ++
SIF TCVAR:対象キャラ:前ターンＢ絶頂 >= 2
	計 ++
SIF TCVAR:対象キャラ:前ターンＶ絶頂 >= 2
	計 ++
SIF TCVAR:対象キャラ:前ターンＡ絶頂 >= 2
	計 ++
SIF TCVAR:対象キャラ:前ターンＳ絶頂 >= 2
	計 ++
RETURNF 計

;---------------------------------------------------------------------
; カット率(%)  部位なしは0
;---------------------------------------------------------------------
@絶頂チャンス_カット率(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 部
#DIM 強
部 = 絶頂チャンス_部位数(対象キャラ)
SIF 部 <= 0
	RETURNF 0
強 = 絶頂チャンス_強部位数(対象キャラ)
RETURNF MIN(95, 50 + 5 * (部 - 1) + 5 * 強)

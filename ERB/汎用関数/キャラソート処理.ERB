;---------------------------------------------------------
;ソート用情報取得関数 出典ソート値取得
;---------------------------------------------------------
@ソート値取得_出典(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 出典ソート値リスト, キャラクタ数上限
#DIM CHARANUM記憶

IF CHARANUM > CHARANUM記憶
	;キャラ数が増えたら出典順リストを更新する
	CHARANUM記憶 = CHARANUM
	CALLF 出典ソート値リスト更新(出典ソート値リスト)
ENDIF

RETURNF 出典ソート値リスト:対象キャラ


;---------------------------------------------------------
;ソート用情報取得関数 出典ソート値用のリスト更新
;---------------------------------------------------------
@出典ソート値リスト更新(出典ソート値リスト)
#FUNCTION
#DIM  REF 出典ソート値リスト
#DIMS DYNAMIC 出典名リスト    , キャラクタ数上限
#DIM  DYNAMIC キャラ番号リスト, キャラクタ数上限
#DIMS 前回出典名
#DIM  出典順位
#DIM  キャラ番号
#DIM  L_CNT

;出典名を文字列順に並べ、同じ出典には同じ順位を割り当てる
VARSET 出典ソート値リスト
FOR キャラ番号, 0, CHARANUM
	出典名リスト:キャラ番号 '= ソート用出典名取得(キャラ番号)
	キャラ番号リスト:キャラ番号 = キャラ番号
NEXT
ARRAYMSORT 出典名リスト, キャラ番号リスト

出典順位 = -1
FOR L_CNT, 0, CHARANUM
	IF L_CNT == 0 || 出典名リスト:L_CNT != 前回出典名
		出典順位 ++
		前回出典名 '= 出典名リスト:L_CNT
	ENDIF
	キャラ番号 = キャラ番号リスト:L_CNT
	出典ソート値リスト:キャラ番号 = 出典順位
NEXT
RETURNF 0


;---------------------------------------------------------
;ソート用情報取得関数 呼び名ソート値用のリスト更新
;---------------------------------------------------------
@呼び名ソート値リスト更新(呼び名ソート値リスト)
#FUNCTION
#DIM  REF 呼び名ソート値リスト
#DIMS DYNAMIC 呼び名リスト    , キャラクタ数上限
#DIM  DYNAMIC キャラ番号リスト, キャラクタ数上限
#DIM  キャラ番号
#DIM  L_CNT

;全キャラを呼び名でソートした順番をリストに保存して使用
VARSET 呼び名ソート値リスト
FOR キャラ番号, 0, CHARANUM
	;同名キャラがキャラ番号順に並ぶように名前の後ろにキャラ番号を付与
	呼び名リスト:キャラ番号 '= @"%CALLNAME:キャラ番号%_%TOSTR(キャラ番号, "0000")%}"
	キャラ番号リスト:キャラ番号 = キャラ番号
NEXT
ARRAYMSORT 呼び名リスト, キャラ番号リスト

FOR L_CNT, 0, CHARANUM
	キャラ番号 = キャラ番号リスト:L_CNT
	呼び名ソート値リスト:キャラ番号 = L_CNT
NEXT
RETURNF 0

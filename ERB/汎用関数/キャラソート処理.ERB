;---------------------------------------------------------
;ソート情報登録
;---------------------------------------------------------
@ソート情報登録(キャラ番号, 登録番号 = 0)
#FUNCTION
#DIM キャラ番号
#DIM 登録番号
#DIM ソート順
#DIM ソート値

;ソート順 = 1
;ソート処理
;SIF キャラ一覧ソート:登録番号 == ""
;	RETURNF 0

IF STRCOUNT(キャラ一覧ソート:(登録番号 + 1), "昇順")
	ソート順 = 1
ELSEIF STRCOUNT(キャラ一覧ソート:(登録番号 + 1), "降順")
	ソート順 = -1
ELSE
	ソート順 = 1
ENDIF

IF STRCOUNT(キャラ一覧ソート:登録番号, "好感度レベル")
	ソート値 = CFLAG:キャラ番号:好感度レベル
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "恋慕レベル")
	ソート値 = CFLAG:キャラ番号:恋慕レベル
ELSEIF GETNUM(ABL, キャラ一覧ソート:登録番号) >= 0
	ソート値 = ABL:キャラ番号:(キャラ一覧ソート:登録番号)
ELSEIF GETNUM(装備ステータス補正保存, キャラ一覧ソート:登録番号) >= 0
	ソート値 = 基礎BATTLE_STATE:キャラ番号:(キャラ一覧ソート:登録番号) + 装備ステータス補正保存:キャラ番号:(キャラ一覧ソート:登録番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "Lv")
	ソート値 = 基礎BATTLE_STATE:キャラ番号:(キャラ一覧ソート:登録番号)
ELSEIF GETNUM(知識素質, キャラ一覧ソート:登録番号) >= 0
	ソート値 = 知識素質:キャラ番号:(キャラ一覧ソート:登録番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "コマンド回数")
	ソート値 = CFLAG:キャラ番号:コマンドタゲ回数記録
ELSEIF GETNUM(性癖素質, キャラ一覧ソート:登録番号) > 0
	ソート値 = 性癖素質:キャラ番号:(キャラ一覧ソート:登録番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "画像数")
	ソート値 = GET_RESOURCES_COUNT(キャラ番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "画像フォルダ数")
	ソート値 = MAX(GET_ALL_RESOURCES_FOLDERS(キャラ番号), 0)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "出典")
	ソート値 = ソート値取得_出典(キャラ番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "呼び名")
	ソート値 = ソート値取得_呼び名(キャラ番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "感覚合計")
	ソート値 = ソート値取得_感覚合計(キャラ番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "身長")
	ソート値 = BASE:キャラ番号:身長
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "バスト")
	ソート値 = 補正込みバストサイズ(キャラ番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "ウエスト")
	ソート値 = 補正込みウエストサイズ(キャラ番号)
ELSEIF STRCOUNT(キャラ一覧ソート:登録番号, "ヒップ")
	ソート値 = 補正込みヒップサイズ(キャラ番号)
ELSEIF キャラ一覧ソート:登録番号 == "" && 登録番号 == 0
	ソート値 = キャラ番号
ELSE
	RETURNF 0
ENDIF

;RETURNF (ソート値 * 10000 * ソート順)+ キャラ番号 + 1
RETURNF (ソート値 * 10000 * ソート順) + 1

;---------------------------------------------------------
;ソート情報表示
;---------------------------------------------------------
@ソート情報表示(対象キャラ, 短縮フラグ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIM 短縮フラグ

;ソート条件に応じた対象キャラの情報を文字列として返す

SIF キャラ一覧ソート:0 == ""
	RETURNF ""

IF STRCOUNT(キャラ一覧ソート:0, "好感度レベル")
	RETURNF @"好感度レベル：Lv{CFLAG:対象キャラ:好感度レベル, 3}"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "恋慕レベル")
	RETURNF @"恋慕レベル：Lv{CFLAG:対象キャラ:恋慕レベル, 3}"
ELSEIF GETNUM(ABL, キャラ一覧ソート:0) >= 0
	RETURNF @"%ABLNAME:(GETNUM(ABL, キャラ一覧ソート:0))%：{ABL:対象キャラ:(キャラ一覧ソート:0), 2}"
ELSEIF GETNUM(装備ステータス補正保存, キャラ一覧ソート:0) >= 0
	RETURNF @"%ERDNAME(装備ステータス補正保存, GETNUM(装備ステータス補正保存, キャラ一覧ソート:0))%：{基礎BATTLE_STATE:対象キャラ:(キャラ一覧ソート:0) + 装備ステータス補正保存:対象キャラ:(キャラ一覧ソート:0), 4}"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "Lv")
	RETURNF @"Lv{基礎BATTLE_STATE:対象キャラ:Lv, 3}"
ELSEIF GETNUM(知識素質, キャラ一覧ソート:0) >= 0
	RETURNF @"%ERDNAME(知識素質, GETNUM(知識素質, キャラ一覧ソート:0))%：{知識素質:対象キャラ:(キャラ一覧ソート:0)}"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "コマンド回数")
	RETURNF @"コマンド回数：{CFLAG:対象キャラ:コマンドタゲ回数記録, 4}"
ELSEIF GETNUM(性癖素質, キャラ一覧ソート:0) > 0
	RETURNF @"%ERDNAME(性癖素質, GETNUM(性癖素質, キャラ一覧ソート:0))%：{性癖素質:対象キャラ:(キャラ一覧ソート:0)}"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "画像数")
	RETURNF @"画像数：{GET_RESOURCES_COUNT(対象キャラ), 4}"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "画像フォルダ数")
	RETURNF @"画像フォルダ数：{MAX(GET_ALL_RESOURCES_FOLDERS(対象キャラ), 0), 4}"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "出典")
	RETURNF @"出典：%ソート用出典名取得(対象キャラ)%"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "呼び名")
	IF 短縮フラグ
		RETURNF @"呼び名：%NAME表示省略(CALLNAME:対象キャラ, 10), 10, LEFT%"
	ELSE
		RETURNF @"呼び名：%CALLNAME:対象キャラ%"
	ENDIF
ELSEIF STRCOUNT(キャラ一覧ソート:0, "感覚合計")
	LOCALS '= GET_TALENTNAME(GETNUM(TALENT, "イキやすさ"), TALENT:対象キャラ:イキやすさ)
	IF LOCALS != ""
		LOCALS '= @"＋ %LOCALS%"
	ELSE
		LOCALS '= @"   　　　"
	ENDIF
	RETURNF @"感覚合計：{ソート値取得_感覚合計(対象キャラ, 1), 2} %LOCALS%"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "身長")
	RETURNF @"身長：%DECIMAL_STRING(BASE:対象キャラ:身長, 1)%cm"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "バスト")
	RETURNF @"バスト：%DECIMAL_STRING(補正込みバストサイズ(対象キャラ), 1)%cm%GET_CUPSIZE(対象キャラ)%"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "ウエスト")
	RETURNF @"ウエスト：%DECIMAL_STRING(補正込みウエストサイズ(対象キャラ), 1)%cm"
ELSEIF STRCOUNT(キャラ一覧ソート:0, "ヒップ")
	RETURNF @"ヒップ：%DECIMAL_STRING(補正込みヒップサイズ(対象キャラ), 1)%cm"
ENDIF


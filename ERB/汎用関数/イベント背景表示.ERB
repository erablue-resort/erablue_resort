;--------------------------------------------------
;イベント用・右下背景画像表示
;
;使用例
;CALL イベント背景表示_右下("キャラ画像フォルダ/still/画像名")
;CALL イベント背景消去_右下
;
;resourcesからの相対パスを指定する。
;表示関数を再度呼ぶと、表示中の画像を新しい画像へ変更する。
;--------------------------------------------------

;==================================================================================================
@イベント背景表示(ファイルパス)
;-------------------------------------------------
;--------------------------------------------------------------------------------------------------
#DIMS ファイルパス
#DIM 横位置
#DIM 縦位置
#DIM イベント背景カラーマトリクス, 5, 5
;--------------------------------------------------------------------------------------------------

;表示中のイベント背景だけを消去する
CALL イベント背景消去

;元画像を読み込む
SIF !GCREATE_拡張子F(19996, ファイルパス)
	RETURN 0

;約30％の濃さにした表示用画像を作成する
イベント背景カラーマトリクス:0:0 = 256,   0,   0,   0,   0
イベント背景カラーマトリクス:1:0 =   0, 256,   0,   0,   0
イベント背景カラーマトリクス:2:0 =   0,   0, 256,   0,   0
イベント背景カラーマトリクス:3:0 =   0,   0,   0, 154,   0 ;76
イベント背景カラーマトリクス:4:0 =   0,   0,   0,   0, 256

GCREATE 19997, GWIDTH(19996), GHEIGHT(19996)
GDRAWG 19997, 19996, 0, 0, GWIDTH(19996), GHEIGHT(19996), 0, 0, GWIDTH(19996), GHEIGHT(19996), イベント背景カラーマトリクス:0:0

SPRITECREATE "イベント背景", 19997

;CBGの原点に合わせ、常に画面右下へ配置する
横位置 = CLIENTWIDTH() - GWIDTH(19997)
縦位置 = 0
CBGSETSPRITE "イベント背景", 横位置, 縦位置, -19996

RETURN 1



;==================================================================================================
@イベント背景消去
;-------------------------------------------------
;--------------------------------------------------------------------------------------------------
;専用レイヤーだけを消し、他のCBG描画には触れない
CBGREMOVERANGE -19996, -19996
SPRITEDISPOSE "イベント背景"
GDISPOSE 19996
GDISPOSE 19997

RETURN 1




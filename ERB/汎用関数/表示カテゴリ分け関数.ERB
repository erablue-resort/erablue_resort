@素質カテゴリ(TALENT番号)
#FUNCTIONS
#DIM TALENT番号

;主に素質指定雇用やCSV作成モードで使う表示順制御

IF INRANGE(TALENT番号, 0, 9) || INRANGE(TALENT番号, 71, 76) || INRANGE(TALENT番号, 132, 134) || INRANGE(TALENT番号, 150, 219) || TALENT番号 == 228 || TALENT番号 == 236
	RETURNF "非表示"
ELSEIF TALENT番号 == 235
	RETURNF "優先表示"
ELSEIF INRANGE(TALENT番号, 10, 27) || TALENT番号 == 30 || INRANGE(TALENT番号, 32, 33) || TALENT番号 == 62 || INRANGE(TALENT番号, 84, 85) || TALENT番号 == 141 || TALENT番号 == 220 || INRANGE(TALENT番号, 224, 225) || TALENT番号 == 229 || INRANGE(TALENT番号, 231, 232) || TALENT番号 == 236 || TALENT番号 == 240 || TALENT番号 == 254 || TALENT番号 == 257 || INRANGE(TALENT番号, 260, 288)
	RETURNF "性格"
ELSEIF INRANGE(TALENT番号, 0, 2) || TALENT番号 == 5 || INRANGE(TALENT番号, 101, 105) || INRANGE(TALENT番号, 110, 111) || TALENT番号 == 130 || TALENT番号 == 149 || TALENT番号 == 152 || TALENT番号 == 154 || INRANGE(TALENT番号, 160, 165) || TALENT番号 == 200 || TALENT番号 == 203 || INRANGE(TALENT番号, 205, 212) || TALENT番号 == 221 || TALENT番号 == 223 || TALENT番号 == 226 || INRANGE(TALENT番号, 238, 239) || INRANGE(TALENT番号, 245, 247) || TALENT番号 == 249 || INRANGE(TALENT番号, 251, 253) || INRANGE(TALENT番号, 289, 298)
	RETURNF "肉体"
ELSEIF GROUPMATCH(TALENT番号, 95, 135, 136, 138, 139, 242, 243, 247, 211, 212)
	;表示しない
	RETURNF ""
ENDIF

RETURNF "その他"

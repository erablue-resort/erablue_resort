;===================================================
;観光客をナンパ
;===================================================
@COMNAME420
#FUNCTIONS
#DIM 同行者フラグ

IF TARGET > 0 && CFLAG:MASTER:隠密 == CFLAG:TARGET:隠密
	TSTR:コマンド名受渡 = アイテム使用
ELSE
	TSTR:コマンド名受渡 = 自分にアイテム使用
ENDIF

;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_420
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("うふふ_単独可能_隠密")


;===================================================
;ツールチップ文章
;===================================================
@COM_TOOLTIP_420
TSTR:ツールチップ受渡 '= "<br>■アイテム使用<br>"
TSTR:ツールチップ受渡 += "手持ちのアイテムを使用するコマンド。<br>※開発中の仮画面につき、将来的に使用画面のレイアウトは変更します。"
TSTR:ツールチップ受渡 += "<br>COMタイプ：単独可能<br>取得ソース：なし"
TSTR:ツールチップ受渡 += "<br>固有の取得経験：なし<br>"


;===================================================
;コマンド実行処理
;===================================================
@COM420

IF TARGET > 0 && CFLAG:MASTER:隠密 == CFLAG:TARGET:隠密
	CALL ITEM_PROTO(TARGET)
ELSE
	CALL ITEM_PROTO(MASTER)
ENDIF

RETURN -1


;===================================================
;実行可能判定
;===================================================
@COM_ABLE420
;隠れる実行判定
SIF SAVESTR:ゲームフェイズ管理 != "通常モード"
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(420)
	RETURN RESULT

RETURN 1



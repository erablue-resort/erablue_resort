;-------------------------------------------------
;TARGETが特定の衣装を着ている時に発生する固有コマンド枠
;-------------------------------------------------
;コマンド名
;-------------------------------------------------
@COMNAME390
#FUNCTIONS
;マップ種別ごとに更に別の関数を呼ぶ
TSTR:コマンド名受渡 = 
TRYCALLFORMF COMNAME_CLOTH_390_%CSTR:TARGET:着せ替え服%

;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_390
#FUNCTION
TRYCALLFORMF COMTYPE_390_%CSTR:TARGET:着せ替え服%

@COM_TOOLTIP_390
TRYCALLFORM COM_TOOLTIP_390_%CSTR:TARGET:着せ替え服%

;-------------------------------------------------
;実行
;-------------------------------------------------
@COM390
;場所ごとに更に別の関数を呼ぶ
TRYCALLFORM COM390_%CSTR:TARGET:着せ替え服%

RETURN RESULT


;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE390
;実行判定
SIF SAVESTR:ゲームフェイズ管理 != "通常モード"
	RETURN 0
;ゆきずり覗き・使い魔覗き中は使用不可
SIF ゆきずり覗き中？(TARGET) || CFLAG:MASTER:使い魔覗き状態
	RETURN 0
;個別のABLEを呼ぶ
TRYCCALLFORM COM_ABLE390_%CSTR:TARGET:着せ替え服%
SIF RESULT == 0
	RETURN 0
CATCH
	RETURN 0
ENDCATCH
RETURN 1

;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MESSAGE_COM390
;マップ種別ごとに更に別の関数を呼ぶ
TRYCALLFORM MESSAGE_COM390_%CSTR:TARGET:着せ替え服%

@MESSAGE_COM390_非口上時
;マップ種別ごとに更に別の関数を呼ぶ
TRYCALLFORM MESSAGE_COM390_%CSTR:TARGET:着せ替え服%_非口上時


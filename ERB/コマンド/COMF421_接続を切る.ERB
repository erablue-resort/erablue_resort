;-------------------------------------------------
;接続を切る
;-------------------------------------------------
@COMNAME421
#FUNCTIONS
TSTR:コマンド名受渡 = 接続を切る


;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_421
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("単独可能")

@COM_TOOLTIP_421
LOCALS = <br>■接続を切る<br>
LOCALS += "使い魔との接続を切り、通常の視点に戻るコマンド。"
LOCALS += ""
LOCALS += "<br>COMタイプ：単独可能<br>取得ソース：なし"
LOCALS += "<br>固有の取得経験：なし<br>"
TSTR:ツールチップ受渡 = %LOCALS%


;-------------------------------------------------
;実処理
;-------------------------------------------------
@COM421
#DIM 覗き対象

覗き対象 = CFLAG:MASTER:使い魔覗き状態
CFLAG:MASTER:使い魔覗き状態 = 0

SIF 覗き対象 > 0 && 覗き対象 < CHARANUM
    TCVAR:覗き対象:ゆきずりセックス_覗かれ中 = 0

RETURN 1


;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE421
;実行判定
;使い魔覗き中しか使用できない
SIF CFLAG:MASTER:使い魔覗き状態
	RETURN 1
;一括管理
SIF GLOBAL_COMABLE(421) && GLOBAL_COMABLE_TYPE("隠密")
	RETURN RESULT

RETURN 0

;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MESSAGE_COM421

PRINTL 使い魔との接続を切った。


@COMNAME301
#FUNCTIONS
TSTR:コマンド名受渡 = お茶を淹れる

;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_301
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("日常")

@COM_TOOLTIP_301
LOCALS = <br>■お茶を淹れる<br>
LOCALS += "お茶を淹れ、その場にいる全員で休憩するコマンド。<br>一度実行した後は２時間のインターバルが必要。"
LOCALS += "<br>COMタイプ：日常<br>取得ソース：歓楽・征服"
LOCALS += "<br>固有の取得経験：なし<br>"
TSTR:ツールチップ受渡 = %LOCALS%

;お茶を淹れる
@COM301

;料理経験獲得をつけて「お茶淹れを繰り返してくと失敗が減る」みたいにしてもいい気もしたけど、
;それだと「ひたすらお茶酌みしてたら全空最高の料理人になっていた件」みたいな感じのなろう系オーナーになってしまう懸念もある
;EXP:お茶酌み経験を新設すればいいんだろうけど、それだと「オーナーの料理人技能意味を持たせようキャンペーン」の趣旨からは外れる。痛し痒し。
IF 知識素質:MASTER:料理人 >= 3
;全空一のお茶酌み
	SELECTCASE RAND:100
	CASE 0 TO 49
	;大成功 50% お茶酌み界の十天衆ならこのくらいは出すよねきっと
		EXP:MASTER:会話経験 ++
		RFLAG:コマンド結果受渡し変数 = 1
	CASEELSE
	;成功 80%
		RFLAG:コマンド結果受渡し変数 = 0	
	ENDSELECT
ELSEIF 知識素質:MASTER:料理人 == 2
;料理人で食ってけるベテランのお茶酌み
	SELECTCASE RAND:100
	CASE 0 TO 19
	;大成功 20%
		EXP:MASTER:会話経験 ++
		RFLAG:コマンド結果受渡し変数 = 1
	CASEELSE
	;成功 80%
		RFLAG:コマンド結果受渡し変数 = 0	
	ENDSELECT
ELSEIF 知識素質:MASTER:料理人 == 1
;あくまで趣味レベルのお茶酌み
	SELECTCASE RAND:100
	CASE 0 TO 14
	;大成功 15%
		EXP:MASTER:会話経験 ++
		RFLAG:コマンド結果受渡し変数 = 1
	CASE 15 TO 19
	;失敗 5%
		RFLAG:コマンド結果受渡し変数 = -1
	CASEELSE
	;成功 80%
		RFLAG:コマンド結果受渡し変数 = 0	
	ENDSELECT
ELSE
;素人
	SELECTCASE RAND:10
	CASE 0
	;大成功 10%
		EXP:MASTER:会話経験 ++
		RFLAG:コマンド結果受渡し変数 = 1
	CASE 1
	;失敗 10%
		RFLAG:コマンド結果受渡し変数 = -1
	CASEELSE
	;成功 80%
		RFLAG:コマンド結果受渡し変数 = 0	
	ENDSELECT
ENDIF


;その場に居るTARGET全員で回す
LOCAL:1 = TARGET
FOR LOCAL,1,CHARANUM
	SIF TARGET:LOCAL <= 0
		CONTINUE
	SIF CFLAG:(TARGET:LOCAL):睡眠
		CONTINUE
	SIF CFLAG:(TARGET:LOCAL):隠密
		CONTINUE
	;お茶飲んだ後だと巻き込まない
	SIF TIME_PROGRESS(TCVAR:(TARGET:LOCAL):お茶飲み時刻) < 120
		CONTINUE
	TARGET = TARGET:LOCAL
	CALL COM301_1
NEXT
TARGET = LOCAL:1

TIME += 30
RETURN 1


@COM301_1


;歓楽強度
LOCAL:0 = 700
;征服強度
LOCAL:1 = 100

IF RFLAG:コマンド結果受渡し変数 == -1
	TIMES LOCAL:0 , 0.10
	TIMES LOCAL:1 , 0.50
ELSEIF RFLAG:コマンド結果受渡し変数 == 0
	TIMES LOCAL:0 , 1.00
	TIMES LOCAL:1 , 1.00
ELSE
	TIMES LOCAL:0 , 2.00
	TIMES LOCAL:1 , 2.00
ENDIF

IF TALENT:TARGET:飲食不可
	LOCAL:0 = LOCAL:0 / 2
	LOCAL:1 = LOCAL:1 / 2
ENDIF

CALL SOURCE_CALC_歓楽(TARGET, PLAYER, LOCAL:0)
CALL SOURCE_CALC_征服(TARGET, PLAYER, LOCAL:1)
CALL SOURCE_CALC_好感度要素_友情度UP(TARGET, PLAYER, LOCAL:0 / 2)

;関係性上昇(基本15分で+1、大成功で1.5倍、失敗時は半減)
CALL 関係性一括上昇(TARGET, 2, RFLAG:コマンド結果受渡し変数)

;体力回復
LOCAL:1 = 100
;回復早い、回復遅い
SIF !GETBIT(TCVAR:TARGET:食事済みフラグ, 0)
	BASE:TARGET:体力 = MIN(MAXBASE:TARGET:体力, BASE:TARGET:体力 + (LOCAL:1 * 3 / (3 - TALENT:TARGET:回復速度)))
SETBIT TCVAR:TARGET:食事済みフラグ, 0

;お茶を飲んだフラグ
TCVAR:お茶飲み時刻 = 1440 * DAY + TIME

;-------------------------------------------------
;実行判定
;-------------------------------------------------

@COM_ABLE301
;お茶を淹れる実行判定
SIF SAVESTR:ゲームフェイズ管理 != "通常モード"
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(301)
	RETURN RESULT
;二時間間隔
SIF TIME_PROGRESS(TCVAR:お茶飲み時刻) < 120
	RETURN 0
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
;浴場
SIF BATHROOM(CFLAG:PLAYER:現在マップ種別, CFLAG:MASTER:現在位置)
	RETURN 0
;隠密中はダメ
SIF CFLAG:PLAYER:隠密
	RETURN 0
RETURN 1

;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MESSAGE_COM301
PRINTFORML %CALLNAME:PLAYER%はお茶を淹れて%CALLNAME:TARGET%\@ GET_TARGETNUM() > 1 ? 達 # \@に差し出した…
IF RFLAG:コマンド結果受渡し変数 == 1
	PRINTFORML %CALLNAME:TARGET%と%CALLNAME:PLAYER%はお茶を飲みながら楽しいひとときを過ごした…
ELSEIF RFLAG:コマンド結果受渡し変数 == -1
	PRINTFORML …どうやら%CALLNAME:TARGET%の口に合わなかったようだ
ENDIF



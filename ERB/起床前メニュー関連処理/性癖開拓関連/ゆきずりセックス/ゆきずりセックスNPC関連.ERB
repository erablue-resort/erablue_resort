;==================================================================================================
@ゆきずりセックス_NPC作成(ARG, 性別)
;-------------------------------------------------
;ランダムで容姿を決め、それを基にNPCを作成する
;キャラIDを返す
;--------------------------------------------------------------------------------------------------
#DIM 性別
#DIM 管理番号
#DIM 生成NPC
;--------------------------------------------------------------------------------------------------

;ランダムな竿役の決定 0918時点でとりあえず7種。CASEELSEだけちょっと確率高め
TCVAR:ARG:ゆきずりセックス_相手モブ = RAND:8
TCVAR:ARG:ゆきずりセックス_相手描写 = 0

;相手キャラIDを設定
生成NPC = CHARANUM
TCVAR:ARG:ゆきずりセックス_相手キャラID = 生成NPC

;NPC生成
ADDCHARA 999

;生成NPC本人に削除対象の印を付ける
TCVAR:生成NPC:ゆきずりセックス_相手キャラID = -1

;性別を決定する
TALENT:生成NPC:性別 = 性別

;ステルスフラグを持たせる
TCVAR:生成NPC:ステルス = 1

;共通してケツ穴は持っておく
TALENT:生成NPC:Ａ感度 = 0

;●男性の設定
IF IS_MALE(生成NPC)
	;[絶倫]を持たせる
	TALENT:生成NPC:絶倫 = 1
	;[Ｃ敏感]を持たせる
	TALENT:生成NPC:Ｃ感度 = 1
	
	;精力を設定する
	MAXBASE:生成NPC:精力 = 9999
	BASE:生成NPC:精力 = MAXBASE:生成NPC:精力
	
	;能力を設定
	ABL:生成NPC:欲望 = 10
	ABL:生成NPC:Ｃ感覚 = 10
	ABL:生成NPC:技巧 = 10
	ABL:生成NPC:腰使い = 10
	
	知識素質:生成NPC:性知識 = 2
	
	;相手モブの種類によって名前と素質を付与
	SELECTCASE TCVAR:ARG:ゆきずりセックス_相手モブ
		CASE 0
			CALLNAME:生成NPC = %TEXTR("冴えない/陰気そうな")%青年
			;成人
			TALENT:生成NPC:年齢層 = 12
			;[童貞]
			TALENT:生成NPC:非童貞 = 0
			;早イキ
			TALENT:生成NPC:イキやすさ = 1

		CASE 1
			CALLNAME:生成NPC = %TEXTR("でっぷりと腹の出た/恰幅のいい")%中年
			;中年
			TALENT:生成NPC:年齢層 = 15
			;[童貞]じゃない
			TALENT:生成NPC:非童貞 = 1
			;肥満
			TALENT:生成NPC:体型 = 3

		CASE 2 TO 3
			IF TALENT:ARG:年齢層 == 10 || (BASE:ARG:年齢 <= 13 && BASE:ARG:年齢 != 0)
				CALLNAME:生成NPC = 同じ年頃の少年
			ELSE
				CALLNAME:生成NPC = %TEXTR("小さな/年端もいかない")%男の子
			ENDIF
			;幼い
			TALENT:生成NPC:年齢層 = 10
			;[童貞]
			TALENT:生成NPC:非童貞 = 0
			;こどもちんぽ
			TALENT:生成NPC:男性器サイズ = -2
			;早イキ
			TALENT:生成NPC:イキやすさ = 1
			
		CASE 4
			CALLNAME:生成NPC = 体格のいい男
			;大人
			TALENT:生成NPC:年齢層 = 13
			;[童貞]じゃない
			TALENT:生成NPC:非童貞 = 1
			;巨根
			TALENT:生成NPC:男性器サイズ = 1
			
		CASE 5
			CALLNAME:生成NPC = 歳が大きく離れた老人
			;老年
			TALENT:生成NPC:年齢層 = 16
			;[童貞]じゃない
			TALENT:生成NPC:非童貞 = 1
			;遅イキ
			TALENT:生成NPC:イキやすさ = -1
			
	;	CASE 6
			
		CASEELSE
			CALLNAME:生成NPC = %TEXTR("ぱっとしない/普通な")%男
			;大人
			TALENT:生成NPC:年齢層 = 13
			;確率で[彼女持ち]もしくは[妻持ち]
			TALENT:生成NPC:恋人持ち = RAND:3
			;[浮気]
			SIF TALENT:生成NPC:恋人持ち
				TALENT:生成NPC:浮気 = 1
			
				
	ENDSELECT
	
;●女性の設定
ELSE
	;[Ｖ敏感]を持たせる
	TALENT:生成NPC:Ｖ感度 = 1
	;[Ｂ敏感]を持たせる
	TALENT:生成NPC:Ｂ感度 = 1
	;[濡れやすい]を持たせる
	TALENT:生成NPC:濡れやすさ = 1
	;バストサイズをランダムに決める
	TALENT:生成NPC:バストサイズ = (RAND:5)-2
	
	;能力を設定
	ABL:生成NPC:欲望 = 10
	ABL:生成NPC:Ｖ感覚 = 10
	ABL:生成NPC:Ａ感覚 = 10
	ABL:生成NPC:Ｂ感覚 = 10
	ABL:生成NPC:腰使い = 10
	
	;相手モブの種類によって名前と素質を付与
	SELECTCASE TCVAR:ARG:ゆきずりセックス_相手モブ
		CASE 0
			CALLNAME:生成NPC = 不慣れそうな女性
			;成人
			TALENT:生成NPC:年齢層 = 12
			
		CASE 1
			CALLNAME:生成NPC = 妙齢の人妻
			;大人
			TALENT:生成NPC:年齢層 = 13
			;[経験豊富]
			TALENT:生成NPC:恋人持ち = 2
			;[浮気]
			TALENT:生成NPC:浮気 = 1
			;20%で[妊娠]
			SIF !RAND:5
				TALENT:生成NPC:妊娠 = 1
			
		CASE 2
			CALLNAME:生成NPC = 小柄な女性
			;成人
			TALENT:生成NPC:年齢層 = 12
			;小柄
			TALENT:生成NPC:体格 = -1
			
		CASE 3
			CALLNAME:生成NPC = 快活な女性
			;成人
			TALENT:生成NPC:年齢層 = 12
			
		CASE 4
			CALLNAME:生成NPC = 妖艶な女性
			;大人
			TALENT:生成NPC:年齢層 = 13
			;
			ABL:生成NPC:技巧 = 10
			;[経験豊富]
			TALENT:生成NPC:経験豊富 = 1
			;[淫乱]
			TALENT:生成NPC:淫乱 = 1
			
			
		CASE 5
			CALLNAME:生成NPC = 上品な女性
			;壮年
			TALENT:生成NPC:年齢層 = 14
			;[淑女的]
			TALENT:生成NPC:精神的余裕 = 2
			
	;	CASE 6
			
		CASEELSE
			CALLNAME:生成NPC = 発情期のエルーンの女性
			;種族エルーン
			TALENT:生成NPC:種族 = 2
			;ケモミミシッポ
			TALENT:生成NPC:エルーン耳 = 1
			TALENT:生成NPC:尻尾あり = 1
			;ケモミミシッポ
			SETBIT TALENT:生成NPC:発情期あり, 1
			;成人
			TALENT:生成NPC:年齢層 = 12
			
	ENDSELECT
ENDIF

CALL ADD_PERSON_FROM_CHARA(生成NPC)
CALL コマンド存在チェック

CFLAG:生成NPC:招待不可フラグ = 0
;CALL ステータス記録_ランダムキャラデータベース(Ｒキャラ追加候補記録, 管理番号, CFLAG:生成NPC:人物番号)

;性欲をある程度確保しておく
MAXBASE:生成NPC:性欲 = 3000
CALL 性欲ゲージ増加(生成NPC, MAXBASE:生成NPC:性欲 * 5)

;雑に欲情させておく
PALAM:生成NPC:欲情 = 30000
;雑に理性も減らしとく
BASE:生成NPC:理性 = MAXBASE:生成NPC:理性 / 4
;チン有ならフルボッキさせる
BASE:生成NPC:勃起=MAXBASE:生成NPC:勃起

;来訪時処理
CFLAG:生成NPC:滞在期間 = 1

;起きている状態にする
CFLAG:生成NPC:睡眠 = 0
;この時点で隠密させておく
CFLAG:生成NPC:隠密 = 1

;出現位置を対象キャラと同じにする
CFLAG:生成NPC:現在マップ種別 = CFLAG:ARG:現在マップ種別
CFLAG:生成NPC:現在位置 = CFLAG:ARG:現在位置

;目的地も決め打ちしておく
スケジュール状態:生成NPC:目的地 = CFLAG:ARG:現在位置
スケジュール状態:生成NPC:目的マップ = CFLAG:ARG:現在マップ種別

;開始状況をNPC側にコピー
TCVAR:生成NPC:ゆきずりセックス_誘い = TCVAR:ARG:ゆきずりセックス_誘い

;ゆきセNPCのスケジュールに仮のものを設定
CALL SET_SCHEDULE(生成NPC, 0, 0, "ゆきずりNPC用", "優先度", "100")
CALL RUN_SCHEDULE(生成NPC)

RETURN 生成NPC



;==================================================================================================
@ゆきずりセックス_NPC消去
;-------------------------------------------------
;ゆきずりセックスで生成されたNPCをDELCHARAする処理
;CHARANUMの仕様上、キャラIDを降順から削除処理を走らせる
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
#DIM 消去実行フラグ
消去実行フラグ = 0
;--------------------------------------------------------------------------------------------------
;先に通常キャラ側のNPC参照を消す
FOR LOCAL, 0, CHARANUM
	相手キャラ = TCVAR:LOCAL:ゆきずりセックス_相手キャラID
	
	IF 相手キャラ > 0 && 相手キャラ < CHARANUM
		SIF TCVAR:相手キャラ:ゆきずりセックス_相手キャラID == -1
			TCVAR:LOCAL:ゆきずりセックス_相手キャラID = 0
	ENDIF
NEXT

;生成NPC本人をキャラ番号の降順で削除
FOR LOCAL, CHARANUM - 1, -1, -1
	SIF TCVAR:LOCAL:ゆきずりセックス_相手キャラID != -1
		CONTINUE
	
	DELCHARA LOCAL
	消去実行フラグ = 1
NEXT

IF 消去実行フラグ
	CALL SORT_CHARALIST()
ENDIF


;==================================================================================================
@SCHEDULE_ゆきずりNPC用(ARG, 小分類, 処理内容)
;-------------------------------------------------
;--------------------------------------------------------------------------------------------------
;#DIM キャラ番号
#DIMS 小分類
#DIMS 処理内容
;--------------------------------------------------------------------------------------------------
SELECTCASE 処理内容
	CASE "開始処理"
		TCVAR:ARG:ゆきずりセックス_行為中 = 1
		TCVAR:ARG:移動ルーチンインターバル時間 = 0
		RETURN 1
	CASE "経過処理"
		IF TCVAR:ARG:ゆきずりセックス_行為中
			;ゆきずり場所がその場なら隠密を継続させる
			SIF !GETBIT(TCVAR:ARG:ゆきずりセックス_誘い, 1)
				CFLAG:ARG:隠密 = 1
		ELSE
			;行為中でないなら退避する
			スケジュール状態:ARG:目的地 = 998
			スケジュール状態:ARG:目的マップ = 0
			
			CFLAG:ARG:滞在期間 = -1
			CFLAG:ARG:現在位置 = 999
			CFLAG:ARG:現在マップ種別 = 0
			
		ENDIF
	CASE "終了処理"
		
		RETURN 1
ENDSELECT




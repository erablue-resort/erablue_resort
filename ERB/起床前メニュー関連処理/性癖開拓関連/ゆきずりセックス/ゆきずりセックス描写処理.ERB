;==================================================================================================
@ゆきずりセックス_描写状況取得(ARG)
#FUNCTIONS
;-------------------------------------------------
;現在の性別構成・プレイ種別・役割を、描写分岐用の文字列として返す
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
#DIM プレイ種別
#DIMS キャラ性別
#DIMS NPC性別
#DIMS 役割
#DIMS プレイ内容
;--------------------------------------------------------------------------------------------------

相手キャラ = TCVAR:ARG:ゆきずりセックス_相手キャラID

SIF 相手キャラ < 0 || 相手キャラ >= CHARANUM
	RETURNF "不明"

;キャラ側の性別
IF IS_FEMALE(ARG) && HAS_PENIS(ARG)
	キャラ性別 '= "ふた"
ELSEIF IS_MALE(ARG)
	キャラ性別 '= "男"
ELSEIF IS_FEMALE(ARG)
	キャラ性別 '= "女"
ELSE
	RETURNF "不明"
ENDIF

;NPC側の性別
IF IS_MALE(相手キャラ)
	NPC性別 '= "男"
ELSEIF IS_FEMALE(相手キャラ)
	NPC性別 '= "女"
ELSE
	RETURNF "不明"
ENDIF

プレイ種別 = ゆきずりセックス_プレイ種別取得(ARG)
プレイ内容 '= ゆきずりセックス_プレイ内容取得(ARG)

SIF プレイ内容 == ""
	RETURNF "不明"

;逆アナルは最初に独立させる
IF ゆきずりセックス_逆アナル発生中(ARG)
	RETURNF "ふた×男_逆アナル"
ENDIF

SELECTCASE プレイ種別
	CASE 1 TO 2
		;V・Aでは実行側＝挿入する側
		IF ゆきずりセックス_実行側？(ARG)
			役割 '= "キャラ挿入"
		ELSE
			役割 '= "NPC挿入"
		ENDIF

	CASEELSE
		;貝合わせは奉仕方向を持たない
		IF プレイ内容 == "貝合わせ"
			役割 '= "貝合わせ"
		ELSEIF ゆきずりセックス_実行側？(ARG)
			;手コキ・フェラなどでは実行側＝奉仕する側
			役割 '= "キャラ奉仕"
		ELSE
			役割 '= "NPC奉仕"
		ENDIF
ENDSELECT

RETURNF @"%キャラ性別%×%NPC性別%_%役割%"

;==================================================================================================
@ゆきずりセックス_実行処理(ARG)
;-------------------------------------------------
;開始状況を基にNPCの生成とスケジュールの割り込みを行う
;--------------------------------------------------------------------------------------------------
#DIM NPC性別
;--------------------------------------------------------------------------------------------------
;ゆきずりNPCの作成
;キャラが女性のとき
IF IS_FEMALE(ARG)
	;同性愛持ちは強度によって確率が変動(25~75%)
	IF 性癖素質:ARG:同性愛 && RAND:100 < 25*MAX(性癖素質:ARG:同性愛, 1)
		;女性を作成
		NPC性別 = 1
		
	;ふたなりは勃起度で確率が変動(50~100%)
	ELSEIF HAS_PENIS(ARG) && RAND:100 < MAX(BASE:ARG:勃起*100/MAXBASE:ARG:勃起,50)
		;女性を作成
		NPC性別 = 1
		
	ELSE
		;男性を作成
		NPC性別 = 2
		
	ENDIF

;キャラが男性
ELSEIF IS_MALE(ARG)
	;同性愛持ちは強度によって確率が変動(25~75%)
	IF 性癖素質:ARG:同性愛 && RAND:100 < 25*MAX(性癖素質:ARG:同性愛, 1)
		;男性を作成
		NPC性別 = 2
		
	ELSE
		;女性を作成
		NPC性別 = 1
		
	ENDIF
ENDIF

;NPCの性別と火遊び抑制の性別が一致した場合は中断
SIF NPC性別 == TALENT:ARG:火遊び抑制
	RETURN 0

;問題がなければNPCを作成
CALL ゆきずりセックス_NPC作成(ARG, NPC性別)

;スケジュールの割り込み
IF GETBIT(TCVAR:ARG:ゆきずりセックス_誘い, 1)
	CALL INTERRUPT_SCHEDULE(ARG, 1, "自室でゆきずりセックス", "所要時間", "60", "優先度", "100")
ELSE
	CALL INTERRUPT_SCHEDULE(ARG, 1, "その場でゆきずりセックス", "所要時間", "30", "優先度", "100")
ENDIF
;即座に実行する
CALL RUN_SCHEDULE(ARG)

;PRINTFORMW ゆきずり開始
RETURN 1



;==================================================================================================
@ゆきずりセックス内容決定(ARG,相手キャラ)
;-------------------------------------------------
;
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
#DIM 攻めキャラ;ID
#DIM 受けキャラ;ID
#DIMS プレイ内容

#DIM V挿入可能
#DIM A挿入可能
#DIM 純潔維持
#DIM A性交フラグ
;--------------------------------------------------------------------------------------------------

;========================================================
; ●攻守の決定
;[女vs女]レズセの場合は誘ったほうが攻めとなる
IF IS_FEMALE(ARG) && IS_FEMALE(相手キャラ)
	;ふたなりはもれなく攻めになる。
	IF HAS_PENIS(ARG)
		攻めキャラ = ARG
		受けキャラ = 相手キャラ
	ELSE
		攻めキャラ = 相手キャラ
		受けキャラ = ARG
	ENDIF
	
;[男vs男]ホモセの場合は誘ったほうが攻めとなる。[淫肛]なら確定で受け
ELSEIF IS_MALE(ARG) && IS_MALE(相手キャラ)
	IF GETBIT(TCVAR:ARG:ゆきずりセックス_誘い, 0) || TALENT:ARG:淫肛
		;誘われ
		攻めキャラ = 相手キャラ
		受けキャラ = ARG
	ELSE
		;誘い
		攻めキャラ = ARG
		受けキャラ = 相手キャラ
	ENDIF
	
;[男vs女]基本的には女性が受け、男性が攻めとなる
ELSEIF IS_FEMALE(ARG)
	攻めキャラ = 相手キャラ
	受けキャラ = ARG
ELSE
	攻めキャラ = ARG
	受けキャラ = 相手キャラ
ENDIF


;========================================================
; ●挿入可能判定
V挿入可能 = HAS_VAGINA(受けキャラ)
A挿入可能 = TALENT:受けキャラ:Ａ感度 != -2
IF HETEROSEX(攻めキャラ, 受けキャラ) == 0
	純潔維持 = OPTION変数:夜這い処女・童貞
ELSE
	純潔維持 = OPTION変数:同性愛処女・童貞
ENDIF

IF 純潔維持
	SIF TALENT:受けキャラ:処女 && TCVAR:受けキャラ:ゆきずりセックス_相手キャラID != -1
		V挿入可能 = 0

	SIF TALENT:受けキャラ:Ａ処女 && TCVAR:受けキャラ:ゆきずりセックス_相手キャラID != -1
		A挿入可能 = 0
	
	;攻め側の童貞を保護(NPCなら無視)
	IF HAS_PENIS(攻めキャラ)&& TCVAR:攻めキャラ:ゆきずりセックス_相手キャラID != -1
		SIF !GETBIT(TALENT:攻めキャラ:非童貞, 0)
			V挿入可能 = 0

		SIF !GETBIT(TALENT:攻めキャラ:非童貞, 1)
			A挿入可能 = 0
	ENDIF
ENDIF



A性交フラグ = 0
;A可能かつ、Vが不可能 or Aを選ぶ特定条件を満たした場合
IF A挿入可能 && (!V挿入可能 || RAND:100 < 10 + 70 * TALENT:受けキャラ:淫肛)
	A性交フラグ = 1
	
ELSEIF V挿入可能
	;V性交
	A性交フラグ = 0

ELSE
	;VもAもできない
	IF HAS_PENIS(攻めキャラ)
		IF RAND:2
			CALL MODE_CHANGE("手コキ", 受けキャラ, 攻めキャラ)
		ELSE
			CALL MODE_CHANGE("フェラチオ", 受けキャラ, 攻めキャラ)
		ENDIF
	ELSEIF HAS_PENIS(受けキャラ)
		IF RAND:2
			CALL MODE_CHANGE("手コキ", 攻めキャラ, 受けキャラ)
		ELSE
			CALL MODE_CHANGE("フェラチオ", 攻めキャラ, 受けキャラ)
		ENDIF
	ELSE
		CALL MODE_CHANGE("貝合わせ", 攻めキャラ, 受けキャラ)
	ENDIF
	RETURN
ENDIF
;========================================================
; ●Ｖ性交
;場所によって体位を変える
IF GETBIT(TCVAR:ARG:ゆきずりセックス_誘い, 1)
	;自室 ベッドの上
	SELECTCASE RAND:8
		CASE 0
			プレイ内容 '= "正常位"
		CASE 1
			プレイ内容 '= "後背位"
		CASE 2
			プレイ内容 '= "寝バック"
		CASE 3
			プレイ内容 '= "対面座位"
		CASE 4
			プレイ内容 '= "背面座位"
		CASE 5
			プレイ内容 '= "騎乗位"
		CASE 6
			プレイ内容 '= "側位"
		CASE 7
			プレイ内容 '= "屈曲位"
	ENDSELECT
ELSE
	;物陰 立位/駅弁
	SELECTCASE RAND:4
		CASE 0
			;体格差を確認して持ち上げられないか確認
			IF 体格差計算(攻めキャラ, 受けキャラ) < 3
				プレイ内容 '= "駅弁"
			ELSE
				プレイ内容 '= "対面立位"
			ENDIF
		CASE 1
			;体格差を確認して持ち上げられないか確認
			IF 体格差計算(攻めキャラ, 受けキャラ) < 3
				プレイ内容 '= "背面駅弁"
			ELSE
				プレイ内容 '= "立ちバック"
			ENDIF
		CASE 2
			プレイ内容 '= "対面立位"
		CASE 3
			プレイ内容 '= "立ちバック"
	ENDSELECT
ENDIF

;========================================================
; ●Ａ性交
;先のＶ性交の体位の先頭に"Ａ"を付けるだけ
IF A性交フラグ
	;攻「男性」->受「ふたなり」の組み合わせのとき、受け手が「性癖：逆アナル」持ちなら確率で攻守が反転する。
	;「性癖：逆アナル」のレベルによって確率は大きくなる(20～60％)
	SIF (IS_MALE(攻めキャラ) && TALENT:受けキャラ:性別 == 3) &&  RAND:100 < 20*(性癖素質:受けキャラ:逆アナル)
		SWAP 攻めキャラ,受けキャラ
	
	;プレイ内容が駅弁系なら体格差を確認し、無理そうなら立位に変更する
	SIF プレイ内容=="駅弁" && 体格差計算(攻めキャラ, 受けキャラ) >= 3
		プレイ内容 '= "対面立位"
	SIF プレイ内容=="背面駅弁" && 体格差計算(攻めキャラ, 受けキャラ) >= 3
		プレイ内容 '= "立ちバック"
	
	;先頭にＡを付ける
	プレイ内容 '= "Ａ" + プレイ内容
	
ENDIF

;体位モードを更新
CALL MODE_CHANGE(プレイ内容, 攻めキャラ, 受けキャラ)



;==================================================================================================
@ゆきずりセックス_共通開始処理(ARG)
;-------------------------------------------------
;ゆきずりセックス関連スケジュールの共通した開始処理
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
;--------------------------------------------------------------------------------------------------
相手キャラ = TCVAR:ARG:ゆきずりセックス_相手キャラID

;同室もしくは使い魔対象なら物陰に行く描写を行う
IF IS_SAME_ROOM(ARG, MASTER) || CFLAG:ARG:使い魔対象
	CALL ゆきずりセックス_連れ込み描写(ARG)
ENDIF

;行為中フラグを維持する
TCVAR:ARG:ゆきずりセックス_行為中 = 1

;キャラ同士うふふフラグを立てる
CFLAG:ARG:キャラ同士うふふ = 1
CFLAG:相手キャラ:キャラ同士うふふ = 1

;V性交の場合
CALL ゆきずりセックス内容決定(ARG,相手キャラ)
;CALL ランダム挿入モードセット(相手キャラ,ARG)

;ゆきずりセックス回数のカウントアップ
IF CFLAG:ARG:リゾート内ゆきずりセックス回数 < 1
	CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>初めてリゾート内で[ゆきずりセックス]をした</font>","うふふ")
ELSEIF CFLAG:ARG:リゾート内ゆきずりセックス回数 == 9
	CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>リゾート内で[ゆきずりセックス]をした回数が１０回に到達した</font>","うふふ")
ELSEIF CFLAG:ARG:リゾート内ゆきずりセックス回数 == 49
	CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>リゾート内で[ゆきずりセックス]をした回数が５０回に到達した</font>","うふふ")
ELSEIF CFLAG:ARG:リゾート内ゆきずりセックス回数 == 99
	CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>リゾート内で[ゆきずりセックス]をした回数が１００回に到達した</font>","うふふ")
ENDIF
CFLAG:ARG:リゾート内ゆきずりセックス回数 ++

;ゆきずりセックス経験を加算する
EXP:ARG:ゆきずりセックス経験 ++



;==================================================================================================
@ゆきずりセックス_共通終了処理(ARG, 相手キャラ)
;-------------------------------------------------
;ゆきずりセックス関連スケジュールの共通した終了処理
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
;--------------------------------------------------------------------------------------------------
;満足度に応じて性欲を減少させる
CALL 性欲ゲージ減少処理(ARG)

;物陰から出てくる描写処理
CALL ゆきずりセックス_終了描写(ARG)

;ゆきずりセックス中フラグを消す
TCVAR:ARG:ゆきずりセックス_行為中 = 0
TCVAR:相手キャラ:ゆきずりセックス_行為中 = 0

;ゆきセNPCよ、さらば。
;CFLAG:相手キャラ:現在位置 = 999
;CFLAG:相手キャラ:現在マップ種別 = 0
;CFLAG:相手キャラ:滞在期間 = -1

;隠密とうふふ状態を解除する
CFLAG:ARG:隠密 = 0
CFLAG:ARG:キャラ同士うふふ = 0
CFLAG:相手キャラ:キャラ同士うふふ = 0

IF !CFLAG:ARG:うふふ
	;うふふじゃないなら全てのモードを消す
	CALL 特定キャラモードリセット(ARG)
ENDIF

;覗きバレフラグを消す
TCVAR:ARG:覗きバレ = 0

;使い魔覗き中だった場合は元の位置に戻りフラグを消す
SIF CFLAG:MASTER:使い魔覗き状態 == ARG
	CFLAG:MASTER:使い魔覗き状態 = 0

;覗かれ中であり、あなたが隠密状態なら、あなたの隠密を解除させる
SIF CFLAG:MASTER:隠密 && TCVAR:ARG:ゆきずりセックス_覗かれ中
	CFLAG:MASTER:隠密 = 0

;覗き中フラグを消す
TCVAR:ARG:ゆきずりセックス_覗かれ中 = 0

;終了時間を記録
TCVAR:ARG:ゆきずりセックス_終了時刻 = NOW()



;==================================================================================================
@SCHEDULE_その場でゆきずりセックス(ARG, 小分類, 処理内容)
;-------------------------------------------------
;ゆきずりセックス専用の割り込みスケジュール
;その場で隠密状態になり、短い間性行為を行う。
;フィールド効果「うふふ目撃スルー」が有効な場合は隠密状態にならない
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
#DIMS 小分類
#DIMS 処理内容
;--------------------------------------------------------------------------------------------------
相手キャラ = TCVAR:ARG:ゆきずりセックス_相手キャラID

SELECTCASE 処理内容
	CASE "開始処理"
		;目的地を現在位置に固定する
		スケジュール状態:ARG:目的地 = CFLAG:ARG:現在位置
		;共通開始処理
		CALL ゆきずりセックス_共通開始処理(ARG)
		
		;隠密状態にする
		CFLAG:ARG:隠密 = 1
		CFLAG:相手キャラ:隠密 = 1
		
		TCVAR:ARG:移動ルーチンインターバル時間 = 0
		RETURN 1
		
		
	CASE "経過処理"
		;隠密状態を維持する
		CFLAG:ARG:隠密 = 1
		
		;以下時間経過時に走る処理
		IF TIME_PROGRESS(TFLAG:行動前時刻)
			
			;キャラが女性のときは相手が、男性のときは自身が射精したら体位変更
			IF TCVAR:ARG:前ターン被射精位置 || TCVAR:相手キャラ:前ターン被射精位置
				;覗き中のみ絶頂描写
				SIF ゆきずり覗き中？(ARG) || 使い魔覗き対象？(ARG)
					CALL ゆきずりセックス_絶頂描写(ARG)
				
				;体位の変更
				CALL ゆきずりセックス内容決定(ARG,相手キャラ)
				;CALL ランダム挿入モードセット(相手キャラ,ARG)
				RETURN 0
			ENDIF
			
		ENDIF
		
	CASE "終了処理"
		;共通終了処理
		CALL ゆきずりセックス_共通終了処理(ARG, 相手キャラ);
		
		RETURN 1
		
		
ENDSELECT



;==================================================================================================
@SCHEDULE_自室でゆきずりセックス(ARG, 小分類, 処理内容)
;-------------------------------------------------
;ゆきずりセックス専用の割り込みスケジュール
;自室(もしくは自宅)へワープし、隠密状態にならない状態で長時間まで性行為を続ける
;性欲が高いほど自宅への連れ込み確率が高くなり、行為中は全裸になる
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
#DIMS 小分類
#DIMS 処理内容
;--------------------------------------------------------------------------------------------------
相手キャラ = TCVAR:ARG:ゆきずりセックス_相手キャラID

SELECTCASE 処理内容
	CASE "開始処理"
		;目的地をキャラクターの自室(もしくは自宅)に固定する
		スケジュール状態:ARG:目的地 = キャラクター部屋検索(ARG)
		スケジュール状態:ARG:目的マップ = 部屋検索_マップ種別
		;お相手も
		スケジュール状態:相手キャラ:目的地 = スケジュール状態:ARG:目的地
		スケジュール状態:相手キャラ:目的マップ = スケジュール状態:ARG:目的マップ
		
		;んでもってワープさせる
		CFLAG:ARG:現在位置 = スケジュール状態:ARG:目的地
		CFLAG:ARG:現在マップ種別 = スケジュール状態:ARG:目的マップ
		;お相手も
		CFLAG:相手キャラ:現在位置 = CFLAG:ARG:現在位置
		CFLAG:相手キャラ:現在マップ種別 = CFLAG:ARG:現在マップ種別
		
		;全裸になる
		CALL CLOTHES_CHANGE(ARG, "全裸")
		
		;共通開始処理
		CALL ゆきずりセックス_共通開始処理(ARG)
		
		TCVAR:ARG:移動ルーチンインターバル時間 = 0
		RETURN 1
		
		
	CASE "経過処理"
		
		;以下時間経過時に走る処理
		IF TIME_PROGRESS(TFLAG:行動前時刻)
			
			;キャラが女性のときは相手が、男性のときは自身が射精したら体位変更
			IF TCVAR:ARG:前ターン被射精位置 || TCVAR:相手キャラ:前ターン被射精位置
				;覗き中のみ絶頂描写
				SIF ゆきずり覗き中？(ARG) || 使い魔覗き対象？(ARG)
					CALL ゆきずりセックス_絶頂描写(ARG)
				
				;体位の変更
				CALL ゆきずりセックス内容決定(ARG,相手キャラ)
				;CALL ランダム挿入モードセット(相手キャラ,ARG)
				RETURN 0
			ENDIF
			
		ENDIF
		
	CASE "終了処理"
		;共通終了処理
		CALL ゆきずりセックス_共通終了処理(ARG, 相手キャラ);
		
		;服装を戻す
		CALL CLOTHES_RESET_TRAIN(ARG)
		
		RETURN 1
		
		
ENDSELECT



;==================================================================================================
@ゆきずりセックス_現在射精側取得(ARG, 相手キャラ)
#FUNCTION
;-------------------------------------------------
;今のモードで「射精を行う側」を取得する。
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
#DIM モード行
;--------------------------------------------------------------------------------------------------
;ARGが挿入側
モード行 = MODE_確認_完全一致("ＶＡ挿入系", ARG, 相手キャラ)
SIF モード行 >= 0
	RETURNF ARG

;相手キャラが挿入側
モード行 = MODE_確認_完全一致("ＶＡ挿入系", 相手キャラ, ARG)
SIF モード行 >= 0
	RETURNF 相手キャラ

;手コキは「実行キャラ, ペニス所有者」の順
;ARGが手コキされている側
モード行 = MODE_確認_完全一致("手コキ系", 相手キャラ, ARG)
SIF モード行 >= 0
	RETURNF ARG

;相手キャラが手コキされている側
モード行 = MODE_確認_完全一致("手コキ系", ARG, 相手キャラ)
SIF モード行 >= 0
	RETURNF 相手キャラ

;フェラチオは「実行キャラ, ペニス所有者」の順
;ARGがフェラチオされている側
モード行 = MODE_確認_完全一致("フェラチオ系", 相手キャラ, ARG)
SIF モード行 >= 0
	RETURNF ARG

;相手キャラがフェラチオされている側
モード行 = MODE_確認_完全一致("フェラチオ系", ARG, 相手キャラ)
SIF モード行 >= 0
	RETURNF 相手キャラ

;パイズリは「実行キャラ, ペニス所有者」の順
;ARGがパイズリされている側
モード行 = MODE_確認_完全一致("パイズリ系", 相手キャラ, ARG)
SIF モード行 >= 0
	RETURNF ARG

;相手キャラがパイズリされている側
モード行 = MODE_確認_完全一致("パイズリ系", ARG, 相手キャラ)
SIF モード行 >= 0
	RETURNF 相手キャラ


;該当する挿入モードがない
RETURNF -1



;==================================================================================================
@ゆきずりセックス_スケジュール遷移前処理(ARG, スケジュール番号)
;-------------------------------------------------
;延長が入った時にGET_NEXT_SCHEDULEが走る前にこれが走る
;--------------------------------------------------------------------------------------------------
#DIM スケジュール番号
#DIM 相手キャラ
#DIM 攻めキャラ
#DIM 受けキャラ
#DIMS スケジュール名
;--------------------------------------------------------------------------------------------------

スケジュール名 = %移動スケジュール文字列:ARG:スケジュール番号:スケジュール%

;終了中なら延長しない
SIF スケジュール状態:ARG:状況 == スケジュール_終了中
	RETURN

;ゆきずり以外は何もしない
SIF !GROUPMATCH(スケジュール名, "その場でゆきずりセックス", "自室でゆきずりセックス")
	RETURN


;まだ規定時間内
SIF TIME < スケジュール状態:ARG:終了予定時間
	RETURN

相手キャラ = TCVAR:ARG:ゆきずりセックス_相手キャラID
攻めキャラ = ゆきずりセックス_現在射精側取得(ARG, 相手キャラ)

;該当する挿入モードがない
SIF 攻めキャラ < 0
	RETURN

IF 攻めキャラ == ARG
	受けキャラ = 相手キャラ
ELSE
	受けキャラ = ARG
ENDIF

;攻めが射精できない場合は通常どおり終了
SIF !射精可能(攻めキャラ)
	RETURN

;手コキ中か確認
IF MODE_確認_完全一致("手コキ系", ARG, 相手キャラ) >= 0 || MODE_確認_完全一致("フェラチオ系", ARG, 相手キャラ) >= 0 || MODE_確認_完全一致("パイズリ系", ARG, 相手キャラ) >= 0
	;射精記録があれば終了
	SIF TCVAR:ARG:前ターン被射精位置 
		RETURN
		
ELSEIF MODE_確認_完全一致("手コキ系", 相手キャラ, ARG) >= 0  || MODE_確認_完全一致("フェラチオ系", 相手キャラ, ARG) >= 0  || MODE_確認_完全一致("パイズリ系", 相手キャラ, ARG) >= 0
	;射精記録があれば終了
	SIF  TCVAR:相手キャラ:前ターン被射精位置
		RETURN
		
ELSE
	;V・A性交は受け側への射精を確認
	IF TCVAR:受けキャラ:前ターン被射精位置
		;覗き中のみ絶頂描写
		SIF ゆきずり覗き中？(ARG) || 使い魔覗き対象？(ARG)
			CALL ゆきずりセックス_絶頂描写(ARG)
		
		;履歴登録
		CALL ゆきずりセックス_履歴登録_射精(ARG)
		
		RETURN
	ENDIF
	
ENDIF

;攻めが未射精なので1分だけ延長
スケジュール状態:ARG:終了予定時間 = TIME + 1



;==================================================================================================
@ゆきずりセックス_中断処理(ARG)
;-------------------------------------------------
;対象のゆきずりセックスを中断させます
;--------------------------------------------------------------------------------------------------
#DIMS 現スケ確認
;--------------------------------------------------------------------------------------------------
;ゆきずり中でなければ遭遇処理をしない
SIF !IS_ゆきずりセックス中(ARG)
	RETURN

;スケジュールを確認
現スケ確認 '= 移動スケジュール文字列:ARG:(スケジュール状態:ARG:現在スケジュール):スケジュール
SIF !(現スケ確認 == "その場でゆきずりセックス"  || 現スケ確認 == "自室でゆきずりセックス")
	RETURN


;終了処理へ進める
スケジュール状態:ARG:状況 = スケジュール_終了中
スケジュール状態:ARG:終了予定時間 = TIME

CALL RUN_SCHEDULE(ARG)
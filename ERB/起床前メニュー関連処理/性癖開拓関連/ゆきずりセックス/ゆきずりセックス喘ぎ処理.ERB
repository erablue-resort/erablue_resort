;==================================================================================================
@ゆきずりセックス_口上処理(ARG, 場面 = "行為中", 射精部位 = -1)
;-------------------------------------------------
;ゆきずりを覗いている際の専用口上を表示する
;表示した場合は1、対象外なら0を返す
;--------------------------------------------------------------------------------------------------
#DIM 相手キャラ
#DIMS 描写状況
#DIMS 場面
#DIM 射精部位
;--------------------------------------------------------------------------------------------------

;不正なキャラ番号
SIF !INRANGE(ARG, 1, CHARANUM - 1)
	RETURN 0

;ゆきずり中でなければ対象外
SIF !IS_ゆきずりセックス中(ARG)
	RETURN 0

;開始・遭遇は、同室または使い魔観察中なら許可
;開始は、遠隔覗きモードへ移る前の使い魔プレビューも許可する
IF GROUPMATCH(場面, "開始", "遭遇_みせつけ", "遭遇_強制続行")
	SIF !IS_SAME_ROOM(ARG, MASTER) && !使い魔覗き対象？(ARG) && !(場面 == "開始" && TCVAR:ARG:使い魔覗き中)
		RETURN 0
ELSE
	SIF !ゆきずり覗き中？(ARG) && !使い魔覗き対象？(ARG)
		RETURN 0
ENDIF

相手キャラ = TCVAR:ARG:ゆきずりセックス_相手キャラID

;相手が消えていた場合の保険
SIF !INRANGE(相手キャラ, 1, CHARANUM - 1)
	RETURN 0

;既存の14分岐を表す文字列を取得
描写状況 '= ゆきずりセックス_描写状況取得(ARG)

;口上格納領域を初期化
CALL 口上変数初期化

;-------------------------------------------------
;ネームドキャラの固有ゆきずり口上
;-------------------------------------------------
IF CFLAG:ARG:人物番号 >= 0
	IF EXISTFUNCTION(@"ゆきずりセックス_固有口上_%CSTR:ARG:口上切り替えキー%{NO:ARG}")
		CALLFORM ゆきずりセックス_固有口上_%CSTR:ARG:口上切り替えキー%{NO:ARG}(ARG, 相手キャラ, 場面, 描写状況, 射精部位)
	ENDIF
ENDIF

;-------------------------------------------------
;快楽が発生していれば、ゆきずり専用喘ぎも追加
;-------------------------------------------------
IF 場面 == "行為中"
	;固有口上があれば、喘ぎとの間に空白行を挟む
	IF 口上有無確認(0, 1)
		KSTR:(K++) '= "　"
	ENDIF
	
	CALL 喘ぎ内容取得(ARG)
ENDIF

;-------------------------------------------------
;格納された口上を表示
;待機を挟まないよう第2引数は1
;-------------------------------------------------
IF 口上有無確認(0, 1)
	PRINTL
	CALL 口上変数表示(ARG, 1)
	PRINTL
ENDIF

;後続処理へ口上を残さない
CALL 口上変数初期化

RETURN 1



;==================================================================================================
@ゆきずりセックス_喘ぎ文節(文節数, 喘ぎレベル, キャラ番号)
#FUNCTIONS
#DIM キャラ番号
#DIM 喘ぎレベル
#DIM 文節数
#DIMS 文字返り値
#DIMS 文節保存
#DIMS 自称単語


;通常喘ぎと同じ基本文字・接続文字・ハート数を使い、二人称の候補は含めない
自称単語 '= CSTR:キャラ番号:一人称

SELECTCASE 文節数
	CASE 1
		LOCALS '= ""
		STRDATA 文字返り値
			DATAFORM 「%汎用喘ぎ基礎文字(喘ぎレベル)%っ……%LOCALS%%汎用喘ぎハート数返り(喘ぎレベル)%」
			DATAFORM 「%汎用喘ぎ基礎文字(喘ぎレベル)%%汎用喘ぎ接続文字()% %LOCALS%%汎用喘ぎハート数返り(喘ぎレベル)%」
			DATAFORM 「%LOCALS%%汎用喘ぎ接続文字()%%汎用喘ぎ基礎文字(喘ぎレベル)%%汎用喘ぎハート数返り(喘ぎレベル)%」
			DATAFORM 「%LOCALS%%汎用喘ぎ接続文字()%っ%汎用喘ぎハート数返り(喘ぎレベル)%」
		ENDDATA
	CASEELSE
		文字返り値 = 
		IF 自称単語 != ""
			STRDATA LOCALS
				DATAFORM 
				DATAFORM 
				DATAFORM %自称単語%っ 
				DATAFORM %自称単語%_H_ 
				DATAFORM %自称単語%、もぅ… 
				DATAFORM %SUBSTRINGU(自称単語, 0, 1)%っ %自称単語%_H_ 
			ENDDATA
		ELSE
			LOCALS '= ""
		ENDIF
		LOCAL:1 = RAND:文節数
		FOR LOCAL, 0, 文節数
			STRDATA 文節保存
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%っ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%ッ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%、%汎用喘ぎ基礎文字(喘ぎレベル)%っ……%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%、%汎用喘ぎ基礎文字(喘ぎレベル)%っ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%、%汎用喘ぎ基礎文字(喘ぎレベル)%ッ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%、%汎用喘ぎ基礎文字(喘ぎレベル)%、%汎用喘ぎ基礎文字(喘ぎレベル)%%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ接続文字()%、%汎用喘ぎ基礎文字(喘ぎレベル)%、%汎用喘ぎ基礎文字(喘ぎレベル)%っ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ接続文字()%、%汎用喘ぎ接続文字()%、%汎用喘ぎ基礎文字(喘ぎレベル)%っ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%、%汎用喘ぎ接続文字()%、%汎用喘ぎ接続文字()%っ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%──っ%汎用喘ぎハート数返り(喘ぎレベル)%
				DATAFORM %汎用喘ぎ基礎文字(喘ぎレベル)%……っ%汎用喘ぎハート数返り(喘ぎレベル)%
			ENDDATA
			SIF LOCAL == LOCAL:1 && LOCALS != ""
				文字返り値 += @"　%LOCALS%"
			文字返り値 += @"　%文節保存%"
		NEXT
		;先頭の全角スペースを削除
		SUBSTRING 文字返り値, 2, -1
		文字返り値 = 「%RESULTS%」
ENDSELECT

RETURNF 文字返り値

SIF CFLAG:MASTER:使い魔覗き状態 <= 0 || CFLAG:MASTER:使い魔覗き状態 >= CHARANUM
	RETURNF 0
SIF ARG == CFLAG:MASTER:使い魔覗き状態 || ARG == TCVAR:(CFLAG:MASTER:使い魔覗き状態):ゆきずりセックス_相手キャラID
	RETURNF 1

RETURNF 0


;==================================================================================================
@同行者がいる？
#FUNCTION
;-------------------------------------------------
;あなたに同行者がいるかを確認し、一人でもいる場合は1を、いない場合は0を返します。
;--------------------------------------------------------------------------------------------------
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	
	IF CFLAG:LOCAL:同行 > 0 || CFLAG:LOCAL:デート == MASTER + 100
		RETURNF 1
	ENDIF
NEXT

RETURNF 0




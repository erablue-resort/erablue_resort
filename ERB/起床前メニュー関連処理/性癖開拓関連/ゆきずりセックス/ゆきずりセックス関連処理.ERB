;==================================================================================================
@ゆきずりセックス判定(ARG)
;-------------------------------------------------
;ARG番のキャラがゆきずりセックスを実行するかを返す関数
;実行する場合フラグ立てまで行う
;開始時, 実行中には1を返す
;終了時, 開始しない時, 途中終了時には0を返す
;--------------------------------------------------------------------------------------------------
;#DIM 性癖レベル
;--------------------------------------------------------------------------------------------------
;フラグの正常性確認
;CALL ゆきずりセックス_フラグ修正処理(ARG)

;行為中にあなたが物陰に入ってきた処理
CALL ゆきずりセックス_遭遇処理(ARG)

;開始できるかチェック
SIF ゆきずりセックス開始可能？(ARG)
	RETURN 0

;処理を実行するかチェック
SIF ゆきずりセックス実行判定(ARG)
	RETURN 0

CALL ゆきずりセックス_実行処理(ARG)

RETURN RESULT



;==================================================================================================
@ゆきずりセックス_フラグ修正処理(ARG)
;-------------------------------------------------
;フラグの正常性を確認し、修正する処理
;--------------------------------------------------------------------------------------------------

;--------------------------------------------------------------------------------------------------
;隠密でない状態で覗き中になるのは異常なため、フラグを修正
;SIF TCVAR:ARG:ゆきずりセックス_覗かれ中 && !CFLAG:PLAYER:隠密
;	TCVAR:ARG:ゆきずりセックス_覗かれ中 = 0
;
;覗かれ中じゃな使い魔覗き中になるのは異常なため、フラグを修正
;SIF !TCVAR:ARG:ゆきずりセックス_覗かれ中
;	TCVAR:ARG:使い魔覗き中 = 0

;あなたとゆきずりキャラが同じ位置にいないのに覗かれ中になるのは異常
;IF CFLAG:ARG:現在位置 != CFLAG:PLAYER:現在位置 && TCVAR:ARG:ゆきずりセックス_覗かれ中
;	TCVAR:ARG:ゆきずりセックス_覗かれ中 = 0
;ENDIF


;==================================================================================================
@ゆきずりセックス開始可能？(ARG)
#FUNCTION
;-------------------------------------------------
;ゆきずりセックスができない状況を確認し、開始できるかを判定する関数
;「開始できる」場合は0を、「開始できない」場合は1を返す
;--------------------------------------------------------------------------------------------------

;--------------------------------------------------------------------------------------------------
;*****************************************************************
;;実年齢が未成年と明示されているキャラは対象外
;SIF GROUPMATCH(TALENT:ARG:年齢層, 10, 11)
;    RETURNF 1
;
;SIF BASE:ARG:年齢 > 0 && BASE:ARG:年齢 < 18
;    RETURNF 1
;
;;外見が幼い・若いと設定されたキャラも対象外
;SIF GROUPMATCH(TALENT:ARG:外見年齢, 10, 11)
;    RETURNF 1
;*****************************************************************

;直前の行動が時間が経過しないコマンドの場合は処理をスキップ
SIF !TIME_PROGRESS(TFLAG:行動前時刻)
	RETURNF 1

;すでにヤッてるならスキップ
SIF IS_ゆきずりセックス中(ARG)
	RETURNF 1
	
;火遊び抑制ならここではじく
SIF TALENT:ARG:火遊び抑制 == 3
	RETURNF 1
;ED持ちでもはじく
SIF TALENT:ARG:ＥＤ
	RETURNF 1

;睡眠中は素直に寝てなさい
SIF CFLAG:ARG:睡眠
	RETURNF 1
;ダウン中も素直に寝てなさい
SIF BASE:ARG:体力 < 1
	RETURNF 1

;あなた宅、もしくは自室では発生しない
SIF CFLAG:ARG:現在マップ種別 == 0 && (CFLAG:ARG:現在位置 >= 2000 || CFLAG:ARG:現在位置 == 20)
	RETURNF 1
;宿泊エリアでは発生しない
SIF CFLAG:ARG:現在マップ種別 > 4
	RETURNF 1
;居住区の家では発生しない
SIF CFLAG:ARG:現在マップ種別 == 2 && CFLAG:ARG:現在位置 >= 1000
	RETURNF 1
;脱衣所、風呂場などの異性禁止エリアでは発生しない
SIF CFLAG:ARG:現在マップ種別 == 0 && (CFLAG:ARG:現在位置 >= 7 && CFLAG:ARG:現在位置 <= 14)
	RETURNF 1
SIF CFLAG:ARG:現在マップ種別 == 0 && (CFLAG:ARG:現在位置 >= 700 && CFLAG:ARG:現在位置 <= 900)
	RETURNF 1

;性知識が無い場合は誘わない
SIF 知識素質:ARG:性知識 < 0
	RETURNF 1
;性感帯無い場合も発生しない
SIF !HAS_EROGENOUS_ZONE(ARG)
	RETURNF 1
	
;同行中はやんないよ
SIF CFLAG:ARG:同行
	RETURNF 1
SIF CFLAG:ARG:一緒に遊ぶ
	RETURNF 1
SIF CFLAG:ARG:デート
	RETURNF 1
SIF CFLAG:ARG:うふふ
	RETURNF 1
SIF MODE_存在判定_いずれか側("同行系", ARG)
	RETURNF 1
SIF MODE_存在判定_いずれか側("キス系", ARG)
	RETURNF 1
SIF MODE_存在判定_ターゲット側("全裸散歩", ARG)
	RETURNF 1
SIF MODE_存在判定_いずれか側("ハーヴィンオナホ系", ARG)
	RETURNF 1

;既に誰かが同じ場所で隠密してるなら発生しない
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == ARG
		CONTINUE
	SIF IS_SAME_ROOM(ARG, LOCAL) && CFLAG:LOCAL:隠密
		RETURNF 1
NEXT

;興味の場合は1時間、愛好の場合は30分、中毒の場合は15分毎にそれぞれ判定を発生させる
SELECTCASE 性癖素質:ARG:ゆきずりセックス
	CASE 1
		SIF TCVAR:ARG:ゆきずりセックス_終了時刻 + 1 * 60 > NOW()
			RETURNF 1
	CASE 2
		SIF TCVAR:ARG:ゆきずりセックス_終了時刻 + 1 * 30 > NOW()
			RETURNF 1
	CASE 3
		SIF TCVAR:ARG:ゆきずりセックス_終了時刻 + 1 * 15 > NOW()
			RETURNF 1
ENDSELECT

RETURNF 0



;==================================================================================================
@ゆきずりセックス実行判定(ARG)
#FUNCTION
;-------------------------------------------------
;ARG番のキャラがゆきずりセックスを実行するかを返す関数
;誘い/誘われ判定を行い、結果に応じて誘いフラグを立てる
;「実行する」場合には0を返し、「実行しない」場合は1を返す
;--------------------------------------------------------------------------------------------------
;●ビット0(誘い、誘われ)の設定
IF ゆきずりセックス誘い判定(ARG)
	CLEARBIT TCVAR:ARG:ゆきずりセックス_誘い, 0
ELSEIF ゆきずりセックス誘われ判定(ARG)
	SETBIT TCVAR:ARG:ゆきずりセックス_誘い, 0
ELSE
	;いずれの判定もすり抜けた場合は「実行しない」を返す
	RETURNF 1
ENDIF


;●ビット1(場所:0:その場、1:自室)の設定
;最初にビット1に0をセットしておく
CLEARBIT TCVAR:ARG:ゆきずりセックス_誘い, 1

;現在地にゆきずり中のキャラクターがいるなら自室確定
FOR LOCAL,1,CHARANUM
	SIF LOCAL == ARG
		CONTINUE
	IF IS_ゆきずりセックス中(LOCAL) && (CFLAG:LOCAL:現在位置 == CFLAG:ARG:現在位置 && CFLAG:LOCAL:現在マップ種別 == CFLAG:ARG:現在マップ種別)
		SETBIT TCVAR:ARG:ゆきずりセックス_誘い, 1
		BREAK
	ENDIF
NEXT

;現在の勃起度に応じた確率で(50~100%)
SIF 性癖素質:ARG:同性愛 && RAND:100 < MAX(BASE:ARG:勃起*100/MAX(MAXBASE:ARG:勃起, 1),50)
	SETBIT TCVAR:ARG:ゆきずりセックス_誘い, 1

;「実行する」を返す
RETURNF 0



;==================================================================================================
@ゆきずりセックス誘い判定(ARG)
#FUNCTION
;-------------------------------------------------
;ARG番のキャラがNPCを誘う判定
;誘い成功時に1、失敗時に0を返す
;--------------------------------------------------------------------------------------------------
#DIM 判定値
;--------------------------------------------------------------------------------------------------
;ナンパ傾向が[誘われ待ち]なら無条件で失敗
SIF TALENT:ARG:ナンパ傾向 < 0
	RETURNF 0

;係数を現在の性欲割合で初期化
判定値 = (BASE:ARG:性欲 * 100) / MAXBASE:ARG:性欲

;基本閾値に上限を設ける
判定値 = MIN(30,判定値)


;素質によって上限値を超えた補正をかける

;素質[淫乱]所持している +10%
SIF TALENT:ARG:淫乱
	判定値 = 判定値 * 110 / 100

;最終閾値で判定を行う
SIF 判定値 > RAND:100
	RETURNF 1

;失敗を返す
RETURNF 0



;==================================================================================================
@ゆきずりセックス誘われ判定(ARG)
#FUNCTION
;-------------------------------------------------
;ARG番のキャラがNPCに誘われる判定
;性的魅力に関わる素質や誘う側が優位に立てそうな素質に影響。
;対象キャラの性欲値は影響しない。
;「エロい人」や「気の弱そうな人」、「優しそうな人」は誘われやすくなり、
;「見た目が子供」「怖そうな人」「厳しそうな人」「断られそうな人」は若干誘われにくくなる。
;誘い成功時に1、失敗時に0を返す
;--------------------------------------------------------------------------------------------------
#DIM 判定値
;--------------------------------------------------------------------------------------------------
;ナンパ傾向が[ナンパ師]なら無条件で失敗
SIF TALENT:ARG:ナンパ傾向 > 0
	RETURNF 0

;係数の初期化
判定値 = 20

;○「エロい人」判定の素質群
;素質[淫乱]所持している
SIF TALENT:ARG:淫乱
	判定値 += 10

;素質[恥薄い]所持している
SIF TALENT:ARG:羞恥心 < 0
	判定値 += 5

;巨乳以上である
SIF TALENT:ARG:バストサイズ > 0
	判定値 += 5

;発情期中である なんかそういうフェロモンでてそう
SIF CFLAG:ARG:発情期フラグ < 0
	判定値 += 5

;○「気の弱そうな人」判定の素質群
;素質[臆病]所持している
SIF TALENT:ARG:度胸 < 0
	判定値 += 5

;素質[押しに弱い]所持している
SIF TALENT:ARG:マイペース < 0
	判定値 += 5

;素質[プライド低い]所持している
SIF TALENT:ARG:プライド < 0
	判定値 += 5

;○「優しそうな人」判定の素質群
;素質[素直]所持している
SIF TALENT:ARG:態度 < 0
	判定値 += 5

;素質[大人しい]所持している
SIF TALENT:ARG:応答 < 0
	判定値 += 5

;素質[淑女的]所持している
SIF TALENT:ARG:精神的余裕 == 2
	判定値 += 5

;素質[面倒見が良い]所持している
SIF TALENT:ARG:無関心 < 0
	判定値 += 5


;●マイナス判定の素質群
;素質[気丈]所持している
SIF TALENT:ARG:度胸 > 0
	判定値 -= 2

;素質[反抗的]所持している
SIF TALENT:ARG:態度 > 0
	判定値 -= 2

;素質[プライド高い]所持している
SIF TALENT:ARG:応答 > 0
	判定値 -= 2

;素質[生意気]所持している
SIF TALENT:ARG:プライド > 0
	判定値 -= 2

;素質[ツンデレ]所持している
SIF TALENT:ARG:ツンデレ
	判定値 -= 2

;素質[真面目][自制心]所持している
SIF TALENT:ARG:自制心 > 0
	判定値 -= 2

;素質[無関心]所持している
SIF TALENT:ARG:無関心 > 0
	判定値 -= 2

;素質[抵抗]所持している
SIF TALENT:ARG:抵抗
	判定値 -= 2
	
;見た目が子供っぽい
SIF TALENT:ARG:外見年齢 == 10 || TALENT:ARG:外見年齢 == 11
	判定値 -= 2

;最終閾値で判定を行う
SIF 判定値 > RAND:100
	RETURNF 1

;失敗を返す
RETURNF 0



;==================================================================================================
@ゆきずりセックス_遭遇処理(ARG)
;-------------------------------------------------
;ゆきずりセックス中のキャラクターがいるところで「物陰に隠れる」を行った時の処理
;通常は「中断」だが、確率によって「みせつけ」「強制続行」に分岐する。
;--------------------------------------------------------------------------------------------------
#DIM バレ反応
;--------------------------------------------------------------------------------------------------
;覗き中でなく、同じ部屋で隠密状態のときに発生
IF !TCVAR:ARG:ゆきずりセックス_覗かれ中 && CFLAG:MASTER:隠密 && IS_SAME_ROOM(ARG, MASTER) && IS_ゆきずりセックス中(ARG)
	
	;先にバレ反応を取得
	バレ反応 = ゆきずりセックス_バレ反応取得(ARG)
	
	;描写処理
	CALL ゆきずりセックス_遭遇描写(ARG,バレ反応)
	
	;バレ反応が「中断」なら処理を終わらせる
	IF バレ反応 == 0
		;中断
		CALL ゆきずりセックス_中断処理(ARG)
		;あなたの隠密も解除する
		CFLAG:MASTER:隠密 = 0
	ELSE
		;覗きフラグを立てる
		TCVAR:ARG:ゆきずりセックス_覗かれ中 = 1
	ENDIF

ENDIF



;==================================================================================================
@ゆきずりセックス_バレ反応取得(ARG)
#FUNCTION
;-------------------------------------------------
; 0:中断 1:みせつけ 2:強制続行 の3パターンを返す。
; 素質により確率が変動し、インモラルな素質ほど「見せつけ」が発生する確率が高くなる。
; 「中断」となった時に確率で「強制続行」となる。
;--------------------------------------------------------------------------------------------------
#DIM 見せつけ確率
;--------------------------------------------------------------------------------------------------
;●「見せつけ」確定素質群
;[淫乱]
SIF TALENT:ARG:淫乱
	RETURNF 1
;[恥薄い]
SIF TALENT:ARG:羞恥心 < 0
	RETURNF 1
;[貞操無頓着]
SIF TALENT:ARG:貞操 < 0
	RETURNF 1


;見せつけ確率を初期50%で設定
見せつけ確率 = 50

;性癖強度が中毒までいくと慣れにより見せつけがぐんと高くなる
SIF 性癖素質:ARG:ゆきずりセックス > 2
	見せつけ確率 = 80

;〇「見せつけ」確率低下素質群
;[恥じらい]
SIF TALENT:ARG:羞恥心
	見せつけ確率 -= 100
;[貞操観念]
SIF TALENT:ARG:貞操
	見せつけ確率 -= 30
;[自制心][真面目]
SIF TALENT:ARG:自制心
	見せつけ確率 -= 20
;[保守的]
SIF TALENT:ARG:性的興味 < 0
	見せつけ確率 -= 20

;●「見せつけ」確率上昇素質群
;[目立ちたがり]
SIF TALENT:ARG:目立ちたがり
	見せつけ確率 += 20
;[性欲強い]
SIF TALENT:ARG:性欲
	見せつけ確率 += 20
;[経験豊富]
SIF TALENT:ARG:経験豊富
	見せつけ確率 += 20
;[倒錯的]
SIF TALENT:ARG:倒錯的
	見せつけ確率 += 20

;見せつけ判定を行う
SIF RAND:100 < 見せつけ確率
	RETURNF 1

;中断時半分の確率で「強制続行」となる
SIF RAND:2
	RETURNF 2

;すべての判定をすり抜けた場合「中断」を返す
RETURNF 0




							PRINTFORML 発情の熱が引かない女は、離れかけた%CALLNAME:ARG%へ縋りつき、切実な吐息を漏らした。
							PRINTFORMW 彼は求め続ける体をもう一度抱き上げ、%最奥表現%へ届く深さで責め続けることにした……
					ENDSELECT
				CASEELSE
					;▼普通の女性客。専用の特徴を持たないため汎用描写を3種から選ぶ
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW それでも満足しない%CALLNAME:ARG%は女を離さず、すぐに次の交わりを始めた……
						CASE 1
							PRINTFORML 女が余韻に浸る間もなく、%CALLNAME:ARG%はその腰を抱き寄せ、まだ終わりではないと囁いた。
							PRINTFORMW 彼は再び熱を帯びた肉棒を%挿入部位%へ押し当て、次の交わりを始めた……
						CASE 2
							PRINTFORML %CALLNAME:ARG%は荒い息を吐きながら女の反応を眺め、満足するにはまだ早いと笑った。
							PRINTFORMW 彼は休もうとする女の脚をもう一度開かせ、%最奥表現%を抉るように腰を重ね始めた……
					ENDSELECT
			ENDSELECT
		ELSE
			;▼奉仕後も満足せず、さらに口での奉仕を続けさせる
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 女が口元を拭って息を整えると、%CALLNAME:ARG%はその顎へ手を添えて顔を上げさせた。
					PRINTFORML 彼はまだ終わりではないと告げ、萎えきらない肉棒を女の唇へもう一度押し当てる。
					PRINTFORMW 女は余韻に濡れた舌を差し出し、熱を取り戻させるように次の奉仕を始めた……
				CASE 1
					PRINTFORML %CALLNAME:ARG%は膝をついたままの女を見下ろし、尿道内に残る余韻まで舐め取るよう命じた。
					PRINTFORML 女が唇と舌を動かし始めると、彼はその髪を撫でながら再び硬さを増す肉棒を導いていく。
					PRINTFORMW やがて女の口が深く沈み、二度目の奉仕が湿った音とともに始まった……
				CASE 2
					PRINTFORML 女がようやく肉棒を口から離すと、%CALLNAME:ARG%は休もうとする肩へ手を置いて引き留めた。
					PRINTFORML 彼は女の濡れた頬を撫で、まだ奉仕が足りないと告げて再び自分の腰へ向き直らせる。
					PRINTFORMW 女は熱い息を吐きながら唇を開き、求められるまま肉棒を咥え直した……
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	IF TCVAR:ARG:覗きバレ
		;▼覗きがバレている状態で行為終了
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 満足した二人が服を整え始め、%CALLNAME:ARG%もこちらへ目を向けたため、%CALLNAME:PLAYER%は急いでその場を離れた。
			CASE 1
				PRINTFORMW 女が乱れた衣服を直す傍らで、%CALLNAME:ARG%がこちらを咎めるように見据えたため、%CALLNAME:PLAYER%は慌ててその場を後にした。
		ENDSELECT
	ELSE
		;▼覗きに気付かれないまま行為終了
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 満足した二人が服を整え始めたため、%CALLNAME:PLAYER%は気付かれないよう静かにその場を離れた。
			CASE 1
				PRINTFORMW 二人が余韻を残しながら身支度を始めたのを見届け、%CALLNAME:PLAYER%は物音を立てぬようそっとその場を後にした。
		ENDSELECT
	ENDIF
ENDIF


;==================================================================================================
@ゆきずりセックス内容決定_攻め(ARG)
;-------------------------------------------------
;男性キャラクターが見知らぬ女性に行うプレイ内容を決定する
;体位0:奉仕を受ける、1:Ｖ挿入、2:Ａ挿入
;--------------------------------------------------------------------------------------------------
#DIMS プレイ内容
#DIM Ｖ性交重み
#DIM Ａ性交重み
#DIM 奉仕重み
#DIM 重み合計
;--------------------------------------------------------------------------------------------------

;途中終了後に前回の体位を持ち越さない
TCVAR:ARG:ゆきずりセックス_体位 = 0

IF TCVAR:ARG:ゆきずりセックス_誘い
	;相手から誘われた場合は、許可された挿入とフェラチオを均等に抽選する
	;純潔設定が有効な場合、未経験の挿入先は候補から外す
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 0))
		Ｖ性交重み = 1
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 1))
		Ａ性交重み = 1
	奉仕重み = 1
ELSE
	;キャラクターから誘った場合は、能力と経験に応じて行為を抽選する
	;純潔設定が有効な場合、未経験の挿入先は候補から外す
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 0))
		Ｖ性交重み = MAX(1, ABL:ARG:技巧)
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 1))
		Ａ性交重み = MAX(1, ABL:ARG:技巧)

	;対応する挿入経験100回ごとに重みを1加算する
	SIF Ｖ性交重み
		Ｖ性交重み += EXP:ARG:Ｃ性交経験_Ｖ挿入 / 100
	SIF Ａ性交重み
		Ａ性交重み += EXP:ARG:Ｃ性交経験_Ａ挿入 / 100
	;奉仕は欲望に応じて重みを得る
	奉仕重み = MAX(1, ABL:ARG:欲望)

	;候補が二つ以上ある場合、どの行為も抽選率が50%を超えないよう重みを制限する
	;候補が一つしかない場合は、成立する行為を優先するため制限しない
	IF Ａ性交重み + 奉仕重み
		Ｖ性交重み = MIN(Ｖ性交重み, Ａ性交重み + 奉仕重み)
	ENDIF
	IF Ｖ性交重み + 奉仕重み
		Ａ性交重み = MIN(Ａ性交重み, Ｖ性交重み + 奉仕重み)
	ENDIF
	IF Ｖ性交重み + Ａ性交重み
		奉仕重み = MIN(奉仕重み, Ｖ性交重み + Ａ性交重み)
	ENDIF
ENDIF

重み合計 = Ｖ性交重み + Ａ性交重み + 奉仕重み

IF 重み合計
	SELECTCASE RAND:重み合計
		CASE IS < 奉仕重み
			プレイ内容 = フェラチオ

		CASE 奉仕重み TO 奉仕重み+Ｖ性交重み-1
			SELECTCASE RAND:6
				CASE 0
					プレイ内容 = 正常位
				CASE 1
					プレイ内容 = 後背位
				CASE 2
					プレイ内容 = 寝バック
				CASE 3
					プレイ内容 = 騎乗位
				CASE 4
					プレイ内容 = 対面立位
				CASE 5
					プレイ内容 = 立ちバック
			ENDSELECT
			TCVAR:ARG:ゆきずりセックス_体位 = 1
			IF !GETBIT(TALENT:ARG:非童貞, 0)
				CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>出会ったばかりの女性に自ら童貞を捧げてしまった</font><img src='えっちハート'>","うふふ")
			ENDIF
			SETBIT TALENT:ARG:非童貞, 0
			EXP:ARG:Ｃ性交経験_Ｖ挿入 ++

		CASEELSE
			SELECTCASE RAND:6
				CASE 0
					プレイ内容 = Ａ正常位
				CASE 1
					プレイ内容 = Ａ後背位
				CASE 2
					プレイ内容 = Ａ寝バック
				CASE 3
					プレイ内容 = Ａ騎乗位
				CASE 4
					プレイ内容 = Ａ対面立位
				CASE 5
					プレイ内容 = Ａ立ちバック
			ENDSELECT
			TCVAR:ARG:ゆきずりセックス_体位 = 2
			IF !GETBIT(TALENT:ARG:非童貞, 1)
				CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>出会ったばかりの女性で初めてアナルへ挿入した</font><img src='えっちハート'>","うふふ")
			ENDIF
			SETBIT TALENT:ARG:非童貞, 1
			EXP:ARG:Ｃ性交経験_Ａ挿入 ++
	ENDSELECT
ELSE
	;純潔設定で挿入できず、相手を誘った場合も最低限の行為を成立させる
	プレイ内容 = フェラチオ
ENDIF

CSTR:ARG:ゆきずりセックス_プレイ内容 = %プレイ内容%

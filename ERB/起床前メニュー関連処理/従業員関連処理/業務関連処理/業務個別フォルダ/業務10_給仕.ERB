

@従業員業務_文字列取得_10(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "給仕"
	CASE "業務説明"
		返し文字列 += "リゾート内の食堂で給仕を担当する業務。<br>"
		返し文字列 += "効果：料理メニューの効果によるルピ収入が<br>"
		返し文字列 += "　　　［（仕事レベル＋１）✕５］％増加する。<br>"
		返し文字列 += "　　　複数人の効果は加算されるが、上限は<br>"
		返し文字列 += "　　　［滞在人数÷１０］％まで。（モブ・ユニーク合算）<br>"

		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_10(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 1
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		RETURNF 1
ENDSELECT


@従業員業務_処理関数_10(動作モード, 対象キャラ)
#DIM 対象キャラ
#DIMS 動作モード
#DIM 業務量

SELECTCASE 動作モード
	CASE "一日終了時処理_キャラ"
		仕事人数表示用:給仕担当人数 ++
		業務別報告文字列:10 += @"%CALLNAME:対象キャラ, 18, LEFT%は"
		;男の娘が男性客にセクハラされてるとかがあってもいい。判別がきついけど(固有素質or特殊性別くらいしか判断できる場所がない)
		;従業員制服がエロかったら視線が露骨になる、みたいなのがあったりしてもいいかも？
		IF TALENT:対象キャラ:性別 == 2 && RAND:3 == 0
		;とりあえずおためしで女だけ
			IF 知識素質:対象キャラ:性知識 == -2
			;無知の場合されるがまま
				業務別報告文字列:10 += @"、%TEXTR("男性客とのすれ違いざま/給仕の道すがら男性客")%に掠めるようにお尻を触られたりしながらも"
				業務別報告文字列:10 += @"%TEXTR("頑張って給仕をしている。/忙しなく給仕をしている。/愛想よく給仕をしている。")%<br>"
			ELSEIF 性癖素質:対象キャラ:ゆきずりセックス >= 1
			;ゆきずりの相手との行為に抵抗がないので客からのセクハラはしたたかに利用する。リゾートの売り上げに含めるかどうかは考え中……別に全部この子のチップってことでもいいのよね……
				IF TALENT:対象キャラ:バストサイズ >= 1
					業務別報告文字列:10 += @"%TEXTR("男性客に胸の谷間へルピ硬貨を押し込まれるのを嬉々として受け入れながら/ルピを対価にセクハラを許容しながら")%ルピを対価にセクハラを許容しながら%TEXTR("笑顔で/忙しなく/愛想よく")%給仕している。<br>"
				ELSE
					業務別報告文字列:10 += @"%TEXTR("男性客に胸元へルピ硬貨を押し込まれるのを嬉々として受け入れながら/ルピを対価にセクハラを許容しながら")%%TEXTR("笑顔で/忙しなく/愛想よく")%給仕している。<br>"
				ENDIF
			ELSEIF TALENT:対象キャラ:バストサイズ >= 1
				業務別報告文字列:10 += @"%TEXTR("料理を運ぶたびに/給仕のたびに")%揺れる胸に%TEXTR("男性/")%客の視線を%TEXTR("浴び/集め")%ながらも"
				業務別報告文字列:10 += @"%TEXTR("頑張って給仕をしている/笑顔を崩さず給仕をしている/愛想よく給仕をしている")%……<br>"
			ELSE
				IF RAND:2 == 0
					IF 陥落チェック_性的(対象キャラ)
					;陥落済みキャラの場合、あなたのものに手を出した罰金はあなたに差し出して褒めてもらいにくる
						業務別報告文字列:10 += @"給仕中にセクハラしてきた客から罰金としてチップを巻き上げ、売り上げとして計上した。<br>"
						RSTR:リゾート収支計算_記録文字列 += @"セクハラ客への罰金によるルピ利益：2000<br>"
						MONEY += 2000
					ELSE
					;未陥落の場合、巻き上げたチップは自身の懐に入る
						業務別報告文字列:10 += @"給仕中にセクハラしてきた客から罰金としてチップを巻き上げたようだ……<br>"
					ENDIF
				ELSE
					業務別報告文字列:10 += @"客のセクハラを%TEXTR("適当にあしらい/巧みにかわし")%ながら"
					業務別報告文字列:10 += @"%TEXTR("頑張って給仕をしている。/忙しなく給仕をしている。/愛想よく給仕をしている。")%<br>"
				ENDIF
			ENDIF
		ELSE
			業務別報告文字列:10 += @"%TEXTR("頑張って給仕をしている。/忙しそうに給仕をしている。/愛想よく給仕をしている。")%<br>"
		ENDIF
		;経験値取得とレベル上昇
		仕事経験値:対象キャラ:10 += 1
		IF 仕事レベル:対象キャラ:10 < 5
			IF 仕事経験値:対象キャラ:10 >= 仕事レベル経験値テーブル:(仕事レベル:対象キャラ:10 + 1)
				仕事レベル:対象キャラ:10 += 1
				業務別報告文字列:10 += @"%CALLNAME:対象キャラ, 18, LEFT%の給仕レベルがLv{仕事レベル:対象キャラ:10}に上昇した！<br>"
				IF 仕事レベル:対象キャラ:10 >= 5
					;仕事レベルは減少しないのでこれでいいはず
					CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, @"仕事：給仕レベルがLv5になった","リゾート")
				ENDIF
				;レポート強調用記憶：従業員業務報告(＋仕事レベル上昇：給仕)
				レポート強調フラグ:従業員業務報告 = 1
				フォント色変更_常駐業務:10 = 1
			ENDIF
		ENDIF
		料理ルピ補正保存 += (仕事レベル:対象キャラ:10 + 1) * 5
	CASE "一日終了時処理_業務報告"
		;すべての業務を合算して表示する文字列、性質上対象キャラは使えない
		SIF フォント色変更_常駐業務:10 > 0
			RSTR:従業員業務報告_記録文字列 += @"<font color='#%カラーパレット_HTML("青緑")%'>"
		RSTR:従業員業務報告_記録文字列 += @"%@"・{仕事人数表示用:給仕担当人数}名の従業員は、愛想よく給仕を行っている。", 80, LEFT%"
		RSTR:従業員業務報告_記録文字列 += "<button value='110'>[詳細を表示]</button>"
		SIF フォント色変更_常駐業務:10
			RSTR:従業員業務報告_記録文字列 += "</font>"
		RSTR:従業員業務報告_記録文字列 += "<br><br>"
ENDSELECT

;------------------------------------------------------------------------------
;業務ルーチン 業務：給仕
;食堂にだいたいいる
;------------------------------------------------------------------------------

@MOVE_ROUTINE_業務_給仕(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		RETURN 1

	CASE "起床時刻"
		時間計算 = 510 - (TALENT:キャラ番号:早起き * 30)
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1380 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_給仕(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "休憩")
スケジュール番号++

;10時から食堂へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 600, "食堂業務", "所要時間", "180")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;14時から昼休憩
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 840, "食事", "小分類", "まかない", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;15時から食堂へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 900, "食堂業務", "所要時間", "180")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;20時から夕食
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1200, "食事", "小分類", "まかない", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;21時から風呂
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "お風呂", "所要時間", "60", "優先度", "2")
スケジュール番号++

;22時から寝るまでは自室
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1320, "休憩")
スケジュール番号++



;------------------------------------------------------------------------------
;食堂業務
;------------------------------------------------------------------------------
@SCHEDULE_食堂業務(キャラ番号, 小分類, 処理内容)
#DIM キャラ番号
#DIMS 小分類
#DIMS 処理内容

SELECTCASE 処理内容
	CASE "開始処理"
		スケジュール状態:キャラ番号:目的マップ = 0
		IF 施設改造度:4:0
			スケジュール状態:キャラ番号:目的地 = RAND(403, 406)
		ELSE
			スケジュール状態:キャラ番号:目的地 = 4
		ENDIF
		RETURN 1
	CASE "経過処理"
		IF 施設改造度:4:0
			SIF TCVAR:キャラ番号:移動ルーチンインターバル時間 > 0
				RETURN

			TCVAR:キャラ番号:移動ルーチンインターバル時間 = RAND(15, 30)
			スケジュール状態:キャラ番号:目的マップ = 0
			スケジュール状態:キャラ番号:目的地 = RAND(403, 406)
		ENDIF
	CASE "終了処理"
		;シンプルに食堂に滞在するだけ
		RETURN 1
ENDSELECT




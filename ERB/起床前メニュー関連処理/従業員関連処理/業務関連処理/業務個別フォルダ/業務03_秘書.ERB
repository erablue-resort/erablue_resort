

@従業員業務_文字列取得_3(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "秘書"
	CASE "業務説明"
		返し文字列 += @"%CALLNAME:PLAYER%の補佐を行う業務。<br>"
		返し文字列 += "効果：一日の最後に、好感度要素：信頼度が<br>"
		返し文字列 += "　　　［（仕事レベル＋１）＾２×２００］増加する。<br>"
		返し文字列 += "　　　リゾート内をランダムに移動する。"
		;ここに秘書起床業務の切り替えボタンを仕込む
		返し文字列 += "<br><br>"
		返し文字列 += "自発的に行ったことのある目覚まし行為を依頼することができる<br>（必ず実行してくれるわけではないが、他の起こし方は発生しにくくなる）<br>"
		;母乳体質が消えている場合、授乳は選択不可
		SIF GETBIT(秘書起床業務:対象キャラ:0, 起こし方_授乳) && !TALENT:対象キャラ:母乳体質
			CLEARBIT 秘書起床業務:対象キャラ:0, 起こし方_授乳
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_騎乗位), TOSTR(1300 + 起こし方_騎乗位), "膣奉仕", "朝勃ちを騎乗位で処理してくれる", 1, 射精可能(MASTER), !(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_騎乗位)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_Ａ騎乗位), TOSTR(1300 + 起こし方_Ａ騎乗位), "肛門奉仕", "朝勃ちをＡ騎乗位で処理してくれる", 1, 射精可能(MASTER), !(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_Ａ騎乗位)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_授乳), TOSTR(1300 + 起こし方_授乳), "授乳", "朝一番の搾りたてミルクを飲ませてくれる。素質[母乳体質]が必要", 1, TALENT:対象キャラ:母乳体質, !(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_授乳)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_フェラチオ), TOSTR(1300 + 起こし方_フェラチオ), "口奉仕", "朝勃ちをフェラチオで処理してくれる", 1, 射精可能(MASTER), !(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_フェラチオ)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_パイズリ), TOSTR(1300 + 起こし方_パイズリ), "乳奉仕", "朝勃ちをパイズリで処理してくれる", 1 ,射精可能(MASTER), !(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_パイズリ)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_手コキ), TOSTR(1300 + 起こし方_手コキ), "手淫奉仕", "朝勃ちを手コキで処理してくれる", 1 , 射精可能(MASTER), !(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_手コキ)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_ペッティング), TOSTR(1300 + 起こし方_ペッティング), "愛撫", "ペッティングで起こしてくれる", 1, 1,!(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_ペッティング)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_キス), TOSTR(1300 + 起こし方_キス), "キス", "キスして起こしてくれる", 1, 1, !(陥落チェック_性的(対象キャラ) && GETBIT(秘書起床経験:対象キャラ:0, 起こし方_キス)))
		返し文字列 += HTMLボタン_条件付き(GETBIT(秘書起床業務:対象キャラ:0, 起こし方_ノーマル), TOSTR(1300 + 起こし方_ノーマル), "声掛け", "部屋まで起こしに来てくれる", 1, 1)

		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_3(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 1
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		RETURNF 1
ENDSELECT



;------------------------------------------------------------------------------
;業務ルーチン 業務：秘書
;雑務と同様、たまに書類確認イベントが起こる
;------------------------------------------------------------------------------
@MOVE_ROUTINE_業務_秘書(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		RETURN 1

	CASE "起床時刻"
		時間計算 = CFLAG:MASTER:起床予定時刻 - 30
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1320 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_秘書(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "休憩")
スケジュール番号++

;8時半から雑務場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 510, "雑務", "所要時間", "150")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;12時から昼休憩
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 720, "食事", "小分類", "従業員お昼", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;13時から雑務場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 780, "雑務", "所要時間", "180")
スケジュール番号++

;18時からお風呂
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1080, "お風呂", "所要時間", "60", "優先度", "2")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;19時半の15分前(着替え時間)から食堂
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1155, "食事", "所要時間", "60", "優先度", "4")
	スケジュール番号++
ENDIF

;21時から寝るまでは自室
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "休憩")
スケジュール番号++




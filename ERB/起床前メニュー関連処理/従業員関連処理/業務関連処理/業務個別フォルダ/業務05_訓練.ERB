

@従業員業務_文字列取得_5(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "訓練"
	CASE "業務説明"
		返し文字列 += "訓練場で戦闘能力を鍛える業務。<br>"
		返し文字列 += "効果：一日の最後にEXPを獲得する。<br>"
		返し文字列 += "　　　獲得量は全キャラ中最も高いレベルに応じて変動する。<br>"
		返し文字列 += "　　　（全キャラ中最も高いレベルより上には成長しない）<br>"
		返し文字列 += "　　　訓練場に常駐する。<br>"
		返し文字列 += "　　　一日につき500kcal消費する。<br>"
		返し文字列 += "　　　この業務に業務レベルは存在しない。"

		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_5(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 0
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		SIF 施設改造度:3:8 == 0
			RETURNF 0
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		;非戦闘キャラはダメ
		SIF TALENT:対象キャラ:非戦闘キャラ
			RETURNF 0
		RETURNF 1
ENDSELECT



;------------------------------------------------------------------------------
;業務ルーチン 業務：訓練
;訓練所に常駐する
;------------------------------------------------------------------------------

@MOVE_ROUTINE_業務_訓練(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		RETURN 1

	CASE "起床時刻"
		時間計算 = 450 - (TALENT:キャラ番号:早起き * 30)
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1320 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_訓練(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "休憩")
スケジュール番号++

;8時半から訓練場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 510, "訓練", "所要時間", "150")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;12時から昼休憩
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 720, "食事", "小分類", "従業員お昼", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;13時から訓練場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 780, "訓練", "所要時間", "180")
スケジュール番号++

;18時からお風呂
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1080, "お風呂", "所要時間", "60", "優先度", "2")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;19時半の15分前(着替え時間)から食堂
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1155, "食事", "所要時間", "60", "優先度", "4")
	スケジュール番号++
ENDIF

;21時から寝るまでは自室
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "休憩")
スケジュール番号++


;------------------------------------------------------------------------------
;訓練
;------------------------------------------------------------------------------
@SCHEDULE_訓練(キャラ番号, 小分類, 処理内容)
#DIM キャラ番号
#DIMS 小分類
#DIMS 処理内容

SELECTCASE 処理内容
	CASE "開始処理"
		スケジュール状態:キャラ番号:目的マップ = 0
		スケジュール状態:キャラ番号:目的地 = 308
		RETURN 1
	CASE "経過処理"
	CASE "終了処理"
		RETURN 1
ENDSELECT


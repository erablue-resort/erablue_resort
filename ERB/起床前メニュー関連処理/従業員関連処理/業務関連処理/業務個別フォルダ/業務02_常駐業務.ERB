

@従業員業務_文字列取得_2(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
#DIMS 一時文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "常駐業務"
	CASE "業務説明"
		返し文字列 += "特定の場所で専門的な仕事を行う業務。<br>"
		返し文字列 += "効果：一日の最後に、ルピが<br>"
		返し文字列 += "　　　［滞在者数×（仕事レベル＋１）＾３］増加する。"
		返し文字列 += "<br><br>"
		IF 現在仕事:対象キャラ:1 == 1
			返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[3001] ロビー ：現在常駐場所</font><br>"
		ELSE
			返し文字列 += @"<button value='3001'>[3001] ロビー でロビー受付として働く</button><br>"
		ENDIF
		IF 施設改造度:5:0
			IF 現在仕事:対象キャラ:1 == 2
				返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[3002] バーエリア ：現在常駐場所</font><br>"
			ELSE
				返し文字列 += @"<button value='3002'>[3002] バーエリア でバーテンダーとして働く</button><br>"
			ENDIF
		ENDIF
		IF 施設改造度:5:6
			IF 現在仕事:対象キャラ:1 == 3
				返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[3003] 図書室 ：現在常駐場所</font><br>"
			ELSE
				返し文字列 += @"<button value='3003'>[3003] 図書室 で司書として働く</button><br>"
			ENDIF
		ENDIF
		IF 施設改造度:15:0
			IF 現在仕事:対象キャラ:1 == 4
				返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[3004] プールサイド ：現在常駐場所</font><br>"
			ELSE
				返し文字列 += @"<button value='3004'>[3004] プールサイド で監視員として働く</button><br>"
			ENDIF
		ELSE
			IF 現在仕事:対象キャラ:1 == 4
				返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[3004] プール ：現在常駐場所</font><br>"
			ELSE
				返し文字列 += @"<button value='3004'>[3004] プール で監視員として働く</button><br>"
			ENDIF
		ENDIF
		IF 空艇港初来訪イベントフラグ
			FOR LOCAL, 3, 9
				IF 空艇港店舗状況:LOCAL:0 > 0
					CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:LOCAL:0}(LOCAL)
					IF 現在仕事:対象キャラ:1 == LOCAL + 100
						返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[{3100 + LOCAL}] 店舗{LOCAL}:%TSTR:場所名受渡% ：現在常駐場所</font><br>"
					ELSE
						返し文字列 += @"<button value='{3100 + LOCAL}'>[{3100 + LOCAL}] 店舗{LOCAL}:%TSTR:場所名受渡% で店員として働く</button><br>"
					ENDIF
				ENDIF
			NEXT
		ENDIF
		IF 海改造度:6:0
			IF 現在仕事:対象キャラ:1 == 5
				返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[3005] 漁船団 ：現在常駐場所</font><br>"
			ELSE
				返し文字列 += @"<button value='3005'>[3005] 漁船団 で漁師として働く</button><br>"
			ENDIF
		ENDIF
		IF 海改造度:6:1 || 海改造度:6:2
			IF 海改造度:6:1
				IF 海改造度:6:2
					一時文字列 = 遊覧船・海底散歩
				ELSE
					一時文字列 = 遊覧船
				ENDIF
			ELSE
				一時文字列 = 海底散歩
			ENDIF
			IF 現在仕事:対象キャラ:1 == 6
				返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[3006] %一時文字列% ：現在常駐場所</font><br>"
			ELSE
				返し文字列 += @"<button value='3006'>[3006] %一時文字列% でシーガイドとして働く</button><br>"
			ENDIF
		ENDIF
		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_2(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 1
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		RETURNF 1
ENDSELECT



@常駐業務_場所番号変換(常駐番号)
#FUNCTION
#DIM 常駐番号

SELECTCASE 常駐番号
	CASE 1
		;ロビー受付
		部屋検索_マップ種別 = 0
		RETURNF 2
	CASE 2
		;バーテンダー
		部屋検索_マップ種別 = 0
		RETURNF 503
	CASE 3
		;司書
		部屋検索_マップ種別 = 0
		RETURNF 506
	CASE 4
		部屋検索_マップ種別 = 0
		IF 施設改造度:15:0
			;プールサイドで監視員
			RETURNF 1503
		ELSE
			;プールで監視員
			RETURNF 15
		ENDIF
	CASE 5
		;漁船団で漁師
		部屋検索_マップ種別 = 3
		RETURNF 103
	CASE 6
		;海でシーガイド
		部屋検索_マップ種別 = 3
		RETURNF 104
	CASE IS > 100
		;店舗で店員、何番目の店舗かは常駐番号から算出
		部屋検索_マップ種別 = 1
		RETURNF 常駐番号 - 100
ENDSELECT


@常駐業務_業務名取得(常駐番号)
#FUNCTIONS
#DIM 常駐番号

SELECTCASE 常駐番号
	CASE 1
		RETURNF "ロビー受付"
	CASE 2
		RETURNF "バーテンダー"
	CASE 3
		RETURNF "司書"
	CASE 4
		RETURNF "プール監視員"
	CASE 5
		RETURNF "漁師"
	CASE 6
		RETURNF "シーガイド"
	CASE IS > 100
		RETURNF REPLACE(GETPLACENAME(1, 常駐番号 - 100), "『.*』", "")
ENDSELECT

@常駐業務_場所名取得(常駐番号)
#FUNCTIONS
#DIM 常駐番号
#DIM 場所番号

場所番号 = 常駐業務_場所番号変換(常駐番号)

RETURNF GETPLACENAME(部屋検索_マップ種別, 場所番号)




;------------------------------------------------------------------------------
;業務ルーチン 業務：常駐業務
;指定店舗に常駐する
;------------------------------------------------------------------------------
@MOVE_ROUTINE_業務_常駐業務(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		;現在仕事:キャラ番号:1に数字が入っている＝店舗常駐である
		RETURN 現在仕事:キャラ番号:1 > 0

	CASE "起床時刻"
		時間計算 = 450 - (TALENT:キャラ番号:早起き * 30)
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1320 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_常駐業務(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "休憩")
スケジュール番号++

;8時半から常駐場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 510, "常駐業務", "所要時間", "150")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;12時から昼休憩
	; IF 現在仕事:キャラ番号:1 < 10000
	IF 現在仕事:キャラ番号:1 < 100
		CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 720, "食事", "小分類", "従業員お昼", "所要時間", "40", "優先度", "4")
	ELSE
		CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 720, "食事", "小分類", "お弁当", "所要時間", "40", "優先度", "4")
	ENDIF
	スケジュール番号++
ENDIF

;13時から常駐場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 780, "常駐業務", "所要時間", "180")
スケジュール番号++

;18時からお風呂
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1080, "お風呂", "所要時間", "60", "優先度", "2")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;19時半の15分前(着替え時間)から食堂
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1155, "食事", "所要時間", "60", "優先度", "4")
	スケジュール番号++
ENDIF

;21時から寝るまでは自室
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "休憩")
スケジュール番号++

;------------------------------------------------------------------------------
;移動スケジュール設定
;------------------------------------------------------------------------------
@SCHEDULE_常駐業務(キャラ番号, 小分類, 処理内容)
#DIM キャラ番号
#DIMS 小分類
#DIMS 処理内容

SELECTCASE 処理内容
	CASE "開始処理"
	; 	スケジュール状態:キャラ番号:目的マップ = 現在仕事:キャラ番号:1 / 10000
	; 	スケジュール状態:キャラ番号:目的地 = 現在仕事:キャラ番号:1 % 10000
		スケジュール状態:キャラ番号:目的地 = 常駐業務_場所番号変換(現在仕事:キャラ番号:1)
		スケジュール状態:キャラ番号:目的マップ = 部屋検索_マップ種別
		;シーガイドだけ例外処理
		;IF 現在仕事:キャラ番号:1 == 30104
		IF 現在仕事:キャラ番号:1 == 6
			スケジュール状態:キャラ番号:目的地 = 104 + RAND:2
		ENDIF
		RETURN 1
	CASE "経過処理"
	CASE "終了処理"
		RETURN 1
ENDSELECT



@従業員業務_文字列取得_11(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "高速船員"
	CASE "業務説明"
		返し文字列 += "高速船に乗り込み、派遣先に向かう業務。<br>"
		返し文字列 += "効果：派遣先により変化。<br>"
		返し文字列 += "　　　この業務に業務レベルは存在しない。<br>"

		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_11(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 0
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		RETURNF 1
ENDSELECT


;------------------------------------------------------------------------------
;業務ルーチン 業務：高速船員
;夕方までどこにもいない、早めに風呂に入ってからは自室へ
;------------------------------------------------------------------------------

@MOVE_ROUTINE_業務_高速船員(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		RETURN 1

	CASE "起床時刻"
		時間計算 = 450 - (TALENT:キャラ番号:早起き * 30)
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1320 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_高速船員(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "自動探索前")
スケジュール番号++

;8時半から自動探索へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 510, "自動探索", "優先度", "100")
スケジュール番号++

;18時からお風呂
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1080, "お風呂", "所要時間", "60", "優先度", "2")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;19時半の15分前(着替え時間)から食堂
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1155, "食事", "所要時間", "60", "優先度", "4")
	スケジュール番号++
ENDIF

;21時から寝るまでは自室
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "休憩")
スケジュール番号++



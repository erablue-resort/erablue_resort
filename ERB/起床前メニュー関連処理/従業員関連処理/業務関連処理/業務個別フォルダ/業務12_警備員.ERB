

@従業員業務_文字列取得_12(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "警備員"
	CASE "業務説明"
		返し文字列 += "リゾートを襲う外敵を排除する業務。<br>"
		返し文字列 += "効果：一日の最後に、特定のイベントが発生している場合<br>"
		返し文字列 += "　　　仕事レベルに応じた確率でイベントを解決する。<br>"
		返し文字列 += "　　　また突発イベント「魔物襲撃」のエネミーレベルを減少させる。<br>"
		返し文字列 += "　　　（複数人いる場合、確率・レベル減少効果は加算）<br>"
		返し文字列 += "　　　リゾート内をランダムに移動する。<br>"

		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_12(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 1
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		;非戦闘キャラはダメ
		SIF TALENT:対象キャラ:非戦闘キャラ
			RETURNF 0
		RETURNF 1
ENDSELECT


@従業員業務_処理関数_12(動作モード, 対象キャラ)
#DIM 対象キャラ
#DIMS 動作モード
#DIM 業務量

SELECTCASE 動作モード
	CASE "一日終了時処理_キャラ"
		仕事人数表示用:警備員担当人数 ++
		業務別報告文字列:12 += @"%CALLNAME:対象キャラ, 18, LEFT%は%TEXTR("真面目に警備をしている/こまめに見回りをしている/不審者への対応をしている")%。<br>"
		撃退値 += 仕事レベル:対象キャラ:12 + 1
		;経験値取得とレベル上昇
		仕事経験値:対象キャラ:12 += 1
		IF 仕事レベル:対象キャラ:12 < 5
			IF 仕事経験値:対象キャラ:12 >= 仕事レベル経験値テーブル:(仕事レベル:対象キャラ:12 + 1)
				仕事レベル:対象キャラ:12 += 1
				業務別報告文字列:12 += @"%CALLNAME:対象キャラ, 18, LEFT%の警備員レベルがLv{仕事レベル:対象キャラ:12}に上昇した！<br>"
				IF 仕事レベル:対象キャラ:12 >= 5
					;仕事レベルは減少しないのでこれでいいはず
					CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, @"仕事：警備員レベルがLv5になった","リゾート")
				ENDIF
				;レポート強調用記憶：従業員業務報告(＋仕事レベル上昇：警備員)
				レポート強調フラグ:従業員業務報告 = 1
				フォント色変更_常駐業務:12 = 1
			ENDIF
		ENDIF
	CASE "一日終了時処理_業務報告"
		;すべての業務を合算して表示する文字列、性質上対象キャラは使えない
		CALL 警備員イベント解消判定()
		SIF RESULT == 1
			フォント色変更_常駐業務:12 = 1
		SIF フォント色変更_常駐業務:12 > 0
			RSTR:従業員業務報告_記録文字列 += @"<font color='#%カラーパレット_HTML("青緑")%'>"
		SELECTCASE RESULT
			CASE 0
				RSTR:従業員業務報告_記録文字列 += @"%@"・{仕事人数表示用:警備員担当人数}名の従業員は、リゾートの周辺を警備している。", 80, LEFT%"
			CASE 1
				RSTR:従業員業務報告_記録文字列 += @"%@"・{仕事人数表示用:警備員担当人数}名の従業員は、不審者の撃退に成功した！", 80, LEFT%"
			CASE -1
				RSTR:従業員業務報告_記録文字列 += @"%@"・{仕事人数表示用:警備員担当人数}名の従業員は、不審者の対応に追われている。", 80, LEFT%"
		ENDSELECT
		RSTR:従業員業務報告_記録文字列 += "<button value='112'>[詳細を表示]</button>"
		SIF フォント色変更_常駐業務:12
			RSTR:従業員業務報告_記録文字列 += "</font>"
		RSTR:従業員業務報告_記録文字列 += "<br><br>"
ENDSELECT


;------------------------------------------------------------------------------
;業務ルーチン 業務：警備員
;一時間ごとにランダムに移動する
;------------------------------------------------------------------------------
@MOVE_ROUTINE_業務_警備員(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		RETURN 1

	CASE "起床時刻"
		時間計算 = 450 - (TALENT:キャラ番号:早起き * 30)
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1320 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_警備員(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "休憩")
スケジュール番号++

;8時半から警備員場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 510, "雑務", "所要時間", "150")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;12時から昼休憩
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 720, "食事", "小分類", "従業員お昼", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;13時から警備員場所へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 780, "雑務", "所要時間", "180")
スケジュール番号++

;18時からお風呂
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1080, "お風呂", "所要時間", "60", "優先度", "2")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;19時半の15分前(着替え時間)から食堂
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1155, "食事", "所要時間", "60", "優先度", "4")
	スケジュール番号++
ENDIF

;21時から寝るまでは自室
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "休憩")
スケジュール番号++




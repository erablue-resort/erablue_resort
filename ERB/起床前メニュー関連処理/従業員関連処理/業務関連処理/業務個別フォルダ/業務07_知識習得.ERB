

@従業員業務_文字列取得_7(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "知識習得"
	CASE "業務説明"
		返し文字列 += "学校に赴き、指定された知識について学習する業務。<br>"
		返し文字列 += "効果：午前と午後の学習終了時に知識経験値を得る。<br>"
		返し文字列 += "　　　学校にいない時間帯は自室にいる。<br>"
		返し文字列 += "　　　Lv2に到達した知識は選択出来ない。<br>"
		返し文字列 += "　　　この業務に業務レベルは存在しない。"
		返し文字列 += "<br><br>"
		LOCAL:1 = 0
		FOR LOCAL, 1, 100
			SIF ERDNAME(知識素質, LOCAL) == ""
				BREAK
			IF 知識素質:対象キャラ:LOCAL > 1
				返し文字列 += @"<font color='#%カラーパレット_HTML("グレーアウト")%'>[{LOCAL + 3000}] %ERDNAME(知識素質, LOCAL), 9, LEFT%を学ぶ(現在Lv{知識素質:対象キャラ:LOCAL})</font>　　　"
			ELSEIF 現在仕事:対象キャラ:1 == LOCAL
				返し文字列 += @"<font color='#%カラーパレット_HTML("黄")%'>[{LOCAL + 3000}] %ERDNAME(知識素質, LOCAL), 9, LEFT%を学ぶ(現在Lv{知識素質:対象キャラ:LOCAL})選択</font>　"
			ELSE
				返し文字列 += @"<button value='{LOCAL + 3000}'>[{LOCAL + 3000}] %ERDNAME(知識素質, LOCAL), 9, LEFT%を学ぶ(現在Lv{知識素質:対象キャラ:LOCAL})</button>　　　"
			ENDIF
			LOCAL:1 ++
			SIF LOCAL:1 % 2 == 0
				返し文字列 += "<br>"
		NEXT
		
		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_7(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 0
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		SIF 居住区改造度:0:0 == 0
			RETURNF 0
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		RETURNF 1
ENDSELECT

@従業員業務_処理関数_7(動作モード, 対象キャラ)
#DIM 対象キャラ
#DIMS 動作モード
#DIM 業務量

SELECTCASE 動作モード
	CASE "一日終了時処理_キャラ"
		仕事人数表示用:知識習得担当人数 ++
		IF 知識素質:対象キャラ:(現在仕事:対象キャラ:1) > 1
			; 仕事による知識習得はLv2まで。以降の学習は無意味になるので仕事内容から外す
			業務別報告文字列:7 += @"%CALLNAME:対象キャラ, 18, LEFT%は%ERDNAME(知識素質, 現在仕事:対象キャラ:1)%について学校で学ぶことは全て%TEXTR("修めきった/学びつくした/学び終えた/修了した")%ようだ。知識習得業務を解除します。<br>"
			現在仕事:対象キャラ:0 = 0
			現在仕事:対象キャラ:1 = 0
			;レポート強調用記憶：従業員業務報告(－知識習得：レベル上限)
			SIF レポート強調フラグ:従業員業務報告 == 0
				レポート強調フラグ:従業員業務報告 = -1
			フォント色変更_常駐業務:7 = -1
		ENDIF
	CASE "一日終了時処理_業務報告"
		;すべての業務を合算して表示する文字列、性質上対象キャラは使えない
		SIF フォント色変更_常駐業務:7 < 0
			RSTR:従業員業務報告_記録文字列 += @"<font color='#%カラーパレット_HTML("赤")%'>"
		RSTR:従業員業務報告_記録文字列 += @"%@"・{仕事人数表示用:知識習得担当人数}名の従業員は、頑張って学習に励んでいる。", 80, LEFT%"
		RSTR:従業員業務報告_記録文字列 += "<button value='107'>[詳細を表示]</button>"
		SIF フォント色変更_常駐業務:7
			RSTR:従業員業務報告_記録文字列 += "</font>"
		RSTR:従業員業務報告_記録文字列 += "<br><br>"
ENDSELECT



;------------------------------------------------------------------------------
;業務ルーチン 業務：知識習得
;学校ルーチンと同一
;------------------------------------------------------------------------------

@MOVE_ROUTINE_業務_知識習得(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		RETURN 1

	CASE "起床時刻"
		時間計算 = 450 - (TALENT:キャラ番号:早起き * 30)
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1320 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_知識習得(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "休憩")
スケジュール番号++

;8時半から学校へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 510, "学校に滞在")
スケジュール番号++

;9時から勉強
;授業時間は90分×2
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 540, "学校で勉強", "所要時間", "180")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;弁当
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 690, "食事", "小分類", "お弁当", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;13時から勉強
;授業時間は90分×3+休憩15分
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 780, "学校で勉強", "所要時間", "285")
スケジュール番号++

IF TALENT:キャラ番号:定住者 == 1
	;居住区に住む場合は直帰

	;18時からお風呂
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1080, "自室入浴", "所要時間", "60", "優先度", "2")
	スケジュール番号++

	IF TALENT:キャラ番号:飲食不可 == 0
		;19時から自炊
		CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1140, "自炊", "所要時間", "60", "優先度", "4")
		スケジュール番号++
	ENDIF

	;あとは寝るまで自室でのんびり
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1230, "休憩")
	スケジュール番号++
ELSE
	;18時からお風呂
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1080, "お風呂", "所要時間", "60", "優先度", "2")
	スケジュール番号++

	IF TALENT:キャラ番号:飲食不可 == 0
		;19時半の15分前(着替え時間)から食堂
		CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1155, "食事", "所要時間", "60", "優先度", "4")
		スケジュール番号++
	ENDIF

	;21時から寝るまでは自室
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "休憩")
	スケジュール番号++
ENDIF




@従業員業務_文字列取得_9(動作モード, 対象キャラ = 0)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "調理師"
	CASE "業務説明"
		返し文字列 += "リゾート内の食堂で料理を担当する業務。<br>"
		返し文字列 += "効果：料理メニューの効果によるZP収入が<br>"
		返し文字列 += "　　　［（知識素質：料理人レベル＋１）✕５］％増加する。<br>"
		返し文字列 += "　　　複数人の効果は加算されるが、上限は<br>"
		返し文字列 += "　　　［滞在人数÷１０］％まで。（モブ・ユニーク合算）<br>"
		返し文字列 += "　　　料理人レベルがマイナスのキャラをこの業務に就けてはいけない。<br>"
		返し文字列 += "　　　この業務に業務レベルは存在しない。"

		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_9(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 0
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		RETURNF 1
	CASE "仕事実行条件"
		;あなたはダメ
		SIF 対象キャラ == MASTER
			RETURNF 0
		RETURNF 1
ENDSELECT


@従業員業務_処理関数_9(動作モード, 対象キャラ)
#DIM 対象キャラ
#DIMS 動作モード
#DIM 料理人レベル退避

SELECTCASE 動作モード
	CASE "一日終了時処理_キャラ"
		仕事人数表示用:調理師担当人数 ++
		IF 知識素質:対象キャラ:料理人 >= 3
			業務別報告文字列:9 += @"%CALLNAME:対象キャラ, 18, LEFT%%TEXTR("の料理は今日も大人気だ。/の料理に感動する客が後を絶たない。/の料理が美味しすぎて泣いた客がいたらしい……/の料理を目当てに島に来た客から「渡してほしい」と感謝のファンレターを預かった。/監修のディナーの待機列は、捌けるのに２時間かかったようだ……")%<br>"
		ELSEIF 知識素質:対象キャラ:料理人 == 2
			業務別報告文字列:9 += @"%CALLNAME:対象キャラ, 18, LEFT%は%TEXTR("慣れた手つきでフライパンを振るっている。/慣れた包丁さばきで飾り切りまで見事に仕上げている。/美味しそうな料理を作っている。/抜群の火加減で絶品ステーキを焼き上げ客を大いに喜ばせた。")%<br>"
		ELSEIF 知識素質:対象キャラ:料理人 == 0
			業務別報告文字列:9 += @"%CALLNAME:対象キャラ, 18, LEFT%は%TEXTR("頑張って料理を作っている。/忙しそうに料理を作っている。/うっかり皿を割ってしまったが、幸い怪我はしなかったようだ。")%<br>"
		ELSE
			業務別報告文字列:9 += @"%CALLNAME:対象キャラ, 18, LEFT%は%TEXTR("フライパンで/鍋で/オーブンで")%%TEXTR("奇妙な/謎の/真っ黒な/時折うごめく謎の")%物体を錬成している……！<br>"
			TFLAG:マイナス調理人人数 ++
		ENDIF
		;経験値取得とレベル上昇
		IF 知識素質:対象キャラ:料理人 >= 0
			知識素質:対象キャラ:料理人経験値 += LIMIT(モブ観光客数 / 20, 1, 10)
			IF 知識素質:対象キャラ:料理人 < 2
				料理人レベル退避 = 知識素質:対象キャラ:料理人
				SKIPDISP 1
				CALL 知識系素質の取得(対象キャラ)
				SKIPDISP 0
				IF 知識素質:対象キャラ:料理人 > 料理人レベル退避
					;料理人レベル上昇時
					業務別報告文字列:9 += @"%CALLNAME:対象キャラ, 18, LEFT%の料理人レベルがLv{知識素質:対象キャラ:料理人}に上昇した！<br>"
					;レポート強調用記憶：従業員業務報告(＋仕事レベル上昇：料理人)
					レポート強調フラグ:従業員業務報告 = 1
					フォント色変更_常駐業務:9 = 1
				ENDIF
			ENDIF
			料理ZP補正保存 += (知識素質:対象キャラ:料理人 + 1) * 5
		ENDIF
	CASE "一日終了時処理_業務報告"
		;すべての業務を合算して表示する文字列、性質上対象キャラは使えない
		SIF フォント色変更_常駐業務:9 > 0
			RSTR:従業員業務報告_記録文字列 += @"<font color='#%カラーパレット_HTML("青緑")%'>"
		RSTR:従業員業務報告_記録文字列 += @"%@"・{仕事人数表示用:調理師担当人数}名の従業員は、頑張って料理を作っている。", 80, LEFT%"
		RSTR:従業員業務報告_記録文字列 += "<button value='109'>[詳細を表示]</button>"
		SIF フォント色変更_常駐業務:9
			RSTR:従業員業務報告_記録文字列 += "</font>"
		RSTR:従業員業務報告_記録文字列 += "<br><br>"
ENDSELECT

;------------------------------------------------------------------------------
;業務ルーチン 業務：調理師
;食堂にだいたいいる
;------------------------------------------------------------------------------

@MOVE_ROUTINE_業務_調理師(キャラ番号, ARGS)
#DIM キャラ番号
#DIM 時間計算

SELECTCASE ARGS
	CASE "参加判定"
		RETURN 1

	CASE "起床時刻"
		時間計算 = 510 - (TALENT:キャラ番号:早起き * 30)
		RETURN 時間計算

	CASE "就寝時刻"
		時間計算 = 1380 - (TALENT:キャラ番号:早寝 * 60)
		RETURN 時間計算

	CASE "就寝場所"
		RETURN 0

	CASE "初期位置"
		CFLAG:キャラ番号:現在位置 = キャラクター部屋検索(キャラ番号)
		CFLAG:キャラ番号:現在マップ種別 = 部屋検索_マップ種別
ENDSELECT

@ROUTINE_SCHEDULE_業務_調理師(キャラ番号)
#DIM キャラ番号
#DIM スケジュール番号

CALL RESET_SCHEDULE(キャラ番号)
スケジュール番号 = 0

;起床後は自室にいる
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 0, "休憩")
スケジュール番号++

;10時から食堂へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 600, "調理業務", "所要時間", "180")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;14時から昼休憩
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 840, "食事", "小分類", "まかない", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;15時から食堂へ
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 900, "調理業務", "所要時間", "180")
スケジュール番号++

IF TALENT:キャラ番号:飲食不可 == 0
	;20時から夕食
	CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1200, "食事", "小分類", "まかない", "所要時間", "40", "優先度", "4")
	スケジュール番号++
ENDIF

;21時から風呂
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1260, "お風呂", "所要時間", "60", "優先度", "2")
スケジュール番号++

;22時から寝るまでは自室
CALL SET_SCHEDULE(キャラ番号, スケジュール番号, 1320, "休憩")
スケジュール番号++




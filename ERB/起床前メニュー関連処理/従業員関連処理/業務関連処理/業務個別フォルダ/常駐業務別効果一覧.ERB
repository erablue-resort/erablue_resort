@常駐業務効果_ディーラー(対象キャラ, 動作モード)
#DIM 対象キャラ
#DIMS 動作モード
#DIM 業務量
#DIM DYNAMIC レベルアップ判定

SELECTCASE 動作モード
	CASE "ルピ補正"	
		業務量 = (常駐業務レベル:対象キャラ:ディーラー + 1) * (常駐業務レベル:対象キャラ:ディーラー + 1) * (常駐業務レベル:対象キャラ:ディーラー + 1) * 滞在キャラ数算出関数() * RAND(95, 106) / 100
		業務別報告文字列:2 += @"%CALLNAME:対象キャラ, 18, LEFT%は"
		IF TALENT:対象キャラ:性別 == 1 && RAND:2 == 0
		;とりあえずおためしで女だけ
			IF 知識素質:対象キャラ:性知識 == -2
				業務別報告文字列:2 += @"無防備に女の魅力を振りまきながらディーラーとして働いている。<br>"
			ELSEIF 性癖素質:対象キャラ:ゆきずりセックス >= 1
			;ゆきずりの相手との行為に抵抗がないので「このゲームでアタシに勝ったらぁ、今夜おにーさんの部屋で『体のシャッフル』してあげよっか♥」とかやる。負けてもアドな孔雀舞。無敵か？
			;露骨に売り上げが多い
				業務量 = 業務量 * 4 / 3
				SELECTCASE RAND:2
				CASE 0
					業務別報告文字列:2 += @"%TEXTR("自らのカラダで/「ご奉仕」をちらつかせて")%男性客の%TEXTR("欲望/射幸心")%を煽り、一晩の逢瀬を求めた客に財布の中身を吐き出させることに成功したようだ。<br>"
				CASE 1
					業務別報告文字列:2 += @"彼女との「一晩」を求めて賭けを挑んでくる男性客を返り討ちにした。<br>"
				ENDSELECT
				RSTR:リゾート収支計算_記録文字列 += @"ボロ負けした客から得た追加の利益：10000<br>"
				業務量 += 10000
				;10000ルピは現在の日本円にしておよそ10万円の価値。ディーラーちゃんの取り分引いてリゾートの売り上げにこれだけ入るんだから相当負けてる。
				;「見事な爆死をキメたお客さんがかわいそうだからフェラだけしてあげた」とかあってもいいかも。大負けした客の不満解消にもなるし。
				;爆死額に応じて憐れみサービス内容が変わるとかでもいいか。5000ルピ負けなら1分間おっぱい触らせてあげるだけ、2000ルピ程度の負けならパンツ見せてあげるだけ、みたいな。残念賞で履いてたパンツあげたとか。
				;……でもこれ、２行にしていいやつ？この一文を書くには余白が狭すぎる可能性がなくもない。

				;負けて戦利品になっちゃうパターンもあっていいと思うけど……どの程度経験やらをつけるかがなぁ……具体的な描写もここに書くことじゃないし
				;「顔が好み」「必死さがかわいかった」とかで「役なしの手札で/相手にストレートフラッシュ作ってあげて わざと負けてあげた」とかあってもいい。ショタくんに負けてあげるえっちなディーラーお姉さん……。
				;リゾートに金銭的損失が発生するわけでもないしスるのは夜なのでオーナーに何か言われる筋合い自体があんまない。
			ELSEIF TALENT:対象キャラ:バストサイズ >= 1
				業務量 = 業務量 * 4 / 3
				業務別報告文字列:2 += @"%TEXTR("巨乳をさりげなく揺らす/深い谷間を見せつける")%巧みな視線誘導で、今日も%TEXTR("男性客からほどほどにむしり取っているようだ……/中々の売り上げを出している。/利益に貢献している。")%<br>"
			ELSE
				業務量 = 業務量 * 4 / 3
				業務別報告文字列:2 += @"%TEXTR("「見えそうで見えない」ギリギリを攻めた/女の魅力を生かした/無防備を装った胸チラによる")%巧みな視線誘導で、今日も%TEXTR("男性客からほどほどにむしり取っているようだ……/中々の売り上げを出している。/利益に貢献している。")%<br>"
			ENDIF
		ELSE
			業務別報告文字列:2 += @"%TEXTR("ディーラーとして実直に働いている/信頼できるディーラーだと評判だ")%。<br>"
		ENDIF
		
		RETURN 業務量
	CASE "経験値取得"
		;経験値取得とレベル上昇
		LOCALS = ディーラー
		LOCAL = GETNUM(常駐業務レベル, "ディーラー")
		常駐業務経験値:対象キャラ:LOCAL += 1
		IF 常駐業務レベル:対象キャラ:LOCALS < 5
			IF 常駐業務経験値:対象キャラ:LOCAL >= 仕事レベル経験値テーブル:(常駐業務レベル:対象キャラ:ディーラー + 1)
				常駐業務レベル:対象キャラ:LOCALS += 1
				業務別報告文字列:2 += @"%CALLNAME:対象キャラ, 18, LEFT%の%LOCALS%レベルがLv{常駐業務レベル:対象キャラ:LOCALS}に上昇した！<br>"
				IF 常駐業務レベル:対象キャラ:LOCALS >= 5
					;仕事レベルは減少しないのでこれでいいはず
					CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, @"仕事：常駐業務：%LOCALS%レベルがLv5になった","リゾート")
				ENDIF
				レベルアップ判定 = 1
			ENDIF
		ENDIF
		RETURN レベルアップ判定
ENDSELECT


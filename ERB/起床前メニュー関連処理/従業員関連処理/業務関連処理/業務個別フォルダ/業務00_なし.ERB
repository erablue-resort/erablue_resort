

@従業員業務_文字列取得_0(動作モード, 対象キャラ)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 動作モード
#DIMS 返し文字列
返し文字列 = 

;主に業務内容の説明や追加選択肢などを記述する

SELECTCASE 動作モード
	CASE "業務名"
		RETURNF "雑務"
	CASE "業務説明"
		返し文字列 += "特に仕事を申し付けず、待機している状態。<br>"
		返し文字列 += "効果：特になし<br>"
		返し文字列 += "　　　通常の客と同じように行動する。"
		RETURNF 返し文字列
ENDSELECT

@従業員業務_数値取得_0(動作モード, 対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIMS 動作モード

;主に業務

SELECTCASE 動作モード
	CASE "仕事レベル有無"
		RETURNF 0
	CASE "仕事発生条件"
		;そもそも仕事が存在しているかの判定
		RETURNF 1
	CASE "仕事実行条件"
		;誰でもOK
		RETURNF 1
ENDSELECT



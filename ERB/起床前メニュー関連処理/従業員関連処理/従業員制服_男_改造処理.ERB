			SWAP 制服改造Temp:(LOCAL:1), 制服改造_男:改造対象:(LOCAL:1)
		NEXT
		IF LOCAL % 10 == 0
			SWAP フィールド展開:エロ制服許可, フィールド保存
			フィールド展開:エロ制服許可 = 0
			RESULT = 1
			CALLFORM 制服改造可_%対象衣装名%((LOCAL - 1000) / 10)

@料理レシピエディタ()
#DIMS DYNAMIC 料理名
#DIMS DYNAMIC 設定食材, 4
#DIM 食材メニュー開閉

LOCALS = 
LOCALS += "<div rect='81,375,1937,3312' padding='25,50,25' border='31' bcolor='#C0C0C0'>"

LOCALS += "<button value='100'>[100] 料理名を設定する</button>"
LOCALS += "<br>"
LOCALS += "<button value='110'>[110] 食材を設定する</button>"
LOCALS += "<br>"
IF 食材メニュー開閉
	LOCALS += "<button value='99'><font color='#808080'>└ 展開する</font></button>"
	LOCALS += "<br>"
ELSE
	LOCALS += "<button value='111'>├[111] メイン食材を設定する</button>"
	LOCALS += "<br>"
	LOCALS += "<button value='112'>├[112] 追加食材１を設定する</button>"
	LOCALS += "<br>"
	LOCALS += "<button value='113'>├[113] 追加食材２を設定する</button>"
	LOCALS += "<br>"
	LOCALS += "<button value='114'>└[114] 追加食材３を設定する</button>"
	LOCALS += "<br>"
ENDIF
LOCALS += "</div>"

LOCALS += "<div rect='2050,375,3875,3312' padding='25,50,25' border='31' bcolor='#C0C0C0'>"

IF 料理名 == ""
	LOCALS += @"■<button value='100'>（未定）</button>"
ELSE
	LOCALS += @"■<button value='100'>%料理名%</button>"
ENDIF
LOCALS += "<br>"
LOCALS += "　　メイン食材："
IF 設定食材:0 == ""
	LOCALS += @"<button value='111'>[--------------------]</button>"
ELSE
	LOCALS += @"<button value='111'>[%設定食材:0%]</button>"
ENDIF
LOCALS += "<br>"
LOCALS += "　　追加食材１："
IF 設定食材:1 == ""
	LOCALS += @"<button value='112'>[--------------------]</button>"
ELSE
	LOCALS += @"<button value='112'>[%設定食材:1%]</button>"
ENDIF
LOCALS += "<br>"
LOCALS += "　　追加食材２："
IF 設定食材:2 == ""
	LOCALS += @"<button value='113'>[--------------------]</button>"
ELSE
	LOCALS += @"<button value='113'>[%設定食材:2%]</button>"
ENDIF
LOCALS += "<br>"
LOCALS += "　　追加食材３："
IF 設定食材:3 == ""
	LOCALS += @"<button value='114'>[--------------------]</button>"
ELSE
	LOCALS += @"<button value='114'>[%設定食材:3%]</button>"
ENDIF
LOCALS += "<br>"

LOCALS += "</div>"



HTML_PRINT LOCALS

FOR LOCAL, 0, 33
	PRINTL
NEXT

BINPUT
LOCAL = RESULT

SELECTCASE LOCAL
	CASE 999
	CASE 100
	CASE 110
		INVERTBIT 食材メニュー開閉, 0
	CASE 111
	CASE 112
	CASE 113
	CASE 114
ENDSELECT

RESTART

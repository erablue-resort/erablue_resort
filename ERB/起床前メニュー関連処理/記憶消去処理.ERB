; 記憶消去薬で消えるもの一覧
; 	恋慕
; 	セフレ
; 	セフレあり
; 	浮気
; 	恋人持ち
	
; 	友情度
; 	信頼度
; 	恋心度
; 	性愛度
; 	好感度＆レベル
; 	恋慕度＆レベル
	
; 	関係データベースでの恋慕関係とセフレ関係
; 	および恋慕相手の恋人持ち
; 	セフレ関係は相手のセフレ数が0になる場合にのみ相手のセフレ持ち消去
; 	縁結びデータで選択したキャラの恋慕とセフレ関係
	
; 	※恋人持ちに関してはキャラ元のCSVファイルを参照してデフォルトの状態に戻すようになっています

@記憶消去処理(キャラ番号)
	#DIM キャラ番号
	#DIM 関係数
	#DIM セフレ相手
	#DIM セフレ関係数
	#DIM DYNAMIC 関係行ID, キャラクタ数上限

IF TALENT:キャラ番号:2 != CSVTALENT(NO:キャラ番号, 2)
	PRINTL 性別を戻しますか？
	PRINTBUTTON "[0] はい", 0
	PRINTL
	PRINTBUTTON "[1] いいえ", 1
	PRINTL
	INPUT 0
	SIF RESULT == 0
		TALENT:キャラ番号:性別 = CSVTALENT(NO:キャラ番号, 2)
ENDIF

IF TALENT:キャラ番号:処女 == 0
	PRINTL 処女を再生しますか？
	PRINTBUTTON "[0] はい", 0
	PRINTL
	PRINTBUTTON "[1] いいえ", 1
	PRINTL
	INPUT 0
	SIF RESULT == 0
		TALENT:キャラ番号:処女 = 1
ENDIF

IF TALENT:キャラ番号:Ａ処女 == 0
	PRINTL Ａ処女を再生しますか？
	PRINTBUTTON "[0] はい", 0
	PRINTL
	PRINTBUTTON "[1] いいえ", 1
	PRINTL
	INPUT 0
	SIF RESULT == 0
		TALENT:キャラ番号:Ａ処女 = 1
ENDIF

IF  TALENT:キャラ番号:非童貞 > 0
	PRINTL 童貞を失った記憶を消しますか？
	PRINTBUTTON "[0] はい", 0
	PRINTL
	PRINTBUTTON "[1] いいえ", 1
	PRINTL
	INPUT 0
	SIF RESULT == 0
		TALENT:キャラ番号:非童貞 = 0
ENDIF

CALL 記憶消去_恋慕解除(キャラ番号)
TALENT:キャラ番号:セフレ = 0
TALENT:キャラ番号:セフレあり = 0

CFLAG:キャラ番号:友情度 = 0
CFLAG:キャラ番号:信頼度 = 0
CFLAG:キャラ番号:恋心度 = 0
CFLAG:キャラ番号:性愛度 = 0
CFLAG:キャラ番号:好感度レベル = 0
CFLAG:キャラ番号:恋慕度 = 0
CFLAG:キャラ番号:恋慕レベル = 0

VARSET コマンド初回フラグ:キャラ番号:0
VARSET コマンド初回フラグ_PLAYER:キャラ番号:0

関係数 = DT_SELECT("関係性データベース", @"(対象キャラ１ = {CFLAG:キャラ番号:人物番号} Or 対象キャラ２ = {CFLAG:キャラ番号:人物番号}) And 関係性種別 = 'セフレ'", , 関係行ID)
IF 関係数 > 0
	FOR LOCAL, 0, 関係数
		IF CFLAG:キャラ番号:人物番号 == DT_CELL_GET("関係性データベース", 関係行ID:LOCAL, "対象キャラ１", 1)
				セフレ相手 = FIND_CHARA_FROM_PERSON_ID(DT_CELL_GET("関係性データベース", 関係行ID:LOCAL, "対象キャラ２", 1))
			ELSE
				セフレ相手 = FIND_CHARA_FROM_PERSON_ID(DT_CELL_GET("関係性データベース", 関係行ID:LOCAL, "対象キャラ１", 1))
		ENDIF
		DT_ROW_REMOVE "関係性データベース", 関係行ID:LOCAL
		IF セフレ相手 >= 0
			セフレ関係数 = DT_SELECT("関係性データベース", @"(対象キャラ１ = {CFLAG:セフレ相手:人物番号} Or 対象キャラ２ = {CFLAG:セフレ相手:人物番号}) And 関係性種別 = 'セフレ'")
			SIF セフレ関係数 < 1
				TALENT:セフレ相手:セフレあり = 0
		ENDIF
	NEXT
ENDIF

関係数 = DT_SELECT("縁結びデータベース", @"(対象キャラ１ = {CFLAG:キャラ番号:人物番号} Or 対象キャラ２ = {CFLAG:キャラ番号:人物番号})", , 関係行ID)
IF 関係数 > 0
	FOR LOCAL, 0, 関係数
		DT_ROW_REMOVE "縁結びデータベース", 関係行ID:LOCAL
	NEXT
ENDIF

;CSVの初期関係性を最後に復元する（相手側だけの記録も対象）
FOR LOCAL, 1, CHARANUM
	SIF ランダムキャラ判定(NO:LOCAL) && LOCAL != キャラ番号
		CONTINUE
	CALL 初期関係性データベース登録(LOCAL, キャラ番号)
NEXT

PRINTFORMW %NAME表示(キャラ番号)%に記憶消去薬を投与しました

RETURN 0

;CSVの恋人を戻す前に、プレイヤーへの恋慕と競合する恋人関係を解除
@記憶消去_恋慕解除(キャラ番号)
#DIM キャラ番号
#DIM 恋慕相手
#DIM 関係行数
#DIM DYNAMIC 関係行ID, キャラクタ数上限

TALENT:キャラ番号:恋慕 = 0
TALENT:キャラ番号:浮気 = 0
CALL 恋人持ち初期化(キャラ番号)
関係行数 = DT_SELECT("関係性データベース", @"(対象キャラ１ = {CFLAG:キャラ番号:人物番号} Or 対象キャラ２ = {CFLAG:キャラ番号:人物番号}) And 関係性種別 = '恋慕'", , 関係行ID)
FOR LOCAL, 0, 関係行数
	IF CFLAG:キャラ番号:人物番号 == DT_CELL_GET("関係性データベース", 関係行ID:LOCAL, "対象キャラ１", 1)
		恋慕相手 = FIND_CHARA_FROM_PERSON_ID(DT_CELL_GET("関係性データベース", 関係行ID:LOCAL, "対象キャラ２", 1))
	ELSE
		恋慕相手 = FIND_CHARA_FROM_PERSON_ID(DT_CELL_GET("関係性データベース", 関係行ID:LOCAL, "対象キャラ１", 1))
	ENDIF
	DT_ROW_REMOVE "関係性データベース", 関係行ID:LOCAL
	IF 恋慕相手 >= 0
		SIF !DT_SELECT("関係性データベース", @"(対象キャラ１ = {CFLAG:恋慕相手:人物番号} Or 対象キャラ２ = {CFLAG:恋慕相手:人物番号}) And 関係性種別 = '恋慕'")
			CALL 恋人持ち初期化(恋慕相手)
	ENDIF
NEXT
RETURN 0

;CSVを参照して元の恋人持ちの数値を入れ直し
@恋人持ち初期化(ARG)
	LOCAL = 0
	LOCAL = CSVTALENT(NO:ARG, 234)
	IF LOCAL == -1
		TALENT:ARG:恋人持ち = -1
	ELSEIF LOCAL == 1
		TALENT:ARG:恋人持ち = 1
	ELSEIF LOCAL == 2
		TALENT:ARG:恋人持ち = 2
	ELSEIF LOCAL == 3
		TALENT:ARG:恋人持ち = 3
	ELSE
		TALENT:ARG:恋人持ち = 0
	ENDIF
RETURN 0


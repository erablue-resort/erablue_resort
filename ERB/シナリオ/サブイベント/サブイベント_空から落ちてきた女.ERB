; ハルハラ ハル子（NO:3652）加入イベント・文章調整用の叩き台
; 仮題：空から落ちてきた女
; 参照本体：erablue-resort/erablue_resort 15de0f32ec59c34623ceb9e42ba4256b5d70d05f
; 会話は仮文。アトムスクやN.Oの名称・説明はイベント本文に出さない。
; 既存のアビリティ・奥義・パッシブ、キャラCSV、本体共通処理は変更しない。
; ハル子は会話上で別方向の魔物を相手にする。探索編成への強制加入はしない。
; 各ウェーブは本体標準の別戦闘。戦闘開始時の味方初期化は連戦の最初の1回だけ。
; 人食い鳥の無制限な増援を避けるため、このイベント中だけ仲間呼びを停止する。
; 検証：静的確認のみ。Emuera本体での起動・戦闘テストは未実施。

; ======================================================================
; 01 調整箇所：ウェーブ数・各ウェーブの敵数
; まず5体×2ウェーブ。3ウェーブにする場合は下のRETURNF 2を3に変更する。
; 敵名は「ハル子加入_連戦」の敵配置箇所にまとめてある。
; ======================================================================
@ハル子加入_ウェーブ数()
#FUNCTION
RETURNF 2

@ハル子加入_敵数(ウェーブ番号)
#FUNCTION
#DIM ウェーブ番号
SELECTCASE ウェーブ番号
	CASE 1
		RETURNF 5
	CASE 2
		RETURNF 5
	CASE 3
		RETURNF 5
	CASEELSE
		RETURNF 0
ENDSELECT

; ======================================================================
; 02 発生条件
; 仮の解放時期：人食い鳥の島クリア後。ZPでのシナリオ購入は要求しない。
; キャラ3652が存在しない環境ではイベントを出さない。
; 招待不可の初期設定はCSV側に任せ、ここでは既存の設定を変更しない。
; ======================================================================
@イベント発生条件_サブイベント_空から落ちてきた女
#DIM ハル子番号
SIF !EXISTCSV(3652)
	RETURN 0
ハル子番号 = GETCHARA(3652)
SIF ハル子番号 < 1
	RETURN 0
SIF ダンジョンクリアフラグ_人食い鳥の島 <= 0
	RETURN 0
SIF イベント完了フラグ確認("空から落ちてきた女") > 0
	RETURN 0
RETURN 1

; ======================================================================
; 03 イベント本体
; 未クリア時は連戦に全勝してから加入処理。敗北・逃走・保留なら完了しない。
; 回想時は文章のみ再生し、戦闘・初期化・招待予約・完了フラグ変更は行わない。
; ======================================================================
@イベント関数_サブイベント_空から落ちてきた女(ARG)
#DIM ハル子番号
#DIM 入力値
#DIM 戦闘結果
#DIM ウェーブ総数

IF !EXISTCSV(3652)
	PRINTW ハル子（キャラ番号3652）のCSVが見つからないため、イベントを開始できません。
	RETURN 0
ENDIF
ハル子番号 = GETCHARA(3652)
IF ハル子番号 < 1
	PRINTW ハル子（キャラ番号3652）のキャラデータが登録されていません。
	RETURN 0
ENDIF
SIF !FLAG:クリア済み視聴フラグ && イベント完了フラグ確認("空から落ちてきた女") > 0
	RETURN 0

ウェーブ総数 = ハル子加入_ウェーブ数()
IF !INRANGE(ウェーブ総数, 2, 3)
	PRINTW ハル子加入イベントのウェーブ数は2か3に設定してください。
	RETURN 0
ENDIF

DRAWLINE
PRINTL ［空から落ちてきた女］
DRAWLINE
PRINTW

IF !FLAG:クリア済み視聴フラグ
	PRINTFORMW リゾート近くに、見慣れない乗り物が落ちたという報告が届いた。
	PRINTFORMW 現場には魔物が集まっているらしい。探索メンバーを連れて、様子を見に行こう。
	PRINTL
	PRINTFORML 低レベルの魔物の群れと{ウェーブ総数}連戦します。現在の探索編成で向かいますか？
	PRINTL
	$ハル子加入_開始確認
	PRINTBUTTON "[0] 様子を見に行く", 0
	PRINTL
	PRINTBUTTON "[1] 準備してから向かう", 1
	PRINTL
	BINPUT
	入力値 = RESULT
	IF 入力値 == 1
		PRINTW まずは準備を整えよう。
		RETURN 0
	ELSEIF 入力値 != 0
		GOTO ハル子加入_開始確認
	ENDIF
ENDIF

CALL ハル子加入_導入()

IF FLAG:クリア済み視聴フラグ
	; 戦闘を省略しても、ウェーブの合間の会話は再生する。
	CALL ハル子加入_回想連戦(ウェーブ総数)
ELSE
	CALL ハル子加入_連戦(ウェーブ総数)
	戦闘結果 = RESULT
	SELECTCASE 戦闘結果
		CASE 0
			; 全ウェーブ勝利。後半の会話へ。
		CASE 1
			PRINTFORMW 群れに押し込まれ、これ以上戦うのは難しそうだ。
			PRINTL 女：
			PRINTW 「はいはい、いったん下がりなって。あたしが道空けるからさぁ」
			PRINTFORMW 女がギターで切り開いた道を抜け、%CALLNAME:PLAYER%たちはその場を離れた。
			PRINTW 編成と装備を整えて出直そう。
			RETURN 0
		CASE -1
			PRINTFORMW %CALLNAME:PLAYER%たちは、いったん群れから距離を取った。
			PRINTL 女：
			PRINTW 「もう帰っちゃうの？　じゃ、今度来る時は工具もよろしくぅ」
			PRINTW 準備を整えて、もう一度様子を見に来よう。
			RETURN 0
		CASEELSE
			; 編成や設定に問題がある場合も、加入・完了には進めない。
			RETURN 0
	ENDSELECT
ENDIF

CALL ハル子加入_修理交渉と滞在()

IF !FLAG:クリア済み視聴フラグ
	CALL ハル子加入_招待解放(ハル子番号)
	CALL イベント完了フラグ汎用処理("空から落ちてきた女")
ELSE
	PRINTL （回想のため、招待状態は変更しません）
ENDIF
FORCEWAIT
RETURN 0

; ======================================================================
; 04 導入：故障・不時着・群れにうんざりしているハル子
; ======================================================================
@ハル子加入_導入()
PRINTFORMW その少し前。
PRINTL
PRINTFORMW 星々の間を、一台のベスパが走っていた。
PRINTFORMW 不意に、エンジンががったんと音を立て、小さな煙を上げる。
PRINTL
PRINTL 女：
PRINTW 「……おいおい。こんなとこでご機嫌斜めってかぁ？」
PRINTL
PRINTFORMW 咳き込むような音を最後に、エンジンは黙ってしまう。
PRINTFORMW 女はハンドルを握り直し、近くに見えた島へと進路を向けた。
PRINTL
PRINTL ……
PRINTW
PRINTFORMW リゾート近く、森の縁の開けた場所。
PRINTFORMW 地面に長い筋を残し、黄色い二輪の乗り物が傾いていた。
PRINTFORMW その脇で、ピンク色の髪をした女がギターを鈍器のように振るっている。
PRINTL
PRINTFORMW 飛びかかってきた鳥の魔物を、女は振り向きざまに打ち返した。
PRINTFORMW 群れはひるむものの獲物を前に逃げ出そうとはしない。女は動かない乗り物へ目をやった。
PRINTL
PRINTL 女：
PRINTW 「あ～あ。面倒くさいとこに落っこちたもんだぜい」
PRINTL

PRINTFORMW 傍にやって来た%CALLNAME:PLAYER%が加勢を呼びかけると、女はこちらに気づいたようだ。
PRINTL
PRINTL 女：
PRINTW 「お、いいとこ来た！　そっちから来る連中、お願いね」
PRINTL
PRINTFORMW 返事を待たず、女は反対側から回り込む魔物へと向き直った。
PRINTFORMW どうやら、もう役割分担は決まったらしい。
PRINTFORMW %CALLNAME:PLAYER%たちも武器を構え、群れへ向かった。
RETURN 0

; ======================================================================
; 05 連戦：既存のイベント中戦闘処理を流用
; 戻り値：0=全勝、1=敗北、-1=逃走、-2=設定/編成不備
; ======================================================================
@ハル子加入_連戦(ウェーブ総数)
#DIM ウェーブ総数
#DIM ウェーブ番号
#DIM 敵番号
#DIM 出現数
#DIM 編成人数
#DIM 戦闘結果
#DIMS 元特殊処理キー

編成人数 = 0
FOR 敵番号, 0, 4
	SIF BATTLE_STATE:敵番号:キャラ登録番号 > 0
		編成人数 += 1
NEXT
IF 編成人数 == 0
	PRINTW 探索編成が設定されていません。探索メンバーを編成してから再度選んでください。
	RETURN -2
ENDIF

; 戦闘を始める前に、全ウェーブの設定を検証する。
FOR ウェーブ番号, 1, ウェーブ総数 + 1
	出現数 = ハル子加入_敵数(ウェーブ番号)
	IF !INRANGE(出現数, 1, 10)
		PRINTFORMW ウェーブ{ウェーブ番号}の敵数は1～10体に設定してください。
		RETURN -2
	ENDIF
NEXT

元特殊処理キー '= 戦闘時_特殊処理フラグ
戦闘結果 = 0
CALL イベント戦闘初期処理()

FOR ウェーブ番号, 1, ウェーブ総数 + 1
	SIF ウェーブ番号 > 1
		CALL ハル子加入_増援会話(ウェーブ番号)

	; 前戦の名前・関数キー・ステータスを全て消してから次の群れを配置する。
	FOR 敵番号, 0, 10
		CALL エネミーリセット処理(敵番号)
	NEXT
	出現数 = ハル子加入_敵数(ウェーブ番号)
	FOR 敵番号, 0, 出現数
		; 敵の仮置き。差し替える場合は、実在するエネミー関数キーを指定する。
		敵BATTLE_STATE_STR:敵番号:エネミー名 = Lv4_人食い鳥
	NEXT

	; この戦闘だけ、標準フックから人食い鳥の仲間呼びを停止する。
	戦闘時_特殊処理フラグ = ハル子加入_群れ
	DRAWLINE
	PRINTFORML WAVE {ウェーブ番号}／{ウェーブ総数}：魔物の群れ（{出現数}体）
	DRAWLINE
	CALL イベント中戦闘用処理()
	戦闘結果 = RESULT
	SIF 戦闘結果 != 0
		BREAK
NEXT

; 敗北・逃走でも必ず標準の終了処理を通す。判定には保存した戦闘結果を使う。
CALL ダンジョン終了時処理()
戦闘時_特殊処理フラグ '= 元特殊処理キー
RETURN 戦闘結果

@固有戦闘開始時処理_特殊_ハル子加入_群れ()
#DIM 敵番号
; 本体は敵ステータス初期化後にこのフックを呼ぶ。
; 仲間呼びだけを止め、攻撃力・HP・ドロップなどは元の敵データのまま使う。
FOR 敵番号, 0, 10
	IF 敵BATTLE_STATE_STR:敵番号:エネミー関数キー == "Lv4_人食い鳥"
		敵BATTLE_STATE:敵番号:最大チャージターン = 0
		敵BATTLE_STATE:敵番号:チャージターン = 0
	ENDIF
NEXT
RETURN 0

@ハル子加入_増援会話(ウェーブ番号)
#DIM ウェーブ番号
PRINTL
IF ウェーブ番号 == 2
	PRINTFORMW 一群を追い払った矢先、木立の向こうから別の群れが飛び出してきた。
	PRINTL 女：
	PRINTW 「まだ来んのかい？　いい加減休みたいなー」
ELSE
	PRINTFORMW 林の奥で、また鳴き声がした。
	PRINTFORMW さらに別の群れが押し寄せてきた。
	PRINTL 女：
	PRINTW 「はーいはい順番待ちしなくていいから。さっさと帰んなってば！」
ENDIF
PRINTFORMW 女はギターを担ぎ直し、次の群れに向き直った。
PRINTL
RETURN 0

@ハル子加入_回想連戦(ウェーブ総数)
#DIM ウェーブ総数
#DIM ウェーブ番号
FOR ウェーブ番号, 1, ウェーブ総数 + 1
	SIF ウェーブ番号 > 1
		CALL ハル子加入_増援会話(ウェーブ番号)
	PRINTFORML （回想：WAVE {ウェーブ番号}の戦闘を省略）
NEXT
RETURN 0

; ======================================================================
; 06 戦闘後：修理の直談判 → 手錠 → 態度の変化 → 滞在 → 独白
; ======================================================================
@ハル子加入_修理交渉と滞在()
PRINTL
PRINTFORMW ようやく群れが散り、森の縁に静けさが戻った。
PRINTFORMW 女はギターを肩に引っかけ、動かない乗り物のそばにしゃがみ込んだ。
PRINTL
PRINTL 女：
PRINTW 「いやぁ助かったー。　でさ、ついでに聞きたいんだけど。コイツ修理できそうなとこ、ない？」
PRINTL
PRINTFORMW まず何者なのかと尋ねると、女は顔を上げた。
PRINTL
PRINTL ハル子：
PRINTW 「ハルハラハル子。ハル子でいいよ。こっちはあたしのベスパ」
PRINTW 「途中で動かなくなっちゃってさぁ。おかげで不時着よ、不時着。困っちまうよね」
PRINTL
PRINTFORMW ベスパ……このケッタギアのような乗機だろうか？
PRINTFORMW ともあれ、この場で立ち話を続けてもどうにもならないだろう。
PRINTFORMW %CALLNAME:PLAYER%は乗機を運ぶ手配をし、ハル子をリゾートへ案内した。
PRINTL
PRINTL ……
PRINTW
PRINTFORMW リゾートに着くなり、ハル子は修理の相談を始めた。
PRINTL
PRINTL ハル子：
PRINTW 「へえ、ここ仕切ってんの、アンタなんだ。だったら話が早いや」
PRINTW 「工具とか、余ってるパーツとかない？　使えそうなのがあればちょーっと分けてほしいんだけど」
PRINTL
PRINTFORMW この島にある部品で、そのベスパとやらを修理できるのだろうか。
PRINTFORMW そう尋ねると、ハル子は気軽に手を振った。
PRINTL
PRINTL ハル子：
PRINTW 「そこは現物見てから考えるって。頼むよぉダンナ」
PRINTL
PRINTFORMW とりあえず工具箱を取ってこようか……と思案していると、ハル子の方からチャリ、と小さな金属音がした。
PRINTFORMW ハル子は自身の手首に付けられている、壊れかけの手錠に目を落とした。
PRINTFORMW やがて顔を上げ、こちらへ鋭い視線を向けた……ような気がする。
PRINTL
PRINTFORMW どうかしたのかと聞こうとすると、ハル子が急に近づいてきた。
PRINTL
PRINTL ハル子：
PRINTW 「……ふうん。アンタ、なかなか面白いねぇ」
PRINTL
PRINTFORMW しゅるりと肩に腕を回され、真横から顔を覗き込まれた。肌が触れ合いそうな距離、ハル子の視線が絡みつく。
PRINTFORMW 先ほどまでの雰囲気とは打って変わり、ハル子はにやりと笑った。
PRINTL
PRINTL ハル子：
PRINTW 「そんな急がなくってもいいじゃんか。このリゾートも、よく見たらいいとこだしさぁ」
PRINTW 「あたし、しばらくここにいようかな。修理？ああ、そんなんのんびりやればいいっしょ？」
PRINTL

PRINTFORMW 滞在したいという申し出を受け、%CALLNAME:PLAYER%は他の客に迷惑をかけないことを念押しした。
PRINTL
PRINTL ハル子：
PRINTW 「話が分かるぅ。じゃ、よろしくね、オーナーさん」
PRINTL
PRINTFORMW ハル子は%CALLNAME:PLAYER%の頬に軽くキスをして、艶めかしい笑みを残した。
PRINTL

PRINTFORMW 部屋の空き状況と手続きを確認するため、%CALLNAME:PLAYER%は席を外した。
PRINTFORMW ハル子はその背中を見送り、もう一度だけ手錠に目を落とした。
PRINTL
PRINTL ハル子：
PRINTW 「ま、上手いこと利用させてもらいますか。あのオーナー、思わぬ掘り出しもんかにゃ」
PRINTW 「しかしリゾート、リゾートね……へっ、たまにゃー羽伸ばしていいっしょぉ」
PRINTL
RETURN 0

; ======================================================================
; 07 招待解放
; 標準の予約配列を使う。直接の部屋割り・強制永住・恋慕付与は行わない。
; 満員でも招待解放は維持し、空室不足を表示する。
; ======================================================================
@ハル子加入_招待解放(ハル子番号)
#DIM ハル子番号
#DIM 招待枠
SIF FLAG:クリア済み視聴フラグ
	RETURN 0
SIF ハル子番号 < 1
	RETURN 0

CFLAG:ハル子番号:招待不可フラグ = 0
DRAWLINE
PRINTFORML %CALLNAME:ハル子番号%をリゾートに招待できるようになりました。

; 導入前から滞在していた場合や、既に予約済みの場合は重複予約しない。
SIF CFLAG:ハル子番号:滞在期間 > 0
	RETURN 0
SIF FINDELEMENT(解放キャラ招待, ハル子番号) >= 0
	RETURN 0
SIF FINDELEMENT(通常キャラ招待, ハル子番号) >= 0
	RETURN 0
SIF FINDELEMENT(持ち越しキャラ招待, ハル子番号) >= 0
	RETURN 0

CALL ユニーク客人数チェック()
招待枠 = FINDELEMENT(解放キャラ招待, 0)
IF 滞在キャラ上限 - 滞在キャラ数 - 集客人数 > 0 && 招待枠 >= 0
	解放キャラ招待:招待枠 = ハル子番号
	FLAG:滞在キャラ枠先確保分 += 1
	PRINTL ハル子の来訪を予約しました。
ELSE
	PRINTL 今は受け入れ枠に空きがありません。空きができたら、キャラクター招待から迎えてください。
ENDIF
RETURN 0

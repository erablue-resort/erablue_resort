;イベントと通常コマンドで共有する、状態・初回記録の処理。
;イベント用の入口は再鑑賞を除外します。経験値・SOURCE・関係性・精液量は自動加算しません。

@体験記録_キャラ組合せ有効(対象キャラ, 相手キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 相手キャラ
	SIF 対象キャラ < 0 || 対象キャラ >= CHARANUM
		RETURNF 0
	SIF 相手キャラ >= CHARANUM || 相手キャラ == 対象キャラ
		RETURNF 0
	RETURNF 1

@体験記録_手段名(手段)
#FUNCTIONS
#DIM 手段
	SELECTCASE 手段
		CASE 1
			RETURNF "ペニス"
		CASE 2
			RETURNF "バイブ"
		CASE 3
			RETURNF "指"
		CASE 4
			RETURNF "触手"
		CASE 5
			RETURNF "ペニスバンド"
	ENDSELECT
	RETURNF ""

;既存の全体初回・相手別初回の重複判定をそのまま利用します。
;返り値は相手別初回の登録ID（既存登録なら0）。履歴は相手別初回にだけ追加します。
@体験記録_初回と相手別登録(対象キャラ, 相手キャラ, 初回名, 相手別名, 日時, 場所, 方法 = "", 履歴文 = "", 備考 = "")
#DIM 対象キャラ
#DIM 相手キャラ
#DIMS 初回名
#DIMS 相手別名
#DIM 日時
#DIMS 場所
#DIMS 方法
#DIMS 履歴文
#DIMS 備考
#DIM 登録ID
	CALL 初体験日登録処理(対象キャラ, 相手キャラ, 初回名, 日時, 場所, 方法, 備考, 1)
	CALL 初体験日登録処理(対象キャラ, 相手キャラ, 相手別名, 日時, 場所, 方法, 備考, 0)
	登録ID = RESULT
	IF 登録ID && 履歴文 != ""
		CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, 履歴文, "うふふ")
	ENDIF
	RETURN 登録ID

@体験記録_うふふ片側(対象キャラ, 相手キャラ, 日時, 場所, 方法 = "")
#DIM 対象キャラ
#DIM 相手キャラ
#DIM 日時
#DIMS 場所
#DIMS 方法
#DIMS 相手名
#DIMS 履歴文
	IF 相手キャラ < 0
		相手名 = 見知らぬ相手
	ELSE
		相手名 '= CALLNAME:相手キャラ
	ENDIF
	履歴文 = <font color='#%カラーパレット_HTML("薄ピンク")%'>初めて%相手名%とえっちをした</font><img src='えっちハート'>
	CALL 体験記録_初回と相手別登録(対象キャラ, 相手キャラ, "初うふふ", "うふふ", 日時, 場所, 方法, 履歴文)
	RETURN RESULT

;種類：Ｖ受け／Ａ受け／Ｖ攻め／Ａ攻め。
;「初体験」は既存キーの意味を維持し、非処女・非童貞でも未登録なら登録します。
@体験記録_挿入片側(対象キャラ, 相手キャラ, 種類, 日時, 場所, 方法 = "", 備考 = "")
#DIM 対象キャラ
#DIM 相手キャラ
#DIMS 種類
#DIM 日時
#DIMS 場所
#DIMS 方法
#DIMS 備考
#DIMS 部位
#DIMS 初回名
#DIMS 相手別名
#DIMS 相手名
#DIMS 履歴文
	SELECTCASE 種類
		CASE "Ｖ受け", "Ｖ攻め"
			部位 = Ｖ
		CASE "Ａ受け", "Ａ攻め"
			部位 = Ａ
		CASEELSE
			RETURN -1
	ENDSELECT
	初回名 = %部位%挿入初体験
	相手別名 = %部位%挿入体験
	IF 相手キャラ < 0
		相手名 = 見知らぬ相手
	ELSE
		相手名 '= CALLNAME:相手キャラ
	ENDIF
	IF 種類 == "Ｖ攻め" || 種類 == "Ａ攻め"
		初回名 += "_男側"
		相手別名 += "_男側"
		履歴文 = <font color='#%カラーパレット_HTML("薄ピンク")%'>初めて%相手名%に%部位%挿入した</font>
	ELSE
		履歴文 = <font color='#%カラーパレット_HTML("薄ピンク")%'>初めて%相手名%から%部位%挿入された</font>
	ENDIF
	CALL 体験記録_初回と相手別登録(対象キャラ, 相手キャラ, 初回名, 相手別名, 日時, 場所, 方法, 履歴文, 備考)
	RETURN RESULT

;通常コマンドでは適用を遅延し、イベントではこの返り値が1の時だけ直ちに適用します。
;再生処女(2)は既存同様、元の喪失相手・道具記録を更新しません。
@体験記録_喪失準備(対象キャラ, 相手キャラ, 種類, 手段 = 1)
#DIM 対象キャラ
#DIM 相手キャラ
#DIMS 種類
#DIM 手段
#DIM 相手人物番号
	IF 相手キャラ < 0
		相手人物番号 = 相手キャラ
	ELSE
		相手人物番号 = CFLAG:相手キャラ:人物番号
	ENDIF
	SELECTCASE 種類
		CASE "Ｖ受け"
			SIF !TALENT:対象キャラ:処女 || RCVAR:対象キャラ:破瓜
				RETURN 0
			RCVAR:対象キャラ:破瓜 = 手段
			RCVAR:対象キャラ:破瓜_相手番号 = 相手キャラ
			IF TALENT:対象キャラ:処女 == 1
				CFLAG:対象キャラ:処女相手番号 = 相手人物番号
				CFLAG:対象キャラ:処女道具記録 = 手段
			ENDIF
		CASE "Ａ受け"
			SIF !TALENT:対象キャラ:Ａ処女 || RCVAR:対象キャラ:Ａ破瓜
				RETURN 0
			RCVAR:対象キャラ:Ａ破瓜 = 手段
			RCVAR:対象キャラ:Ａ破瓜_相手番号 = 相手キャラ
			IF TALENT:対象キャラ:Ａ処女 == 1
				CFLAG:対象キャラ:Ａ処女相手番号 = 相手人物番号
				CFLAG:対象キャラ:Ａ処女道具記録 = 手段
			ENDIF
		CASE "Ｖ攻め"
			SIF GETBIT(TALENT:対象キャラ:性別, 1) == 0 || GETBIT(TALENT:対象キャラ:非童貞, 0) || RCVAR:対象キャラ:童貞喪失
				RETURN 0
			RCVAR:対象キャラ:童貞喪失 = 1
			RCVAR:対象キャラ:童貞喪失_相手番号 = 相手キャラ
			CFLAG:対象キャラ:童貞相手番号 = 相手人物番号
		CASE "Ａ攻め"
			SIF GETBIT(TALENT:対象キャラ:性別, 1) == 0 || GETBIT(TALENT:対象キャラ:非童貞, 1) || RCVAR:対象キャラ:Ａ童貞喪失
				RETURN 0
			RCVAR:対象キャラ:Ａ童貞喪失 = 1
			RCVAR:対象キャラ:Ａ童貞喪失_相手番号 = 相手キャラ
			CFLAG:対象キャラ:Ａ童貞相手番号 = 相手人物番号
		CASEELSE
			RETURN -1
	ENDSELECT
	RETURN 1

;喪失時の素質変更と履歴。通常コマンドの適用関数からも呼びます。
@体験記録_喪失適用(対象キャラ, 相手キャラ, 種類, 手段 = 1)
#DIM 対象キャラ
#DIM 相手キャラ
#DIMS 種類
#DIM 手段
#DIMS 部位
#DIMS 道具記録
#DIMS 相手記録
	SELECTCASE 種類
		CASE "Ｖ受け", "Ｖ攻め"
			部位 = Ｖ
		CASE "Ａ受け", "Ａ攻め"
			部位 = Ａ
		CASEELSE
			RETURN -1
	ENDSELECT
	IF 種類 == "Ｖ受け" || 種類 == "Ａ受け"
		IF 種類 == "Ｖ受け"
			TALENT:対象キャラ:処女 = 0
		ELSE
			TALENT:対象キャラ:Ａ処女 = 0
		ENDIF
		道具記録 '= 体験記録_手段名(手段)
		SELECTCASE 手段
			CASE 1, 4, 5
				IF 相手キャラ < 0
					相手記録 = 誰とも知らない相手の%道具記録%
				ELSE
					相手記録 = %CALLNAME:相手キャラ%の%道具記録%
				ENDIF
			CASEELSE
				相手記録 '= 道具記録
		ENDSELECT
		IF 相手キャラ >= 0
			CALL 履歴データベース登録(CFLAG:相手キャラ:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>%道具記録%で%CALLNAME:対象キャラ%の%部位%処女を奪った</font><img src='えっちハート'>", "うふふ実績")
		ENDIF
		CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>%相手記録%に%部位%処女を捧げた</font><img src='えっちハート'>", "うふふ実績")
	ELSE
		IF 種類 == "Ｖ攻め"
			SETBIT TALENT:対象キャラ:非童貞, 0
		ELSE
			SETBIT TALENT:対象キャラ:非童貞, 1
		ENDIF
		IF 相手キャラ < 0
			相手記録 = 誰とも知らない相手
		ELSE
			相手記録 '= CALLNAME:相手キャラ
			CALL 履歴データベース登録(CFLAG:相手キャラ:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>%CALLNAME:対象キャラ%の%部位%童貞を奪った</font><img src='えっちハート'>", "うふふ実績")
		ENDIF
		CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>%相手記録%に%部位%童貞を捧げた</font><img src='えっちハート'>", "うふふ実績")
	ENDIF
	RETURN 1

;指定種類のフラグだけを消去。他の種類の処理待ちフラグには触れません。
@体験記録_喪失フラグ消去(対象キャラ, 種類)
#DIM 対象キャラ
#DIMS 種類
	SELECTCASE 種類
		CASE "Ｖ受け"
			RCVAR:対象キャラ:破瓜 = 0
			RCVAR:対象キャラ:破瓜_相手番号 = 0
		CASE "Ａ受け"
			RCVAR:対象キャラ:Ａ破瓜 = 0
			RCVAR:対象キャラ:Ａ破瓜_相手番号 = 0
		CASE "Ｖ攻め"
			RCVAR:対象キャラ:童貞喪失 = 0
			RCVAR:対象キャラ:童貞喪失_相手番号 = 0
		CASE "Ａ攻め"
			RCVAR:対象キャラ:Ａ童貞喪失 = 0
			RCVAR:対象キャラ:Ａ童貞喪失_相手番号 = 0
	ENDSELECT

;以下はイベント作者向け。返り値：1=実行、0=再鑑賞によるスキップ、-1=引数・処理状況が不正。
@イベントうふふ記録(キャラ１, キャラ２, 日時 = -1, 場所 = "", イベント名 = "")
#DIM キャラ１
#DIM キャラ２
#DIM 日時
#DIMS 場所
#DIMS イベント名
#DIMS 方法
	SIF FLAG:クリア済み視聴フラグ
		RETURN 0
	SIF !体験記録_キャラ組合せ有効(キャラ１, キャラ２)
		RETURN -1
	SIF 日時 < 0
		日時 = DAY * 1440 + TIME
	SIF 場所 == ""
		場所 = 不明
	方法 =
	SIF イベント名 != ""
		方法 = イベント_%イベント名%
	CALL 体験記録_うふふ片側(キャラ１, キャラ２, 日時, 場所, 方法)
	IF キャラ２ >= 0
		CALL 体験記録_うふふ片側(キャラ２, キャラ１, 日時, 場所, 方法)
	ENDIF
	RETURN 1

;対象キャラ=受け側、相手キャラ=行う側。行為は「Ｖ挿入」「Ａ挿入」。
;この関数だけで双方のうふふ初回記録も登録します。
@イベント性交記録(対象キャラ, 相手キャラ, 行為, 日時 = -1, 場所 = "", イベント名 = "", 手段 = 1)
#DIM 対象キャラ
#DIM 相手キャラ
#DIMS 行為
#DIM 日時
#DIMS 場所
#DIMS イベント名
#DIM 手段
#DIMS 受け種類
#DIMS 攻め種類
#DIMS 方法
	SIF FLAG:クリア済み視聴フラグ
		RETURN 0
	SIF !体験記録_キャラ組合せ有効(対象キャラ, 相手キャラ) || !GROUPMATCH(手段, 1, 2, 3, 4, 5)
		RETURN -1
	SELECTCASE 行為
		CASE "Ｖ挿入"
			SIF GETBIT(TALENT:対象キャラ:性別, 0) == 0
				RETURN -1
			受け種類 = Ｖ受け
			攻め種類 = Ｖ攻め
		CASE "Ａ挿入"
			受け種類 = Ａ受け
			攻め種類 = Ａ攻め
		CASEELSE
			RETURN -1
	ENDSELECT
	SIF 日時 < 0
		日時 = DAY * 1440 + TIME
	SIF 場所 == ""
		場所 = 不明
	;通常コマンド同様、相手に男性器がない場合の手段1はペニスバンド扱いです。
	IF 手段 == 1
		IF 相手キャラ >= 0
			SIF GETBIT(TALENT:相手キャラ:性別, 1) == 0
				手段 = 5
		ELSE
			SIF GETBIT(ABS(相手キャラ), 1) == 0
				手段 = 5
		ENDIF
	ENDIF
	;通常コマンドが同じ種類の喪失を適用待ちにしている場合は、先に通常側で確定します。
	IF 受け種類 == "Ｖ受け"
		SIF RCVAR:対象キャラ:破瓜
			RETURN -1
	ELSE
		SIF RCVAR:対象キャラ:Ａ破瓜
			RETURN -1
	ENDIF
	IF 相手キャラ >= 0 && 手段 == 1
		IF 攻め種類 == "Ｖ攻め"
			SIF RCVAR:相手キャラ:童貞喪失
				RETURN -1
		ELSE
			SIF RCVAR:相手キャラ:Ａ童貞喪失
				RETURN -1
		ENDIF
	ENDIF
	方法 '= 体験記録_手段名(手段)
	CALL イベントうふふ記録(対象キャラ, 相手キャラ, 日時, 場所, イベント名)
	CALL 体験記録_挿入片側(対象キャラ, 相手キャラ, 受け種類, 日時, 場所, 方法, イベント名)
	CALL 体験記録_喪失準備(対象キャラ, 相手キャラ, 受け種類, 手段)
	IF RESULT == 1
		CALL 体験記録_喪失適用(対象キャラ, 相手キャラ, 受け種類, 手段)
		CALL 体験記録_喪失フラグ消去(対象キャラ, 受け種類)
	ENDIF
	IF 相手キャラ >= 0 && 手段 == 1
		CALL 体験記録_挿入片側(相手キャラ, 対象キャラ, 攻め種類, 日時, 場所, "", イベント名)
		CALL 体験記録_喪失準備(相手キャラ, 対象キャラ, 攻め種類)
		IF RESULT == 1
			CALL 体験記録_喪失適用(相手キャラ, 対象キャラ, 攻め種類)
			CALL 体験記録_喪失フラグ消去(相手キャラ, 攻め種類)
		ENDIF
	ENDIF
	RETURN 1

;既存の「あなたの手で初絶頂」の日付と双方の履歴を登録します。
;MASTER以外を相手とする場合、このMASTER専用記録は更新しません。
@イベント絶頂記録(対象キャラ, 相手キャラ)
#DIM 対象キャラ
#DIM 相手キャラ
	SIF FLAG:クリア済み視聴フラグ
		RETURN 0
	SIF !体験記録_キャラ組合せ有効(対象キャラ, 相手キャラ)
		RETURN -1
	IF 相手キャラ == MASTER && 対象キャラ != MASTER && 初体験日:対象キャラ:あなたの手で初絶頂 < 1
		初体験日:対象キャラ:あなたの手で初絶頂 = DAY
		CALL 履歴データベース登録(CFLAG:MASTER:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>初めて%CALLNAME:対象キャラ%を絶頂させた</font>", "うふふ")
		CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>初めて%CALLNAME:MASTER%の手で絶頂した</font>", "うふふ")
	ENDIF
	RETURN 1

;加算前の経験値を保存し、このイベントの差分だけを表示・履歴判定する準備をします。
@イベント経験開始(キャラ１, キャラ２ = -1)
#DIM キャラ１
#DIM キャラ２
#DIM EXP番号
	SIF FLAG:クリア済み視聴フラグ
		RETURN 0
	SIF !体験記録_キャラ組合せ有効(キャラ１, キャラ２)
		RETURN -1
	FOR EXP番号, 0, 200
		TCVAR:キャラ１:(400 + EXP番号) = EXP:キャラ１:EXP番号
		SIF キャラ２ >= 0
			TCVAR:キャラ２:(400 + EXP番号) = EXP:キャラ２:EXP番号
	NEXT
	RETURN 1

;イベント経験開始の後で経験値を加算し、この関数で差分表示と履歴を確定します。
;経験値の加算自体は、再鑑賞でないことを確認してイベント側で行います。
@イベント経験確定(キャラ１, キャラ２ = -1, 表示あり = 1)
#DIM キャラ１
#DIM キャラ２
#DIM 表示あり
	SIF FLAG:クリア済み視聴フラグ
		RETURN 0
	SIF !体験記録_キャラ組合せ有効(キャラ１, キャラ２)
		RETURN -1
	IF 表示あり
		CALL EXP取得表示_指定キャラ(キャラ１)
		SIF キャラ２ >= 0
			CALL EXP取得表示_指定キャラ(キャラ２)
	ENDIF
	CALL EXP変動記録処理(キャラ１)
	SIF キャラ２ >= 0
		CALL EXP変動記録処理(キャラ２)
	RETURN 1


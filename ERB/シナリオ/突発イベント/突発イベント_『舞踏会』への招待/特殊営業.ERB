;=============================================================
;屈服ルート（事後ルート = 3）の精算
;正常位→後背位→騎乗位→種付けプレス→口淫清掃、五段フルコース分を一括で。
;基準は オートコマンド関連\物陰連れ込まれ処理.ERB の
;@逆性処理_EXP増加処理(対象キャラ, ダウンフラグ) を一晩分に増量したもの。
;数値を調整する時はこの関数だけ触ればいい。
;=============================================================
@屈服路線_精算(精算対象)
#DIM 精算対象
#DIM 消耗体力
#DIM 注ぎ込んだ量

	;---------- 経験値 ----------
	EXP:精算対象:肉体熟知 += RAND(150, 300)
	EXP:精算対象:Ｖ経験 += RAND(30, 50)
	EXP:精算対象:Ｖ性交経験 += RAND(12, 20)
	EXP:精算対象:Ｖ絶頂経験 += RAND(2, 4)
	EXP:精算対象:絶頂経験 += RAND(2, 4)
	EXP:精算対象:膣内射精絶頂経験 += 1
	EXP:精算対象:苦痛快楽経験 += RAND(20, 40)
	EXP:精算対象:口淫経験 += RAND(40, 70)
	EXP:精算対象:精飲経験 += RAND(20, 35)
	EXP:精算対象:精液経験 += RAND(15, 25)
	EXP:精算対象:性接待経験 += 1
	EXP:精算対象:被写経験 += 1
	EXP:MASTER:被接待経験 += 1

	;---------- パラメータ（PALAMLV:3=3000 / 4=10000 / 5=30000） ----------
	PALAM:精算対象:快Ｖ += 10000
	PALAM:精算対象:屈服 += 20000
	PALAM:精算対象:欲情 += 5000
	PALAM:精算対象:奉仕 += 5000
	PALAM:精算対象:苦痛 += 3000
	PALAM:精算対象:恥情 = MAX(0, PALAM:精算対象:恥情 - 5000)

	;---------- 刻印（ここまで堕ちたなら屈服は最低Lv2） ----------
	MARK:精算対象:屈服刻印 = MIN(3, MAX(MARK:精算対象:屈服刻印 + 1, 2))

	;---------- 好感度要素（友情／信頼／恋心／性愛／キャラ固有） ----------
	;NOWEX に積んでから 関係性ゲージUP用関数 で一括精算する。
	;手順は 口上_キャラ個別ERB\2726_ちひろ\キャライベント_『シンデレラ』と『舞踏会』.ERB:305-315 と同じ。
	;恋慕度は恋心度の 1/3 が MAX で引き上げられる（TRACHECK.ERB:1357）。
	NOWEX:精算対象:友情度上昇格納 += RAND(300, 600)
	NOWEX:精算対象:信頼度上昇格納 += RAND(500, 1000)
	NOWEX:精算対象:恋心度上昇格納 += RAND(600, 1200)
	NOWEX:精算対象:性愛度上昇格納 += RAND(800, 1600)
	SIF CSTR:精算対象:キャラ固有好感度要素 != ""
		NOWEX:精算対象:キャラ固有好感度要素上昇格納 += RAND(300, 600)
	CALL 関係性ゲージUP用関数(精算対象, 0, "好感度")
	;精算済みの一時値を戻す（次イベントへ持ち越さない）
	NOWEX:精算対象:友情度上昇格納 = 0
	NOWEX:精算対象:信頼度上昇格納 = 0
	NOWEX:精算対象:恋心度上昇格納 = 0
	NOWEX:精算対象:性愛度上昇格納 = 0
	NOWEX:精算対象:キャラ固有好感度要素上昇格納 = 0

	;---------- 消耗 ----------
	消耗体力 = RAND(300, 500)
	BASE:精算対象:体力 = MAX(0, BASE:精算対象:体力 - 消耗体力)
	BASE:精算対象:理性 = MAX(0, BASE:精算対象:理性 - 300)
	;履歴登録（SOURCE.ERB:440-442 と同じ手順。成就の閾値判定を通すためRFLAG経由）
	RFLAG:履歴用数値保存 = 消耗体力
	CALL 履歴登録チェック(精算対象, "体力減少")
	履歴用実績:精算対象:体力減少量累積 += 消耗体力

	;---------- 膣内射精（妊娠・精液量の計上） ----------
	注ぎ込んだ量 = 500
	CALL TAKE_SPERM(精算対象, PLAYER, 注ぎ込んだ量)
	;履歴登録（SOURCE_SHOOT_射精先一覧.ERB:127-130 と同じ手順）
	RFLAG:履歴用数値保存 = 1
	CALL 履歴登録チェック(精算対象, "膣内射精回数")
	履歴用実績:精算対象:膣内射精回数 += 1
	;口淫清掃で搾り取った分
	RFLAG:履歴用数値保存 = 1
	CALL 履歴登録チェック(精算対象, "口内射精回数")
	履歴用実績:精算対象:口内射精回数 += 1
	;絶頂ハメ撮り（COMF414_写真を撮る.ERB:163-165 と同じ手順）
	履歴用実績:精算対象:絶頂ハメ撮り回数 += 1
	CALL 履歴登録チェック(精算対象, "被写体_ハメ撮り_絶頂時")

	;---------- 能力上昇（EXP連動：指テク／舌技／腰使い） ----------
	CALL SOURCE_ABLUP(精算対象)

	;---------- 通知（設定で数値変動を隠している時は出さない） ----------
	SIF !OPTION変数:数値変動省略
		PRINTFORMW 　%CALLNAME:精算対象%の身体に、深い屈服の刻印が刻まれた……（屈服刻印 Lv{MARK:精算対象:屈服刻印}）


;---------- 体験回数から事後ルート番号を決める（呼ぶたびに体験回数を１つ進める） ----------
;戻り値：0＝失神／1＝自慰（ボタンで屈服ルート選択可）／2＝展示
@特殊営業_ルート番号取得(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 体験回数
体験回数 = 特殊営業体験回数:対象キャラ:0
特殊営業体験回数:対象キャラ:0 += 1
SELECTCASE 体験回数
	CASE 0
		;初回は必ず失神
		RETURNF 0
	CASE 1
		;２回目は必ず展示
		RETURNF 2
	CASEELSE
		;３回目以降は自慰（ここから屈服ルートを選べる）
		RETURNF 1
ENDSELECT
RETURNF 1

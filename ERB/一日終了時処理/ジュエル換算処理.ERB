
@JUEL_CHECK(ARG)
#DIM ループ用
#DIM 獲得量
#DIM CONST PALAM_潤滑 = GETNUM(PALAM, "潤滑")
#DIM CONST PALAM_否定 = GETNUM(PALAM, "否定")

FOR ループ用, 0, VARSIZE("PALAM")
	SIF STRLENSU(PALAMNAME:ループ用) == 0
		CONTINUE
	;PALAM:潤滑は珠にならない
	SIF ループ用 == PALAM_潤滑
		CONTINUE
	;PALAM:否定は存在しない。反感や不快が否定の珠になる
	SIF ループ用 == PALAM_否定
		CONTINUE

	SELECTCASE PALAM:ARG:ループ用
		CASE IS < PALAMLV:1
			獲得量 = 0
		CASE IS < PALAMLV:1 * 3
			獲得量 = 1
		CASE IS < PALAMLV:2
			獲得量 = 2
		CASE IS < PALAMLV:2 * 3
			獲得量 = 10
		CASE IS < PALAMLV:3
			獲得量 = 20
		CASE IS < PALAMLV:3 * 2
			獲得量 = 100
		CASE IS < PALAMLV:4
			獲得量 = 200
		CASE IS < PALAMLV:5
			獲得量 = 1000
		CASE IS < PALAMLV:6
			獲得量 = 2000
		CASE IS < PALAMLV:7
			獲得量 = 3000
		CASE IS < PALAMLV:8
			獲得量 = 5000
		CASE IS < PALAMLV:9
			獲得量 = 8000
		CASE IS < PALAMLV:10
			獲得量 = 12000
		CASE IS < PALAMLV:11
			獲得量 = 25000
		CASE IS < PALAMLV:12
			獲得量 = 40000
		CASE IS < PALAMLV:13
			獲得量 = 60000
		CASE IS < PALAMLV:14
			獲得量 = 100000
		CASEELSE
			獲得量 = 150000
	ENDSELECT
	
	;快感系
	IF ループ用 >= 0 && ループ用 < 5
		獲得量 = 獲得量 + EX:ARG:ループ用 * 1000
	ENDIF
	
	SIF ループ用 == 0 && !獲得量 && TALENT:ARG:性別 == 2 &&  OPTION変数:男性感度上昇低下
		獲得量 = 獲得量 / 250 + 1
		
	SIF ループ用 == 4 && !獲得量 && TALENT:ARG:性別 == 2 &&  OPTION変数:男性感度上昇低下
		獲得量 = 獲得量 / 50 + 1
		
	SIF (ループ用 == 3 || ループ用 == 10 || ループ用 == 12 || ループ用 == 16) && TALENT:ARG:性別 == 2 &&  OPTION変数:男性感度上昇低下
		獲得量 = 獲得量 / 1000
	
	IF IS_DENIAL_PALAM(ループ用)
		;否定の珠
		JUEL:ARG:否定 += 獲得量 * 2
	ELSE
		JUEL:ARG:ループ用 += 獲得量
	ENDIF
NEXT


@IS_DENIAL_PALAM(ARG)
#FUNCTION
;PALAM簡略化：反感・不快→否定の珠の換算は廃止。常時0を返す
RETURNF 0

@DENIAL_CHECK(ARG)
;PALAM簡略化：否定の珠のブレーキは廃止。本体は無効化
RETURN 0

;-------------------------------------------------
;恋心度の精神枠補正
;　共通＋独占欲／貞操（軽め）／羞恥心（軽め）
;-------------------------------------------------
@SOURCE_補正取得_恋心度_精神枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_精神枠(対象キャラ)
	;独占欲（+10）
	SIF TALENT:対象キャラ:独占欲
		補正値 += 10
	;貞操（貞操観念 -5／貞操無頓着 +5）
	補正値 -= TALENT:対象キャラ:貞操 * 5
	;羞恥心（恥じらい -5／恥薄い +5）
	補正値 -= TALENT:対象キャラ:羞恥心 * 5
	RETURNF 補正値

;-------------------------------------------------
;性愛度の精神枠補正
;　共通＋性への態度一式
;-------------------------------------------------
@SOURCE_補正取得_性愛度_精神枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_精神枠(対象キャラ)
	;性欲（強い +10／薄い -10／無し -20）
	補正値 += TALENT:対象キャラ:性欲 * 10
	;好奇心（好奇心 +10／保守的 -10）
	補正値 += TALENT:対象キャラ:好奇心 * 10
	;貞操（貞操観念 -10／貞操無頓着 +10）
	補正値 -= TALENT:対象キャラ:貞操 * 10
	;羞恥心（恥じらい -10／恥薄い +10）
	補正値 -= TALENT:対象キャラ:羞恥心 * 10
	;好色（+10）
	SIF TALENT:対象キャラ:好色
		補正値 += 10
	;浮気性（+5）
	SIF TALENT:対象キャラ:浮気性
		補正値 += 5
	;目立ちたがり（目立ちたがり +5／目立ちたくない -5）
	補正値 += TALENT:対象キャラ:目立ちたがり * 5
	;独占欲（+5）
	SIF TALENT:対象キャラ:独占欲
		補正値 += 5
	RETURNF 補正値



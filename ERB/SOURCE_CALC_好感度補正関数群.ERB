;-------------------------------------------------
;好感度上昇の枠補正を取得する関数群（新規追加分）
;　物理枠・状況枠・精神枠の補正値を、要素別に返す
;　・引数は対象キャラのみ（行為者はこの経路では常にMASTERのため直接参照）
;　・素質名は素質整理後の新体系に準拠
;　・既存の要素関数への接続（呼び出しへの差し替え）は別途行うこと
;　・二人きり判定は GET_TARGETNUM() に依るため、呼び出し時点の
;　　TARGETが対象キャラである文脈で使うこと
;-------------------------------------------------

;================ 物理枠 ================

;-------------------------------------------------
;好感度共通の物理枠補正
;　容姿（行為者側）／体臭（行為者側・相手の汚臭耐性で増減）／酩酊（対象側）
;-------------------------------------------------
@SOURCE_補正取得_好感度共通_物理枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	;容姿（-10～+20）
	補正値 = TALENT:MASTER:容姿 * 10
	;体臭（潔癖症±20／汚臭敏感±15／通常±10／汚臭鈍感±5／汚れ無視0）
	補正値 += TALENT:MASTER:体臭 * (10 - TALENT:対象キャラ:汚臭耐性 * 5)
	;酩酊（満タンで+20）
	補正値 += GET_REVISION(BASE:対象キャラ:酩酊, 40, 1000)
	RETURNF 補正値

;-------------------------------------------------
;友情度の物理枠補正
;　共通＋会話難
;-------------------------------------------------
@SOURCE_補正取得_友情度_物理枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_物理枠(対象キャラ)
	;会話難（口下手 -10／会話難 -20）
	補正値 -= TALENT:対象キャラ:会話難 * 10
	RETURNF 補正値

;-------------------------------------------------
;信頼度の物理枠補正
;　共通のみ
;-------------------------------------------------
@SOURCE_補正取得_信頼度_物理枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_物理枠(対象キャラ)
	RETURNF 補正値

;-------------------------------------------------
;恋心度の物理枠補正
;　共通＋媚薬・発情期（どちらかで+30、重複なし）
;-------------------------------------------------
@SOURCE_補正取得_恋心度_物理枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_物理枠(対象キャラ)
	;媚薬・発情期
	IF TEQUIP:対象キャラ:媚薬 || (GETBIT(TALENT:対象キャラ:発情期あり, 6) && CFLAG:対象キャラ:発情期フラグ < 0)
		補正値 += 30
	ENDIF
	RETURNF 補正値

;-------------------------------------------------
;性愛度の物理枠補正
;　共通＋媚薬・発情期（どちらかで+30、重複なし）
;-------------------------------------------------
@SOURCE_補正取得_性愛度_物理枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_物理枠(対象キャラ)
	;媚薬・発情期
	IF TEQUIP:対象キャラ:媚薬 || (GETBIT(TALENT:対象キャラ:発情期あり, 6) && CFLAG:対象キャラ:発情期フラグ < 0)
		補正値 += 30
	ENDIF
	RETURNF 補正値

;================ 状況枠 ================

;-------------------------------------------------
;好感度共通の状況枠補正
;　ムード（1500で+50）／マッサージ中は警戒の低さで代替（最大+50）
;-------------------------------------------------
@SOURCE_補正取得_好感度共通_状況枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	IF SAVESTR:ゲームフェイズ管理 == "マッサージモード"
		;警戒の低さ
		補正値 = GET_REVISION(1000 - BASE:対象キャラ:警戒, 200, 3000)
	ELSE
		;ムード
		補正値 = GET_REVISION(BASE:対象キャラ:ムード, 250, 6000)
	ENDIF
	RETURNF 補正値

;-------------------------------------------------
;友情度の状況枠補正
;　共通のみ
;-------------------------------------------------
@SOURCE_補正取得_友情度_状況枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_状況枠(対象キャラ)
	RETURNF 補正値

;-------------------------------------------------
;信頼度の状況枠補正
;　共通＋デート中
;-------------------------------------------------
@SOURCE_補正取得_信頼度_状況枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_状況枠(対象キャラ)
	;デート中（+20）
	SIF CFLAG:対象キャラ:デート == MASTER + 100
		補正値 += 20
	RETURNF 補正値

;-------------------------------------------------
;恋心度の状況枠補正
;　共通＋二人きり＋デート中（同時成立時は両方発揮）
;-------------------------------------------------
@SOURCE_補正取得_恋心度_状況枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_状況枠(対象キャラ)
	;二人きり（+20）
	SIF GET_TARGETNUM() == 1
		補正値 += 20
	;デート中（+20）
	SIF CFLAG:対象キャラ:デート == MASTER + 100
		補正値 += 20
	RETURNF 補正値

;-------------------------------------------------
;性愛度の状況枠補正
;　共通＋二人きり
;-------------------------------------------------
@SOURCE_補正取得_性愛度_状況枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	補正値 = SOURCE_補正取得_好感度共通_状況枠(対象キャラ)
	;二人きり（+20）
	SIF GET_TARGETNUM() == 1
		補正値 += 20
	RETURNF 補正値

;================ 精神枠 ================

;-------------------------------------------------
;好感度共通の精神枠補正
;　相手側の性格素質のみを見る
;　反転・無効化の境目は 好感度レベル > 関係閾値:2
;-------------------------------------------------
@SOURCE_補正取得_好感度共通_精神枠(対象キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 補正値
	;社交性（人見知りは関係が育つと -10 → +10 に反転）
	IF TALENT:対象キャラ:社交性 == -1 && CFLAG:対象キャラ:好感度レベル > 関係閾値:2
		補正値 += 10
	ELSE
		補正値 += TALENT:対象キャラ:社交性 * 10
	ENDIF
	;態度（素直 +10／反抗的 -10）
	補正値 -= TALENT:対象キャラ:態度 * 10
	;愛想（愛想が良い +5／無愛想 -5）
	補正値 += TALENT:対象キャラ:愛想 * 5
	;応答（大人しい +5／生意気 -5）
	補正値 -= TALENT:対象キャラ:応答 * 5
	;面倒見（面倒見が良い +10／無関心 -10）
	補正値 -= TALENT:対象キャラ:面倒見 * 10
	;優しさ（優しい +5／意地悪 -5）
	補正値 += TALENT:対象キャラ:優しさ * 5
	;感情の豊かさ（感情豊か +10／感情乏しい -10）
	補正値 += TALENT:対象キャラ:感情の豊かさ * 10
	;感情の表出（表情豊か +5／無表情 -5）
	補正値 += TALENT:対象キャラ:感情の表出 * 5
	;流されやすさ（押しに弱い +10／流されない -10）
	補正値 += TALENT:対象キャラ:流されやすさ * 10
	;頑固さ（頑固は関係が育つと無効化、柔軟は +10）
	IF TALENT:対象キャラ:頑固さ == 1 && CFLAG:対象キャラ:好感度レベル > 関係閾値:2
		;無効化
	ELSE
		補正値 -= TALENT:対象キャラ:頑固さ * 10
	ENDIF
	;プライド（高い方は関係が育つと無効化、低い方は +5）
	IF TALENT:対象キャラ:プライド == 1 && CFLAG:対象キャラ:好感度レベル > 関係閾値:2
		;無効化
	ELSE
		補正値 -= TALENT:対象キャラ:プライド * 5
	ENDIF
	;ツンデレ（関係が育つと -10 → +20 に反転）
	IF TALENT:対象キャラ:ツンデレ
		IF CFLAG:対象キャラ:好感度レベル > 関係閾値:2
			補正値 += 20
		ELSE
			補正値 -= 10
		ENDIF
	ENDIF
	;性別嗜好
	SELECTCASE TALENT:対象キャラ:性別嗜好
		CASE 1
			SIF TALENT:MASTER:性別 == 2
				補正値 += -30
		CASE 2
			SIF TALENT:MASTER:性別 == 1
				補正値 += -30
		CASE 3
			補正値 += -30
	ENDSELECT
	RETURNF 補正値


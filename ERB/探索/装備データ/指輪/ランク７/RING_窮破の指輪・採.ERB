@指輪個別文章表示_窮破の指輪・採
LOCALS = 
LOCALS += @"■窮破の指輪・採<br><br>"
LOCALS += "窮地を破るための指輪。<br>"
LOCALS += "例え厳しい状況だろうと、相手に合わせた的確な戦術があれば打破出来ることを示す。<br>"
LOCALS += "討伐対象を想定した調整がされており、事前に作戦を立てる騎空士に人気。<br>"
LOCALS += "最高品質のため全空でも数が少なく、深部のダンジョンでしか見かけない。<br>"
LOCALS += "<br>"

詳細文文字列受け渡し変数 = %LOCALS%
基礎販売額 = 100000

@指輪基礎効果文章表示_窮破の指輪・採(指輪番号, 効果番号)
#DIM 効果番号
#DIM 指輪番号
LOCALS = 
LOCALS += "【基礎効果】<br>"
LOCALS += "最大ＨＰ+1600 最大ＭＰ+480 攻撃力+480 防御力+480 回復力+480<br>"
LOCALS += "行動速度+480 DA率+40% TA率+20% 対植物・虫・爬虫特攻<br>"

LOCALS:1 = %DT_CELL_GETS("所持指輪データベース", 指輪番号, "オプションステータス補正", 1)%
IF LOCALS:1 != ""
	LOCALS += @"<br>【オプション効果】<br>%オプション効果表示文字列作成(LOCALS:1)%"
ENDIF

詳細文文字列受け渡し変数 = %LOCALS%

@指輪出現率_窮破の指輪・採(入手タイプ, 装備ランク)
#DIMS 入手タイプ
#DIM 装備ランク

SIF 装備ランク < 7
	RETURN 0
SELECTCASE 入手タイプ
	CASE "輸入"
		RETURN 装備レアリティ_Ｎ
	CASE "古ぼけた装備"
		RETURN 装備レアリティ_Ｎ
ENDSELECT

@指輪ステータス決定_窮破の指輪・採(オプション数, 情報取得フラグ = 0, 効果指定 = -1)
#DIM 効果指定
#DIM オプション数
#DIM 情報取得フラグ
#DIMS 基本補正文字列

基本補正文字列 = 最大ＨＰ_1600_最大ＭＰ_480_攻撃力_480_防御力_480_回復力_480_行動速度_480_DA率_40_TA率_20

IF 情報取得フラグ
	詳細文文字列受け渡し変数 = %基本補正文字列%
	;オプション固定用にオプションランクを返す
	RETURN 5
ENDIF

;オプション数に応じてオプション効果をランダムで付加
;ランク7の指輪なのでLv5のオプションが付く
;Lv5オプションは既存ゲームにはないため、別ファイルで新規作成すること

オプション補正文字列 = 
IF オプション数
	FOR LOCAL, 0, オプション数
		CALL オプション効果決定(5)
	NEXT
ENDIF

LOCAL = DT_ROW_ADD("所持指輪データベース", "指輪名", "窮破の指輪・採", "基礎ステータス補正", 基本補正文字列, "オプションステータス補正", オプション補正文字列)


@固有バフ・デバフ処理_指輪_窮破の指輪・採_与ダメージ(隊列番号, ダメージ値)
#DIM 隊列番号
#DIM ダメージ値

;対象の種族がいずれかの特攻条件を満たすなら
IF 種族判定関数(戦闘行動対象, "植物", "虫類", "爬虫")
	;ダメージ１．７倍
	RETURN ダメージ値 * 170 / 100
ENDIF

;上に引っかからなかったらダメージをそのまま返す
RETURN ダメージ値

@指輪個別文章表示_超克の指輪・鎮
LOCALS = 
LOCALS += @"■超克の指輪・鎮<br><br>"
LOCALS += "征伐の指輪をさらに研ぎ澄ませた、上位の指輪。<br>"
LOCALS += "討伐対象を想定した調整がされており、事前に作戦を立てる騎空士に人気。<br>"
LOCALS += "高品質なため全空でも数が少なく、深部のダンジョンでしか見かけない。<br>"
LOCALS += "<br>"

詳細文文字列受け渡し変数 = %LOCALS%
基礎販売額 = 50000

@指輪基礎効果文章表示_超克の指輪・鎮(指輪番号, 効果番号)
#DIM 効果番号
#DIM 指輪番号
LOCALS = 
LOCALS += "【基礎効果】<br>"
LOCALS += "最大ＨＰ+800 最大ＭＰ+240 攻撃力+240 防御力+240 回復力+240<br>"
LOCALS += "行動速度+240 DA率+20% TA率+10% 命中率+10% 対霊魂・精霊・星晶特攻<br>"

LOCALS:1 = %DT_CELL_GETS("所持指輪データベース", 指輪番号, "オプションステータス補正", 1)%
IF LOCALS:1 != ""
	LOCALS += @"<br>【オプション効果】<br>%オプション効果表示文字列作成(LOCALS:1)%"
ENDIF

詳細文文字列受け渡し変数 = %LOCALS%

@指輪出現率_超克の指輪・鎮(入手タイプ, 装備ランク)
#DIMS 入手タイプ
#DIM 装備ランク

SIF 装備ランク < 5
	RETURN 0
SELECTCASE 入手タイプ
	CASE "輸入"
		RETURN 装備レアリティ_Ｎ
	CASE "古ぼけた装備"
		RETURN 装備レアリティ_Ｎ
ENDSELECT

@指輪ステータス決定_超克の指輪・鎮(オプション数, 情報取得フラグ = 0, 効果指定 = -1)
#DIM 効果指定
#DIM オプション数
#DIM 情報取得フラグ
#DIMS 基本補正文字列

基本補正文字列 = 最大ＨＰ_800_最大ＭＰ_240_攻撃力_240_防御力_240_回復力_240_行動速度_240_DA率_20_TA率_10_命中率_10

IF 情報取得フラグ
	詳細文文字列受け渡し変数 = %基本補正文字列%
	;オプション固定用にオプションランクを返す
	RETURN 3
ENDIF

;オプション数に応じてオプション効果をランダムで付加
;ランク5の指輪だがベース指輪なのでLv3のオプションが付く

オプション補正文字列 = 
IF オプション数
	FOR LOCAL, 0, オプション数
		CALL オプション効果決定(3)
	NEXT
ENDIF

LOCAL = DT_ROW_ADD("所持指輪データベース", "指輪名", "超克の指輪・鎮", "基礎ステータス補正", 基本補正文字列, "オプションステータス補正", オプション補正文字列)


@固有バフ・デバフ処理_指輪_超克の指輪・鎮_与ダメージ(隊列番号, ダメージ値)
#DIM 隊列番号
#DIM ダメージ値

;対象の種族がいずれかの特攻条件を満たすなら
IF 種族判定関数(戦闘行動対象, "霊魂", "精霊", "星晶", "星晶獣")
	;ダメージ１．５倍
	RETURN ダメージ値 * 150 / 100
ENDIF

;上に引っかからなかったらダメージをそのまま返す
RETURN ダメージ値

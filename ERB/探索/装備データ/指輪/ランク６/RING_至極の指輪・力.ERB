@指輪個別文章表示_至極の指輪・力
LOCALS = 
LOCALS += @"■至極の指輪・力<br><br>"
LOCALS += "魔力を引き出す最高品質の指輪。<br>"
LOCALS += "特に攻撃する性能に優れた調整がされており、火力重視の騎空士に人気。<br>"
LOCALS += "最高品質のため全空でも数が少なく、深部のダンジョンでしか見かけない。<br>"
LOCALS += "<br>"

詳細文文字列受け渡し変数 = %LOCALS%
基礎販売額 = 70000

@指輪基礎効果文章表示_至極の指輪・力(指輪番号, 効果番号)
#DIM 効果番号
#DIM 指輪番号
LOCALS = 
LOCALS += "【基礎効果】<br>"
LOCALS += "最大ＨＰ+1200 最大ＭＰ+240 攻撃力+800 防御力+160 行動速度+400 命中率+15%<br>"

LOCALS:1 = %DT_CELL_GETS("所持指輪データベース", 指輪番号, "オプションステータス補正", 1)%
IF LOCALS:1 != ""
	LOCALS += @"<br>【オプション効果】<br>%オプション効果表示文字列作成(LOCALS:1)%"
ENDIF

詳細文文字列受け渡し変数 = %LOCALS%

@指輪出現率_至極の指輪・力(入手タイプ, 装備ランク)
#DIMS 入手タイプ
#DIM 装備ランク

SIF 装備ランク < 6
	RETURN 0
SELECTCASE 入手タイプ
	CASE "輸入"
		RETURN 装備レアリティ_Ｎ
	CASE "古ぼけた装備"
		RETURN 装備レアリティ_Ｎ
ENDSELECT

@指輪ステータス決定_至極の指輪・力(オプション数, 情報取得フラグ = 0, 効果指定 = -1)
#DIM 効果指定
#DIM オプション数
#DIM 情報取得フラグ
#DIMS 基本補正文字列

基本補正文字列 = 最大ＨＰ_1200_最大ＭＰ_240_攻撃力_800_防御力_160_行動速度_400_命中率_15

IF 情報取得フラグ
	詳細文文字列受け渡し変数 = %基本補正文字列%
	;オプション固定用にオプションランクを返す
	RETURN 4
ENDIF

;オプション数に応じてオプション効果をランダムで付加
;ユーザーの指定によりLv4のオプションが付く

オプション補正文字列 = 
IF オプション数
	FOR LOCAL, 0, オプション数
		CALL オプション効果決定(4)
	NEXT
ENDIF

LOCAL = DT_ROW_ADD("所持指輪データベース", "指輪名", "至極の指輪・力", "基礎ステータス補正", 基本補正文字列, "オプションステータス補正", オプション補正文字列)

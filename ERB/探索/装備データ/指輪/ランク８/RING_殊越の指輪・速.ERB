@指輪個別文章表示_殊越の指輪・速
LOCALS = 
LOCALS += @"■殊越の指輪・速<br><br>"
LOCALS += "魔力を引き出す、殊に優れた指輪。<br>"
LOCALS += "先手を取って手数で押す調整がされており、速攻を好む騎空士に人気。<br>"
LOCALS += "限界を超えた性能のため、全空でもほとんど見かけない。<br>"
LOCALS += "<br>"

詳細文文字列受け渡し変数 = %LOCALS%
基礎販売額 = 140000

@指輪基礎効果文章表示_殊越の指輪・速(指輪番号, 効果番号)
#DIM 効果番号
#DIM 指輪番号
LOCALS = 
LOCALS += "【基礎効果】<br>"
LOCALS += "最大ＨＰ+800 最大ＭＰ+800 攻撃力+800 行動速度+1600<br>DA率+65% TA率+50% 命中率+20%<br>"

LOCALS:1 = %DT_CELL_GETS("所持指輪データベース", 指輪番号, "オプションステータス補正", 1)%
IF LOCALS:1 != ""
	LOCALS += @"<br>【オプション効果】<br>%オプション効果表示文字列作成(LOCALS:1)%"
ENDIF

詳細文文字列受け渡し変数 = %LOCALS%

@指輪出現率_殊越の指輪・速(入手タイプ, 装備ランク)
#DIMS 入手タイプ
#DIM 装備ランク

SIF 装備ランク < 8
	RETURN 0
SELECTCASE 入手タイプ
	CASE "輸入"
		RETURN 装備レアリティ_Ｎ
	CASE "古ぼけた装備"
		RETURN 装備レアリティ_Ｎ
ENDSELECT

@指輪ステータス決定_殊越の指輪・速(オプション数, 情報取得フラグ = 0, 効果指定 = -1)
#DIM 効果指定
#DIM オプション数
#DIM 情報取得フラグ
#DIMS 基本補正文字列

基本補正文字列 = 最大ＨＰ_800_最大ＭＰ_800_攻撃力_800_行動速度_1600_DA率_65_TA率_50_命中率_20

IF 情報取得フラグ
	詳細文文字列受け渡し変数 = %基本補正文字列%
	;オプション固定用にオプションランクを返す
	RETURN 5
ENDIF

;オプション数に応じてオプション効果をランダムで付加
;ランク8の指輪なのでLv5のオプションが付く
;Lv5オプションはランク7の天却／窮破用に新規作成済みのものを使う

オプション補正文字列 = 
IF オプション数
	FOR LOCAL, 0, オプション数
		CALL オプション効果決定(5)
	NEXT
ENDIF

LOCAL = DT_ROW_ADD("所持指輪データベース", "指輪名", "殊越の指輪・速", "基礎ステータス補正", 基本補正文字列, "オプションステータス補正", オプション補正文字列)

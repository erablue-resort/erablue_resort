

@ダンジョンハプニング時画像表示処理(対象キャラ, ハプニング名)
#DIM 対象キャラ
#DIMS ハプニング名
#DIMS 画像文字列
#DIMS 画像種別

画像種別 = %CSTR:対象キャラ:着せ替え服%
SIF 画像種別 == ""
	画像種別 = デフォルト

IF 画像種別 == "全裸" || 画像種別 == "湯浴み着" || STRCOUNT(所持エロ衣装文字列, @"エロ/%画像種別%_")
	;条件をクリアしていない時、これらの服はデフォルトに着替える
	IF フィールド展開:常時全裸
		;常時全裸は全員OK
	ELSEIF TALENT:対象キャラ:従業員 && フィールド展開:エロ制服許可
		;従業員の場合はエロ制服許可でOK
	ELSE
		;そうでない時はデフォルトに変更
		CSTR:対象キャラ:着せ替え服 = 
		画像種別 = デフォルト
	ENDIF
ENDIF

LOCALS = ハプニング時_%画像種別%_

画像文字列 = 
IF ENUMFILES(@"resources/%CSTR:対象キャラ:画像フォルダ%/", @"%LOCALS + ハプニング名%*.*")
	;現在表示してるグラの差分があるか見る
	画像文字列 '= LOCALS + コマンド画像ランダム処理(対象キャラ, LOCALS, ハプニング名, "")
ENDIF

IF 画像文字列 != ""
	SIF STRCOUNT(画像文字列, "ハプニング時_") > 0
		画像文字列 '= REPLACE(画像文字列, "ハプニング時_", "")
	イベント画像表示文字列 = %CSTR:対象キャラ:画像フォルダ%/ハプニング時_%画像文字列%
ENDIF

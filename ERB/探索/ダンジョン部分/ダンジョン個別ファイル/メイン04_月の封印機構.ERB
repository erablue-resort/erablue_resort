; ;=================================================================
; ; 月の封印遺構 - ダンジョン構造（骨組み）
; ;=================================================================
; ; 推奨Lv：30（守護者戦は結界なしでLv30相当。結界が残っていると実質それ以上）
; ; 固定ダンジョン。5層（深度0～5）＋側道マス。
; ; 発生条件は未決定。ダンジョン出現フラグ_月の封印遺構 が立ったら入れる形。
; ; 既存ダンジョン（沿岸部の森／人食い鳥の島／リゾート島開拓作業）の型に合わせている。
; ;
; ; 各ダンジョン固有変数.ERH に追加すること
; ; #DIM SAVEDATA ダンジョン構造配列_月の封印遺構, 100, 9
; ; #DIM SAVEDATA ダンジョン出現フラグ_月の封印遺構
; ; #DIM SAVEDATA ダンジョンクリアフラグ_月の封印遺構
; ; #DIM SAVEDATA 封印欠片_記録
; ; #DIM SAVEDATA 封印欠片_動力
; ; #DIM SAVEDATA 封印欠片_制御
; ; #DIM SAVEDATA 月の技術コア獲得フラグ
; ; #DIM SAVEDATA 月の封印結界強度
; ;
; ;
; ; ・ボスエネミー Lv30_封印管理体セレネ は別ファイルで作成すること。
; ; 5_0のマスイベントでその名前を呼んでいる。
; ; 仮置きで既存ボスを使う場合は、5_0の敵名だけ差し替えること。
; ; ・雑魚の敵名は仮置き。既存の一般エネミーはLv22までしかないため、
; ; Lv20～22の敵を複数体で組んでいる。Lv30帯の新規一般エネミーを
; ; 作ったら、1_0／1_1／2_1／3_1／4_0の敵名を差し替えること。
; ; ・マップ画像は既存の工場／遺跡系を使っている。専用画像ができたら差し替えること。
; ;=================================================================


; @ダンジョン初期処理_月の封印遺構
; ;ダンジョン構造の読み込み
; ;0でない時、そのマスは存在する
; #DIM 深度
; #DIM 分岐

; ダンジョンサブタイトル = MOON SEAL RUINS
; ダンジョンマス画像URL_伏せ状態 = 壁_工場
; ダンジョン現在位置:0 = 0
; ダンジョン現在位置:1 = 0
; ダンジョン背景画像 = 背景_工場

; ;スタート地点は必ず存在
; ;初期からオープン済みなので3を入れる
; ;ビット0：存在するか　ビット1：移動できるか　ビット2：そこから通路を伸ばすか　ビット3：入れないが表示する場合に使用
; ;ビット4以降：自由枠フラグ
; IF GETVAR(@"ダンジョン構造配列_%ダンジョン名%:0:0") == 0
; SETVAR @"ダンジョン構造配列_%ダンジョン名%:0:0", 3
; ENDIF

; FOR 深度, 1, 100
; 	LOCAL = 0
; 	FOR 分岐, 0, 9
; 		IF ダンジョン構造配列_月の封印遺構:深度:分岐
; 			;既にマス情報が入ってるなら飛ばす
; 			LOCAL = 1
; 			CONTINUE
; 		ELSEIF ENUMFUNCBEGINSWITH(@"ダンジョンマス情報_月の封印遺構_{深度}_{分岐}")
; 			LOCAL = 1
; 			ダンジョン構造配列_月の封印遺構:深度:分岐 = 1
; 		ENDIF
; 	NEXT
; 	IF LOCAL
; 		ダンジョン最大深度 = 深度
; 	ENDIF
; NEXT



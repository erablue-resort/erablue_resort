
@空艇港店舗名表示_5(店舗番号)
#FUNCTION
#DIM 店舗番号
TSTR:場所名受渡 = 直売所『%空艇港店舗屋号記録:店舗番号%』

@空艇港店舗解説文_5(建物文章受け渡し文字列, 店舗番号)
#DIMS REF 建物文章受け渡し文字列
#DIM 店舗番号

建物文章受け渡し文字列 = ■直売所『%空艇港店舗屋号記録:店舗番号%』<br><br>
建物文章受け渡し文字列 += "　リゾートのある島で取れた食材や加工食品を扱う店舗。<br>"
建物文章受け渡し文字列 += "　加工・管理を行うため食材在庫の回復量が増加する。観光客にも人気。<br>"
建物文章受け渡し文字列 += "　<br>"
建物文章受け渡し文字列 += "　施設効果：一日終了時のルピ収入増加（極小）<br>"
建物文章受け渡し文字列 += "　　　　　　人気度上昇量の減衰ライン増加（小）<br>"
建物文章受け渡し文字列 += "　　　　　　一日の食材在庫回復量＋３０<br>"

RETURN 10000

@空艇港店舗効果_5(ARGS)

SELECTCASE ARGS
	CASE "一日終了時のルピ収入"
		LOCAL = 滞在キャラ数算出関数() * 100 * RAND(95, 106) / 100
		RETURN LOCAL
	CASE "人気度上昇量の減衰ライン"
		;キャラ上限0.5人分の上昇
		RETURN 1000
	CASE "食材在庫回復量"
		;+30
		RETURN 30
ENDSELECT

RETURN 0



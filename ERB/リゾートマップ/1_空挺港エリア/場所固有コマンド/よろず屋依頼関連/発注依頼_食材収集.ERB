@発注依頼_食材収集

依頼文章保存 = 
依頼文章保存 += "食料を集めてきてもらい、食材在庫を毎日増加させます。<br>"
依頼文章保存 += "食材在庫の増加量は変動します。<br>"
依頼文章保存 += "<br>"
依頼文章保存 += @"変動範囲："
依頼文章保存 += @"100～200<br>"
依頼文章保存 += @"必要報酬額：%NUM_FORMAT(3000)%<br>"
依頼報酬額 = 3000
依頼文章保存 += "<br>"
依頼文章保存 += "<button value='201'>[201] これで発注する</button><br><br>"


@依頼追加表示情報_食材収集(表示依頼枠番号)
#DIM 表示依頼枠番号

詳細文文字列受け渡し変数 = 

@発注実処理_食材収集(表示依頼枠番号)
#DIM 表示依頼枠番号

BINPUT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE 201
		IF MONEY < 依頼報酬額
			PRINTL 
			PRINTW ルピが足りません。
			RETURN 0
		ENDIF
		PRINTL
		PRINTFORMW 依頼：食材収集　　を発注しました。
		MONEY -= 依頼報酬額
		遂行中依頼_対象名:表示依頼枠番号 = 食料在庫
		依頼完了確率_初期値:表示依頼枠番号 = 100
		RETURN 1
	CASE 999
		RETURN -1
ENDSELECT

@依頼完了時処理_食材収集(表示依頼枠番号)
#DIM 表示依頼枠番号

LOCAL = 素材アイテム_数値データ取得("素材ランク", 遂行中依頼_対象名:表示依頼枠番号)
LOCAL = RAND:100 + 100
依頼報告文字列:表示依頼枠番号 += @"%依頼受注者名:表示依頼枠番号% が %遂行中依頼:表示依頼枠番号% の依頼を達成したようだ！<br>"
依頼報告文字列:表示依頼枠番号 += @"%遂行中依頼_対象名:表示依頼枠番号% を {LOCAL}個手に入れた！<br>"
FLAG:食材在庫量 += LOCAL

@GETPLACENAME_0_17(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1702
		TSTR:場所名受渡 = ロビー
	CASE 1703
		TSTR:場所名受渡 = 展望エリア
	CASE 1704
		TSTR:場所名受渡 = 貸し切り展望室
ENDSELECT


@DRAW_MAP_BG_0_17(SLICED, 表示文字列)
#DIMS REF 表示文字列
#DIMS SLICED

SELECTCASE SLICED
	;下部一覧の数字を三桁表示しつつボタン化させる
	CASE "二"
		表示文字列 += @"<button value='1702'>02</button>"
	CASE "三"
		表示文字列 += @"<button value='1703'>03</button>"
	CASE "四"
		表示文字列 += @"<button value='1704'>04</button>"
	;ふつうの
	CASEELSE
		表示文字列 += @"%SLICED%"
ENDSELECT

@SOURCE_場所補正_0_1703(対象キャラ)
#DIM 対象キャラ

;この場所でうふふしている時、全てのコマンドが露出フラグを持つ
IF CFLAG:対象キャラ:うふふ || CFLAG:対象キャラ:キャラ同士うふふ
	RCVAR:対象キャラ:露出コマンドフラグ = 1
ENDIF

@SOURCE_場所補正_0_1704(対象キャラ)
#DIM 対象キャラ

CALL SOURCE_場所補正_0_1703(対象キャラ)


@展望タワー系列改造メニュー()
#FUNCTIONS
;100~199と999は大本のメニュー操作で使うため、使用しないこと

LOCALS = リゾートエリアに展望タワーを建設します。<br><br>
IF 施設改造度:17:0 < 1
	LOCALS += @"■<button value='200'>[展望タワーを建設する]</button> （必要:400,000ルピ）<br>"
ELSE
	LOCALS += @"■[展望タワーを建設する] 建設済<br>"
ENDIF

RETURNF LOCALS

@展望タワー系列改造実行関数(ARG)

SELECTCASE ARG
	CASE 200
		DRAWLINE
		PRINTL リゾートエリアに展望タワーを建設します。
		PRINTBUTTON "■展望室について", 500
		PRINTL 
		PRINTBUTTON "■貸し切り展望室について", 501
		PRINTL 
		PRINTL 
		PRINTL 展望タワーを建設しますか？（必要:400,000ルピ）
		PRINTBUTTONLC "[0] はい", 0
		PRINTBUTTONLC "[1] いいえ", 1
		BINPUT
		SELECTCASE RESULT
			CASE 0
				IF MONEY < 400000
					PRINTW ルピが足りません。
					RETURN
				ENDIF
				施設改造度:17:0 = 1
				MONEY -= 400000
				PRINTL 展望タワーを建設しました！
				PRINTW (リゾート人気度上限＋２５)
				CALL RESET_GRAPH_0
				CALL 履歴データベース登録(CFLAG:MASTER:人物番号, @"展望タワーを建設した","実績")
				RETURN
			CASE 1
				RETURN
			CASE 500
				DRAWLINE
				PRINTL リゾートと島全体を見渡せる展望室です。
				PRINTL 昼は観光客の目玉施設として、夜は夜景を楽しむデートスポットとして機能します。
				PRINTL また、この場所でうふふした場合、全てのコマンドが露出コマンド扱いになります。
				PRINTW
			CASE 501
				DRAWLINE
				PRINTL 他人が入ってこない展望室です。
				PRINTL 防音工事もされているので、中でナニをしていても大丈夫な設計となっています。
				PRINTL また、この場所でうふふした場合、全てのコマンドが露出コマンド扱いになります。
				PRINTW
		ENDSELECT
		RESTART
ENDSELECT

ENDSELECT

@CAN_MOVE_FESTIVAL_夏祭り(ARG, ARG:1)
;ARG 移動元
;ARG:1 移動先
#FUNCTION

SELECTCASE ARG
	CASE 1
		;神輿、盆踊り、屋台
		IF GROUPMATCH(ARG:1, 2, 3, 4)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 2
		;入口、盆踊り、屋台
		IF GROUPMATCH(ARG:1, 1, 3, 4)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 3
		;入口、神輿、屋台
		IF GROUPMATCH(ARG:1, 1, 2, 4)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 4
		;全部OK
		IF GROUPMATCH(ARG:1, 1, 2, 3, 5)
			RESULT = 3
			RETURNF 3
		ELSEIF GROUPMATCH(ARG:1, 6)
			RESULT = 1
			RETURNF 1
		ENDIF
	CASE 5
		;屋台のみ
		IF GROUPMATCH(ARG:1, 4)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 6
		;屋台のみ
		IF GROUPMATCH(ARG:1, 4)
			RESULT = 1
			RETURNF 1
		ENDIF
ENDSELECT
RESULT = 0

@存在しない移動先_FESTIVAL_夏祭り(ARG)
#FUNCTION
IF ARG < 1 || ARG > 6
	RESULT = 1
	RETURNF 1
ELSE
	RESULT = 0
	RETURNF 0
ENDIF

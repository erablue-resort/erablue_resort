#DIMS REF 表示文字列
#DIMS SLICED
SELECTCASE SLICED
	CASEELSE
		表示文字列 += @"%SLICED%"
ENDSELECT

@CAN_MOVE_FESTIVAL_麦酒祭(ARG, ARG:1)
;ARG 移動元
;ARG:1 移動先
#FUNCTION

SELECTCASE ARG
	CASE 1
		;屋台のみ
		IF GROUPMATCH(ARG:1, 2)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 2
		;入口、飲食、宴会
		IF GROUPMATCH(ARG:1, 1, 3, 4)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 3
		;屋台、宴会、静かな場所
		IF GROUPMATCH(ARG:1, 2, 4, 6)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 4
		;屋台、飲食、池
		IF GROUPMATCH(ARG:1, 2, 3, 5)
			RESULT = 3
			RETURNF 3
		ELSEIF GROUPMATCH(ARG:1, 6)
			RESULT = 1
			RETURNF 1
		ENDIF
	CASE 5
		;宴会のみ
		IF GROUPMATCH(ARG:1, 4)
			RESULT = 3
			RETURNF 3
		ENDIF
	CASE 6
		;飲食のみ
		IF GROUPMATCH(ARG:1, 3)
			RESULT = 1
			RETURNF 1
		ENDIF
ENDSELECT
RESULT = 0

@存在しない移動先_FESTIVAL_麦酒祭(ARG)
#FUNCTION
IF ARG < 1 || ARG > 6
	RESULT = 1
	RETURNF 1
ELSE
	RESULT = 0
	RETURNF 0
ENDIF

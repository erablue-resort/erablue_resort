@CLOTHES_衣装説明_エロティコ・ド・サンバ()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 10000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
;サンバ衣装を入手後に販売開始
販売禁止フラグ = !(STRCOUNT(所持制服文字列, @"汎用/サンバ衣装_") + STRCOUNT(所持エロ衣装文字列, @"エロ/サンバ衣装_"))

説明文章 = 
説明文章 += "大胆な露出を極めた幻想的なデザインのサンバ衣装。<br>"
説明文章 += "頭に大きな羽根のヘッドドレス、背中に広がる羽根の翼。<br>"
説明文章 += "トップレスビキニで胸と乳首を大胆に露わに強調。<br>"
説明文章 += "腰に細いチェーンが揺れ、下半身はオープンショーツで淫部を際立たせ、<br>"
説明文章 += "ヒップを囲む羽根がその際どいラインをさらに強調するドレス。<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格


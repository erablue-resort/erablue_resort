@CLOTHES_衣装説明_ヤリサーテニスウェア()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 10000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
;テニスウェアを入手後に販売開始
販売禁止フラグ = !(STRCOUNT(所持制服文字列, @"汎用/テニスウェア_") + STRCOUNT(所持エロ衣装文字列, @"エロ/ヤリサーテニスウェア_"))
説明文章 = 
説明文章 += "スリーブレスのシャツは乳首まで露わな状態で周囲の視線を釘付け。<br>"
説明文章 += "マイクロスカートは少し動くだけで秘部を大胆に晒す。<br>"
説明文章 += "極限のエロを追求したテニスは二の次のヤリサー専用テニスウェア。<br>"
説明文章 += "理性を崩壊させ、征服欲を爆発させる一着。<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

@CLOTHES_CHANGE_ヤリサーテニスウェア(対象キャラ)
#DIM 対象キャラ

;一個前の服装を保持
SIF CSTR:対象キャラ:着せ替え服 != "ヤリサーテニスウェア"
	CSTR:対象キャラ:脱ぐ前の服 = %CSTR:対象キャラ:着せ替え服%

CSTR:対象キャラ:着せ替え服 = ヤリサーテニスウェア

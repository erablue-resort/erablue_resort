@CLOTHES_衣装説明_淫習祭乃法被()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 10000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
;祭り法被を入手後に販売開始
販売禁止フラグ = !(STRCOUNT(所持制服文字列, @"汎用/祭り法被_") + STRCOUNT(所持エロ衣装文字列, @"エロ/祭り法被_"))

説明文章 = 
説明文章 += "普通の祭りでは考えられない裸に法被のみという大胆な衣装。<br>"
説明文章 += "晒しに包まれているはずの乳房は大胆に露出して視線は釘付け、<br>"
説明文章 += "さらに下を見れば秘部を開放し性欲をひたすらに煽る。<br>"
説明文章 += "羞恥と露出を極めた淫らな法被の着方。<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格


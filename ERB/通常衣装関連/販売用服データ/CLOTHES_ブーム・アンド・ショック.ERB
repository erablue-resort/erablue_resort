@CLOTHES_衣装説明_ブーム・アンド・ショック()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 931210
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = 通常衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 0

説明文章 = 
説明文章 += "透明なチューブトップに黄色のスリングショット、そして紐の様に細いマイクロビキニを組み合わせた水着……であるらしい<br>"
説明文章 += "チューブトップの谷間部にはハートの穴が開いており、非常に煽情的な衣装であるが、<br>"
説明文章 += "何故かスリングショットをリモコンに、チューブトップを画面として【BOOM】というゲームができるようになっている<br>"
説明文章 += "　<br>"
説明文章 += "……本当に何故？<br>"
説明文章 += "またゲームをする際、スリングショットを掴まなくてはいけないので実質胸を鷲摑みにしかなければゲームができないのだが本当にこの用途はあっているのだろうか……？<br>"

;出典元がある場合、それを記載
出典元 = 勝利の女神:NIKKE

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格


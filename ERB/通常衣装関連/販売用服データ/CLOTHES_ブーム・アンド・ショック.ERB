;固有コマンド

;----------------------------------------------------
;キャラ固有コマンド処理
;----------------------------------------------------
;コマンド名
;----------------------------------------------------
@COMNAME_CLOTH_390_ブーム・アンド・ショック
#FUNCTION
TSTR:コマンド名受渡 = BOOMをプレイする

;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_390_ブーム・アンド・ショック
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("セクハラ強")

@COM_TOOLTIP_390_ブーム・アンド・ショック
LOCALS = <br>■BOOMをプレイする<br>
LOCALS += "ブーム・アンド・ショック衣装に付属しているゲーム、BOOMをプレイするコマンド。<br>衣装着用時にしかプレイ出来ないため、必然的に胸を鷲掴みする形になる。"
LOCALS += "<br>COMタイプ：セクハラ<br>取得ソース：接触・快Ｂ"
LOCALS += "<br>固有の取得経験：乳首開発(TARGET)<br>"
TSTR:ツールチップ受渡 = %LOCALS%

;-------------------------------------------------
;実行処理
;-------------------------------------------------
@COM390_ブーム・アンド・ショック
#DIM プレイ結果

;ミニゲーム作りたい……けどゲームのプレイ結果を出すだけ

;ランダムでゲームの結果を算出、数値が多いほど良いスコア
プレイ結果 = RAND:100

;貧乳以下だとプレイしやすい
SIF TALENT:TARGET:バストサイズ < 0
	プレイ結果 += 10
;Bがない（乳首が存在しない）場合、快楽が発生しないためTARGETが動かずプレイしやすい
SIF TALENT:TARGET:Ｂ感度 == -2
	プレイ結果 += 15
;B敏感だとTARGETがめっちゃ動くのでプレイしづらい
SIF TALENT:TARGET:Ｂ感度 > 0
	プレイ結果 -= 10

;プレイ結果表示はメッセージにて
RFLAG:コマンド結果受渡し変数３ = プレイ結果

CALL セクハラ反応タイプ判定(TARGET)
;RFLAG:コマンド結果受渡し変数
;1:拒絶  2:受け入れ 3:喜び
;RFLAG:コマンド結果受渡し変数２
;1:無知  2:無反応 3:嫌悪  4:拒否  5:余裕  6:羞恥  7:愉悦  8:汎用

;セクハラ強は基本的に喜び以外に入らないはず（合意条件であり、合意に入るにはそれなりに仲良くならなければならないため）

SELECTCASE RFLAG:コマンド結果受渡し変数２
	CASE 1
		;無知
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 200)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 50)
	CASE 2
		;無反応
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 200)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 50)
	CASE 3
		;嫌悪
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 200)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 80)
	CASE 4
		;拒否
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 200)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 100)
	CASE 5
		;余裕
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 200)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 120)
	CASE 6
		;羞恥
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 300)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 350)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 150)
	CASE 7
		;愉悦
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 200)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 130)
	CASE 8
		;汎用
		CALL SOURCE_CALC_接触(TARGET, PLAYER, 200)
		CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
		CALL SOURCE_CALC_好感度要素_性愛度UP(TARGET, PLAYER, 100)
ENDSELECT


;発生する快楽はゲームスコアに依存
SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE IS < 30
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
	CASE IS < 60
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
	CASE IS < 90
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
	CASEELSE
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
		CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 100)
ENDSELECT
SIF TALENT:PLAYER:器用な指
	CALL SOURCE_CALC_快Ｂ(TARGET, PLAYER, 50)

SIF 同性愛性癖判定(PLAYER,TARGET)
	EXP:PLAYER:同性愛経験 += 1

RCVAR:乳首開発フラグ = 1

TIME += 10

SIF CFLAG:TARGET:睡眠
	RETURN 1

SIF 同性愛性癖判定(TARGET,PLAYER)
	EXP:TARGET:同性愛経験 += 1


;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE390_ブーム・アンド・ショック
;一括管理
SIF GLOBAL_COMABLE(390)
	RETURN RESULT
;上着がない時はダメ
SIF TEQUIP:TARGET:上半身服あり != 1
	RETURN 0
RETURN 1



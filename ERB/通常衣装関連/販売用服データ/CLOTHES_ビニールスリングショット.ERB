@CLOTHES_初期所持関数_ビニールスリングショット()
SIF STRCOUNT(所持制服文字列, @"汎用/ビニールマイクロビキニ_") || STRCOUNT(所持エロ衣装文字列, @"エロ/ビニールマイクロビキニ_")
CALL 制服登録処理("ビニールスリングショット")

@CLOTHES_衣装説明_ビニールスリングショット()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 100000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
;スリングショットを入手後に販売開始
販売禁止フラグ = !(STRCOUNT(所持制服文字列, @"汎用/スリングショット_") + STRCOUNT(所持エロ衣装文字列, @"エロ/スリングショット_"))

説明文章 = 
説明文章 += "透き通るビニール素材のみで仕立てられたスリングショット型の水着。<br>"
説明文章 += "肩から胸部を渡り股間を通って背中へ続く一本の紐が体を締め上げ、<br>"
説明文章 += "最小限のビニールが胸と秘部をわずかに覆うのみである。<br>"
説明文章 += "透明な生地は肌に密着して豊かな曲線を余すことなく映し出し、<br>"
説明文章 += "艶やかに輝くその姿は見る者の視線を釘付けにする過激な装いである。<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格


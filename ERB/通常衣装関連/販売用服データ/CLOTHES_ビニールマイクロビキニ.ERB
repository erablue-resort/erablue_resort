@CLOTHES_衣装説明_ビニールマイクロビキニ()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 100000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
;マイクロビキニを入手後に販売開始
販売禁止フラグ = !(STRCOUNT(所持制服文字列, @"汎用/マイクロビキニ_") + STRCOUNT(所持エロ衣装文字列, @"エロ/マイクロビキニ_"))

説明文章 = 
説明文章 += "透き通るビニール素材のみで構成された極限まで削ぎ落とした紐型の水着。<br>"
説明文章 += "上は細い紐で吊るされた三角形のビニールが胸部をわずかに覆い、<br>"
説明文章 += "下は糸のような紐が腰を巡り最小限のビニールが秘部を隠すのみ。<br>"
説明文章 += "光を透過して肌の色と形を鮮明に浮かび上がらせ、艶やかな光沢を<br>"
説明文章 += "放ちながらもほとんど何も身に着けていないかのような大胆な装いである。<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格


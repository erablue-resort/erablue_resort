@CLOTHES_衣装説明_ゴールデンマイクロビキニ()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 99800000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 0

説明文章 = 
説明文章 += "太陽に負けない輝きを返す、黄金のビキニ型水着。<br>"
説明文章 += "布面積は乳首と秘裂を隠す機能しかないほどの極小サイズで、プールや海で使うには不安しかない。<br>"
説明文章 += "そのくせわざわざ最高級の金糸で作られているため、非常に手に取りにくい価格となってしまった。<br>"
説明文章 += "別の世界のとある国では、晩春から初夏に移る頃に着せる風習があるらしい……<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格



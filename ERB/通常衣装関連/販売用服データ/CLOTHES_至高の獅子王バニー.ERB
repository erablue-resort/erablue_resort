@CLOTHES_衣装説明_至高の獅子王バニー()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 10000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = 通常衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 0

説明文章 = 
説明文章 += "カジノのオーナーとなった騎士王の衣装。<br>"
説明文章 += "白と金のハイレグレオタードに青いタイツが華やかなるカジノの更なる彩りとなる。<br>"
説明文章 += "一見バニーガールのようだが、本人曰く「最も格式高く公平なるディーラーの衣装」とのこと。<br>"
説明文章 += "これを身に着けた者には幸運と勝利の女神が微笑む……かもしれない。<br>"

;出典元がある場合、それを記載
出典元 = Fate/GrandOrder

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格


@CLOTHES_初期所持関数_ビニールパレオ()
SIF STRCOUNT(所持制服文字列, @"汎用/ビニール水着_") || STRCOUNT(所持エロ衣装文字列, @"エロ/ビニール水着_")
CALL エロ衣装登録処理("ビニールパレオ")

@CLOTHES_衣装説明_ビニールパレオ()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

販売分類 = エロ衣装
説明文章 = 
説明文章 += "透き通るビニール素材のみで仕立てられたビキニとパレオ。<br>"
説明文章 += "上は細い紐で結ばれた三角形のビキニが胸部をわずかに覆い、<br>"
説明文章 += "下は腰にゆるく巻き付けたパレオが秘部を隠すのみである。<br>"
説明文章 += "パレオは完全に透けて下半身の様子が鮮明に浮かび上がり、<br>"
説明文章 += "艶やかな光沢が肌の曲線を際立たせる大胆な装いである。"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%


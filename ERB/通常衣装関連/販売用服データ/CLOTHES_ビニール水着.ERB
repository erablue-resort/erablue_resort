@CLOTHES_衣装説明_ビニール水着()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 50000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
販売禁止フラグ = 0

説明文章 = 
説明文章 += "光を透過する極薄のビニール生地で仕立てられた、大胆な一体型の水着。<br>"
説明文章 += "肌をくっきりと透かし出す艶やかな光沢が特徴。<br>"
説明文章 += "密着するシルエットが曲線を強調し、<br>"
説明文章 += "透け感と光沢が相まって視線を強く誘う、官能的な一着である。"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

@CLOTHES_CHANGE_ビニール水着(対象キャラ)

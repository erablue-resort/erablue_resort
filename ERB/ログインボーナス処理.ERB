	UNDERSCORE_POS = STRFIND(REWARDS:LOCAL, "_")
	IF UNDERSCORE_POS < 0
		CONTINUE
	ENDIF

	DIST_METHOD = TOINT(SUBSTRING(REWARDS:LOCAL, 0, UNDERSCORE_POS))
	REWARD_NAME = %SUBSTRING(REWARDS:LOCAL, UNDERSCORE_POS + 1, STRLENS(REWARDS:LOCAL) - UNDERSCORE_POS - 1)%


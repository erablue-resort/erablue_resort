@PULL_REWARD(GACHA_COST,REWARDS, REWARD_AMOUNT)
;Rewards - [(N)Prism (1-3), (N)Gifts(1-3), (N)Currency, N(ZP) (~10% of Cost)(custom), (R)Tickets (Reroll)(1), (R)Invites-ZP(1), (R)Acc-gear(1), (R)Seggs items(1), (S)Anima 8 types (1-3), weighted pools, weighted rarity rewards.
#DIMS REWARD_POOLS, 9
#DIM REF GACHA_COST
#DIMS REF REWARDS
#DIM REF REWARD_AMOUNT
#DIM UNDERSCORE_POS
#DIMS REWARD_NAME

REWARD_POOLS:0 = REWARD_PRISM
REWARD_POOLS:1 = REWARD_GIFT
REWARD_POOLS:2 = REWARD_CURR
REWARD_POOLS:3 = REWARD_ZP
REWARD_POOLS:4 = REWARD_SHOPREROLL
REWARD_POOLS:5 = REWARD_ACCESSORY
REWARD_POOLS:6 = REWARD_SEGG
REWARD_POOLS:7 = REWARD_INVITE
REWARD_POOLS:8 = REWARD_ANIMA

FOR LOCAL, 0, 10
	CALL PULL_DECISION(GACHA_COST)
	REWARD_AMOUNT:LOCAL = RESULT:1
	CALLFORM %REWARD_POOLS:RESULT%
	REWARDS:LOCAL = %RESULTS%

	UNDERSCORE_POS = STRFIND(REWARDS:LOCAL, "_")
	REWARD_NAME = %SUBSTRING(REWARDS:LOCAL, UNDERSCORE_POS + 1, STRLENS(REWARDS:LOCAL) - UNDERSCORE_POS - 1)%
	PRINTFORML Obtained %REWARD_NAME% x{REWARD_AMOUNT:LOCAL}!
NEXT



@PULL_DECISION(ARG)
#DIM TIER, 3 = 60, 25, 15
#DIM ROLL
#DIM AMOUNT

ROLL = RAND:100

FOR LOCAL, 0,3
	IF ROLL < TIER:LOCAL
		RESULT = TIER:LOCAL
		BREAK
	ELSE
		ROLL -= TIER:LOCAL
	ENDIF
NEXT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE TIER:0
		ROLL = RAND:4
		IF ROLL == 3
			CALL ZP_AMOUNT_GACHA_REWARD(ARG)
			AMOUNT = RESULT
		ELSEIF ROLL == 2
			CALL CURR_AMOUNT_GACHA_REWARD
			AMOUNT = RESULT
		ELSE
			AMOUNT = 1 + RAND:3
		ENDIF
	CASE TIER:1
		ROLL = 4 + RAND:4
		AMOUNT = 1
	CASE TIER:2
		ROLL = 8
		AMOUNT = 1 + RAND:3
ENDSELECT
RETURN ROLL, AMOUNT


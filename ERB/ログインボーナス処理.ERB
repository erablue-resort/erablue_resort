@REWARD_CURR(COST_REFUND = 1)
#DIM COST_REFUND
#DIM REFUND_RATE
#DIM RAW_REFUND
#DIM FINAL_REFUND

;##################################################################################################################
;assuming Refund ZP is 10%, Cost only by 1.2 or 6/5. Refund amount only increases by 1%~ for early iterations
;ZP flat refund, 10-11-13-~~~etc, threshhold by 5. amound refund(5-10-15-20), increase by 5 semi times, 1XX/100 % 
;##################################################################################################################

;Rewards - MONEY( 500 - 1000 - 1500 - 10000 - 25000) or ZP Refund( 5% - 5% - 10% - 15% - 20% )
LOCAL = RAND:10
SELECTCASE LOCAL
	CASE 0
		MONEY += 500
		PRINTL 500ルピ手に入れた！
	CASE 1
		MONEY += 1000
		PRINTL 1,000ルピ手に入れた！
	CASE 2
		MONEY += 1500
		PRINTL 1,500ルピ手に入れた！
	CASE 3
		MONEY += 10000
		PRINTL 10,000ルピ手に入れた！
	CASE 4
		MONEY += 25000
		PRINTL 25,000ルピ手に入れた！
	CASE 5, 6
		REFUND_RATE = 5
	CASE 7
		REFUND_RATE = 10
	CASE 8
		REFUND_RATE = 15
	CASE 9
		REFUND_RATE = 20
ENDSELECT

IF LOCAL > 4
	RAW_REFUND = COST_REFUND * REFUND_RATE / 100
	FINAL_REFUND = (RAW_REFUND + 2) / 5 * 5
	FINAL_REFUND = MAX(5, FINAL_REFUND)
	flag:ZP所持量 += FINAL_REFUND
	PRINTFORML Obtained {FINAL_REFUND} ZP!
	PRINTFORML %NUM_FORMAT(FINAL_REFUND)%ZP手に入れた！
ENDIF


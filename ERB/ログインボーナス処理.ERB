@PULL_REWARD(COST)
;Rewards - [(N)Prism, (N)Gifts, (N)Currency (~10% of Cost), (R)Tickets (Reroll), (R)Invites-ZP, (R)Acc-gear, (R)Seggs items, (S)Anima] 8 types, weighted pools, weighted rarity rewards.
#DIMS REWARD_POOLS, 8
#DIM COST
REWARD_POOLS:0 = REWARD_PRISM
REWARD_POOLS:1 = REWARD_GIFT
REWARD_POOLS:2 = REWARD_CURR
REWARD_POOLS:3 = REWARD_SHOPREROLL
REWARD_POOLS:4 = REWARD_ACCESSORY
REWARD_POOLS:5 = REWARD_SEGG
REWARD_POOLS:6 = REWARD_INVITE
REWARD_POOLS:7 = REWARD_ANIMA

CALL PULL_DECISION
PRINTL 
CALLFORM %REWARD_POOLS:RESULT%(COST)

@PULL_DECISION
#DIM TIER, 3 = 60, 25, 15
#DIM ROLL

ROLL = RAND:100

FOR LOCAL, 0,3
	IF ROLL < TIER:LOCAL
		RESULT = TIER:LOCAL
		BREAK
	ELSE
		ROLL -= TIER:LOCAL
	ENDIF
NEXT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE TIER:0
		RESULT = RAND:3
	CASE TIER:1
		RESULT = 3 + RAND:4
	CASE TIER:2
		RESULT = 7
ENDSELECT
RETURN RESULT



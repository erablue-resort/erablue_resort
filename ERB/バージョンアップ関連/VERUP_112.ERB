;Ver0.112と旧バージョンとの互換のための処理
;Ver0.115にしたとき消す、互換を113に

;追加TALENT、追加CSTRのチェック
@VERUP_112_CHARA(ARG)

;その他広域変数の書き換えなど
@VERUP_112()
#DIM 値

; IF なんらかフォロー == 0
; 	;なんらかのフォロー処理
; 	;ここで"なんらかフォロー = 1"しない
; ENDIF

IF Ｒキャラ初期値フォロー == 0
	FOR LOCAL, 0, DT_ROW_LENGTH(Ｒキャラ初期値記録)
		;自制心(20)
		値 = ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 20)
		SELECTCASE 値
			CASE 1
				SIF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 269) == 0
					CALL ランダムキャラデータ_SET(Ｒキャラ初期値記録, LOCAL, "素質", 269, 1)
				CALL ランダムキャラデータ_REMOVE(Ｒキャラ初期値記録, LOCAL, "素質", 20)
			CASE 2
				CALL ランダムキャラデータ_SET(Ｒキャラ初期値記録, LOCAL, "素質", 20, 1)
			CASE -1
				SIF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 269) == 0
					CALL ランダムキャラデータ_SET(Ｒキャラ初期値記録, LOCAL, "素質", 269, -1)
				CALL ランダムキャラデータ_REMOVE(Ｒキャラ初期値記録, LOCAL, "素質", 20)
		ENDSELECT

		;会話資質(18)
		値 = ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 18)
		SELECTCASE 値
			CASE -1
				SIF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 265) == 0
					CALL ランダムキャラデータ_SET(Ｒキャラ初期値記録, LOCAL, "素質", 265, 1)
				CALL ランダムキャラデータ_REMOVE(Ｒキャラ初期値記録, LOCAL, "素質", 18)
			CASE -2
				SIF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 265) == 0
					CALL ランダムキャラデータ_SET(Ｒキャラ初期値記録, LOCAL, "素質", 265, 2)
				CALL ランダムキャラデータ_REMOVE(Ｒキャラ初期値記録, LOCAL, "素質", 18)
		ENDSELECT

		;マイペース(17)
		値 = ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 17)
		IF 値 == -1
			SIF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 270) == 0
				CALL ランダムキャラデータ_SET(Ｒキャラ初期値記録, LOCAL, "素質", 270, 1)
			CALL ランダムキャラデータ_REMOVE(Ｒキャラ初期値記録, LOCAL, "素質", 17)
		ENDIF

		;おもらし癖(57)：廃止
		IF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 57) != 0
			CALL ランダムキャラデータ_REMOVE(Ｒキャラ初期値記録, LOCAL, "素質", 57)
		ENDIF

		;幼稚(151)：精神的余裕(19)の-2へ統合
		IF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 151) != 0
			SIF ランダムキャラデータ_GET(Ｒキャラ初期値記録, LOCAL, "素質", 19) == 0
				CALL ランダムキャラデータ_SET(Ｒキャラ初期値記録, LOCAL, "素質", 19, -2)
			CALL ランダムキャラデータ_REMOVE(Ｒキャラ初期値記録, LOCAL, "素質", 151)
		ENDIF
	NEXT
ENDIF

;対応処理用フラグを対応済状態にセット
@VERUP_112_FINISH()
; なんらかフォロー = 1

Ｒキャラ初期値フォロー = 1

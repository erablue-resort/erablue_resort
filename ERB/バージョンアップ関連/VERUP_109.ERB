;Ver0.109と旧バージョンとの互換のための処理
;Ver0.112にしたとき消す、互換を110に

;追加TALENT、追加CSTRのチェック
@VERUP_109_CHARA(ARG)

IF ゆきずりセックス統合フォロー == 0
	性癖素質:ARG:ゆきずりセックス = MAX(性癖素質:ARG:ゆきずりセックス, 性癖素質:ARG:ゆきずりセックス（攻め）)
	EXP:ARG:ゆきずりセックス経験 = MAX(EXP:ARG:ゆきずりセックス経験, EXP:ARG:ゆきずりセックス（攻め）経験)
	性癖素質:ARG:ゆきずりセックス（攻め） = 0
	EXP:ARG:ゆきずりセックス（攻め）経験 = 0
ENDIF

IF 恋慕恋慕不可フォロー == 0
	IF GETBIT(TALENT:ARG:陥落不可, 0) && TALENT:ARG:恋慕 > 0
		CLEARBIT TALENT:ARG:陥落不可, 0
	ENDIF
ENDIF

;その他広域変数の書き換えなど
@VERUP_109()

; IF なんらかフォロー == 0
; 	;なんらかのフォロー処理
; 	;ここで"なんらかフォロー = 1"しない
; ENDIF

IF 戦闘関連オプション移行フォロー == 0
	OPTION変数:クイック行動 = クイック行動フラグ
	OPTION変数:アビ使用確認スキップ = アビ使用確認スキップフラグ
	OPTION変数:奥義使用確認スキップ = 奥義使用確認スキップフラグ
	OPTION変数:突入時アニメーション封印 = 突入時アニメーション封印フラグ
	OPTION変数:帰還時アニメーション封印 = 帰還時アニメーション封印フラグ
	OPTION変数:ダメージアニメーション封印 = ダメージアニメーション封印フラグ
	OPTION変数:カットイン演出一括表示 = カットイン演出一括表示フラグ
	OPTION変数:カットイン画像一括表示 = カットイン画像一括表示フラグ
ENDIF

IF 隠密コマンド化フォロー == 0
	REPLACE USERCOM表示文字列, "840_", ""
	REPLACE USERCOM表示文字列, "841_", ""
	REPLACE USERCOM表示文字列, "840", ""
	REPLACE USERCOM表示文字列, "841", ""
ENDIF

IF アイテムコマンド化フォロー == 0
	REPLACE USERCOM表示文字列, "850_", ""
	REPLACE USERCOM表示文字列, "850", ""
ENDIF


;対応処理用フラグを対応済状態にセット
@VERUP_109_FINISH()
; なんらかフォロー = 1

戦闘関連オプション移行フォロー = 1
隠密コマンド化フォロー = 1
アイテムコマンド化フォロー = 1
ゆきずりセックス統合フォロー = 1
恋慕恋慕不可フォロー = 1

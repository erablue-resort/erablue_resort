;Ver0.110と旧バージョンとの互換のための処理
;Ver0.113にしたとき消す、互換を111に

;追加TALENT、追加CSTRのチェック
@VERUP_110_CHARA(ARG)

;その他広域変数の書き換えなど

IF 常駐業務フォロー == 0
	IF TALENT:ARG:従業員 && 現在仕事:ARG:0 == 2
		SELECTCASE 現在仕事:ARG:1
			CASE 2
				;ロビーで受付中
				現在仕事:ARG:1 = 1
			CASE 503
				;バーエリアでバーテンダー中
				現在仕事:ARG:1 = 2
			CASE 506
				;図書室で司書中
				現在仕事:ARG:1 = 3
			CASE 1503, 15
				;プールで監視員中
				現在仕事:ARG:1 = 4
			CASE 30103
				;漁師
				現在仕事:ARG:1 = 5
			CASE 30104
				;シーガイド
				現在仕事:ARG:1 = 6
			CASE 10000 TO 10009
				現在仕事:ARG:1 = 現在仕事:ARG:1 - 10000 + 100
		ENDSELECT
	ENDIF
ENDIF

@VERUP_110()
#DIM 関数総数
#DIMS 関数名

; IF なんらかフォロー == 0
; 	;なんらかのフォロー処理
; 	;ここで"なんらかフォロー = 1"しない
; ENDIF

IF キャライベントNO追加フォロー == 0
	FOR LOCAL, 0, DT_ROW_LENGTH("各イベント用変数配列")
		SIF DT_CELL_GETS("各イベント用変数配列", LOCAL, "イベントカテゴリ") != "キャライベント"
			CONTINUE
		SIF STRFIND(DT_CELL_GETS("各イベント用変数配列", LOCAL, "イベント名"), "【汎用】") >= 0
			CONTINUE
		関数総数 = ENUMFUNCENDSWITH(DT_CELL_GETS("各イベント用変数配列", LOCAL, "イベント名"))
		IF 関数総数 > 0
			FOR LOCAL:1, 0, 関数総数
				IF STRFIND(RESULTS:(LOCAL:1), "イベント関数_キャライベント_") >= 0
					関数名 '= RESULTS:(LOCAL:1)
					BREAK
				ENDIF
			NEXT
			DT_CELL_SET "各イベント用変数配列", LOCAL, "イベント名", SUBSTRING(関数名, 28)
			;確認
			PRINTFORMW %DT_CELL_GETS("各イベント用変数配列", LOCAL, "イベント名")%
		ENDIF
	NEXT
ENDIF

;対応処理用フラグを対応済状態にセット
@VERUP_110_FINISH()
; なんらかフォロー = 1

常駐業務フォロー = 1
キャライベントNO追加フォロー = 1

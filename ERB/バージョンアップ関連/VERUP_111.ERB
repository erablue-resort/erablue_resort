;Ver0.111と旧バージョンとの互換のための処理
;Ver0.114にしたとき消す、互換を112に

;追加TALENT、追加CSTRのチェック
@VERUP_111_CHARA(ARG)

IF 素質改修フォロー == 0
	SELECTCASE TALENT:ARG:自制心
		CASE 1
			TALENT:ARG:自制心 = 0
			TALENT:ARG:真面目さ = 1
		CASE 2
			TALENT:ARG:自制心 = 1
		CASE -1
			TALENT:ARG:自制心 = 0
			TALENT:ARG:真面目さ = -1
	ENDSELECT
	
	SELECTCASE TALENT:ARG:会話資質
		CASE -1
			TALENT:ARG:会話資質 = 0
			TALENT:ARG:会話難 = 1
		CASE -2
			TALENT:ARG:会話資質 = 0
			TALENT:ARG:会話難 = 2
	ENDSELECT

	IF TALENT:ARG:マイペース == -1
		TALENT:ARG:マイペース = 0
	ENDIF
ENDIF

;その他広域変数の書き換えなど
@VERUP_111()


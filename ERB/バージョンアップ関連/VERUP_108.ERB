;Ver0.108と旧バージョンとの互換のための処理
;Ver0.109にしたとき消す、互換を107に

;追加TALENT、追加CSTRのチェック
@VERUP_108_CHARA(ARG)

IF 従業員デジモンフォロー == 0
	IF TALENT:ARG:定住者 == 3
		IF TALENT:ARG:従業員
			FOR LOCAL, 0, 従業員部屋数
				IF 従業員部屋割り配列:(LOCAL) == ARG
					従業員部屋割り配列:(LOCAL) = 0
				ENDIF
			NEXT
		ENDIF
	ENDIF
ENDIF

;その他広域変数の書き換えなど
@VERUP_108()


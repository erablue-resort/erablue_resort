;Ver0.108と旧バージョンとの互換のための処理
;Ver0.109にしたとき消す、互換を107に

;追加TALENT、追加CSTRのチェック
@VERUP_108_CHARA(ARG)

IF 従業員デジモンフォロー == 0
	IF TALENT:ARG:定住者 == 3
		IF TALENT:ARG:従業員
			FOR LOCAL, 0, 従業員部屋数
				IF 従業員部屋割り配列:(LOCAL) == ARG
					従業員部屋割り配列:(LOCAL) = 0
				ENDIF
			NEXT
		ENDIF
	ENDIF
ENDIF

;その他広域変数の書き換えなど
@VERUP_108()
#DIM era番号

; IF なんらかフォロー == 0
; 	;なんらかのフォロー処理
; 	;ここで"なんらかフォロー = 1"しない
; ENDIF

IF キャラ衣装フォロー == 0
	SIF STRCOUNT(所持制服文字列, "汎用/酒を呑み干す童鬼の装束_")
		REPLACE 所持制服文字列, "汎用/酒を呑み干す童鬼の装束_", ""
	SIF STRCOUNT(所持制服文字列, "汎用/白いワンピース_")
		REPLACE 所持制服文字列, "汎用/白いワンピース_", ""
ENDIF

IF era妊娠不可フォロー == 0
	era番号 = GETCHARA(998)
	IF TALENT:era番号:陥落不可 != 3
		TALENT:era番号:妊娠不可 = 0
	ENDIF
ENDIF

;対応処理用フラグを対応済状態にセット
@VERUP_108_FINISH()
; なんらかフォロー = 1

従業員デジモンフォロー = 1
キャラ衣装フォロー = 1
era妊娠不可フォロー = 1


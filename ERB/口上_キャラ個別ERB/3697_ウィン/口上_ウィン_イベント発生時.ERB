;--------------------------------------------------
;挨拶
;--------------------------------------------------
@KOJO_EVENT_挨拶_3697(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TALENT:対象キャラ:恋慕
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「あっ、%CSTR:対象キャラ:二人称%！ えへへ、会えました♪」
			KSTR:(K++) = ウィンが小走りに駆け寄ってきた。プチリュウが嬉しそうに%CALLNAME:MASTER%の周りを飛び回っている。
		CASE 1
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、今日も一緒にいていいですか？ えへへ、隣が好きなんです♪」
		CASE 2
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%♪」
			KSTR:(K++) = 名前を呼ぶだけで嬉しそうに微笑むウィン。翠の瞳が%CALLNAME:MASTER%を映して、きらきらと輝いていた。
	ENDSELECT
	IF TALENT:対象キャラ:淫乱
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「えへへ、%CSTR:対象キャラ:二人称%♪%CSTR:対象キャラ:二人称%といるとね…おまんこうずうずしてくるんです…♥」
				KSTR:(K++) = %CALLNAME:MASTER%の姿を見た途端、太腿の間がじわりと熱くなる。パブロフの犬のように——%CALLNAME:MASTER%の存在が、ウィンの中の「雌」を呼び覚まし、身体を発情させてしまう。
			CASE 1
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の匂い……♪ 嗅いだだけで身体が熱くなって、どきどきしてくるの…♥ 今日もいっぱいしてくださいね♪」
			CASE 2
				KSTR:(K++) = 「おはよ♪ あのね、朝から三回も自分で触っちゃいました…でもおちんぽじゃないと全然足りないんです♥」
				KSTR:(K++) = 少し恥ずかしそうに、だが、翠の瞳は確実に%CSTR:対象キャラ:二人称%に狙いを定め、自慰の報告を語っている。
		ENDSELECT
	ENDIF
ELSE
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「あ、%CSTR:対象キャラ:二人称%……えへへ、こんにちは♪」
		CASE 1
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、今日もお仕事ですか？ 頑張ってくださいね♪」
		CASE 2
			KSTR:(K++) = ウィンがマントのフードの中からひょこりと顔を覗かせた。
			KSTR:(K++) = 「あ、見つかっちゃいました……えへへ」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;情事目撃
;--------------------------------------------------
@KOJO_EVENT_情事目撃_3697(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TALENT:対象キャラ:恋慕
	KSTR:(K++) = 「……っ」
	KSTR:(K++) = ウィンが息を呑んだ。%CALLNAME:MASTER%が他の誰かと交わっている——その光景が、翠の瞳に映り込んでいる。
	KSTR:(K++) = 「……見ちゃいました……」
	KSTR:(K++) = マントの裾をきゅっと握りしめて、その場から動けなくなっていた。逃げたいのに、目が離せない。
	IF TALENT:対象キャラ:淫乱
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%のおちんぽ……他の子に使ってる♥」
				KSTR:(K++) = 嫉妬と興奮が入り混じった視線で見つめながら、ウィンの手がいつの間にかスカートの中に忍び込んでいた。悔しい。悔しいのに——%CALLNAME:MASTER%が腰を振る姿を見ていると、おまんこが勝手に蕩けていく。
				KSTR:(K++) = 「私のおまんこも空いてますよ…順番待ちしてますから…♥」
			CASE 1
				KSTR:(K++) = 「ねぇ……その子が終わったら私の番ね♪ 残ってるぶん、全部私に出してくださいね♥」
			CASE 2
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%のえっちしてるとこ見てたら…おまんこぐちょぐちょになっちゃいました…自分で触っちゃっていいですか…？」
		ENDSELECT
	ENDIF
ELSE
	KSTR:(K++) = 「あっ……ご、ごめんなさい！ 見てないですから……！」
	KSTR:(K++) = ウィンが真っ赤な顔で慌てて引き返していった。プチリュウだけが不思議そうにドアの隙間から覗き込んでいる。
ENDIF

CALL 口上変数表示(対象キャラ, 0)


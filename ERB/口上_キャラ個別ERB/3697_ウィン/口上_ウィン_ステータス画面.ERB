;ウィン（ID:3697）ステータス画面口上
;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_3697(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	IF TALENT:対象キャラ:淫乱
		KSTR:(K++) = んぅ……まだびくびくしてます……もう一回してほしいです…♥
	ELSE
		KSTR:(K++) = ふぁ……頭ぼうってします……すごかったです……
	ENDIF
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = いらっしゃいませ♪ えっと、ご予約のお名前は……えへへ、まだ慣れなくて
		CASE 2
			;バーエリアでバーテンダー中
			KSTR:(K++) = カクテル作るの楽しいです♪ ……あ、シェイカー振りすぎちゃいました
		CASE 3
			;図書室で司書中
			KSTR:(K++) = この本、精霊の生態についてすごく詳しく書いてあります。……えっ、お仕事中でした
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 泳いでる人たち見てると気持ちよさそうで……私も入りたいなぁ
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = お魚さん、ごめんなさい……でもみんなのごはんのためですから……
		CASE 6
			;遊覧船・海底散歩でシーガイド中
			KSTR:(K++) = 海の中って風がないんですね……不思議な感じ。でも水の流れが風みたいです♪
		CASE 100 TO 199
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 100):0}(現在仕事:対象キャラ:1 - 100)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = いらっしゃいませ♪ えっと……この薬は何に使うんですか？ ……え、夜に使う？
				CASE "土産物屋"
					KSTR:(K++) = この貝殻のストラップ、かわいいです♪ プチリュウの分も欲しいなぁ
				CASE "食事処"
					KSTR:(K++) = ご注文はお決まりですか？ ……えへへ、私のおすすめはプリンです♪
				CASE "装飾品店"
					KSTR:(K++) = このリボン、私のと色違いですね♪ ……似合いますか？
				CASE "直売所"
					KSTR:(K++) = 採れたてのお野菜です♪ プチリュウが収穫お手伝いしてくれたんですよ
			ENDSELECT
	ENDSELECT
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

IF CFLAG:対象キャラ:飲み会
	;飲み会中
	IF TALENT:対象キャラ:淫乱
		KSTR:(K++) = えへへ、ちょっと酔っちゃいました……%CALLNAME:MASTER%、あとで二人きりになれませんか…♥
	ELSE
		KSTR:(K++) = このジュースおいしい♪ ……え、お酒？ ……ぅえ、甘いから気づかなかったです
	ENDIF
ELSEIF CFLAG:対象キャラ:睡眠
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = す……すみません……ちょっと休ませて……プチリュウ、お水……
	ELSE
		;睡眠中
		IF TALENT:対象キャラ:淫乱
			KSTR:(K++) = ん……%CALLNAME:MASTER%……おちんぽ……んむ……すぅ……
		ELSE
			KSTR:(K++) = すぅ……すぅ……風の精霊さん……えへへ……すぅ……
		ENDIF
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	IF TALENT:対象キャラ:淫乱
		KSTR:(K++) = デート♪ ……えへへ、帰ったらいいことしましょうね…♥
	ELSE
		KSTR:(K++) = デート……えへへ……どこに連れて行ってくれるんですか？ どきどきします♪
	ENDIF
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	KSTR:(K++) = わぁ、一緒に遊んでくれるんですか？ プチリュウも嬉しそう♪
ELSEIF CFLAG:対象キャラ:同行
	KSTR:(K++) = 一緒にお出かけですね♪ 風が気持ちいい日です。プチリュウもご機嫌ですよ
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	KSTR:(K++) = しーっ……静かにしないと見つかっちゃいますよ。プチリュウ、声出しちゃだめだよ
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	KSTR:(K++) = ♪～♪～……えへへ、今日もいい風♪ ……ん？ 誰かいるような……気のせいかな
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;野外オナニー中
	IF TALENT:対象キャラ:淫乱
		KSTR:(K++) = はぁ……ここなら誰も来ない……%CALLNAME:MASTER%のこと考えながら……んっ…♥
	ELSE
		KSTR:(K++) = ひゃっ……な、なんでもないです……その、ちょっと、一人になりたくて……
	ENDIF
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;好感度分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = %CALLNAME:MASTER%は私の一番の友達です♪ プチリュウも同意してますよ、ね？
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = %CALLNAME:MASTER%とお話しするの楽しいです♪ もっといろんなこと教えてくださいね
			CASEELSE
				KSTR:(K++) = えっと……よろしくお願いします♪ 私、ウィンっていいます
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = %CALLNAME:MASTER%のそばにいると安心します。風の精霊さんと一緒にいる時みたい
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = %CALLNAME:MASTER%って不思議な人ですね。なんだか、風みたいに穏やかで
			CASEELSE
				KSTR:(K++) = リゾートのオーナーさんですよね？ えっと、よろしくお願いします♪
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = %CALLNAME:MASTER%のこと、大好きです。……えへへ、何回でも言いますよ♪
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = あっ、%CALLNAME:MASTER%……えへへ、なんでもないです。……顔、赤いですか？
			CASEELSE
				KSTR:(K++) = %CALLNAME:MASTER%の顔見ると、胸がどきどきするんです。……風邪ですかね？
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = %CALLNAME:MASTER%の匂い……嗅ぐだけで、下がじゅんってなっちゃいます…♥
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = えっちのこと考えると……身体が熱くなります。……これって普通ですか？
			CASEELSE
				KSTR:(K++) = えっちって……気持ちいいんですか？ よくわからないけど……興味あります
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情


;ウィン（ID:3697）淫堕ルート エンディングイベント
;「風霊使いの卒業」——杖を手放し、おちんぽを握る。

@イベント関数_エンディングイベント_風霊使いの卒業(動作モード, イベント行id)
#DIMS 動作モード
#DIM イベント行id
#DIM 対象キャラ

SELECTCASE 動作モード
	CASE "設定取得"
		TSTR:コマンド名受渡 = EX3697
		TSTR:ツールチップ受渡 = 
		TSTR:ツールチップ受渡 += "■エンディングNo.EX3697『風霊使いの卒業』<br>"
		TSTR:ツールチップ受渡 += "<br>"
		TSTR:ツールチップ受渡 += "風霊使いウィンの淫堕ルート・エンディング。<br>"
		TSTR:ツールチップ受渡 += "快楽に溺れた風霊使いが、精霊との絆を手放し、<br>"
		TSTR:ツールチップ受渡 += "ただひとりの雄の雌として生きる道を選ぶ。<br>"
		TSTR:ツールチップ受渡 += "<br>"
		TSTR:ツールチップ受渡 += "実行条件：ウィンが恋慕・淫乱であり、淫堕ルート⑥完了済み<br>"
		TSTR:ツールチップ受渡 += "解放要素：なし<br>"
		TSTR:ツールチップ受渡 += "エンディング視聴後：現在の周回を継続<br>"
	CASE "発生条件"
		SIF リゾートランク < 2
			RETURN 0
		対象キャラ = キャラ検索("[蒼翠の風霊使い]ウィン")
		SIF 対象キャラ < 0
			RETURN 0
		SIF !TALENT:対象キャラ:恋慕
			RETURN 0
		SIF !TALENT:対象キャラ:淫乱
			RETURN 0
		SIF !イベント完了フラグ確認("ウィン、淫堕ルート⑥堕ちた風霊使い")
			RETURN 0
		RETURN 1
	CASE "実行条件"
		対象キャラ = キャラ検索("[蒼翠の風霊使い]ウィン")
		SIF 対象キャラ < 0
			RETURN 0
		SIF !TALENT:対象キャラ:恋慕
			RETURN 0
		SIF !TALENT:対象キャラ:淫乱
			RETURN 0
		RETURN 1
	CASE "実処理"
		CALL エンディングイベント_シナリオ_風霊使いの卒業()
		RETURN RESULT
ENDSELECT

@イベントメッセージ_エンディングイベント_風霊使いの卒業(ARGS)
SELECTCASE ARGS
	CASE "発生時"
		PRINTL ウィンが大切そうに杖を抱えている。その翠の瞳には、覚悟の光が灯っていた。
ENDSELECT
DRAWLINE


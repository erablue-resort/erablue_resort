;****************************************
;キャラの初期パラメータを口上側で制御するためのファイル
;風霊使いウィン(3697)
;****************************************

;--------------------------------------------------
;初期パラメータ変更
;--------------------------------------------------
@口上側初期パラメータ変更_3697
;NEWGAME時に呼ばれる
LOCAL = GETCHARA(3697)

;画像フォルダ設定
CSTR:LOCAL:画像フォルダ = 3697ウィン

;キャラクターが自分を指す際の呼び方
SIF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = 私

;キャラクターがあなたを指す際の呼び方
SIF CSTR:LOCAL:二人称 == ""
	CSTR:LOCAL:二人称 = オーナーさん

;--------------------------------------------------
;ロード時パラメータ変更
;--------------------------------------------------
@口上側LOADENDパラメータ変更_3697
;ロード時に呼ばれる
LOCAL = GETCHARA(3697)

;画像フォルダ設定（ロード時も必ず設定）
CSTR:LOCAL:画像フォルダ = 3697ウィン

;キャラクターが自分を指す際の呼び方
IF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = %CSVCSTR(NO:LOCAL, GETNUM(CSTR, "一人称"))%
ENDIF
;キャラクターがあなたを指す際の呼び方
IF CSTR:LOCAL:二人称 == ""
	CSTR:LOCAL:二人称 = %CSVCSTR(NO:LOCAL, GETNUM(CSTR, "二人称"))%
ENDIF

;--------------------------------------------------
;弱点コマンド制御
;--------------------------------------------------
@弱点コマンド変更_3697
LOCAL = GETCHARA(3697)

;指定なし＝ランダム

;--------------------------------------------------
;フレーバー素質設定
;--------------------------------------------------
@フレーバー素質初期設定変更_3697
LOCAL = GETCHARA(3697)

フレーバー素質:LOCAL:素質表示設定 = 1

フレーバー素質:LOCAL:陰毛濃さ = 2
;1:パイパン 2:薄め
フレーバー素質:LOCAL:乳首大きさ = 2
;2:小さめ
フレーバー素質:LOCAL:乳輪大きさ = 2
;2:小さめ
フレーバー素質:LOCAL:性器種類 = 0
フレーバー素質:LOCAL:クリ大きさ = 1
;1:小さめ
フレーバー素質:LOCAL:ほくろ位置 = 0

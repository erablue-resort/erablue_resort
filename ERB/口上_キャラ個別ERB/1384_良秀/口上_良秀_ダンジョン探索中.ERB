;--------------------------------------------------
;ダンジョン探索中に条件を満たしていた時表示される文章
;--------------------------------------------------

;--------------------------------------------------
;「仲間と会話」ボタン押下時
;簡単に何度も見られるので、条件分岐やランダム化で複数パターンの登録を推奨
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

;仲間と会話は表示後にWAITが入らないので、追加分は全行WSTRにしている
SELECTCASE RAND:9
	CASE 0
		WSTR:(K++) = 「ライターは持ってきたか？」
	CASE 1
		WSTR:(K++) = 「機会が有れば芸術を見せてやろう」
	CASE 2
		WSTR:(K++) = 「それっぽい芸術を見てからだいぶ経ったな」
		KSTR:(K++) = 「近頃はどこかで見たことあるようなものばっかり大量生産しやがって。ふん」
	CASE 3
		WSTR:(K++) = 「不・満・オ？」（不満な事でもあるのか、オーナー？）
	CASE 4
		WSTR:(K++) = 「この辺りの土、砕けば顔料になりそうだ。
		WSTR:(K++) = 　帰りに少し持って帰るか」
	CASE 5
		WSTR:(K++) = 「煙草が湿気る。さっさと終わらせて外に出るぞ」
	CASE 6
		; は・へ・め＝腹が減った、飯にするぞ
		WSTR:(K++) = 「は・へ・め」（腹が減った、飯にするぞ）
	CASE 7
		IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
			;恋慕
			WSTR:(K++) = 「おい、前に出すぎるな。
			WSTR:(K++) = 　守るのは面倒なんだ。_一人称_の後ろにいろ」
		ELSE
			WSTR:(K++) = 「足を引っ張るなよ、オーナー。拾いに戻るのは面倒だ」
		ENDIF
	CASE 8
		;ドンキホーテが隊列にいれば掛け合い
		LOCAL:2 = GETCHARA(1389)
		IF LOCAL:2 > -1 && キャラ隊列検索(LOCAL:2) > -1
			WSTR:(K++) = 「おい、ドンキホーテ。その兜、少し貸せ。
			WSTR:(K++) = 　光の当たり方を描いておきたい」
			NSTR:(K++) = ++++
			切り替え名前:0 = %CALLNAME:(LOCAL:2)%
			切り替え顔グラリソース:0 = 探索用_{キャラ隊列検索(LOCAL:2)}_顔
			WSTR:(K++) = 「おお！ %CALLNAME:対象キャラ%殿が私を描いてくださるのでありまするか！
			WSTR:(K++) = 　ならば、正義の構えで待つとしよう！」
		ELSE
			WSTR:(K++) = 「退屈だな。斬りごたえのある奴はいないのか」
		ENDIF
ENDSELECT


CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0)


;ゲームの勝敗ではなく、ゲーム中の１ラウンドに勝利・敗北した際に表示される口上
;ゲームそのものの勝敗による口上は「コマンド実行時」のテンプレートを参照してください

@KOJO_EVENT_卓球勝負中_1384(対象キャラ, 表示モード)
#DIM 対象キャラ
#DIMS 表示モード
CALL 口上変数初期化

;遊びの口上は軽め。何で遊んでいるかと、負けず嫌いなのが伝わる程度
SELECTCASE 表示モード
	CASE "TARGET勝利"
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ふん、甘い。_一人称_の懐を抜けると思ったか」
			CASE 1
				KSTR:(K++) = 「一点。次も_一人称_がもらう」
		ENDSELECT
	CASE "あなた勝利_ポロリ無し"
		;そもそもポロリの条件を満たしてない時
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ちっ、今のはまぐれだ。次で取り返す」
			CASE 1
				KSTR:(K++) = 「やるな。だが、勝ち逃げは許さんぞ」
		ENDSELECT
	CASE "あなた勝利_ポロリ成功"
		;ポロリ成功時
		KSTR:(K++) = 「っ、おい、見るな！ もう少し強く縛っておくんだったか……！」
		KSTR:(K++) = 良秀は慌てて胸元を押さえ、%CALLNAME:MASTER%を睨みつけた。
	CASE "あなた勝利_ポロリ失敗"
		;ポロリ失敗時
		KSTR:(K++) = 「今、どこを狙った？ 次は顔面に打ち返すぞ」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;カード勝負
;--------------------------------------------------

@KOJO_EVENT_カード勝負_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;遊びの口上は軽め。勝てば得意げに、負ければ取り返す気満々
SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE -2
		;あなた敗北・罰ゲーム
		KSTR:(K++) = 「_一人称_の勝ちだ。さて、罰は何にしてやろうか」
	CASE -1
		;あなた敗北・ルピ減少
		KSTR:(K++) = 「勝負ありだ。賭け金は遠慮なくもらっておく」
	CASE 0
		;賭け有り・引き分けor賭け無し
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE -1
				;賭け無し・あなた敗北
				KSTR:(K++) = 「_一人称_の勝ちだ。賭けていなかったのが惜しいな」
			CASE 0
				;引き分け
				KSTR:(K++) = 「引き分けか。気に食わん。もう一勝負だ」
			CASE 1
				;賭け有り・あなた勝利
				KSTR:(K++) = 「ちっ。次は賭けてやる。そこで取り返すぞ」
		ENDSELECT
	CASE 1
		;あなた勝利・ルピ増加
		KSTR:(K++) = 「ちっ、持っていけ。次で倍にして取り返す」
	CASE 2
		;あなた勝利・罰ゲーム
		KSTR:(K++) = 「負けは負けだ。罰でも何でも、さっさと言え」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;すごろく
;--------------------------------------------------
;この口上はTARGETでなくとも、すごろく参加者なら全員表示される

@KOJO_EVENT_すごろく_1384(対象キャラ, 表示モード, 分岐変数)
#DIM 対象キャラ
#DIMS 表示モード
#DIM 分岐変数
CALL 口上変数初期化

;遊びの口上は軽め。手番の台詞は頻繁に出るので短く
SELECTCASE 表示モード
	CASE "手番_ダイスロール"
		;分岐変数にはターン数が入る。分岐変数 == 1でゲームスタート直後の開幕ターン
		IF 分岐変数 == 1
			KSTR:(K++) = 「始めるぞ。最初に抜け出すのは_一人称_だ」
		ELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「振るぞ」
				CASE 1
					KSTR:(K++) = 「出目くらい、_一人称_に従え」
				CASE 2
					KSTR:(K++) = 「さっさと進め。まだ追いつける」
			ENDSELECT
		ENDIF
	CASE "手番_一回休み"
		;分岐変数には何も入らない
		KSTR:(K++) = 「休みか。賽にまで足止めされるとはな」
	CASE "ゴール！"
		;分岐変数にはターン数が入る
		;誰かがゴールした時点で終了するので、一位のキャラの口上しか表示されない
		; 勝・当＝勝って当然
		KSTR:(K++) = 「ふっ、一着だな。勝・当。……勝って当然、という意味だ」
	CASE "全体イベント"
		;全員進むか全員戻るのイベント、分岐変数に移動量が入る
		IF 分岐変数 > 0
			;全員進む時
			KSTR:(K++) = 「全員前進か。差が縮まらんのは気に食わんな」
		ELSEIF 分岐変数 < 0
			;全員戻る時
			KSTR:(K++) = 「全員戻るのか。まあ、_一人称_だけじゃないならいい」
		ENDIF
	CASE "罰ゲームイベント"
		;分岐変数には罰ゲーム種類が入る
		SELECTCASE 分岐変数
			CASE 0
				;不思議な力で衣装がバニーに
				KSTR:(K++) = 「何だこの服は。動きにくい。さっさと次を振れ」
			CASE 1
				;一発芸を披露する
				KSTR:(K++) = 「一発芸か。短縮で十人の名前を言ってやる。当ててみろ」
			CASE 2
				;不思議な力で衣装がメイド服に
				KSTR:(K++) = 「おかえりなさいませ、とでも言えばいいのか。二度は言わんぞ」
			CASE 3
				;次のターンまで誰かを膝枕したままプレイする_する側
				KSTR:(K++) = 「膝を貸すだけだ。寝るなよ、手番が来たら起こすからな」
			CASE 4
				;誰かから思いっきりくすぐられる_される側
				KSTR:(K++) = 「っ、く……触るな、くく、やめっ……！」
			CASE 5
				;誰かを思い切りハグする_する側
				KSTR:(K++) = 「ほら。これでいいだろう。さっさと離れろ」
		ENDSELECT
	CASE "罰ゲームイベント_反応"
		;分岐変数には罰ゲーム種類が入る
		SELECTCASE 分岐変数
			CASE 3
				;次のターンまで誰かを膝枕したままプレイする_される側
				KSTR:(K++) = 「妙な気分だ。まあ、悪くはない」
			CASE 4
				;誰かから思いっきりくすぐられる_する側
				KSTR:(K++) = 「くく、覚悟しろ。容赦はせん」
			CASE 5
				;誰かを思い切りハグする_される側
				KSTR:(K++) = 「苦しい。罰ゲームはそっちだろう」
		ENDSELECT
	CASE "有利イベント"
		;分岐変数にはイベント種類が入る（もう一度振る、２～４マス進む）。台詞は共通
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「よし、流れが来た」
			CASE 1
				KSTR:(K++) = 「当然だ。賽も分かっている」
		ENDSELECT
	CASE "不利イベント"
		;分岐変数にはイベント種類が入る
		IF 分岐変数 == 0
			;一回休みに
			KSTR:(K++) = 「ちっ。ここで止まるのか」
		ELSE
			;２～４マス戻る
			KSTR:(K++) = 「戻るだと？ この盤を作った奴は性格が悪いな」
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)
IF 表示モード == "全体イベント"
	;移動処理が挟まりながら口上が出てくるため、スキップで見逃さないようにFORCEWAITを挟む
	FORCEWAIT
ENDIF

;--------------------------------------------------
;罰ゲーム
;--------------------------------------------------

@KOJO_EVENT_罰ゲーム_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;遊びの口上は軽め。触れる系の罰ゲームは共通の台詞でまとめる（良秀に角・尻尾はない）
SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE 1
		;ルピ賭けあなた勝利
		KSTR:(K++) = 「ちっ、持っていけ。次で取り返す」
	CASE -1
		;ルピ賭けキャラ勝利
		KSTR:(K++) = 「もらっておく。悔しいなら、また挑んでこい」
	CASE 2
		;罰ゲーム賭けあなた勝利（良秀が罰を受ける）
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE 0
				;でこぴん
				KSTR:(K++) = 「っ……！ 加減というものを知らんのか」
			CASE 1
				;お酒を飲む、TCVAR:対象キャラ:初飲酒フラグ = 1の時、キャラが初めて飲酒した
				IF TCVAR:対象キャラ:初飲酒フラグ
					KSTR:(K++) = 「これが酒か。……罰にしては、悪くない」
				ELSE
					KSTR:(K++) = 「罰で飲む酒も、酒は酒だ。ありがたくもらう」
				ENDIF
			CASE 2
				;体に触れる
				;セクハラの身体に触れる系コマンドと数字一致
				SELECTCASE RFLAG:コマンド結果受渡し変数４
					CASE 9
						;脇をくすぐる
						KSTR:(K++) = 「っ、くく……そこは、反則だ……！」
					CASEELSE
						;背中、耳、尻、腹、頭、髪、太もも、へそ、下腹部など（角・尻尾はない）
						KSTR:(K++) = 「触るなら、さっさとしろ。罰だからな」
				ENDSELECT
			CASE 10
				;下着の色を言う
				KSTR:(K++) = 「見れば分かるだろう。……黒だ。満足か」
			CASE 11
				;セクシーポーズで淫語
				KSTR:(K++) = 良秀は渋々ポーズを取り、聞き取れないほどの小声で何かを呟いた。
				KSTR:(K++) = 「二度とやらんからな。罰にしても趣味が悪い」
			CASE 12
				;乳首当てゲーム
				IF RFLAG:コマンド結果受渡し変数４ == 1
					;的中
					KSTR:(K++) = 「っ！ まぐれだ。まぐれに決まってる」
				ELSEIF RFLAG:コマンド結果受渡し変数４ == -1
					;ハズレ
					KSTR:(K++) = 「くく、外れだ。_二人称_の目は節穴か」
				ELSEIF RFLAG:コマンド結果受渡し変数４ == 2
					;的中したが誤魔化したので指をぐりぐりして認めさせる
					KSTR:(K++) = 「っ、分かった、当たりだ！ ぐりぐりするな……！」
				ENDIF
			CASE 14
				;胸を揉む
				KSTR:(K++) = 「揉むほどないだろう。……言わせるな」
			CASE 13, 16, 17, 18
				;尻を揉む、肩組み乳揉み、乳首ひっかき、股間を弄る
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「罰だからな。罰だから、仕方なく許してるだけだ」
					CASE 1
						KSTR:(K++) = 「っ、調子に乗るなよ。次は_一人称_が勝つ」
				ENDSELECT
		ENDSELECT
	CASE -2
		;罰ゲーム賭けキャラ勝利（良秀が罰を与える）
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE 0
				;でこぴん
				KSTR:(K++) = 「歯を食いしばれ。加減？ 罰ゲームに加減はない」
			CASE 1
				;お酒を飲む、TCVAR:PLAYER:初飲酒フラグ = 1の時、PLAYERが初めて飲酒した
				IF TCVAR:PLAYER:初飲酒フラグ
					KSTR:(K++) = 「初めてか？ なら、ゆっくり飲め。罰でも、酒は楽しむものだ」
				ELSE
					KSTR:(K++) = 「ほら、飲め。一気にな」
				ENDIF
			CASE 10
				;下着の色を言う
				KSTR:(K++) = 「さあ、言ってもらおうか。嘘をついたら確かめるぞ」
			CASE 11
				;セクシーポーズで淫語
				KSTR:(K++) = 「くく、そのポーズで言ってみろ。ほら、声が小さい」
			CASE 12
				;乳首当てゲーム
				IF RFLAG:コマンド結果受渡し変数４ == 1
					;的中
					KSTR:(K++) = 「ほら、当たりだ。_一人称_の目に狂いはない」
				ELSEIF RFLAG:コマンド結果受渡し変数４ == -1
					;ハズレ
					KSTR:(K++) = 「外れたか。服の上からじゃ、構図が掴めん」
				ENDIF
			CASE 13, 14, 16, 17, 18
				;尻を揉む、胸を揉む、肩組み乳揉み、乳首ひっかき、股間を弄る
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「罰は罰だ。逃げるなよ」
					CASE 1
						KSTR:(K++) = 「くく、大人しくしていろ。負けたのは_二人称_だ」
				ENDSELECT
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;初うふふが泥酔ックスだった場合、翌朝に発動するイベント
;--------------------------------------------------

@KOJO_MORNINGEVENT_初うふふ泥酔ックス後_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;この口上関数が存在すると汎用文章が表示されないので注意（翌朝だと分かる地の文から入る）
IF 告白成功判定(対象キャラ)
	;気持ちがある：覚えていないのが惜しい、後悔していない理由が分からない（困惑と許容）
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 目を覚ました良秀は、隣で眠る%CALLNAME:MASTER%と、床に散らばった服を交互に眺めた。
			KSTR:(K++) = 「……頭が割れる。昨夜のことは、半分も覚えてない」
			KSTR:(K++) = 「覚えてないのが、妙に惜しい。……なぜだ」
			KSTR:(K++) = 良秀はしばらく考え込んでいたが、やがて考えるのをやめたように息を吐いた。
			KSTR:(K++) = 「まあいい。水を寄越せ。話はそれからだ」
		CASE 1
			KSTR:(K++) = 「……起きたか。お互い、酒に呑まれたらしいな」
			KSTR:(K++) = 良秀は額を押さえながら、%CALLNAME:MASTER%の顔をじっと見つめた。
			KSTR:(K++) = 「_二人称_はどうだ？ 昨日のことは憶えているか？ ……ふっ、ニヤつくんじゃない」
			KSTR:(K++) = 微笑みながら良秀は%CALLNAME:MASTER%の頭を小突いた。
	ENDSELECT
ELSEIF CFLAG:対象キャラ:好感度レベル > 関係閾値:4
	;親しいが気持ちはまだ：酒の勢いに流された自分への苛立ち
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「……ちっ。酒の勢いとは、我ながら趣味が悪い」
			KSTR:(K++) = 良秀は乱れた髪を掻き上げ、気まずそうに%CALLNAME:MASTER%から目を逸らした。
			KSTR:(K++) = 「昨夜のことは、記憶から消せ。……_一人称_も、消せるものならそうしたい」
		CASE 1
			KSTR:(K++) = 「……おい。_一人称_は、どこまで覚えていると思う」
			KSTR:(K++) = %CALLNAME:MASTER%の返事を聞くと、良秀は長い沈黙のあとで顔を背けた。
			KSTR:(K++) = 「……そうか。なら、忘れたふりをしてやる。お互いにな」
	ENDSELECT
ELSE
	;それ以外：二日酔いの不機嫌さで突き放す
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「……頭が痛い。それと、なぜ_二人称_がここにいる」
			KSTR:(K++) = 良秀はしばらく状況を眺めていたが、やがて深々と溜息をついた。
			KSTR:(K++) = 「酒は芸術の友だと思っていたが、訂正する。……水だ。水を寄越せ」
		CASE 1
			KSTR:(K++) = 「起きたなら、さっさと出ていけ。……いや、待て。水を置いていけ」
			KSTR:(K++) = 良秀は枕に顔を埋めたまま、手だけを%CALLNAME:MASTER%の方へ突き出した。
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;うふふ終了時
;--------------------------------------------------
@KOJO_EVENT_うふふ終了_1384(対象キャラ, 終了原因)
#DIM 対象キャラ
#DIMS 終了原因
CALL 口上変数初期化

IF CFLAG:対象キャラ:体力限界
	;終了時にダウンしている
	IF 終了原因 == "全員ダウン"
		;全員ダウン時
		KSTR:(K++) = 「……はぁ、はぁ……全員、倒れたか……
		KSTR:(K++) = 　_二人称_、化け物か……」
	ELSE
		;他に生き残りがいる時
		KSTR:(K++) = 「……っ、くそ……_一人称_が、先に落ちるとは……」
	ENDIF
ELSE
	;終了時にダウンしていない
	SELECTCASE 終了原因
		CASE "通常終了"
			;逢引終了ボタンでの終了。最も一般的
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「終わりか。……まあいい、今日はこのくらいで勘弁してやる」
					KSTR:(K++) = 良秀は乱れた服を雑に直すと、何事もなかったように煙草を咥えた。
				CASE 1
					KSTR:(K++) = 「……ん。悪くなかった」
					KSTR:(K++) = 「次は、_一人称_が終わりを決める番だ」
			ENDSELECT
		CASE "目撃される"
			;陥落していないキャラにうふふが目撃された
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……見られたか。ちっ、興が削がれた」
					KSTR:(K++) = 「続きは、もっと人目のない所でやるぞ」
				CASE 1
					KSTR:(K++) = 「ふん、覗き見とは趣味が悪い。
					KSTR:(K++) = 　……まあ、見せて減るものでもないが」
			ENDSELECT
		CASE "サウナ限界"
			;サウナ内でうふふ中、熱気ゲージがたまりすぎた時
			SELECTCASE RAND:2
				CASE 0
					; か・す・ぬ・し＝体中の水分が抜けて死にそうだ
					KSTR:(K++) = 「か・す・ぬ・し。……続きは外だ。水を寄越せ」
				CASE 1
					KSTR:(K++) = 「……これ以上は茹で上がる。_二人称_も顔が真っ赤だぞ」
			ENDSELECT
		CASE "あなた泥酔"
			;あなたが酔いすぎにより終了。"現在発生しないはず"
		CASE "不機嫌"
			;キャラが怒って終了。"現在発生しないはず"
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)


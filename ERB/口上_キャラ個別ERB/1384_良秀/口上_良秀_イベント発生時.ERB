;****************************************

;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;このイベントで呼ばれるのはオーナーだけ
;良秀は夜更かしで朝寝坊（素質の早寝・早起きがマイナス）。朝は眠そうに、夜は目が冴えている
IF 口上_陥落判定_3652(対象キャラ, MASTER)
	;陥落後
	SELECTCASE TIME
		;朝　5時～11時
		CASE 5*60 TO 11*60
			SELECTCASE RAND:2
				CASE 0
					; ね・む＝眠い（一語を区切るだけの型）
					KSTR:(K++) = 「ふぁ。_二人称_か。……ね・む」
					KSTR:(K++) = 良秀は眠そうに目を擦りながら、それでも当たり前のように%CALLNAME:MASTER%の隣へ並んだ。
				CASE 1
					KSTR:(K++) = 「朝から_二人称_の顔か。悪くない目覚ましだ」
					KSTR:(K++) = 「二度寝はやめておく。今日は付き合ってやる」
			ENDSELECT
		;昼　11時～18時
		CASE 11*60 TO 18*60
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「ん、ようやく会えたな。どこをほっつき歩いてた」
					KSTR:(K++) = 良秀は口ぶりとは裏腹に、どこか機嫌よさそうに%CALLNAME:MASTER%の顔を眺めた。
				CASE 1
					; 昼・済＝昼飯は済んだか
					KSTR:(K++) = 「昼・済？ まだなら付き合え。
					KSTR:(K++) = 　_二人称_と食う方が、一人より退屈しない」
			ENDSELECT
		;夜　それ以外
		CASEELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「夜はこれからだろう。どうした、もう眠いのか？」
					KSTR:(K++) = 昼間とは打って変わって、良秀の目はすっかり冴えている。
				CASE 1
					KSTR:(K++) = 「やっと静かになったな。昼間は人が多すぎる」
					KSTR:(K++) = 「少し歩くか。夜の景色は、昼とは別物だぞ」
			ENDSELECT
	ENDSELECT
ENDIF
IF K == 0
	;陥落前
	SELECTCASE TIME
		;朝　5時～11時
		CASE 5*60 TO 11*60
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……朝か。_一人称_に話しかけるなら、もう少し後にしろ」
					KSTR:(K++) = 良秀は不機嫌そうに欠伸を噛み殺した。どうやら朝は弱いらしい。
				CASE 1
					; お・は＝おはよう
					KSTR:(K++) = 「お・は。短縮は美だ。朝から長い挨拶は要らん」
			ENDSELECT
		;昼　11時～18時
		CASE 11*60 TO 18*60
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「ん。オーナーか。用がないなら、_一人称_は行くぞ」
				CASE 1
					KSTR:(K++) = 「オーナーか。今日は何か面白いことでもあったか？
					KSTR:(K++) = 　……ないなら、別にいい」
			ENDSELECT
		;夜　それ以外
		CASEELSE
			SELECTCASE RAND:2
				CASE 0
					; 静・夜＝静かな夜
					KSTR:(K++) = 「静・夜。これくらいのほうが_一人称_にとっては過ごしやすい。ここはあちこち人が多くてかなわん」
				CASE 1
					KSTR:(K++) = 「まだ起きてたのか、オーナー。
					KSTR:(K++) = 　夜更かしは、_一人称_の専売特許だぞ」
			ENDSELECT
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;次のキャラの一文と区別したい場合は、下のコメントアウトを外すこと
SIF K > 0
	DRAWLINE

;--------------------------------------------------
;情事目撃時
;--------------------------------------------------
@KOJO_EVENT_情事目撃_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;情事を目撃した後、再び顔を合わせた時。「先の○○との一件について問い詰められた…」の表示の直後に呼ばれる
;相手はCFLAG:対象キャラ:情事目撃（台詞内では「あいつ」と呼ぶ）
;共通の導入。表情は3種からランダム
SELECTCASE RAND:3
	CASE 0
		LOCALS = ニヤニヤしながら
	CASE 1
		LOCALS = 意味深な笑みを浮かべながら
	CASE 2
		LOCALS = 含みのある笑顔のまま
ENDSELECT
KSTR:(K++) = 良秀は%CALLNAME:MASTER%を見つけると、%LOCALS%近づいてきた。
IF 口上_関係性判定_3652(対象キャラ, MASTER, "恋慕")
	;恋慕：責めるより、張り合うか混ざりたがる
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「見たぞ。あいつとの一件」
			KSTR:(K++) = 良秀は%CALLNAME:MASTER%の顔を覗き込み、わざとらしく首を傾げてみせた。
			KSTR:(K++) = 「で、あいつのどこがよかった？ 参考までに聞いておく」
		CASE 1
			KSTR:(K++) = 「別に責めはしない。ただ、次は_一人称_も混ぜろ。
			KSTR:(K++) = 　見てるだけは、性に合わん」
	ENDSELECT
ELSEIF 口上_関係性判定_3652(対象キャラ, MASTER, "セフレ")
	;セフレ
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「見たぞ。_二人称_も好き者だな。人のことは言えんが」
		CASE 1
			KSTR:(K++) = 「あいつとの一件、なかなかの見物だったぞ。……構図だけはな」
	ENDSELECT
ELSE
	;未恋慕
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「見たぞ。ああいうことは、もう少し場所を選べ」
			KSTR:(K++) = 良秀は呆れたように溜息をついたが、どこか面白がっているようにも見えた。
		CASE 1
			KSTR:(K++) = 「あれは何だ。いや、言わなくていい。
			KSTR:(K++) = 　絵の題材にするには、少し品がなさすぎた」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)



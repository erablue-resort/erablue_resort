;何かにパッと気づくのではなく、最初は困惑して処理しきれず、相手を許容する方へじわじわ移っていく
SELECTCASE RAND:2
	CASE 0
		;描いているはずが、気づけば相手の輪郭ばかり
		KSTR:(K++) = 良秀は珍しく筆を止め、描きかけの紙と%CALLNAME:MASTER%の顔を何度も見比べていた。
		KSTR:(K++) = 「……妙だな。海を描いていたはずが、気づくと人の輪郭ばかり引いている」
		KSTR:(K++) = 紙の上には、描きかけの%CALLNAME:MASTER%の横顔が、いくつも重なっていた。
		KSTR:(K++) = 「_二人称_の顔は、別に美しい構図じゃない。目を留める理由がない。
		KSTR:(K++) = 　……なのに、だ」
		KSTR:(K++) = 良秀は眉間に皺を寄せ、しばらく黙り込んだ。答えの出ない問いを、何度もなぞるように。
		KSTR:(K++) = 「分からん。……分からんが」
		KSTR:(K++) = やがて小さく息を吐くと、良秀は描きかけの紙を破らずに畳み、懐へしまった。
		KSTR:(K++) = 「まあいい。分からんものを、分からんまま置いておくのも悪くはない」
	CASE 1
		;立ち去ろうとした相手の袖を、自分の手が掴んでいる
		KSTR:(K++) = 用事を済ませて立ち去ろうとした%CALLNAME:MASTER%の袖を、良秀の指が掴んでいた。
		KSTR:(K++) = 掴んだ当の本人が、誰よりも驚いた顔をしている。
		KSTR:(K++) = 「……今のは、_一人称_の手か？」
		KSTR:(K++) = 良秀は自分の指をしげしげと眺め、それから%CALLNAME:MASTER%の顔を見た。
		KSTR:(K++) = 「引き止める理由はない。用もない。……なのに、手が動いた」
		KSTR:(K++) = 理屈を探すように視線を彷徨わせていたが、やがて良秀は、掴んだ袖をゆっくりと放した。
		KSTR:(K++) = 「隣にいられるのが、前ほど鬱陶しくない。……それだけのことか」
		KSTR:(K++) = 「ふん。いい。こっちの話だ。……どうした。_一人称_は_一人称_の好きにする。_二人称_も好きにしろ」
ENDSELECT


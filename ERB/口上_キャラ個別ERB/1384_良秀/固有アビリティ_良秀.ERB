        L_MP = 15
        L_CD = 0
        L_P = 0
        L_X = 20
        L_Y = 100
        L_T = 3
        L_NAME = ばらまく
        L_DESC '= @"敵全体の防御力を{L_T}ターン{L_X}％低下（B枠）。"
    CASE 3

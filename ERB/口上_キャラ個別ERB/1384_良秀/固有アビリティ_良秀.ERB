#DIM DYNAMIC L_JOB
#DIM DYNAMIC L_SLOT
#DIM DYNAMIC L_KEY
#DIM DYNAMIC L_MP
#DIM DYNAMIC L_CD
#DIM DYNAMIC L_P
#DIM DYNAMIC L_X
#DIM DYNAMIC L_Y
#DIM DYNAMIC L_T
#DIMS DYNAMIC L_NAME
#DIMS DYNAMIC L_DESC

L_KEY = L_JOB * 10 + L_SLOT
SIF L_SLOT == 1
    L_KEY = 1
L_MP = 0
L_CD = 0
L_P = 0
L_X = 0
L_Y = 0
L_T = 0
L_NAME =
L_DESC =
SELECTCASE L_KEY
    CASE 1
        ; 共通 / 塗る
        L_MP = 30
        L_CD = 3
        L_P = 100
        L_X = 10
        L_Y = 10
        L_T = 3
        L_NAME = く・へ
        L_DESC '= @"行動を消費せず通常攻撃。<br>攻撃後、クリティカル率を{L_T}ターン＋{L_X}ポイント（独自枠・非累積）。<br>効果中、次のクリティカル時に一度だけ最大MPの{L_Y}％を回復。"

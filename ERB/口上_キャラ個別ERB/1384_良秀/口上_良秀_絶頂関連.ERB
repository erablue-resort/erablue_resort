;--------------------------------------------------
;良秀（1384）の絶頂関連の口上
;陥落の有無では分けず、必要な所だけ性癖（性癖素質。0:なし 1:興味 2:愛好 3:中毒）で分ける。
;相手があなたの時だけ口上を出し、それ以外は汎用文章に任せる。
;良秀は男性器がないので、キャラ射精時（KOJO_ORGASM_射精）は作らない。
;露出絶頂・苦痛絶頂などの種類別の絶頂は、ゲーム側の呼び出しがコメントアウトされているので作らない。
;--------------------------------------------------

;--------------------------------------------------
;通常絶頂時
;--------------------------------------------------
;NOWEX:対象キャラ:Ｃ絶頂～Ｓ絶頂 に、各部位の絶頂強度（1～5）が入っている
;TCVAR:対象キャラ:うふふ中Ｃ絶頂累積 などに、うふふ中の絶頂回数の累積が入っている（うふふ終了でリセット）
@KOJO_ORGASM_通常絶頂_1384(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
#DIM 同時絶頂数
#DIM 累積絶頂数
CALL 口上変数初期化

相手キャラ番号 = 絶頂相手算出(対象キャラ)
IF 相手キャラ番号 == MASTER
	;同時に絶頂した部位の数
	同時絶頂数 = 0
	FOR LOCAL, 0, 5
		SIF NOWEX:対象キャラ:LOCAL
			同時絶頂数 += 1
	NEXT
	累積絶頂数 = TCVAR:対象キャラ:うふふ中Ｃ絶頂累積 + TCVAR:対象キャラ:うふふ中Ｖ絶頂累積 + TCVAR:対象キャラ:うふふ中Ａ絶頂累積 + TCVAR:対象キャラ:うふふ中Ｂ絶頂累積 + TCVAR:対象キャラ:うふふ中Ｓ絶頂累積
	
	IF 累積絶頂数 >= 6 && RAND:2
		;うふふ中に何度もイかされた時：性欲に呑まれて止まれない自分への苛立ち
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「……は、ぁ……まだ、続けるのか……_H_
				KSTR:(K++) = 　っ、身体が、勝手に……」
			CASE 1
				KSTR:(K++) = 「くそ……何度目だ……っ_H_
				KSTR:(K++) = 　止められん……_一人称_も、_二人称_も……」
		ENDSELECT
	ELSEIF 同時絶頂数 >= 3
		;3部位以上の同時絶頂
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「っ、あ、ぁ……っ_H_ 全部、いっぺんに……っ_H__H_
				KSTR:(K++) = 　……くそ、頭が、真っ白だ……」
			CASE 1
				KSTR:(K++) = 「～～～っ！ ……は、ぁ……っ_H_ 何も、考えられん……」
		ENDSELECT
	ELSEIF 同時絶頂数 == 2
		;2部位の同時絶頂
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「んっ、ぁ……っ_H_ 待て、両方は……っ_H_」
			CASE 1
				KSTR:(K++) = 「っ、く……二箇所、同時に……っ_H_ 卑怯だぞ、_二人称_……」
		ENDSELECT
	ELSEIF NOWEX:対象キャラ:Ｃ絶頂
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「っ……ん、ぅ……_H_ そこばかり、責めるな……っ」
			CASE 1
				KSTR:(K++) = 「ぁ……っ_H_ ……ちっ、こんなに、あっさり……」
		ENDSELECT
	ELSEIF NOWEX:対象キャラ:Ｖ絶頂
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ぁ、あ……っ_H_ 奥、が……っ、締まる……っ_H_」
			CASE 1
				KSTR:(K++) = 「っ、ん……_H_ _二人称_の形を、覚えさせられてる気分だ……」
		ENDSELECT
	ELSEIF NOWEX:対象キャラ:Ａ絶頂
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「っ……！ 後ろで、こんな……っ_H_ ……っ、くそ」
			CASE 1
				KSTR:(K++) = 「ぁ、ぐ……っ_H_ 変態め。後ろでイかせるな……」
		ENDSELECT
	ELSEIF NOWEX:対象キャラ:Ｂ絶頂
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「んっ……_H_ 揉むほどの胸もないのに、なぜ……っ」
			CASE 1
				KSTR:(K++) = 「っ、ぁ……胸、で……？ ……ちっ、妙な所を開発するな……」
		ENDSELECT
	ELSEIF NOWEX:対象キャラ:Ｓ絶頂
		KSTR:(K++) = 「っ……ぁ……_H_ 背筋が、痺れて……」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;射精を受けた時（相手の射精）
;--------------------------------------------------
;RFLAG:フィニッシュ場所：どこに出されたか
;　0:膣内 1:腸内 2:口 3:乳内 5:顔 6:腹 7:背中 8:太もも 9:手のひら 10:足 30:他にどこにも出せない時
;RCVAR:対象キャラ:被射精絶頂の強度：1以上なら、射精された時に良秀も絶頂した（今は膣内・腸内・口・乳内の時だけ起こる）
;RCVAR:対象キャラ:精飲フラグ：口に出された時　2:喜んで飲む 1:なんとか飲み込む 0:吐き出す
@KOJO_ORGASM_被射精_1384(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号
IF 相手キャラ番号 == MASTER
	SELECTCASE RFLAG:フィニッシュ場所
		CASE 0
			;膣内。性癖「膣内射精」で分ける
			IF RCVAR:対象キャラ:被射精絶頂の強度
				IF 性癖素質:対象キャラ:膣内射精 >= 2
					KSTR:(K++) = 「っ、あ、ぁ……っ_H_ 熱いのが、奥に……っ_H__H_
					KSTR:(K++) = 　……もっと、寄越せ……」
				ELSE
					KSTR:(K++) = 「っ……！ 中で、出されて……っ_H_ ……一緒に、イくとはな……」
				ENDIF
			ELSE
				IF 性癖素質:対象キャラ:膣内射精 >= 3
					KSTR:(K++) = 「ん……っ_H_ まだ足りん。もっと奥に、出せ……」
				ELSEIF 性癖素質:対象キャラ:膣内射精 == 2
					KSTR:(K++) = 「中に出されるのは、嫌いじゃない……。
					KSTR:(K++) = 　……くそ、嫌いじゃなくなった」
				ELSE
					KSTR:(K++) = 「中に出したな。後始末は_二人称_がやれよ」
				ENDIF
			ENDIF
		CASE 1
			;腸内。性癖「腸内射精」で分ける
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 「っ、ぐ……後ろに、出されて……っ_H_ イかされるとは……っ」
			ELSEIF 性癖素質:対象キャラ:腸内射精 >= 2
				KSTR:(K++) = 「後ろに出される感覚、悪くない……。……言わせるな」
			ELSE
				KSTR:(K++) = 「後ろに出すな。……腹が重い」
			ENDIF
		CASE 2
			;口。飲むかどうかはゲーム側の精飲フラグ、喜び方は性癖「精飲」で分ける
			SELECTCASE RCVAR:対象キャラ:精飲フラグ
				CASE 2
					IF 性癖素質:対象キャラ:精飲 >= 2
						KSTR:(K++) = 「ん、く……っ、ごく……っ_H_ ……ふぅ。
						KSTR:(K++) = 　_二人称_の味は、癖になる」
					ELSE
						KSTR:(K++) = 「ん……ごくっ。飲んでやった。感謝しろ」
					ENDIF
				CASE 1
					KSTR:(K++) = 「っ、ん……ぐ……。苦い。よくこんなものを出せるな」
				CASEELSE
					KSTR:(K++) = 「っ、げほっ……！ ……口に出すなら、先に言え」
			ENDSELECT
		CASE 3
			;乳内（パイズリ）
			KSTR:(K++) = 「この胸で、出せたのか。……ふん、物好きめ」
		CASE 5
			;顔
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「顔にかけるな。前が見えん。拭くものを寄越せ」
				CASE 1
					KSTR:(K++) = 「人の顔に描くなら、もう少し筆遣いを考えろ」
			ENDSELECT
		CASE 6
			;腹
			KSTR:(K++) = 「腹の上が、べたべただ。_二人称_が拭け」
		CASE 7
			;背中
			KSTR:(K++) = 「背中に出したな。自分じゃ拭けん。責任を持て」
		CASE 8
			;太もも
			KSTR:(K++) = 「腿に垂れてくる。……ちっ、歩きにくい」
		CASE 9
			;手のひら
			KSTR:(K++) = 良秀は手のひらに受け止めたものを、しげしげと眺めた。
			KSTR:(K++) = 「ずいぶん出したな。……満足したか？」
		CASE 10
			;足
			KSTR:(K++) = 「足に、か。妙な趣味だな、_二人称_」
		CASE 30
			IF CFLAG:対象キャラ:うふふ
				;うふふ中の汎用射精
				KSTR:(K++) = 「……出したか。満足したなら、少し休ませろ」
			ELSE
				;うふふ中ではない時の射精（逆セクハラなど）
				KSTR:(K++) = 「くく、もう出たのか。早いな」
			ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

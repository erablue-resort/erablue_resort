@KOJO_COM_1384_351(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
;連れ出すは出かける前の一言なので、場所では分けない。両方の関係があれば恋慕を優先。
;RFLAG:コマンド結果受渡し変数が1なら既に同行中で手を繋ぐ方、0なら新しく連れ出す。
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	IF RFLAG:コマンド結果受渡し変数
		; 既に同行中。実際の相手に恋慕がある。
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「指まで絡めるのか。……いい。離す時は言えよ。急にいなくなられると気に障る」
			CASE 1
				; 受け身に留まらず、自分の握り方に直す。
				KSTR:(K++) = 「それで繋いだつもりか？」
				KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の指を握り直し、歩き出した。
				KSTR:(K++) = 「ほら、このくらいだ。_一人称_が寄り道する時も、離すなよ」
		ENDSELECT
	ELSE
		; 新しく連れ出す。実際の相手に恋慕がある。
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「どこへ行く。……いや、言わなくていい。
				KSTR:(K++) = 　着いてからのお楽しみにしておく」
			CASE 1
				KSTR:(K++) = 良秀は返事の代わりに煙草を咥え直し、%CALLNAME:PLAYER%の隣に並んだ。
				KSTR:(K++) = 「_二人称_が行く所なら、退屈はしないだろう。

ELSE
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM404 覗く
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;覗き方  1:脱衣所・更衣室から反対側  2:脱衣所・更衣室に隠れて
	;　　　　3:野外オナorゆきずりセックスをしてる人をこっそり　4:温泉施設で覗き用場所から
;RFLAG:コマンド結果受渡し変数３
	;風呂を覗いた時  0:湯船に浸かる姿  1:体を洗う姿
;RFLAG:コマンド結果受渡し変数４
	;野外オナニー時、部位が入る  0:Ｃ 1:Ｖ 2:Ａ 3:Ｂ
@KOJO_COM_1384_404(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 1, 2
		;1:脱衣所・更衣室から反対側を覗く　2:脱衣所・更衣室に隠れて覗く
		;本文は共通。2は近くに潜んでいるので、ときどき気配に勘づく
		;夜遅く・早朝は誰もいない場面。それ以外は2/3でモブ観光客との会話、1/3で誰もいない場面
		LOCAL = TIME < 6*60 || TIME >= 22*60 || RAND:3 == 0
		;場所。海エリア（マップ種別3）の4・5は水着の更衣室として扱う
		IF CFLAG:PLAYER:現在マップ種別 == 3
			LOCAL:1 = 13
		ELSE
			LOCAL:1 = CFLAG:PLAYER:現在位置
		ENDIF
		SELECTCASE LOCAL:1
			CASE 7, 8
				;服を脱いでいる
				IF LOCAL
					;誰もいない
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 脱衣所には良秀のほかに誰もいない。
							KSTR:(K++) = 良秀は脱いだ服を雑に籠へ放り込み、両腕を上げて大きく伸びをした。
							KSTR:(K++) = 「……ふう。誰の目もないと、肩が軽いな」
						CASE 1
							KSTR:(K++) = 誰もいない脱衣所で、良秀は鏡の前に立ち、自分の姿をしげしげと眺めていた。
							KSTR:(K++) = 「……悪くない構図だ。
							KSTR:(K++) = 　これを描ける奴がいないのが惜しいな」
					ENDSELECT
				ELSE
					;モブ観光客と会話
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 年配の観光客が、籠のそばに立てかけた刀を見て目を丸くしている。
							KSTR:(K++) = 「……ああ、これか。手の届く所にないと落ち着かんだけだ。
							KSTR:(K++) = 　気にするな、湯の邪魔はせん」
							KSTR:(K++) = 観光客がほっとしたように笑うと、良秀は何事もなかったように上着を脱いだ。
						CASE 1
							KSTR:(K++) = 二人連れの観光客が、良秀の方をちらちら見ながら囁き合っている。
							KSTR:(K++) = 「……何だ。言いたいことがあるなら、聞こえるように言え」
							KSTR:(K++) = 「スタイルいいなって……」と慌てて答える二人に、良秀は鼻を鳴らした。
							; 見・目・有＝見る目が有る
							KSTR:(K++) = 「ふん。見・目・有。……悪い気はしないか」
					ENDSELECT
				ENDIF
			CASE 9, 11
				;浴場。RFLAG:コマンド結果受渡し変数３　0:湯船に浸かる姿　1:体を洗う姿
				IF RFLAG:コマンド結果受渡し変数３ == 0
					;湯船に浸かっている
					IF LOCAL
						;誰もいない
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 広い湯船に浸かっているのは、良秀ひとりだった。
								KSTR:(K++) = 良秀は縁に頭を預け、湯の中で手足を思い切り伸ばしている。
								; 貸・切＝貸し切り
								KSTR:(K++) = 「……ああ……貸・切。悪くない」
							CASE 1
								KSTR:(K++) = 誰もいない湯船で、良秀は肩まで浸かり、立ちのぼる湯気をぼんやりと眺めていた。
								KSTR:(K++) = 「……湯気の形は、二度と同じにならんな」
								KSTR:(K++) = そう呟いたきり、良秀は長いあいだ湯気の行方を目で追っていた。
						ENDSELECT
					ELSE
						;モブ観光客と会話
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 隣に浸かった観光客に話しかけられ、良秀は面倒そうに片目を開けた。
								KSTR:(K++) = 「ん？ ……ああ、絵を描く。それがどうした」
								KSTR:(K++) = 「画家さんなんですか！」と目を輝かせる相手に、良秀はまんざらでもなさそうに口の端を上げた。
								KSTR:(K++) = 「……_一人称_の絵を見たいなら、それなりの覚悟をしておけ」
							CASE 1
								KSTR:(K++) = 湯船の向こうで、観光客たちが今日の観光の話で盛り上がっている。
								KSTR:(K++) = 良秀は黙って聞いていたが、話が一段落したところで口を挟んだ。
								KSTR:(K++) = 「……さっき話していた岬、夕方に行け。
								KSTR:(K++) = 　昼に見るより、ずっといい」
								KSTR:(K++) = 思わぬ助言に、観光客たちは顔を見合わせてから嬉しそうに礼を言った。
						ENDSELECT
					ENDIF
				ELSE
					;体を洗っている
					IF LOCAL
						;誰もいない
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 誰もいない洗い場で、良秀は鼻歌まじりに髪を洗っていた。
								KSTR:(K++) = 「……ふん、ふ、ふん……」
								KSTR:(K++) = 泡を流し終えると、良秀は辺りを確かめてから、桶の湯を頭から豪快にかぶった。
							CASE 1
								KSTR:(K++) = 洗い場には良秀ひとりしかいない。
								KSTR:(K++) = 良秀は石鹸の泡を指ですくい、鏡に何やら描き始めていた。
								KSTR:(K++) = 「……ふむ。泡でも、案外いけるな」
								KSTR:(K++) = 鏡はあっという間に、泡の線で埋め尽くされていった。
						ENDSELECT
					ELSE
						;モブ観光客と会話
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 隣の観光客に「背中、流しましょうか？」と声をかけられ、良秀は少し考えてから背を向けた。
								KSTR:(K++) = 「……頼む。手が届かんところがあってな。
								KSTR:(K++) = 　強めでいい」
								KSTR:(K++) = 背中を擦られながら、良秀は満足げに目を細めていた。
							CASE 1
								KSTR:(K++) = 洗い場で隣り合った観光客が、良秀の洗い方を見て思わず声をかけた。
								KSTR:(K++) = 「……雑？ 汚れが落ちれば、それでいいだろう」
								KSTR:(K++) = 丁寧な洗い方を勧められ、良秀は面倒そうにしながらも、言われたとおりに泡を立て直した。
						ENDSELECT
					ENDIF
				ENDIF
			CASE 13, 14
				;水着に着替えている（海エリアの更衣室も含む）
				IF LOCAL
					;誰もいない
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 更衣室には誰もいない。良秀は水着の紐を結びながら、鏡越しに自分の姿を眺めていた。
							KSTR:(K++) = 「……ふむ。もう少し、色の強いものでもよかったか」
						CASE 1
							KSTR:(K++) = 誰もいない更衣室で、良秀はベンチに腰かけ、懐から煙草を取り出しかけて手を止めた。
							KSTR:(K++) = 「……ここは禁煙か。ちっ」
							KSTR:(K++) = 良秀は名残惜しそうに煙草をしまい、ようやく着替えに取りかかった。
					ENDSELECT
				ELSE
					;モブ観光客と会話
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 着替えを終えた良秀に、観光客の女性が「その水着、素敵ですね」と声をかけてきた。
							KSTR:(K++) = 「……これか？ 適当に選んだんだが。……似合わんか？」
							KSTR:(K++) = 「すっごく似合ってます！」という返事に、良秀は「そうか」とだけ答え、鏡の前でさりげなく角度を変えてみせた。
						CASE 1
							KSTR:(K++) = 隣で着替えていた観光客たちが、どこで泳ぐか相談している。
							KSTR:(K++) = 「……泳ぐなら、人の少ない端だ。
							KSTR:(K++) = 　ぶつかる心配もないし、そこから見る景色もいい」
							KSTR:(K++) = 思わぬ助言に顔を見合わせる観光客をよそに、良秀はさっさと着替えを終えて出ていった。
					ENDSELECT
				ENDIF
		ENDSELECT
		;隠れて覗いた時は、1/3で気配に勘づく
		IF RFLAG:コマンド結果受渡し変数 == 2 && K > 0 && RAND:3 == 0
			KSTR:(K++) = 良秀はふと手を止め、%CALLNAME:PLAYER%が潜む物陰の方へ鋭い視線を向けた。
			KSTR:(K++) = 「……気のせいか」
		ENDIF
	CASE 3
		;野外オナニー（ゆきずりセックス中の文章は、口上_良秀_ゆきずり性交時.ERB の開始に移した）
		;TCVAR:対象キャラ:野外オナニー_部位でどこで自慰しているのかが取れる
		IF IS_野外オナニー中(対象キャラ)
			;弄っている部位の言い回し（0:Ｃ 1:Ｖ 2:Ａ 3:Ｂ）
			SELECTCASE TCVAR:対象キャラ:野外オナニー_部位
				CASE 2
					LOCALS = 尻の窄まり
				CASE 3
					LOCALS = 胸の先
				CASEELSE
					LOCALS = 脚の間
			ENDSELECT
			IF TCVAR:対象キャラ:野外オナニー_絶頂
				;絶頂シーン
				KSTR:(K++) = 「っ……ぁ、あ……っ_H_」
				KSTR:(K++) = 良秀は手の甲に歯を立てて声を殺したが、跳ねる腰までは抑えきれなかった。
				KSTR:(K++) = 息が落ち着くと、乱暴に服を直して煙草に火をつけた。
				KSTR:(K++) = 「……何をやってるんだ、_一人称_は」
			ELSE
				;オナニーシーン
				IF ABL:対象キャラ:(TCVAR:対象キャラ:野外オナニー_部位) > 4
					IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
						;恋慕：好意が自己嫌悪を上回り、歯止めが利かない
						KSTR:(K++) = 良秀は茂みの陰で膝を立て、遠慮なく%LOCALS%を弄んでいた。
						KSTR:(K++) = 「はっ……ぁ、……あいつの、手なら……っ_H_ くそ、もっと……_H_」
						KSTR:(K++) = 誰を思い浮かべているのか、自分でも気づいていないらしい。指の動きは、むしろ速くなっていく。
					ELSE
						KSTR:(K++) = 良秀は茂みの陰で膝を立て、手慣れた指つきで%LOCALS%を弄んでいた。
						KSTR:(K++) = 「はっ……ぁ、……くそ、いい……」
						KSTR:(K++) = 腰が勝手に浮くたび、苛立たしげに眉を寄せる。それでも、手を止める気配はない。
					ENDIF
				ELSEIF ABL:対象キャラ:(TCVAR:対象キャラ:野外オナニー_部位) > 2
					KSTR:(K++) = 良秀は木の幹に背を預け、%LOCALS%に指を這わせていた。
					KSTR:(K++) = 「ん……今日は、少し強くする、か……」
					KSTR:(K++) = 噛み締めた唇の端から、熱い息が漏れる。物音に一度だけ目を上げたが、指は止まらなかった。
				ELSE
					KSTR:(K++) = 良秀は木陰に腰を下ろし、無駄のない手つきで%LOCALS%を探っていた。
					KSTR:(K++) = 「……ちっ。まさかこんな行為が……ぅっ_H_」
					KSTR:(K++) = 漏れた声に、良秀は自分で顔をしかめた。それでも指は離れない。
				ENDIF
			ENDIF
		ENDIF
	CASE 4
		;温泉施設の覗き用場所で
		SELECTCASE CFLAG:対象キャラ:現在位置
			CASE 702, 802
				; 服を脱いでいる様子が見える…
				KSTR:(K++) = 良秀は籠に置いた荷物の位置を直し、片方に寄った履物を揃えた。刀だけは手の届く場所から離さない。
			CASE 703, 803
				; 石鹸で体を洗っている様子が見える…
				KSTR:(K++) = 良秀は桶を傾け、泡を流した。「……この匂い、残りすぎるな」石鹸を眺める目だけは、ひどく険しい。
			CASE 704, 804
				; 裸で湯船に浸かっている様子が見える…
				KSTR:(K++) = 「悪くない。……あと少しだな」良秀は湯の揺らぎを眺め、急いで上がる気配を見せなかった。
			CASE 705, 805
				; 裸で変わり湯に浸かっている様子が見える…
				KSTR:(K++) = 「今日はこれか。……匂いは悪くない」良秀は湯気を少し吸い込み、今度は黙って湯面を眺めた。
			CASE 706, 806
				; サウナで汗を流している様子が見える…
				KSTR:(K++) = 「熱いな。……じっとしてるだけで、こうも違うか」良秀は一度目を閉じ、落ち着いて呼吸を整えた。
			CASE 707, 807
				; 裸で露天風呂に浸かっている様子が見える…
				KSTR:(K++) = 「あの枝、一本落とせば収まりがいい」良秀は景色を眺めて呟いた。湯気の向こうで、枝先が風に揺れている。
			CASE 708, 808
				; 裸で壺湯に浸かっている様子が見える…
				KSTR:(K++) = 「一人分か。なるほどな」良秀は壺の縁を指で軽く叩いた。誰にも詰めろと言われない広さは、気に入ったらしい。
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM405 観察する
;--------------------------------------------------
@KOJO_COM_1384_405(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		;誰も隠密してない
		KSTR:(K++) = 「観察か？ だったら、先に何を見るのか決めておけ。ただ眺めてるだけじゃ、目の前のものまで見落とすぞ」
	CASE 1
		;誰かが隠密している
		KSTR:(K++) = 「何だ、顔に煤でもついてるのか？ 違うなら、そんな遠慮した目をするな。聞きたいことがあれば聞けよ」
		;正直0と1はキャラの観察結果としては分けなくていいかも
	CASE 10
		;起床までの残り時間
		;寝言とか言う感じかな？
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS > 180
				;3時間以上
				KSTR:(K++) = 良秀は眠ったまま、緩やかな呼吸を繰り返している。眉間の皺も消え、まだ起きる気配はない。
			CASE IS > 90
				;3時間以下
				KSTR:(K++) = 良秀は枕に頬を寄せて寝返りを打った。「……その線は、違う……」小さな寝言のあと、また静かな寝息に戻った。
			CASE IS > 30
				;90分以下
				KSTR:(K++) = 良秀の瞼がかすかに動いた。起きかけたように見えたが、肩の力が抜けると、そのまま眠り直した。
			CASEELSE
				;30分以下
				KSTR:(K++) = 良秀は一度眉を寄せ、枕の位置を直した。「……まだ早い……」眠たげな独り言のあと、浅い寝息が続いた。
		ENDSELECT
	CASE 11
		;睡眠＋ダウン、スコアの多さで分岐
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS >= 400
				;めちゃくちゃにされてる
				KSTR:(K++) = 良秀はぐったりと眠り込んでいる。物音にも反応せず、疲れ切った顔に時折、眉間の皺だけが浮かんだ。
			CASE IS >= 20
				;結構がっつり
				KSTR:(K++) = 良秀の呼吸は落ち着いているが、目元には疲れが濃く残っている。身じろぎすることもなく、深く眠っていた。
			CASEELSE
				;体力付きたけど割と穏やか、あんまり来ないかも
				KSTR:(K++) = 良秀は肩の力を抜いて眠っている。普段の険しい顔つきが薄れ、呼吸もゆっくりと穏やかだった。
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM414 写真を撮る
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数３ 写真のシチュエーション
@KOJO_COM_1384_414(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE 1
		;寝てる、相手は気づいてない
	CASE 2
		;ハメ撮り、相手は気づいている
		IF TCVAR:対象キャラ:前ターン絶頂
			;絶頂直後
			KSTR:(K++) = 「……少し待て、息を整える。撮ったものは、あとで_一人称_にも見せろよ。消せと言ったら、_一人称_の前で消せ」
		ELSE
			KSTR:(K++) = 「撮ったなら、_一人称_にも見せろ。残すかどうかは_一人称_が決める。ふっ、まさか裸婦のモチーフになるとはな」
		ENDIF
	CASE 3
		;覗き、相手は気づいてない
		;覗きの口上に飛ばしていいんじゃね？ と思うので飛ばす
		TRYCALLFORM KOJO_COM_{NO:対象キャラ}_404(対象キャラ)
		RETURN 0
	CASE 4
		;仕事中、相手は気づいている
		SELECTCASE 現在仕事:対象キャラ:0
			CASE 1
				;雑務
				KSTR:(K++) = 「手を動かしてるところが欲しいのか？ なら、そこから撮れ。片付いた後より、今の方が何をしてたか分かるだろうよ」
			CASE 2
				;常駐業務
				;今仕事場にいるかで分岐
				IF GETPLACENAME(CFLAG:対象キャラ:現在マップ種別, CFLAG:対象キャラ:現在位置) == 常駐業務_場所名取得(現在仕事:対象キャラ:1)
					KSTR:(K++) = 「仕事中の_一人称_を撮るなら、手元も入れろ。顔だけ撮っても、ここで何をしてるのか伝わらんだろう」
				ELSE
					KSTR:(K++) = 「ここで撮っても、仕事の様子にはならんぞ。……_一人称_個人を撮りたいならそう言えよ。戻るまでなら、付き合ってやる」
				ENDIF
			CASE 3
				;秘書
				KSTR:(K++) = 「撮るなら、机の上の書類は避けろ。_二人称_のために纏めた話を、写真一枚で余所にばら撒かれては敵わん」
			CASE 4
				;宣伝
				KSTR:(K++) = 「宣伝に使うなら、目を引く一枚にしろ。……この角度はどうだ？」良秀は立ち位置を変え、%CALLNAME:PLAYER%の返事を待っている。
			CASE 5
				;訓練
				;今仕事場にいるかで分岐
				IF CFLAG:対象キャラ:現在マップ種別 == 0 && CFLAG:対象キャラ:現在位置 == 308
					KSTR:(K++) = 「撮るなら、今からだ。途中で目を逸らすなよ。……_二人称_の腕で、_一人称_の剣をフィルムに収められるか試してみろ」
				ELSE
					KSTR:(K++) = 「まだ始めてないぞ、訓練の記録には使えん。……折角なら見せてやる、上手くやれるんだろうな」
				ENDIF
		ENDSELECT
	CASE 5
		;日常のスナップショット、相手は気づいている
		KSTR:(K++) = 「今の_一人称_を撮りたいのか？ いいぞ、撮ったら見せろよ。……次は_二人称_も入れ、一人だけじゃ面白くない」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


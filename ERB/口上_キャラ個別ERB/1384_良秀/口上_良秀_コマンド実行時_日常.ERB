		ENDSELECT
	ENDIF
ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
	;セフレ専用は80％。抽選に外れた場合は下の汎用口上へ。
	IF RFLAG:コマンド結果受渡し変数
		; 既に同行中。手を繋ぐ。
		KSTR:(K++) = 「昼間から手か。……ふん、夜の方がよっぽど大胆なくせに」
	ELSE
		; 新しく連れ出す。
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「連れ出す、ね。行き先が寝床じゃないなら、付き合ってやる」
			CASE 1
				KSTR:(K++) = 「外を歩くのか。たまにはいいか。
				KSTR:(K++) = 　ただし、途中で帰りたくなっても文句は言うなよ」
		ENDSELECT
	ENDIF
ENDIF

IF K == 0
	IF RFLAG:コマンド結果受渡し変数
		; 既に同行中。実際の相手に恋慕がない。
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「手か。ほら。引っ張るなよ、歩く速さくらい合わせてやる」
			CASE 1
				; 行き先を確認し、握ったまま返事を待つ。
				KSTR:(K++) = 「どこまで引っ張る気だ。行き先くらいは言え」
				KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の手を握ったまま、返答を待った。
				KSTR:(K++) = 「……分かった。曲がる前に言えよ」
		ENDSELECT
	ELSE
		; 新たに同行を始める。失敗・拒否の分岐ではない。
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「行くか。途中で面白いものを見つけたら、少し止まるぞ。_二人称_も見たいだろう？」

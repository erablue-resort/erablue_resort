;--------------------------------------------------
;COM305_雑務をこなす
;--------------------------------------------------
;雑務ゲージ:(CFLAG:PLAYER:現在位置)で雑務をこなした後の雑務ゲージの残りが取得可能

@KOJO_COM_1384_305(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	IF RAND:5
		; 恋慕。80％の状況入口に入ったら、残量に合う口上を選ぶ。
		IF 雑務ゲージ:(CFLAG:PLAYER:現在位置) == 0
			; 現在地の雑務終了後。自分の相手をさせる。
			KSTR:(K++) = 「終わったか。なら、今度は_一人称_の相手をしろ」
			KSTR:(K++) = 良秀は%CALLNAME:PLAYER%が手を止めるのを待って、そばへ歩み寄った。
			KSTR:(K++) = 「今日はほかに何をしてた。……急がなくていい。_一人称_も、今は暇だ」
		ELSEIF 雑務ゲージ:(CFLAG:PLAYER:現在位置) > 0
			; 現在地に雑務が残っている。視線でからかうだけで手伝わない。
			KSTR:(K++) = 「まだ残ってるのか。_二人称_、さっきから_一人称_の方ばかり見ているな」
			KSTR:(K++) = 良秀は%CALLNAME:PLAYER%と目が合うと、わざと視線を逸らさずにいた。
			KSTR:(K++) = 「気が散るか？ _一人称_は退屈してないぞ。ほら、手を動かせ」
		ENDIF
	ENDIF
	IF K == 0
		; 良秀は作業に加わらず、見ている。
		; 雑・片・暇＝雑務を片付けて暇を作る。
		KSTR:(K++) = 「雑・片・暇。さっさと片付けろ。
		KSTR:(K++) = 　空いた時間は、_一人称_がもらう」
	ENDIF
ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
	;セフレ時の口上をここへ追記する。

ELSEIF RAND:5
	IF CFLAG:PLAYER:現在マップ種別 == CFLAG:対象キャラ:現在マップ種別 && CFLAG:PLAYER:現在位置 == CFLAG:対象キャラ:現在位置
		;同じ場所のロケーション・状況口上をここへ追記する。
	ENDIF
ENDIF

IF K == 0
	SELECTCASE RAND:4
		CASE 0
			KSTR:(K++) = 「雑・片・暇。……雑務を片付けて暇を作る。_二人称_が働くのを見てるだけでも、手際の良し悪しはよく分かる」
		CASE 1
			; 教わった手順と本人の癖に関心を示す。
			KSTR:(K++) = 「そのやり方、誰かに教わったのか？」
			KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の説明を聞きながら、それまで眺めていた手順を思い返した。
			KSTR:(K++) = 「……そうか。雑務でも、_二人称_の癖は出るものだな」
		CASE 2
			KSTR:(K++) = 良秀は%CALLNAME:PLAYER%が働く様子を眺めながら、ふと思いついた話を口にした。
			KSTR:(K++) = 「金の斧、銀の斧。_一人称_は、あの話の川底を見てみたい。
			KSTR:(K++) = 　斧ばかり何本も出てくるなら、他にも何か沈んでいるだろう」
		CASE 3
			KSTR:(K++) = 「嫌いな仕事でも、やり方が分かれば面白くなることはあるか？
			KSTR:(K++) = 　_一人称_は逆もある。うまくやれると分かった途端、飽きる」
			KSTR:(K++) = 良秀は%CALLNAME:PLAYER%が働く様子を眺めたまま、返答を待っている。
	ENDSELECT
ENDIF
CALL 口上変数表示(対象キャラ, 0)


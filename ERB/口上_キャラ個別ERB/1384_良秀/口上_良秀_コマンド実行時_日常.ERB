;--------------------------------------------------
;良秀（1384）用の日常口上。
;日常口上53関数とゆきずり相手判定関数、恋慕相手判定関数を有効化している。
;未設定の特殊贈物はコメントのまま保管する。
;未対応の遊び分岐は本文を追加せず、既存の汎用メッセージへの振り分けを維持する。
;固有コマンドと水鉄砲は、本体側が未実装のため口上関数のみ登録する。
;--------------------------------------------------

;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;キャラクター番号は1384に設定済み。コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
	;-2の場合は会話出来なかった扱いなので何も言わないのがいいかも
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_1384_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;関係性を先に分け、場所はSELECTCASE 口上_場所判定_1384()で分ける（場所の一覧は関数のコメント参照）。
;未出力なら直後のIF K == 0で通常会話へ。
;恋慕とセフレをまとめて「陥落後」とは判定しない。両方あれば恋慕を優先。
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	;恋慕あり
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2, -1
			;話題切れ・失敗は専用本文を追加せず、末尾の既存汎用口上へ。
		CASE 0
			;通常成功：場所会話を80％で選び、外れたら下の恋慕・通常会話へ。
			;別の場所にいる時や、未対応の場所では""が返るので、どのCASEにも当たらない。
			IF RAND:5
				SELECTCASE 口上_場所判定_1384(対象キャラ)
					CASE "ロビー受付"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「受付ってのは、来た奴の顔を覚える仕事らしい。
								KSTR:(K++) = 　_一人称_は顔より先に服の色を覚える。さっきの客は『緑の上着』だ」
							CASE 1
								KSTR:(K++) = 「_二人称_、暇ならそこに立ってろ。
								KSTR:(K++) = 　客が来たら、_一人称_の代わりに愛想を振りまく係だ」
								KSTR:(K++) = 良秀はそう言って、受付台の横を顎でしゃくった。
						ENDSELECT
					CASE "ロビー"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「ロビーの花、また替わったな。色の合わせ方が下手だ。
								KSTR:(K++) = 　……_二人称_が選んだのか？ そうか。なら次は_一人称_が選んでやる」
							CASE 1
								KSTR:(K++) = 良秀はロビーのソファに深く腰掛け、%CALLNAME:PLAYER%の分の場所を空けた。
								KSTR:(K++) = 「座れ。人の出入りを眺めながら、_二人称_の話を聞くのも悪くない」
						ENDSELECT
					CASE "調理師"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 良秀は妙に色鮮やかな料理を盛った小皿を、%CALLNAME:PLAYER%の口元に突き出した。
								KSTR:(K++) = 「味見しろ。見た目は完璧だ。……味は、_二人称_の顔を見て決める」
							CASE 1
								KSTR:(K++) = 「ウインナーに切れ込みを入れたら、面白い形になった。何に見える？
								KSTR:(K++) = 　……違う、タコだ。足が八本あるだろう。よく見ろ」
						ENDSELECT
					CASE "給仕"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「皿ってのは、どうしてこう持ちにくい形をしてるんだ。
								KSTR:(K++) = 　……さっき一枚割った。黙っておけ」
							CASE 1
								KSTR:(K++) = 「_二人称_の席はそこだ。注文は_一人称_に言え。
								KSTR:(K++) = 　他の奴に頼んだら、運ばずに_一人称_が食う」
						ENDSELECT
					CASE "食堂"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「_二人称_、それ食わないなら寄越せ」
								KSTR:(K++) = 良秀は返事を待たずに、%CALLNAME:PLAYER%の皿からひょいとおかずをつまんだ。
								KSTR:(K++) = 「何だその顔は。_一人称_のも一口やるから、それで手を打て」
							CASE 1
								KSTR:(K++) = 「一緒に食う飯は、一人で食うより味がする。
								KSTR:(K++) = 　……妙な話だが、_二人称_といるとそう思う」
						ENDSELECT
					CASE "プール監視員"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「監視ってのは退屈だな。
								KSTR:(K++) = 　_二人称_、溺れたふりでもしてみろ。すぐに引き上げてやる」
							CASE 1
								KSTR:(K++) = 「水面の光、見てみろ。描こうとすると、すぐに形を変える。
								KSTR:(K++) = 　仕事中じゃなければ、ずっと眺めてるんだがな」
						ENDSELECT
					CASE "プール"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「_二人称_、日焼け止めを塗れ。
								KSTR:(K++) = 　背中は手が届かん。手伝え」
							CASE 1
								KSTR:(K++) = 「泳ぐのは嫌いじゃないが、水の中じゃ煙草が吸えん。
								KSTR:(K++) = 　だから_二人称_が話し相手になれ」
						ENDSELECT
					CASE "海水浴場"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「海の色は一日で何度も変わる。朝と夕方じゃ別物だ。
								KSTR:(K++) = 　_二人称_はどっちが好きだ？」
								KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の答えを聞くと、少しだけ口元を緩めた。
							CASE 1
								KSTR:(K++) = 良秀は砂浜にしゃがみ込み、指で何かを描き始めた。
								KSTR:(K++) = 「……_二人称_の顔だ。波が来る前に、よく見ておけ」
						ENDSELECT
					CASE "船着き場"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「_二人称_とどこか遠くへ行くなら、船がいい。
								KSTR:(K++) = 　バスより揺れるが、窓の外は飽きなさそうだ」
							CASE 1
								KSTR:(K++) = 「どこかへ行く時は、_一人称_も連れて行け。
								KSTR:(K++) = 　置いていかれるのは性に合わん」
						ENDSELECT
					CASE "バーテンダー"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「酒は色で作る。味は二の次だ。
								KSTR:(K++) = 　……客にはよく文句を言われる。_二人称_は飲めるな？」
							CASE 1
								KSTR:(K++) = 「_二人称_には強いのを作ってやる。
								KSTR:(K++) = 　潰れたら、部屋まで引きずっていってやるから安心しろ」
						ENDSELECT
					CASE "ディーラー"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「カードを配るのは得意だ。指先には自信がある。
								KSTR:(K++) = 　……チップの計算は別だ。_二人称_、これはいくらになる」
							CASE 1
								KSTR:(K++) = 「賭けるなら_一人称_の台にしろ。
								KSTR:(K++) = 　勝ったら祝ってやる。負けたら慰めてやる。どっちに転んでも損はない」
						ENDSELECT
					CASE "バーエリア"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「ここの酒は悪くない。_二人称_も一杯付き合え。
								KSTR:(K++) = 　一杯で済むと思うなよ」
							CASE 1
								KSTR:(K++) = 「カジノの照明はやかましいな。
								KSTR:(K++) = 　_二人称_の顔だけ見ていれば、目が疲れずに済む」
						ENDSELECT
					CASE "温泉浴場"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「湯気で輪郭がぼやけるのは悪くない。
								KSTR:(K++) = 　_二人称_、もう少しこっちに来い。遠いと見えん」
							CASE 1
								KSTR:(K++) = 「ふぅ……。たまには、こういうのも悪くない」
								KSTR:(K++) = 良秀は湯船の縁に頭を預け、目を閉じたまま%CALLNAME:PLAYER%の話に耳を傾けている。
						ENDSELECT
					CASE "温泉洗い場"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「背中を流せ。代わりに、_二人称_のも流してやる」
							CASE 1
								KSTR:(K++) = 「_一人称_の髪は長いから、洗うのが面倒だ。
								KSTR:(K++) = 　_二人称_が洗え。丁寧にな」
						ENDSELECT
					CASE "温泉脱衣所"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「何を今さら目を逸らしてる。くく、見たいなら見ればいい」
							CASE 1
								KSTR:(K++) = 「浴衣の帯の結び方が分からん。
								KSTR:(K++) = 　_二人称_、結べ。緩すぎず、きつすぎずだ」
						ENDSELECT
					CASE "女子更衣室"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「水着ってのは動きやすいが、どうも落ち着かん。
								KSTR:(K++) = 　刀を提げる場所がない」
							CASE 1
								KSTR:(K++) = 「この水着、色はどうだ。
								KSTR:(K++) = 　_二人称_の目で見てどうかと聞いてるんだ。ちゃんと答えろ」
						ENDSELECT
					CASE "サウナ"
						SELECTCASE RAND:2
							CASE 0
								; か・す・ぬ・し＝体中の水分が抜けて死にそうだ
								KSTR:(K++) = 「暑い……。か・す・ぬ・し」
								KSTR:(K++) = 良秀は汗を拭いながらも、%CALLNAME:PLAYER%より先に出る気はないらしい。
							CASE 1
								KSTR:(K++) = 「我慢比べか？ いいだろう。
								KSTR:(K++) = 　先に出た方が、今日の煙草代を持て」
						ENDSELECT
					CASE "キャンプファイアー"
						;火はモチーフとしても奥が深い、という話
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 良秀は炎の揺らぎから目を離さずに、膝の上で指を動かしている。
								KSTR:(K++) = 「火は、描こうとすると逃げる。形がないくせに、一瞬ごとに違う顔をする。
								KSTR:(K++) = 　……_二人称_の顔も、火の前だと少し違って見えるな」
							CASE 1
								KSTR:(K++) = 「燃えるものは、燃え尽きる直前が一番いい色をする。
								KSTR:(K++) = 　……薪の話だ。_二人称_、もう一本くべろ」
						ENDSELECT
					CASE "知識習得"
						;知識習得で学校に滞在中
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「勉強なんぞ柄じゃないが、知らないことを知るのは悪くない。
								KSTR:(K++) = 　_二人称_、この字は何て読む。笑うなよ」
							CASE 1
								KSTR:(K++) = 「都市じゃ、こんな風に机を並べて学ぶことなんてなかった。
								KSTR:(K++) = 　_二人称_が隣に座ってると、妙に落ち着かんな」
						ENDSELECT
					CASE "教師"
						;教師として学校で勤務中
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「_一人称_が教えられるのは、絵と……まあ、絵くらいだな」
							CASE 1
								KSTR:(K++) = 「ガキどもに線の引き方を教えてやった。どいつも下手くそだ。
								KSTR:(K++) = 　だが一人、迷いのない線を引く奴がいた。……悪くない」
						ENDSELECT
					CASE "司書"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「本を背表紙の色で並べ直したら、怒られた。分類の方が大事らしい。
								KSTR:(K++) = 　_一人称_には分からん感覚だ」
							CASE 1
								KSTR:(K++) = 「静かにしろ、と言うのが仕事らしい。
								KSTR:(K++) = 　_二人称_にだけは言わんでおいてやる」
						ENDSELECT
					CASE "図書室"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「画集はないのか、ここは。……あった。
								KSTR:(K++) = 　_二人称_、一緒に見ろ。解説は_一人称_がしてやる」
							CASE 1
								KSTR:(K++) = 「字ばかりの本は眠くなる。
								KSTR:(K++) = 　_二人称_が読んで聞かせろ。声は嫌いじゃない」
						ENDSELECT
					CASE "美術館"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 良秀は一枚の絵の前で足を止め、%CALLNAME:PLAYER%の袖を引いた。
								KSTR:(K++) = 「この筆の運び、見えるか？ ここで一度迷ってる。
								KSTR:(K++) = 　迷いを消さずに残してるのがいい。_二人称_にも分かるか？」
							CASE 1
								KSTR:(K++) = 「いつか、_一人称_の絵もここに飾らせろ。
								KSTR:(K++) = 　一番いい場所だ。_二人称_が毎日見に来られるようにな」
						ENDSELECT
					CASE "お祭り"
						;お祭りの特設会場（お花見・夏祭り・歳旦祭）。CASE 3は祭りごとに分ける
						SELECTCASE RAND:5
							CASE 0
								KSTR:(K++) = 「人が多すぎる。はぐれるなよ。……ほら、袖でも掴んでろ」
								KSTR:(K++) = 良秀はそっぽを向いたまま、%CALLNAME:PLAYER%の方へ腕を突き出した。
							CASE 1
								KSTR:(K++) = 「出店の飯ってのは、どうしてこう味が濃いんだ。
								KSTR:(K++) = 　_二人称_、それ一口寄越せ。_一人称_のもやる」
							CASE 2
								KSTR:(K++) = 「提灯の灯りは悪くない。人の顔が、少しずつ赤く見える。
								KSTR:(K++) = 　_二人称_の顔も、な」
							CASE 3
								SELECTCASE 開催予定祭り名
									CASE "FESTIVAL_お花見"
										KSTR:(K++) = 「桜は、散る時の方が描き甲斐がある。
										KSTR:(K++) = 　……散りきる前に、もう一度来るぞ。_二人称_も一緒にな」
									CASE "FESTIVAL_夏祭り"
										KSTR:(K++) = 「夏の夜は好きだ。暑さで頭がぼやけて、灯りの色がよく滲む。
										KSTR:(K++) = 　_二人称_、何か冷たいものを買ってこい」
									CASE "FESTIVAL_歳旦祭"
										KSTR:(K++) = 「都市にいた頃は、年が変わったことにも気づかなかった。
										KSTR:(K++) = 　……今年は、_二人称_の隣で数えてやる」
									CASEELSE
										KSTR:(K++) = 「祭りってのは、どこも騒がしいな。……嫌いじゃない」
								ENDSELECT
							CASE 4
								KSTR:(K++) = 「出店の遊びってのは、どうも性に合わん。的に一つも当たらなかった。
								KSTR:(K++) = 　……笑うな。_二人称_もやってみろ」
						ENDSELECT
					CASE "警備員"
						;警備員として勤務中（上のどの場所にもいない時）
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「見回りも悪くない。夜の廊下は、昼とはまるで別の絵になる」
							CASE 1
								KSTR:(K++) = 「怪しい奴はいないか、だと？
								KSTR:(K++) = 　……目の前に一人いるな。_二人称_、どこへ行く気だった」
						ENDSELECT
					CASE "訓練"
						;訓練中（上のどの場所にもいない時）
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「腕が鈍るのは気に入らん。_二人称_も付き合え。
								KSTR:(K++) = 　鞘のままでも、当たれば痛いぞ」
							CASE 1
								KSTR:(K++) = 「型をなぞるだけの稽古は退屈だ。
								KSTR:(K++) = 　_二人称_が相手なら、少しは楽しめそうだがな」
						ENDSELECT
				ENDSELECT
			ENDIF
			
			IF K == 0
			;恋慕・通常会話。場所抽選外、未対応の場所、別の場所にいる場合。
				SELECTCASE RAND:8
					CASE 0
						KSTR:(K++) = 「……聞いているから焦るな。考えながら喋っても構わん。_二人称_の話なら、そのくらいは待つ」
						KSTR:(K++) = 良秀は%CALLNAME:PLAYER%が言葉を選ぶ間も、話の続きを待っている。
					CASE 1
						KSTR:(K++) = 「_二人称_は、気に入ったものを最後まで取っておく方か？ 食い物の話だ」
						KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の返答をじっと聞いている。
						KSTR:(K++) = 「そうか。_一人称_は先に食う。残しておいてなくなったら、腹が立つからな。
						KSTR:(K++) = 　_一人称_に食事を取り分ける時は憶えておけ」
					CASE 2
						KSTR:(K++) = 「_二人称_、今日はどこへ行った。……いや、別に。聞いただけだ」
					CASE 3
						KSTR:(K++) = 「少し描いてもいいか。動くな。喋る分には構わん」
						KSTR:(K++) = 良秀は話を聞きながら、指で宙に%CALLNAME:PLAYER%の輪郭をなぞっている。
					CASE 4
						KSTR:(K++) = 「ツレってのは、こういう下らん話をする相手のことを言うんだろう。
						KSTR:(K++) = 　……違うか？ なら、そういうことにしておけ」
					CASE 5
						KSTR:(K++) = 「バスの連中に、_二人称_のことを話してやりたいな。
						KSTR:(K++) = 　……いや、やめておく。面倒なことになりそうだ」
					CASE 6
						KSTR:(K++) = 「_一人称_の話は短い。だから_二人称_が長く話せ。
						KSTR:(K++) = 　それで釣り合いが取れる」
					CASE 7
						KSTR:(K++) = 良秀は何も言わずに、%CALLNAME:PLAYER%の肩にもたれかかった。
						KSTR:(K++) = 「……続けろ。聞いてる」
				ENDSELECT
			ENDIF
	ENDSELECT
ELSE
	;恋慕なし。セフレ・その他の陥落・未陥落を含む。
	IF RFLAG:コマンド結果受渡し変数 == 0
		;セフレ専用は通常成功時に80％。当選したら後の場所会話は出さない。
		IF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
			SELECTCASE RAND:5
				CASE 0
					KSTR:(K++) = 「話すより、身体を動かす方が早いと思うがな。
					KSTR:(K++) = 　まあいい。今は聞いてやる」
				CASE 1
					KSTR:(K++) = 「昨日のこと、覚えてるか？ くく、顔に出てるぞ」
				CASE 2
					KSTR:(K++) = 「_二人称_とは、話すより別のことをしてる時間の方が長いな。
					KSTR:(K++) = 　たまにはこういうのも悪くない」
				CASE 3
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の話を聞き流しながら、その首筋をじっと眺めている。
					KSTR:(K++) = 「……ん？ ああ、聞いてる。続けろ」
				CASE 4
					KSTR:(K++) = 「くだらん話でいい。夜まで、退屈しのぎだ」
			ENDSELECT
		ENDIF
		
		;通常成功：場所会話を80％で選択。セフレ専用に外れた枠も同じ抽選。
		;恋慕なしでは勤務中かどうかを分けないので、仕事名も場所と同じCASEにまとめる。
		IF K == 0 && RAND:5
			SELECTCASE 口上_場所判定_1384(対象キャラ)
				CASE "ロビー", "ロビー受付"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「ここは人の出入りが多いな。
							KSTR:(K++) = 　荷物の持ち方ひとつで、どこから来た奴か大体分かる」
						CASE 1
							KSTR:(K++) = 「受付の後ろの絵、誰が選んだ？ 額縁の方が高そうだな」
					ENDSELECT
				CASE "食堂", "調理師", "給仕"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「ここの飯は悪くない。
							KSTR:(K++) = 　都市の飯に比べれば、大抵のものは美味いがな」
						CASE 1
							KSTR:(K++) = 「食いながら喋るな。いや、_一人称_もか。なら構わん」
					ENDSELECT
				CASE "プール", "プール監視員"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「水の中じゃ煙草が吸えん。それだけが難点だ」
						CASE 1
							KSTR:(K++) = 「プールの底の模様、誰が描いた？
							KSTR:(K++) = 　水越しに見ると、悪くない揺れ方をする」
					ENDSELECT
				CASE "海水浴場"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「砂浜に絵を描いても、波がすぐ消していく。
							KSTR:(K++) = 　それはそれで、悪くない」
						CASE 1
							KSTR:(K++) = 「潮の匂いは嫌いじゃない。煙草の味が少し変わる」
					ENDSELECT
				CASE "船着き場"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「どこから来た船だ？ 積み荷の色がいい」
						CASE 1
							KSTR:(K++) = 「船を見ると、あのバスを思い出す。揺れ方はだいぶ違うがな」
					ENDSELECT
				CASE "キャンプファイアー"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「赤だけじゃない。根元は青いし、芯は白い。
							KSTR:(K++) = 　火ってのは、見れば見るほど奥が深いモチーフだ」
						CASE 1
							KSTR:(K++) = 「火を描くのは難しい。色を重ねるほど、熱が逃げていく。
							KSTR:(K++) = 　だから面白い。何度でも描きたくなる」
					ENDSELECT
				CASE "お祭り"
					;お祭りの特設会場。CASE 3は祭りごとに分ける
					SELECTCASE RAND:5
						CASE 0
							KSTR:(K++) = 「祭りか。騒がしいが、色だけは悪くない」
						CASE 1
							KSTR:(K++) = 「人混みは嫌いだ。だが、群衆は描くと面白い。
							KSTR:(K++) = 　誰一人として同じ顔をしてない」
						CASE 2
							KSTR:(K++) = 「出店の飯は味が濃すぎる。……もう一本買ってくるか」
						CASE 3
							SELECTCASE 開催予定祭り名
								CASE "FESTIVAL_お花見"
									KSTR:(K++) = 「桜の色は、思ったより白い。
									KSTR:(K++) = 　皆、頭の中で勝手に赤くしてるんだ」
								CASE "FESTIVAL_夏祭り"
									KSTR:(K++) = 「浴衣ってのは動きにくいな。帯がきつい。
									KSTR:(K++) = 　これでどうやって走るんだ」
								CASE "FESTIVAL_歳旦祭"
									KSTR:(K++) = 「年が変わっただけで、ここまで騒げるのか。
									KSTR:(K++) = 　都市の連中に見せてやりたいな」
								CASEELSE
									KSTR:(K++) = 「祭りってのは、どこも騒がしいな」
							ENDSELECT
						CASE 4
							KSTR:(K++) = 「くじ引きを五回引いた。全部外れだ。
							KSTR:(K++) = 　……あの箱、本当に当たりが入ってるのか？」
					ENDSELECT
				CASE "美術館"
					;ハル子にはない、良秀用の追加
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「ここの展示はまだ少ないな。
							KSTR:(K++) = 　_一人称_の絵を置いてやってもいいぞ」
						CASE 1
							KSTR:(K++) = 「この絵、悪くない。_二人称_、分かるか？
							KSTR:(K++) = 　分からんなら、分かるまで見てろ」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

IF K == 0
	;専用口上がない結果・関係では既存の結果分岐を使う。
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……話は尽きた。茶でも飲んで、一度その口を休めろ」
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の顔を見て、少し呆れたように言った。
				CASE 1
					KSTR:(K++) = 「なんだ？ 話が分かるな。くく、興が乗って来た。いいか、短縮の美学ってのは……
					KSTR:(K++) = 　―――くどくど―――滔々――――」
					KSTR:(K++) = どうやらこの話題は長くなりそうだ……
			ENDSELECT
		CASE -1
			;失敗
			SELECTCASE RAND:3
				CASE 0
					; 前・長＝前置きが長い
					KSTR:(K++) = 「前・長。_二人称_が何を言いたいのか、そこから話せ」
				CASE 1
					KSTR:(K++) = 良秀に学生時代の思い出を聞いてみると、彼女の目つきが鋭くなった。どうやら話題選びを間違えたようだ……
				CASE 2
					KSTR:(K++) = 「…………ふぅ」
					KSTR:(K++) = 良秀は黙って次の煙草に火をつけた。もう少し興味を引けそうな話題がよさそうだ。
			ENDSELECT
		CASE 0
			;通常成功
			SELECTCASE RAND:7
				CASE 0
					KSTR:(K++) = 「で、その後はどうした。肝心なところで話を切るな」
				CASE 1
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%が話す人物の顔を思い浮かべ、口を挟んだ。
					KSTR:(K++) = 「そいつは、その顔で大真面目に言ったのか？
					KSTR:(K++) = 　……ふっ。_二人称_の説明より、そいつの顔を見たかったな」
				CASE 2
					KSTR:(K++) = 「_二人称_は、道に迷ったらすぐ引き返す方か？
					KSTR:(K++) = 　_一人称_はもう少し先を見る。戻る道ばかり探していたら、迷った甲斐がないだろう」
				CASE 3
					KSTR:(K++) = 「ふん、それで？ 続けろ。
					KSTR:(K++) = 　煙草一本分くらいは聞いてやる」
				CASE 4
					KSTR:(K++) = 「都市じゃ、そういう話は大抵ろくな結末にならん。
					KSTR:(K++) = 　……ここは平和だな」
				CASE 5
					KSTR:(K++) = 「_二人称_は、何色が好きだ？ ふぅん。
					KSTR:(K++) = 　理由まで言え。そこが一番面白いところだ」
				CASE 6
					KSTR:(K++) = 「その話、絵にするならどこを切り取る？
					KSTR:(K++) = 　_一人称_なら、一番間抜けな瞬間を選ぶ」
			ENDSELECT
		CASEELSE
			;大成功
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ふっ、そいつはいい。……なんだ？ 早く続きを聞かせろ」
				CASE 1
					KSTR:(K++) = 「ふぅん。そんな面白い状況、なんで誘ってくれなかった？
					KSTR:(K++) = 　_一人称_がその場にいればもっと面白いことになっただろうな」
					KSTR:(K++) = 良秀は口元に笑みを残したまま、%CALLNAME:PLAYER%に続きを促した。
				CASE 2
					KSTR:(K++) = 「結末はまだ言うな。_一人称_が当てる」
					KSTR:(K++) = 良秀は思いついた結末を口にし、%CALLNAME:PLAYER%の返答を待った。
					KSTR:(K++) = 「……違うのか。なら、最後まで聞こう。
					KSTR:(K++) = 　外したままでは気が済まん」
			ENDSELECT
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM301_お茶を淹れる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;その場にいる全員が対象だが、口上は対面している相手のみ

@KOJO_COM_1384_301(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;関係性を先に分け、場所はSELECTCASE 口上_場所判定_1384()で分ける。未出力なら末尾のIF K == 0で汎用口上へ。
;お茶は浴場（内風呂・露天風呂・洗い場・温泉のサウナなど）では実行できないので、温泉浴場・温泉洗い場・サウナは分岐に入れない。
;恋慕の相手と非恋慕の相手を分ける。両方の関係があれば恋慕を優先。
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE 0
			;恋慕・通常成功：場所の口上を80％で選び、外れたら下の恋慕・通常口上へ。
			IF RAND:5
				SELECTCASE 口上_場所判定_1384(対象キャラ)
					CASE "キャンプ場", "キャンプファイアー"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「外で飲む茶は、部屋で飲むより味がする。……気のせいかもしれんが」
								KSTR:(K++) = 良秀はカップを両手で包み、%CALLNAME:PLAYER%の隣に腰を下ろした。
							CASE 1
								KSTR:(K++) = 「火にかけた湯で淹れたのか。少し煙の匂いがするな。
								KSTR:(K++) = 　悪くない。_一人称_の煙草とどっちが勝つか、試してみるか」
						ENDSELECT
					CASE "プール", "海水浴場"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「冷たいのはないのか。……熱い茶か。_二人称_らしいな」
								KSTR:(K++) = 文句を言いながらも、良秀は一口ずつ茶をすすっている。
							CASE 1
								KSTR:(K++) = 「泳いだ後の茶は染みるな。_二人称_も飲め。
								KSTR:(K++) = 　倒れられたら、運ぶのは_一人称_なんだぞ」
						ENDSELECT
					CASE "温泉ロビー"
						;浴場ではお茶を実行できないので、湯上がりの温泉ロビーの場面
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「湯上がりに熱い茶とはな。汗が引かん。
								KSTR:(K++) = 　……まあいい。_二人称_が淹れたなら飲む」
							CASE 1
								KSTR:(K++) = 良秀は濡れた髪をタオルで雑に拭きながら、%CALLNAME:PLAYER%から湯呑みを受け取った。
								KSTR:(K++) = 「ふぅ……。風呂と茶と_二人称_。今日はこれで十分だ」
						ENDSELECT
					CASE "食堂"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「飯の後の茶は悪くない。_二人称_、もう一杯」
							CASE 1
								KSTR:(K++) = 「食堂の茶より、_二人称_が淹れた方が濃いな。
								KSTR:(K++) = 　褒めてるわけじゃない。……いや、褒めてる」
						ENDSELECT
					CASE "図書室"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「本の上に置くなよ。染みになったら、_一人称_が怒られる」
							CASE 1
								KSTR:(K++) = 「茶を飲みながら画集をめくるのは、悪くない時間だ。
								KSTR:(K++) = 　_二人称_も座れ」
						ENDSELECT
					CASE "美術館"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「ここで飲み食いするな、と言いたいところだが。
								KSTR:(K++) = 　絵から離れて飲めば構わんだろう。こっちに来い」
							CASE 1
								KSTR:(K++) = 「茶の熱さ、香り、カップの手触り……五感に刺激を受けながら芸術品を見るというのも悪くないな。
								KSTR:(K++) = 　絵に近付けないのが残念だが」
						ENDSELECT
					CASE "お祭り"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「出店の飯で喉が渇いてたところだ。気が利くな」
							CASE 1
								KSTR:(K++) = 「人混みの中で茶か。……少し、静かな方へ行くぞ。ついて来い」
						ENDSELECT
					CASE "ロビー受付", "調理師", "給仕", "プール監視員", "バーテンダー", "ディーラー", "司書", "教師", "警備員"
						;勤務中への差し入れ
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「差し入れか。……助かる。少しだけ休む」
							CASE 1
								KSTR:(K++) = 「仕事中に茶を持ってくる雇い主がいるか。
								KSTR:(K++) = 　……いるな、ここに。置いていけ」
						ENDSELECT
				ENDSELECT
			ENDIF
			IF K == 0
				SELECTCASE RAND:5
					CASE 0
						KSTR:(K++) = 「ん、この濃さでいい。_二人称_も座れ。茶が空くまで、_一人称_の話に付き合え」
						KSTR:(K++) = 良秀は茶を一口飲み、%CALLNAME:PLAYER%が座る方へ顔を向けた。
					CASE 1
						KSTR:(K++) = 「茶請けはないのか。……ちっ、_一人称_が取ってくる。
						KSTR:(K++) = 　_二人称_はそこで指を咥えて待っていろ」
					CASE 2
						KSTR:(K++) = 「_二人称_の淹れる茶は、毎回少しずつ味が違うな。
						KSTR:(K++) = 　今日のは悪くない」
					CASE 3
						KSTR:(K++) = 良秀は湯呑みを傾けながら、%CALLNAME:PLAYER%の手元をじっと見ている。
						KSTR:(K++) = 「次は_一人称_が淹れてやる。味の保証はせんぞ」
					CASE 4
						KSTR:(K++) = 「茶柱か。縁起がいいらしいな。……_二人称_にやる」
						KSTR:(K++) = 良秀は自分の湯呑みを、%CALLNAME:PLAYER%の方へ押しやった。
				ENDSELECT
			ENDIF
	ENDSELECT
ELSE
	;恋慕なし。セフレ・その他の陥落・未陥落を含む。
	IF RFLAG:コマンド結果受渡し変数 == 0
		;セフレ専用は通常成功時に80％。当選したら後の場所口上は出さない。
		IF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「茶か。酒の方がよかったが、まあいい。夜まで取っておく」
				CASE 1
					KSTR:(K++) = 「わざわざ淹れてきたのか。妙なところで気が回る奴だな」
				CASE 2
					KSTR:(K++) = 良秀は茶をすすりながら、%CALLNAME:PLAYER%の口元をじっと見ている。
					KSTR:(K++) = 「……何だ。茶を飲む口元を見てただけだ」
			ENDSELECT
		ENDIF
		
		;場所の口上を80％で選択。セフレ専用に外れた枠も同じ抽選。
		IF K == 0 && RAND:5
			SELECTCASE 口上_場所判定_1384(対象キャラ)
				CASE "キャンプ場", "キャンプファイアー"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「外で飲む茶は悪くない。煙草の煙とよく合う」
						CASE 1
							KSTR:(K++) = 「火のそばで茶か。……温まるな」
					ENDSELECT
				CASE "プール", "海水浴場"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「泳いだ後の茶は染みるな」
						CASE 1
							KSTR:(K++) = 「冷たいのはないのか。……まあ、これでいい」
					ENDSELECT
				CASE "温泉ロビー"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「湯上がりに熱い茶か。汗が引かんぞ」
						CASE 1
							KSTR:(K++) = 「風呂上がりの一杯は悪くない。酒なら、もっといいが」
					ENDSELECT
				CASE "ロビー受付", "調理師", "給仕", "プール監視員", "バーテンダー", "ディーラー", "司書", "教師", "警備員"
					;勤務中への差し入れ
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「差し入れか。……助かる」
						CASE 1
							KSTR:(K++) = 「仕事中だぞ。……まあ、一杯くらいはいいか」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

IF K == 0
	;専用口上がない結果・関係では既存の結果分岐を使う。
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -1
			;失敗
			SELECTCASE RAND:2
				CASE 0
					; 苦・渋＝苦くて渋い
					KSTR:(K++) = 「苦・渋。茶葉を責める前に、淹れてから何をしてたか思い出せ」
				CASE 1
					KSTR:(K++) = 良秀は一口すすると、黙って湯呑みを置いた。
					KSTR:(K++) = 「……_一人称_が淹れるよりはましだ。それだけだ」
			ENDSELECT
		CASE 0
			;通常成功
			IF TALENT:対象キャラ:飲食不可
				KSTR:(K++) = 「ん。そこへ置け。_二人称_の分も淹れたんだろう？ 立ってることはない」
			ELSE
				SELECTCASE RAND:6
					CASE 0
						KSTR:(K++) = 「ん。そこへ置け。_二人称_の分も淹れたんだろう？ 立ってることはない」
					CASE 1
						;フライング
						KSTR:(K++) = 「……フ・イ。……ちっ、短縮の出来もイマイチか」
						KSTR:(K++) = 良秀はお茶に息を吹きかけて冷ましている。どうやら少し熱すぎたようだ。
					CASE 2
						KSTR:(K++) = 「_二人称_は、嫌いな物から先に食う方か？
						KSTR:(K++) = 　_一人称_は最後だ。そこまで残せば、もう食わずに済むこともある」
						KSTR:(K++) = 良秀はそう言って、茶を口にした。
					CASE 3
						KSTR:(K++) = %CALLNAME:PLAYER%が短く鼻歌を歌ってやめると、茶を飲んでいた良秀が顔を上げた。
						KSTR:(K++) = 「……いまので終わりか？
						KSTR:(K++) = 　_一人称_はその曲を知らん。続きがあるならやれ。途中で切られると、妙に気になる」
					CASE 4
						KSTR:(K++) = 「茶の色ってのは、淹れる奴で変わる。_二人称_のは少し濁ってるな。
						KSTR:(K++) = 　味は、まあ悪くない」
					CASE 5
						KSTR:(K++) = 「茶請けは？ ……ないのか。なら、次は持ってこい」
				ENDSELECT
			ENDIF
		CASEELSE
			;大成功
			SELECTCASE RAND:2
				CASE 0
					; 香・良＝香りが良い
					KSTR:(K++) = 「……香・良。湯の加減を覚えておけよ。次もこれで頼む」
				CASE 1
					KSTR:(K++) = 良秀は黙って茶を飲み干すと、空の湯呑みを%CALLNAME:PLAYER%に差し出した。
					KSTR:(K++) = 「もう一杯」
			ENDSELECT
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM302_スキンシップ
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功

@KOJO_COM_1384_302(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;関係性を先に分け、場所はSELECTCASE 口上_場所判定_1384()で分ける。未出力なら末尾のIF K == 0で汎用口上へ。
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	;恋慕。両方の素質がある場合もこちらを優先。
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -1
			;失敗
			KSTR:(K++) = 「っ？！ ……油断していたとはいえ_一人称_の後ろを取るとはな。
			KSTR:(K++) = 　次は白刃取りしてやる。ほら、打ってこい」
			KSTR:(K++) = バトルジャンキーのスイッチが入ってしまったようだ。
		CASE 0
			;恋慕・通常成功：場所の口上を80％で選び、外れたら下の恋慕・通常口上へ。
			IF RAND:5
				SELECTCASE 口上_場所判定_1384(対象キャラ)
					CASE "温泉浴場"
						;湯船に浸かったままのじゃれ合い。洗い場・脱衣所・サウナは除外。
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「湯の中でまで触ってくるのか。……くく、好きにしろ。逃げ場もない」
								KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の肩に頭を預け、湯の中で指を絡めてきた。
							CASE 1
								KSTR:(K++) = 「背中に回るな。……いや、そのまま肩を揉め。
								KSTR:(K++) = 　湯の中だと、よく効く」
						ENDSELECT
					CASE "プール", "海水浴場"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「濡れた手で触るな。……冷たいだろうが」
								KSTR:(K++) = そう言いながらも、良秀は%CALLNAME:PLAYER%の手を振り払おうとはしなかった。
							CASE 1
								KSTR:(K++) = 「日に焼けた肩を叩くな。ひりひりする。
								KSTR:(K++) = 　……今日は優しくしろ」
						ENDSELECT
					CASE "サウナ"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「この暑さでくっついてくるとはな。
								KSTR:(K++) = 　我慢比べのつもりか？ いいだろう、受けて立つ」
							CASE 1
								KSTR:(K++) = 「汗だくの手で触るな。……_一人称_も汗だくか。なら、お互い様だな」
						ENDSELECT
					CASE "キャンプファイアー"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「火の前だと、_二人称_の手も温かいな。……もう少し、そうしていろ」
							CASE 1
								KSTR:(K++) = 良秀は%CALLNAME:PLAYER%に寄りかかったまま、炎を眺めている。
								KSTR:(K++) = 「動くな。今、この火と_二人称_の横顔を一緒に覚えてる」
						ENDSELECT
					CASE "お祭り"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「人前で触るな。……人混みの中なら、誰も見てないか」
								KSTR:(K++) = 良秀はそう言うと、%CALLNAME:PLAYER%の手をぐっと握り返した。
							CASE 1
								KSTR:(K++) = 「はぐれないように、か。口実が下手だな。
								KSTR:(K++) = 　……まあいい、繋いでおけ」
						ENDSELECT
					CASE "美術館"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「ここで触っていいのは、展示品以外だけだ。
								KSTR:(K++) = 　……つまり、_一人称_か。好きにしろ」
							CASE 1
								KSTR:(K++) = 「絵の前で騒ぐ奴は嫌いだ。
								KSTR:(K++) = 　……手だけなら、繋いでいてもいい」
						ENDSELECT
					CASE "ロビー受付", "調理師", "給仕", "プール監視員", "バーテンダー", "ディーラー", "司書", "教師", "警備員"
						;勤務中（訓練・知識習得は仕事ではないので除く）
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「仕事中だ。_二人称_が邪魔してどうする。
								KSTR:(K++) = 　……少しだけだぞ」
							CASE 1
								KSTR:(K++) = 良秀は手を止めずに、%CALLNAME:PLAYER%の手を肘で軽く押し返した。
								KSTR:(K++) = 「後にしろ。今触られると手元が狂う。狂ったら_二人称_のせいだからな」
						ENDSELECT
				ENDSELECT
			ENDIF
			IF K == 0
				SELECTCASE RAND:6
					CASE 0
						KSTR:(K++) = 「……そこはもういい。少し上だ」
						KSTR:(K++) = 良秀は肩を少し下げ、手が届くようにした。
						KSTR:(K++) = 「_二人称_なら、細かく言わずに済むと思ったが、まだまだ修行が足りないようだな。……ん、そのままでいい」
					CASE 1
						KSTR:(K++) = 「もう疲れたのか？ ……根性を出して続けろ。この時間は気に入ってる」
						KSTR:(K++) = 良秀は姿勢を変えず、%CALLNAME:PLAYER%の手を待っている。
					CASE 2
						KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の手を取ると、指の一本一本を確かめるように眺めた。
						KSTR:(K++) = 「いい手だ。描くなら、骨の形から入りたい」
					CASE 3
						KSTR:(K++) = 「頭を撫でるな。子供扱いか？
						KSTR:(K++) = 　……続けろとは言ってない。止めろとも言ってないが」
					CASE 4
						KSTR:(K++) = 「_二人称_の手は、いつも少し冷たいな。……温めてやるから、貸せ」
					CASE 5
						KSTR:(K++) = 良秀は触れられたお返しとばかりに、%CALLNAME:PLAYER%の頬をつまんできた。
						KSTR:(K++) = 「ふっ、間の抜けた顔だ。……描いておくか」
				ENDSELECT
			ENDIF
		CASE IS > 0
			;恋慕・大成功
			KSTR:(K++) = 「こうして無防備になって触れられるのも、案外悪くないものだな」
			KSTR:(K++) = 良秀は肩から力を抜き、%CALLNAME:PLAYER%の手に身を任せた。
			KSTR:(K++) = 「ふっ。もう少し任せる。どうした。次はないかもしれんぞ」
	ENDSELECT
ELSE
	;恋慕なし。セフレ・その他の陥落・未陥落を含む。
	IF RFLAG:コマンド結果受渡し変数 == 0
		;セフレ専用は通常成功時に80％。当選したら後の場所口上は出さない。
		IF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
			SELECTCASE RAND:4
				CASE 0
					KSTR:(K++) = 「そんな触り方じゃ、夜まで待てなくなるぞ。
					KSTR:(K++) = 　……それが狙いか？」
				CASE 1
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の手を掴み、自分の腰の辺りへ導いた。
					KSTR:(K++) = 「触るなら、こっちだろう」
				CASE 2
					KSTR:(K++) = 「昼間から何のつもりだ。……くく、続きは後でな」
				CASE 3
					KSTR:(K++) = 「肩を揉む手つきじゃないな、それは。
					KSTR:(K++) = 　……ちっ、余計なことを思い出させるな」
			ENDSELECT
		ENDIF
		
		;場所の口上を80％で選択。セフレ専用に外れた枠も同じ抽選。
		IF K == 0 && RAND:5
			SELECTCASE 口上_場所判定_1384(対象キャラ)
				CASE "温泉浴場"
					;湯船に浸かったままのじゃれ合いを80％。洗い場・脱衣所・サウナは除外。
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「あまりうろうろするな。湯のかさが減るだろう」
							KSTR:(K++) = 良秀は%CALLNAME:PLAYER%を押さえつけ、肩まで湯に浸かるように促した。
						CASE 1
							KSTR:(K++) = 「はぁ、落ち着きのないやつだな。人の体を触ってないと死ぬのか？」
							KSTR:(K++) = 良秀はスキンシップに迷惑そうな顔をするが、止めようとはしてこない。
						CASE 2
							KSTR:(K++) = 「おい、ゆっくり風呂を楽しませろ。気が散る」
							KSTR:(K++) = 良秀はベタベタしてきた%CALLNAME:PLAYER%を足蹴にしている。
					ENDSELECT
				CASE "プール", "海水浴場"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「濡れた手で触るな。冷たい」
						CASE 1
							KSTR:(K++) = 「日焼けしたところを叩くな。……覚えてろよ」
					ENDSELECT
				CASE "キャンプファイアー"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「火の近くでじゃれつくな。燃えても知らんぞ」
						CASE 1
							KSTR:(K++) = 「ん。火の前だと、触られても悪くない気がするな。
							KSTR:(K++) = 　……火のせいだ」
					ENDSELECT
				CASE "お祭り"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「人混みでベタベタするな。暑苦しい」
						CASE 1
							KSTR:(K++) = 「はぐれないように、か。……袖くらいなら掴ませてやる」
					ENDSELECT
				CASE "ロビー受付", "調理師", "給仕", "プール監視員", "バーテンダー", "ディーラー", "司書", "教師", "警備員"
					;勤務中（訓練・知識習得は仕事ではないので除く）
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「仕事中だ。触るな、手元が狂う」
						CASE 1
							KSTR:(K++) = 「後にしろ。手順を忘れたら、_二人称_が代わりにやれよ」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

IF K == 0
	;専用口上がない結果・関係では既存の結果分岐を使う。
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -1
			;失敗
			KSTR:(K++) = 「急に触るな。何か用があるなら、先に口を使え」
		CASE 0
			;通常成功
			SELECTCASE RAND:7
				CASE 0
					KSTR:(K++) = 「労りたいのか_一人称_の機嫌を取りたいのか。_一人称_の見立てじゃ手つきは前者だが、顔は後者だな」
				CASE 1
					KSTR:(K++) = %CALLNAME:PLAYER%が良秀に触れると、手の甲を指で軽くつねられた。
					KSTR:(K++) = 「何だ、その顔は。触り返されるとは思わなかったか？」
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の反応を見て、喉の奥で笑った。
				CASE 2
					KSTR:(K++) = 良秀の肩を揉んでいると、張ったところに%CALLNAME:PLAYER%の指が止まった。
					KSTR:(K++) = 「……そこを選んだか。手当たり次第ではなさそうだな。だが……
					KSTR:(K++) = 　そこまで分かっていて、その力加減か。惜しいな」
				CASE 3
					KSTR:(K++) = 「なぜ_一人称_に触れてくる。気に食わなかったら叩き切るぞ」
					KSTR:(K++) = 幸い、まだ切られていない。
				CASE 4
					;季節で変わる（ハル子と同じく DAY % 120 / 30 で春夏秋冬）
					SELECTCASE DAY % 120 / 30
						CASE 0
							;春
							KSTR:(K++) = 「髪に花びら？ ……取ったなら、さっさと手を離せ」
						CASE 1
							;夏
							KSTR:(K++) = 「暑い。触るなら、もっと冷たい手で来い」
						CASE 2, 3
							;秋・冬
							KSTR:(K++) = 「手が冷たい。触るなら、先に温めてこい」
					ENDSELECT
				CASE 5
					KSTR:(K++) = 「肩か。ふん、悪くない。もう少し右だ。
					KSTR:(K++) = 　……行き過ぎだ。左。……そこだ」
				CASE 6
					KSTR:(K++) = 「_二人称_の指、筆を持たせたら面白い線を引きそうだな。
					KSTR:(K++) = 　今度、持たせてみるか」
			ENDSELECT
		CASEELSE
			;大成功
			KSTR:(K++) = 「ん……どうした。反抗されないのが珍しいとでも言いたげな顔だな。
			KSTR:(K++) = 　_一人称_のことを駄々をこねる子供か何かだと思っていないか？」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM303_口説く
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_1384_303(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口説くは場所では分けず、関係性で分ける。両方の関係があれば恋慕を優先。
;酔っている時（BASE:酩酊が0より大きい）は、成功時に限り「酩酊÷1000」の確率で酔った時の反応にする。
;酩酊はステータス表示と同じく、500未満を「ほろ酔い」、500以上を「酩酊」として分ける。
IF RFLAG:コマンド結果受渡し変数 >= 0 && BASE:対象キャラ:酩酊 > 0 && RAND:1000 < BASE:対象キャラ:酩酊
	IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
		;恋慕・酔っている
		IF BASE:対象キャラ:酩酊 >= 500
			;酩酊
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「んー……_二人称_の声は、酔うとよく響くな……」
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の肩に額を押しつけたまま、くつくつと笑っている。
					KSTR:(K++) = 「もっと言え……今なら、全部覚えてないふりをしてやる……」
				CASE 1
					KSTR:(K++) = 「_二人称_の顔、今日はやけに描き甲斐がある……。
					KSTR:(K++) = 　動くな、そのまま……」
					KSTR:(K++) = 良秀は据わった目で%CALLNAME:PLAYER%の頬を指でなぞり、そのまま寄りかかってきた。
			ENDSELECT
		ELSE
			;ほろ酔い
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「酒の席の口説き文句か。悪くない。
					KSTR:(K++) = 　もう一杯注げ。続きを聞いてやる」
				CASE 1
					KSTR:(K++) = 「_二人称_、今のをもう一回だ。
					KSTR:(K++) = 　酒が入ると、言葉がよく染みる」
			ENDSELECT
		ENDIF
	ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ")
		;セフレ・酔っている
		IF BASE:対象キャラ:酩酊 >= 500
			KSTR:(K++) = 「口説くなら……もっと近くで言え。聞こえん……」
			KSTR:(K++) = 良秀はとろんとした目のまま、%CALLNAME:PLAYER%の胸ぐらを掴んで引き寄せた。
		ELSE
			KSTR:(K++) = 「酒の勢いで口説くのか？ くく、乗ってやってもいいぞ」
		ENDIF
	ELSE
		;恋慕・セフレなし・酔っている
		IF BASE:対象キャラ:酩酊 >= 500
			KSTR:(K++) = 「くく……今の、下手くそだな……。でも、もう一回言え……」
			KSTR:(K++) = 良秀はグラスを揺らしながら、ぼんやりと%CALLNAME:PLAYER%の顔を眺めている。
		ELSE
			KSTR:(K++) = 「酒の席の口説き文句なんぞ、朝には忘れてる。
			KSTR:(K++) = 　_一人称_も、_二人称_もな」
		ENDIF
	ENDIF
ENDIF

IF K == 0
	IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE 0
				;恋慕・通常成功。CASE 2・3は図星を指されて黙る反応
				SELECTCASE RAND:6
					CASE 0
						KSTR:(K++) = 「……それは、_一人称_のどこを見て言った？」
						KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の目をじっと見つめている。
						KSTR:(K++) = 「続けろ。_二人称_がどう見ているのかは、聞いておきたい」
					CASE 1
						KSTR:(K++) = 「_一人称_も_二人称_が好きだ。それだけでは足りんか？」
						KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の顔を見てから、少し考えた。
						KSTR:(K++) = 「……待て。今の言い方はつまらんな。_二人称_の言い方に倣うなら、_一人称_ももう頭を捻ろう」
					CASE 2
						KSTR:(K++) = %CALLNAME:PLAYER%が、絵を描いている時の顔が一番好きだと言うと、良秀は何か言いかけて口を閉じた。
						KSTR:(K++) = 良秀は黙ったまま煙草を取り出したが、火をつけるのに少し手間取った。
					CASE 3
						KSTR:(K++) = 「照れてる？ 誰がだ。_一人称_は……」
						KSTR:(K++) = 良秀はそこで言葉を切ると、それきり何も言い返さずに顔を背けた。
					CASE 4
						KSTR:(K++) = 「甘ったるい言い方はやめろ。_一人称_とは、もっと雑に話せ。
						KSTR:(K++) = 　その方が、よく響く」
					CASE 5
						KSTR:(K++) = 「その台詞、何回練習した？ くく、顔に書いてある」
				ENDSELECT
			CASE IS > 0
				;恋慕・大成功。
				KSTR:(K++) = 「……いい。今の言葉は、_一人称_がもらう」
				KSTR:(K++) = 良秀は%CALLNAME:PLAYER%を見据えたまま、小さく口の端を上げた。
				KSTR:(K++) = 「もう一度言え。聞き逃したわけではない。気に入った」
		ENDSELECT
	ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
		;セフレ専用は通常成功時に80％。抽選に外れた場合や他の結果は、下の汎用口上へ。
		IF RFLAG:コマンド結果受渡し変数 == 0
			SELECTCASE RAND:4
				CASE 0
					KSTR:(K++) = 「口説く必要があるのか？ もう寝てるだろう、_一人称_たちは」
				CASE 1
					KSTR:(K++) = 「口が上手くなったな。どこで練習してる。
					KSTR:(K++) = 　……まさか、他の奴相手か」
				CASE 2
					KSTR:(K++) = 「言葉より手の方が得意だろう、_二人称_は。試してやろうか？」
				CASE 3
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の口説き文句を最後まで聞くと、肩をすくめた。
					KSTR:(K++) = 「悪くない。夜にもう一度言え。続きはその時だ」
			ENDSELECT
		ENDIF
	ELSEIF RFLAG:コマンド結果受渡し変数 == 0 && CFLAG:対象キャラ:恋心度 > 経験値テーブル:(関係閾値:3) && RAND:5
		;恋慕の手前（恋心が想い人以上）：言葉が処理しきれず、困惑して詰まる・黙る
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「何だ、今のは。もう一度……いや、言わなくていい」
				KSTR:(K++) = 良秀は眉を寄せたまま、%CALLNAME:PLAYER%から目を逸らした。
			CASE 1
				KSTR:(K++) = 「どうも妙だ。_二人称_にそう言われると、うまく返す言葉が出てこない」
				KSTR:(K++) = （なぜだ。他の奴なら、鼻で笑って終わりなのに）
			CASE 2
				KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の言葉に何も言い返さず、黙って煙草に火をつけた。
				KSTR:(K++) = 吐き出す煙が、いつもより少しだけ遅い。
		ENDSELECT
	ENDIF
ENDIF

IF K == 0
	;専用口上がない結果・関係では既存の結果分岐を使う。
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			;大失敗：共有の話題無しフラグ。直前に同じ口説き文句を使ったとは限らない。
			KSTR:(K++) = 「もう聞き飽きた。他の言い方はないのか」
		CASE -1
			;失敗
			KSTR:(K++) = 「その言葉、誰にでも言ってるのか。_一人称_に言うなら、_一人称_を見て考えろ」
		CASE 0
			;通常成功
			SELECTCASE RAND:6
				CASE 0
					; 赤・回＝赤点回避
					KSTR:(K++) = 「６０点。赤・回だな」
				CASE 1
					KSTR:(K++) = 「それは褒めているんだろうな？
					KSTR:(K++) = 　……ふっ。なら、そういうことにしておいてやる」
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の言葉をしばらく吟味してから、面白そうに笑った。
				CASE 2
					KSTR:(K++) = 「そういうのはどこかで習うモノなのか？ あるいは天性のナンパ野郎なのか……
					KSTR:(K++) = 　しかしまぁ、言葉選びのセンスとしては磨けば光るものがありそうだ。もう少し聞かせてみろ」
				CASE 3
					KSTR:(K++) = 「一節ごとによく声色が変わるものだな。ふっ……
					KSTR:(K++) = 　意味はよく分からんが、ゴマすりよりは聴き応えがある」
				CASE 4
					KSTR:(K++) = 「口説き文句ってのは、相手を見て選ぶものだ。
					KSTR:(K++) = 　_二人称_のは、誰にでも使える形をしてる。まあ、形は悪くないが」
				CASE 5
					KSTR:(K++) = 「ふん。_一人称_を口説いて、何の得がある」
			ENDSELECT
		CASEELSE
			;大成功
			KSTR:(K++) = 「ふっ……そう来るか。_一人称_が嫌う言い方を、よく避けたな。どこで覚えた？」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM304_知識を教わる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;RFLAG:コマンド結果受渡し変数２=教えてもらう知識種類
	;1,調合知識  2,魔法知識  3,機械知識  4,錬金知識  5,魔物知識  6,絵師  7,高貴  8,釣り好き  9,踊り子  10,歌唱技能
	;11,料理人  12,歴史知識  13,経営知識  14,水泳技能  15,農業知識
;知識素質:(RFLAG:コマンド結果受渡し変数２)でキャラの知識のLv値が得られる
	;教えられるのは「そのキャラが持っている知識素質が、あなたよりLvが高い時のみ」なので、持っていない知識に関して記述する必要はない

@KOJO_COM_1384_304(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	IF RAND:5
		IF CFLAG:PLAYER:現在マップ種別 == CFLAG:対象キャラ:現在マップ種別 && CFLAG:PLAYER:現在位置 == CFLAG:対象キャラ:現在位置 && CFLAG:PLAYER:現在マップ種別 == 0 && GROUPMATCH(CFLAG:PLAYER:現在位置, 9, 10, 11, 12, 704, 705, 707, 708, 804, 805, 807, 808)
			;湯船に浸かったまま教わるのを80％。洗い場・脱衣所・サウナは除外。
		ENDIF
	ENDIF
	IF K == 0
		;恋慕時の汎用口上をここへ追記する。
	ENDIF
ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
	;セフレ時の口上をここへ追記する。

ELSEIF RAND:5
	IF CFLAG:PLAYER:現在マップ種別 == CFLAG:対象キャラ:現在マップ種別 && CFLAG:PLAYER:現在位置 == CFLAG:対象キャラ:現在位置
		;同じ場所のロケーション・状況口上をここへ追記する。
	ENDIF
ENDIF
IF K == 0
	SELECTCASE RFLAG:コマンド結果受渡し変数２
		CASE 1
			;調合知識
			SELECTCASE RFLAG:コマンド結果受渡し変数
				CASE -1
					;失敗
					KSTR:(K++) = 「手順を飛ばすな。何を混ぜたか分からなくなってから嗅いでも遅い」
				CASE 0
					;通常成功
					KSTR:(K++) = 「今の順番を覚えろ。次は_二人称_がやってみろ。
					KSTR:(K++) = 　……_一人称_もたまに間違えるから、手元は_二人称_も見ておけ」
				CASEELSE
					;大成功
					KSTR:(K++) = 「そこまで分かったか。なら、同じ結果をもう一度出してみろ。偶然で済ませるのは惜しい」
			ENDSELECT
		CASE 2
			;魔法知識
		CASE 3
			;機械知識
		CASE 4
			;錬金知識
		CASE 5
			;魔物知識
		CASE 6
			;絵師／絵の心得。良秀が教え、PLAYERが学ぶ。
			SELECTCASE RFLAG:コマンド結果受渡し変数
				CASE -1
					KSTR:(K++) = 「形だけ真似るな。……いや、今のは忘れろ。見せた方が早い」
					KSTR:(K++) = 良秀は説明を切り上げて実演に移ったが、%CALLNAME:PLAYER%には、まだ違いが掴めなかった。
				CASE 0
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 良秀は指を広げ、%CALLNAME:PLAYER%に手の形を見せた。
							KSTR:(K++) = 「指を描くなら、指の間も見ろ。
							KSTR:(K++) = 　……そうだ。隙間の形が違えば、手の印象も変わる」
						CASE 1
							KSTR:(K++) = 良秀は口元を動かさずに眉を寄せ、そのあと眉だけを上げてみせた。
							KSTR:(K++) = 「同じ口でも、眉が違えば別の顔になる。……描いてみろ」
							KSTR:(K++) = %CALLNAME:PLAYER%が眉の角度だけを変えて二つの顔を描き分けると、良秀は小さく頷いた。
							KSTR:(K++) = 「……飲み込みが早いじゃないか」
					ENDSELECT
				CASE 1
					KSTR:(K++) = 「そこに目をつけたか。……ふっ。面白さが分かってきたか？ 次は何を描いてみたい？」
			ENDSELECT
		CASE 7
			;高貴
		CASE 8
			;釣り好き
		CASE 9
			;踊り子
		CASE 10
			;歌唱技能
		CASE 11
			;料理人
		CASE 12
			;歴史知識
		CASE 13
			;経営知識
		CASE 14
			;水泳技能
		CASE 15
			;農業知識
	ENDSELECT

ENDIF
CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM313_ハグする
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功

@KOJO_COM_1384_313(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;関係性を先に分け、場所はSELECTCASE 口上_場所判定_1384()で分ける。未出力なら末尾のIF K == 0で汎用口上へ。
;恋慕の相手と非恋慕の相手を分ける。両方の関係があれば恋慕を優先。
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE 0
			;恋慕・通常成功：場所の口上を80％で選び、外れたら下の恋慕・通常口上へ。
			IF RAND:5
				SELECTCASE 口上_場所判定_1384(対象キャラ)
					CASE "温泉浴場"
						;湯船に浸かったままのハグ。洗い場・脱衣所・サウナは除外。
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「湯の中で抱きつくな。のぼせる」
								KSTR:(K++) = そう言いつつ、良秀は%CALLNAME:PLAYER%を引き剥がそうとはせず、湯の中で背中に腕を回した。
							CASE 1
								KSTR:(K++) = 「濡れた肌同士だと、妙に離れにくいな」
								KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の肩に顎を乗せ、目を閉じた。
								KSTR:(K++) = 「もう少し、このままでいろ」
						ENDSELECT
					CASE "プール", "海水浴場"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「日差しの下で抱きつくな。暑い」
								KSTR:(K++) = 良秀は文句を言いながらも、%CALLNAME:PLAYER%の腰に腕を回して引き寄せた。
							CASE 1
								KSTR:(K++) = 「人目があるぞ。……知るか、と言いたげな顔だな。
								KSTR:(K++) = 　まあいい、_一人称_も知らん」
						ENDSELECT
					CASE "サウナ"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「この暑さで抱きつくとは、正気か」
								KSTR:(K++) = 良秀は汗だくのまま、%CALLNAME:PLAYER%を抱き返した。
								KSTR:(K++) = 「離れたら負けた気がする。続けろ」
							CASE 1
								KSTR:(K++) = 「暑い。ほら、先に音を上げた方が、水を取ってくる係だ」
						ENDSELECT
					CASE "キャンプファイアー"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「火の前で抱きつくのは、悪くない趣向だ。
								KSTR:(K++) = 　背中まで寒くなくて済む」
							CASE 1
								KSTR:(K++) = 良秀は%CALLNAME:PLAYER%を抱いたまま、火の粉が夜空に昇っていくのを眺めている。
								KSTR:(K++) = 「火の粉が星に紛れていく。見てみろ。
								KSTR:(K++) = 　_二人称_の肩越しだと、ちょうどいい構図だ」
						ENDSELECT
					CASE "お祭り"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「人混みで抱きつくな。はぐれる方がまだましだ。
								KSTR:(K++) = 　……と言いたいところだが、まあいい。少しだけだ」
							CASE 1
								KSTR:(K++) = 「祭りの浮かれた空気に当てられたか？
								KSTR:(K++) = 　……_一人称_もか。なら、仕方ない」
						ENDSELECT
					CASE "美術館"
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「絵の前で抱きつくな。鑑賞しづらいだろう。……後でな」
							CASE 1
								KSTR:(K++) = 「展示品より、_二人称_の方が手触りがいい。
								KSTR:(K++) = 　……ここで言うことじゃないな」
						ENDSELECT
					CASE "ロビー受付", "調理師", "給仕", "プール監視員", "バーテンダー", "ディーラー", "司書", "教師", "警備員"
						;勤務中（訓練・知識習得は仕事ではないので除く）
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「仕事中だぞ。客がいないうちに、さっさと済ませろ」
							CASE 1
								KSTR:(K++) = 「抱きついてる暇があるなら手伝え。
								KSTR:(K++) = 　いや、やっぱりいい。_二人称_に手伝わせると、余計に散らかる」
						ENDSELECT
				ENDSELECT
			ENDIF
			IF K == 0
				SELECTCASE RAND:6
					CASE 0
						KSTR:(K++) = 「なんだ？ なんで引っ付いてくる」
						KSTR:(K++) = そう言いながらも良秀は%CALLNAME:PLAYER%の背へ腕を回し、抱き返した。
						KSTR:(K++) = 「話もしたいなら、このまま喋れ。聞き取れる距離だ」
					CASE 1
						KSTR:(K++) = 「待て。_一人称_からもやらせろ」
						KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の背へ両腕を回し、改めて抱き寄せた。
						KSTR:(K++) = 「……よし。このくらいがいい。苦しいか？ _一人称_は楽しいぞ」
					CASE 2
						KSTR:(K++) = 「急に何だ。まあいい、ちょうど寒かった」
					CASE 3
						KSTR:(K++) = 良秀は抱きついてきた%CALLNAME:PLAYER%の頭を、雑な手つきでわしわしと撫でた。
						KSTR:(K++) = 「ツレってのは、こういうことをする間柄なんだろう。違うか？」
					CASE 4
						KSTR:(K++) = 「_二人称_からは、いつも違う匂いがするな。
						KSTR:(K++) = 　今日は……日向の匂いだ」
					CASE 5
						KSTR:(K++) = 「力を入れすぎだ。……逃げやしない」
				ENDSELECT
			ENDIF
		CASE IS > 0
			;恋慕・大成功。ハグの結果1に対応。
			KSTR:(K++) = 「……ふっ。妙に収まりがいいな」
			KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の背へ腕を回し、そのまま抱きとめた。
			KSTR:(K++) = 「まだ動くな。_一人称_は、もう少しこうしていたい」
	ENDSELECT
ELSE
	;恋慕なし。セフレ・その他の陥落・未陥落を含む。
	IF RFLAG:コマンド結果受渡し変数 == 0
		;セフレ専用は通常成功時に80％。当選したら後の場所口上は出さない。
		IF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ") && RAND:5
			SELECTCASE RAND:4
				CASE 0
					KSTR:(K++) = 「昼間からくっつくな。……夜まで我慢できないのか」
				CASE 1
					KSTR:(K++) = 良秀は抱きついてきた%CALLNAME:PLAYER%の耳元に顔を寄せた。
					KSTR:(K++) = 「続きをしたいなら、場所を変えるぞ」
				CASE 2
					KSTR:(K++) = 「抱きつくだけか？ 物足りんな」
				CASE 3
					KSTR:(K++) = 「離れろ。こうしてると、余計なことばかり思い出す」
			ENDSELECT
		ENDIF
		
		;場所の口上を80％で選択。セフレ専用に外れた枠も同じ抽選。
		IF K == 0 && RAND:5
			SELECTCASE 口上_場所判定_1384(対象キャラ)
				CASE "温泉浴場"
					;湯船に浸かったままハグするのを80％。洗い場・脱衣所・サウナは除外。
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「湯の中で抱きつくな。湯がこぼれる」
						CASE 1
							KSTR:(K++) = 「裸で抱きつく奴があるか。少しは恥じらえ。
							KSTR:(K++) = 　_一人称_は気にせんが」
					ENDSELECT
				CASE "プール", "海水浴場"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「濡れたまま抱きつくな。冷たい」
						CASE 1
							KSTR:(K++) = 「人目のある所で何をしてる。……物好きめ」
					ENDSELECT
				CASE "キャンプファイアー"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「火の近くでくっつくな。燃えたらどうする」
						CASE 1
							KSTR:(K++) = 「夜は冷えるからな。今回だけだ」
					ENDSELECT
				CASE "お祭り"
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「浮かれすぎだ。離れろ」
						CASE 1
							KSTR:(K++) = 「祭りの勢いか？ 今回だけは見逃してやる」
					ENDSELECT
				CASE "ロビー受付", "調理師", "給仕", "プール監視員", "バーテンダー", "ディーラー", "司書", "教師", "警備員"
					;勤務中（訓練・知識習得は仕事ではないので除く）
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「仕事中だ。離れろ」
						CASE 1
							KSTR:(K++) = 「客が見てるぞ。オーナーが従業員に抱きついてどうする」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

IF K == 0
	;専用口上がない結果・関係では既存の結果分岐を使う。
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -1
			;失敗
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……締めるな。抱きつくにも加減くらいあるだろう」
				CASE 1
					KSTR:(K++) = 良秀は抱きつこうとした%CALLNAME:PLAYER%の額を、指先で押し返した。
					KSTR:(K++) = 「間合いに入るな。斬られたいのか」
			ENDSELECT
		CASE 0
			;通常成功
			SELECTCASE RAND:6
				CASE 0
					KSTR:(K++) = 「突然前に出てくるな。そのうちうっかり叩き切るぞ」
				CASE 1
					KSTR:(K++) = 「……何がしたい？
					KSTR:(K++) = 　服にニオイがついても、_一人称_は知らんからな」
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%のことを気にも留めず、懐から煙草を取り出した。
				CASE 2
					KSTR:(K++) = 「くぁ……はあ。おい、これはいつ終わるんだ。
					KSTR:(K++) = 　退屈で眠くなってきたぞ」
					KSTR:(K++) = 引っ付いている%CALLNAME:PLAYER%の体温のせいか、良秀は大きなあくびをした。
				CASE 3
					KSTR:(K++) = 「ん。何だ、寒いのか？ なら、少しだけだぞ」
				CASE 4
					KSTR:(K++) = 「抱きつくなら、先に言え。身構える暇もない」
				CASE 5
					KSTR:(K++) = 良秀は抱きつかれたまま、%CALLNAME:PLAYER%の肩越しに遠くを眺めている。
					KSTR:(K++) = 「……いい角度だ。_二人称_の肩は、ちょうど額縁みたいだな」
			ENDSELECT
		CASEELSE
			;大成功
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……今のは避けきれんか。_二人称_、間合いを詰める時だけ妙に迷いがないな」
				CASE 1
					KSTR:(K++) = 良秀は一瞬だけ身体を強張らせたが、すぐに力を抜いて%CALLNAME:PLAYER%に体重を預けた。
					KSTR:(K++) = 「……悪くない。もう少しだけ、このままでいろ」
			ENDSELECT
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM314_プレゼントを渡す
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;0:通常成功  1:大成功  2:特殊反応

@KOJO_COM_1384_314(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
;プレゼントは場所では分けず、関係性と「普通／好きなもの」で分ける。両方の関係があれば恋慕を優先。
;RFLAG:コマンド結果受渡し変数　0:普通（好みに入らない品）　1:好きなもの（CSVのプレゼント好みに入る品）
;好みは今は絵画だけだが、今後増える前提で、好きなものの台詞は品目を限定しない言い方にする。品名は%RSTR:コマンド結果受渡し文字列%で取れる。
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE 0
			;恋慕・普通
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「_二人称_が選んだのか。
					KSTR:(K++) = 　物より、選んでる時の_二人称_の顔の方が気になるな」
				CASE 1
					KSTR:(K++) = 良秀は受け取った%RSTR:コマンド結果受渡し文字列%を、光にかざしてしばらく眺めた。
					KSTR:(K++) = 「悪くない。_一人称_の部屋に置く。置き場所は_二人称_も一緒に考えろ」
				CASE 2
					KSTR:(K++) = 「わざわざ_一人称_に、か。
					KSTR:(K++) = 　礼に、今度_二人称_を描いてやる。それで釣り合うだろう」
			ENDSELECT
		CASE 1
			;恋慕・好きなもの
			SELECTCASE RAND:3
				CASE 0
					; 恋慕のある贈り手を引き留め、自分の感想を聞かせる。
					KSTR:(K++) = 「これを渡して、それで終わりか？」
					KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の袖を指先でつまみ、その場に引き留めた。
					KSTR:(K++) = 「_一人称_がどこを気に入ったか、聞いていけ。選んだ本人なら、最後まで付き合え」
				CASE 1
					KSTR:(K++) = 「分かってるじゃないか、_二人称_」
					KSTR:(K++) = 良秀は%RSTR:コマンド結果受渡し文字列%から目を離さないまま、口の端を上げた。
					KSTR:(K++) = 「いつの間に_一人称_の好みを調べた。
					KSTR:(K++) = 　……まあいい。そういうところは、嫌いじゃない」
				CASE 2
					KSTR:(K++) = 良秀は贈り物を受け取るなり、%CALLNAME:PLAYER%の頭を雑に引き寄せて、額を軽くぶつけた。
					KSTR:(K++) = 「上出来だ。ツレへの贈り物としては、満点にしておいてやる」
			ENDSELECT
	ENDSELECT

;本文未記入の関数も含めて登録している。
;台詞を追加するときは、各関数の空欄に記入する。
;本文未記入の口上変数への代入行も有効化している。
;元からある説明コメントは解除しない。TRYCALLFORMの振り分けも有効化している。
;振り分け関数と、作成した施術部位の関数を組み合わせて有効にする。
;--------------------------------------------------

;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;キャラクター番号は1384に設定済み。コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-MASSAGE_コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;マッサージ開始時（通常開始）
;--------------------------------------------------
;コマンド実行時_日常に「マッサージを始める」のテンプレがあるのでそちらで対応

;--------------------------------------------------
;マッサージ開始時（マッサージ来店時）
;--------------------------------------------------
@KOJO_EVENT_マッサージ来店_念入り_1384(対象キャラ)
#DIM 対象キャラ

;キャラが自動でマッサージに来たとき、念入りにマッサージを選んだときの口上
;この選択肢を選んだ時、この口上を表示してからマッサージモードに遷移する

CALL 口上変数初期化

;恋慕：普段と違う場所での触れ合いを面白がる／セフレ：普通のマッサージをしろと文句を言いつつ受け入れる／未陥落：何かおかしいと思いつつ、不思議な力で逆らえない
IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	;恋慕
	KSTR:(K++) = 「来てやったぞ。今日は念入りにやるんだろう？」
	KSTR:(K++) = 良秀は施術台に勝手に寝転がり、にやりと%CALLNAME:PLAYER%を見上げた。
	KSTR:(K++) = 「マッサージ屋の_二人称_か。……くく、どこまでやる気か見ててやる」
ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ")
	;セフレ
	KSTR:(K++) = 「肩が凝った。揉め。
	KSTR:(K++) = 　先に言っておくが、普通のマッサージだぞ。普通の」
	KSTR:(K++) = 良秀は念を押すように%CALLNAME:PLAYER%を指差してから、施術台に身を横たえた。
ELSE
	;未陥落
	KSTR:(K++) = 「腕がいいと聞いた。肩と腕を頼む。筆も刀も、どうも肩に来る。
	KSTR:(K++) = 　下手だったら、すぐに帰るからな」
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;マッサージ開始時（マッサージ来店時_簡易）
;--------------------------------------------------
@KOJO_EVENT_マッサージ来店_簡易_1384(対象キャラ)
#DIM 対象キャラ

;キャラが自動でマッサージに来たとき、簡易マッサージを選んだときの口上

CALL 口上変数初期化

IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	;恋慕
	KSTR:(K++) = 「今日は手早く済ませるのか？ つまらん」
	KSTR:(K++) = 良秀は不満げに言いながらも、%CALLNAME:PLAYER%の手が肩に触れると大人しく目を閉じた。
	KSTR:(K++) = 「ん……まあ、悪くない。続きは今度、念入りにやれ」
ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ")
	;セフレ
	KSTR:(K++) = 「軽くでいい。ああ、そこだ。ふん、今日は真面目だな。
	KSTR:(K++) = 　いつもこうなら、文句はないんだがな」
ELSE
	;未陥落
	KSTR:(K++) = 「ん、そこだ。ほう、悪くない腕だ。
	KSTR:(K++) = 　肩が軽くなった。また来てやる」
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;マッサージ終了時
;--------------------------------------------------
@KOJO_EVENT_マッサージ終了_1384(対象キャラ)
#DIM 対象キャラ
;「マッサージを終える」ボタンを押した時のみ
;うふふに移行するパターンや体力０で終えた場合は呼び出されない

;TCVAR:対象キャラ:エロマッサージ施術フラグ が１の時、そのマッサージ中にエロマッサージを行った扱い
;０ならエロしてない

CALL 口上変数初期化

IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	;恋慕
	IF TCVAR:対象キャラ:エロマッサージ施術フラグ
		KSTR:(K++) = 「はぁ……っ。_二人称_、施術台の上でここまでやるとはな」
		KSTR:(K++) = 良秀は乱れた施術着を直そうともせず、気だるげに笑った。
		KSTR:(K++) = 「こういうのも悪くない。次はやり返してやる」
	ELSE
		KSTR:(K++) = 「なんだ、今日は真面目に終わるのか」
		KSTR:(K++) = 良秀は拍子抜けしたように施術台から起き上がり、%CALLNAME:PLAYER%の顔を覗き込んだ。
		KSTR:(K++) = 「まあいい。肩は軽くなった。礼は言っておく」
	ENDIF
ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ")
	;セフレ
	IF TCVAR:対象キャラ:エロマッサージ施術フラグ
		KSTR:(K++) = 「……ちっ。だから、普通のマッサージをしろと言っただろうが」
		KSTR:(K++) = 良秀は顔をしかめて施術着の襟を掻き合わせ、%CALLNAME:PLAYER%を睨んだ。
		KSTR:(K++) = 「肩は軽くなった。そこだけは褒めてやる」
	ELSE
		KSTR:(K++) = 「ん。今日はちゃんと普通だったな」
		KSTR:(K++) = 良秀は肩を回しながら、どこか拍子抜けしたような顔をしている。
		KSTR:(K++) = 「何だ。物足りないなどとは言ってないぞ」
	ENDIF
ELSE
	;未陥落
	IF TCVAR:対象キャラ:エロマッサージ施術フラグ
		KSTR:(K++) = 「……何だったんだ、今のは」
		KSTR:(K++) = 良秀は施術台に腰掛けたまま、額に手を当ててしばらく黙り込んでいた。
		KSTR:(K++) = 「マッサージ、だったはずだ。……なぜ、_一人称_は止めなかった？」
	ELSE
		KSTR:(K++) = 「肩が軽い。腕は確かだな。
		KSTR:(K++) = 　また来てやる。次は腕も頼む」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)



;--------------------------------------------------
;良秀（1384）用の口上ひな形。ハルハラハル子のファイル構成と関数署名を参考に作成。
;口上本文は未記入。関数宣言と処理行は有効化している。
;本文未記入の関数も含めて登録している。
;台詞を追加するときは、各関数の空欄に記入する。
;本文未記入の口上変数への代入行も有効化している。
;元からある説明コメントは解除しない。TRYCALLFORMの振り分けも有効化している。
;--------------------------------------------------

;・使い方
;キャラクター番号は1384に設定済み。それぞれの関数に処理を入れる
;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、通常時の画面で表示されるので
;基本的にWAIT系列は使わないことを推奨
;また、一行のみの表示を想定。二行以上は基本的に禁止
;※うふふ中には表示されません

;以下は分岐の例
;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	KSTR:(K++) = 「……っ、は……見るな。今は、見るな」
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = 「い・ま。ご用件は短く頼む」
		CASE 2
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「何にする。迷うなら、_一人称_が決める」
		CASE 3
			;図書室で司書中
			KSTR:(K++) = 「静かにしろ。画集の棚なら奥だ」
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 「そこ、走るな。溺れても知らんぞ」
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = 「網を引くのは嫌いじゃない。魚の色は、いい」
		CASE 6
			;遊覧船・海底散歩でシーガイド中
			KSTR:(K++) = 「海の底の色を見せてやる。ついて来い」
		CASE 100 TO 199
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 100):0}(現在仕事:対象キャラ:1 - 100)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「欲しいものがあるなら言え。ないなら帰れ」
				CASE "土産物屋"
					KSTR:(K++) = 「土産か。この辺りの色なら、悪くない」
				CASE "食事処"
					KSTR:(K++) = 「注文は短く。厨房は戦場だ」
				CASE "装飾品店"
					KSTR:(K++) = 「_二人称_には、こっちの石の方が合う」
				CASE "直売所"
					KSTR:(K++) = 「採れたてだ。形が悪いのは安い」
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置
;状況で分岐

IF CFLAG:対象キャラ:飲み会
	;飲み会中
	KSTR:(K++) = 「もう一杯だ。……まだ、酔ってない」
ELSEIF CFLAG:対象キャラ:睡眠
	;ダウン・睡眠中
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「……もう、指一本、動かん……」
	ELSEIF 陥落チェック_性的(対象キャラ) && RAND:3
;		;寝言で甘えさせたい場合
		KSTR:(K++) = 「……ん……そこに、いろ……」
	ELSE
		KSTR:(K++) = 「……すぅ……」
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中
	;デートの相手のキャラ番号 + 100が入っている
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	KSTR:(K++) = 「次はどこに行く。退屈させるなよ」
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	;一緒に遊ぶ中
	KSTR:(K++) = 「勝つまでやるぞ。逃げるなよ」
ELSEIF CFLAG:対象キャラ:同行
	;同行中
	KSTR:(K++) = 「どこへ行く。面白いものがあれば止まるぞ」
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;一緒に隠密中
	KSTR:(K++) = 「息を潜めろ。気配が漏れてる」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	;あなたが隠れていて、キャラはあなたに気づいていない
	KSTR:(K++) = 「ふぅ。今日の色は、悪くない」
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;キャラの野外オナニー中
	KSTR:(K++) = 「……っ、誰も、来るなよ……」
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「あいつ、今日は何を持ってくるか」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「暇だな。あいつでも探すか」
			CASEELSE
				KSTR:(K++) = 「暇だ。何か描くものはないか」
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「面倒事は、あいつに投げておけばいい」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「ここの仕事も、慣れれば悪くない」
			CASEELSE
				KSTR:(K++) = 「この島の連中は、呑気だな」
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「あいつの顔を描くと、どうも筆が遅くなる」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「今、あいつのことを考えていたか？ ……違う」
			CASEELSE
				KSTR:(K++) = 「海の色を探しに行くか」
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「……ちっ。あいつのせいで、身体が熱い」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「あいつの身体の線、一度ちゃんと描いてみたいな」
			CASEELSE
				KSTR:(K++) = 「煙草が切れそうだ」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_1384(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;基本的にWAIT系列は使わないことを推奨

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「知らん顔だ」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「名前くらいは聞いた気がする」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「ここの主だったか。暇潰しにはなる」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「話していて退屈しない。それで十分だ」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「あいつといると、時間の進みが妙に速い」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「あいつ以外に、_一人称_の与太話を最後まで聞く奴はいない」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


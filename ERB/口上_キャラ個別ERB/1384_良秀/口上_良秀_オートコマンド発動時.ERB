		KSTR:(K++) = 「こんな所で、何をこそこそしてる」
		KSTR:(K++) = 物陰から現れた良秀は、愉しげに%CALLNAME:PLAYER%の手元を覗き込んだ。
		KSTR:(K++) = 「なんだ、手伝ってやろうか_H_」
	ELSEIF 知識素質:AUTOCOM_実行番号保存:性知識 < 0
		;無知や獣並で自慰のことを知らず、あなたに聞いてくるパターン
		KSTR:(K++) = 「隠れて何をしてるんだ？ 新しい遊びか」
	ELSE
		;立ち去るパターン
		KSTR:(K++) = 「見なかったことにしてやる。貸しだぞ」
	ENDIF
ELSE
	;隠密せず自慰したら、キャラの方が隠密していたパターン
	;つまりキャラが野外オナニーをしていたパターンと同義
	KSTR:(K++) = 「……_二人称_もか」

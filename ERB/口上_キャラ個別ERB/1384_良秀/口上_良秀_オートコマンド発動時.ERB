;--------------------------------------------------
@KOJO_AUTOCOM_1384_12(対象キャラ)
#DIM 対象キャラ
;欲情フィールド展開時、非うふふ状態の時、うふふしたことがあるキャラと同室していると発動
CALL 口上変数初期化

; RFLAG:コマンド結果受渡し変数 = セクハラ部位
; RFLAG:コマンド結果受渡し変数２ = セクハラ快楽量
; PALAM:PLAYER:(RFLAG:コマンド結果受渡し変数)で現在の快楽蓄積値が取得可能
; 絶頂したかどうかはTFLAG:調教者絶頂強度で取れる
; ただし、あなた射精時の口上については@KOJO_ORGASM_被射精_1384で記述した方が良い

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		;Cセクハラ時
		IF GETBIT(TALENT:PLAYER:性別, 1)
			;ペニスあり
			KSTR:(K++) = 良秀は背後から%CALLNAME:PLAYER%の股間へ手を伸ばし、器用な指先でなぞり上げた。
			KSTR:(K++) = 「筆と同じだ。力の入れ具合ひとつで、反応が変わる」
		ELSE
			;ペニスなし
			KSTR:(K++) = 良秀は背後から%CALLNAME:PLAYER%の股間へ手を伸ばし、器用な指先でなぞり上げた。
			KSTR:(K++) = 「ほう、ここか。いい反応だ」
		ENDIF
	CASE 1
		;Vセクハラ時
		KSTR:(K++) = 「動くな。指一本で、どこまで崩れるか見てやる」
		KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の反応を観察するように、指をゆっくりと沈めていく。
	CASE 2
		;Aセクハラ時
		KSTR:(K++) = 「くく、後ろは無防備だな」
		KSTR:(K++) = 良秀は意地悪く笑い、%CALLNAME:PLAYER%の後ろの窄まりへ指を這わせた。
	CASE 3
		;Bセクハラ時
		KSTR:(K++) = 良秀は%CALLNAME:PLAYER%の胸に手を当て、形を確かめるように撫で回した。
		KSTR:(K++) = 「デッサンの参考だ。じっとしてろ」
ENDSELECT


CALL 口上変数表示(対象キャラ, 0)


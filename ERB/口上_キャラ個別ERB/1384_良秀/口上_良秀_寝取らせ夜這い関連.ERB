;--------------------------------------------------
;良秀（1384）用の口上ひな形。
;口上本文は未記入。関数宣言と処理行は有効化している。
;本文未記入の関数も含めて登録している。
;台詞を追加するときは、各関数の空欄に記入する。
;本文未記入の口上変数への代入行も有効化している。
;元からある説明コメントは解除しない。TRYCALLFORMの振り分けも有効化している。
;--------------------------------------------------

;****************************************
;寝取らせ夜這いイベントの発生時に表示される文章
;****************************************
;・使い方
;キャラクター番号は1384に設定済み。各関数に処理を入れる
;※差し出してくる側の口上
;****************************************

;良秀は倒錯的な素質持ち。差し出した相手が抱かれる姿を「画」として見たがる方向で書く

;--------------------------------------------------
;訪問時
;　RETURN 0以外でデフォルト文章をスキップ
;--------------------------------------------------
@KOJO_EVENT_寝取らせ夜這い_訪問_1384(主導キャラ, 献上品キャラ)
#DIM 主導キャラ
#DIM 献上品キャラ
CALL 口上変数初期化

;良秀用の画像はないのでコメントアウト（ハル子と同じ）
;CALL PRINT_STRW(@"IMAGEPATH_%CSTR:主導キャラ:画像フォルダ%/寝取らせ夜這い_献上_%CALLNAME:献上品キャラ%")
KSTR:(K++) = 「起きてるな。頼みがある。……こいつを抱け」
KSTR:(K++) = 良秀は%CALLNAME:献上品キャラ%の背を押し、%CALLNAME:PLAYER%の前へ突き出した。
KSTR:(K++) = 「何だその顔は。_一人称_は見ているだけだ。
KSTR:(K++) = 　こいつが他の奴に崩される顔を、一度この目で見ておきたい」
CALL 口上変数表示(主導キャラ, 0)
RETURN 0

;--------------------------------------------------
;受諾時テキスト
;　RETURN 0以外でデフォルト文章をスキップ
;--------------------------------------------------
@KOJO_EVENT_寝取らせ夜這い_受諾_1384(主導キャラ, 献上品キャラ)
#DIM 主導キャラ
#DIM 献上品キャラ
CALL 口上変数初期化

;RFLAG:コマンド結果受渡し変数２には、本体が選択肢の番号を記録している（0 受け入れる、2 一緒に誘ってみる）
IF RFLAG:コマンド結果受渡し変数２ == 2
	;一緒に誘われた：見ているつもりが、自分も混ざることになる
	;この選択肢が出るのは、良秀があなたに恋慕かセフレのときか、あなたとうふふ済みのとき
	IF 口上_関係性判定_3652(主導キャラ, MASTER, "恋慕")
		;恋慕：あなたに求められると歯止めが利かなくなる
		KSTR:(K++) = 「話が早い。行け、_一人称_はそこで……おい、何の真似だ」
		KSTR:(K++) = 椅子へ向かいかけた良秀の手首を、%CALLNAME:PLAYER%が掴んで引き戻した。
		KSTR:(K++) = 「_一人称_は見に来ただけだと言っただろう。
		KSTR:(K++) = 　ちっ。_二人称_にそういう目で見られると、断る理由が出てこん」
		KSTR:(K++) = 良秀は抱えていたスケッチブックを床に放ると、シャツのボタンを上から乱暴に外していった。
		KSTR:(K++) = 驚いて顔を上げた%CALLNAME:献上品キャラ%の顎を指先で持ち上げ、良秀は口の端を吊り上げる。
		KSTR:(K++) = 「こいつが崩れる顔は、隣で見る方がよく見える。
		KSTR:(K++) = 　_二人称_の顔もな。二人まとめて、目に焼きつけてやる」
	ELSEIF 口上_関係性判定_3652(主導キャラ, MASTER, "セフレ")
		;セフレ：満更でもないが、乗り気な自分に舌打ちする
		KSTR:(K++) = 「おい、離せ。_一人称_は見る側だと言っただろう」
		KSTR:(K++) = 椅子を引き寄せようとした良秀の腕を、%CALLNAME:PLAYER%が掴んでベッドの方へ引いた。
		KSTR:(K++) = 振りほどこうとした良秀の手が止まる。%CALLNAME:献上品キャラ%を連れてくると決めた時から、下腹の奥はとっくに熱を持っていた。
		;ふ・ま・く＝二人まとめて崩してやる
		KSTR:(K++) = 「……ちっ。性欲に負けて画を捨てるとはな。
		KSTR:(K++) = 　いいだろう。ふ・ま・く。二人まとめて崩してやる」
		KSTR:(K++) = 良秀は咥えていた煙草を揉み消し、ベルトを外しながらベッドに膝をついた。
	ELSE
		;うふふ済みなだけ：渋るが、結局は熱に負ける
		KSTR:(K++) = 「は？ _一人称_もだと？ 一度や二度寝たくらいで、図に乗るな」
		KSTR:(K++) = 良秀は掴まれた手首を見下ろして顔をしかめたが、振りほどこうとはしなかった。
		KSTR:(K++) = 「……今夜だけだ。描く側が画の中に入るなど、どうかしている」
		KSTR:(K++) = 吐き捨てるように言いながら、良秀は自分から上着を脱ぎ、%CALLNAME:献上品キャラ%の隣に腰を下ろした。
	ENDIF
	KSTR:(K++) =
	;ここから本体の標準文章（浮気・言いなりの知らせ）の代わり。この分岐では標準文章を飛ばす
	;浮気の知らせは、本体と同じく良秀と献上品キャラが恋人同士のときだけ出す
	;献上品キャラに浮気の素質がつくのはこの口上のあと（本体）なので、初めてなら0のまま
	IF 口上_関係性判定_3652(主導キャラ, 献上品キャラ, "恋慕")
		IF TALENT:献上品キャラ:浮気 == 0
			IF TALENT:献上品キャラ:処女 && GETBIT(TALENT:献上品キャラ:性別, 0)
				KSTR:(K++) = 良秀にもまだ許していない身体を、%CALLNAME:献上品キャラ%はその良秀と一緒に、%CALLNAME:PLAYER%へ差し出すことになる。
			ELSE
				KSTR:(K++) = 恋人の良秀が同じベッドにいようと、%CALLNAME:献上品キャラ%を抱くのは%CALLNAME:PLAYER%だ。
			ENDIF
			NSTR:(K++) = これが%CALLNAME:献上品キャラ%にとって、初めての
			KCOLOR:K = カラーパレット("えっちな色")
			NSTR:(K++) = [浮気]
			KSTR:(K++) = になる。
		ELSE
			NSTR:(K++) = %CALLNAME:献上品キャラ%にとって、
			KCOLOR:K = カラーパレット("えっちな色")
			NSTR:(K++) = [浮気]
			KSTR:(K++) = はもう初めてではない。ただ今夜は、恋人の良秀も同じベッドの上にいる。
		ENDIF
		KSTR:(K++) =
	ENDIF
	;言いなりの知らせ。一緒に誘ったときは良秀も言いなりになる（本体）
	NSTR:(K++) = 良秀の願いを叶えるために、%CALLNAME:献上品キャラ%はこの一晩%CALLNAME:PLAYER%の
	KCOLOR:K = カラーパレット("えっちな色")
	NSTR:(K++) = [言いなり]
	KSTR:(K++) = だ。
	NSTR:(K++) = 口では偉そうなままだが、誘いに乗った良秀もまた、今夜は
	KCOLOR:K = カラーパレット("えっちな色")
	NSTR:(K++) = [言いなり]
	KSTR:(K++) = になっている。二人とも、望めばなんだってしてくれるだろう……
ELSE
	KSTR:(K++) = 「話が早い。……行け。_一人称_はそこで見ている」
	KSTR:(K++) = 良秀は部屋の隅の椅子を引き寄せて腰掛け、膝の上にスケッチブックを広げた。
ENDIF
CALL 口上変数表示(主導キャラ, 0)
IF RFLAG:コマンド結果受渡し変数２ == 2
	;口上を表示できたとき（RESULT 1）だけ、本体の標準文章を飛ばす。口上が非表示のときは標準文章が出る
	RETURN RESULT
ENDIF
RETURN 0


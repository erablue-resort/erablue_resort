@時空移動設定_2199(対象キャラ)
#FUNCTIONS
#DIM 対象キャラ
#DIMS 素質名
#DIMS 素質解説
;時空移動素質を持つキャラの、素質名や素質解説などを設定する
;時空移動素質がないキャラには無意味

素質名 = 時間遡行の魔法;ここに素質名を入れる
SELECTCASE TALENT:対象キャラ:恋慕
	CASE 0
		素質解説 = 親友であるまどかを救うため、時間を越えて過去をやり直す魔法。<br>
		素質解説 += "空の世界では魔女がいないので、こちらの世界にいる限りは無用の長物。<br>"
		素質解説 += "しかし万が一のためにいつでも使えるよう備えている。"
	CASE 1
		素質解説 = 親友であるまどかを救うため、時間を越えて過去をやり直す魔法。<br>
		素質解説 += "ワルプルギスの夜でまどかが死ぬことはもうない。<br>"
		素質解説 += "もうこの魔法を使うことはないだろう、と思っている。"
	CASE 2
		素質解説 = 親友であるまどかを救うため、時間を越えて過去をやり直す魔法だった。<br>
		素質解説 += @"%CALLNAME:MASTER%との繋がりと星晶獣の力によって、この魔法は変質した。<br>"
		素質解説 += "愛する人との穏やかな日々を過ごすため、自身が望む限り幾つもの人生を歩むことが出来る。<br>"
		素質解説 += @"%CALLNAME:MASTER%の隣で。<br>"
ENDSELECT

;------------ここから下は弄らない------------
RESULTS:0 '= 素質名
RESULTS:1 '= 素質解説

RETURNF RESULTS:0


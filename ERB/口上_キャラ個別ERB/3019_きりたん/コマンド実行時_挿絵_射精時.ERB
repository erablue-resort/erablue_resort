;--------------------------------------------------
;調教者の射精時
;--------------------------------------------------
@KOJO_ORGASM_被射精_3019(対象キャラ)

#DIM 対象キャラ
#DIM 相手キャラ番号

;RFLAG:フィニッシュ場所
	;どこに出されたか  
;RCVAR:対象キャラ:被射精絶頂の強度
	;１以上だと射精された時にキャラも絶頂
	;現状はフィニッシュ場所が0～3の時しか起こらない
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	SELECTCASE RFLAG:フィニッシュ場所
		CASE 0
			;膣内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				;射精による快楽で絶頂した時
				;KSTR:(K++) = 
			ELSE
				;KSTR:(K++) = 
			ENDIF
			
			;正常位、後背位、寝バック、対面座位、背面座位、騎乗位、側位、屈曲位、駅弁、背面駅弁、対面立位、立ちバック
			IF MODE_存在判定_完全一致("正常位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-正常位")
			ELSEIF MODE_存在判定_完全一致("後背位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-後背位")
			ELSEIF MODE_存在判定_完全一致("寝バック", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-寝バック")
			ELSEIF MODE_存在判定_完全一致("対面座位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-対面座位")
			ELSEIF MODE_存在判定_完全一致("背面座位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-背面座位")
			ELSEIF MODE_存在判定_完全一致("騎乗位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-騎乗位")
			ELSEIF MODE_存在判定_完全一致("側位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-側位")
			ELSEIF MODE_存在判定_完全一致("屈曲位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-屈曲位")
			ELSEIF MODE_存在判定_完全一致("駅弁", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-駅弁")
			ELSEIF MODE_存在判定_完全一致("背面駅弁", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-背面駅弁")
			ELSEIF MODE_存在判定_完全一致("対面立位", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-対面立位")
			ELSEIF MODE_存在判定_完全一致("立ちバック", MASTER, 対象キャラ)
				CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-膣内-立ちバック")
			ENDIF
		CASE 1
			;腸内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				;射精による快楽で絶頂した時
				;KSTR:(K++) = 
			ELSE
				;KSTR:(K++) = 
			ENDIF
			
			CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-腸内")
		CASE 2
			;口
			IF RCVAR:対象キャラ:精飲フラグ > 1
			;喜んで飲む
				IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					;KSTR:(K++) = 
				ELSE
					;KSTR:(K++) = 
				ENDIF
			ELSEIF RCVAR:対象キャラ:精飲フラグ
			;なんとか飲み込む
				IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					;KSTR:(K++) = 
				ELSE
					;KSTR:(K++) = 
				ENDIF
			ELSEIF ABL:対象キャラ:技巧 > 2
			;ティッシュに吐き出す
				;KSTR:(K++) = 
			ELSE
			;吐き出してむせる
				;KSTR:(K++) = 
			ENDIF
			
			CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-口")
		CASE 3
			;乳内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				;KSTR:(K++) = 
			ELSE
				;KSTR:(K++) = 
			ENDIF
			
			CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-乳内")
		CASE 5
			;顔
			;KSTR:(K++) = 
			
            CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-顔")
		CASE 6
			;腹
			;KSTR:(K++) = 
			
            CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-腹")
		CASE 7
			;背中
			;KSTR:(K++) = 
            
            CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-背中")
		CASE 8
			;太もも
			;KSTR:(K++) = 
			
            CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-太もも")
		CASE 9
			;手のひら
			;KSTR:(K++) = 
			
            CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-手のひら")
		CASE 10
			;足
			;KSTR:(K++) = 
			
            CALL コマンド実行時画像表示処理(対象キャラ, "独自-射精時-足")
		CASE 30
			IF CFLAG:対象キャラ:うふふ
				;うふふ中汎用射精
				;KSTR:(K++) = 
			ELSE
				;非うふふ時の射精、逆セクハラなど
				;KSTR:(K++) = 
			ENDIF
	ENDSELECT
ENDIF

;CALL 口上変数表示(対象キャラ, 0)



@固有アビ_1192_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM プラプラしきい値
#DIM プラスしきい値
#DIM 威力値
#DIM バフ_通常攻撃ダメージ補正値
#DIM バフ_奥義ダメージ補正値

	;どのレベルで強化されるかを設定
	プラプラしきい値 = 32
	プラスしきい値 = 20

	IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラプラしきい値
		アビ名 = 水破・兵破＋＋
		消費ＭＰ = 54
		威力値 = 175
		バフ_通常攻撃ダメージ補正値 = 50
		バフ_奥義ダメージ補正値 = 40
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
		アビ名 = 水破・兵破＋
		消費ＭＰ = 40
		威力値 = 130
		バフ_通常攻撃ダメージ補正値 = 50
		バフ_奥義ダメージ補正値 = 0
	ELSE
		アビ名 = 水破・兵破
		消費ＭＰ = 13
		威力値 = 100
		バフ_通常攻撃ダメージ補正値 = 40
		バフ_奥義ダメージ補正値 = 0
	ENDIF

	;この中からランダムで１行選択し実行時メッセージ１に代入される
	STRDATA アビ汎用文字列:実行時メッセージ１
		DATAFORM 「せいッ！」
		DATAFORM 「やぁッ！」
		DATAFORM 「はッ！」
		DATAFORM 「逃がしはしません！」
	ENDDATA

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += "<br>敵単体に［{威力値}％］の自属性ダメージを2回与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［{バフ_通常攻撃ダメージ補正値}％］（Ｂ枠・3ターン）のダメージ補正_通常攻撃ダメージ上昇効果を与える。"

			;++でのみ奥義ダメージ補正追加
			SIF 基礎BATTLE_STATE:キャラ番号:Lv >= プラプラしきい値
				詳細文文字列受け渡し変数 += "<br>味方全体に［{バフ_奥義ダメージ補正値}％］（Ｂ枠・3ターン）のダメージ補正_奥義ダメージ上昇効果を与える。"
		CASE "アビ効果"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用変数:効果割合 = 威力値
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 2
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT

			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
			アビ汎用文字列:バフ・デバフ枠 = ダメージ補正_通常攻撃ダメージB
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_通常攻撃ダメージ
			アビ汎用変数:効果割合 = バフ_通常攻撃ダメージ補正値
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット

			;++だったら追加で奥義ダメージ補正
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラプラしきい値
				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_味方全体
				アビ汎用文字列:バフ・デバフ枠 = ダメージ補正_奥義ダメージB
				アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
				アビ汎用変数:効果割合 = バフ_奥義ダメージ補正値
				アビ汎用変数:持続ターン = 3
				CALL アビテンプレート_有利効果_バフ効果セット
			ENDIF
	ENDSELECT



@固有アビ_1192_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 隊列番号
#DIM CD
#DIM CTNOW
#DIM 残りCT
#DIM プラプラしきい値
#DIM プラスしきい値
#DIM 習得しきい値
#DIM バフ_DA上昇値
#DIM バフ_TA上昇値
#DIM バフ_クリティカル上昇値
#DIM バフ_クリティカルダメージ上昇値

;	プラプラしきい値 = 9999
	プラスしきい値 = 30
	習得しきい値 = 5

	IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
		アビ名 = 源氏の武練 EX
		消費ＭＰ = 60
		バフ_DA上昇値 = 0
		バフ_TA上昇値 = 100
		バフ_クリティカル上昇値 = 100
		バフ_クリティカルダメージ上昇値 = 50
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 習得しきい値
		アビ名 = 無窮の武練 A＋
		消費ＭＰ = 40
		バフ_DA上昇値 = 100
		バフ_TA上昇値 = 0
		バフ_クリティカル上昇値 = 100
		バフ_クリティカルダメージ上昇値 = 0
	;レベルが一定以下なら覚えてないよー
	ELSE
		;アビ名を空欄にすると未習得扱いになる
		アビ名 = 
	ENDIF

	;クールダウン確認
	隊列番号 = キャラ隊列検索(キャラ番号)
	;確認するCT番号をセット
	CTNOW = 1
	;クールダウン設定
	CD = 5

	;CTの明記・追記表示
	;アビ名が空欄でなく、隊列内にいる場合
	IF 隊列番号 > -1 && アビ名 != ""
		残りCT = 戦闘中カウント:隊列番号:CTNOW + CD - 現在ターン数
		;かつ、残りCTがあるなら、アビ名に「残りCT」を表示
		SIF 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:残りCT + CD)
			アビ名 += @" CT:{残りCT}"
	ENDIF

	;クールタイムが明けてないなら使用禁止
	SIF 隊列番号 > -1 && 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:CTNOW + 1)
		アビテンプレート用_アビ封印用フラグ = 1

	;この中からランダムで１行選択し実行時メッセージ１に代入
	STRDATA アビ汎用文字列:実行時メッセージ１
		DATAFORM 「手遊びのようなものですが」
		DATAFORM 「ご覧になってください」
		DATAFORM 「思い上がりましたねぇ」
		DATAFORM 「御覚悟、どうぞ」
	ENDDATA

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
				詳細文文字列受け渡し変数 += "<br>自身に［{バフ_TA上昇値}］（Ｂ枠・3ターン）のTA率上昇効果を与える。"
				詳細文文字列受け渡し変数 += "<br>［{バフ_クリティカル上昇値}］（Ｂ枠・3ターン）のクリティカル率上昇効果を与える。"
				詳細文文字列受け渡し変数 += "<br>［{バフ_クリティカルダメージ上昇値}％］（Ｂ枠・3ターン）のクリティカルダメージ率上昇効果を与える。"
			ELSE
				詳細文文字列受け渡し変数 += "<br>自身に［{バフ_DA上昇値}］（Ｂ枠・3ターン）のDA率上昇効果を与える。"
				詳細文文字列受け渡し変数 += "<br>［{バフ_クリティカル上昇値}］（Ｂ枠・3ターン）のクリティカル率上昇効果を与える。"
			ENDIF
			詳細文文字列受け渡し変数 += @"<br>このアビリティでは行動回数を消費しない。"
			詳細文文字列受け渡し変数 += @"<br>使用後{CD}ターン使用不能。"

			RETURN 消費ＭＰ
		CASE "アビ効果"
			;行動消費なし（CTありで連続使用はできない）
			アビテンプレート用_行動消費無しフラグ = 1
			CALL アビ対象選択テンプレート_自己のみ

			;源氏の場合はTA率
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
				アビ汎用文字列:バフ・デバフ枠 = TA率B
				アビ汎用文字列:バフ・デバフ対象能力 = TA率
				アビ汎用変数:効果量 = バフ_TA上昇値
				アビ汎用変数:持続ターン = 3
				CALL アビテンプレート_有利効果_バフ効果セット
			;無窮の場合はDA率
			ELSE
				アビ汎用文字列:バフ・デバフ枠 = DA率B
				アビ汎用文字列:バフ・デバフ対象能力 = DA率
				アビ汎用変数:効果量 = バフ_DA上昇値
				アビ汎用変数:持続ターン = 3
				CALL アビテンプレート_有利効果_バフ効果セット
			ENDIF

			;CT率は共通
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = クリティカル率B
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
			アビ汎用変数:効果量 = バフ_クリティカル上昇値
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット

			;源氏の場合はクリティカルダメージも追加
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
				CALL アビ汎用変数文字列リセット
				アビ汎用文字列:バフ・デバフ枠 = クリティカルダメージ率B
				アビ汎用文字列:バフ・デバフ対象能力 = クリティカルダメージ率
				アビ汎用変数:効果割合 = バフ_クリティカルダメージ上昇値
				アビ汎用変数:持続ターン = 3
				CALL アビテンプレート_有利効果_バフ効果セット
			ENDIF

			;クールダウン確認用のターン数をセット
			戦闘中カウント:隊列番号:CTNOW = 現在ターン数
	ENDSELECT



@固有アビ_1192_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 隊列番号
#DIM CD
#DIM CTNOW
#DIM 残りCT
#DIM プラプラしきい値
#DIM プラスしきい値
#DIM 習得しきい値
#DIM バフ_与ダメージ上昇値
#DIM バフ_回避率上昇値
#DIM バフ_奥義ゲージUP値

;	プラプラしきい値 = 9999
	プラスしきい値 = 25
	習得しきい値 = 10

	IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
		アビ名 = 雷神の顕 A＋
		消費ＭＰ = 85
		バフ_与ダメージ上昇値 = 70
		バフ_回避率上昇値 = 100
		バフ_奥義ゲージUP値 = 30
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 習得しきい値
		アビ名 = 魔力放出（雷） A
		消費ＭＰ = 70
		バフ_与ダメージ上昇値 = 50
		バフ_回避率上昇値 = 100
		バフ_奥義ゲージUP値 = 0
	ELSE
		アビ名 = 
	ENDIF

	;クールダウン確認
	隊列番号 = キャラ隊列検索(キャラ番号)
	;確認するCT番号をセット
	CTNOW = 2
	;クールダウン設定
	CD = 4

	;CTの明記・追記表示
	;アビ名が空欄でなく、隊列内にいる場合
	IF 隊列番号 > -1 && アビ名 != ""
		残りCT = 戦闘中カウント:隊列番号:CTNOW + CD - 現在ターン数
		;かつ、残りCTがあるなら、アビ名に「残りCT」を表示
		SIF 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:残りCT + CD)
			アビ名 += @" CT:{残りCT}"
	ENDIF

	;クールタイムが明けてないなら使用禁止
	SIF 隊列番号 > -1 && 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:CTNOW + 1)
		アビテンプレート用_アビ封印用フラグ = 1

	;この中からランダムで１行選択し実行時メッセージ１に代入
	STRDATA アビ汎用文字列:実行時メッセージ１
		DATAFORM 「では、そのように」
		DATAFORM 「ご覧になってください」
		DATAFORM 「御命令とあらば」
		DATAFORM 「ええ、はい♪」
	ENDDATA

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += "<br>自身に［{バフ_与ダメージ上昇値}％］（Ｃ枠・1ターン）の与ダメージ上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［{バフ_回避率上昇値}］（Ｃ枠・1ターン）の回避率上昇効果を与える。"
			;雷神のときのみ奥義ゲージUPが追加
			SIF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
				詳細文文字列受け渡し変数 += "<br>［{バフ_奥義ゲージUP値}］の奥義ゲージUP効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>このアビリティでは行動回数を消費しない。"
			詳細文文字列受け渡し変数 += @"<br>使用後{CD}ターン使用不能。"
			RETURN 消費ＭＰ
		CASE "アビ効果"
			アビテンプレート用_行動消費無しフラグ = 1
			CALL アビ対象選択テンプレート_自己のみ

			;与ダメージ上昇部分
			アビ汎用文字列:バフ・デバフ枠 = 与ダメージC
			アビ汎用文字列:バフ・デバフ対象能力 = 与ダメージ
			アビ汎用変数:効果割合 = バフ_与ダメージ上昇値
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット

			;回避率上昇
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 回避率C
			アビ汎用文字列:バフ・デバフ対象能力 = 回避率
			アビ汎用変数:効果量 = バフ_回避率上昇値
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット

			;雷神のときのみ奥義ゲージUPが追加
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
				CALL アビ汎用変数文字列リセット
				アビ汎用変数:効果量 = 30
				CALL アビテンプレート_有利効果_奥義ゲージUP
			ENDIF

			;クールダウン確認用のターン数をセット
			戦闘中カウント:隊列番号:CTNOW = 現在ターン数
	ENDSELECT



@固有アビ_1192_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM プラプラしきい値
#DIM プラスしきい値
#DIM 習得しきい値
#DIM 威力値
#DIM 攻撃回数
#DIM 攻撃対象数
#DIM 即死付与率

;	プラプラしきい値 = 9999
	プラスしきい値 = 45
	習得しきい値 = 21

	IF 基礎BATTLE_STATE:キャラ番号:Lv >= プラスしきい値
		アビ名 = 童子切安綱＋
		消費ＭＰ = 90
		攻撃対象数 = 4
		攻撃回数 = 4
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 習得しきい値
		アビ名 = 童子切安綱
		消費ＭＰ = 60
		攻撃対象数 = 3
		攻撃回数 = 3
	ENDIF

	威力値 = 100
	即死付与率 = 100

	;この中からランダムで１行選択し実行時メッセージ１に代入
	STRDATA アビ汎用文字列:実行時メッセージ１
		DATAFORM 「容赦しませんから！」
		DATAFORM 「──せいッ！」
		DATAFORM 「如何です！」
		DATAFORM 「ならば御覧に入れましょう」
		DATAFORM 「いざ、御免！」
	ENDDATA

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += "<br>敵ランダム{攻撃対象数}体に［{威力値}％］の自属性ダメージを{攻撃回数}回与える。"
			詳細文文字列受け渡し変数 += "<br>即死効果を与える。付与率{即死付与率}％。"
			RETURN 消費ＭＰ
		CASE "アビ効果"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵ランダムＸ体(攻撃対象数)
			アビ汎用変数:効果割合 = 威力値
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 攻撃回数
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT

			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 即死付与率
			CALL アビテンプレート_不利効果_即死
	ENDSELECT





@固有アビ_1192_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
	アビ名 = 水破・兵破＋＋
	消費ＭＰ = 54
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
	アビ名 = 水破・兵破＋
	消費ＭＰ = 40
ELSEIF 1
	アビ名 = 水破・兵破
	消費ＭＰ = 13
ENDIF

SELECTCASE RAND:4
CASE 0
	アビ汎用文字列:実行時メッセージ１ = 「せいッ！」
CASE 1
	アビ汎用文字列:実行時メッセージ１ = 「やぁッ！」
CASE 2
	アビ汎用文字列:実行時メッセージ１ = 「はッ！」
CASEELSE
	アビ汎用文字列:実行時メッセージ１ = 「逃がしはしません！」
ENDSELECT


SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
			詳細文文字列受け渡し変数 = 消費ＭＰ：54
			詳細文文字列受け渡し変数 += "<br>敵単体に［175％］の自属性ダメージを2回与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［50％］（Ｂ枠・3ターン）のダメージ補正_通常攻撃ダメージ上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［40％］（Ｂ枠・3ターン）のダメージ補正_奥義ダメージ上昇効果を与える。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
			詳細文文字列受け渡し変数 = 消費ＭＰ：40
			詳細文文字列受け渡し変数 += "<br>敵単体に［130％］の自属性ダメージを2回与える。"
			詳細文文字列受け渡し変数 += "<br>自身に［50％］（Ｂ枠・3ターン）のダメージ補正_通常攻撃ダメージ上昇効果を与える。"
		ELSEIF 1
			詳細文文字列受け渡し変数 = 消費ＭＰ：13
			詳細文文字列受け渡し変数 += "<br>敵単体に［100％］の自属性ダメージを2回与える。"
			詳細文文字列受け渡し変数 += "<br>自身に［40％］（Ａ枠・3ターン）のダメージ補正_通常攻撃ダメージ上昇効果を与える。"
		ENDIF
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用変数:効果割合 = 175
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 2
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
			アビ汎用文字列:バフ・デバフ枠 = ダメージ補正_通常攻撃ダメージB
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_通常攻撃ダメージ
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
			アビ汎用文字列:バフ・デバフ枠 = ダメージ補正_奥義ダメージB
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
			アビ汎用変数:効果割合 = 40
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用変数:効果割合 = 130
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 2
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = ダメージ補正_通常攻撃ダメージB
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_通常攻撃ダメージ
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 1
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 2
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = ダメージ補正_通常攻撃ダメージA
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_通常攻撃ダメージ
			アビ汎用変数:効果割合 = 40
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
ENDSELECT

@固有アビ_1192_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 隊列番号
#DIM CD
#DIM CTNOW

CTNOW = 1
隊列番号 = キャラ隊列検索(キャラ番号)

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
	アビ名 = 源氏の武練 EX
	消費ＭＰ = 60
	CD = 5
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 5
	アビ名 = 無窮の武練 A＋
	消費ＭＰ = 40
	CD = 5
ENDIF

SIF 隊列番号 > -1 && 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:CTNOW + 1)
	アビテンプレート用_アビ封印用フラグ = 1

SELECTCASE RAND:4
CASE 0
	アビ汎用文字列:実行時メッセージ１ = 「手遊びのようなものですが」
CASE 1
	アビ汎用文字列:実行時メッセージ１ = 「ご覧になってください」
CASE 2
	アビ汎用文字列:実行時メッセージ１ = 「思い上がりましたねぇ」
CASEELSE
	アビ汎用文字列:実行時メッセージ１ = 「御覚悟、どうぞ」
ENDSELECT

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
			詳細文文字列受け渡し変数 = 消費ＭＰ：50
			詳細文文字列受け渡し変数 += "<br>自身に［100］（Ｂ枠・3ターン）のTA率上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［100］（Ｂ枠・3ターン）のクリティカル率上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［50％］（Ｂ枠・3ターン）のクリティカルダメージ率上昇効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>使用後1ターン使用不能"
			詳細文文字列受け渡し変数 += @"　　　　このアビリティでは行動回数を消費しない。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 5
			詳細文文字列受け渡し変数 = 消費ＭＰ：35
			詳細文文字列受け渡し変数 += "<br>自身に［100］（Ｂ枠・3ターン）のDA率上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［100］（Ｂ枠・3ターン）のクリティカル率上昇効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>使用後1ターン使用不能"
			詳細文文字列受け渡し変数 += @"　　　　このアビリティでは行動回数を消費しない。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
			アビテンプレート用_行動消費無しフラグ = 1


			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = TA率B
			アビ汎用文字列:バフ・デバフ対象能力 = TA率
			アビ汎用変数:効果量 = 100
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = クリティカル率B
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
			アビ汎用変数:効果量 = 100
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = クリティカルダメージ率B
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカルダメージ率
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 5
			アビテンプレート用_行動消費無しフラグ = 1


			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = DA率B
			アビ汎用文字列:バフ・デバフ対象能力 = DA率
			アビ汎用変数:効果量 = 100
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = クリティカル率B
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
			アビ汎用変数:効果量 = 100
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
		戦闘中カウント:隊列番号:CTNOW = 現在ターン数
ENDSELECT

@固有アビ_1192_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 隊列番号
#DIM CD
#DIM CTNOW

CTNOW = 2
隊列番号 = キャラ隊列検索(キャラ番号)

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 25
	アビ名 = 雷神の顕 A＋
	消費ＭＰ = 85
	CD = 4
	IF 隊列番号 > -1
		LOCAL = 戦闘中カウント:隊列番号:CTNOW + CD - 現在ターン数
		SIF 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:CTNOW + CD)
			アビ名 += @" CT:{LOCAL}"
	ENDIF
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
	アビ名 = 魔力放出（雷） A
	消費ＭＰ = 70
	CD = 4
	IF 隊列番号 > -1
		LOCAL = 戦闘中カウント:隊列番号:CTNOW + CD - 現在ターン数
		SIF 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:CTNOW + CD)
			アビ名 += @" CT:{LOCAL}"
	ENDIF
ENDIF

SIF 隊列番号 > -1 && 戦闘中カウント:隊列番号:CTNOW != 0 && 現在ターン数 < (戦闘中カウント:隊列番号:CTNOW + CD)
	アビテンプレート用_アビ封印用フラグ = 1

SELECTCASE RAND:4
CASE 0
	アビ汎用文字列:実行時メッセージ１ = 「では、そのように」
CASE 1
	アビ汎用文字列:実行時メッセージ１ = 「ご覧になってください」
CASE 2
	アビ汎用文字列:実行時メッセージ１ = 「御命令とあらば」
CASEELSE
	アビ汎用文字列:実行時メッセージ１ = 「ええ、はい♪」
ENDSELECT

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 25
			詳細文文字列受け渡し変数 = 消費ＭＰ：70
			詳細文文字列受け渡し変数 += "<br>自身に［70％］（Ｃ枠・1ターン）の与ダメージ上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［100］（Ｃ枠・1ターン）の回避率上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［30］の奥義ゲージUP効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>使用後{CD}ターン使用不能"
			詳細文文字列受け渡し変数 += @"　　　　このアビリティでは行動回数を消費しない。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
			詳細文文字列受け渡し変数 = 消費ＭＰ：70
			詳細文文字列受け渡し変数 += "<br>自身に［50％］（Ｃ枠・1ターン）の与ダメージ上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［100］（Ｃ枠・1ターン）の回避率上昇効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>使用後{CD}ターン使用不能"
			詳細文文字列受け渡し変数 += @"　　　　このアビリティでは行動回数を消費しない。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 25
			アビテンプレート用_行動消費無しフラグ = 1


			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = 与ダメージC
			アビ汎用文字列:バフ・デバフ対象能力 = 与ダメージ
			アビ汎用変数:効果割合 = 70
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 回避率C
			アビ汎用文字列:バフ・デバフ対象能力 = 回避率
			アビ汎用変数:効果量 = 100
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果量 = 30
			CALL アビテンプレート_有利効果_奥義ゲージUP
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
			アビテンプレート用_行動消費無しフラグ = 1


			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = 与ダメージC
			アビ汎用文字列:バフ・デバフ対象能力 = 与ダメージ
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 回避率C
			アビ汎用文字列:バフ・デバフ対象能力 = 回避率
			アビ汎用変数:効果量 = 100
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
		戦闘中カウント:隊列番号:CTNOW = 現在ターン数
ENDSELECT

@固有アビ_1192_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
	アビ名 = 童子切安綱＋
	消費ＭＰ = 90
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 21
	アビ名 = 童子切安綱
	消費ＭＰ = 60
ENDIF

SELECTCASE RAND:5
CASE 0
	アビ汎用文字列:実行時メッセージ１ = 「容赦しませんから！」
CASE 1
	アビ汎用文字列:実行時メッセージ１ = 「──せいッ！」
CASE 2
	アビ汎用文字列:実行時メッセージ１ = 「如何です！」
CASE 3
	アビ汎用文字列:実行時メッセージ１ = 「ならば御覧に入れましょう」
CASEELSE
	アビ汎用文字列:実行時メッセージ１ = 「いざ、御免！」
	ENDSELECT

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			詳細文文字列受け渡し変数 = 消費ＭＰ：95
			詳細文文字列受け渡し変数 += "<br>敵ランダム4体に［100％］の自属性ダメージを4回与える。"
			詳細文文字列受け渡し変数 += "<br>即死効果を与える。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 21
			詳細文文字列受け渡し変数 = 消費ＭＰ：55
			詳細文文字列受け渡し変数 += "<br>敵ランダム3体に［100％］の自属性ダメージを3回与える。"
			詳細文文字列受け渡し変数 += "<br>即死効果を与える。"
		ENDIF
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵ランダムＸ体(4)
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 4
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_即死
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 21
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵ランダムＸ体(3)
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 3
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_即死
		ENDIF
ENDSELECT

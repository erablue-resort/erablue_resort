;--------------------------------------------------
;COM20_キス
;--------------------------------------------------
;セクハラコマンドの方のキスを削除してこちらに合流
;「TFLAG:調教モード」で判別可能。  1:セクハラ時  2:セックス中

@KOJO_COM_1221_20(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｓ
;ランダム弱点コマンドの候補
CALL 口上開始_1221

IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE CUP:対象キャラ:快Ｓ
			;各部位の累積が10000で絶頂
			CASE IS > 10000
				;即絶頂
				KSTR:(K++) = 「ん、っ……　――っ」
				KSTR:(K++) = 「……申し訳、ございません。　口づけだけで、このような」
				KSTR:(K++) = 「メイド長の名が泣きますね。　どうか、ご内密に」
			CASE IS > 6000
				;かなり感じている
				KSTR:(K++) = 「ん、っ……　%CSTR:対象キャラ:二人称%、息が上がっていらっしゃいますよ？」
				KSTR:(K++) = 「……ええ。　私も、でございます」
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 「んっ……　はい。　もう一度、いかがですか？」
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 「不意打ちは、いけませんと申し上げましたのに」
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%。　目を閉じていらっしゃいませんでしたね？」
				KSTR:(K++) = 「ええ、私も開けておりました」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		KSTR:(K++) = 「あら。　こういうことは、なさらない方かと思っておりました」
		KSTR:(K++) = 「順番が、逆でございますね？」
	ELSE
		KSTR:(K++) = 「……%CSTR:対象キャラ:二人称%」
		KSTR:(K++) = 　拒まれはしなかった。ただ、%CALLNAME:対象キャラ%はしばらく口を開かなかった。
		KSTR:(K++) = 「うふふ。　メイドに口づけをなさる方は、そう多くございませんよ」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


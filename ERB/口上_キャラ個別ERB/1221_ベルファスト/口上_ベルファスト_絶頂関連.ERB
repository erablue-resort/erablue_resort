;--------------------------------------------------
;調教者の射精時
;--------------------------------------------------
@KOJO_ORGASM_被射精_1221(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;RFLAG:フィニッシュ場所
	;どこに出されたか  
;RCVAR:対象キャラ:被射精絶頂の強度
	;１以上だと射精された時にキャラも絶頂
	;現状はフィニッシュ場所が0～3の時しか起こらない
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	SELECTCASE RFLAG:フィニッシュ場所
		CASE 0
			;膣内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				;射精による快楽で絶頂した時
				WSTR:(K++) = 「っ……！　熱いものが、奥深くに……っ_H_　ご主人様と、一緒に……っ_H__H_！」
				KSTR:(K++) = 　
				KSTR:(K++) = 「……はぁっ_H_　ふふ、お腹の芯まで、ご主人様の色に染まってしまいました……_H_」
			ELSE
				KSTR:(K++) = 「ん……っ_H_　ご主人様の熱い雫、しかと奥でお預かりいたしました_H_」
				KSTR:(K++) = 「……たっぷりと注いでくださって、ありがとうございます。愛しておりますよ、ご主人様_H_」
			ENDIF
		CASE 1
			;腸内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				;射精による快楽で絶頂した時
				KSTR:(K++) = 「あ……んぅぅっ_H_　お尻の奥が満たされて……っ、達してしまいました……_H__H_」
			ELSE
				KSTR:(K++) = 「んっ……_H_　お尻の中まで、こんなにも熱く満たされるとは……_H_」
			ENDIF
		CASE 2
			;口
			IF RCVAR:対象キャラ:精飲フラグ > 1
			;喜んで飲む
				WSTR:(K++) = 「んむっ……ちゅ、じゅる……っ_H_　……ん、ごくんっ……_H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「……ふふ、綺麗にいただきましたわ_H_　ご主人様のすべてを味わうのも、メイド長のお勤めですから_H_」
			ELSEIF RCVAR:対象キャラ:精飲フラグ
			;なんとか飲み込む
				KSTR:(K++) = 「ん、っ……ふぅ。少々独特な風味でございますが、慣れてまいりましたわ_H_」
			ELSEIF ABL:対象キャラ:技巧 > 2
			;ティッシュに吐き出す
				KSTR:(K++) = 「んっ……ふぅ。……お口いっぱいに注いでくださり、光栄でございます」
			ELSE
			;吐き出してむせる
				KSTR:(K++) = 「っ……！　けほっ、こほっ……。……申し訳ございません、少々むせてしまいました」
			ENDIF
		CASE 3
			;乳内
			KSTR:(K++) = 「胸の谷間に、こんなにも温かいものを……_H_　ふふ、大変愛おしく思います_H_」
		CASE 5
			;顔
			KSTR:(K++) = 「ふふ、顔にかかってしまいましたね。……ご主人様が昂ぶってくださった証拠なら、誇らしく思います_H_」
		CASE 6
			;腹
			KSTR:(K++) = 「お腹の上に……白く熱いものが_H_」
		CASE 7
			;背中
			KSTR:(K++) = 「背中にまで注がれるとは……。ふふ、ご主人様の情熱、しかと背中で受け止めましたわ_H_」
		CASE 30
			IF CFLAG:対象キャラ:うふふ
				;うふふ中汎用射精
				KSTR:(K++) = 「はぁ……_H_　たっぷりと果ててくださり、私も嬉しいです_H_」
			ELSE
				;非うふふ時の射精、逆セクハラなど
				KSTR:(K++) = 
			ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

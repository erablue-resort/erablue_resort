;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「1221」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM0_愛撫
;--------------------------------------------------
@KOJO_COM_1221_0(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｃ、Ｂ
;ランダム弱点コマンドの候補
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE MAX(CUP:対象キャラ:快Ｃ, CUP:対象キャラ:快Ｂ)
			;各部位の累積が10000で絶頂、場合分けの数値は参考数値なのでイメージで変えてもらってOK
			CASE IS > 10000
				;即絶頂
				KSTR:(K++) = 「ん、んぅぅ……っ_H__H_！　……はぁ、ぁ……っ_H_」
				KSTR:(K++) = 「……ふふ。いけませんね。……ご主人様の手のひら一つで、こんなにも乱されてしまうなんて……_H_」
			CASE IS > 6000
				;かなり感じている
				WSTR:(K++) = 「はぁっ_H_　ん……っ、ご主人様の手……熱くて、とても心地が良くて……_H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「もっと……もっと乱暴に触れてくださっても、よろしいのですよ……？_H_」
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 「んっ……ふふ、くすぐったいような……でも、身体の奥が熱くなってまいりました_H_」
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 「ご主人様の手、とても優しいですね。……メイドの身体、どうぞお好きなようになさってくださいませ」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		SELECTCASE MAX(CUP:対象キャラ:快Ｃ, CUP:対象キャラ:快Ｂ)
			CASE IS > 10000
				WSTR:(K++) = 「んく……っ_H_　そんなに的確に弄ばれては……っ_H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「っ……あ、ぁ……っ_H_　んん……っ_H__H_」
				KSTR:(K++) = 「……ふぅ、っ。……ご主人様は、本当に罪作りな指先をお持ちですね_H_」
			CASE IS > 6000
				KSTR:(K++) = 「は……っ_H_　ご主人様、ずいぶんと手慣れていらっしゃいますね……っ_H_　んっ、そこ……っ_H_」
			CASE IS > 3000
				KSTR:(K++) = 「ん……っ_H_　ええ、結構でございますよ。もっと奥まで、触れてくださいませ」
			CASEELSE
				KSTR:(K++) = 「どうぞ。ご満足いただけるよう、この身を委ねておりますので」
		ENDSELECT
	ELSE
		SELECTCASE MAX(CUP:対象キャラ:快Ｃ, CUP:対象キャラ:快Ｂ)
			CASE IS > 10000
				WSTR:(K++) = 「っ……！　いけません、ご主人様……っ_H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「ん、くぅ……っ_H_　……っっ_H__H_」
				KSTR:(K++) = 　ベルファストは袖口を強く握り締め、熱い吐息を漏らしながら震えに耐えていた。
			CASE IS > 6000
				KSTR:(K++) = 「あっ……_H_　ご主人様……っ、指先が、そんなところに……っ」
			CASE IS > 3000
				KSTR:(K++) = 「んっ……。身体が、少し熱くなってまいりました……」
			CASEELSE
				KSTR:(K++) = 「はい。メイドとして、ご主人様のご奉仕を受け入れます」
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)



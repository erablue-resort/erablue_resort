#DIM 対象キャラ
CALL 口上開始_1221

SELECTCASE RFLAG:コマンド結果受渡し変数２
	CASE 7
		;高貴
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE -1
				KSTR:(K++) = 「申し訳ございません。作法というものは、頭で覚えるより先に身体が覚えるものでして」
			CASE 0
				KSTR:(K++) = 「背筋を伸ばして、顎を引いて。　ええ、そのまま歩いてくださいませ」

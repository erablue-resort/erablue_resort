;--------------------------------------------------
;COM380_0_15 プールで一緒に遊ぶ
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数３
	;１：普通に遊ぶ  ２：泳ぎで競争  ３：浮き輪でのんびり浮かぶ
;RFLAG:コマンド結果受渡し変数
	;0未満:失敗  1～9:通常成功  10以上:大成功
;--------------------------------------------------
@KOJO_COM_1221_380_0_15(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1221

SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE 1
		;普通に遊ぶ
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				KSTR:(K++) = 「あら。　髪が全て濡れてしまいましたね」
				KSTR:(K++) = 「これは後でお返しいたします」
			CASE IS >= 10
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、そのお顔は少々はしゃぎすぎでございますよ？」
			CASEELSE
				KSTR:(K++) = 「水の中では、足音を消す必要もございませんね。　気楽なものです」
		ENDSELECT
	CASE 2
		;泳ぎで競争
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				KSTR:(K++) = 「お見事でございます。　悔しいですね」
				KSTR:(K++) = 「もう一本、お願いできますか？」
			CASE IS >= 10
				KSTR:(K++) = 「私の勝ちでございますね。　ご忠告いたしましたでしょう？」
				KSTR:(K++) = 「海の上で過ごした身でございますので」
			CASEELSE
				KSTR:(K++) = 「よい勝負でございました。　次はもう少し、本気を出させていただきます」
		ENDSELECT
	CASE 3
		;浮き輪でのんびり浮かぶ
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				KSTR:(K++) = 「まあ。　浮き輪から落ちる方を、初めて拝見いたしました」
			CASE IS >= 10
				KSTR:(K++) = 「何もせずに浮かんでいるだけ、というのは。　……存外、悪くございませんね」
			CASEELSE
				KSTR:(K++) = 「ええ、こうしております。　メイドが働かない時間も必要でございましょう？」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)



			ENDIF
		CASEELSE
		;大成功
			KSTR:(K++) = 「お口に合いましたでしょうか？」
			KSTR:(K++) = 「うふふ。焼き加減を計るのは、砂時計より難しいものでございました」
	ENDSELECT
ELSE
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
		;大失敗
			KSTR:(K++) = 「……これは。　いえ、責任を持って私が頂戴いたします。頂戴いたしますとも」
			KSTR:(K++) = 　%CALLNAME:対象キャラ%は顔色ひとつ変えずに完食し、それから静かに水を一杯飲んだ。
		CASE -1
		;失敗
			KSTR:(K++) = 「火が通っておりませんね。　お貸しくださいませ、私が焼き直します」
		CASE 0
			IF 関係レベル < 関係閾値:4
				KSTR:(K++) = 「ええ、美味しゅうございます」
				KSTR:(K++) = 「%TEXTR("たまにはこうして、焼いていただく側に回るのも悪くございませんね/ユニオンの皆様がお好きなのも、頷ける味でございます")%」
			ELSE
				KSTR:(K++) = 「ユニオンの皆様との食事会を思い出します。　……あれは、給仕どころではございませんでした」
				KSTR:(K++) = 「いいえ、嫌いとは申しておりません。　皿と布巾が恋しいだけでございます」
			ENDIF
		CASEELSE
			KSTR:(K++) = 「まあ、これは。　存外に美味しいですね」
			KSTR:(K++) = 「……本日は、負けを認めておきましょう」
	ENDSELECT
ENDIF


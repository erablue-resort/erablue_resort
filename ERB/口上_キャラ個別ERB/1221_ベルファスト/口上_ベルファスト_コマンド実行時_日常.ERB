;--------------------------------------------------
;●ベルファスト口上＠erablue_resort用
;　――コマンド実行後に表示される文章（日常）
;　　該当のキャラが「TARGET」の時に呼ばれる
;--------------------------------------------------
;分岐は原則 MAX(好感度レベル, 恋慕レベル) と 関係閾値 の比較で行う。
;各段の意味づけは ベルファスト口上_readme.txt を参照
;--------------------------------------------------


;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
;ABL:MASTER:話術技能によって効果上昇
;--------------------------------------------------
@KOJO_COM_1221_300(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上開始_1221

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
;陥落済みは最上位として扱う
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗、話題が尽きてしまったパターン
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%？　無理に話題をお作りにならずとも、私は逃げも隠れもいたしませんよ」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「話の種より先に、紅茶が冷めてしまいますね。淹れ直して参りましょうか？」
			CASEELSE
				KSTR:(K++) = 「言葉が続かないのでしたら、それはそれで。　黙っていらっしゃる%CSTR:対象キャラ:二人称%も、なかなか良いものでございますよ」
		ENDSELECT
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「申し訳ございません。着任したばかりで、%CSTR:対象キャラ:二人称%のお好みをまだ把握しておりません。次までには必ず」
				KSTR:(K++) = 　完璧な角度の礼が返ってきた。会話は、そこで途切れた。
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「申し訳ございません。今のお話は、私には少々難しいお話でございました」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「あら、失礼。聞き返してしまいましたね。　どうか陛下にはご内密に」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「申し訳ございません。少々、考え事を。　何をとは、申し上げませんが」
			CASEELSE
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%？　今、私の顔をご覧になっていましたね？」
				KSTR:(K++) = 　はぐらかされた。%CALLNAME:対象キャラ%が話を逸らすのは珍しい。
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「ご機嫌麗しゅうございます、%CSTR:対象キャラ:二人称%。何かご用でしょうか」
					CASE 1
						KSTR:(K++) = 「ロイヤルより参りました、メイドのベルファストと申します。　ええ、何度でも名乗らせていただきますとも」
					CASE 2
						KSTR:(K++) = 「このリゾートの導線は、なかなかよく出来ておりますね。どなたの采配でしょうか？」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「お飲み物はいかがですか？　はい、お答えを伺う前に用意してございます」
					CASE 1
						KSTR:(K++) = 「先ほどの書類でしたら、机の右手に揃えてございます」
					CASE 2
						KSTR:(K++) = 「本日のご予定は私が把握しております。何なりとお尋ねくださいませ」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%は、話しかける前に必ず一度、息を吸われますね」
					CASE 1
						KSTR:(K++) = 「あら？　私の顔に何かついておりますか？　それとも、お目当ては別のところでしょうか」
					CASE 2
						KSTR:(K++) = 「不用意に女性を見つめるのは紳士の所業ではございませんよ？　もっとも、私は数に入っておりませんが」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:5
					CASE 0
						KSTR:(K++) = 「この島は、よい風が吹きますね。　昔いた川辺を思い出します。あちらより、少しばかり賑やかでございますが」
					CASE 1
						KSTR:(K++) = 「何事もない一日というのは、当たり前のようでいて、そうではございません。　よいお仕事をなさいましたね」
					CASE 2
						KSTR:(K++) = 「少しお休みになってはいかがですか？　いいえ、進言ではございません。お願いでございます」
					CASE 3
						KSTR:(K++) = 「ふふ、そんなに身構えなくても結構ですよ？　二人きりの時くらいは、肩の力を抜いてお話しいたしましょう」
					CASE 4
						KSTR:(K++) = 「あら……そんなにじっと見つめられては、完璧なメイドでいられなくなってしまいますよ？」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:6
					CASE 0
						KSTR:(K++) = 「おかえりなさいませ、あなた。　うふふ、今の呼び方はいかがでしたか？」
					CASE 1
						KSTR:(K++) = 「後ろに控えているより、隣に立つほうが。　%CSTR:対象キャラ:二人称%と同じ景色が見えますので」
					CASE 2
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%？　いいえ、御用はございません。お呼びしたかっただけでございます」
					CASE 3
						KSTR:(K++) = 「ふふ、今日はずっとこうしてお話ししていたい気分です。……だめ、でしょうか？」
					CASE 4
						KSTR:(K++) = 「たまにはメイド長ではなく、一人の女性として甘えてみてもよろしいですか？　……うふふ、冗談でございますよ」
					CASE 5
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%とお話ししている時の私、少し顔が緩んでいるかもしれませんね。……あなた様だけの秘密にしてくださいませ」
				ENDSELECT
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%は、メイドの手元をよくご覧になっていらっしゃる」
				KSTR:(K++) = 「そういう方にお仕えするのは初めてでございます。　張り合いがございますね」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「困りましたね。%CSTR:対象キャラ:二人称%とお話ししていると、時間の管理を忘れてしまいます」
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「まあ。ずるい方でございますね」
						KSTR:(K++) = 「そのようなことを仰られては、ベルファストも取り繕えなくなってしまいます」
					CASE 1
						KSTR:(K++) = 「ふふっ、もう……%CSTR:対象キャラ:二人称%ったら。そんな素敵なことを仰るなんて、反則でございますよ」
						KSTR:(K++) = 「完璧なメイド長もお手上げでございます。……うふふ」
				ENDSELECT
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM301_お茶を淹れる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;その場にいる全員が対象だが、口上は対面している相手のみ
;--------------------------------------------------
@KOJO_COM_1221_301(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上開始_1221

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
;陥落済みは最上位として扱う
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「頂戴いたします」
				KSTR:(K++) = 「差し出がましいようですが、茶葉は蒸らしすぎますと渋みが出ますよ。次は、砂時計をお貸ししましょうか？」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「次は、ベルファストにお任せいただけますか？」
			CASEELSE
				KSTR:(K++) = 「美味しくいただきました」
				KSTR:(K++) = 　嘘だった。%CALLNAME:対象キャラ%は最後まで飲み干して、静かにカップを置いた。
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「頂戴いたします」
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%に淹れていただくとは。メイドとしては、少々複雑でございますね」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「ありがとうございます。　お湯の温度が前より安定しておりますね。　ええ、見ておりました」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「まあ。%CSTR:対象キャラ:二人称%、私を甘やかしてどうなさるおつもりですか？」
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「……ありがとうございます」
						KSTR:(K++) = 「人に淹れていただくお茶が、こんなに温かいものだとは。　勉強になりました」
					CASE 1
						KSTR:(K++) = 「ふふ、美味しいです。%CSTR:対象キャラ:二人称%に淹れていただくお茶なら、どんな高級茶葉にも勝りますね」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「姉さんの淹れた紅茶と、どちらが好きかとお尋ねですか？」
						KSTR:(K++) = 「うふふ。それは……内緒でございます」
					CASE 1
						KSTR:(K++) = 「ふふ、ごちそうさまでした。……美味しくて、心が温かくなります」
					CASE 2
						KSTR:(K++) = 「お隣、よろしいですか？　……たまにはこうして、%CSTR:対象キャラ:二人称%と肩を並べてお茶をいただくのも悪くありませんね」
					CASE 3
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%と飲むお茶は、いつもよりずっと甘く感じてしまいます。……お砂糖を入れすぎたわけではございませんよ？」
				ENDSELECT
		ENDSELECT
	CASEELSE
		;大成功
		KSTR:(K++) = 「――見事でございます」
		KSTR:(K++) = 「この一杯のためにどれだけ気を配ってくださったか、飲めばわかります」
		SIF 関係レベル >= 関係閾値:3
			KSTR:(K++) = 「メイド長として、少々立つ瀬がございませんね」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)



@口上側LOADENDパラメータ変更_1221
;ロード時に呼ばれる関数。NEWGAME時に呼ばれないことに注意
;初期パラメータ関数だけだと後から追加した時にバグるため追加
LOCAL = GETCHARA(1221)

IF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = 私
ENDIF

IF CSTR:LOCAL:二人称 == ""
	CSTR:LOCAL:二人称 = ご主人様
ENDIF

IF CSTR:LOCAL:キャラ固有好感度要素 == ""
	CSTR:LOCAL:キャラ固有好感度要素 =
ENDIF




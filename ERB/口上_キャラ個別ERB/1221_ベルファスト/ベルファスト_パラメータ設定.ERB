;****************************************
;キャラの初期パラメータを口上側で制御するためのファイル
;****************************************
;・使い方
;「1221」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;初期パラメータ変更
;--------------------------------------------------
@口上側初期パラメータ変更_1221
;NEWGAME時に呼ばれる関数、ロード時には呼ばれないことに注意
;TALENTをONOFFしたり、EXPの取得や初期ABLの変更などをここに記述すること
LOCAL = GETCHARA(1221)
;キャラクターが自分を指す際の呼び方

CSTR:LOCAL:一人称 = 私

CSTR:LOCAL:二人称 = ご主人様

CSTR:LOCAL:キャラ固有好感度要素 =


;プレゼントの好み
;基本的にはCSVで設定すべきだが、口上特有の設定をする場合はここに記述
;CSTR:LOCAL:プレゼント好み = 

;身長やバストの数値を指定する・変更する場合
; BASE:LOCAL:身長 = 
; BASE:LOCAL:バスト = 

;性別の表記変更
;「男の娘」や「漢女」などを表記するための変数
;CSTR:LOCAL:性別表記 = 

;--------------------------------------------------
;ロード時パラメータ変更
;--------------------------------------------------
@口上側LOADENDパラメータ変更_1221
;ロード時に呼ばれる変数。NEWGAME時に呼ばれないことに注意
;初期パラメータ関数だけだと後から追加した時にバグるため追加
LOCAL = GETCHARA(1221)
;キャラクターが自分を指す際の呼び方

IF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = 私
ENDIF
;キャラクターがあなたを指す際の呼び方

IF CSTR:LOCAL:二人称 == ""
	CSTR:LOCAL:二人称 = ご主人様
ENDIF
;キャラクターが固有に持つ独自の好感度要素の名前
;通常上昇しないので、設定した場合はキャラ固有処理_1221.ERBなどで上昇処理も作ること

IF CSTR:LOCAL:キャラ固有好感度要素 == ""
	CSTR:LOCAL:キャラ固有好感度要素 =
ENDIF


;--------------------------------------------------
;弱点コマンド制御
;--------------------------------------------------
@弱点コマンド変更_1221
;各変数にコマンド番号を入れること
;派生コマンドや専用コマンドは「370_1」のように記述すること
;ここで指定しなかった枠はランダムで埋められる
;ランダムで埋める場合、枠０・１はセクハラコマンド、２・３はうふふコマンド、４は完全ランダムに選択される
LOCAL = GETCHARA(1221)


; 弱点コマンド枠:LOCAL:0 = 
; 弱点コマンド枠:LOCAL:1 = 
; 弱点コマンド枠:LOCAL:2 = 
; 弱点コマンド枠:LOCAL:3 = 
; 弱点コマンド枠:LOCAL:4 = 

;--------------------------------------------------
;フレーバー素質設定
;--------------------------------------------------
@フレーバー素質初期設定変更_1221
LOCAL = GETCHARA(1221)

フレーバー素質:LOCAL:素質表示設定 = 1
;以下の要素は0の時、表示されない

フレーバー素質:LOCAL:陰毛濃さ = 2
フレーバー素質:LOCAL:乳首大きさ = 3
フレーバー素質:LOCAL:乳輪大きさ = 2
フレーバー素質:LOCAL:性器種類 = 4
フレーバー素質:LOCAL:クリ大きさ = 2
フレーバー素質:LOCAL:ほくろ位置 = 0
;ビット管理
;ビット0：乳首付近　1：性器付近　2：アナル付近　3：陰茎（ふたなり時のみ）


;2の時玉あり

;--------------------------------------------------
;固有好感度設定
;--------------------------------------------------
@キャラ固有好感度関係名_1221(ARG)
;好感度要素の恋心、信頼、友情、性愛以外の要素の段階名を設定する
;初期パラメータ変更の方で固有好感度を付けておかないと発動しないので注意
SELECTCASE ARG
	CASE IS == 関係閾値:0
		RESULTS = 初対面
	CASE IS <= 関係閾値:1
		RESULTS =
	CASE IS <= 関係閾値:2
		RESULTS =
	CASE IS <= 関係閾値:3
		RESULTS =
	CASE IS <= 関係閾値:4
		RESULTS =
	CASE IS <= 関係閾値:5
		RESULTS =
ENDSELECT
RETURN



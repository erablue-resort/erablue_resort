;--------------------------------------------------
;COM306_1_背中に触れる
;--------------------------------------------------
;取得快楽：Ｓ
;RFLAG:コマンド結果受渡し変数　1:拒絶  2:受け入れ  3:喜び
;--------------------------------------------------
@KOJO_COM_1221_306_1(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1221

IF TALENT:対象キャラ:恋慕
	SELECTCASE CUP:対象キャラ:快Ｓ
		CASE IS > 10000
			KSTR:(K++) = 「っ……背中は、いけません。　そこは、本当に」
		CASE IS > 6000
			KSTR:(K++) = 「背筋を、そのように。　……ええ、効いております。認めますとも」
		CASE IS > 3000
			KSTR:(K++) = 「背中を許すというのは、相当のことでございますよ？」
		CASEELSE
			KSTR:(K++) = 「どうぞ。　背中を預けられる方は、そう多くございません」
	ENDSELECT
ELSEIF TALENT:対象キャラ:セフレ
	KSTR:(K++) = 「あら。　……ええ、そのままで結構でございます」
ELSE
	IF RFLAG:コマンド結果受渡し変数 == 1
		KSTR:(K++) = 「背後を取るのは感心いたしませんね。　正面からどうぞ」
	ELSEIF RFLAG:コマンド結果受渡し変数 == 2
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は背筋を伸ばしたまま、触れられるに任せた。
		KSTR:(K++) = 「はい。　お済みになりましたら、お知らせくださいませ」
	ELSEIF RFLAG:コマンド結果受渡し変数 == 3
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、手つきが遠慮がちでございますね？」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)



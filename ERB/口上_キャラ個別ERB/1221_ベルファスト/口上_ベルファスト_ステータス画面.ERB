;--------------------------------------------------
;●ベルファスト口上＠erablue_resort用
;　――ステータス画面／通常画面に表示される一言
;--------------------------------------------------


;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
;一行のみの表示を想定。二行以上は基本的に禁止
;WAIT系列は使わないこと
;--------------------------------------------------
@口上_INFO画面_一言コメント_1221(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1221

;絶頂時
;エロ側の口上と合わせて書くべきなので、現状は未記述
;IF TCVAR:対象キャラ:前ターン絶頂
;	KSTR:(K++) =
;ENDIF
;SIF KSTR:0 != ""
;	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 現在仕事:対象キャラ:1 % 10000 && CFLAG:対象キャラ:現在マップ種別 == 現在仕事:対象キャラ:1 / 10000
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 2
			;ロビーで受付中
			KSTR:(K++) = 「いらっしゃいませ。ご滞在の間、何なりとお申し付けくださいませ」
		CASE 503
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「お強いものと、そうでないもの。どちらをお望みでしょうか？」
		CASE 506
			;図書室で司書中
			KSTR:(K++) = 「お静かに願います。ええ、私も声を落としてお答えいたしますので」
		CASE 1503, 15
			;プールで監視員中
			KSTR:(K++) = 「足元にお気を付けくださいませ。溺れる方は、たいてい浅いところで溺れます」
		CASE 10000 TO 10009
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 10000):0}(現在仕事:対象キャラ:1 - 10000)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「入り用のものがございましたら、お伺いいたします」
				CASE "土産物屋"
					KSTR:(K++) = 「贈り先の方のお顔を伺えれば、いくつかお選びできますが」
				CASE "食事処"
					KSTR:(K++) = 「本日の献立でしたら、そらで申し上げられます」
				CASE "装飾品店"
					KSTR:(K++) = 「お似合いになるものと、お好きなもの。どちらをお探しでしょうか？」
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;状況で分岐
IF CFLAG:対象キャラ:飲み会
	;飲み会中
	KSTR:(K++) = 「ええ、頂戴いたします。　崩れはいたしませんので、ご心配なく」
ELSEIF CFLAG:対象キャラ:睡眠
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「申し訳、ございません。　すぐに、起きますので……」
	ELSE
		KSTR:(K++) = 　眠っていてなお、%CALLNAME:対象キャラ%の背筋は伸びたままだった。
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	IF CFLAG:対象キャラ:デート == MASTER + 100
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「本日は、荷物をお持ちするだけの日ではございませんね」
			CASE 1
				KSTR:(K++) = 「ふふ、%CSTR:対象キャラ:二人称%のエスコートなら、喜んで腕をお預けいたします」
		ENDSELECT
	ELSE
		KSTR:(K++) = 「ええ、お付き合いいたします。メイドの勤めの外でも、多少は」
	ENDIF
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	KSTR:(K++) = 「手加減は、いたしませんよ？」
ELSEIF CFLAG:対象キャラ:同行
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「はい。半歩後ろに控えております」
		CASE 1
			KSTR:(K++) = 「ふふ、%CSTR:対象キャラ:二人称%とご一緒できるなら、どこへでもお供いたしますよ」
		CASE 2
			KSTR:(K++) = 「隣を歩かせていただいてもよろしいですか？　……ふふっ、ありがとうございます」
	ENDSELECT
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	KSTR:(K++) = 「足音を殺すのも、メイドの技能のうちでございます」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	KSTR:(K++) = 　%CALLNAME:対象キャラ%は一度だけ手を止め、こちらを見ないまま、何事もなかったように仕事へ戻った。
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%とは、ずいぶん気安くなってしまいましたね」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。お茶になさいますか？」
			CASEELSE
				KSTR:(K++) = 「何かご用でしょうか、%CSTR:対象キャラ:二人称%」
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%のご判断でしたら、私は従うまででございます」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「お任せくださいませ。段取りは、こちらで組んでおきます」
			CASEELSE
				KSTR:(K++) = 「ご指示をいただければ、そのように動きます」
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「いいえ。ただ、お顔を見ていただけでございます」
					CASE 1
						KSTR:(K++) = 「ふふ、私の視線に気づかれましたか？　愛しい方の姿は、つい追ってしまいますね」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「うふふ。また目が合いましたね、%CSTR:対象キャラ:二人称%」
			CASEELSE
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%？　いえ、なんでもございません」
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「夜のご用命も、承っております。ご遠慮なさいませんように」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「あら？　そのようなお顔で見られますと、困ってしまいます」
			CASEELSE
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%？　目のやり場にお困りでしょうか」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_1221(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1221

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「あなた様が、このリゾートの主でいらっしゃいますか」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「お客様として遇するべきか、主として遇するべきか。まだ、決めかねております」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%のお好みは、だいたい把握いたしました」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「最近は、仕事の話でない話も増えましたね」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の前ですと、少しだけ気を抜いてしまいます。内緒でございますよ？」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「メイドと主という間柄には、本来ないものでございますね。これは」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_信頼
;--------------------------------------------------
@口上_ステータス画面_信頼コメント_1221(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1221

SELECTCASE CFLAG:対象キャラ:信頼度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「この身は、お預けするとお約束いたしました。それだけでございます」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「命じられたことは、確実に。それがメイドの最低限でございます」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%は、人を働かせ方をご存じの方でいらっしゃいますね」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;知己
		KSTR:(K++) = 「お任せくださいませ。そう申し上げても、聞き流されない方でございますね」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;相棒
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%が決めたことでしたら、理由は後から伺います」
	CASEELSE
		;水魚の交わり
		KSTR:(K++) = 「障害は、私が取り除きます。%CSTR:対象キャラ:二人称%は、前だけをご覧くださいませ」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_恋心
;--------------------------------------------------
@口上_ステータス画面_恋心コメント_1221(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1221

SELECTCASE CFLAG:対象キャラ:恋心度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「メイドがそのようなことを申し上げる立場にはございません」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「お仕えするのに、心の在り処は関係ございませんので」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の困っておいでのお顔が、少々お可愛らしく思います」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;好意
		KSTR:(K++) = 「最近、目で追ってしまう癖がついてしまいました。困ったものでございますね」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;恋心
		KSTR:(K++) = 「お見守りするだけで満足していたはずでございましたのに。欲張りになったものでございます」
	CASEELSE
		;愛情
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%。いいえ、あなた様、と。　そちらのほうが、近く感じますので」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_性愛
;--------------------------------------------------
@口上_ステータス画面_性愛コメント_1221(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1221

SELECTCASE CFLAG:対象キャラ:性愛度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「そのようなご用命は、まだ承っておりません」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「主にすべてを捧げるのはメイドの勤めでございます。ええ、すべてを」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「あら？　目のやり場にお困りでしたら、そう仰ってくださればよろしいのに」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;意識
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%。あまり、試すようなことはなさいませんように」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;情欲
		KSTR:(K++) = 「ご覧になりますか？　うふふ、そう仰ると思っておりました」
	CASEELSE
		;耽溺
		KSTR:(K++) = 「もっとご奉仕して、もっとお情けを頂戴したくなります。全く困った%CSTR:対象キャラ:二人称%でございます」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)

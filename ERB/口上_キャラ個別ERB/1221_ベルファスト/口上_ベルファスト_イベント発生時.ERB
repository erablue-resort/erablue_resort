;--------------------------------------------------
;罰ゲーム
;--------------------------------------------------

@KOJO_EVENT_罰ゲーム_1221(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE 2
		;罰ゲーム賭けあなた勝利
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE 0
				;でこぴん
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は目を閉じ、額をこちらへ差し出した。まばたきひとつしなかった。
				KSTR:(K++) = 「はい、確かに。　……もう一度、いかがですか？」
			CASE 1
				;お酒を飲む、TCVAR:対象キャラ:初飲酒フラグ = 1の時、キャラが初めて飲酒した
				KSTR:(K++) = 　注がれた酒を、%CALLNAME:対象キャラ%は一滴も残さず飲み干した。
				KSTR:(K++) = 　グラスを置く音すら立たなかった。
				KSTR:(K++) = 「ごちそうさまでございました。　……罰、でございましたよね？」
			CASE 2
				;体に触れる
				;セクハラの身体に触れる系コマンドと数字一致
				KSTR:(K++) = 「はい、どうぞ。　罰ゲームでございますものね」
				KSTR:(K++) = 「……そのように恐る恐る触られますと、こちらが悪いことをしている気分になります」
			CASE 10
				;下着の色を言う
				KSTR:(K++) = 「本日は%今日の下着文字列生成(対象キャラ)%でございます」
				KSTR:(K++) = 　即答だった。%CALLNAME:対象キャラ%は次の札を切りながら、ついでのように言った。
				KSTR:(K++) = 「支給品につき、特に面白みがなく申し訳ございません」
			CASE 11
				;セクシーポーズで淫語
				KSTR:(K++) = 「かしこまりました」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は言われた通りの姿勢を取り、言われた通りの言葉を、一言一句そのまま口にした。
				KSTR:(K++) = 　澱みも、照れもなかった。ただ淡々と、給仕の口上を述べるように。
				KSTR:(K++) = 「以上でよろしいでしょうか。　……あら。%CSTR:対象キャラ:二人称%のほうが、赤くていらっしゃいますね」
				KSTR:(K++) = 「罰ゲームとは、こういうものでございましたか」
			CASE 12
				;乳首当てゲーム
				IF RFLAG:コマンド結果受渡し変数４ == 1
					;的中
					KSTR:(K++) = 「っ……　　ええ、正解でございます」
					KSTR:(K++) = 「よくご存じで。　……どちらで覚えられたのでしょうね？」
				ELSE
					KSTR:(K++) = 「はずれでございます」
					KSTR:(K++) = 「毎日ご覧になっている割に、見当違いでいらっしゃいますね」
				ENDIF
			CASE 13
				;尻を揉む
				KSTR:(K++) = 「はい。　罰ゲームでございますから、抗いません」
				KSTR:(K++) = 「……ずいぶんと、遠慮のない罰でございますこと」
			CASE 14
				;胸を揉む
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は姿勢も表情も一切崩さなかった。
				KSTR:(K++) = 「どうぞ。　……ええ、時間はお決めになりませんでしたね」
				KSTR:(K++) = 「お好きなだけ、ということでよろしいですか？」
			CASE 16
				;肩組み乳揉み
				KSTR:(K++) = 「肩を組まれるのは、初めてでございます」
				KSTR:(K++) = 「こうしていると、悪友のようでございますね。　……手の位置を除けば」
			CASE 17
				;乳首ひっかき
				KSTR:(K++) = 「っ、　……失礼。　少し、驚いただけでございます」
				KSTR:(K++) = 「罰ゲームにしては、ずいぶん熱心でいらっしゃいますね」
			CASE 18
				;股間を弄る
				KSTR:(K++) = 「……%CSTR:対象キャラ:二人称%」
				KSTR:(K++) = 　声は静かなままだった。しかし%CALLNAME:対象キャラ%が言葉を切ったのは、この夜で初めてだった。
				KSTR:(K++) = 「ええ、負けは負けでございます。　……最後まで、どうぞ」
			CASEELSE
				KSTR:(K++) = 「かしこまりました。　負けは負けでございますので」
				KSTR:(K++) = 「……ご存分に」
		ENDSELECT

	CASE -2
		;罰ゲーム賭けキャラ勝利
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE 0
				;でこぴん
				KSTR:(K++) = 「では、失礼して。　……はい、動かないでくださいませ」
				KSTR:(K++) = 「ご忠告いたしましたでしょう、私は手加減が出来ません」
			CASE 1
				;お酒を飲む、TCVAR:PLAYER:初飲酒フラグ = 1の時、PLAYERが初めて飲酒した
				KSTR:(K++) = 「どうぞ、お注ぎいたします。　ええ、なみなみと」
				KSTR:(K++) = 「うふふ。　こういう時だけは、給仕という仕事も楽しく思えますね♪」
			CASE 10
				;下着の色を言う
				KSTR:(K++) = 「では、伺いましょうか。　本日は何色でいらっしゃいます？」
				KSTR:(K++) = 「うふふ。　嘘は結構でございますよ。　洗っているのは私でございますので」
			CASE 11
				;セクシーポーズで淫語
				KSTR:(K++) = 「はい、そのまま。　……もう少し顎をお上げになったほうが、様になります」
				KSTR:(K++) = 「結構でございます。　メイド隊の研修に使えそうな出来映えでした」
			CASE 12
				;乳首当てゲーム
				;あなた側ではごまかす分岐が存在しない（ごまかすかどうか選択肢出すとテンポが悪いので）
				IF RFLAG:コマンド結果受渡し変数４ == 1
					;的中
					KSTR:(K++) = 「はい、こちらでございますね」
					KSTR:(K++) = 「うふふ。　毎日お召し替えを手伝っておりますもの。　外すはずがございません」
				ELSE
					KSTR:(K++) = 「……あら。　外してしまいましたね」
					KSTR:(K++) = 「次は目を開けて、確かめさせていただきましょうか」

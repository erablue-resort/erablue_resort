;****************************************
;ターン開始時や一日開始時・終了時に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「1221」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_1221(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化
;挨拶の時間・内容は地の文では言及されないので適宜変更してもOK

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE TIME
	;朝　5時～11時
	CASE 5*60 TO 11*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。本日のご予定を、後ほどお持ちいたします」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。お茶は既に用意してございます」
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます。あら、%CSTR:対象キャラ:二人称%、髪が一房はねておいでですよ？」
					CASE 1
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。まだ半分眠っておいでですね」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。よくお休みになれましたか？」
					CASE 1
						KSTR:(K++) = 「おはようございます。よい朝でございますね。こういう朝が、私は好きでございます」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。本当はもう少し、寝顔を見ていたかったのですが」
					CASE 1
						KSTR:(K++) = 「お目覚めですか？　うふふ、起こすのが惜しくて、少々遅くなってしまいました」
					CASE 2
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。……ふふっ、まだ少し眠たそうなお顔。こちらへいらしてください、身嗜みを整えて差し上げますね♪」
				ENDSELECT
		ENDSELECT
	CASE 11*60 TO 18*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「ご機嫌麗しゅうございます、%CSTR:対象キャラ:二人称%。何かご用でしょうか」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%。お手が空きましたら、軽食をご用意いたします」
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あら？　%CSTR:対象キャラ:二人称%、私を探しておいででしたか？」
					CASE 1
						KSTR:(K++) = 「ご機嫌麗しゅうございます。そのお顔は何かご相談がおありですね？」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%。少しお休みになってはいかがですか？　メイドの目は誤魔化せませんよ」
					CASE 1
						KSTR:(K++) = 「よい風が吹いておりますね。こうしてお会いできる昼が、いくつも続きますように」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%？　いいえ、御用は。お名前をお呼びしたかっただけでございます」
					CASE 1
						KSTR:(K++) = 「うふふ。後ろに控えているより、こうして隣に立つほうが、同じ景色が見えますね」
					CASE 2
						KSTR:(K++) = 「ご機嫌麗しゅうございます。……ふふっ、二人きりの時は、そんなに改まらなくても結構ですよ？　少しお茶でもしながら、お話しいたしましょう♪」
				ENDSELECT
		ENDSELECT
	CASEELSE
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。夜分のご用命も承っております」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。湯浴みの支度は整えてございます」
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。%CSTR:対象キャラ:二人称%、本日は少し働きすぎでございますよ？」
					CASE 1
						KSTR:(K++) = 「あら、こんな時間まで。メイドを働かせる口実にされては困ります」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。本日も、何事もない一日でございましたね」
					CASE 1
						KSTR:(K++) = 「夜風が心地よいですね。昔いた川辺も、この時間が一番静かでございました」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「こんばんは。この時間にお会いすると、少し落ち着かなくなります」
					CASE 1
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%。いえ、あなた、と。　練習でございます」
					CASE 2
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。今日もお疲れ様でした。……今夜は、私を独り占めしてくださってもよろしいのですよ？」
				ENDSELECT
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)



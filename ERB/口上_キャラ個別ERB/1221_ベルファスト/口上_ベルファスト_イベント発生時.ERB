;--------------------------------------------------
@KOJO_EVENT_恋慕自覚_1221(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

WSTR:(K++) = 　ティーポットを持つ手が、注ぎ口の高さで止まった。
KSTR:(K++) = 　
WSTR:(K++) = 「……失礼いたしました。少々、考え事を」
KSTR:(K++) = 　
KSTR:(K++) = 　%CALLNAME:対象キャラ%は何事もなかったように紅茶を注ぎ、静かにポットを置いた。
WSTR:(K++) = 　それから、%CALLNAME:MASTER%の顔を見た。
KSTR:(K++) = 　
WSTR:(K++) = 「これは、少々困ったものですね」
KSTR:(K++) = 　
KSTR:(K++) = 「%CSTR:対象キャラ:二人称%をお見守りして、時折お困りのご様子を拝見できれば、
WSTR:(K++) = 　それで満足していたはずでございましたのに」
KSTR:(K++) = 　

		KSTR:(K++) = 「値引きをご希望でしたら、それはそれで交渉に応じますが？」
	ENDIF
	KSTR:(K++) = 　
	KSTR:(K++) = 「それで。　本日は、何をご所望でいらっしゃいます？」
ELSEIF TALENT:対象キャラ:セフレ
	KSTR:(K++) = 「かしこまりました。　律儀な方でいらっしゃいますね？」
	KSTR:(K++) = 　
	WSTR:(K++) = 「昨日はお代を頂戴しなかったと記憶しておりますが、本日はお支払いになるのですね」
	KSTR:(K++) = 　
	KSTR:(K++) = 「どちらでも構いませんとも。　線引きは%CSTR:対象キャラ:二人称%にお任せいたします」
	KSTR:(K++) = 　
	KSTR:(K++) = 「では、ご用命を。　……お品書きは、頭に入っております」
ELSE
	NSTR:(K++) = 「はい、承っております。性処理業務でございますね」
	KSTR:(K++) = 　
	KSTR:(K++) = 　断りもしなければ、驚きもしなかった。
	WSTR:(K++) = 　%CALLNAME:対象キャラ%は伝票を確かめる時と同じ手つきで、袖口のボタンを外し始めた。
	KSTR:(K++) = 　
	KSTR:(K++) = 「ロイヤルのメイドは、こういった御用も承ります。　教育のうちでございますので」
	KSTR:(K++) = 　
	IF RFLAG:コマンド結果受渡し変数 == 1
		KSTR:(K++) = 「お代は結構でございます。　……ええ、そういう決まりになっておりますので」
	ELSE
		KSTR:(K++) = 「お代は{RFLAG:コマンド結果受渡し変数２}ルピ。　前金でも、後払いでも」
	ENDIF
	KSTR:(K++) = 　
	KSTR:(K++) = 「ご希望をどうぞ。　……そう身構えられずとも結構でございますよ」
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;振り分け処理
;--------------------------------------------------
;仕様上、性処理業務は全て同じコマンド扱いなのでここで分岐させる
;この関数は編集しないこと
;--------------------------------------------------
@KOJO_COM_1221_315(対象キャラ)
#DIM 対象キャラ

SELECTCASE RSTR:コマンド結果受渡し文字列
	CASE "手コキ処理"
		TRYCALLFORM KOJO_性処理_1221_手コキ処理(対象キャラ)
	CASE "パイズリ処理"
		TRYCALLFORM KOJO_性処理_1221_パイズリ処理(対象キャラ)
	CASE "フェラチオ処理"
		TRYCALLFORM KOJO_性処理_1221_フェラチオ処理(対象キャラ)
	CASE "手マン処理"
		TRYCALLFORM KOJO_性処理_1221_手マン処理(対象キャラ)
	CASE "クンニ処理"
		TRYCALLFORM KOJO_性処理_1221_クンニ処理(対象キャラ)
	CASE "セックス処理"
		TRYCALLFORM KOJO_性処理_1221_セックス処理(対象キャラ)
	CASE "被セックス処理"
		TRYCALLFORM KOJO_性処理_1221_被セックス処理(対象キャラ)
	CASE "アナルセックス処理"
		TRYCALLFORM KOJO_性処理_1221_アナルセックス処理(対象キャラ)
	CASE "被アナルセックス処理"
		TRYCALLFORM KOJO_性処理_1221_被アナルセックス処理(対象キャラ)
ENDSELECT



;--------------------------------------------------
;ダフネ専用・画像フォルダ選択候補の制御
;--------------------------------------------------
@画像フォルダ個別処理_2642(対象キャラ, 候補フォルダ)
#FUNCTION
#DIM 対象キャラ
#DIMS 候補フォルダ

;既定では表示を許可
RESULT = 1

;「肉の身体」完了前は人間身体用フォルダを表示しない
IF イベント完了フラグ確認("肉の身体") < 1 && STRCOUNT(候補フォルダ, "ah_human")
	RESULT = 0
ENDIF
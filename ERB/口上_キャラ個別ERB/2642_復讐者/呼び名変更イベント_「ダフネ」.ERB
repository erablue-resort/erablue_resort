;ダフネがリゾートに滞在中
SIF CFLAG:キャラ番号取得:滞在期間 <= 0
	RETURN 0
;親友以上で解放
SIF CFLAG:キャラ番号取得:好感度レベル <= 関係閾値:3
	RETURN 0
RETURN 1


;==================================================================================================
@固有アビ_2642_2(ARGS, キャラ番号)
;-------------------------------------------------
;復讐者をアタッカーのスタンスに切り替える行動。[霊体召喚:フレデリック]か否かでアビリティが変化
;●フレデリックが召喚されていない⇒「霊体召喚:フレデリック」
; [霊体召喚:フレデリック]となり、与ダメージ上昇を付与し、行動後に特殊追撃が発生するようになる。
;○フレデリックが召喚されている⇒「獣爪」
; 単体攻撃。
;--------------------------------------------------------------------------------------------------
#DIM キャラ番号
#DIM 召喚MP

#DIM 隊列番号
#DIM ファミリーバフ
#DIM フレデリック召喚中

#DIM 段階
#DIM 現在Lv
#DIM 必要Lv, 4
#DIM 威力表, 4
#DIM 消費MP表, 4
;--------------------------------------------------------------------------------------------------
;*** 配列作成 *************************************************************
現在Lv = 基礎BATTLE_STATE:キャラ番号:Lv

必要Lv:0 = 1
必要Lv:1 = 15
必要Lv:2 = 30
必要Lv:3 = 45

威力表:0 = 200
威力表:1 = 225
威力表:2 = 250
威力表:3 = 300

消費MP表:0 = 12
消費MP表:1 = 15
消費MP表:2 = 18
消費MP表:3 = 24

; 現在Lvで利用できる最上位の段階を取得
段階 = 0
FOR LOCAL, 0, 4
	SIF 現在Lv >= 必要Lv:LOCAL
		段階 = LOCAL
NEXT
;**************************************************************************

隊列番号 = キャラ隊列検索(キャラ番号)
ファミリーバフ = バフ番号取得_枠("ファミリー", 隊列番号)
フレデリック召喚中 = 0

IF ファミリーバフ > -1
	SIF DT_CELL_GETS("戦闘効果データベース", ファミリーバフ, "対象能力") == "霊体召喚:フレデリック"
		フレデリック召喚中 = 1
ENDIF

;消費MPを算出
IF ダンジョン表示モード == "戦闘画面"
	召喚MP = (BATTLE_STATE:隊列番号:最大ＭＰ * 5 + 99) / 100
ELSE
	召喚MP = (基礎BATTLE_STATE:キャラ番号:最大ＭＰ * 5 + 99) / 100
ENDIF

;[霊体召喚:フレデリック]か否か
IF !フレデリック召喚中
	;======================================================================================================================
	; ●霊体召喚:フレデリック
	;======================================================================================================================
	SELECTCASE ARGS
		CASE "アビ名"
			SELECTCASE 段階
				CASE 0
					TSTR:コマンド名受渡 = 霊体召喚:フレデリック-I
				CASE 1
					TSTR:コマンド名受渡 = 霊体召喚:フレデリック-II
				CASE 2
					TSTR:コマンド名受渡 = 霊体召喚:フレデリック-III
				CASE 3
					TSTR:コマンド名受渡 = 霊体召喚:フレデリック-IV
			ENDSELECT
			
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{召喚MP}(最大ＭＰの5％)
			詳細文文字列受け渡し変数 += "<br>霊体「フレデリック」を召喚する。"
			詳細文文字列受け渡し変数 += "<br>「フレデリック」召喚中は攻撃能力が向上する。"
			SIF 段階 >= 2
				詳細文文字列受け渡し変数 += "<br>霊体召喚は行動回数を消費しない。"
			
			;非戦闘時の戦闘能力確認画面
			IF ダンジョン表示モード != "戦闘画面"
				詳細文文字列受け渡し変数 += "<br><br>【フレデリック召喚中は以下に変化】"
				SELECTCASE 段階
					CASE 0
						詳細文文字列受け渡し変数 += "<br>[獣爪-I]"
					CASE 1
						詳細文文字列受け渡し変数 += "<br>[獣爪-II]"
					CASE 2
						詳細文文字列受け渡し変数 += "<br>[獣爪-III]"
					CASE 3
						詳細文文字列受け渡し変数 += "<br>[獣爪-IV]"
				ENDSELECT
				詳細文文字列受け渡し変数 += @"<br>消費ＭＰ：{消費MP表:段階}"
				詳細文文字列受け渡し変数 += @"<br>敵単体に［攻撃力✕{威力表:段階}％］の無属性ダメージを与える。"
			ENDIF
			RETURN 召喚MP
			
		CASE "アビ説明文_詳細"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{召喚MP}(最大ＭＰの5％)
			詳細文文字列受け渡し変数 += "<br>自身に「霊体召喚:フレデリック」（独自枠・消去不可）を与える。"
			詳細文文字列受け渡し変数 += "<br>「霊体召喚:フレデリック」中は以下の効果を受ける。"
			詳細文文字列受け渡し変数 += "<br>＞［20％］の与ダメージ上昇"
			詳細文文字列受け渡し変数 += "<br>＞ 行動後、敵に[攻撃力×100％]の自属性ダメージを与える。"
			詳細文文字列受け渡し変数 += "<br>   召喚直後は特殊攻撃となり、敵に[攻撃力×100％]の自属性ダメージを3回与える。"
			SIF 段階 >= 2
				詳細文文字列受け渡し変数 += "<br>霊体召喚は行動回数を消費しない。"
			
			
		CASE "アビ効果"
			;3段階目からはターン消費無しになる
			SIF 段階 >= 2
				アビテンプレート用_行動消費無しフラグ = 1
			
			;召喚を切り替える前に、以前の固有効果を掃除
			CALL 戦闘効果直接削除(隊列番号, "バフ", "枠", "ファミリー_固有効果")
			CALL 戦闘効果直接削除(隊列番号, "バフ", "枠", "ファミリー_固有效果2")
			
			;召喚状態となる主バフ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			
			;メッセージ
			アビ汎用文字列:実行時メッセージ１ = %CALLNAME:キャラ番号%はリラを奏で、フレデリックを呼び出した！
			
			;効果処理
			アビ汎用文字列:バフ・デバフ枠 = ファミリー
			アビ汎用文字列:バフ・デバフ対象能力 = 霊体召喚:フレデリック
			アビ汎用文字列:バフ・デバフ名 = 霊体召喚:フレデリック
			アビ汎用文字列:バフ・デバフアイコン = 霊体召喚_フレデリック
			アビ汎用変数:持続ターン = 0
			アビ汎用変数:消去不可オプション = 1
			アビ汎用変数:特殊表示オプション = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			;自動生成されたバフ付与メッセージを削除
			IF A_M_NUM:0 > 0
				A_M_NUM:0 -= 1
				アビテンプレート用_表示メッセージ格納:0:(A_M_NUM:0) = 
			ENDIF
			
			;主バフに与ダメージ上昇効果を付随
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = ファミリー_固有效果
			アビ汎用文字列:バフ・デバフ対象能力 = 与ダメージ
			アビ汎用変数:効果割合 = 20
			CALL アビテンプレート_有利効果_付随バフ効果セット("ファミリー")
			
			;召喚直後の追撃制御
			IF 段階 >= 2
				;第3段階以降は無料召喚なので、召喚直後の追撃なし
				戦闘中カウント:戦闘行動キャラ:0 = 2
			ELSE
				;第1・第2段階は特殊追撃を発生
				戦闘中カウント:戦闘行動キャラ:0 = 1
			ENDIF
			
	ENDSELECT
ELSE
	;======================================================================================================================
	; ○獣爪
	;======================================================================================================================
	SELECTCASE ARGS
		CASE "アビ名"
			SELECTCASE 段階
				CASE 0
					TSTR:コマンド名受渡 = 獣爪-I
				CASE 1
					TSTR:コマンド名受渡 = 獣爪-II
				CASE 2
					TSTR:コマンド名受渡 = 獣爪-III
				CASE 3
					TSTR:コマンド名受渡 = 獣爪-IV
			ENDSELECT
			
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費MP表:段階}
			詳細文文字列受け渡し変数 += @"<br>敵単体に［攻撃力✕{威力表:段階}％］の無属性ダメージを与える。"
			RETURN 消費MP表:段階
			
		CASE "アビ効果"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵単体
			
			;メッセージ
			アビ汎用文字列:実行時メッセージ１ = %CALLNAME:キャラ番号%は獣爪を放った！<br>地を這う斬撃が敵を襲う！
			
			;効果処理
			アビ汎用変数:効果割合 = 威力表:段階
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_無属性
			
	ENDSELECT
ENDIF
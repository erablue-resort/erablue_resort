;==================================================================================================
@固有アビ_2642_3(ARGS, キャラ番号)
;-------------------------------------------------
;復讐者をタンクのスタンスに切り替える行動。[霊体召喚:セバスチャン]か否かでアビリティが変化
;●セバスチャンが召喚されていない⇒「霊体召喚:セバスチャン」
; [霊体召喚:セバスチャン]となり、被ダメージ減少と敵視上昇を付与し、行動後に特殊追撃が発生するようになる。
;○セバスチャンが召喚されている⇒「グレイオールの咆哮」
; 全体攻撃。与ダメージ減少と被ダメージ上昇のデバフを与える。燃費悪い。
;--------------------------------------------------------------------------------------------------
#DIM キャラ番号
#DIM 召喚MP

#DIM 隊列番号
#DIM ファミリーバフ
#DIM セバスチャン召喚中

#DIM 段階
#DIM 現在Lv
#DIM 必要Lv, 4
#DIM 威力表, 4
#DIM 消費MP表, 4
#DIM 召喚バフ量表, 4
#DIM 咆哮デバフ量表, 4
;--------------------------------------------------------------------------------------------------
;*** 配列作成 *************************************************************
現在Lv = 基礎BATTLE_STATE:キャラ番号:Lv

必要Lv:0 = 1
必要Lv:1 = 15
必要Lv:2 = 30
必要Lv:3 = 45

威力表:0 = 100
威力表:1 = 125
威力表:2 = 150
威力表:3 = 200

消費MP表:0 = 50
消費MP表:1 = 60
消費MP表:2 = 75
消費MP表:3 = 100

召喚バフ量表:0 = 20
召喚バフ量表:1 = 25
召喚バフ量表:2 = 30
召喚バフ量表:3 = 40

咆哮デバフ量表:0 = 15
咆哮デバフ量表:1 = 20
咆哮デバフ量表:2 = 25
咆哮デバフ量表:3 = 30

; 現在Lvで利用できる最上位の段階を取得
段階 = 0
FOR LOCAL, 0, 4
	SIF 現在Lv >= 必要Lv:LOCAL
		段階 = LOCAL
NEXT
;**************************************************************************

隊列番号 = キャラ隊列検索(キャラ番号)
ファミリーバフ = バフ番号取得_枠("ファミリー", 隊列番号)
セバスチャン召喚中 = 0

IF ファミリーバフ > -1
	SIF DT_CELL_GETS("戦闘効果データベース", ファミリーバフ, "対象能力") == "霊体召喚:セバスチャン"
		セバスチャン召喚中 = 1
ENDIF

;消費MPを算出
IF ダンジョン表示モード == "戦闘画面"
	召喚MP = (BATTLE_STATE:隊列番号:最大ＭＰ * 5 + 99) / 100
ELSE
	召喚MP = (基礎BATTLE_STATE:キャラ番号:最大ＭＰ * 5 + 99) / 100
ENDIF

;[霊体召喚:セバスチャン]か否か
IF !セバスチャン召喚中
	;======================================================================================================================
	; ●霊体召喚:セバスチャン
	;======================================================================================================================
	SELECTCASE ARGS
		CASE "アビ名"
			SELECTCASE 段階
				CASE 0
					TSTR:コマンド名受渡 = 霊体召喚:セバスチャン-I
				CASE 1
					TSTR:コマンド名受渡 = 霊体召喚:セバスチャン-II
				CASE 2
					TSTR:コマンド名受渡 = 霊体召喚:セバスチャン-III
				CASE 3
					TSTR:コマンド名受渡 = 霊体召喚:セバスチャン-IV
			ENDSELECT
			
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{召喚MP}(最大ＭＰの5％)
			詳細文文字列受け渡し変数 += "<br>霊体「セバスチャン」を召喚する。"
			詳細文文字列受け渡し変数 += "<br>「セバスチャン」召喚中は防衛能力が向上する。"
			SIF 段階 >= 2
				詳細文文字列受け渡し変数 += "<br>霊体召喚は行動回数を消費しない。"
			
			;非戦闘時の戦闘能力確認画面
			IF ダンジョン表示モード != "戦闘画面"
				詳細文文字列受け渡し変数 += "<br><br>【セバスチャン召喚中は以下に変化】"
				SELECTCASE 段階
					CASE 0
						詳細文文字列受け渡し変数 += "<br>[グレイオールの咆哮-I]"
					CASE 1
						詳細文文字列受け渡し変数 += "<br>[グレイオールの咆哮-II]"
					CASE 2
						詳細文文字列受け渡し変数 += "<br>[グレイオールの咆哮-III]"
					CASE 3
						詳細文文字列受け渡し変数 += "<br>[グレイオールの咆哮-IV]"
				ENDSELECT
				詳細文文字列受け渡し変数 += @"<br>消費ＭＰ：{消費MP表:段階}"
				詳細文文字列受け渡し変数 += @"<br>敵全体に［攻撃力✕{威力表:段階}％］の無属性ダメージを与える。"
				詳細文文字列受け渡し変数 += @"<br>［{咆哮デバフ量表:段階}％］（Ａ枠・3ターン）の与ダメージ減少効果を与える。"
				詳細文文字列受け渡し変数 += @"<br>［{咆哮デバフ量表:段階}％］（Ａ枠・3ターン）の被ダメージ上昇効果を与える。"
			ENDIF
			RETURN 召喚MP
			
		CASE "アビ説明文_詳細"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{召喚MP}(最大ＭＰの5％)
			詳細文文字列受け渡し変数 += "<br>自身に「霊体召喚:セバスチャン」（独自枠・消去不可）を与える。"
			詳細文文字列受け渡し変数 += "<br>「霊体召喚:セバスチャン」中は以下の効果を受ける。"
			詳細文文字列受け渡し変数 += @"<br>＞［{召喚バフ量表:段階}％］の被ダメージ減少"
			詳細文文字列受け渡し変数 += "<br>＞［100％］の敵対心上昇"
			詳細文文字列受け渡し変数 += "<br>＞ 行動後、敵に[攻撃力×100％]の自属性ダメージを与える。"
			詳細文文字列受け渡し変数 += "<br>   召喚直後は特殊攻撃となり、敵に[攻撃力×300％]の自属性ダメージを与える。"
			SIF 段階 >= 2
				詳細文文字列受け渡し変数 += "<br>霊体召喚は行動回数を消費しない。"
			
		CASE "アビ効果"
			;3段階目からはターン消費無しになる
			SIF 段階 >= 2
				アビテンプレート用_行動消費無しフラグ = 1
			
			;召喚を切り替える前に、以前の固有効果を掃除
			CALL 戦闘効果直接削除(隊列番号, "バフ", "枠", "ファミリー_固有効果")
			CALL 戦闘効果直接削除(隊列番号, "バフ", "枠", "ファミリー_固有效果2")
			
			;召喚状態となる主バフ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			
			;メッセージ
			アビ汎用文字列:実行時メッセージ１ = %CALLNAME:キャラ番号%はリラを奏で、セバスチャンを呼び出した！
			
			;効果処理
			アビ汎用文字列:バフ・デバフ枠 = ファミリー
			アビ汎用文字列:バフ・デバフ対象能力 = 霊体召喚:セバスチャン
			アビ汎用文字列:バフ・デバフ名 = 霊体召喚:セバスチャン
			アビ汎用文字列:バフ・デバフアイコン = 霊体召喚_セバスチャン
			アビ汎用変数:持続ターン = 0
			アビ汎用変数:消去不可オプション = 1
			アビ汎用変数:特殊表示オプション = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			;自動生成されたバフ付与メッセージを削除
			IF A_M_NUM:0 > 0
				A_M_NUM:0 -= 1
				アビテンプレート用_表示メッセージ格納:0:(A_M_NUM:0) = 
			ENDIF
			
			;主バフに被ダメージ減少効果を付随
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = ファミリー_固有效果
			アビ汎用文字列:バフ・デバフ対象能力 = 被ダメージ
			アビ汎用変数:効果割合 = 召喚バフ量表:段階
			CALL アビテンプレート_有利効果_付随バフ効果セット("ファミリー")
			
			;主バフに敵対心上昇効果を付随
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = ファミリー_固有效果2
			アビ汎用文字列:バフ・デバフ対象能力 = 敵対心
			アビ汎用変数:効果割合 = 100
			CALL アビテンプレート_有利効果_付随バフ効果セット("ファミリー")
			
			;召喚直後の追撃制御
			IF 段階 >= 2
				;第3段階以降は無料召喚なので、召喚直後の追撃なし
				戦闘中カウント:戦闘行動キャラ:0 = 2
			ELSE
				;第1・第2段階は特殊追撃を発生
				戦闘中カウント:戦闘行動キャラ:0 = 1
			ENDIF
			
	ENDSELECT
ELSE
	;======================================================================================================================
	; ○グレイオールの咆哮
	;======================================================================================================================
	SELECTCASE ARGS
		CASE "アビ名"
			SELECTCASE 段階
				CASE 0
					TSTR:コマンド名受渡 = グレイオールの咆哮-I
				CASE 1
					TSTR:コマンド名受渡 = グレイオールの咆哮-II
				CASE 2
					TSTR:コマンド名受渡 = グレイオールの咆哮-III
				CASE 3
					TSTR:コマンド名受渡 = グレイオールの咆哮-IV
			ENDSELECT
			
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費MP表:段階}
			詳細文文字列受け渡し変数 += @"<br>敵全体に［攻撃力✕{威力表:段階}％］の無属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>［{咆哮デバフ量表:段階}％］（Ａ枠・3ターン）の与ダメージ減少効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>［{咆哮デバフ量表:段階}％］（Ａ枠・3ターン）の被ダメージ上昇効果を与える。"
			RETURN 消費MP表:段階
			
		CASE "アビ効果"
			
			;ダメージ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			
			;メッセージ
			アビ汎用文字列:実行時メッセージ１ = %CALLNAME:キャラ番号%はグレイオールの咆哮を行った！<br>大老竜の咆哮が轟き、衝撃と共に周囲の敵を委縮させる！
			
			;効果処理
			アビ汎用変数:効果割合 = 威力表:段階
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_無属性
			
			;デバフ
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 与ダメージA
			アビ汎用文字列:バフ・デバフ対象能力 = 与ダメージ
			アビ汎用変数:効果割合 = 咆哮デバフ量表:段階
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 被ダメージA
			アビ汎用文字列:バフ・デバフ対象能力 = 被ダメージ
			アビ汎用変数:効果割合 = 咆哮デバフ量表:段階
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_不利効果_デバフ効果セット
			
		ENDSELECT
ENDIF

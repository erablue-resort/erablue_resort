;==================================================================================================
@固有アビ_2642_1(ARGS, キャラ番号)
;-------------------------------------------------
;復讐者をヒーラーのスタンスに切り替える行動。[霊体召喚:ヘレン]か否かでアビリティが変化
;●ヘレンが召喚されていない⇒「霊体召喚:ヘレン」
; [霊体召喚:ヘレン]となり、5%の再生効果、与回復量上昇を付与し、行動後に特殊追撃が発生するようになる。
;○ヘレンが召喚されている⇒「黄金樹の回復」
; 全体回復。
;--------------------------------------------------------------------------------------------------
#DIM キャラ番号
#DIM 召喚MP

#DIM 隊列番号
#DIM ファミリーバフ
#DIM ヘレン召喚中

#DIM 段階
#DIM 現在Lv
#DIM 必要Lv, 4
#DIM 威力表, 4
#DIM 消費MP表, 4
;--------------------------------------------------------------------------------------------------
;*** 配列作成 *************************************************************
現在Lv = 基礎BATTLE_STATE:キャラ番号:Lv

必要Lv:0 = 1
必要Lv:1 = 15
必要Lv:2 = 30
必要Lv:3 = 45

威力表:0 = 200
威力表:1 = 225
威力表:2 = 250
威力表:3 = 300

消費MP表:0 = 24
消費MP表:1 = 28
消費MP表:2 = 32
消費MP表:3 = 36

; 現在Lvで利用できる最上位の段階を取得
段階 = 0
FOR LOCAL, 0, 4
	SIF 現在Lv >= 必要Lv:LOCAL
		段階 = LOCAL
NEXT
;**************************************************************************

隊列番号 = キャラ隊列検索(キャラ番号)
ファミリーバフ = バフ番号取得_枠("ファミリー", 隊列番号)
ヘレン召喚中 = 0

IF ファミリーバフ > -1
	SIF DT_CELL_GETS("戦闘効果データベース", ファミリーバフ, "対象能力") == "霊体召喚:ヘレン"
		ヘレン召喚中 = 1
ENDIF

;消費MPを算出
IF ダンジョン表示モード == "戦闘画面"
	召喚MP = (BATTLE_STATE:隊列番号:最大ＭＰ * 5 + 99) / 100
ELSE
	召喚MP = (基礎BATTLE_STATE:キャラ番号:最大ＭＰ * 5 + 99) / 100
ENDIF

;[霊体召喚:ヘレン]か否か
IF !ヘレン召喚中
	;======================================================================================================================
	; ●霊体召喚:ヘレン
	;======================================================================================================================
	SELECTCASE ARGS
		CASE "アビ名"
			SELECTCASE 段階
				CASE 0
					TSTR:コマンド名受渡 = 霊体召喚:ヘレン-I
				CASE 1
					TSTR:コマンド名受渡 = 霊体召喚:ヘレン-II
				CASE 2
					TSTR:コマンド名受渡 = 霊体召喚:ヘレン-III
				CASE 3
					TSTR:コマンド名受渡 = 霊体召喚:ヘレン-IV
			ENDSELECT
			
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{召喚MP}(最大ＭＰの5％)
			詳細文文字列受け渡し変数 += "<br>霊体「ヘレン」を召喚する。"
			詳細文文字列受け渡し変数 += "<br>「ヘレン」召喚中は回復能力が向上する。"
			SIF 段階 >= 2
				詳細文文字列受け渡し変数 += "<br>霊体召喚は行動回数を消費しない。"
			
			;非戦闘時の戦闘能力確認画面
			IF ダンジョン表示モード != "戦闘画面"
				詳細文文字列受け渡し変数 += "<br><br>【ヘレン召喚中は以下に変化】"
				SELECTCASE 段階
					CASE 0
						詳細文文字列受け渡し変数 += "<br>[黄金樹の回復-I]"
					CASE 1
						詳細文文字列受け渡し変数 += "<br>[黄金樹の回復-II]"
					CASE 2
						詳細文文字列受け渡し変数 += "<br>[黄金樹の回復-III]"
					CASE 3
						詳細文文字列受け渡し変数 += "<br>[黄金樹の回復-IV]"
				ENDSELECT
				詳細文文字列受け渡し変数 += @"<br>消費ＭＰ：{消費MP表:段階}"
				詳細文文字列受け渡し変数 += @"<br>味方全体に［回復力✕{威力表:段階}％］のＨＰ回復を与える。"
			ENDIF
			RETURN 召喚MP
			
		CASE "アビ説明文_詳細"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{召喚MP}(最大ＭＰの5％)
			詳細文文字列受け渡し変数 += "<br>自身に「霊体召喚:ヘレン」（独自枠・消去不可）を与える。"
			詳細文文字列受け渡し変数 += "<br>「霊体召喚:ヘレン」中は以下の効果を受ける。"
			詳細文文字列受け渡し変数 += "<br>＞［5％］の再生"
			詳細文文字列受け渡し変数 += "<br>＞［20％］の与回復量上昇"
			詳細文文字列受け渡し変数 += "<br>＞ 行動後、敵に[攻撃力×50％]の自属性ダメージを2回与える。"
			詳細文文字列受け渡し変数 += "<br>   召喚直後は特殊攻撃となり、敵に[攻撃力×70％]の自属性ダメージを4回与える。"
			SIF 段階 >= 2
				詳細文文字列受け渡し変数 += "<br>霊体召喚は行動回数を消費しない。"
				
		CASE "アビ効果"
			;3段階目からはターン消費無しになる
			SIF 段階 >= 2
				アビテンプレート用_行動消費無しフラグ = 1
			
			;召喚を切り替える前に、以前の固有効果を掃除
			CALL 戦闘効果直接削除(隊列番号, "バフ", "枠", "ファミリー_固有効果")
			CALL 戦闘効果直接削除(隊列番号, "バフ", "枠", "ファミリー_固有效果2")
			
			;召喚状態となる主バフ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			
			;メッセージ
			アビ汎用文字列:実行時メッセージ１ = %CALLNAME:キャラ番号%はリラを奏で、ヘレンを呼び出した！
			
			;効果処理
			アビ汎用文字列:バフ・デバフ枠 = ファミリー
			アビ汎用文字列:バフ・デバフ対象能力 = 霊体召喚:ヘレン
			アビ汎用文字列:バフ・デバフ名 = 霊体召喚:ヘレン
			アビ汎用文字列:バフ・デバフアイコン = 霊体召喚_ヘレン
			アビ汎用変数:持続ターン = 0
			アビ汎用変数:消去不可オプション = 1
			アビ汎用変数:特殊表示オプション = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			;自動生成されたバフ付与メッセージを削除
			IF A_M_NUM:0 > 0
				A_M_NUM:0 -= 1
				アビテンプレート用_表示メッセージ格納:0:(A_M_NUM:0) = 
			ENDIF
			
			;主バフに再生を付随
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = ファミリー_固有効果
			アビ汎用文字列:バフ・デバフ対象能力 = 再生
			アビ汎用変数:効果割合 = 5
			CALL アビテンプレート_有利効果_付随バフ効果セット("ファミリー")
			
			;主バフに与回復量上昇効果を付随
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = ファミリー_固有效果2
			アビ汎用文字列:バフ・デバフ対象能力 = 与回復量
			アビ汎用変数:効果割合 = 20
			CALL アビテンプレート_有利効果_付随バフ効果セット("ファミリー")
			
			;召喚直後の追撃制御
			IF 段階 >= 2
				;第3段階以降は無料召喚なので、召喚直後の追撃なし
				戦闘中カウント:戦闘行動キャラ:0 = 2
			ELSE
				;第1・第2段階は特殊追撃を発生
				戦闘中カウント:戦闘行動キャラ:0 = 1
			ENDIF
			
	ENDSELECT
	
ELSE
	;======================================================================================================================
	; ○黄金樹の回復
	;======================================================================================================================
	SELECTCASE ARGS
		CASE "アビ名"
			SELECTCASE 段階
				CASE 0
					TSTR:コマンド名受渡 = 黄金樹の回復-I
				CASE 1
					TSTR:コマンド名受渡 = 黄金樹の回復-II
				CASE 2
					TSTR:コマンド名受渡 = 黄金樹の回復-III
				CASE 3
					TSTR:コマンド名受渡 = 黄金樹の回復-IV
			ENDSELECT
			
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 '= @"消費ＭＰ：{消費MP表:段階}"
			詳細文文字列受け渡し変数 += @"<br>味方全体に［回復力✕{威力表:段階}％］のＨＰ回復を与える。"
			RETURN 消費MP表:段階
			
		CASE "アビ効果"
			
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
			アビ汎用変数:効果割合 = 威力表:段階
			アビ汎用文字列:回復側使用能力値 = 回復力
			CALL アビテンプレート_回復処理_MAXでも回復
	ENDSELECT

ENDIF




;==================================================================================================
@固有奥義_2642(ARGS, キャラ番号)
;-------------------------------------------------
;①敵全体に霊炎爆発による自属性ダメージ
;②戦闘不能の味方の復活
;③味方全体の回復
;④味方全体に与ダメージ上昇効果
;⑤復讐者に最大HPの50％の自傷ダメージ
;⑥霊体追撃の特殊攻撃フラグ
;--------------------------------------------------------------------------------------------------
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力

#DIM 自傷ダメージ
;--------------------------------------------------------------------------------------------------

奥義名 = 不死の行進
	奥義威力 = 0
	表示用奥義威力 = 300
SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		詳細文文字列受け渡し変数 = 
		詳細文文字列受け渡し変数 += "<br>敵全体に［攻撃力×300％］の自属性ダメージを与え、"
		詳細文文字列受け渡し変数 += "<br>味方全体に復活、［回復力✕300％］のＨＰ回復、ガッツ、与ダメージ上昇効果を与える。"
		詳細文文字列受け渡し変数 += "<br>自身は［最大ＨＰ✕50％］の自傷ダメージを受ける。"
		詳細文文字列受け渡し変数 += "<br>召喚中の霊体に特殊攻撃を命令する。"
		詳細文文字列受け渡し変数 += "<br> "
		RETURN 奥義威力
		
	CASE "奥義説明文_詳細"
			詳細文文字列受け渡し変数 =
			詳細文文字列受け渡し変数 += "敵全体に［攻撃力×300％］の自属性ダメージを与える。"
			詳細文文字列受け渡し変数 += "<br><br>戦闘不能の味方を復活させる。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［回復力✕300％］のＨＰ回復を与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に（Ａ枠・1ターン）のガッツ効果を与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［25％］（Ａ枠・3ターン）の与ダメージ上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br><br>自身は［最大ＨＰ✕50％］分の自傷ダメージを受ける。"
			詳細文文字列受け渡し変数 += "<br><br>召喚中の霊体に特殊攻撃を命令する。"
			
	CASE "奥義前効果"
		
	CASE "奥義追加効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_敵全体_生者のみ
		
		;発動時のメッセージ
		SELECTCASE RAND:4
			CASE 0 
				アビ汎用文字列:実行時メッセージ１ = 『この……腑抜けがァァァッ！』
			CASE 1
				アビ汎用文字列:実行時メッセージ１ = 『畳みかけるぞ……ッ！』
			CASE 2
				アビ汎用文字列:実行時メッセージ１ = 『夜を払う……ッ！』
			CASE 3
				アビ汎用文字列:実行時メッセージ１ = 『立ち上がれ……復讐の時だッ！』
		ENDSELECT
		
		アビ汎用変数:効果割合 = 300
		アビ汎用文字列:攻撃側使用能力値 = 攻撃力
		CALL アビテンプレート_ダメージ処理_自属性
		
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方全体
		アビ汎用変数:効果割合 = 300
		アビ汎用文字列:回復側使用能力値 = 回復力
		アビ汎用変数:蘇生可能オプション = 1
		CALL アビテンプレート_回復処理_MAXでも回復
		
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方全体
		アビ汎用文字列:バフ・デバフ枠 = ガッツA
		アビ汎用文字列:バフ・デバフ対象能力 = ガッツ
		アビ汎用変数:持続ターン = 2
		CALL アビテンプレート_有利効果_バフ効果セット
		
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 与ダメージA
		アビ汎用文字列:バフ・デバフ対象能力 = 与ダメージ
		アビ汎用変数:効果割合 = 25
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_バフ効果セット
		
		;最大HPの50％分、自身にダメージ
		自傷ダメージ = BATTLE_STATE:戦闘行動キャラ:最大ＨＰ * 50 / 100
		BATTLE_STATE:戦闘行動キャラ:ＨＰ = MAX(BATTLE_STATE:戦闘行動キャラ:ＨＰ - 自傷ダメージ, 1)

		;特殊攻撃フラグ
		戦闘中カウント:戦闘行動キャラ:0 = 1
			
ENDSELECT
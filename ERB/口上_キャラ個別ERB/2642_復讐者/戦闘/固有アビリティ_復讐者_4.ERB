;==================================================================================================
@固有アビ_2642_4(ARGS, キャラ番号)
;-------------------------------------------------
;召喚中の霊体によって変化するアビリティ
;○ヘレンが召喚されている⇒「回帰性原理」
; 敵全体のバフを解除、味方全体のデバフを解除する
;○フレデリックが召喚されている⇒「黒き剣」
; 敵単体に大ダメージ、強圧・自傷を付与
;○セバスチャンが召喚されている⇒「黄金樹に誓って」
; 味方全体に与ダメージ上昇、被ダメージ減少のバフ
;●何も召喚されていない⇒「白い影の誘い」
; 自分の敵対心を大きく下げる
;--------------------------------------------------------------------------------------------------
#DIM キャラ番号
#DIM 消費ＭＰ

#DIM 隊列番号
#DIM ファミリーバフ

#DIM 段階
#DIM 現在Lv
#DIM 必要Lv, 2
#DIM 威力表, 2
#DIM 消費MP表, 2
#DIM バフ量表, 2
;--------------------------------------------------------------------------------------------------
;*** 配列作成 *************************************************************
現在Lv = 基礎BATTLE_STATE:キャラ番号:Lv

必要Lv:0 = 30
必要Lv:1 = 45

威力表:0 = 150
威力表:1 = 200

消費MP表:0 = 36
消費MP表:1 = 48

バフ量表:0 = 10
バフ量表:1 = 20

; 現在Lvで利用できる最上位の段階を取得
段階 = 0
FOR LOCAL, 0, 2
	SIF 現在Lv >= 必要Lv:LOCAL
		段階 = LOCAL
NEXT
;**************************************************************************
;Lv30で習得
SIF 基礎BATTLE_STATE:キャラ番号:Lv < 30
	RETURN

;召喚中のファミリーを取得
隊列番号 = キャラ隊列検索(キャラ番号)
ファミリーバフ = バフ番号取得_枠("ファミリー", 隊列番号)

;霊体が召喚されているかどうかで分岐
IF ファミリーバフ >= 0
	;召喚中の霊体によって分岐
	SELECTCASE DT_CELL_GETS("戦闘効果データベース", ファミリーバフ, "対象能力")
		CASE "霊体召喚:ヘレン"
			;======================================================================================================================
			; ○回帰性原理
			;======================================================================================================================
			SELECTCASE ARGS
				CASE "アビ名"
					TSTR:コマンド名受渡 = 回帰性原理
					
				CASE "アビ説明文"
					詳細文文字列受け渡し変数 = 消費ＭＰ：36
					詳細文文字列受け渡し変数 += "<br>味方全体に［3］のデバフ消去効果を与える。"
					詳細文文字列受け渡し変数 += "<br>敵全体に［3］のバフ消去効果を与える。"
					RETURN 36
					
				CASE "アビ効果"
					CALL アビ汎用変数文字列リセット
					CALL アビ対象選択テンプレート_味方全体
					CALL アビテンプレート_有利効果_デバフ消去
					CALL アビテンプレート_有利効果_デバフ消去
					CALL アビテンプレート_有利効果_デバフ消去
					
					CALL アビ汎用変数文字列リセット
					CALL アビ対象選択テンプレート_敵全体_生者のみ
					アビ汎用変数:基礎成功確率 = 100
					CALL アビテンプレート_不利効果_バフ消去
					CALL アビテンプレート_不利効果_バフ消去
					CALL アビテンプレート_不利効果_バフ消去
					
			ENDSELECT
			
		CASE "霊体召喚:フレデリック"
			;======================================================================================================================
			; ○黒き剣
			;======================================================================================================================
			SELECTCASE ARGS
				CASE "アビ名"
					SELECTCASE 段階
						CASE 0
							TSTR:コマンド名受渡 = 黒き剣-I
						CASE 1
							TSTR:コマンド名受渡 = 黒き剣-II
					ENDSELECT
					
				CASE "アビ説明文"
					詳細文文字列受け渡し変数 = 消費ＭＰ：{消費MP表:段階}
					詳細文文字列受け渡し変数 += @"<br>敵単体に［{威力表:段階}％］の光属性ダメージを2回与える。"
					詳細文文字列受け渡し変数 += "<br>（Ａ枠・3ターン）の強圧効果を与える。"
					詳細文文字列受け渡し変数 += "<br>［10％］（Ａ枠・3ターン）の自傷効果を与える。"
					RETURN 消費MP表:段階
					
				CASE "アビ効果"
					;
					CALL アビ汎用変数文字列リセット
					CALL アビ対象選択テンプレート_敵単体
					
					;メッセージ
					アビ汎用文字列:実行時メッセージ１ = %CALLNAME:キャラ番号%は黒き剣を放った！<br>斬撃から生じた赤黒い光波が敵を両断する！
					
					;効果処理
					アビ汎用変数:効果割合 = 威力表:段階
					アビ汎用文字列:攻撃側使用能力値 = 攻撃力
					FOR LOCAL, 0, 2
						CALL アビテンプレート_ダメージ処理_光属性
					NEXT
					;
					CALL アビ汎用変数文字列リセット
					アビ汎用文字列:バフ・デバフ枠 = 強圧A
					アビ汎用文字列:バフ・デバフ対象能力 = 強圧
					アビ汎用変数:持続ターン = 3
					CALL アビテンプレート_不利効果_デバフ効果セット
					;
					CALL アビ汎用変数文字列リセット
					アビ汎用文字列:バフ・デバフ枠 = 自傷A
					アビ汎用文字列:バフ・デバフ対象能力 = 自傷
					アビ汎用変数:効果割合 = 10
					アビ汎用変数:持続ターン = 3
					CALL アビテンプレート_不利効果_デバフ効果セット
					
			ENDSELECT
			
		CASE "霊体召喚:セバスチャン"
			;======================================================================================================================
			; ○黄金樹に誓って
			;======================================================================================================================
			SELECTCASE ARGS
				CASE "アビ名"
					SELECTCASE 段階
						CASE 0
							TSTR:コマンド名受渡 = 黄金樹に誓って-I
						CASE 1
							TSTR:コマンド名受渡 = 黄金樹に誓って-II
					ENDSELECT
					
				CASE "アビ説明文"
					詳細文文字列受け渡し変数 = 消費ＭＰ：{消費MP表:段階}
					詳細文文字列受け渡し変数 += @"<br>味方全体に［{バフ量表:段階}％］（Ｃ枠・3ターン）の与ダメージ上昇効果を与える。"
					詳細文文字列受け渡し変数 += @"<br>［{バフ量表:段階}％］（Ｃ枠・3ターン）の被ダメージ減少効果を与える。"
					RETURN 消費MP表:段階
					
				CASE "アビ効果"
					CALL アビ汎用変数文字列リセット
					CALL アビ対象選択テンプレート_味方全体
					アビ汎用文字列:バフ・デバフ枠 = 与ダメージC
					アビ汎用文字列:バフ・デバフ対象能力 = 与ダメージ
					アビ汎用変数:効果割合 = バフ量表:段階
					アビ汎用変数:持続ターン = 3
					CALL アビテンプレート_有利効果_バフ効果セット
					CALL アビ汎用変数文字列リセット
					アビ汎用文字列:バフ・デバフ枠 = 被ダメージC
					アビ汎用文字列:バフ・デバフ対象能力 = 被ダメージ
					アビ汎用変数:効果割合 = バフ量表:段階
					アビ汎用変数:持続ターン = 3
					CALL アビテンプレート_有利効果_バフ効果セット
					
			ENDSELECT
			
			
	ENDSELECT
ELSE
	;======================================================================================================================
	; ●白い影の誘い
	;======================================================================================================================
	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = 白い影の誘い
			
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：8
			詳細文文字列受け渡し変数 += "<br>自身に［50％］（Ａ枠・3ターン）の敵対心減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>このアビリティは召喚中のファミリーに応じて変化する。"
			;非戦闘時の戦闘能力確認画面
			IF ダンジョン表示モード != "戦闘画面"
				詳細文文字列受け渡し変数 += "<br><br>【ヘレン召喚中は以下に変化】"
				詳細文文字列受け渡し変数 += "<br>［回帰性原理］"
				詳細文文字列受け渡し変数 += "<br>消費ＭＰ：36"
				詳細文文字列受け渡し変数 += "<br>味方全体に［3］のデバフ消去効果を与える。"
				詳細文文字列受け渡し変数 += "<br>敵全体に［3］のバフ消去効果を与える。"
				
				詳細文文字列受け渡し変数 += "<br><br>【フレデリック召喚中は以下に変化】"
				SELECTCASE 段階
					CASE 0
						詳細文文字列受け渡し変数 += "<br>[黒き剣-I]"
					CASE 1
						詳細文文字列受け渡し変数 += "<br>[黒き剣-II]"
				ENDSELECT
				詳細文文字列受け渡し変数 += @"<br>消費ＭＰ：{消費MP表:段階}"
				詳細文文字列受け渡し変数 += @"<br>敵単体に［{威力表:段階}％］の光属性ダメージを2回与える。"
				詳細文文字列受け渡し変数 += "<br>（Ａ枠・3ターン）の強圧効果を与える。"
				詳細文文字列受け渡し変数 += "<br>［10％］（Ａ枠・3ターン）の自傷効果を与える。"
				
				詳細文文字列受け渡し変数 += "<br><br>【セバスチャン召喚中は以下に変化】"
				SELECTCASE 段階
					CASE 0
						詳細文文字列受け渡し変数 += "<br>[黄金樹に誓って-I]"
					CASE 1
						詳細文文字列受け渡し変数 += "<br>[黄金樹に誓って-II]"
				ENDSELECT
				詳細文文字列受け渡し変数 += @"<br>消費ＭＰ：{消費MP表:段階}"
				詳細文文字列受け渡し変数 += @"<br>味方全体に［{バフ量表:段階}％］（Ｃ枠・3ターン）の与ダメージ上昇効果を与える。"
				詳細文文字列受け渡し変数 += @"<br>［{バフ量表:段階}％］（Ｃ枠・3ターン）の被ダメージ減少効果を与える。"
			ENDIF
			RETURN 8
			
		CASE "アビ効果"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = 敵対心A
			アビ汎用文字列:バフ・デバフ対象能力 = 敵対心
			アビ汎用変数:効果割合 = -50
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			
	ENDSELECT
ENDIF
;==================================================================================================
@固有行動直後処理_キャラ_2642
;-------------------------------------------------
;召喚しているファミリーに応じた行動後の霊体追撃の処理
;直前の行動が敵単体なら同一の敵を、それ以外ならランダムに追撃を発生させる
;奥義使用後、召喚直後で特殊攻撃が発生
;--------------------------------------------------------------------------------------------------
#DIM ファミリーバフ
#DIM 直前対象
#DIM 敵単体行動フラグ
;--------------------------------------------------------------------------------------------------
ファミリーバフ = バフ番号取得_枠("ファミリー", 戦闘行動キャラ)

;霊体が召喚されていなければ終了
SIF ファミリーバフ < 0
	RETURN

;III以降の無料召喚直後は追撃せず、次の行動後に特殊追撃を発生させる
IF 戦闘中カウント:戦闘行動キャラ:0 == 2
	戦闘中カウント:戦闘行動キャラ:0 = 1
	RETURN
ENDIF

;追撃の対象選択で上書きされる前に、直前の行動対象を保存
直前対象 = アビテンプレート用_対象保存:0

;前回呼び出し時の判定を残さない
敵単体行動フラグ = 0

;敵が1体だけ対象になっているか
IF INRANGE(直前対象, 10, 19) && アビテンプレート用_対象保存:1 < 0
    敵単体行動フラグ = 1
ENDIF

CALL アビ汎用変数文字列リセット

;召喚中の霊体によって分岐
SELECTCASE DT_CELL_GETS("戦闘効果データベース", ファミリーバフ, "対象能力")
	CASE "霊体召喚:ヘレン"
		IF 戦闘中カウント:戦闘行動キャラ:0 == 1
			CALL アビ汎用変数文字列リセット
			;特殊追撃
			アビテンプレート用_アビ名 = 霊体特殊追撃:ヘレン
			アビ汎用文字列:実行時メッセージ１ = ヘレンの特殊追撃！<br>「切り刻め、ヘレン！」
			
			;直前の行動が生存中の敵単体を対象としていた場合、同じ敵を狙う
			IF 敵単体行動フラグ
				IF 敵BATTLE_STATE:(直前対象 - 10):ＨＰ > 0
					CALL アビ対象選択テンプレート_指定(直前対象)
				ELSE
					CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
				ENDIF
			ELSE
				CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
			ENDIF
			
			アビ汎用変数:効果割合 = 70
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
			CALL アビテンプレート_ダメージ処理_自属性
			CALL アビテンプレート_ダメージ処理_自属性
			CALL アビテンプレート_ダメージ処理_自属性
			
			;特殊攻撃フラグを閉じる
			戦闘中カウント:戦闘行動キャラ:0 = 0
			
		ELSE
			;通常追撃
			アビテンプレート用_アビ名 = 霊体追撃:ヘレン
			アビ汎用文字列:実行時メッセージ１ = ヘレンの追撃！
			
			;直前の行動が生存中の敵単体を対象としていた場合、同じ敵を狙う
			IF 敵単体行動フラグ
				IF 敵BATTLE_STATE:(直前対象 - 10):ＨＰ > 0
					CALL アビ対象選択テンプレート_指定(直前対象)
				ELSE
					CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
				ENDIF
			ELSE
				CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
			ENDIF
			
			アビ汎用変数:効果割合 = 50
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
			CALL アビテンプレート_ダメージ処理_自属性
		ENDIF
		
	CASE "霊体召喚:フレデリック"
		IF 戦闘中カウント:戦闘行動キャラ:0 == 1
			;特殊追撃
			アビテンプレート用_アビ名 = 霊体特殊追撃:フレデリック
			アビ汎用文字列:実行時メッセージ１ = フレデリックの特殊追撃！<br>「叩き潰せ、フレデリック！」
			
			;直前の行動が生存中の敵単体を対象としていた場合、同じ敵を狙う
			IF 敵単体行動フラグ
				IF 敵BATTLE_STATE:(直前対象 - 10):ＨＰ > 0
					CALL アビ対象選択テンプレート_指定(直前対象)
				ELSE
					CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
				ENDIF
			ELSE
				CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
			ENDIF
			
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
			CALL アビテンプレート_ダメージ処理_自属性
			CALL アビテンプレート_ダメージ処理_自属性
			
			;特殊攻撃フラグを閉じる
			戦闘中カウント:戦闘行動キャラ:0 = 0
			
		ELSE
			;通常追撃
			アビテンプレート用_アビ名 = 霊体追撃:フレデリック
			アビ汎用文字列:実行時メッセージ１ = フレデリックの追撃！
			
			;直前の行動が生存中の敵単体を対象としていた場合、同じ敵を狙う
			IF 敵単体行動フラグ
				IF 敵BATTLE_STATE:(直前対象 - 10):ＨＰ > 0
					CALL アビ対象選択テンプレート_指定(直前対象)
				ELSE
					CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
				ENDIF
			ELSE
				CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
			ENDIF
			
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
		ENDIF
		
		
	CASE "霊体召喚:セバスチャン"
		IF 戦闘中カウント:戦闘行動キャラ:0 == 1
			;特殊追撃
			アビテンプレート用_アビ名 = 霊体特殊追撃:セバスチャン
			アビ汎用文字列:実行時メッセージ１ = セバスチャンの特殊追撃！<br>「薙ぎ払え、セバスチャン！」
			アビ汎用文字列:実行時メッセージ２ = 
			
			;直前の行動が生存中の敵単体を対象としていた場合、同じ敵を狙う
			IF 敵単体行動フラグ
				IF 敵BATTLE_STATE:(直前対象 - 10):ＨＰ > 0
					CALL アビ対象選択テンプレート_指定(直前対象)
				ELSE
					CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
				ENDIF
			ELSE
				CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
			ENDIF
			
			アビ汎用変数:効果割合 = 300
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
			
			;特殊攻撃フラグを閉じる
			戦闘中カウント:戦闘行動キャラ:0 = 0
			
		ELSE
			;通常追撃
			アビテンプレート用_アビ名 = 霊体追撃:セバスチャン
			アビ汎用文字列:実行時メッセージ１ = セバスチャンの追撃！
			
			;直前の行動が生存中の敵単体を対象としていた場合、同じ敵を狙う
			IF 敵単体行動フラグ
				IF 敵BATTLE_STATE:(直前対象 - 10):ＨＰ > 0
					CALL アビ対象選択テンプレート_指定(直前対象)
				ELSE
					CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
				ENDIF
			ELSE
				CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
			ENDIF
			
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
		ENDIF
		
		
ENDSELECT



;==================================================================================================
@バフ・デバフ特殊表示_ファミリー(隊列番号, バフ・デバフ行数)
;--------------------------------------------------------------------------------------------------
#DIM 隊列番号
#DIM バフ・デバフ行数
;--------------------------------------------------------------------------------------------------
SELECTCASE DT_CELL_GETS("戦闘効果データベース", バフ・デバフ行数, "対象能力")
	CASE "霊体召喚:ヘレン"
		;ヘレン召喚中の表示
		PRINTFORML 【ヘレン召喚中】
		PRINTFORML 行動後、ヘレンが追撃を行う
		PRINTFORML 再生と与回復量が上昇している
		
	CASE "霊体召喚:フレデリック"
		;フレデリック召喚中の表示
		PRINTFORML 【フレデリック召喚中】
		PRINTFORML 行動後、フレデリックが追撃を行う
		PRINTFORML 与ダメージが上昇している
		
	CASE "霊体召喚:セバスチャン"
		;セバスチャン召喚中の表示
		PRINTFORML 【セバスチャン召喚中】
		PRINTFORML 行動後、セバスチャンが追撃を行う
		PRINTFORML 被ダメージが減少し、敵に狙われやすくなっている
		
ENDSELECT




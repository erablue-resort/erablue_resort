
@固有奥義_2602(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM ロキシー隊列
#DIM クールタイム

ロキシー隊列 = キャラ隊列検索(GETCHARA(2602))
; IF レベルやイベント完了などで強化される場合、奥義名や奥義威力などを分岐させる
; 	奥義名 = （任意の奥義名）
; 	奥義威力 = （任意の奥義威力数値。汎用奥義は300、固有奥義は400～500を基準とする）
; ELSE
IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
	奥義名 = アブソリュート・ゼロ
ELSE
	奥義名 = フロストノヴァ
ENDIF
	奥義威力 = 0
; ENDIF

;奥義威力を0にした場合、通常の奥義処理は行われず奥義追加効果のみが行われる。
;全体攻撃にしたい時や、攻撃しない奥義を作る場合は0に設定のこと 

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		詳細文文字列受け渡し変数 = 奥義威力：{奥義威力}％<br>「詠唱」1ターン後 
		詳細文文字列受け渡し変数 += @"<br>敵全体に「湿潤」状態を与える。氷結Lvが2上昇［最大Lv10/5ターン/回復不可］"
		詳細文文字列受け渡し変数 += @"<br>［80％］（通常枠・2ターン）の麻痺効果を与える。成功率60％。"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			詳細文文字列受け渡し変数 += @"<br>敵全体に［100％］の水属性ダメージを与える。"
		ENDIF
		RETURN 奥義威力
	CASE "奥義前効果"
		;対象決定の後、ダメージよりも前に発生する効果。基本の奥義ダメージ部分は記載する必要はない。
		;奥義威力が0だとここの部分もスキップされる
	CASE "奥義追加効果"
		;ここに奥義効果を記述する。基本の奥義ダメージ部分は記載する必要はない。
		;基本的にアビテンプレートの関数を使用すること
		;テンプレート使用の例は固有アビリティ_キャラ名.ERBに記載
		戦闘中カウント:ロキシー隊列:10 = 10
		CALL 一ターン詠唱()

		
ENDSELECT


@固有アビ_2602_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM ロキシー隊列
#DIM クールタイム

ロキシー隊列 = キャラ隊列検索(GETCHARA(2602))
;レベルなどの条件でアビを強化する場合、アビ名の文字列を条件分岐で変化させる

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 35
	アビ名 = 氷槍吹雪
	消費ＭＰ = 50
ELSE
	アビ名 = 氷霜撃
	消費ＭＰ = 30
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>「詠唱」1ターン後 
		IF アビ名 == "氷槍吹雪"
			詳細文文字列受け渡し変数 += @"<br>敵全体に［250％］の水属性ダメージを与える。"
		ELSE
			詳細文文字列受け渡し変数 += @"<br>敵単体に［250％］の水属性ダメージを与える。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		戦闘中カウント:ロキシー隊列:10 = 1
		CALL 一ターン詠唱()
	
		

ENDSELECT

@一ターン詠唱()
;#FUNCTION
CALL アビ対象選択テンプレート_自己のみ
CALL アビ汎用変数文字列リセット
アビ汎用変数:効果割合 = 30
アビ汎用文字列:バフ・デバフ枠 = 詠唱
アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
アビ汎用変数:消去不可オプション = 1
アビ汎用変数:持続ターン = 2
CALL アビテンプレート_有利効果_バフ効果セット

CALL アビ汎用変数文字列リセット
アビ汎用文字列:バフ・デバフ枠 = 詠唱_回避率
アビ汎用文字列:バフ・デバフ対象能力 = 回避率
アビ汎用変数:効果割合 = 50
アビ汎用変数:持続ターン = 2
CALL アビテンプレート_不利効果_付随デバフ効果セット("詠唱")



RETURN RESULT

@固有アビ_2602_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 効果数値１
#DIM 効果数値２
#DIM 効果成功率
#DIM ロキシー隊列
#DIM クールタイム

ロキシー隊列 = キャラ隊列検索(GETCHARA(2602))
;レベルなどの条件でアビを強化する場合、アビ名の文字列を条件分岐で変化させる
IF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
	アビ名 = 土砦
	消費ＭＰ = 基礎BATTLE_STATE:キャラ番号:Lv  * 3
	効果数値１ = 20
ENDIF


SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>「詠唱」1ターン後 
		詳細文文字列受け渡し変数 += @"<br>味方単体に［レベル✕{効果数値１}」のバリア効果（4ターン）を与える。"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		戦闘中カウント:ロキシー隊列:10 = 2
		CALL 一ターン詠唱()

		
ENDSELECT



@固有アビ_2602_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM ロキシー隊列
#DIM クールタイム

ロキシー隊列 = キャラ隊列検索(GETCHARA(2602))

;レベルなどの条件でアビを強化する場合、アビ名の文字列を条件分岐で変化させる
IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
	アビ名 = 豪雷積層雲
	消費ＭＰ = 400
ELSE

ENDIF

IF INRANGE(ロキシー隊列, 0, 3) && 戦闘中カウント:ロキシー隊列:1
	クールタイム = MAX(0, 6 + 戦闘中カウント:ロキシー隊列:1 - 現在ターン数)
	SIF クールタイム > 0
		アビテンプレート用_アビ封印用フラグ = 1
ELSE
	クールタイム = 0
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ} 「詠唱」1ターン後 
		詳細文文字列受け渡し変数 += @"<br>敵と味方全体に「湿潤」状態を与える。/ 敵全体に［1］のスロウ効果を与える。"
		詳細文文字列受け渡し変数 += @"<br>ランダムな敵３体に［100％］に風属性ダメージを与える。"
		詳細文文字列受け渡し変数 += @"<br>ランダムな敵３体に［100％］に水属性ダメージを与える。"
		詳細文文字列受け渡し変数 += @"<br>ランダムな敵３体に［100％］に光属性ダメージを与える。"
		SIF クールタイム > 0
			詳細文文字列受け渡し変数 += @"（残り{クールタイム}ターン）"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		戦闘中カウント:ロキシー隊列:10 = 3
		CALL 一ターン詠唱()

		

		戦闘中カウント:ロキシー隊列:1 = 現在ターン数
ENDSELECT

@固有アビ_2602_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM ロキシー隊列
#DIM クールタイム1
#DIM 効果数値１
#DIM 効果数値２
#DIM 効果成功率

ロキシー隊列 = キャラ隊列検索(GETCHARA(2602))

IF INRANGE(ロキシー隊列, 0, 3) && 戦闘中カウント:ロキシー隊列:1
	クールタイム1 = MAX(0, 4 + 戦闘中カウント:ロキシー隊列:1 - 現在ターン数)
ELSE
	クールタイム1 = 0
ENDIF

;レベルなどの条件でアビを強化する場合、アビ名の文字列を条件分岐で変化させる
IF クールタイム1 > 0
	アビ名 = 雷光
	消費ＭＰ = BATTLE_STATE:戦闘行動キャラ:最大ＭＰ / 2
	効果数値１ = LIMIT(300, 消費ＭＰ, 1000) 
ELSE

ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>「詠唱」1ターン後 <br>敵単体に［{効果数値１}％］の光属性ダメージを与える。
		詳細文文字列受け渡し変数 += "<br>このアビリティは相手の防御力を50％無視する。"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		戦闘中カウント:ロキシー隊列:10 = 4
		CALL 一ターン詠唱()



ENDSELECT


;--------------------------------------------------
; 回合开始时处理 (回复/CD/动态Buff更新)
;--------------------------------------------------
@固有行動開始時処理_キャラ_2602

#DIM ロキシー隊列
#DIM キャラ番号

キャラ番号 = GETCHARA(2602)
ロキシー隊列 = キャラ隊列検索(キャラ番号)

IF バフ番号取得_枠("詠唱", ロキシー隊列) > -1 && ( バフ・デバフ効果検索("デバフ", "能力", "アビリティ封印", 戦闘行動キャラ) > -1 || バフ・デバフ効果検索("デバフ", "能力", "奥義封印", 戦闘行動キャラ) > -1 || バフ・デバフ効果検索("デバフ", "能力", "混乱", 戦闘行動キャラ) > -1  || バフ・デバフ効果検索("デバフ", "能力", "暗闇", 戦闘行動キャラ) > -1 )
	WSTR:(K++) = ロキシーの詠唱が中断された！
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_自己のみ
	アビ汎用変数:消去不可バフデバフ削除オプション = 1
	CALL アビテンプレート_不利効果_バフ消去("詠唱")
	戦闘中カウント:ロキシー隊列:10 = -1
ENDIF


IF バフ番号取得_枠("詠唱", ロキシー隊列) > -1 
	IF 戦闘中カウント:ロキシー隊列:10 == 10
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			アビテンプレート用_アビ名 = アブソリュート・ゼロ
		ELSE
			アビテンプレート用_アビ名 = フロストノヴァ
		ENDIF

		CALL アビ対象選択テンプレート_敵全体_生者のみ
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 30
		アビ汎用文字列:バフ・デバフ枠 = 湿潤
		アビ汎用変数:特殊表示オプション = 1
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_水		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_デバフ効果セット
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_火耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_火
		アビ汎用変数:効果割合 = 30
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_付随バフ効果セット("湿潤")
		アビ汎用変数:効果割合 = 50
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_風耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_風		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_付随デバフ効果セット("湿潤")

		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 氷結
		アビ汎用文字列:バフ・デバフ対象能力 = 氷結
		アビ汎用変数:効果量 = 50
		アビ汎用変数:累積上限_固定値 = 500
		アビ汎用変数:持続ターン = 5
		アビ汎用変数:消去不可オプション = 1
		CALL アビテンプレート_不利効果_累積デバフ効果セット
		CALL アビテンプレート_不利効果_累積デバフ効果セット

		CALL アビ対象選択テンプレート_敵全体_生者のみ
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 麻痺
		アビ汎用文字列:バフ・デバフ対象能力 = 麻痺
		アビ汎用変数:効果割合 = 80
		アビ汎用変数:持続ターン = 2
		アビ汎用変数:基礎成功確率 = 60
		CALL アビテンプレート_不利効果_デバフ効果セット

		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:ダメージ種類 = 奥義ダメージ
			CALL アビテンプレート_ダメージ処理_水属性
		ENDIF

	ELSEIF 戦闘中カウント:ロキシー隊列:10 == 1
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 35
			アビテンプレート用_アビ名 = 氷槍吹雪
		ELSE
			アビテンプレート用_アビ名 = 氷霜撃
		ENDIF

		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 35
			CALL アビ対象選択テンプレート_敵全体_生者のみ
		ELSE
			CALL アビ対象選択テンプレート_敵単体
		ENDIF
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 250
		CALL アビテンプレート_ダメージ処理_水属性

	ELSEIF 戦闘中カウント:ロキシー隊列:10 == 2
		アビテンプレート用_アビ名 = 土砦

		CALL アビ対象選択テンプレート_味方単体_生者のみ
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = バリア
		アビ汎用文字列:バフ・デバフ対象能力 = バリア
		アビ汎用変数:持続ターン = 4
		アビ汎用変数:効果量 = 基礎BATTLE_STATE:キャラ番号:Lv * 20
		CALL アビテンプレート_有利効果_バフ効果セット

	ELSEIF 戦闘中カウント:ロキシー隊列:10 == 3
		アビテンプレート用_アビ名 = 豪雷積層雲

		CALL アビ対象選択テンプレート_敵全体_生者のみ
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 30
		アビ汎用文字列:バフ・デバフ枠 = 湿潤
		アビ汎用変数:特殊表示オプション = 1
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_水		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_デバフ効果セット
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_火耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_火
		アビ汎用変数:効果割合 = 30
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_付随バフ効果セット("湿潤")
		アビ汎用変数:効果割合 = 50
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_風耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_風		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_付随デバフ効果セット("湿潤")
		

		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果量 = 1
		アビ汎用変数:基礎成功確率 = 100
		CALL アビテンプレート_不利効果_スロウ

		CALL アビ対象選択テンプレート_味方全体_生者のみ
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 30
		アビ汎用文字列:バフ・デバフ枠 = 湿潤
		アビ汎用変数:特殊表示オプション = 1
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_水		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_デバフ効果セット
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_火耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_火
		アビ汎用変数:効果割合 = 30
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_付随バフ効果セット("湿潤")
		アビ汎用変数:効果割合 = 50
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_風耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_風		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_付随デバフ効果セット("湿潤")
		
		CALL アビ対象選択テンプレート_敵ランダムＸ体_重複無し(3)
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 100
		CALL アビテンプレート_ダメージ処理_風属性
		CALL アビ対象選択テンプレート_敵ランダムＸ体_重複無し(3)
		CALL アビテンプレート_ダメージ処理_水属性
		CALL アビ対象選択テンプレート_敵ランダムＸ体_重複無し(3)
		CALL アビテンプレート_ダメージ処理_光属性
	ELSEIF 戦闘中カウント:ロキシー隊列:10 == 4
		アビテンプレート用_アビ名 = 雷光

		CALL アビ対象選択テンプレート_敵単体
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = LIMIT(300, BATTLE_STATE:戦闘行動キャラ:最大ＭＰ / 2, 850) 
		アビ汎用変数:防御無視オプション_割合 = 50
		CALL アビテンプレート_ダメージ処理_光属性
	ENDIF
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_自己のみ
	アビ汎用変数:消去不可バフデバフ削除オプション = 1
	CALL アビテンプレート_不利効果_バフ消去("詠唱")
	行動不能フラグ = 1
ENDIF
戦闘中カウント:ロキシー隊列:10 = -1


@バフ・デバフ特殊表示_湿潤(隊列番号, バフ・デバフ行数)
#DIM 隊列番号
#DIM バフ・デバフ行数
VARSET LOCAL
PRINTL 湿潤
HTML_PRINT "受けた火属性ダメージを30％減少、受けた風属性ダメージを50％増加、水属性ダメージを30％増加"
PRINTL

@固有ターン開始時処理_キャラ_2602
#DIM ロキシー隊列
#DIM キャラ番号

キャラ番号 = GETCHARA(2602)
ロキシー隊列 = キャラ隊列検索(キャラ番号)




@固有戦闘開始時処理_キャラ_2602

CALL アビ対象選択テンプレート_自己のみ
CALL アビ汎用変数文字列リセット
アビ汎用文字列:バフ・デバフ枠 = 水聖級魔術師
アビ汎用文字列:バフ・デバフ対象能力 = 属性与ダメージ_水
アビ汎用変数:効果割合 = 40
アビ汎用変数:持続ターン = -1
アビ汎用変数:消去不可オプション = 1
CALL アビテンプレート_有利効果_パッシブバフ効果セット
;--------------------------------------------------
;戦闘能力画面に表示されるキャラごとの固有処理説明
;--------------------------------------------------
;・使い方
;「XXXX」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;　口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;　基本的にWAIT系列は使わないことを推奨
;--------------------------------------------------
@口上_ステータス画面_固有特性解説_2602(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = □ 特性：『詠唱短縮』 □------------------------------------------------------------
KSTR:(K++) = 　通常よりも短い詠唱で魔術を発動する技術。
KSTR:(K++) = □ 特性：『水聖級魔術師』 □--------------------------------------------------------
KSTR:(K++) = 　水属性ダメージが40％上昇する




CALL 口上変数表示(対象キャラ, 1)




;--------------------------------------------------
;キャラの絶頂後、あなたの射精への反応など
;--------------------------------------------------

;--------------------------------------------------
;通常絶頂時
;--------------------------------------------------
@KOJO_ORGASM_通常絶頂_1040(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;NOWEX:対象キャラ:Ｃ絶頂, NOWEX:対象キャラ:Ｖ絶頂, NOWEX:対象キャラ:Ａ絶頂, NOWEX:対象キャラ:Ｂ絶頂, NOWEX:対象キャラ:Ｓ絶頂

CALL 口上変数初期化

相手キャラ番号 = 絶頂相手算出(対象キャラ)

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	IF RCVAR:PLAYER:絶頂の強度
		;同時絶頂時
		KSTR:(K++) = 「ぁ……っ_H_　だめ……あたしも、いく……から……っ_H_」
		KSTR:(K++) = 「いっしょ、に……っ_H_　出して……っ_H_」
		KSTR:(K++) = 六花はあなたの身体に縋りつき、震える声で同時に果てることを求めた。
	ELSE
		IF NOWEX:対象キャラ:Ｖ絶頂
			IF NOWEX:対象キャラ:Ｖ絶頂 == EXP:対象キャラ:Ｖ絶頂経験
				;初Ｖ絶頂
				KSTR:(K++) = 「あ……なにこれ……おなかの、中……_H_」
				KSTR:(K++) = 「ナカ……溶け、そう……っ_H_」
				KSTR:(K++) = 初めて知る子宮の奥からの快感に、六花は戸惑いながらも抗えずに絶頂した。
			ELSEIF NOWEX:対象キャラ:Ｖ絶頂 > 1
				;強絶頂以上
				STRDATA KSTR:(K++)
					DATA 「ひっ……ぁっ_H_　だめ、中……すご、すぎる……っ_H_」
					DATA 「あはっ_H_　いく……っ_H_　おまんこで、イッちゃうぅっ……_H_」
				ENDDATA
			ELSE
				;通常のV絶頂
				STRDATA KSTR:(K++)
					DATA 「ん……っ_H_　くる……_H_　あ、あぁっ_H_」
					DATA 「やっ……_H_　中、ぎゅうって、なる……っ_H_」
				ENDDATA
			ENDIF
		ELSE
			;その他の絶頂（V絶頂以外は一旦汎用で返す）
			STRDATA KSTR:(K++)
				DATA 「あ……っ_H_　ん、ぅ……っ_H_」
				DATA 「やっ……きもちい……_H_」
			ENDDATA
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------

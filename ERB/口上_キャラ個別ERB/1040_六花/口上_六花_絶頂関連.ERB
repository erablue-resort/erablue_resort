相手キャラ番号 = RFLAG:フィニッシュ相手番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	KSTR:(K++) = 
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;調教者の射精時
;--------------------------------------------------
@KOJO_ORGASM_被射精_1040(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;RFLAG:フィニッシュ場所
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	SELECTCASE RFLAG:フィニッシュ場所
		CASE 0
			;膣内
			IF 性癖素質:対象キャラ:膣内射精 == 3
				;膣内射精性癖が最高
				KSTR:(K++) = 「あ……っ_H_　中で……熱いの、出てる……っ_H_」
				KSTR:(K++) = 「出されるの、こんなに気持ちいいなんて……っ_H_」
			ELSEIF RCVAR:対象キャラ:被射精絶頂の強度
				;射精による快楽で絶頂した時
				KSTR:(K++) = 「ひゃっ_H_　あ……ぅ……っ_H_　中、どくどくして……_H_」
				KSTR:(K++) = 「精液、で……あたしまで……イッちゃ……ぅぅっ_H_」
			ELSEIF NOWEX:相手キャラ番号:射精 > 1
				;大量射精
				KSTR:(K++) = 「んっ……っ_H_　ちょ、どんだけ出てるの……っ_H_」
				KSTR:(K++) = 「おなか……熱くて……パンパンになっちゃう……っ_H_」
			ELSE
				;通常膣内射精
				KSTR:(K++) = 「ん……っ_H_　あ、熱い……っ_H_」
				KSTR:(K++) = 「……ちゃんと、中で出たね……。……うん、いいよ……_H_」
			ENDIF
		CASEELSE
			;膣内以外での射精（仮の汎用）
			IF NOWEX:相手キャラ番号:射精 > 1
				KSTR:(K++) = 「ひゃっ……_H_　すごい量……べたべたになっちゃったじゃん……」
			ELSE
				KSTR:(K++) = 「ん……出た……？　……びくびくしてる……」
			ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;●六花口上＠erablue_resort用
;　――ステータス画面／通常画面に表示される一言
;--------------------------------------------------
;好感度が上がっていく過程が最も可視化される場所。
;丁寧語→タメ口のスライドが地続きに読めるように書くこと
;--------------------------------------------------


;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
;一行のみの表示を想定。二行以上は基本的に禁止
;WAIT系列は使わないこと
;--------------------------------------------------
@口上_INFO画面_一言コメント_1040(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1040

;絶頂時
;エロ側の口上と合わせて書くべきなので、現状は未記述
;IF TCVAR:対象キャラ:前ターン絶頂
;	KSTR:(K++) =
;ENDIF
;SIF KSTR:0 != ""
;	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 現在仕事:対象キャラ:1 % 10000 && CFLAG:対象キャラ:現在マップ種別 == 現在仕事:対象キャラ:1 / 10000
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 2
			;ロビーで受付中
			KSTR:(K++) = 「いらっしゃませー。　……あ、噛んだ。今の見なかったことにして」
		CASE 503
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「あたし、コーヒーは得意だけどお酒はねー……まあ、レシピ通りには作れるよ」
		CASE 506
			;図書室で司書中
			KSTR:(K++) = 「本の整理、意外と落ち着くんだよね。　静かにしてってのだけ、よろしく」
		CASE 1503, 15
			;プールで監視員中
			KSTR:(K++) = 「はしゃぐのはいいけど、無理はしないでねー。　あたし、泳ぎはそんな得意じゃないから」
		CASE 10000 TO 10009
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 10000):0}(現在仕事:対象キャラ:1 - 10000)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「品出しと仕分けは任せて。　実家で散々やってたから、慣れたもんだよ」
				CASE "土産物屋"
					KSTR:(K++) = 「贈る相手のこと教えてくれたら、いくつか見繕うよ？　こういうの得意なんだ」
				CASE "食事処"
					KSTR:(K++) = 「今日のおすすめ？　あー、それなら食べた感じで言うと……こっちかな」
				CASE "装飾品店"
					KSTR:(K++) = 「似合うやつ選ぶの、任せてよ。　あたし、そういうセンスはちょっと自信あるんだよね」
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;状況で分岐
IF CFLAG:対象キャラ:飲み会
	;飲み会中
	KSTR:(K++) = 「あたし未成年だから、ジュースねジュース。　……えー、いいじゃん、ノリだけ参加させてよ」
ELSEIF CFLAG:対象キャラ:睡眠
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「ごめん……ちょっとだけ、休ませて……すぐ、戻るから……」
	ELSE
		KSTR:(K++) = 　スマホを握ったまま、六花は気持ちよさそうに寝息を立てていた。
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	IF CFLAG:対象キャラ:デート == MASTER + 100
		KSTR:(K++) = 「ふふ、今日は荷物持ちの日じゃないよね？　……ちゃんとエスコートしてよ？」
	ELSE
		KSTR:(K++) = 「まあ、付き合ってあげてもいいけどさ。　……あんまり期待はしないでよね」
	ENDIF
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	KSTR:(K++) = 「言っとくけど、あたし負けず嫌いだからね？　手加減しないよ」
ELSEIF CFLAG:対象キャラ:同行
	KSTR:(K++) = 「はいはい、ちゃんとついてってるよ。　……常識役として、見張っとくからさ」
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	KSTR:(K++) = 「……こそこそするの、ちょっとドキドキするね。　バレないようにね」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	KSTR:(K++) = 　六花はふと顔を上げ、あたりを見回したが、気のせいだと思ったのか、またスマホに目を落とした。
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「%CALLNAME:MASTER%とはさ、なんか気楽に喋れるんだよね。　悪くないよ、こういうの」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「あ、%CALLNAME:MASTER%さん。　……なんか用？　暇なら、話し相手になるけど」
			CASEELSE
				KSTR:(K++) = 「えっと……あたしに、何か？」
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「%CALLNAME:MASTER%が決めたことなら、あたしは付き合うよ。　……そういうの、もう慣れた」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「無茶しそうになったら、あたしが止めるからね。　常識役ってやつ？」
			CASEELSE
				KSTR:(K++) = 「……ちゃんと説明してくれたら、あたしも協力するんで」
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「……別に。　ただ、%CALLNAME:MASTER%のこと見てただけ。　悪い？」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「……ん、なんでもない。　また目、合っちゃっただけ」
			CASEELSE
				KSTR:(K++) = 「な、なに見てんの。　……こっちのセリフだし」
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「……あんまり、そういう目で見ないでよ。　……嫌じゃ、ないけどさ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「なに、その顔。　……もう、変なこと考えてるでしょ」
			CASEELSE
				KSTR:(K++) = 「……そういうの、まだ早いから。　あたし、そういうの慣れてないんで」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_1040(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1040

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「宝多六花です。　……まだ、ここのこと全然わかってないんですけど」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「あなたのこと、まだよく知らないからなあ。　悪い人じゃなさそう、とは思うけど」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CALLNAME:MASTER%さん、って感じの人だってのは、だいたいわかってきたかも」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「最近さ、仕事の話じゃない話も増えたよね。　……こういうの、嫌いじゃないよ」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「%CALLNAME:MASTER%の前だと、なんか素でいられるんだよね。　……内緒だけど」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「なんだかんだ、%CALLNAME:MASTER%といるのが一番落ち着くかも。　……言っちゃった」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_信頼
;--------------------------------------------------
@口上_ステータス画面_信頼コメント_1040(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1040

SELECTCASE CFLAG:対象キャラ:信頼度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「信用……は、これからでしょ。　まだ会ったばっかりだし」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「変なことしない人、ってのは、まあ、伝わってきてる。　今んとこはね」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CALLNAME:MASTER%さんって、意外と話が通じるんだよね。　ちょっと安心した」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;知己
		KSTR:(K++) = 「困ったことあったら、言ってよ。　あたしにできることなら、手伝うから」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;相棒
		KSTR:(K++) = 「%CALLNAME:MASTER%のことは、もう信じてるよ。　……こっちのことも、信じてよね」
	CASEELSE
		;水魚の交わり
		KSTR:(K++) = 「あたしが隣にいる限り、%CALLNAME:MASTER%に無茶はさせないから。　それだけは、任せて」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_恋心
;--------------------------------------------------
@口上_ステータス画面_恋心コメント_1040(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1040

SELECTCASE CFLAG:対象キャラ:恋心度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「え、そういうの？　……ないない。　まだ会ったばっかりでしょ」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「別に、なんとも思ってないから。　……ほんとだって」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CALLNAME:MASTER%さんのこと？　……普通だよ、普通。　深い意味はなし」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;好意
		KSTR:(K++) = 「最近さ、つい目で追っちゃうんだよね。　……く、癖だよ、癖！」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;恋心
		KSTR:(K++) = 「見てるだけで満足、なんて……嘘だな。　もっと、こっち見てほしいって思っちゃう」
	CASEELSE
		;愛情
		KSTR:(K++) = 「……好きだよ。　って、あたしに何回言わせる気なの。%TEXTR("　もう、ばか/　……元の世界の子には、内緒だからね？　……って、あたし今けっこう最低なこと言った！？")%」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_性愛
;--------------------------------------------------
@口上_ステータス画面_性愛コメント_1040(対象キャラ)
#DIM 対象キャラ
CALL 口上開始_1040

SELECTCASE CFLAG:対象キャラ:性愛度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「は？　そういうのは、まだ全然。　急がないでよね」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「露骨なのは苦手なの。　……そういうの、ゆっくりでいいでしょ」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「な、なんかいやらしい目してない？　……気のせい？　だといいけど」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;意識
		KSTR:(K++) = 「……あんまり、見つめないでよ。　調子、狂うから」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;情欲
		KSTR:(K++) = 「……もう。　そういう雰囲気にするの、ずるいってば」
	CASEELSE
		;耽溺
		KSTR:(K++) = 「……%CALLNAME:MASTER%になら、いいよ。　……あたしの、こういうとこも、全部」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)

			ELSE
				KSTR:(K++) = 「……っ_H_　なんで、こんな……_H_」
				WSTR:(K++) = %CALLNAME:対象キャラ%は自分の身体の反応に戸惑いながら、恐る恐る触れている……
			ENDIF
		ENDIF
	CASE 4
		;温泉施設の覗き用場所で
		SELECTCASE CFLAG:対象キャラ:現在位置
			CASE 702, 802
				; 服を脱いでいる様子が見える…
				WSTR:(K++) = %CALLNAME:対象キャラ%が無防備に衣服を脱いでいるのが見える……

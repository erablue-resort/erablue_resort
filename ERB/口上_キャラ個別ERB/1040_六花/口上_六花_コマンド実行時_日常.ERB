;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「1040」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
	;-2の場合は会話出来なかった扱いなので何も言わないのがいいかも
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_1040_300(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「えっと……その話、さっきも聞いたような。　あー、いや、なんでもないです」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「んー……ネタ切れ？　まあいいじゃん、無理に喋らなくてもさ」
			CASEELSE
				KSTR:(K++) = 「もう、そんな話題探さなくていいって。　……別に、一緒にいるだけでいいんだから。　……あ、今の無し」
		ENDSELECT
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「えっと……ごめんなさい、なんて言えばいいか。　まだあんまり、あなたのこと知らないので」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「あー……うん、ごめん。　今の話、あたしにはちょっと難しかったかも」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「え、なになに？　ごめん、聞いてなかった。　……じゃなくて、聞き取れなかった！」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「ごめん、ちょっとぼーっとしてた。　……なんでもないってば。　考え事」
			CASEELSE
				KSTR:(K++) = 「……え、なに。　なんであたしの顔じっと見てんの。　やめてよ、調子狂うから」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「宝多六花です。　家、喫茶店付きのリサイクルショップやってて。　コーヒーくらいなら淹れられますよ」
					CASE 1
						KSTR:(K++) = 「ここにも学校ってあるんだ……別の世界なのに同じものがあるの、なんか不思議」
					CASE 2
						KSTR:(K++) = 「えっと……あたしに何か用でした？　あ、話し相手ならいいですけど」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「男の人って、そういう話好きですよね。　あたしは全然、興味ないんだけど……ふふっ」
					CASE 1
						KSTR:(K++) = 「そういえば、なみことはっす見ました？　もう……散策するって言って、どっか行っちゃって」
					CASE 2
						KSTR:(K++) = 「へー、そうなんですか。　……あ、すいません。ちゃんと聞いてます。　リアクション薄いだけ」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「あはは、それやばくない？　うわー、あたし明日から気になっちゃうじゃん、それ」
					CASE 1
						KSTR:(K++) = 「%CALLNAME:MASTER%ってさ、意外と話しやすいよね。　……ほめてるんだよ、これ」
					CASE 2
						KSTR:(K++) = 「んー、まあ、そういう日もあるよね。　気にしすぎないほうがいいって、そういうの」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「なんかさ、こうやって普通に喋ってられるの、いいよね。　あたし、こういうの結構好き」
					CASE 1
						KSTR:(K++) = 「%CALLNAME:MASTER%、ちゃんと寝てる？　……別に心配とかじゃないけど。　顔色、ちょっとね」
					CASE 2
						KSTR:(K++) = 「ん、聞いてる聞いてる。　……あのさ、あたしの話も、たまには聞いてくれる？」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「……なんか、%CALLNAME:MASTER%と喋ってると時間忘れちゃうんだよね。　困ったもんだよ、ほんと」
					CASE 1
						KSTR:(K++) = 「あのさ。　こうやって隣にいるの、すっかり当たり前になってて。　……ずるいよね、それって」
					CASE 2
						KSTR:(K++) = 「別に用はないよ。　ただ、%CALLNAME:MASTER%の声、聞きたかっただけ。　……なに笑ってんの」
				ENDSELECT
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「へえ、%CALLNAME:MASTER%さんって、そういうこと考える人なんだ。　……ちょっと見直したかも」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「あはは、なにそれ！　……ああもう、笑わせないでよ。　お腹痛い」
			CASEELSE
				KSTR:(K++) = 「……もう。　そういうこと言うの、ほんとずるい」
				KSTR:(K++) = 「顔に出ちゃうでしょ、あたし。　……わかってて言ってるよね、絶対」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM301_お茶を淹れる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;その場にいる全員が対象だが、口上は対面している相手のみ

@KOJO_COM_1040_301(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「……あ、いただきます。　えっと……お湯、ちょっと熱すぎたかも。　次は少し冷ましてからのほうが」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「んー、惜しい！　次はあたしが淹れたげるよ。　実家仕込みだから、味は保証する」
			CASEELSE
				KSTR:(K++) = 「……うん、おいしい」
				KSTR:(K++) = 　嘘だとバレバレだったが、六花は最後まで飲み干した。
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「あ、どうも……いただきます。　……へえ、意外とちゃんとしてる」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「ありがとうございます。　……あたし実家喫茶店だから、つい味チェックしちゃうんですよね。　うん、悪くない」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「わ、ありがと。　なんかこういうの、逆で慣れないな。　いつも淹れる側だから、あたし」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「……ありがと。　人に淹れてもらうお茶って、こんなあったかいんだ。　なんか、へへ」
			CASEELSE
				KSTR:(K++) = 「ありがと。　……今度はあたしがコーヒー淹れたげる。　%CALLNAME:MASTER%好みの、覚えてるから」
		ENDSELECT
	CASEELSE
		;大成功
		KSTR:(K++) = 「――え、うま。　なにこれ、ちゃんとしてる」
		KSTR:(K++) = 「これだけ気合い入れて淹れてくれたの、飲めばわかるよ。　……ありがと、ね」
		SIF 関係レベル >= 関係閾値:3
			KSTR:(K++) = 「実家の看板娘として、ちょっと悔しいけど……負けたかも」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM302_スキンシップ
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功

@KOJO_COM_1040_302(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「ちょ、離れてください。　そういうの、生理的に無理なんで」
							KSTR:(K++) = 　六花は弾かれたように半歩引いて、はっきりと嫌悪の色を浮かべた。
						CASE 1
							KSTR:(K++) = 「……は？　触らないで。　無理無理、マジで無理なんで、そういうの」
							KSTR:(K++) = 　声から温度が消えていた。取りつく島もない。
					ENDSELECT
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「うわ、なになに。　急に距離詰めてこないでよ、びっくりするから」
			CASEELSE
				KSTR:(K++) = 「もー、いきなりはずるいって。　……せめて、心の準備させてよ」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
					KSTR:(K++) = 「……やめてください。　まだ会ったばっかりの人に触られるの、普通に無理なんで」
					KSTR:(K++) = 　露骨に距離を取られた。半笑いもない、心からの拒絶だった。
			CASE IS < 関係閾値:2
					KSTR:(K++) = 「……あの、まだそういうのは。　悪いけど、気安く触らないでもらえます？」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「はいはい。　……別に、%CALLNAME:MASTER%になら、これくらいいいけどさ」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「ん……。　冷たい手だね、%CALLNAME:MASTER%。　……ちょっとだけ、あっためたげる」
			CASEELSE
				KSTR:(K++) = 「……いいよ、別に。　%CALLNAME:MASTER%になら、好きにさせたげる。　……ちょっとだけ、だからね」
					SIF RAND:2 == 0
						KSTR:(K++) = 「……ってあたし、こんな簡単に触らせて大丈夫なの？　元の世界だったら即ビンタもんだよ、これ……あー、もう。あたし、なんか色々ゆるくなってきてない？」
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「……触り方、丁寧ですね。　そういうとこは、まあ、嫌いじゃないかも」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「うわ、びっくりした……。　今の、なし。　あたしがドキッとしたの、なかったことにして」
			CASEELSE
				KSTR:(K++) = 「……心臓の音、聞こえてたりしないよね？」
				KSTR:(K++) = 「%TEXTR("う、うるさいな、あたしのだよ/……聞こえてても、言わないでよ")%」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM303_口説く
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_1040_303(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
		KSTR:(K++) = 「はいはい、もういいって。　同じ手、何回目だと思ってんの。　……効かないから」
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「……えっ、急に何なんですか。　ごめん、そういうの本気で無理なんで。　やめてもらえます？」
						CASE 1
							KSTR:(K++) = 「うわ……。　その手の話、あたしに振らないでください。　普通に鳥肌立ったんですけど」
					ENDSELECT
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「いやいやいや、ないない。　なんなの急に、キャラじゃないでしょ？　やめてよもう、半笑いになるから」
			CASEELSE
				KSTR:(K++) = 「もー……。　そういうの、不意打ちでやめてってば。　……ずるいんだよ、%CALLNAME:MASTER%は」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
					KSTR:(K++) = 「……あの、真面目に言いますね。　まだよく知らない人にそういうこと言われても、引くだけなんで」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「うわー、出た。　そういうこと言う人だと思わなかったな……ちょっとがっかり。　半分冗談だけど」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「え、なに、口説いてる？　……あはは、冗談きついって。　顔、赤くないし。赤くないからね？」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「……もう、そういうの反則。　ちゃんと、こっちの心臓の都合も考えてよね」
			CASEELSE
				KSTR:(K++) = 「……知ってるよ、そういうの。　わかってるから、何回も言わなくていいの。　……でも、もう一回だけなら」
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「……っ。　な、なに真顔で言ってんの。　ずるいですよ、そういうの」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「もー！　だから不意打ちやめてってば！　……心臓に悪いんだって、ほんとに」
			CASEELSE
				KSTR:(K++) = 「……ほんと、ずるい人。　あたしが選ばれたいって思ってるの、バレバレじゃん」
				KSTR:(K++) = 「……ちゃんと、選んでよね。　あたしのこと」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM304_知識を教わる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;RFLAG:コマンド結果受渡し変数２=教えてもらう知識種類
	;1,調合知識  2,魔法知識  3,機械知識  4,錬金知識  5,魔物知識  6,絵師  7,高貴  8,釣り好き  9,踊り子  10,歌唱技能
	;11,料理人  12,歴史知識  13,経営知識  14,水泳技能  15,農業知識
;知識素質:(RFLAG:コマンド結果受渡し変数２)でキャラの知識のLv値が得られる
	;教えられるのは「そのキャラが持っている知識素質が、あなたよりLvが高い時のみ」なので、持っていない知識に関して記述する必要はない

@KOJO_COM_1040_304(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数２
	CASE 11
		;料理人
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE -1
				;失敗
				KSTR:(K++) = 「あー、そこ火強すぎ。　焦げるって。　……もう、貸してみ？」
			CASE 0
				;通常成功
				KSTR:(K++) = 「実家がお店だからさ、簡単なやつなら教えられるよ。　まず、味見はこまめに。　これ基本ね」
				KSTR:(K++) = 「あとコーヒーは……豆を蒸らす時間が命だから。　そこだけは、ちゃんと」
			CASEELSE
				;大成功
				KSTR:(K++) = 「お、いいじゃん。　筋いいね、%CALLNAME:MASTER%。　……この調子なら、お店手伝ってもらえるかも」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM313_ハグする
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功

@KOJO_COM_1040_313(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「……は？　離して。　急に抱きつくとか、正直ドン引きなんですけど」
							KSTR:(K++) = 　六花は一瞬固まったあと、両手ではっきりと押しのけた。
						CASE 1
							KSTR:(K++) = 「ちょっ……無理無理無理！　知らない人にくっつかれるの、鳥肌立つんで！　離れて！」
					ENDSELECT
			CASEELSE
				KSTR:(K++) = 「もー、不意打ちはなしって言ったじゃん。　……心臓、止まるかと思った」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
				CASE IS < 関係閾値:1
					KSTR:(K++) = 「……っ、離して。　そういう絡み方、無理」
					KSTR:(K++) = 　やんわりと、しかしはっきりと引き剥がされた。
				CASE IS < 関係閾値:2
					KSTR:(K++) = 「……えっと。　まあ、これくらいなら。　あんまり、長くはなしね？」
					KSTR:(K++) = 　抗いはしなかったが、背中はどこか硬いままだった。
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「ん……。　なに、疲れてんの？　……しょうがないな。　ちょっとだけだよ」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「……はいはい。　どうしたの、甘えん坊さんだなあ、今日は」
				KSTR:(K++) = 　そう言いながら、六花の手は背中をとんとんと叩いていた。
			CASEELSE
				KSTR:(K++) = 「……おかえり。　まだどこも行ってないのにね、こういうの言いたくなるの、変かな」
		ENDSELECT
	CASEELSE
		;大成功

@KOJO_COM_1040_405(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		;誰も隠密してない
		WSTR:(K++) = %CALLNAME:対象キャラ%はスマホをいじっている。時折、ふっと小さく笑ったり、「うわ、まじか」と独り言を漏らしたりしている。
	CASE 1
		;誰かが隠密している
		WSTR:(K++) = %CALLNAME:対象キャラ%はスマホを眺めつつ、たまに周囲をきょろきょろ見回している。何かの気配を感じたのだろうか。
	CASE 10
		;起床までの残り時間
		;寝言とか言う感じかな？
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS > 180
				;3時間以上
				WSTR:(K++) = %CALLNAME:対象キャラ%はぐっすりと眠っている。寝顔は普段の気だるげな表情が抜けて、あどけなかった。
			CASE IS > 90
				;3時間以下
				WSTR:(K++) = %CALLNAME:対象キャラ%は寝返りを打った。「……ん、アカネ……勝手に食べないで……」と寝言が聞こえる。
			CASE IS > 30
				;90分以下
				WSTR:(K++) = %CALLNAME:対象キャラ%の眠りが浅くなってきたようだ。布団の中でもぞもぞと身じろぎしている。
			CASEELSE
				;30分以下
				WSTR:(K++) = %CALLNAME:対象キャラ%はそろそろ目を覚ましそうだ。薄く開いた目が、一瞬こちらを捉えた気がした。
		ENDSELECT
	CASE 11
		;睡眠＋ダウン、スコアの多さで分岐
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS >= 400
				;めちゃくちゃにされてる
				WSTR:(K++) = %CALLNAME:対象キャラ%は完全に意識を失っており、身体の至るところに昨晩の痕跡が残っている……
			CASE IS >= 20
				;結構がっつり
				WSTR:(K++) = %CALLNAME:対象キャラ%は疲れ果てた様子で眠っている。肌に残る赤みがやけに生々しい……
			CASEELSE
				;体力付きたけど割と穏やか、あんまり来ないかも
				WSTR:(K++) = %CALLNAME:対象キャラ%は静かに眠っている。穏やかな寝息が聞こえる。
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM414 写真を撮る
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数３ 写真のシチュエーション
@KOJO_COM_1040_414(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE 1
		;寝てる、相手は気づいてない
		WSTR:(K++) = %CALLNAME:対象キャラ%の寝顔を撮った。起きている時のクール顔とは全然違う、あどけない表情だった。
	CASE 2
		;ハメ撮り、相手は気づいている
		IF TCVAR:対象キャラ:前ターン絶頂
			;絶頂直後
			KSTR:(K++) = 「っ……や、やめ……撮るなって……_H_　こんなの、誰かに見られたら……」
			WSTR:(K++) = 　絶頂直後の%CALLNAME:対象キャラ%の蕩けた表情がレンズに収められた。
		ELSE
			KSTR:(K++) = 「ちょ……っ、撮ってんの！？　消して！　消してって！！」
			WSTR:(K++) = %CALLNAME:対象キャラ%は慌てて顔を隠すが、間に合わなかった……
		ENDIF
	CASE 3
		;覗き、相手は気づいてない
		;覗きの口上に飛ばしていいんじゃね？　と思うので飛ばす
		TRYCALLFORM KOJO_COM_{NO:対象キャラ}_404(対象キャラ)
		RETURN 0
	CASE 4
		;仕事中、相手は気づいている
		SELECTCASE 現在仕事:対象キャラ:0
			CASE 1
				;雑務
				KSTR:(K++) = 「え、あたし撮ってたの？　……別にいいけど、もうちょっとマシな時に撮ってよ」
			CASE 2
				;常駐業務
				;今仕事場にいるかで分岐
				KSTR:(K++) = 「あ、お仕事中です。　撮るのはいいけど……変な加工しないでくださいね？」
			CASE 3
				;秘書
				KSTR:(K++) = 「写真？　……まあ、仕事頑張ってる証拠ってことで。　いいですよ」
			CASEELSE
				KSTR:(K++) = 「え、今？　……ま、いっか。　はい、パシャ」
		ENDSELECT
	CASE 5
		;日常のスナップショット、相手は気づいている
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「あ、撮った？　見せて見せて。　……うわ、あたしこんな顔してんの。　消して」
			CASE 1
				KSTR:(K++) = 「ちょっと、急に撮るのやめてよ。　……せめて構える時間くらいちょうだい」
			CASE 2
				KSTR:(K++) = 「ん、いいよー。　はい、チーズ。　……って古っ、あたし何言ってんだ」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM600 探索に誘う
;--------------------------------------------------
@KOJO_COM_1040_600(対象キャラ)
#DIM 対象キャラ
;探索PTに誘った時の反応
;好感度レベル11以上必須、足りないと断られる
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		;成功
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「探索？　うん、いいよ。　%CALLNAME:MASTER%と一緒なら……ま、楽しいし」
			KSTR:(K++) = 「あたしは戦えないけど、常識役として支えるから。　任せて」
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「探索ですか？　分かりました。　お手伝いくらいなら」
				CASE 1
					KSTR:(K++) = 「ん、了解。　あたしでよければ付き合います」
			ENDSELECT
		ENDIF
	CASE -1
		KSTR:(K++) = 「あー……ごめん。　今日はちょっとパス。　体調がイマイチで」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

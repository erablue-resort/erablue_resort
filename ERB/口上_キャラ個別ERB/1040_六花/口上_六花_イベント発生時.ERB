;****************************************
;ターン開始時や一日開始時・終了時に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「1040」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_1040(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化
;挨拶の時間・内容は地の文では言及されないので適宜変更してもOK

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE TIME
	;朝　5時～11時
	CASE 5*60 TO 11*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「あ、おはようございます。　意外と朝、早いんですね」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「おはようございます。　朝ごはん、ちゃんと食べました？　……あ、いや、別に気にしてるわけじゃ」
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはよ。　うわ、まだ眠そうな顔してるじゃん。　だいじょぶ？」
					CASE 1
						KSTR:(K++) = 「あ、おはよー。　今日もいい天気だね。　こういう朝、あたし結構好きかも」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはよ、%CALLNAME:MASTER%。　ちゃんと寝れた？　……無理しすぎないでよね」
					CASE 1
						KSTR:(K++) = 「おはよー。　なんか、こうやって朝に会うの、すっかり慣れちゃったな」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「……おはよ。　ん、なんでもない。　ちょっと、寝顔見てただけ。　……言わせないでよ、もう」
					CASE 1
						KSTR:(K++) = 「おはよ、%CALLNAME:MASTER%。　朝いちばんにキミの顔って、悪くないな……って、聞かなかったことにして！」
				ENDSELECT
		ENDSELECT
	CASE 11*60 TO 18*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「あ、どうも。　……えっと、あたしに何か用でした？」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「お疲れさまです。　根詰めすぎるのも、よくないと思いますよ。　一般論として、ですけど」
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あ、%CALLNAME:MASTER%。　なんか、あたしのこと探してた？」
					CASE 1
						KSTR:(K++) = 「うぃーす。　ちょうど暇してたとこ。　……って、暇そうに見えた？　やば」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CALLNAME:MASTER%、ちょっと休憩したら？　あたしがコーヒー淹れたげるからさ」
					CASE 1
						KSTR:(K++) = 「あ、いいとこ来た。　……ううん、用があるわけじゃないんだけど。　なんとなく」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CALLNAME:MASTER%。　……別に。ただ、顔見たくなっただけ。　悪い？」
					CASE 1
						KSTR:(K++) = 「あのさ。　こうやって隣にいるの、当たり前になってきてるの、ちょっとずるいよね。　……あ、今の忘れて」
				ENDSELECT
		ENDSELECT
	CASEELSE
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「あ、こんばんは。　……もうこんな時間か。　一日、早いなあ」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「こんばんは。　あんまり夜更かしすると、明日に響きますよ？　……あたしが言えた義理じゃないけど」
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あ、まだ起きてたんだ。　奇遇じゃん。　あたしもなんか、寝そびれちゃって」
					CASE 1
						KSTR:(K++) = 「こんばんは。　夜って、なんか落ち着くよね。　静かで」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CALLNAME:MASTER%、まだ仕事？　ほどほどにしなよ。　……心配、するでしょ」
					CASE 1
						KSTR:(K++) = 「こんばんは。　夜風、気持ちいいね。　……こういう普通の夜が、いちばん大事なんだよ。あたしは、そう思う」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「……こんな時間に会うと、なんか、変にドキドキするからやめてほしい。　……って、あたしが呼んだんだけどさ」
					CASE 1
						KSTR:(K++) = 「おやすみ……って言う前に、%CALLNAME:MASTER%の顔だけ見に来た。　うん、それだけ。　それだけだから」
					CASE 2
						KSTR:(K++) = 「……ねえ、あたしさ、元の世界だと結構いい感じの子いたはずなんだよね。　なのに、なんで%CALLNAME:MASTER%におやすみ言いに来てんの……うわ、あたしヤバくない！？」
				ENDSELECT
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;恋慕自覚時
;（告白成功条件が整っている、かつ恋慕陥落をまだしていない時）
;--------------------------------------------------
@KOJO_EVENT_恋慕自覚_1040(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = 　六花はスマホをいじる手を止めて、しばらく画面の一点を見つめていた。
WSTR:(K++) = 「……あれ。　なんか、あたし」
KSTR:(K++) = 「さっきから%CALLNAME:MASTER%のこと、目で追ってるな……って」
WSTR:(K++) = 　言いかけて、はっと顔を上げた。
KSTR:(K++) = 「い、いやいやいや。　違う違う、そういうんじゃなくて！」
WSTR:(K++) = 「……えっ、ちょっと待って。　あたし、元の世界にさ……その、いい感じの子、いなかったっけ……？」
KSTR:(K++) = 　自分で言って、自分で頭を抱えた。
WSTR:(K++) = 「うわぁー……なにやってんの、あたし。　ちょっと優しくされたくらいで、ころっといくとか……軽っ！　軽すぎでしょ！」
KSTR:(K++) = 　――そこまで言っておいて。
WSTR:(K++) = 　六花はもう一度、ちらりと%CALLNAME:MASTER%を見てしまう。
KSTR:(K++) = 「……はぁ。　……いや、うん。　なんでもない。　今の全部、忘れて。　マジで、忘れてってば！」

CALL 口上変数表示(対象キャラ, 0)



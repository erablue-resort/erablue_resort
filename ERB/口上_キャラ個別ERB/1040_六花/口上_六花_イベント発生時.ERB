;--------------------------------------------------
;この口上はTARGETでなくとも、すごろく参加者なら全員表示される

@KOJO_EVENT_すごろく_1040(対象キャラ, 表示モード, 分岐変数)
#DIM 対象キャラ
#DIMS 表示モード
#DIM 分岐変数
CALL 口上変数初期化

SELECTCASE 表示モード
	CASE "手番_ダイスロール"
		;分岐変数にはターン数が入る。分岐変数 == 1でゲームスタート直後の開幕ターン
		IF 分岐変数 == 1
			KSTR:(K++) = 「すごろくかあ。　よーし、やるからには勝ちにいくよ。　えいっ」
		ELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「あたしのターン。　……いけっ」
				CASE 1
					KSTR:(K++) = 「でかい目出ろ……えいっ」
				CASE 2
					KSTR:(K++) = 「はい、あたしね。　よいしょっと」
			ENDSELECT
		ENDIF
	CASE "手番_一回休み"
		;分岐変数には何も入らない
		KSTR:(K++) = 「えー、休み？　……はぁ、ついてないなあ」
	CASE "ゴール！"
		;分岐変数にはターン数が入る
		;誰かがゴールした時点で終了するので、一位のキャラの口上しか表示されない
		KSTR:(K++) = 「やったぁ！　一着！　……ふふん、どうだ」
	CASE "全体イベント"
		;全員進むか全員戻るのイベント、分岐変数に移動量が入る
		IF 分岐変数 > 0
			;全員進む時
			KSTR:(K++) = 「お、全員進むやつだ。　ラッキー♪」
		ELSEIF 分岐変数 < 0
			;全員戻る時
			KSTR:(K++) = 「えぇー、全員戻るの！？　うそでしょ……」
		ENDIF
	CASE "罰ゲームイベント"
		;分岐変数には罰ゲーム種類が入る
		;RFLAG:コマンド結果受渡し変数２には、相手が必要な罰ゲームの場合には相手のキャラ番号が入る
		SELECTCASE 分岐変数
			CASE 0
				;不思議な力で衣装がバニーに
				KSTR:(K++) = 「えっ……バニー！？　は、はぁ！？　なんでバニーなの！？」
				KSTR:(K++) = 「……うわ、ほんとに変わった。　やだ、恥ずかしい……見ないで」
			CASE 1
				;一発芸を披露する
				KSTR:(K++) = 「い、一発芸……？　あたしそういうの無理だって！　……え、やらなきゃダメ？」
				KSTR:(K++) = 「……じゃ、じゃあ……。　……ごめん、何も思いつかない。　パスで」
			CASE 2
				;不思議な力で衣装がメイド服に
				KSTR:(K++) = 「め、メイド服……？　こんなひらひらしたの着たことないんだけど……」
				KSTR:(K++) = 「……似合ってる？　……そ、そう。　……別に嬉しくないし」
			CASE 3
				;次のターンまで誰かを膝枕したままプレイする_する側
				KSTR:(K++) = 「膝枕？　……まあ、それくらいなら。　ほら、頭乗せなよ」
				KSTR:(K++) = 「……え、『柔らかい』？　……言うなっ、感想とか求めてないから！」
			CASE 4
				;誰かから思いっきりくすぐられる_される側
				KSTR:(K++) = 「くすぐ……っ、ひゃっ、やめ、あはは！　やめてってば！」
				KSTR:(K++) = 「っ、あはははは！　もう無理、降参！　降参だって！！」
			CASE 5
				;誰かを思い切りハグする_する側
				KSTR:(K++) = 「ハグ？　……罰ゲームだからね？　罰ゲーム。　……いくよ」
				WSTR:(K++) = 　六花はぎゅっと%CALLNAME:MASTER%を抱きしめた。心臓の音がやたらと大きく聞こえる。
				KSTR:(K++) = 「……もういい？　もういいでしょ。　離すよ。　……はい、おわり」
		ENDSELECT
	CASE "罰ゲームイベント_反応"
		;分岐変数には罰ゲーム種類が入る
		;相手が必要な罰ゲームイベントの、相手側になった時の口上。罰ゲーム側のキャラ番号は「参加者:行動手番」で引っ張ってこれる
		SELECTCASE 分岐変数
			CASE 3
				;次のターンまで誰かを膝枕したままプレイする_される側
				KSTR:(K++) = 「え、あたしが頭乗せるの？　……うわ、なんか照れる」
			CASE 4
				;誰かから思いっきりくすぐられる_する側
				KSTR:(K++) = 「えー、あたしがくすぐるの？　……しょうがないなあ。　ほら、覚悟しなよ」
			CASE 5
				;誰かを思い切りハグする_される側
				KSTR:(K++) = 「えっ……ハグ、される側？　……あ、うん。　……どうぞ」
		ENDSELECT
	CASE "有利イベント"
		;分岐変数にはイベント種類が入る
		SELECTCASE 分岐変数
			CASE 0
				;もう一度ダイスを振って進む
				KSTR:(K++) = 「もう一回振れるの？　ラッキー！」
			CASEELSE
				KSTR:(K++) = 「おっ、進める！　いい調子じゃん」
		ENDSELECT
	CASE "不利イベント"
		;分岐変数にはイベント種類が入る
		SELECTCASE 分岐変数
			CASE 0
				;一回休みに
				KSTR:(K++) = 「一回休み……マジかぁ。　ついてない」
			CASEELSE
				KSTR:(K++) = 「えぇー、戻るの？　最悪なんだけど……」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)
IF 表示モード == "全体イベント"
	;移動処理が挟まりながら口上が出てくるため、スキップで見逃さないようにFORCEWAITを挟む
	FORCEWAIT
ENDIF



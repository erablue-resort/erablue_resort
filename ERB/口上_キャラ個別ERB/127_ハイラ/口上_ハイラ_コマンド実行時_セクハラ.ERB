;****************************************
;コマンド実行後に表示される文章（セクハラ）
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・関係性の分岐はテンプレートに合わせ、恋慕側（ハイラ_恋慕側判定_127）は快Ｓの段階、セフレは一括、その他は反応（RFLAG）で分ける
;・背中（逆鱗）：段階 3（恋慕側・セフレ）は鱗を見せ、触れるのも許す。宝の相手に触れられた時だけ力が静まる（原作にない設定）
;　その他は、手が鱗（髪の下）に届く前に止める。天候の描写は入れない
;・角：段階 3 は「丁寧に扱え」と言いつつ許す。その他はとがめる
;****************************************

;--------------------------------------------------
;COM306_背中に触れる
;--------------------------------------------------
@KOJO_COM_127_306_1(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｓ

;RFLAG:コマンド結果受渡し変数
	;1:拒絶  2:受け入れ  3:喜び

CALL 口上変数初期化

IF ハイラ_恋慕側判定_127(対象キャラ)
	SELECTCASE CUP:対象キャラ:快Ｓ
		CASE IS > 10000
			;即絶頂
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ん、ぁ……っ_H_　背を、そのように……っ_H_　妾の鱗まで……っ_H_　ぁぁっ_H__H__H_」
				CASE 1
					KSTR:(K++) = 「汝に触れられると……っ_H_　力は静まるのに……っ_H_　身体の奥が……っ_H__H__H_」
				CASE 2
					KSTR:(K++) = 「%CALLNAME:MASTER%……っ_H_　誰にも触れさせなかった所を……っ_H_　ぁ……ぁぁっ_H__H__H_」
			ENDSELECT
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 逆鱗を撫でられているというのに、%CALLNAME:対象キャラ%はただ%CALLNAME:MASTER%の手の下で甘く震えて果てた……_H_
				CASE 1
					KSTR:(K++) = 背を%CALLNAME:MASTER%に預けきったまま、%CALLNAME:対象キャラ%は小さく背を反らせて達した……_H_
			ENDSELECT
		CASE IS > 6000
			;かなり感じている
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「はぁ……_H_　背中を撫でられるだけで……っ_H_　こんなに……_H_」
				CASE 1
					KSTR:(K++) = 「ん、ぁ……っ_H_　鱗の縁を、なぞるな……っ_H_　妙な心地に……っ_H_」
				CASE 2
					KSTR:(K++) = 「汝にだけは……っ_H_　妾の弱いところを、全部……許す……_H_」
			ENDSELECT
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 鱗の上を指先が滑るたび、%CALLNAME:対象キャラ%の肩が小さく跳ねている……
				CASE 1
					KSTR:(K++) = %CALLNAME:対象キャラ%は髪をかきあげたまま、背中を%CALLNAME:MASTER%に差し出すようにじっとしている……
			ENDSELECT
		CASE IS > 3000
			;人並みに感じている
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ん……_H_　そこに触れられると、妙に落ち着く……_H_」
				CASE 1
					KSTR:(K++) = 「汝の手は温かいな……_H_　鱗の奥まで、静まっていく……_H_」
				CASE 2
					KSTR:(K++) = 「……誰にも触れさせなかった所だ。大事に扱え……_H_」
			ENDSELECT
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = %CALLNAME:対象キャラ%は安心しきったように目を閉じ、背中を撫でる手に身を任せている……
				CASE 1
					KSTR:(K++) = 青緑色の鱗に触れる%CALLNAME:MASTER%の手を、%CALLNAME:対象キャラ%は振り払おうともしない……
			ENDSELECT
		CASEELSE
			;まだ快楽に慣れていない
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「……汝にだけは見せてやる。見るだけだぞ。……いや、汝ならば、そっと触れるくらいは……」
				CASE 1
					KSTR:(K++) = 「背の鱗か。……案ずるな、汝の手ならば、妾の力は暴れん」
				CASE 2
					KSTR:(K++) = 「ふふ……不思議なものだ。他の誰が触れても荒れ狂う力が、汝の手の下では凪いでおる」
			ENDSELECT
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = %CALLNAME:対象キャラ%はそっと髪をかきあげ、宝石をはめ込んだような背の鱗を%CALLNAME:MASTER%に見せた……
				CASE 1
					KSTR:(K++) = 背に触れる手が%CALLNAME:MASTER%のものだと分かると、%CALLNAME:対象キャラ%の肩からふっと力が抜けた……
			ENDSELECT
	ENDSELECT
ELSEIF TALENT:対象キャラ:セフレ
	SELECTCASE RAND:4
		CASE 0
			KSTR:(K++) = 「ほう、背中か。……ふふ、鱗に触れたいのだろう？　汝ならば、構わん」
		CASE 1
			KSTR:(K++) = 「妙な話だ。汝が触れても、妾の力は暴れん。……面白いから、好きにせよ_H_」
		CASE 2
			KSTR:(K++) = 「んっ……_H_　そこを撫でられるのは、悪くない。続けよ_H_」
		CASE 3
			KSTR:(K++) = 「鱗に爪を立てるなよ。……撫でるだけなら、いくらでも許す_H_」
	ENDSELECT
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = %CALLNAME:対象キャラ%は面白がるように髪をかきあげ、背の鱗を%CALLNAME:MASTER%に晒してみせた……
		CASE 1
			KSTR:(K++) = 背を撫でられながら、%CALLNAME:対象キャラ%は肩越しに挑発的な笑みを向けている……
		CASE 2
			KSTR:(K++) = %CALLNAME:対象キャラ%は心地よさそうに背を伸ばし、もっと撫でろと言わんばかりに身を寄せた……
	ENDSELECT
ELSE
	;恋慕やセフレを得ていると基本的に「喜び」になるはずなので、反応で分岐するのは陥落素質なしの場合のみで良い
	IF RFLAG:コマンド結果受渡し変数 == 1
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「触れるな……！　背には、触れてはならん……！」
			CASE 1
				KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%、その手を退けよ。……汝のために言っておるのだ」
		ENDSELECT
		KSTR:(K++) = %CALLNAME:対象キャラ%は鋭く身を翻し、%CALLNAME:MASTER%の手が背に届く前に払いのけた……
	ELSEIF RFLAG:コマンド結果受渡し変数 == 2
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「……背中に触れるのは許す。だが、髪の下には手を入れるな」
			CASE 1
				KSTR:(K++) = 「そこまでだ。それより上へは、指一本這わせるでないぞ」
		ENDSELECT
		KSTR:(K++) = %CALLNAME:対象キャラ%は背に触れる手を許しながらも、%CALLNAME:MASTER%の指が髪の下へ向かわぬよう気を張っている……
	ELSEIF RFLAG:コマンド結果受渡し変数 == 3
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ふふ……背を撫でられるのは、悪くない。……だが、鱗にだけは触れるなよ」
			CASE 1
				KSTR:(K++) = 「ん……心地よいな。……ただし、髪の下だけはならぬ。よいな？」
		ENDSELECT
		KSTR:(K++) = 心地よさそうに目を細めながらも、%CALLNAME:対象キャラ%は肩越しに%CALLNAME:MASTER%の手の行方を見張っている……
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


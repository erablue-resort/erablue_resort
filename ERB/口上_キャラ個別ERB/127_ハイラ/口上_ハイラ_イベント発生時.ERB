;****************************************
;イベント発生時の口上
;「127」をキャラクター番号として、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;処女喪失時
;--------------------------------------------------
;コマンド処理中に RCVAR:対象キャラ:破瓜 が立った時、本体の破瓜の地の文の後に呼ばれる（うふふ・夜這い・性処理業務・むりやりのどれでも起きる）
;ハイラ_キャラ設定.txt：純潔を「どの宝よりも得難い宝」として尊大な形のまま捧げる。破瓜の痛みは強がってこらえる
@KOJO_EVENT_処女喪失_127(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF ハイラ_恋慕側判定_127(対象キャラ)
		WSTR:(K++) = 「っ……く、ぅ……！」
		WSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%の腕に指を食い込ませ、ぎゅっと唇を噛んだ。
		WSTR:(K++) = 「……ふ、ふふ……どうということは、ない……妾を、誰だと思っておる……」
		KSTR:(K++) = 「妾の純潔は、妾が持つどの宝よりも得難いものだ。……それを、汝にくれてやった。光栄に思え_H_」
		KSTR:(K++) = 「そして……粗末に扱うことは、許さぬぞ。……汝は、妾の宝なのだからな_H_」
	ELSEIF TALENT:対象キャラ:セフレ
		WSTR:(K++) = 「っ……！　……く、ふ……ふふ……なるほど、これが破瓜の痛みか……」
		KSTR:(K++) = 「妾の純潔だぞ。どの宝よりも得難いものを、汝にくれてやったのだ」
		KSTR:(K++) = 「……その分、存分に楽しませてもらうからな。覚悟せよ_H_」
		KSTR:(K++) = 強がって笑う%CALLNAME:対象キャラ%の目尻には、うっすらと涙が滲んでいた……
	ELSE
		WSTR:(K++) = 「っ……！　……ふ、ふん。この程度、どうということは……ない……」
		WSTR:(K++) = 強がる声とは裏腹に、%CALLNAME:対象キャラ%の肩は小さく震えていた。
		KSTR:(K++) = 「……妾の純潔だぞ。妾が持つどの宝よりも得難いものを……汝は、手にしたのだ」
		KSTR:(K++) = 「そのこと、決して忘れるでないぞ。%ハイラ_呼び名_127(対象キャラ)%」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;****************************************
;イベント発生時の口上（初対面・挨拶・恋慕自覚・情事目撃・飲み会終了・泥酔した翌朝）
;「127」をキャラクター番号として、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;初対面時
;--------------------------------------------------
;TARGET を切り替えて初めて顔を合わせた時に一度だけ呼ばれる（特定状況口上条件分岐.ERB の @KOJO_遭遇時EVENT → メッセージ呼び出し用構文("初対面")）
;うふふ中・あなたが隠密中は起きない。汎用文章が有効なら、先に「（あなた）は（キャラ）と初めて出会った」が出る
;ハイラ_キャラ設定.txt「イベントの決めごと」：島に来た理由は宝探し（龍玉の手がかりの含みは可）。主人公は島の管理人だが、初対面なので「客人」と呼ぶ
@KOJO_EVENT_初対面_127(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = 角を戴いた小柄な女性が、わずかに上がった息を整えながら、%CALLNAME:MASTER%の顔をじっと見上げてきた。
KSTR:(K++) = 「客人。汝がこの島を取り仕切っている者か。……ほう、管理人とな。まあよい、妾から見れば客人に変わりはあるまい」
WSTR:(K++) = 「名乗っておこう。妾は十二神将がひとり、東南東の守護神にして辰神宮の主――%CALLNAME:対象キャラ%だ」
KSTR:(K++) = 「この島には、珍しい品や美しいものが集まると聞いてな。妾は宝を探しに来た」
KSTR:(K++) = 「……ついでに、ちと探し物もある。何を探しておるかは、今は言わずにおこう」
KSTR:(K++) = 「美しいものの在処を知っておるなら、妾に教えよ。むろん、対価は払う」
KSTR:(K++) = そう言うと%CALLNAME:対象キャラ%は、宝石の目利きでもするように、%CALLNAME:MASTER%の頭から足先までをゆっくりと眺めた。
KSTR:(K++) = 「……汝そのものが宝かどうかは、これからじっくり見定めるとしよう。しばし世話になるぞ、客人」

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
;INFO.ERB の遭遇処理から呼ばれる。MAX(好感度Lv, 恋慕Lv) が 関係閾値:1（10）を超えている時だけ
;先に「あなたを見かけた（キャラ）が挨拶してきた」（閾値:3 を超えていると「駆け寄ってきて」）が出る。情事目撃の問い詰めがある時はそちらが優先
;時間帯（朝 5時～11時／昼 11時～18時／夜 それ以外）と関係の段階で分ける
;段階 3：陥落チェック。恋慕側（ハイラ_恋慕側判定_127）とセフレで温度を変える
;段階 2：好感度Lv 21 以上。名前＋汝
;段階 1：それ以外（ここでは好感度Lv 11～20 の顔見知り）。「客人」
@KOJO_EVENT_挨拶_127(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;挨拶の時間・内容は地の文では言及されないので適宜変更してもOK
IF ハイラ_恋慕側判定_127(対象キャラ)
	;段階 3・恋慕側：宝として大切にする。尊大さが緩む
	SELECTCASE TIME
		;朝　5時～11時
		CASE 5*60 TO 11*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ん……%CALLNAME:MASTER%……。朝から汝の顔を見られるなら、起きるのも悪くはない。……悪くはないが、眠い」
				CASE 1
					KSTR:(K++) = 「おはよう、妾の宝。……ふふ、寝起きの妾にこんな顔をさせるのは、汝くらいのものだ」
				CASE 2
					KSTR:(K++) = %CALLNAME:対象キャラ%はまだ眠たげなまま%CALLNAME:MASTER%の傍に寄ると、宝の無事を確かめるように、その頬へそっと指を添えた。
					KSTR:(K++) = 「……うむ。今日も傷ひとつない。それでよい」
			ENDSELECT
		;昼　11時～18時
		CASE 11*60 TO 18*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「%CALLNAME:MASTER%。暑いというのに、汝の顔を見るとつい傍へ寄りたくなる。……困ったものだ」
				CASE 1
					KSTR:(K++) = 「%CALLNAME:MASTER%、今日はどこへ行く？　……汝が行くのなら、妾も重い腰を上げてやってもよい」
				CASE 2
					KSTR:(K++) = 「妾の宝は、今日もよく輝いておるな。……ふふ、褒めておるのだ。素直に受け取るがよい」
			ENDSELECT
		;夜　それ以外
		CASEELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「%CALLNAME:MASTER%。今宵の酒は汝の隣で飲むと、とうに決めておった。断る理由など、汝にはあるまい？」
				CASE 1
					KSTR:(K++) = 「こんばんは。……昼に汝の顔を見なかった分、今は少し長く眺めさせよ」
				CASE 2
					KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%を見つけるなり、ほっとしたように目元を緩めた。
					KSTR:(K++) = 「ああ、汝か。……ふふ、なんでもない。今日も無事でよかった、と思っただけだ」
			ENDSELECT
	ENDSELECT
ELSEIF 陥落チェック(対象キャラ)
	;段階 3・セフレ：退屈しのぎの宝として挑発し、からかう
	SELECTCASE TIME
		;朝　5時～11時
		CASE 5*60 TO 11*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ふあ……%CALLNAME:MASTER%か。朝から妾の前に顔を出すとは……さては、妾に可愛がられたくて眠れなかったか？」
				CASE 1
					KSTR:(K++) = 「ん……汝か。眠い。……汝が退屈しのぎになってくれるなら、起きてやらんでもない」
				CASE 2
					KSTR:(K++) = %CALLNAME:対象キャラ%は寝ぼけ眼のまま%CALLNAME:MASTER%を眺め、愉しげに唇の端を吊り上げた。
					KSTR:(K++) = 「……ふふ。朝いちばんに見る顔としては、悪くない」
			ENDSELECT
		;昼　11時～18時
		CASE 11*60 TO 18*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「%CALLNAME:MASTER%。暑くて何もする気が起きん。……汝、妾の退屈を紛らわせてみせよ」
				CASE 1
					KSTR:(K++) = 「おや、妾の手慰みの宝ではないか。今日は何をして妾を楽しませてくれる？」
				CASE 2
					KSTR:(K++) = 「汝の顔を見ると、日の高いうちから酒が欲しくなる。……ふふ、どちらも妾を酔わせるからな」
			ENDSELECT
		;夜　それ以外
		CASEELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「%CALLNAME:MASTER%か。夜はよい……酒もうまいし、汝で遊ぶにもちょうどよい刻限だ」
				CASE 1
					KSTR:(K++) = 「こんばんは。……ふふ、そう構えるな。今宵は妾の酒に付き合うだけでよい。……まずは、な」
				CASE 2
					KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%の顎に指をかけ、品定めするようにくいと持ち上げた。
					KSTR:(K++) = 「今宵も、よい顔をしておる。妾の宝として申し分ない」
			ENDSELECT
	ENDSELECT
ELSEIF CFLAG:対象キャラ:好感度レベル > 関係閾値:2
	;段階 2：名前＋汝。打ち解けてきた相手として、気安く接する
	SELECTCASE TIME
		;朝　5時～11時
		CASE 5*60 TO 11*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%か……。妾の寝起きの悪さは、汝ももう知っておろう。用件は手短にせよ」
				CASE 1
					KSTR:(K++) = 「ん……%ハイラ_呼び名_127(対象キャラ)%。おはよう。……妾がこの刻限に起きておるのは珍しいぞ。汝は運がよい」
				CASE 2
					KSTR:(K++) = %CALLNAME:対象キャラ%は眠気の残る目をこすりながら%CALLNAME:MASTER%の顔を認めると、ほんの少しだけ口元を緩めた。
					KSTR:(K++) = 「……汝か。ならば、まあ、もう少し起きておってやろう」
			ENDSELECT
		;昼　11時～18時
		CASE 11*60 TO 18*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%。暑くてかなわん……汝、何か冷たい飲み物を持っておらぬか」
				CASE 1
					KSTR:(K++) = 「おお、%ハイラ_呼び名_127(対象キャラ)%か。ちょうど退屈していたところだ。……ああ、歩くのは御免だぞ。話ならここで聞く」
				CASE 2
					KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%よ。今朝は手持ちの宝を磨いておった。……ふふ、汝にも見せてやりたいくらい、よく光ったぞ」
			ENDSELECT
		;夜　それ以外
		CASEELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%か。ちょうどよい、一杯付き合え。……汝と飲む酒は、ひとりで飲むより味がよい」
				CASE 1
					KSTR:(K++) = 「こんばんは、%ハイラ_呼び名_127(対象キャラ)%。……夜は好きだ。うるさい者が寝静まって、酒がうまくなる」
				CASE 2
					KSTR:(K++) = %CALLNAME:対象キャラ%は盃を傾ける真似をしてみせながら、%CALLNAME:MASTER%を迎えた。
					KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%よ、汝の今日の話を肴にしてやろう。聞かせよ」
			ENDSELECT
	ENDSELECT
ELSE
	;段階 1：「客人」。愛想はないが、顔見知りとして挨拶はする
	SELECTCASE TIME
		;朝　5時～11時
		CASE 5*60 TO 11*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「……客人か。朝は好かぬ。用がないのなら、妾の目が覚めるまで話しかけるな」
				CASE 1
					KSTR:(K++) = %CALLNAME:対象キャラ%は眠たげな目で%CALLNAME:MASTER%を一瞥し、「うむ」とだけ返して小さくあくびをした。
				CASE 2
					KSTR:(K++) = 「客人、早いな。……妾はまだ半分寝ておる。挨拶なら、昼過ぎにもう一度来るがよい」
			ENDSELECT
		;昼　11時～18時
		CASE 11*60 TO 18*60
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「客人か。この島の昼は、妾には暑すぎる。……涼める場所を知っておるなら教えよ」
				CASE 1
					KSTR:(K++) = 「ふむ、客人。島に面白い品が入ったなら、真っ先に妾に知らせよ。よいな」
				CASE 2
					KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%に気づくと、軽く顎を引いて会釈らしきものを寄越した。愛想はないが、無視されないだけましなのだろう。
			ENDSELECT
		;夜　それ以外
		CASEELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「客人か。こんな刻限にうろついて……さては汝も、酒の匂いに誘われた口か？」
				CASE 1
					KSTR:(K++) = 「うむ。……客人、この島でいちばんうまい酒はどこで出る？　知っておるなら言うがよい」
				CASE 2
					KSTR:(K++) = 「夜は静かでよい。……客人、騒ぐつもりなら他所でやれ」
			ENDSELECT
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;次のキャラの一文と区別したい場合は、下のコメントアウトを外すこと
;SIF K > 0
;	DRAWLINE

;--------------------------------------------------
;恋慕自覚時
;（告白成功条件が整っている、かつ恋慕陥落をまだしていない時）
;--------------------------------------------------
;特定状況口上条件分岐.ERB の @KOJO_遭遇時EVENT から、主人公と顔を合わせた時に一度だけ呼ばれる（告白成功判定が真で 初体験日:恋慕自覚 が 0 の時。隠密中は起きない）
;汎用の地の文は無く、この口上だけが出る
;ハイラ_キャラ設定.txt「喪失への恐れ」「夏のエピソード後の安心」を下敷きに、主人公を失いたくない宝だと気づく場面
;すでに陥落（セフレ・疑似恋慕・非エロ陥落）していれば宝とは言ってきた相手なので、「数ある宝のひとつではない」と気づく形にする
@KOJO_EVENT_恋慕自覚_127(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

WSTR:(K++) = %CALLNAME:MASTER%の姿を見つけた途端、%CALLNAME:対象キャラ%の足がふと止まった。
IF 陥落チェック(対象キャラ)
	;すでに宝として扱っている
	KSTR:(K++) = （汝は妾の宝のひとつ……そう思っていた。そう口にもしてきた）
	KSTR:(K++) = だが今、%CALLNAME:MASTER%の顔を見た瞬間に胸を満たしたのは、宝を眺める満足とは違う、もっと静かな安堵だった。
	KSTR:(K++) = （この者を失ったら……ほかのどの宝をかき集めても、きっとこの胸の穴は埋まらぬ）
	KSTR:(K++) = 「……数ある宝のひとつ、などではなかったのだな。汝は」
	KSTR:(K++) = ぽつりとこぼした%CALLNAME:対象キャラ%は、%CALLNAME:MASTER%の手を取り、宝石の重みを確かめるようにそっと握った。
	KSTR:(K++) = 「妾は欲深いぞ。汝を失うくらいなら、天地を敵に回してでも守り抜く。……覚悟しておくがよい」
ELSE
	;まだ宝とは言っていない
	KSTR:(K++) = （……まただ。この者の顔を見ると、胸の奥の虚ろな所が、すっと静まる）
	KSTR:(K++) = 宝を眺めている時と同じ安らぎ。そして、宝を奪われると思った時と同じ、背筋の冷える怖れ。その二つが目の前の一人に向いていることに、%CALLNAME:対象キャラ%はようやく気づいた。
	KSTR:(K++) = （共に過ごす刻が過ぎてゆくのさえ、惜しいと思うてしまう。……ああ、そうか）
	KSTR:(K++) = 「……妾は、いつの間にか、汝を宝にしておったのだな」
	KSTR:(K++) = 小さく漏れた呟きに、%CALLNAME:対象キャラ%は自分で驚いたように目を瞬かせ、それから静かに笑った。
	KSTR:(K++) = 「ふふ……気にするな、独り言だ。……だが覚えておけ。妾は、一度宝と定めたものを決して手放さぬ。何者にも奪わせはせぬ」
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;情事目撃時
;--------------------------------------------------
;INFO.ERB の @AFFAIR_DISCLOSURE で、主人公が別のキャラとうふふしている所を見た時に CFLAG:対象キャラ:情事目撃 に相手が入る
;（恋慕かセフレで、主人公と初うふふ済みなら、問い詰めずにうふふに加わるので、この口上は出ない）
;その後、相手がその場にいない時に顔を合わせると、「（キャラ）に先の（相手）との一件について問い詰められた…」の後に呼ばれる。その日の挨拶より優先
;相手の名前は %CALLNAME:(CFLAG:対象キャラ:情事目撃)%（この口上の後で 0 に戻される）
;怒る時は声を荒げず静かになる（ハイラ_キャラ設定.txt「話し方の調子」）
@KOJO_EVENT_情事目撃_127(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF ハイラ_恋慕側判定_127(対象キャラ)
	;段階 3・恋慕側：自分の宝に他の者が触れたことへの、静かな嫉妬
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「%CALLNAME:MASTER%。……先ほどのは、何だ」
			KSTR:(K++) = 静かな声だった。%CALLNAME:対象キャラ%の顔からは表情が消え、ただ瞳だけが%CALLNAME:MASTER%を捉えて離さない。
		CASE 1
			KSTR:(K++) = 「妾の宝に、%CALLNAME:(CFLAG:対象キャラ:情事目撃)%の匂いがついておる。……好かぬ。実に好かぬ」
		CASE 2
			KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%の手首をつかみ、逃がさぬように引き寄せた。
			KSTR:(K++) = 「……妾から汝を奪えると思うな、と%CALLNAME:(CFLAG:対象キャラ:情事目撃)%には伝えておけ。汝自身にもだ」
	ENDSELECT
ELSEIF 陥落チェック(対象キャラ)
	;段階 3・セフレ（まだ主人公と初うふふをしていない時だけ来る）：先を越されたことを面白がりつつ、自分の番を要求する
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「ほう……%CALLNAME:(CFLAG:対象キャラ:情事目撃)%とは、ずいぶん愉しそうであったな。妾を差し置いて、か」
		CASE 1
			KSTR:(K++) = 「見ておったぞ。……ふふ、怒ってはおらん。ただ、妾ならもっと汝を啼かせてやれる、と思うただけだ」
		CASE 2
			KSTR:(K++) = %CALLNAME:対象キャラ%は面白がるように目を細め、%CALLNAME:MASTER%の胸元を指先でとんと突いた。
			KSTR:(K++) = 「次は妾の番だ。……順番を違えたら、ただでは済まさぬぞ」
	ENDSELECT
ELSEIF CFLAG:対象キャラ:好感度レベル > 関係閾値:2
	;段階 2：責める筋合いはないと分かっていて、胸がざわつく
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%。先ほどのあれ、%CALLNAME:(CFLAG:対象キャラ:情事目撃)%とであったな。……いや、責めはせぬ。せぬが、妾は見たくなかった」
		CASE 1

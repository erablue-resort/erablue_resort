			KSTR:(K++) = 「しばらくは島で厄介になる。身の回りのことは、汝が面倒を見るがよい_H_」
		ENDIF
	ELSE
		IF CFLAG:対象キャラ:MASTERの子供妊娠回数 <= 1
			;あなたとの初めての子
			KSTR:(K++) = 「……%ハイラ_呼び名_127(対象キャラ)%。斯様な姿を見せることになるとはな」
			KSTR:(K++) = 「汝の子だ。宮に戻ってから、日に日に腹が大きくなって……妾も、どうしたものかと思った」
			KSTR:(K++) = %CALLNAME:対象キャラ%は大きく張ったお腹を抱え、ばつが悪そうに視線を逸らした……
			KSTR:(K++) = 「だが、腹の中で動くのを感じるたび、この子を手放す気などとうに失せておると気づかされた」
			KSTR:(K++) = 「……産むぞ。汝がどう思おうと、この子は妾の宝だ」
		ELSE
			;あなたとの二度目以降の子
			KSTR:(K++) = 「……また、この姿で来ることになった。%ハイラ_呼び名_127(対象キャラ)%」
			KSTR:(K++) = %CALLNAME:対象キャラ%は重たげなお腹に手を添え、呆れたような、諦めたような顔で小さく息をついた……
			KSTR:(K++) = 「恋仲でもない相手の子をまた宿すとは、我ながらどうかしておる」
			KSTR:(K++) = 「……それでも、この子も妾の宝だ。上の子と同じように、大切に産み育てる」
		ENDIF
	ENDIF
ELSE
	;あなた以外の子（父親不明を含む）
	KSTR:(K++) = 「久しいな、%ハイラ_呼び名_127(対象キャラ)%。……驚かせたか」
	KSTR:(K++) = 「汝の子ではない。宮で過ごす間に、ここまで育った」
	KSTR:(K++) = %CALLNAME:対象キャラ%は大きく張ったお腹を撫で、ゆっくりと息を整えた……
	IF ハイラ_恋慕側判定_127(対象キャラ)
		KSTR:(K++) = 「……それでも、汝に会いに来た。この腹を見せてでもな。妾の心が汝にあることは、変わっておらぬ」
	ELSE
		KSTR:(K++) = 「腹の子も妾の宝だ。重くてかなわんが、粗末にはできぬ。……しばらく島で休ませてもらうぞ」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;出産_リゾート内で出産時
;--------------------------------------------------
@KOJO_出産_リゾート内_127(対象キャラ)
;口上の前に、産気づいたこと・あなたが医務室へ運んだこと・出産を終えたこと・子供の姿・母親の様子が表示される（妊娠.ERB）
;この時点では EXP:対象キャラ:出産経験 は今回の出産より前の数、CFLAG:対象キャラ:子の父親・今回受胎人数 は今回のまま
;出産経験は生まれた人数ぶん増えるので、前回が双子なら次は「それ以降」に入る。前の子の父親が主人公とは限らないので「上の子」と書く
;尊大さと母としての喜びを混ぜる。体力の無さを出してよい
#DIM 対象キャラ
#DIMS 子供名
#DIMS 子呼び
CALL 口上変数初期化

;初期から出産経験を持つキャラは初産分岐に入ることはないので注意（アリシア、ラルナなど）

IF CFLAG:対象キャラ:今回受胎人数 > 1
	子呼び '= "この子ら"
ELSE
	子呼び '= "この子"
ENDIF

IF CFLAG:対象キャラ:子の父親 == MASTER
	;今回生まれた子の呼び名（名付けていなければ空）
	子供名 '= あなたの子_呼び名_末(対象キャラ, 2, "と")
	IF EXP:対象キャラ:出産経験 == 0
		;初産
		KSTR:(K++) = 「はぁ……っ、はぁ……。終わった、のか……。妾は……やり遂げたのだな……」
		KSTR:(K++) = %CALLNAME:対象キャラ%は寝台にぐったりと身を沈めたまま、それでも腕の中の小さな命から目を離そうとしない……
		IF 子供名 != ""
			KSTR:(K++) = 「%子供名%……。ふふ、よい響きだ。妾の、新しい宝……」
		ELSE
			KSTR:(K++) = 「なんと小さい……。%子呼び%が、妾の新しい宝か……」
		ENDIF
		KSTR:(K++) = 「少し歩くだけで息の切れる妾が、よくぞ持ちこたえたものだ。……褒めてよいぞ、%CALLNAME:MASTER%」
		IF ハイラ_恋慕側判定_127(対象キャラ)
			KSTR:(K++) = 「汝と妾の宝だ。……抱いてみよ。そっとだぞ。%子呼び%は、何者にも傷つけさせぬ_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			KSTR:(K++) = 「戯れの果てに、これほどの宝が手に入るとはな。……ふふっ、汝もたまには顔を見に来るがよい」
		ELSE
			KSTR:(K++) = 「汝との仲がどうであれ……%子呼び%は、妾が生涯かけて愛でる宝だ。……汝も、見ておくがよい」
		ENDIF
	ELSEIF EXP:対象キャラ:出産経験 == 1
		;2回目
		KSTR:(K++) = 「ふぅ……っ。二度目でも、楽にはならんな……。腕一本上げるのも億劫だ……」
		KSTR:(K++) = %CALLNAME:対象キャラ%は汗に濡れた髪をかき上げる力もなく、それでも満足げに口元をほころばせた……
		IF 子供名 != ""
			KSTR:(K++) = 「%子供名%か。……ふふ、また一つ、妾の宝に名が刻まれたな」
		ELSE
			KSTR:(K++) = 「ふふ……また一つ、妾の宝が増えた。上の子も、さぞ喜ぶであろう」
		ENDIF
		IF ハイラ_恋慕側判定_127(対象キャラ)
			KSTR:(K++) = 「%CALLNAME:MASTER%、もっと近くへ。……%子呼び%と汝、妾の宝を並べて眺めていたいのだ_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			KSTR:(K++) = 「ふふっ、そう心配そうな顔をするな。妾は存外しぶといのだ。……ただ、しばらく酒はお預けだがな」
		ELSE
			KSTR:(K++) = 「……付き添ってくれたこと、礼を言う。%子呼び%の顔を、汝にも見せておきたかった」
		ENDIF
	ELSE
		;それ以降
		KSTR:(K++) = 「は……ぁ……。何度経験しても、この疲れだけは慣れぬな……」
		KSTR:(K++) = %CALLNAME:対象キャラ%は枕に頭を預けたまま、慣れた手つきで生まれたばかりの我が子を胸元に抱き寄せた……
		IF 子供名 != ""
			KSTR:(K++) = 「%子供名%、よく来た。妾の宝物庫は賑やかだぞ。……上の子らが、首を長くして待っておる」
		ELSE
			KSTR:(K++) = 「よく来た。妾の宝物庫は賑やかだぞ。……上の子らが、首を長くして待っておる」
		ENDIF
		KSTR:(K++) = 「宝は数あれど、こうして生まれたばかりの顔を見る時ほど満ち足りることはない」
		IF ハイラ_恋慕側判定_127(対象キャラ)
			KSTR:(K++) = 「%CALLNAME:MASTER%。……子らも、汝も、妾が守る。一つとして失わせはせぬ_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			KSTR:(K++) = 「ふふっ、汝との戯れの数だけ宝が増えるな。……体が戻ったら、また相手をしてやろう_H_」
		ELSE
			KSTR:(K++) = 「汝とは、恋仲というわけでもないのにな。……それでも、%子呼び%の父であることは、覚えておけ」
		ENDIF
	ENDIF
ELSE
	;あなた以外の子（父親不明を含む）
	KSTR:(K++) = 「はぁ……っ、%ハイラ_呼び名_127(対象キャラ)%か……。ここまで運んでもらったこと、礼を言う……」
	KSTR:(K++) = %CALLNAME:対象キャラ%は疲れ切った顔で、それでも腕の中の赤子を大切そうに抱え直した……
	KSTR:(K++) = 「汝の子ではないが……見よ、この小さな手を。宝であることに変わりはない」
	IF ハイラ_恋慕側判定_127(対象キャラ)
		KSTR:(K++) = 「……汝にも、%子呼び%を可愛がってほしい。妾の宝を、汝と分かち合いたいのだ」
	ELSE
		KSTR:(K++) = 「%子呼び%は妾が育てる。……体が言うことを聞くようになるまで、少し休ませてもらうぞ」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;出産_リゾート外で出産時
;--------------------------------------------------
@KOJO_出産_リゾート外_127(対象キャラ)
;島の外にいるキャラから連絡が来る、というシチュの口上
;口上の前に、出産の連絡があったこと・子供の姿が表示される（妊娠.ERB）
;この時点では EXP:対象キャラ:出産経験 は今回の出産より前の数、CFLAG:対象キャラ:子の父親・今回受胎人数 は今回のまま
;ハイラからの文（手紙）として書く。前の子の父親が主人公とは限らないので「上の子」と書く
#DIM 対象キャラ
#DIMS 子供名
#DIMS 子呼び
CALL 口上変数初期化

;初期から出産経験を持つキャラは初産分岐に入ることはないので注意（アリシア、ラルナなど）

IF CFLAG:対象キャラ:今回受胎人数 > 1
	子呼び '= "この子ら"
ELSE
	子呼び '= "この子"
ENDIF

IF CFLAG:対象キャラ:子の父親 == MASTER
	;今回生まれた子の呼び名（名付けていなければ空）
	子供名 '= あなたの子_呼び名_末(対象キャラ, 2, "と")
	IF EXP:対象キャラ:出産経験 == 0
		;初産
		KSTR:(K++) = %CALLNAME:対象キャラ%からの文には、尊大な、それでいてどこか浮き立った言葉が並んでいた……
		KSTR:(K++) = 「%CALLNAME:MASTER%へ。妾は無事に子を産んだ。汝の子だ。喜ぶがよい」
		IF 子供名 != ""
			KSTR:(K++) = 「%子供名%は、よく泣き、よく眠る。どの宝よりも小さいくせに、どの宝よりも手がかかる。……それが、妙に愛おしい」
		ELSE
			KSTR:(K++) = 「よく泣き、よく眠る。どの宝よりも小さいくせに、どの宝よりも手がかかる。……それが、妙に愛おしい」
		ENDIF
		KSTR:(K++) = 「正直に言えば、産むのは骨が折れた。妾の体がここまで持ちこたえるとは、妾自身も驚いておる」
		IF ハイラ_恋慕側判定_127(対象キャラ)
			KSTR:(K++) = 「体が戻り次第、%子呼び%を連れて島へ行く。汝の腕で抱いてやれ。……妾のことも、忘れるでないぞ_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			KSTR:(K++) = 「戯れの代価にしては、ずいぶんと上等な宝を得たものだ。……気が向いたら、顔を見に来るがよい」
		ELSE
			KSTR:(K++) = 「汝に知らせる義理があるかは迷ったが……%子呼び%の父には、知る権利があろう。それだけだ」
		ENDIF
	ELSEIF EXP:対象キャラ:出産経験 == 1
		;2回目
		KSTR:(K++) = %CALLNAME:対象キャラ%からの文は短く、それでいて満ち足りた調子で綴られていた……
		KSTR:(K++) = 「%CALLNAME:MASTER%へ。二人目の子が生まれた。二度目とはいえ、やはり楽ではなかったな」
		IF 子供名 != ""
			KSTR:(K++) = 「%子供名%の寝顔を眺めておると、時が過ぎるのを忘れる。……宝を眺めるのは妾の楽しみだが、これは格別だ」
		ELSE
			KSTR:(K++) = 「寝顔を眺めておると、時が過ぎるのを忘れる。……宝を眺めるのは妾の楽しみだが、これは格別だ」
		ENDIF
		IF ハイラ_恋慕側判定_127(対象キャラ)
			KSTR:(K++) = 「出不精の妾が、早く島へ行きたいなどと思うとはな。……汝のせいだぞ_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			KSTR:(K++) = 「しばらく酒も戯れもお預けだ。体が戻ったら、その分まとめて付き合ってもらうぞ_H_」
		ELSE
			KSTR:(K++) = 「%子呼び%のことは、妾が責を持って育てる。汝は……たまに顔を見せれば、それでよい」
		ENDIF
	ELSE
		;それ以降
		KSTR:(K++) = %CALLNAME:対象キャラ%からの文は手短で、子が無事に生まれたという報せと、いくつかの言付けが添えられていた……
		KSTR:(K++) = 「%CALLNAME:MASTER%へ。また宝が増えた。母子ともに無事だ、案ずるな」
		IF 子供名 != ""
			KSTR:(K++) = 「%子供名%も、上の子らに負けず劣らず声が大きい。宮が騒がしくてかなわん。……だが、この騒がしさは嫌いではない」
		ELSE
			KSTR:(K++) = 「上の子らに負けず劣らず、声の大きな子だ。宮が騒がしくてかなわん。……だが、この騒がしさは嫌いではない」
		ENDIF
		IF ハイラ_恋慕側判定_127(対象キャラ)
			KSTR:(K++) = 「汝と妾の宝は、もう両手では抱えきれぬ。……一つ残らず守り抜くゆえ、汝も早く顔を見せに来い_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			KSTR:(K++) = 「戯れのたびに宝が増えるとは、まったく割のいい遊びだ。……体が戻ったら、また島へ行く_H_」
		ELSE
			KSTR:(K++) = 「恋仲でもない汝との子が、ここまで増えるとはな。……それでも、どの子も妾の宝だ。そこは変わらぬ」
		ENDIF
	ENDIF
ELSE
	;あなた以外の子（父親不明を含む）
	KSTR:(K++) = %CALLNAME:対象キャラ%からの文は短く、子が無事に生まれたことだけが淡々と記されていた……
	KSTR:(K++) = 「%ハイラ_呼び名_127(対象キャラ)%へ。子が生まれた。汝の子ではないが、知らせておく」
	KSTR:(K++) = 「小さくて、よく泣く。……妾の宝が、また一つ増えた」
	IF ハイラ_恋慕側判定_127(対象キャラ)
		KSTR:(K++) = 「体が戻ったら、島へ顔を出す。……汝にも、%子呼び%を見せたいのだ」
	ELSE
		KSTR:(K++) = 「しばらくは宮で休む。妾の体では、出歩くのはまだ骨が折れるのでな」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

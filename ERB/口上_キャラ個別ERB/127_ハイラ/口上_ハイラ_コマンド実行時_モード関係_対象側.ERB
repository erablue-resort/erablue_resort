						KSTR:(K++) = %CALLNAME:対象キャラ%は背中に手を回し、鱗が無事か確かめるようにそっと触れた……
					CASE 3
						KSTR:(K++) = %CALLNAME:対象キャラ%は頬に残る熱を隠すように顔を背け、黙って衣の乱れを直している……
				ENDSELECT
			ENDIF
		ELSE
			;Ａ挿入解除
		ENDIF
	ENDIF
ENDIF


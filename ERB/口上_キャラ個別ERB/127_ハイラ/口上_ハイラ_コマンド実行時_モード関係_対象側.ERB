@KOJO_COM_127_60_4(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｖ
;主人公が後ろから挿入し、ハイラの角を掴んで突く。後背位・立ちバックのみ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF ハイラ_恋慕側判定_127(対象キャラ)
		SELECTCASE CUP:対象キャラ:快Ｖ
			CASE IS > 10000
				;即絶頂
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「あ゛っ_H_　角、引かれて……っ_H_　奥に、響いて……っ_H_　お゛っ……ぁぁぁっ_H__H__H_」
					CASE 1
						KSTR:(K++) = 「%CALLNAME:MASTER%っ_H_　妾の角を、そのように……っ_H_　汝にだけは……っ_H_　あ゛ぁぁっ_H__H__H_」
					CASE 2
						KSTR:(K++) = 「妾が、こんな声を……っ_H_　角を手綱にされて……っ_H_　イ……っ、く……っ_H__H__H_」
				ENDSELECT
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 角を握られたまま後ろから深く穿たれ、%CALLNAME:対象キャラ%は背を弓なりに反らせて果てた……_H_
					CASE 1

;--------------------------------------------------
;初期パラメータ変更
;--------------------------------------------------
;NEWGAME時に呼ばれる関数、ロード時には呼ばれないことに注意
;--------------------------------------------------
@口上側初期パラメータ変更_2032
#DIM 対象キャラ
	対象キャラ = FINDCHARA(NO, 2032)

	;キャラクターが自分を指す際の呼び方
	CSTR:対象キャラ:一人称 = こずえ

	;キャラクターがあなたを指す際の呼び方
	;こずえの口調に合わせてひらがな表記
	CSTR:対象キャラ:二人称 = おーなーさん

	;キャラクターが固有に持つ独自の好感度要素の名前
	CSTR:対象キャラ:キャラ固有好感度要素 = ふわふわ

	;体力補正（130cm/28kgの極小体格）
	;小梅(142cm/34kg)の85%よりさらに低く設定
	BASE:対象キャラ:体力 = BASE:対象キャラ:体力 * 78 / 100


;--------------------------------------------------
;ロード時パラメータ変更
;--------------------------------------------------
;ロード時に呼ばれる変数。NEWGAME時に呼ばれないことに注意
;--------------------------------------------------
@口上側LOADENDパラメータ変更_2032
#DIM 対象キャラ
	対象キャラ = FINDCHARA(NO, 2032)

	IF CSTR:対象キャラ:一人称 == ""
		CSTR:対象キャラ:一人称 = こずえ
	ENDIF

	IF CSTR:対象キャラ:二人称 == ""
		CSTR:対象キャラ:二人称 = おーなーさん
	ENDIF

	IF CSTR:対象キャラ:キャラ固有好感度要素 == ""
		CSTR:対象キャラ:キャラ固有好感度要素 = ふわふわ
	ENDIF


;--------------------------------------------------
;固有好感度段階名
;--------------------------------------------------
;こずえの世界観に合わせて全ひらがな表記
;「ふわふわ」＝こずえが相手にどれだけ心を開いているかの指標
;--------------------------------------------------
@キャラ固有好感度関係名_2032(ARG)
SELECTCASE ARG
	CASE IS == 関係閾値:0
		RESULTS = はじめまして
	CASE IS <= 関係閾値:1
		RESULTS = みしらぬひと
	CASE IS <= 関係閾値:2
		RESULTS = おともだち
	CASE IS <= 関係閾値:3
		RESULTS = だいじなひと
	CASE IS <= 関係閾値:4
		RESULTS = いっしょのひと
	CASE IS <= 関係閾値:5
		RESULTS = ずっとずっと
ENDSELECT
RETURN



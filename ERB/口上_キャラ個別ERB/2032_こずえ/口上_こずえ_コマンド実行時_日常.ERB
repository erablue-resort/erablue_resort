;--------------------------------------------------
;口上用のゆきずり相手判定
;--------------------------------------------------
@ゆきずり相手判定_2032(対象キャラ)
#FUNCTIONS
#DIM 対象キャラ
#DIM 相手キャラ

SIF 対象キャラ < 0 || 対象キャラ >= CHARANUM
	RETURNF ""
SIF !IS_ゆきずりセックス中(対象キャラ)
	RETURNF ""

相手キャラ = TCVAR:対象キャラ:ゆきずりセックス_相手キャラID
SIF 相手キャラ < 0 || 相手キャラ >= CHARANUM
	RETURNF ""

SELECTCASE TALENT:相手キャラ:性別
	CASE 1
		;女性
		SELECTCASE TCVAR:対象キャラ:ゆきずりセックス_相手モブ
			CASE 0
				RETURNF "陰気女"
			CASE 1
				RETURNF "人妻"
			CASE 2
				RETURNF "小柄女"
			CASE 3
				RETURNF "快活女"
			CASE 4
				RETURNF "妖艶女"
			CASE 5
				RETURNF "上品女"
			CASE 6
				RETURNF "エルーン女"
			CASE 7
				RETURNF "女性モブ"
		ENDSELECT
	CASE 2
		;男性
		SELECTCASE TCVAR:対象キャラ:ゆきずりセックス_相手モブ
			CASE 0
				RETURNF "陰気青年"
			CASE 1
				RETURNF "中年"
			CASE 2
				RETURNF "ショタ"
			CASE 3
				RETURNF "ゴブガキ"
			CASE 4
				RETURNF "チャラ男"
			CASE 5
				RETURNF "老人"
			CASE 6
				RETURNF "並男"
			CASE 7
				RETURNF "男性モブ"
		ENDSELECT
ENDSELECT

RETURNF ""

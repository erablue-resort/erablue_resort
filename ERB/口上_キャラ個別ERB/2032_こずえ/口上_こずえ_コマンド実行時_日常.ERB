;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
;  -2:大失敗(話題尽き) -1:失敗 0:通常成功 1:大成功
;--------------------------------------------------
@KOJO_COM_2032_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;妊娠中──赤ちゃんの話をする
IF TALENT:対象キャラ:妊娠 && RFLAG:コマンド結果受渡し変数 >= 0
	IF TALENT:対象キャラ:淫乱
		SELECTCASE RAND:3
			CASE 0
			KSTR:(K++) = 「おーなーさん……あかちゃん……おなかのなかで……」
			KSTR:(K++) = 「うごいてるよー……おーなーさんの……おちんちん……まってるのかなー……%UNICODE(0x2661)%」
			PRINTL
			KSTR:(K++) = ぼて腹をぽんぽんと叩きながら、にこにこしている。
			KSTR:(K++) = ──赤ちゃんの話とおちんちんの話が常にセットになっている。
			KSTR:(K++) = この子の中では、全部つながっているのだ。
			CASE 1
			KSTR:(K++) = 「ねーおーなーさん……あかちゃん……うまれたら……おっぱい……あげるの……？ こずえ……おっぱいちっちゃいけど……でるかなー……」
			PRINTL
			KSTR:(K++) = 「でなかったら……おーなーさんの……みるく……あかちゃんに……のませていい……？」
			PRINTL
			KSTR:(K++) = 精液を母乳代わりに──と言っている。真顔で。この子に冗談のつもりは一切ない。
			CASE 2
			KSTR:(K++) = 「おーなーさん……あかちゃん……おとこのこかなー……おんなのこかなー……」
			PRINTL
			KSTR:(K++) = ぼて腹を両手で包んで、首を傾げている。
			PRINTL
			KSTR:(K++) = 「おんなのこだったら……こずえと……おそろいで……」
			KSTR:(K++) = 「おーなーさんの……おちんちんの……あじ……おしえてあげるのー……%UNICODE(0x2661)%」
			PRINTL
			KSTR:(K++) = ──とんでもないことを言い出した。笑顔で。
		ENDSELECT
	ELSEIF TALENT:対象キャラ:恋慕
		SELECTCASE RAND:3
			CASE 0
			KSTR:(K++) = 「おーなーさん……あかちゃん……げんきだよー……おなかのなかで……ぽこぽこ……うごいてるの……」
			PRINTL
			KSTR:(K++) = ぼて腹を撫でながら嬉しそうに報告している。──%CALLNAME:MASTER%の手を取って、お腹に当てた。ぽこ、と蹴った。
			CASE 1
			KSTR:(K++) = 「おーなーさん……あかちゃんの……おなまえ……かんがえよー……こずえがかんがえた……おなまえ……きいてー……」
			PRINTL
			KSTR:(K++) = ぼて腹をぎゅっと抱えて、真剣な目で%CALLNAME:MASTER%を見つめている。──名前はまだ全ひらがなで、本人は自信満々らしい。
			CASE 2
			KSTR:(K++) = 「おーなーさん……こずえ……おかあさんに……なるんだよね……ちゃんと……できるかなー……」
			PRINTL
			KSTR:(K++) = 少し不安そうに、でもどこか嬉しそうに、自分のぼて腹を見つめていた。
			KSTR:(K++) = ──%CALLNAME:MASTER%が大丈夫だと伝えると、ふにゃりと笑った。
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
			KSTR:(K++) = 「おーなーさん……おなかに……だれかいるの……ぽこぽこって……するの……」
			PRINTL
			KSTR:(K++) = 不思議そうにお腹を触っている。──赤ちゃんがいる、ということをまだうまく理解できていないらしい。
			CASE 1
			KSTR:(K++) = 「おーなーさん……こずえ……おなか……おっきくなった……ごはん……たべすぎたー……？」
			PRINTL
			KSTR:(K++) = ──妊娠を食べすぎだと思っている。
		ENDSELECT
	ENDIF
	CALL 口上変数表示(対象キャラ, 0)
	RETURN
ENDIF

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗：話題が尽きた
		KSTR:(K++) = こずえは口を開きかけて──そのまま、ふにゃりと目を閉じかけた。
		PRINTL
		KSTR:(K++) = 「ん…………なんだっけ……ふわぁ…………」
		PRINTL
		KSTR:(K++) = 話題が見つからないのか、それとも単に眠くなっただけなのか。プラチナブロンドの頭がゆらゆらと揺れて、こてん、と傾いた。
	CASE -1
		;失敗
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「おーなーさん……こずえね……おはなし……したいの……でも……ことば……でてこない……」
			PRINTL
			KSTR:(K++) = 左右で高さの違うおさげがしょんぼりと垂れる。
			KSTR:(K++) = 翠の瞳が%CALLNAME:MASTER%を見上げて──
			KSTR:(K++) = 伝えたいことがあるのに形にならない、そのもどかしさに唇がきゅっと結ばれた。
		ELSE
			KSTR:(K++) = 「…………ふわぁ……」
			PRINTL
			KSTR:(K++) = こずえは%CALLNAME:MASTER%の顔をぼんやり見つめたまま、小さくあくびをした。
			KSTR:(K++) = 会話が噛み合わなかったのか、それとも最初から別の何かを見ていたのか──
			KSTR:(K++) = 翠の瞳の焦点が、どこか遠い。
		ENDIF
	CASE 0
		;通常成功
		IF TALENT:対象キャラ:恋慕
			IF TALENT:対象キャラ:淫乱
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = こずえが%CALLNAME:MASTER%の隣にちょこんと座った。
						KSTR:(K++) = 小さな体がぴたりと寄り添うと、カーディガンの下からほのかに甘い体温が伝わってくる。
						PRINTL
						KSTR:(K++) = 「おーなーさん……こずえね……おーなーさんの……においすると……おなかのした……ぎゅってなるの……」
						PRINTL
						KSTR:(K++) = 無邪気にそう告げる翠の瞳には、自分の体に起きていることへの無理解と──
						KSTR:(K++) = それでも求めてしまう衝動が混在している。
						KSTR:(K++) = 白いカーディガンの裾をきゅっと握りしめて、小さな太腿がもぞもぞと擦り合わされた。
					CASE 1
						KSTR:(K++) = 「おーなーさん……きのうのね……まだ……おまんこ……じんじんしてるの……」
						PRINTL
						KSTR:(K++) = 何でもないことのように言って、こずえは%CALLNAME:MASTER%の袖を引いた。
						KSTR:(K++) = チェック柄のスカートの下で、細い太腿がもじもじと動いている。
						KSTR:(K++) = ──昨夜の記憶を体が忘れていないのだ。
						PRINTL
						KSTR:(K++) = 「おはなし……するまえに……ちょっとだけ……さわって……？ こずえの……ここ……%UNICODE(0x2661)%」
						PRINTL
						KSTR:(K++) = 小さな手が%CALLNAME:MASTER%の手を取って、スカートの中に導こうとする。
						KSTR:(K++) = ショーツ越しでもわかるほど、割れ目が湿り始めていた。
					CASEELSE
						KSTR:(K++) = 「おーなーさん……こずえ……おはなしするのすき……でもね……」
						PRINTL
						KSTR:(K++) = ちょこんと%CALLNAME:MASTER%の膝に座ろうとする。
						KSTR:(K++) = チェック柄のスカートが捲れて、白い太腿が露わになった。
						KSTR:(K++) = おしりをちょこちょこと動かして位置を調整しながら──
						KSTR:(K++) = 無意識に%CALLNAME:MASTER%の太腿に自分の股間を押し付けている。
						PRINTL
						KSTR:(K++) = 「……ここにすわると……あったかくて……きもちいいの……えへへ……%UNICODE(0x2661)%」
				ENDSELECT
			ELSE
				KSTR:(K++) = 「おーなーさんとおはなしするのー……こずえ……すきだよー……」
				PRINTL
				KSTR:(K++) = ホワイトカーディガンの袖をぱたぱたと揺らしながら、こずえは嬉しそうに笑った。
				KSTR:(K++) = 相変わらず眠そうな翠の瞳だが、%CALLNAME:MASTER%と話している時だけは、その奥にぽっと小さな灯がともる。
			ENDIF
		ELSE
			KSTR:(K++) = 「ん……おーなーさん……こずえにもわかるように……おはなししてー……？」
			PRINTL
			KSTR:(K++) = 話の内容を半分も理解していない顔だが、聞くこと自体は嫌いではないらしい。
			KSTR:(K++) = プラチナブロンドの頭がゆらゆらと揺れて──
			KSTR:(K++) = 微妙に寝かけているのか、聞き入っているのか、判別がつかない。
		ENDIF
	CASEELSE
		;大成功
		IF TALENT:対象キャラ:恋慕
			IF TALENT:対象キャラ:淫乱
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = %CALLNAME:MASTER%と話しているうちに、こずえの声がだんだんと甘くとろけていく。
						KSTR:(K++) = 翠の瞳がとろんと潤んで、スカートの下で白い太腿がぎゅっと閉じられた。
						PRINTL
						KSTR:(K++) = 「おーなーさん……こずえね……おーなーさんのこえ……きいてると……したのほう……ぬるぬるしてくるの……」
						PRINTL
						KSTR:(K++) = 「おはなしもっとしたい……けど……おまんこ……もう……がまんできないの……%UNICODE(0x2661)%」
						PRINTL
						KSTR:(K++) = 小さな手がスカートの裾をたくし上げた。
						KSTR:(K++) = うさぎ柄のショーツに濃い染みが広がっている。
						KSTR:(K++) = ──声を聞いているだけで発情してしまう体。
						KSTR:(K++) = こずえはそれを恥ずかしいとも思わず、ただ%CALLNAME:MASTER%に見せている。
					CASE 1
						KSTR:(K++) = 「えへへ……おーなーさんとおはなし……たのしいのー……でもね……こずえ……もっとたのしいこと……したい……」
						PRINTL
						KSTR:(K++) = %CALLNAME:MASTER%の手を取って、自分のスカートの中に引き込んだ。
						KSTR:(K++) = ショーツ越しに触れた割れ目がぷっくりと熱を持っていて、指を当てた瞬間ぴくりと小さな体が震えた。
						PRINTL
						KSTR:(K++) = 「ここ……さわって……おーなーさんのて……だいすき……おまんこが……よろこんでるの……%UNICODE(0x2661)%」
					CASEELSE
						KSTR:(K++) = 「おーなーさん……こずえね……おーなーさんのおちんちん……いれてほしいの……いまね……すっごく……いれてほしいの……」
						PRINTL
						KSTR:(K++) = ぽそりと呟いて、%CALLNAME:MASTER%の手を握った。
						KSTR:(K++) = 翠の瞳が真っ直ぐに見上げてくる。
						KSTR:(K++) = ──欲しいものを欲しいと言うだけ。
						KSTR:(K++) = この子には遠慮も駆け引きもない。
						KSTR:(K++) = ただ、体が求めるままに。
						PRINTL
						KSTR:(K++) = 「おはなしは……あとでするから……いま……こずえの……なか……いっぱいにしてー……%UNICODE(0x2661)%」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「えへへー……おーなーさんとおはなしすると……ぜんぜんねむくならないのー……ふしぎだねー……」
						PRINTL
						KSTR:(K++) = 早寝のこずえが眠気を忘れている。
						KSTR:(K++) = それがどれだけ特別なことか──
						KSTR:(K++) = %CALLNAME:MASTER%の言葉一つ一つを、翠の瞳がきらきらと追いかけていた。
					CASE 1
						KSTR:(K++) = 「おーなーさんのおはなし……こずえ……もうおぼえたよー……」
						PRINTL
						KSTR:(K++) = 一度聞いた話を正確に復唱してみせる。
						KSTR:(K++) = 脚本家を驚嘆させた記憶力は健在だ。
						KSTR:(K++) = ──復唱した後、自分でも何を言ったのかわからなくなったのか、小首を傾げて「ふわぁ」と欠伸した。
					CASEELSE
						KSTR:(K++) = 「おーなーさん……こずえね……おーなーさんといると……ぽかぽかするの……」
						PRINTL
						KSTR:(K++) = そっと%CALLNAME:MASTER%の腕にもたれかかった。
						KSTR:(K++) = プラチナブロンドの柔らかな髪がさらりとかかる。
						KSTR:(K++) = 人形のように整った横顔に、穏やかな微笑みが浮かんでいた。
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「おーなーさん……こずえのこと……もっとしりたい……？ えへー……きいていいよー……」
					PRINTL
					KSTR:(K++) = 自分から許可を出しておきながら、何を聞かれても「なんだっけー」と首を傾げる。
					KSTR:(K++) = ──けれど、%CALLNAME:MASTER%が話しかけてくれること自体が嬉しいらしく、翠の瞳がきらきらしていた。
				CASE 1
					KSTR:(K++) = 「えへへ……おーなーさんっておもしろいのー……こずえ……もっときいてたい……」
					PRINTL
					KSTR:(K++) = ホワイトカーディガンの袖をぱたぱた揺らして笑う。
					KSTR:(K++) = 何が面白かったのかは定かではないが──
					KSTR:(K++) = 話の内容よりも、%CALLNAME:MASTER%の声そのものを楽しんでいるようだった。
				CASEELSE
					KSTR:(K++) = 「こずえ……おーなーさんのこえ……すきだよー……ずっときいてたいの……ふわぁ……」
					PRINTL
					KSTR:(K++) = 言いながら、すうっと目が閉じかけた。心地よすぎて眠くなったらしい。──けれど「すきだよ」は確かにこの子の本心だ。
			ENDSELECT
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;こずえ（ID:2032）キャライベント
;「おやこえっち」
;淫乱+出産済み+娘キャラ化後に発火
;CFLAG:960 = おやこえっち完了フラグ
;--------------------------------------------------

@イベント発生条件_キャライベント_2032_おやこえっち
#DIM 対象キャラ
#DIM こずえ人物番号
#DIM 子リスト, 20
#DIM 子数
#DIM 候補キャラ
#DIM 娘キャラ

対象キャラ = キャラ検索("[ようせいのこ]遊佐こずえ")
SIF 対象キャラ < 0
	RETURN 0
;淫乱必須
SIF !TALENT:対象キャラ:淫乱
	RETURN 0
;出産経験あり
SIF CFLAG:対象キャラ:MASTERの子供妊娠回数 < 1
	RETURN 0
;未完了
SIF CFLAG:対象キャラ:960 != 0
	RETURN 0

;こずえの子でキャラ化済み（NO=999）の女の子を探す
こずえ人物番号 = CFLAG:対象キャラ:人物番号
CALL FIND_CHILDREN(こずえ人物番号)
子数 = RESULT
SIF 子数 < 1
	RETURN 0
SIF 子数 > 20
	子数 = 20
FOR LOCAL, 0, 子数
	子リスト:LOCAL = RESULT:(LOCAL + 1)
NEXT

娘キャラ = -1
FOR LOCAL, 0, 子数
	候補キャラ = FIND_CHARA_FROM_PERSON_ID(子リスト:LOCAL)
	SIF 候補キャラ < 0
		CONTINUE
	SIF NO:候補キャラ != 999
		CONTINUE
	SIF !GETBIT(TALENT:候補キャラ:性別, 0)
		CONTINUE
	娘キャラ = 候補キャラ
	BREAK
NEXT

SIF 娘キャラ < 0
	RETURN 0

RETURN 1

@イベント消滅条件_キャライベント_2032_おやこえっち
#DIM 対象キャラ
対象キャラ = キャラ検索("[ようせいのこ]遊佐こずえ")
SIF 対象キャラ < 0
	RETURN 1
SIF CFLAG:対象キャラ:960 == 1
	RETURN 1
RETURN 0

@イベント関数_イベント表示名制御_2032_おやこえっち
#FUNCTIONS
RESULTS = おやこえっち

@イベント関数_キャライベント_2032_おやこえっち(ARG)
#DIM 対象キャラ
対象キャラ = キャラ検索("[ようせいのこ]遊佐こずえ")
CALL KOJO_CHARAEVENT_おやこえっち_2032(対象キャラ)
IF !FLAG:クリア済み視聴フラグ
	CFLAG:対象キャラ:960 = 1
ENDIF
CALL イベント完了フラグ汎用処理("2032_おやこえっち")



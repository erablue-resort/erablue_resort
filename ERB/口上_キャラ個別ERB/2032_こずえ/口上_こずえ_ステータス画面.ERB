;--------------------------------------------------
;通常画面一言口上（一行のみ、WAIT禁止）
;--------------------------------------------------
@口上_INFO画面_一言コメント_2032(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;仕事中
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			KSTR:(K++) = 「おきゃくさんー……いらっしゃいませー……って……いうんだよね……えへへ……」
		CASE 2
			KSTR:(K++) = 「おーなーさん……じゅーす……つくったよー……おいしいよー……」
		CASE 3
			KSTR:(K++) = 「しー……ここ……しずかにするとこだよー……こずえ……ねちゃいそう……」
		CASE 4
			KSTR:(K++) = 「こずえ……およげないけど……みはるの……とくいだよー……たぶん……」
	ENDSELECT
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

IF CFLAG:対象キャラ:飲み会
	KSTR:(K++) = 「おーなーさん……じゅーす……おいしいー……もういっぱいー……」
ELSEIF CFLAG:対象キャラ:睡眠
	KSTR:(K++) = 「すー……すー……おーなーさん……なでなで……むにゃ……」
ELSEIF CFLAG:対象キャラ:デート
	KSTR:(K++) = 「おーなーさんと……おでかけー……どこいくのー……？ えへへー……」
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	KSTR:(K++) = 「おーなーさんと……あそぶー……なにしてあそぶー……？」
ELSEIF CFLAG:対象キャラ:同行
	KSTR:(K++) = 「おーなーさん……こずえ……ついていくー……だっこしてー……あるけないー……」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	KSTR:(K++) = 「ん……だれかいるー……？ きのせいかなー……」
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	KSTR:(K++) = 「ふわぁ……からだ……へんなかんじ……おーなーさん……いないのに……」
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;妊娠中一言
IF TALENT:対象キャラ:妊娠
	IF TALENT:対象キャラ:淫乱
		SELECTCASE RAND:3
			CASE 0
			KSTR:(K++) = 「おーなーさん……あかちゃんが……おーなーさんの……みるく……のみたいって……いってるよー……」
			CASE 1
			KSTR:(K++) = 「おなか……おっきくなっても……えっち……するよー……あかちゃんに……みせてあげるの……」
			CASE 2
			KSTR:(K++) = 「おーなーさん……こずえの……おなか……なでてー……あかちゃんも……パパにあいたがってるの……」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:恋慕
		SELECTCASE RAND:2
			CASE 0
			KSTR:(K++) = 「おーなーさん……あかちゃん……げんきだよー……きょうも……ぽこぽこしてる……」
			CASE 1
			KSTR:(K++) = 「おーなーさんの……あかちゃん……はやくあいたいなー……」
		ENDSELECT
	ELSE
		KSTR:(K++) = 「おなか……おっきくなったー……なんか……はいってるー……」
	ENDIF
	GOTO 表示位置
ENDIF

;好感度で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		KSTR:(K++) = 「おーなーさん……あそぼー……なにしてあそぶー……？」
	CASE 1
		KSTR:(K++) = 「おーなーさん……こずえ……おしごとがんばるよー……たぶんー……」
	CASE 2
		KSTR:(K++) = 「おーなーさん……こずえ……おーなーさんのそば……いたいの……」
	CASE 3
		KSTR:(K++) = 「おーなーさん……こずえ……おーなーさんに……さわってほしいの……」
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_2032(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		KSTR:(K++) = 「……だれー……？ こずえ……ねむい……」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		KSTR:(K++) = 「おーなーさん……こずえのこと……しってるー……？ こずえは……しらない……」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		KSTR:(K++) = 「おーなーさん……おっきいひとだねー……こずえ……おっきいひと……めずらしいー……」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		KSTR:(K++) = 「おーなーさん……こずえのおともだちー……おともだち……いっぱいほしいなー……えへへ……」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		KSTR:(K++) = 「おーなーさんは……こずえの……だいじなおともだちだよー……いっしょにあそぶの……たのしいー……」
	CASEELSE
		KSTR:(K++) = 「おーなーさんは……こずえの……いちばんのおともだちだよー……ずっと……いっしょにいてねー……」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_信頼

	IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-60-") < 0
		;初めてのV挿入=処女喪失はイベント発生時に記載済み。ここは簡易
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = %CALLNAME:MASTER%のペニスがこずえの小さな入り口を押し広げた。──大人のペニスに対して、こずえの体は明らかに小さすぎる。それでも、ゆっくりと沈んでいく。
			PRINTL
			KSTR:(K++) = 「おーなーさん……おっきい……こずえ……おなか……ぱんぱん……」
		ELSE
			KSTR:(K++) = 「ふわぁ……なにかはいってきた……おーなーさんの……おっきいの……こずえのなか……ひろがってるー……」
		ENDIF

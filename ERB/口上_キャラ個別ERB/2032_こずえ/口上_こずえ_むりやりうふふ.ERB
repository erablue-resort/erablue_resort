			CASE 0
			KSTR:(K++) = 「やだー……そこ……なめないでー……って……いうの……？ やだー……」
			PRINTL
			KSTR:(K++) = 確認してから棒読みした。──こずえにとってはただのごっこ遊びのセリフだ。
			CASE 1
			KSTR:(K++) = 「おーなーさん……やめてー……くすぐったいよー……えへ……」
			CASE 2

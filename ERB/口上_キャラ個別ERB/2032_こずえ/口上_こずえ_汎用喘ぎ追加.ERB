;****************************************
;遊佐こずえ口上＠erablue_resort用
;汎用喘ぎ追加口上（Speechファイル）
;キャラ番号: 2032
;汎用喘ぎの直後に追加されるこずえ固有の反応
;口上変数初期化は使わない。KSTR:(K++)のみ
;全ひらがな、ふわふわ口調、体格差リアクション
;淫乱時は命令口調「～しろー」「～でろー」混入
;****************************************

@汎用喘ぎ追加口上_2032(キャラ番号, 喘ぎレベル, 最大快楽部位, 最大快楽量)
#DIM キャラ番号
#DIM 喘ぎレベル
#DIM 最大快楽部位
#DIM 最大快楽量

;3回に1回だけ追加
SIF RAND:3 != 0
	RETURN 0

SELECTCASE 最大快楽部位
	CASE 0
		;快Ｃ
		IF TALENT:キャラ番号:淫乱
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「ん……そこ……さわると……きもちいい……もっとしろー……」
				CASE 3 TO 4
					KSTR:(K++) = 「あっ……そこぉ……おまんこ……びくびく……もっとぐりぐりしろー……%UNICODE(0x2661)%」
				CASE 5
					KSTR:(K++) = 「やっ……だめ……いっちゃ……いくぅ……おまんこ……とまんないぃ……%UNICODE(0x2661)%」
			ENDSELECT
		ELSE
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「ん……へんなかんじ……するー……」
				CASE 3 TO 4
					KSTR:(K++) = 「ふぁ……おなかのした……じんじんする……おーなーさん……」
				CASE 5
					KSTR:(K++) = 「あっ……なにか……くる……からだ……びくってなるぅ……」
			ENDSELECT
		ENDIF
	CASE 1
		;快Ｖ
		IF TALENT:キャラ番号:淫乱
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「ん……おちんちん……なかで……うごいてる……きもちいい……」
				CASE 3 TO 4
					KSTR:(K++) = 「はぁっ……おくまで……きてる……おなかぽこぽこ……もっとおくしろー……%UNICODE(0x2661)%」
				CASE 5
					KSTR:(K++) = 「あ゛っ……なか……ぎゅーってしてる……おちんちん……はなさないの……せーえきだせー……なかにでろー……%UNICODE(0x2661)%」
			ENDSELECT
		ELSE
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「ん……おなか……おっきいのがはいってるー……」
				CASE 3 TO 4
					KSTR:(K++) = 「ふぁ……おなかのおく……こつこつされてる……あたま……ぼーっとする……」
				CASE 5
					KSTR:(K++) = 「あっ……おなか……なにかくる……こずえ……おかしくなっちゃう……」
			ENDSELECT
		ENDIF
	CASE 2
		;快Ａ
		IF TALENT:キャラ番号:淫乱
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「おしり……へんなかんじ……きもちいいかも……」
				CASE 3 TO 4
					KSTR:(K++) = 「おしり……ひくひくしてる……おまんこまで……びくびくなってるぅ……%UNICODE(0x2661)%」
				CASE 5
					KSTR:(K++) = 「おしりで……いきそう……やだ……おしりで……いっちゃう……%UNICODE(0x2661)%」
			ENDSELECT
		ELSE
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「おしり……くすぐったい……」
				CASE 3 TO 4
					KSTR:(K++) = 「ふぁ……おしり……へんなかんじするー……」
				CASE 5
					KSTR:(K++) = 「おしり……からだ……びくびくする……なんでぇ……」
			ENDSELECT
		ENDIF
	CASE 3
		;快Ｂ（B62の薄い胸、乳首メイン）
		IF TALENT:キャラ番号:淫乱
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「ちくび……さわると……びりってするの……」
				CASE 3 TO 4
					KSTR:(K++) = 「ちくびころころしないでぇ……あたま……ぐるぐるするぅ……もっとしろー……%UNICODE(0x2661)%」
				CASE 5
					KSTR:(K++) = 「ちくびで……からだぜんぶ……びりびり……こずえ……むねちっちゃいのに……こんなにかんじちゃう……%UNICODE(0x2661)%」
			ENDSELECT
		ELSE
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「むね……さわるとくすぐったいー……」
				CASE 3 TO 4
					KSTR:(K++) = 「ちくび……かたくなってる……なんでー……」
				CASE 5
					KSTR:(K++) = 「むね……ちくびから……なにか……くるぅ……」
			ENDSELECT
		ENDIF
	CASE 4
		;快Ｓ
		IF TALENT:キャラ番号:淫乱
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「おーなーさんの……て……あったかい……もっとさわって……さわれー……」
				CASE 3 TO 4
					KSTR:(K++) = 「からだぜんぶ……おーなーさんに……さわられてるぅ……きもちいい……もっとしろー……%UNICODE(0x2661)%」
				CASE 5
					KSTR:(K++) = 「さわるだけで……こずえ……いっちゃう……からだ……おーなーさんの……おもちゃ……%UNICODE(0x2661)%」
			ENDSELECT
		ELSE
			SELECTCASE 喘ぎレベル
				CASE 1 TO 2
					KSTR:(K++) = 「ん……なでなで……きもちいい……」
				CASE 3 TO 4
					KSTR:(K++) = 「ふぁ……からだ……あつくなってきた……おーなーさん……」
				CASE 5
					KSTR:(K++) = 「あっ……さわられただけなのに……からだ……びくってした……」
			ENDSELECT
		ENDIF
ENDSELECT
RETURN 0

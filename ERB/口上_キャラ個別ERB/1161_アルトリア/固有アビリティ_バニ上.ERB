@スタイル変更_1161(対象キャラ, 動作モード)
#DIM 対象キャラ
#DIMS 動作モード
;この関数はいくつ別スタイル作ってもキャラ毎に一個
;[聖槍の騎士王]アルトリア・ランサーから[至高の獅子王バニー]アルトリア・ルーラーへ
SELECTCASE 動作モード
	CASE "スタイル名取得"
		VARSET RESULTS
		;RESULTS:Xに肩書を、RESULTS:X+10にリミテッドや水着など通称(？)を入れる
		RESULTS:0 = %NAME:対象キャラ%
		RESULTS:10 = 騎士王

		IF 陥落チェック(対象キャラ)
			RESULTS:1 = [至高の獅子王バニー]アルトリア・ルーラー
			RESULTS:11 = バニ上
		ENDIF
	CASE @"スタイル解説_%NAME:対象キャラ%"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += @"■%NAME:対象キャラ%<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "伝説の騎士王アルトリア・ペンドラゴン。<br>"
		TSTR:スタイル解説 += "王として台頭した後、聖剣ではなく聖槍を手にブリテンを統治したアーサー王のIF。<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "<br>"
		CALL スタイル奥義アビ表示_汎用文章(対象キャラ, NAME:対象キャラ)
	CASE "スタイル解説_[至高の獅子王バニー]アルトリア・ルーラー"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += "■[至高の獅子王バニー]アルトリア・ルーラー<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "聖槍を手にブリテンを統治したアーサー王のIF……がバニーガールになった姿。<br>"
		TSTR:スタイル解説 += "本人曰く「最も格式高く公平なるディーラーの衣装」とのこと。<br>"
		TSTR:スタイル解説 += "一応水着だそうだが、機能性は不明である。<br>"
		TSTR:スタイル解説 += "<br>"
		CALL スタイル奥義アビ表示_汎用文章(対象キャラ, "[至高の獅子王バニー]アルトリア・ルーラー")
	CASE "変更後処理"
		;CSTR:対象キャラ:スタイル管理文字列をキーにして処理を実行
		;一人称や二人称、素質の変化などを想定、今回は何もなし
		SELECTCASE CSTR:対象キャラ:スタイル管理文字列
			CASE ""
			CASE "[至高の獅子王バニー]アルトリア・ルーラー"
			;CASE RESULTS:2
			;CASE RESULTS:3
		ENDSELECT
ENDSELECT



@スタイルステータス補正_至高の獅子王バニー_アルトリア・ルーラー(対象キャラ)
#DIM 対象キャラ
;関数名に[]が使えないため、やむなく[]排除時の文字列をキーに

装備ステータス補正保存:対象キャラ:基礎属性変更 = 属性文字列数値変換("風") + 10
装備ステータス補正保存:対象キャラ:TA率 += 50


@固有ダンジョン突入時_衣装変更_1161(キャラ番号)
#DIM キャラ番号

;ダンジョン突入時に着替える処理を入れる

IF スタイル判定関数(キャラ番号, "[至高の獅子王バニー]アルトリア・ルーラー")
	CALL CLOTHES_CHANGE(キャラ番号, "至高の獅子王バニー")
	
	;1を返さないと適用されないので注意
	RETURN 1
ENDIF



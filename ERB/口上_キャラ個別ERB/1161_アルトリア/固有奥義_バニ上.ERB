
@固有奥義_1161(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力

;ランサーVerの処理は別ファイルにまとめるため、別関数を呼ぶ
; IF CSTR:キャラ番号:スタイル管理文字列 == "[至高の獅子王バニー]アルトリア・ルーラー"
; 	CALL 至高の獅子王バニー固有奥義(ARGS, キャラ番号)
; 	RETURN RESULT
; ENDIF

IF CSTR:キャラ番号:スタイル管理文字列 != "[至高の獅子王バニー]アルトリア・ルーラー"
	RETURN 0
ENDIF

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 35
	奥義名 = 燦燦とあれ、我が輝きの広間＋
	奥義威力 = 0
	表示用奥義威力 = 500
ELSEIF 1
	奥義名 = 燦燦とあれ、我が輝きの広間
	奥義威力 = 0
	表示用奥義威力 = 450
ENDIF

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			詳細文文字列受け渡し変数 = 奥義威力：500　自属性全体攻撃
			詳細文文字列受け渡し変数 += "<br>"
			詳細文文字列受け渡し変数 += "<br>奥義前に自身に［20％］（独自枠・1ターン・消去不可）のダメージ補正_奥義ダメージ上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>奥義前に敵全体に［70％］（独自枠・1被ダメ）の防御力減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>"
		ELSEIF 1
			詳細文文字列受け渡し変数 = 奥義威力：450　自属性全体攻撃
			詳細文文字列受け渡し変数 += "<br>"
			詳細文文字列受け渡し変数 += "<br>奥義前に敵全体に［15％］（独自枠・1ターン・消去不可）のダメージ補正_奥義ダメージ上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>奥義前に［50％］（独自枠・1被ダメ・消去不可）の防御力減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>"
		ENDIF
	CASE "奥義前効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			ARRAYCOPY "アビテンプレート用_対象保存", "アビテンプレート用_奥義使用先保存"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = バニー
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
			アビ汎用変数:効果割合 = 20
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = バニー
			アビ汎用文字列:バフ・デバフ対象能力 = 防御力
			アビ汎用変数:効果割合 = 70
			アビ汎用変数:持続被ダメ回数 = 1
			CALL アビテンプレート_不利効果_デバフ効果セット
		ELSEIF 1
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			ARRAYCOPY "アビテンプレート用_対象保存", "アビテンプレート用_奥義使用先保存"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = バニー
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
			アビ汎用変数:効果割合 = 15
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = バニー
			アビ汎用文字列:バフ・デバフ対象能力 = 防御力
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続被ダメ回数 = 1
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF
	CASE "奥義追加効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			CALL アビ対象選択テンプレート_奥義対象()
			アビ汎用変数:効果割合 = 500
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
		ELSEIF 1
			CALL アビ対象選択テンプレート_奥義対象()
			アビ汎用変数:効果割合 = 450
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
		ENDIF
ENDSELECT


 

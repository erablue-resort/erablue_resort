@固有奥義_3349(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力
#DIM アン隊列
#DIM メアリー隊列
#DIM アン番号
#DIM メアリー番号


IF 陥落チェック(キャラ番号)
	奥義名 = 比翼にして連理＋
	奥義威力 = 300
ELSEIF 1
	奥義名 = 比翼にして連理
	奥義威力 = 300
ENDIF

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		IF 陥落チェック(キャラ番号)
			詳細文文字列受け渡し変数 = 奥義威力：300
			詳細文文字列受け渡し変数 += "<br>奥義前に自身に逆境［100］（独自枠・1ターン）を追加。アンと一緒だとさらに追加。"
		ELSEIF 1
			詳細文文字列受け渡し変数 = 奥義威力：300
			詳細文文字列受け渡し変数 += "<br>アンと一緒だと奥義前に自身に逆境［100］（独自枠・1ターン）を追加。"
		ENDIF
	CASE "奥義前効果"
	アン番号 = GETCHARA(3348)
	メアリー番号 = GETCHARA(3349)
	アン隊列 = キャラ隊列検索(キャラ検索("[カリブ海に舞う比翼の翼]アン・ボニー"))
	メアリー隊列 = キャラ隊列検索(キャラ検索("[カリブ海に舞う比翼の翼]メアリー・リード"))

	IF  陥落チェック(メアリー番号)
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用文字列:バフ・デバフ枠 = 逆境_独自A
		アビ汎用文字列:バフ・デバフ対象能力 = 逆境
		アビ汎用変数:効果割合 = 100
		アビ汎用変数:持続ターン = 1
		CALL アビテンプレート_有利効果_バフ効果セット
	ENDIF
	IF  INRANGE(アン隊列, 0, 3) && INRANGE(メアリー隊列, 0, 3)
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用文字列:バフ・デバフ枠 = 逆境_独自B
		アビ汎用文字列:バフ・デバフ対象能力 = 逆境
		アビ汎用変数:効果割合 = 100
		アビ汎用変数:持続ターン = 1
		CALL アビテンプレート_有利効果_バフ効果セット
	ENDIF
		CALL アビ対象選択テンプレート_敵単体
		ARRAYCOPY "アビテンプレート用_対象保存", "アビテンプレート用_奥義使用先保存"
	CASE "奥義追加効果"
		IF 陥落チェック(キャラ番号)
			CALL アビ対象選択テンプレート_奥義対象()
			アビ汎用変数:効果割合 = 300
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
		ELSE
			CALL アビ対象選択テンプレート_奥義対象()
			アビ汎用変数:効果割合 = 300
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
		ENDIF
ENDSELECT


 

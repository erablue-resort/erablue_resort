@固有奥義_1250(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力

IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 30
	奥義名 = 幻灯のサーカス♡
ELSEIF 陥落チェック(キャラ番号) || 基礎BATTLE_STATE:キャラ番号:Lv >= 30
	奥義名 = 幻灯のサーカス＋
ELSEIF 1
	奥義名 = 幻灯のサーカス
ENDIF
奥義威力 = 0
表示用奥義威力 = 100
SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 30
			詳細文文字列受け渡し変数 += "<br>敵全体に［80％］（Ｃ枠・2行動）の睡眠効果を与える。成功率80％。"
		ELSEIF 陥落チェック(キャラ番号) || 基礎BATTLE_STATE:キャラ番号:Lv >= 30
			詳細文文字列受け渡し変数 += "<br>敵全体に［70％］（Ｃ枠・2行動）の睡眠効果を与える。成功率80％。"
		ELSEIF 1
			詳細文文字列受け渡し変数 += "<br>敵全体に［60％］（Ｃ枠・2行動）の睡眠効果を与える。成功率80％。"
		ENDIF
	CASE "奥義前効果"
	CASE "奥義追加効果"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = 睡眠C
			アビ汎用文字列:バフ・デバフ対象能力 = 睡眠
			アビ汎用変数:効果割合 = 60
			IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 30
				アビ汎用変数:効果割合 = 80
			ELSEIF 陥落チェック(キャラ番号) || 基礎BATTLE_STATE:キャラ番号:Lv >= 30
				アビ汎用変数:効果割合 = 70
			ELSEIF 1
				アビ汎用変数:効果割合 = 60
			ENDIF
			アビ汎用変数:持続行動回数 = 2
			アビ汎用変数:基礎成功確率 = 80
			CALL アビテンプレート_不利効果_デバフ効果セット
ENDSELECT


 

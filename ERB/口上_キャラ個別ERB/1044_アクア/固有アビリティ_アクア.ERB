;=================================================
; アビリティ1：セイクリッド・クリエイト・ウォーター（5ターン冷却）
;=================================================
@固有アビ_1044_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 隊列番号
#DIM クールタイム
#DIM 効果数値
#DIMS アビ名

;レベルなどの条件でアビを強化する場合、アビ名の文字列を条件分岐で変化させる
IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45 ;修改45
	アビ名 = セイクリッド・クリエイト・ウォーター
ELSE
	
ENDIF

隊列番号 = キャラ隊列検索(キャラ番号)
消費ＭＰ = BATTLE_STATE:戦闘行動キャラ:ＭＰ / 4 + 100
効果数値 = 消費ＭＰ / 3 + 100

; 冷却时间的计算 (5回合)
IF INRANGE(隊列番号, 0, 3) && 戦闘中カウント:隊列番号:1
	クールタイム = MAX(0, 5 + 戦闘中カウント:隊列番号:1 - 現在ターン数)
	SIF クールタイム > 0
		アビテンプレート用_アビ封印用フラグ = 1
ELSE
	クールタイム = 0
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵全体に［{効果数値}％］の水属性ダメージ。<br>
		詳細文文字列受け渡し変数 += "［75％］の確率で［湿潤］効果（3ターン）を付与する。行動速度を25％減少させる"
		詳細文文字列受け渡し変数 += "<br>この能力は50％の確率で味方に効果を付与する"
		詳細文文字列受け渡し変数 += "<br>※このアビリティは［5ターン］の冷却時間が発生する。"
		SIF クールタイム > 0
			詳細文文字列受け渡し変数 += @"（残り{クールタイム}ターン）"
		RETURN 消費ＭＰ
	CASE "アビ説明文_詳細"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵全体に［{効果数値}％］の水属性ダメージ。<br>
		詳細文文字列受け渡し変数 += "［75％］の確率で［湿潤］効果（3ターン）を付与する。行動速度を25％減少させる"
		詳細文文字列受け渡し変数 += "<br>この能力は50％の確率で味方に効果を付与する"
		詳細文文字列受け渡し変数 += "<br>※このアビリティは［5ターン］の冷却時間が発生する。"
		SIF クールタイム > 0
			詳細文文字列受け渡し変数 += @"（残り{クールタイム}ターン）"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ対象選択テンプレート_敵全体_生者のみ
		; 2. 湿潤デバフ処理
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 30
		アビ汎用文字列:バフ・デバフ枠 = 湿潤
		アビ汎用変数:特殊表示オプション = 1
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_水		
		アビ汎用変数:持続ターン = 3
		アビ汎用変数:基礎成功確率 = 75
		CALL アビテンプレート_不利効果_デバフ効果セット
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_火耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_火
		アビ汎用変数:効果割合 = 30
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_付随バフ効果セット("湿潤")
		アビ汎用変数:効果割合 = 50
		アビ汎用文字列:バフ・デバフ枠 = 湿潤_風耐性
		アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_風		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_付随デバフ効果セット("湿潤")

		; 1. 水属性ダメージ処理
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 効果数値
		CALL アビテンプレート_ダメージ処理_水属性

		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 25
		アビ汎用文字列:バフ・デバフ枠 = 行動速度
		アビ汎用文字列:バフ・デバフ対象能力 = 行動速度		
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_不利効果_デバフ効果セット

		IF RAND:10 < 5
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			; 2. 湿潤デバフ処理
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 30
			アビ汎用文字列:バフ・デバフ枠 = 湿潤
			アビ汎用変数:特殊表示オプション = 1
			アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_水		
			アビ汎用変数:持続ターン = 3
			アビ汎用変数:基礎成功確率 = 75
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 湿潤_火耐性
			アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_火
			アビ汎用変数:効果割合 = 30
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_付随バフ効果セット("湿潤")
			アビ汎用変数:効果割合 = 50
			アビ汎用文字列:バフ・デバフ枠 = 湿潤_風耐性
			アビ汎用文字列:バフ・デバフ対象能力 = 属性被ダメージ_風		
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_不利効果_付随デバフ効果セット("湿潤")
			; 1. 水属性ダメージ処理
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 効果数値
			CALL アビテンプレート_ダメージ処理_水属性

			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 25
			アビ汎用文字列:バフ・デバフ枠 = 行動速度
			アビ汎用文字列:バフ・デバフ対象能力 = 行動速度		
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_不利効果_デバフ効果セット

		ENDIF
		; 冷却時間记录
		戦闘中カウント:隊列番号:1 = 現在ターン数
ENDSELECT

;=================================================
; アビリティ2：リザレクション (各対象につき戦闘中1回のみ)
;=================================================
@固有アビ_1044_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 選択対象隊列
#DIM 隊列番号

消費ＭＰ = 400
隊列番号 = キャラ隊列検索(キャラ番号)
SIF 隊列番号 > -1 && 戦闘中カウント:隊列番号:2 == 1
	アビテンプレート用_アビ封印用フラグ = 1


SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = リザレクション
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>戦闘不能の味方単体に［回復力✕100％］のＨＰ回復を与える。復活させる。
		詳細文文字列受け渡し変数 += "<br>このアビリティは1戦闘中1回しか使えない。"
		RETURN 消費ＭＰ
	CASE "アビ説明文_詳細"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>戦闘不能の味方単体に［回復力✕100％］のＨＰ回復を与える。復活させる。
		詳細文文字列受け渡し変数 += "<br>このアビリティは1戦闘中1回しか使えない。"
	CASE "アビ効果"
		CALL アビ対象選択テンプレート_味方単体_死者のみ
		SIF アビテンプレート用_キャンセルフラグ
			RETURN -1
		アビ汎用変数:効果割合 = 100
		アビ汎用変数:蘇生可能オプション = 1
		CALL アビテンプレート_回復処理
		戦闘中カウント:隊列番号:2 = 1
ENDSELECT


;=================================================
; アビリティ3：セイクリッド・ハイネス・ヒール
;=================================================
@固有アビ_1044_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 回復値
#DIM 回復値2
#DIM 隊列番号
#DIM クールタイム
隊列番号 = キャラ隊列検索(キャラ番号)

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 40
	アビ名 = セイクリッド・ハイネスヒール
	消費ＭＰ = 150
	回復値 = 200
ELSE
	アビ名 = ヒール
	消費ＭＰ = 85
	回復値 = 120
ENDIF
回復値2 = 回復値 / 4

; 冷却时间的计算 (4回合)
IF INRANGE(隊列番号, 0, 3) && 戦闘中カウント:隊列番号:3
	クールタイム = MAX(0, 4 + 戦闘中カウント:隊列番号:3 - 現在ターン数)
	SIF クールタイム > 0
		アビテンプレート用_アビ封印用フラグ = 1
ELSE
	クールタイム = 0
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>
		IF アビ名 == "セイクリッド・ハイネスヒール"
			詳細文文字列受け渡し変数 += @"味方全体に［回復力✕{回復値}％］のＨＰ回復を与える。［1］のデバフ消去を与える。"
		ELSE 
			詳細文文字列受け渡し変数 += @"味方単体に［回復力✕{回復値}％］のＨＰ回復を与える。"
		ENDIF
		詳細文文字列受け渡し変数 += @"<br>［回復力✕{回復値2}％］（Ａ枠・3ターン）の再生効果を与える。"
		詳細文文字列受け渡し変数 += "<br>※このアビリティは［4ターン］の冷却時間が発生する。"
		SIF クールタイム > 0
			詳細文文字列受け渡し変数 += @"<br>（残り{クールタイム}ターン）"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_自己のみ
		CALL バフ込み数値算出("回復力")
		回復値2 = RESULT * 回復値2 / 100

		CALL アビ汎用変数文字列リセット
		IF アビ名 == "セイクリッド・ハイネスヒール"
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			CALL アビテンプレート_有利効果_デバフ消去()
		ELSE 
			CALL アビ対象選択テンプレート_味方単体_生者のみ
		ENDIF
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:効果割合 = 回復値
		CALL アビテンプレート_回復処理_MAXでも回復

		; 2. リジェネバフ付与
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 再生A
		アビ汎用文字列:バフ・デバフ対象能力 = 再生
		アビ汎用変数:効果量 = 回復値2
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_バフ効果セット

		; 冷却時間记录
		戦闘中カウント:隊列番号:3 = 現在ターン数
ENDSELECT

;=================================================
; アビリティ4：セイクリッド・ブレイクスペル（6ターン冷却）
;=================================================
@固有アビ_1044_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 隊列番号
#DIM クールタイム

隊列番号 = キャラ隊列検索(キャラ番号)
消費ＭＰ = 150

; 冷却时间的计算 (8回合)
IF INRANGE(隊列番号, 0, 3) && 戦闘中カウント:隊列番号:4
	クールタイム = MAX(0, 6 + 戦闘中カウント:隊列番号:4 - 現在ターン数)
	SIF クールタイム > 0
		アビテンプレート用_アビ封印用フラグ = 1
ELSE
	クールタイム = 0
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = セイクリッド・ブレイクスペル
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>自己以外味方単体に弱体効果を全て消去する。
		詳細文文字列受け渡し変数 += "<br>※このアビリティは［6ターン］の冷却時間が発生する。"
		SIF クールタイム > 0
			詳細文文字列受け渡し変数 += @"<br>（残り{クールタイム}ターン）"
		RETURN 消費ＭＰ
	CASE "アビ説明文_詳細"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>自己以外味方単体に弱体効果を全て消去する。
		詳細文文字列受け渡し変数 += "<br>※このアビリティは［6ターン］の冷却時間が発生する。"
		SIF クールタイム > 0
			詳細文文字列受け渡し変数 += @"<br>（残り{クールタイム}ターン）"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方単体_生者のみ_自己以外
		CALL アビテンプレート_有利効果_デバフ全て消去()

		; 冷却時間记录
		戦闘中カウント:隊列番号:4 = 現在ターン数
ENDSELECT

;=================================================
; アビリティ5：セイクリッド・ターンアンデッド
;=================================================
@固有アビ_1044_5(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 効果数値
#DIMS アビ名
#DIM 対象


IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
	アビ名 = セイクリッド・ターンアンデッド
	消費ＭＰ = 100
	効果数値 = 150
ELSE 
	アビ名 = ターン・アンデッド
	消費ＭＰ = 60
	効果数値 = 100
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵単体に{効果数値}％の光属性ダメージ。<br>
		詳細文文字列受け渡し変数 += "［アンデッド］［悪魔］［霊魂］系に倍率が5倍となる。"
		RETURN 消費ＭＰ
	CASE "アビ説明文_詳細"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵単体に{効果数値}％の光属性ダメージ。<br>
		詳細文文字列受け渡し変数 += "［アンデッド］［悪魔］［霊魂］系に倍率が5倍となる。"
	CASE "アビ効果"
		CALL アビ対象選択テンプレート_敵単体
		; 特攻・特効対象判定を組み込んだ光属性ダメージ処理
		CALL アビ汎用変数文字列リセット
		対象 = アビテンプレート用_対象保存:0 - 10
		アビ汎用変数:効果割合 = 効果数値
		IF REGEXPMATCH(敵BATTLE_STATE_STR:対象:種族, "アンデッド|霊魂|悪魔") > 0 			
			KSTR:(K++) = 不浄の生命である%敵BATTLE_STATE_STR:(アビテンプレート用_対象保存:0 - 10):エネミー名%に効果抜群！
			アビ汎用変数:効果割合 = 効果数値 * 5
		ENDIF
		CALL アビテンプレート_ダメージ処理_光属性
ENDSELECT


;=================================================
; ステータス画面：固有特性解説
;=================================================
@口上_ステータス画面_固有特性解説_1044(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = □ 特性：『駄女神の加護とトラブルメーカー』 □------------------------------------
KSTR:(K++) =  ①連続攻撃率・クリティカル率は成長しない、攻撃力・回避率が低め。
KSTR:(K++) =  ②敵対心・最大MPは通常値の2倍になる
KSTR:(K++) =  ③毎ターン30％の確率で［花鳥風月］が発動し、味方全体の攻撃力・防御力・回避率・命中率が25％上昇する，HP＆MPが5％回復する。

CALL 口上変数表示(対象キャラ, 1)


;=================================================
; パッシブ：ターン開始時処理（MP回復・宴会芸・ヘイト等）
;================================================= 
@固有行動開始時処理_キャラ_1044
#DIM 隊列番号
#DIM 回復ＭＰ量


隊列番号 = キャラ隊列検索(GETCHARA(1044))

; 戦闘不能時は処理しない
SIF BATTLE_STATE:隊列番号:ＨＰ <= 0
	RETURN 0

; 1. 回合开始恢复10% MP


; 3. 30%概率触发宴会芸
IF RAND:100 < 30
	WSTR:(K++) = アクアが宴会芸「花鳥風月」を発動した！
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_味方全体_生者のみ
	アビ汎用変数:効果割合 = 5
	アビ汎用文字列:回復側使用能力値 = 最大ＭＰ
	CALL アビテンプレート_ＭＰ回復処理_MAXでも回復

	アビ汎用文字列:回復側使用能力値 = 最大ＨＰ
	CALL アビテンプレート_回復処理_MAXでも回復

	CALL アビ汎用変数文字列リセット
	アビ汎用文字列:バフ・デバフ枠 = 花鳥風月
	アビ汎用文字列:バフ・デバフ対象能力 = 花鳥風月
	アビ汎用変数:特殊表示オプション = 1
	アビ汎用変数:持続ターン = 2
	CALL アビテンプレート_有利効果_バフ効果セット

	CALL アビ汎用変数文字列リセット
	アビ汎用変数:効果割合 = 25
	アビ汎用変数:持続ターン = 2
	;VARSET アビテンプレート用_表示メッセージ格納:0:0
	アビ汎用文字列:バフ・デバフ枠 = 花鳥風月_攻撃力
	アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
	CALL アビテンプレート_有利効果_付随バフ効果セット("花鳥風月")
	アビ汎用文字列:バフ・デバフ枠 = 花鳥風月_防御力
	アビ汎用文字列:バフ・デバフ対象能力 = 防御力
	CALL アビテンプレート_有利効果_付随バフ効果セット("花鳥風月")

	CALL アビ汎用変数文字列リセット
	アビ汎用変数:効果量 = 25
	アビ汎用変数:持続ターン = 2

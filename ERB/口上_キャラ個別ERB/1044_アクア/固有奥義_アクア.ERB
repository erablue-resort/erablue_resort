;=================================================
; 固有奥義：ゴッドブロー / ゴッドレクイエム
;=================================================
@固有奥義_1044(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力
#DIM  対象

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 65 ;修改65
	奥義名 = ゴッドレクイエム
	奥義威力 = 0
	表示用奥義威力 = 400
ELSE
	奥義名 = ゴッドブロー
	奥義威力 = 0
	表示用奥義威力 = 250
ENDIF

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		詳細文文字列受け渡し変数 = 奥義威力：{表示用奥義威力}％<br>敵単体に{表示用奥義威力}％の光属性ダメージ。<br>
		IF 奥義名 == "ゴッドレクイエム"
			詳細文文字列受け渡し変数 += "対象が［アンデッド］［悪魔］［霊魂］の場合、威力倍率が倍増＋防御力を100%減少させる＋確定クリティカル＋高確率で即死。<br>"
		ELSE
			詳細文文字列受け渡し変数 += "対象が［アンデッド］［悪魔］［霊魂］系の場合、威力倍率が倍増＋防御無視100％＋確定クリティカル<br>"
		ENDIF
		詳細文文字列受け渡し変数 += "※対象が［動物］系の場合、ダメージ無効＋自身に［恐怖］［麻痺］（3ターン）。"
		RETURN 奥義威力
	CASE "奥義説明文_詳細"
		詳細文文字列受け渡し変数 = 奥義威力：{表示用奥義威力}％<br>敵単体に{表示用奥義威力}％の光属性ダメージ。<br>
		IF 奥義名 == "ゴッドレクイエム"
			詳細文文字列受け渡し変数 += "対象が［アンデッド］［悪魔］［霊魂］の場合、威力倍率が倍増＋防御力を100%減少させる＋確定クリティカル＋高確率で即死。<br>"
		ELSE
			詳細文文字列受け渡し変数 += "対象が［アンデッド］［悪魔］［霊魂］系の場合、威力倍率が倍増＋防御無視100％＋確定クリティカル<br>"
		ENDIF
		詳細文文字列受け渡し変数 += "※対象が［動物］系の場合、ダメージ無効＋自身に［恐怖］［麻痺］（3ターン）。"
	CASE "奥義前効果"
		
	CASE "奥義追加効果"
		; 技能开始时统一选择目标
		CALL アビ対象選択テンプレート_敵単体
		;アビテンプレート用_対象保存:0 = 奥義対象指定先
		対象 = アビテンプレート用_対象保存:0 - 10
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:ダメージ種類 = 奥義ダメージ

		IF REGEXPMATCH(敵BATTLE_STATE_STR:対象:種族, "アンデッド|霊魂|悪魔") > 0 
			表示用奥義威力 = 表示用奥義威力 * 2
		ENDIF

		; 動物系判定
		IF STRFINDU(敵BATTLE_STATE_STR:対象:種族, "動物") >= 0
			; ダメージ無効化のため効果割合を0に
			KSTR:(K++) = 効果がない……
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用変数:効果割合 = 85
			アビ汎用変数:持続ターン = 3
			アビ汎用文字列:バフ・デバフ枠 = 恐怖
			アビ汎用文字列:バフ・デバフ対象能力 = 恐怖
			CALL アビテンプレート_不利効果_デバフ効果セット
			アビ汎用文字列:バフ・デバフ枠 = 麻痺
			アビ汎用文字列:バフ・デバフ対象能力 = 麻痺
			CALL アビテンプレート_不利効果_デバフ効果セット
		ELSEIF 奥義名 == "ゴッドレクイエム"
			IF REGEXPMATCH(敵BATTLE_STATE_STR:対象:種族, "アンデッド|霊魂|悪魔") > 0 		
				KSTR:(K++) = 不浄の生命である%敵BATTLE_STATE_STR:(アビテンプレート用_対象保存:0 - 10):エネミー名%に効果抜群！
				アビ汎用変数:基礎成功確率 = 80
				CALL アビテンプレート_不利効果_即死

				CALL アビ汎用変数文字列リセット
				アビ汎用変数:効果割合 = 100
				アビ汎用文字列:バフ・デバフ枠 = 防御力
				アビ汎用文字列:バフ・デバフ対象能力 = 防御力
				アビ汎用変数:持続ターン = 2
				CALL アビテンプレート_不利効果_デバフ効果セット

				CALL アビ汎用変数文字列リセット
				;アビ汎用変数:防御無視オプション_割合 = 100
				アビ汎用変数:クリティカルフラグ = 999
			ENDIF
				アビ汎用文字列:ダメージ種類 = 奥義ダメージ
				アビ汎用変数:効果割合 = 表示用奥義威力
				CALL アビテンプレート_ダメージ処理_光属性
		ELSE
			; ゴッドブロー
			IF REGEXPMATCH(敵BATTLE_STATE_STR:対象:種族, "アンデッド|霊魂|悪魔") > 0 		
				KSTR:(K++) = 不浄の生命である%敵BATTLE_STATE_STR:(アビテンプレート用_対象保存:0 - 10):エネミー名%に効果抜群！
				CALL アビ汎用変数文字列リセット
				アビ汎用変数:防御無視オプション_割合 = 100
				アビ汎用変数:クリティカルフラグ = 999
			ENDIF
				アビ汎用文字列:ダメージ種類 = 奥義ダメージ
				アビ汎用変数:効果割合 = 表示用奥義威力
				CALL アビテンプレート_ダメージ処理_光属性
		ENDIF
ENDSELECT
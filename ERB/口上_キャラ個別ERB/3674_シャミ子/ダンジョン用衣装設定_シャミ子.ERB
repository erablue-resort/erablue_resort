;シャミ子の衣装
@固有ダンジョン突入時_衣装変更_3674(キャラ番号)
#DIM キャラ番号

;ダンジョン突入時に着替える処理を入れる
CALL CLOTHES_CHANGE(キャラ番号, "危機管理フォーム")

;1を返さないと適用されないので注意
RETURN 1


@CLOTHES_CHANGE_危機管理フォーム(対象キャラ)
#DIM 対象キャラ
 
;ダンジョン衣装は基本的にキャラクター固有のものになるはずなので、
;ここに服装のテンプレートを置いておく
;YYYYは服装名、他と被らない名前にすること

;一個前の服装を保持
SIF CSTR:対象キャラ:着せ替え服 != "危機管理フォーム"
	CSTR:対象キャラ:脱ぐ前の服 = %CSTR:対象キャラ:着せ替え服%
 
CSTR:対象キャラ:着せ替え服 = 危機管理フォーム
CSTR:対象キャラ:着せ替え服追加名 = 
TEQUIP:対象キャラ:上半身鎧あり = 0
TEQUIP:対象キャラ:上半身服あり = 1
TEQUIP:対象キャラ:脇出し = 1
TEQUIP:対象キャラ:へそ出し = 1
TEQUIP:対象キャラ:はだけ可 = 1
TEQUIP:対象キャラ:手差し込み可 = 1
TEQUIP:対象キャラ:パイズリ可 = 1
TEQUIP:対象キャラ:上タイツあり = 0
TEQUIP:対象キャラ:上半身下着あり = 0
TEQUIP:対象キャラ:上半身下着抜き取り可 = 0
TEQUIP:対象キャラ:下腹部後鎧あり = 0
TEQUIP:対象キャラ:下腹部前鎧あり = 0
TEQUIP:対象キャラ:下半身服あり = 1
TEQUIP:対象キャラ:スカートめくり可 = 0
TEQUIP:対象キャラ:ずらし可 = 1
TEQUIP:対象キャラ:下タイツあり = 0
TEQUIP:対象キャラ:下半身下着あり = 1
TEQUIP:対象キャラ:下半身下着抜き取り可 = 0
TEQUIP:対象キャラ:上下一体服 = 0
TEQUIP:対象キャラ:上下一体タイツ = 0
TEQUIP:対象キャラ:上タイツ破れ = 0
TEQUIP:対象キャラ:下タイツ破れ = 0
TEQUIP:対象キャラ:膝露出 = 0



@CLOTHES_着用条件_危機管理フォーム(対象キャラ)
#DIM 対象キャラ

;キャラのNOが想定したキャラでない場合は着用を禁止する
SIF NO:対象キャラ != 3674
	RETURN 0
;他キャラにも着衣させて良い場合はここの条件は弄ってよい

;ここまで来たらオッケーを出す
RETURN 1

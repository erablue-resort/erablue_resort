
@固有奥義_1507(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力

IF 陥落チェック(キャラ番号)
	奥義名 = ”こおる大地”
	奥義威力 = 0
	表示用奥義威力 = 450
ELSE
	奥義名 = ”こおる大地”
	奥義威力 = 0
	表示用奥義威力 = 150
ENDIF
SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
			詳細文文字列受け渡し変数 = 奥義威力：150　自属性全体攻撃　陥落時効果３倍
			詳細文文字列受け渡し変数 += "<br>［1］のバフ消去効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［25％］（Ｄ枠・3ターン）の攻撃力・防御力減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［50％］（Ｄ枠・3ターン）の被回復量減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［50］（Ｄ枠・3ターン）の回避率減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［500］（Ｄ枠・3ターン）の氷結効果を与える。"
	CASE "奥義前効果"
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			ARRAYCOPY "アビテンプレート用_対象保存", "アビテンプレート用_奥義使用先保存"
	CASE "奥義追加効果"
			CALL アビ対象選択テンプレート_奥義対象()
			IF 陥落チェック(キャラ番号)
				アビ汎用変数:効果割合 = 300
			ELSE
				アビ汎用変数:効果割合 = 150
			ENDIF
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_自属性
			CALL アビ汎用変数文字列リセット
			CALL アビテンプレート_不利効果_バフ消去()
			IF 陥落チェック(キャラ番号)
				CALL アビテンプレート_不利効果_バフ消去()
				CALL アビテンプレート_不利効果_バフ消去()
			ENDIF
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力D
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:効果割合 = 25
			IF 陥落チェック(キャラ番号)
				アビ汎用変数:持続ターン = 9
			ELSE
				アビ汎用変数:持続ターン = 3
			ENDIF
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 防御力D
			アビ汎用文字列:バフ・デバフ対象能力 = 防御力
			アビ汎用変数:効果割合 = 25
			IF 陥落チェック(キャラ番号)
				アビ汎用変数:持続ターン = 9
			ELSE
				アビ汎用変数:持続ターン = 3
			ENDIF
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 被回復量D
			アビ汎用文字列:バフ・デバフ対象能力 = 被回復量
			アビ汎用変数:効果割合 = 50
			IF 陥落チェック(キャラ番号)
				アビ汎用変数:持続ターン = 9
			ELSE
				アビ汎用変数:持続ターン = 3
			ENDIF
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 回避率D
			アビ汎用文字列:バフ・デバフ対象能力 = 回避率
			アビ汎用変数:効果量 = 50
			IF 陥落チェック(キャラ番号)
				アビ汎用変数:持続ターン = 9
			ELSE
				アビ汎用変数:持続ターン = 3
			ENDIF
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 氷結D
			アビ汎用文字列:バフ・デバフ対象能力 = 氷結
			アビ汎用変数:効果量 = 500
			IF 陥落チェック(キャラ番号)
				アビ汎用変数:持続ターン = 9
			ELSE
				アビ汎用変数:持続ターン = 3
			ENDIF
			CALL アビテンプレート_不利効果_デバフ効果セット
ENDSELECT


 


@固有アビ_1507_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
	アビ名 = 闇の魔法＋＋
	消費ＭＰ = 500
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 24
	アビ名 = 闇の魔法＋
	消費ＭＰ = 500
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 12
	アビ名 = 闇の魔法
	消費ＭＰ = 500
ELSE
	アビ名 = 
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>自身に（独自枠・5ターン）の再行動［2］効果を与える。
			詳細文文字列受け渡し変数 += "<br>［200％］（独自枠・5ターン）の行動速度上昇効果を与える。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 24
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>自身に（独自枠・3ターン）の再行動［2］効果を与える。
			詳細文文字列受け渡し変数 += "<br>［200％］（独自枠・3ターン）の行動速度上昇効果を与える。"
		ELSE
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>自身に（独自枠・2ターン）の再行動［2］効果を与える。
			詳細文文字列受け渡し変数 += "<br>［200％］（独自枠・2ターン）の行動速度上昇効果を与える。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用文字列:バフ・デバフ枠 = 再行動_闇の魔法
		アビ汎用文字列:バフ・デバフ対象能力 = 再行動
		アビ汎用変数:効果量 = 2
		アビ汎用変数:消去不可オプション = 1
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
			アビ汎用変数:持続ターン = 5
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 24
			アビ汎用変数:持続ターン = 3
		ELSE
			アビ汎用変数:持続ターン = 2
		ENDIF
		CALL アビテンプレート_有利効果_バフ効果セット
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 行動速度独自
		アビ汎用文字列:バフ・デバフ対象能力 = 行動速度
		アビ汎用変数:効果割合 = 200
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
			アビ汎用変数:持続ターン = 5
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 24
			アビ汎用変数:持続ターン = 3
		ELSE
			アビ汎用変数:持続ターン = 2
		ENDIF
		アビ汎用変数:消去不可オプション = 1
		CALL アビテンプレート_有利効果_バフ効果セット

ENDSELECT

@固有通常攻撃後処理_キャラ_1507(全滅フラグ, 連撃数)
#DIM 全滅フラグ
#DIM 連撃数
#DIM エヴァ番号
#DIM エヴァ隊列
#DIM バフ量


SIF 全滅フラグ
	RETURN 0

エヴァ番号 = GETCHARA(1507)
エヴァ隊列 = キャラ隊列検索(GETCHARA(1507))

IF 陥落チェック(エヴァ番号)
	バフ量 = 基礎BATTLE_STATE:エヴァ番号:Lv * 15
ELSE
	バフ量 = 基礎BATTLE_STATE:エヴァ番号:Lv * 5
ENDIF

CALL アビテンプレート用_表示メッセージ変換処理
アビテンプレート用_アビ名表示済フラグ = 0


IF 陥落チェック(エヴァ番号)
	バフ量 = 基礎BATTLE_STATE:エヴァ番号:Lv * 15
ELSE
	バフ量 = 基礎BATTLE_STATE:エヴァ番号:Lv * 5
ENDIF

;HP回復
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_味方全体
アビテンプレート用_アビ名 = 気まぐれサポート
アビ汎用文字列:適用範囲 = 味方全体
アビ汎用変数:効果量 = バフ量
アビ汎用文字列:回復側使用能力値 = 回復力
CALL アビテンプレート_回復処理_MAXでも回復
戦闘中カウント:エヴァ隊列:0 += 1
IF 戦闘中カウント:エヴァ隊列:0 > 2 
	戦闘中カウント:エヴァ隊列:0 -= 3
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_味方全体
	アビテンプレート用_アビ名 = ご褒美
	アビ汎用変数:効果量 = バフ量
	アビ汎用文字列:回復側使用能力値 = 回復力
	CALL アビテンプレート_ＭＰ回復処理_MAXでも回復
ENDIF


@固有戦闘開始時処理_キャラ_1507
;戦闘開始時処理関数から呼び出し
#DIM バフ・デバフ行数
#DIM エヴァ番号
#DIM バフ量

エヴァ番号 = GETCHARA(1507)
IF 陥落チェック(エヴァ番号)
	バフ量 = 基礎BATTLE_STATE:エヴァ番号:Lv * 9
ELSE
	バフ量 = 基礎BATTLE_STATE:エヴァ番号:Lv * 3
ENDIF

CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = 不死の魔法使い
アビ汎用文字列:バフ・デバフ対象能力 = 自動復活
アビ汎用変数:効果割合 = 80
アビ汎用変数:持続回数 = 1
CALL アビテンプレート_有利効果_バフ効果セット

CALL アビテンプレート用_表示メッセージ変換処理
アビテンプレート用_アビ名表示済フラグ = 0

CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_味方全体
アビテンプレート用_アビ名 = 気まぐれサポート
アビ汎用文字列:適用範囲 = 味方全体
アビ汎用文字列:バフ・デバフ枠 = ダメージ補正_通常攻撃ダメージ_師匠
アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_通常攻撃ダメージ
アビ汎用変数:効果量 = バフ量
アビ汎用変数:持続ターン = -1
アビ汎用変数:消去不可オプション = 1
CALL アビテンプレート_有利効果_バフ効果セット


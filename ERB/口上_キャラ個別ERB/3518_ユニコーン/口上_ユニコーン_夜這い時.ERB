	ELSE
		;通常時
		IF TALENT:対象キャラ:恋慕
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%の腕に包まれながら、とろんとした瞳で見上げた。
					KSTR:(K++) = 「えへへ……お兄ちゃん……ユニコーン、来ちゃった……_H_　だって……お兄ちゃんに会いたかったんだもん……」
					KSTR:(K++) = 「おなか……あったかい……_H_　お兄ちゃんの匂いに包まれてると……安心する……」
					KSTR:(K++) = 「このまま朝まで……一緒にいてもいい……？」
				CASE 1
					KSTR:(K++) = 「お兄ちゃん……えへへ……_H_　ユニコーン、幸せ……」
					KSTR:(K++) = %CALLNAME:対象キャラ%はゆーちゃんと%CALLNAME:MASTER%の腕を両方抱きしめて、すりすりと頬を擦り寄せた。
					KSTR:(K++) = 「ゆーちゃんもお兄ちゃんも大好き……でもね……お兄ちゃんの方が……もっともっと大好き……_H_」
					KSTR:(K++) = 「内緒だよ……ゆーちゃんには……えへへ……」
				CASE 2
					KSTR:(K++) = 「ん……お兄ちゃん……_H_」
					KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%の胸元に耳を当て、鼓動を聞きながら微笑んだ。
					KSTR:(K++) = 「お兄ちゃんの心臓の音……とくんとくんって……ユニコーンだけの子守唄みたい……_H_」
					KSTR:(K++) = 「……すぅ……」
					KSTR:(K++) = すやすやと寝息を立て始めた%CALLNAME:対象キャラ%の寝顔は、どこまでも幸せそうだった。
			ENDSELECT
		ELSEIF TALENT:対象キャラ:セフレ
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「はぁ……はぁ……_H_　お兄ちゃん……すごかった……_H_」
					KSTR:(K++) = %CALLNAME:対象キャラ%は汗ばんだ体を%CALLNAME:MASTER%に預け、ぼんやりとした瞳で天井を見つめていた。
					KSTR:(K++) = 「おなかの奥……まだびくびくしてる……_H_　……えへへ、ユニコーン……もう変な子になっちゃったね……_H_」

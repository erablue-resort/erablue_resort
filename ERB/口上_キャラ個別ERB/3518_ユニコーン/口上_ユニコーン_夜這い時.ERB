			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「あ……あの……ごめんなさい……勝手に来ちゃって……」
					KSTR:(K++) = %CALLNAME:対象キャラ%は気まずそうに目を逸らしながらも、%CALLNAME:MASTER%の隣から動こうとしなかった。

;--------------------------------------------------
;一日終了時の夜這い失敗時
;--------------------------------------------------
@KOJO_夜這い失敗時_3518(対象キャラ, 相手キャラ)
#DIM 対象キャラ
#DIM 相手キャラ
CALL 口上変数初期化

SELECTCASE CSTR:対象キャラ:夜這い口上渡し_記録文字列
	CASE "まごまご"
		;夜這い経験が少なくてまごまごして帰っちゃった
		IF 相手キャラ == MASTER
			KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%の部屋の前まで来たものの、ドアノブに手をかけたまま固まっていた。
			KSTR:(K++) = ゆーちゃんを胸にぎゅっと抱きしめ、何度も深呼吸を繰り返す。
			KSTR:(K++) = 「お兄ちゃん……あの……ユニコーン……えっと……」
			KSTR:(K++) = 「……だめ……やっぱり恥ずかしい……ゆーちゃん、帰ろ……」
			KSTR:(K++) = 小さな足音がぱたぱたと廊下を遠ざかっていった。
		ELSE
			KSTR:(K++) = 「……あの……えっと……ごめんなさい……ユニコーン……やっぱり帰るね……」
			KSTR:(K++) = %CALLNAME:対象キャラ%はゆーちゃんを抱きしめたまま、もじもじと立ち尽くした後──小走りで去っていった。
		ENDIF
	CASE "不在"
		;相手が別の場所で寝てるなどで不在
		IF 相手キャラ == MASTER
			KSTR:(K++) = 「お兄ちゃん……？　いないの……？」
			KSTR:(K++) = %CALLNAME:対象キャラ%はがらんとした部屋を見回し、しゅんと肩を落とした。
			KSTR:(K++) = 「……ゆーちゃん、お兄ちゃんいなかったね……。ユニコーン、せっかく勇気出したのに……」
			KSTR:(K++) = 寂しそうにゆーちゃんの頭を撫でながら、とぼとぼと自分の部屋へ戻っていった。
		ELSE
			KSTR:(K++) = 「……いないみたい。ゆーちゃん、帰ろっか……」
			KSTR:(K++) = %CALLNAME:対象キャラ%は少しだけほっとしたような顔で部屋を出た。
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


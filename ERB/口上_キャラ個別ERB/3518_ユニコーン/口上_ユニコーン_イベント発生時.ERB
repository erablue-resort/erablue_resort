		;恋慕関係性の場合
		KSTR:(K++) = 「えへへ……今日ね、大好きな人とお出かけしてきたの……。すっごく楽しかった……」
	ELSEIF 関係性チェック(対象キャラ, ABS(CFLAG:対象キャラ:デート) - 100, "セフレ")
		;セフレ関係性の場合
		KSTR:(K++) = 「えっと……今日、お友達とお出かけしてきたの……。うん、楽しかったよ……」
	ELSEIF 縁結び進展度取得(対象キャラ, ABS(CFLAG:対象キャラ:デート) - 100, "恋慕") > 0
		;恋慕がまだ成立してない場合
		KSTR:(K++) = 「あのね……今日、気になる人をお出かけに誘ったの……。ドキドキしちゃった……」
	ELSEIF 縁結び進展度取得(対象キャラ, ABS(CFLAG:対象キャラ:デート) - 100, "セフレ") > 0
		;セフレがまだ成立してない場合
		KSTR:(K++) = 「今日はお友達とお出かけ……。仲良くなれたかな……えへへ」
	ENDIF
ELSE

;****************************************
;コマンド実行後に表示される文章
;モードを開始したり削除したりするものを記載
;****************************************
;・使い方
;「XXXX」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
;	CUP:対象キャラ:快Ｃ
;	CUP:対象キャラ:快Ｖ
;	CUP:対象キャラ:快Ａ
;	CUP:対象キャラ:快Ｂ
;	CUP:対象キャラ:快Ｓ
;
;TCVAR:対象キャラ:弱点コマンドフラグ
;	該当コマンドが弱点かどうか
;	現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
;	口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない
;
;オートコマンドで実行したか、コマンドで実行したか
;	TFLAG:オートコマンドフラグ > 1 の時はオートコマンド、それ以外なら指示モード
;
;コマンド初回実行
;	IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
;	コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM9_1_セルフ手コキ
;--------------------------------------------------
@KOJO_COM_3518_9_1(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｃ
;自慰系はオートコマンドで自分からやるパターンあり
;IF TFLAG:オートコマンドフラグ > 1 で判定可能

CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE CUP:対象キャラ:快Ｃ
			;各部位の累積が10000で絶頂
			CASE IS > 10000
				;即絶頂
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「お兄ちゃんに見られながらっ_H_　ユニコーン、自分でっ_H_　イっちゃう……っ_H__H_　あ、あぁっ_H__H_」

					CASE 1
						KSTR:(K++) = 「だめっ_H_　お兄ちゃんが見てるからっ_H_　余計にっ_H_　自分の手でイっちゃう……んぅっ_H__H_」

					CASE 2
						KSTR:(K++) = 「やぁっ_H_　自分でこすったらっ_H_　すぐイっちゃった……っ_H_　お兄ちゃんのせいだよぉ……_H__H_」

					CASE 3
						KSTR:(K++) = 「ひっ_H_　イくっ_H_　お兄ちゃんに見つめられてっ_H_　自分の指でぐちゅぐちゅしてたらっ_H_　ユニコーンもうだめ……っ_H_　あっ_H_　指がとまらないのぉ……っ_H__H_　お兄ちゃんの目がえっちだから、ユニコーンのここ、ひくひくして止まんないよぉ……っ_H__H_」
				ENDSELECT
			CASE IS > 6000
				;かなり感じている
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「はぁ……っ_H_　お兄ちゃんの前で、こんなことっ_H_　でも、止められない……の゛ぉ……_H__H_」

					CASE 1
						KSTR:(K++) = 「んぅっ_H_　ユニコーンの手、ぬるぬるになってきて……_H_　お兄ちゃんに見られてるのに、きもちいの……_H__H_」

					CASE 2
						KSTR:(K++) = 「あっ_H_　お兄ちゃんが見てるとっ_H_　どきどきして……余計に感じちゃう……_H__H_」

					CASE 3
						KSTR:(K++) = 「はぁっ_H_　自分の手なのにっ_H_　お兄ちゃんの視線がユニコーンのここに集まってるって思うと……っ_H_　おまめのあたりがじんじんして、手が止まんない……_H_　ユニコーン、えっちな子になっちゃったの……？_H__H_」
				ENDSELECT
			CASE IS > 3000
				;人並みに感じている
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「ん……っ_H_　お兄ちゃんに言われたから……ユニコーン、ここ触ってるけど……なんか、きもちいい……_H_」

					CASE 1
						KSTR:(K++) = 「えへへ……お兄ちゃんの前でこうするの、恥ずかしいけど……_H_　なんか、ぽかぽかしてきた……_H_」

					CASE 2
						KSTR:(K++) = 「ん……自分で触るとさ……_H_　お兄ちゃんにしてもらうのとちょっと違うね……でも、きもちいかも……_H_」

					CASE 3
						KSTR:(K++) = 「んっ……_H_　お兄ちゃんが見てると思うと……ちょっとどきどきする……_H_　ユニコーン、上手にできてるかな……？_H_」
				ENDSELECT
			CASEELSE
				;まだ快楽に慣れていない
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「えっと……こう……？　ユニコーン、自分でするの、よくわかんないよぉ……」

					CASE 1
						KSTR:(K++) = 「お兄ちゃん……自分で触っても、何が気持ちいいのかわかんないの……教えて……？」

					CASE 2
						KSTR:(K++) = 「う……こうやって触ればいいの……？　ユニコーン、手の動かし方がわかんない……」

					CASE 3
						KSTR:(K++) = 「えと……自分の手で……こう……？　なんか、くすぐったいだけだよぉ……」
				ENDSELECT
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「ん……こう、すればいいの……？　自分で触るの……恥ずかしい……_H_」

			CASE 1
				KSTR:(K++) = 「ん……自分でこうやって……_H_　見てるなら、もうちょっとそっぽ向いてほしいんだけど……_H_」

			CASE 2
				KSTR:(K++) = 「はぁ……自分で触ってると……なんか虚しいんだけど……_H_」

			CASE 3
				KSTR:(K++) = 「ん……こうやって触ればいいんでしょ……_H_　あんまりじっと見ないでよ……_H_」
		ENDSELECT
	ELSE
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「う……自分でやれって言うの……？　こんなこと……恥ずかしいよ……」

			CASE 1
				KSTR:(K++) = 「えっ……自分でこんなこと……ユニコーン、やだよぉ……」

			CASE 2
				KSTR:(K++) = 「やだ……そんなの、自分でなんてできないよ……」

			CASE 3
				KSTR:(K++) = 「う……ユニコーンに自分でやれっていうの……？　ひどいよぉ……」
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


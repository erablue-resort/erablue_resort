#DIM ユニコーン番号

ユニコーン番号 = GETCHARA(3518)
SELECTCASE 動作モード
	CASE "設定取得"
		;CH:Character Endingの略。キャラエンドの意
		TSTR:コマンド名受渡 = EX3518

		;解説文もここで取得
		TSTR:ツールチップ受渡 =
		TSTR:ツールチップ受渡 += "■エンディングNo.EX3518『ユニコーン』<br>"
		TSTR:ツールチップ受渡 += "<br>"
		TSTR:ツールチップ受渡 += "ユニコーンとの仲を深め、結婚式を挙げるキャラクターエンド。<br>"
		TSTR:ツールチップ受渡 += "天使のような花嫁と愛を誓い、新たな命を授かる。<br>"
		TSTR:ツールチップ受渡 += "<br>"
		TSTR:ツールチップ受渡 += "実行条件：5,000ZPの所持/キャラ『ユニコーン』が恋慕状態<br>"
		TSTR:ツールチップ受渡 += "解放要素：ゲーム開始直後からキャラ『ユニコーン』が解放される<br>"
		TSTR:ツールチップ受渡 += "エンディング視聴後：現在の周回を継続<br>"
	CASE "発生条件"
		;リストに表示するための条件
		;一回表示したらその後条件を満たさなくなっても表示したままなので注意
		SIF リゾートランク < 2
			RETURN 0
		SIF CFLAG:ユニコーン番号:恋慕度 < 経験値テーブル:(関係閾値:3)
			RETURN 0
		RETURN 1
	CASE "実行条件"
		;リストから実行するための条件
		;満たしてない間は実行ボタンが灰色で表示され、クリック不可
		SIF FLAG:ZP所持量 < 5000
			RETURN 0
		SIF !TALENT:ユニコーン番号:恋慕
			RETURN 0
		RETURN 1
	CASE "実処理"
		SIF !FLAG:クリア済み視聴フラグ
			FLAG:ZP所持量 -= 5000

		;文章部分はここに記載するよりも別関数に分ける方が見やすいし書きやすいので推奨
		CALL エンディングイベント_シナリオ_ユニコーン()
		RETURN RESULT
ENDSELECT


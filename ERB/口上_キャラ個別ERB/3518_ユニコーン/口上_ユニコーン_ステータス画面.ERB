;・ユニコーン（キャラ番号3518）ステータス画面一言口上
;一人称「ユニコーン」（三人称自称）、二人称「お兄ちゃん」
;えへへ、ゆーちゃん、カタカナ→ひらがな変換が特徴
;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_3518(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、通常時の画面で表示されるので
;基本的にWAIT系列は使わないことを推奨
;また、一行のみの表示を想定。二行以上は基本的に禁止
;※うふふ中には表示されません

;以下は分岐の例
;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	KSTR:(K++) = 「はぅ……まだ体が……ぴくぴくしてるの……えへへ……」
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = 「いらっしゃいませ。えへへ、ユニコーンがご案内しますね」
		CASE 2
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「お兄ちゃん、何飲む……？ ゆーちゃんのおすすめは、みるくだよ」
		CASE 3
			;図書室で司書中
			KSTR:(K++) = 「しーっ……ここは静かにしてね。ゆーちゃんもお昼寝してるから……」
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 「お兄ちゃん、走っちゃだめだよ……？ ユニコーンが見てるからね」
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = 「えへへ……お魚さん、いっぱい獲れたよ。ゆーちゃんも喜んでる」
		CASE 6
			;遊覧船・海底散歩でシーガイド中
			KSTR:(K++) = 「お兄ちゃん、見て見て……お魚さんがきらきらしてるの……えへへ」
		CASE 100 TO 199
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 100):0}(現在仕事:対象キャラ:1 - 100)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「何か探してるの……？　えへへ、ユニコーンにお任せ」
				CASE "土産物屋"
					KSTR:(K++) = 「お土産……ゆーちゃんのぬいぐるみも、あるよ……えへへ」
				CASE "食事処"
					KSTR:(K++) = 「お兄ちゃん、お腹すいた？ ユニコーンが作ってあげるね」
				CASE "装飾品店"
					KSTR:(K++) = 「えへへ……この髪飾り、ユニコーンに似合うかな……？」
				CASE "直売所"
					KSTR:(K++) = 「新鮮なお野菜、どうかな……？　えへへ」
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置
;状況で分岐

IF CFLAG:対象キャラ:飲み会
	;飲み会中
	KSTR:(K++) = 「えへへ……じゅーすおいしい……お兄ちゃんも飲む……？」
ELSEIF CFLAG:対象キャラ:睡眠
	;ダウン・睡眠中
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「ぅぅ……体が動かないの……お兄ちゃん、そばにいて……」
;	ELSEIF 陥落チェック_性的(対象キャラ) && RAND:3
;		;寝言で甘えさせたい場合
;		KSTR:(K++) = 「……ん……お兄ちゃん……もっと……んぅ……」
	ELSE
		KSTR:(K++) = 「すぅ……すぅ……ゆーちゃん……えへへ……すぅ……」
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中
	;デートの相手のキャラ番号 + 100が入っている
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	KSTR:(K++) = 「えへへ……お兄ちゃんとおでかけ……ゆーちゃんもいっしょだよ」
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	;一緒に遊ぶ中
	KSTR:(K++) = 「お兄ちゃんとあそぶの、たのしいね……えへへ」
ELSEIF CFLAG:対象キャラ:同行
	;同行中
	KSTR:(K++) = 「お兄ちゃん、どこに行くの……？ ユニコーンもついていく……」
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;一緒に隠密中
	KSTR:(K++) = 「しーっ……ゆーちゃんも静かにね……えへへ」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	;あなたが隠れていて、キャラはあなたに気づいていない
	KSTR:(K++) = 「ゆーちゃん、お兄ちゃんどこ行っちゃったんだろうね……」
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;キャラの野外オナニー中
	KSTR:(K++) = 「……んっ……お兄ちゃん……お兄ちゃんの……はぅ……」
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「お兄ちゃんはユニコーンの一番のお友達……えへへ、ゆーちゃんの次にね」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「えへへ……お兄ちゃんとお話するの、好きだよ」
			CASEELSE
				KSTR:(K++) = 「……あの……ゆーちゃんが、挨拶しなさいって……」
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「お兄ちゃんのそばにいると……安心するの。えへへ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「お兄ちゃんは……優しいね。ゆーちゃんもそう言ってるよ」
			CASEELSE
				KSTR:(K++) = 「…………（ゆーちゃんをぎゅっと抱きしめている）」
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「お兄ちゃんのこと考えると……胸がぽかぽかするの……えへへ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「あのね……今日もお兄ちゃんに会えて嬉しいの……えへへ」
			CASEELSE
				KSTR:(K++) = 「……ゆーちゃん、あの人のこと見てるの。……べ、別にユニコーンは見てないよ……？」
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「お兄ちゃんの匂い……嗅ぐだけで、おまんこがきゅってなっちゃう……えへへ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「お兄ちゃんが近くにいると……なんか、体があつくなるの……」
			CASEELSE
				KSTR:(K++) = 「…………（なぜか目を逸らしている）」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_3518(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;基本的にWAIT系列は使わないことを推奨

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「……あの……はじめまして……ユニコーン……っていうの……」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「……えっと……ゆーちゃんが、お話してみたらって……」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「あ……お兄ちゃん。えへへ、今日もいいお天気だね」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「えへへ……お兄ちゃんとお話するの、楽しいよ。ゆーちゃんもそう思うよね？」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「お兄ちゃんはね、ユニコーンの大事な大事なお友達なの。ゆーちゃんの次にね……えへへ」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「ユニコーンにとって、お兄ちゃんとゆーちゃんは特別なの。ずーっと一緒にいようね？」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


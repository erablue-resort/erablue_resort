			CASEELSE
				KSTR:(K++) = 「お兄ちゃん、すごい……！　魔法の理屈、もう理解しちゃったの……？　ユニコーン、お兄ちゃんのこと尊敬しちゃうな……」
		ENDSELECT
	CASE 3
		;機械知識
	CASE 4

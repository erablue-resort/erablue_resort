;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「XXXX」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
	;-2の場合は会話出来なかった扱いなので何も言わないのがいいかも
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_3518_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TALENT:対象キャラ:恋慕
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
			KSTR:(K++) = 「お兄ちゃん……えっと……ユニコーン、もうお話することなくなっちゃった……えへへ、でもお兄ちゃんのそばにいるだけで幸せだから……」
		CASE -1
			;失敗
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ん……ごめんね、ユニコーン、うまくお話できなかった……。でも、お兄ちゃんが聞いてくれるだけで嬉しいの……」
				CASE 1
					KSTR:(K++) = 「あ、あれ……ユニコーン、何を言おうとしてたんだっけ……ごめんね、お兄ちゃん……」
				CASE 2
					KSTR:(K++) = 「う……ユニコーン、ちょっと緊張しちゃって……。お兄ちゃんの前だと、ドキドキして言葉が出てこないの……」
			ENDSELECT
		CASE 0
			;通常成功
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「えへへ……お兄ちゃんとお話するの、楽しいな。ゆーちゃんも嬉しそうだよ……」
				CASE 1
					KSTR:(K++) = 「お兄ちゃん……ユニコーンね、お兄ちゃんと一緒にいる時間が一番好き……。こうしてお話してるだけで、心がぽかぽかするの」
				CASE 2
					KSTR:(K++) = 「あのね、お兄ちゃん……今日ね、ゆーちゃんとお散歩してたら、お花が咲いてたの。お兄ちゃんにも見せてあげたいな……」
			ENDSELECT
		CASEELSE
			;大成功
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「お兄ちゃん……！　えへへ、今日のお話、すっごく楽しかった……！　ユニコーン、お兄ちゃんのこと、もっともっと知りたいな……」
				CASE 1
					KSTR:(K++) = 「お兄ちゃん、ユニコーンのこと……そんな風に思ってくれてたの……？　えへへ……嬉しくて、泣いちゃいそう……」
				CASE 2
					KSTR:(K++) = 「お兄ちゃんとお話してると、時間があっという間に過ぎちゃうの……。ずっと、こうしていたいな……お兄ちゃん……」
			ENDSELECT
	ENDSELECT
ELSEIF TALENT:対象キャラ:セフレ
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			KSTR:(K++) = 「あ……ユニコーン、もうお話のネタ、なくなっちゃったかも……。でも、お兄ちゃんのそばにいるだけでも……いい？」
		CASE -1
			KSTR:(K++) = 「ん……ごめんね、ユニコーン、うまく言えなくて……。お兄ちゃんの前だと、変にドキドキしちゃうの……」
		CASE 0
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「えへへ……お兄ちゃんとお話するの、好きだよ。……ゆーちゃんも、お兄ちゃんのこと好きみたい」
				CASE 1
					KSTR:(K++) = 「お兄ちゃん……ユニコーン、最近お兄ちゃんのこと考えてると、胸がきゅってなるの……なんでだろう……」
			ENDSELECT
		CASEELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「お兄ちゃん……今日のお話、とっても楽しかった。ユニコーン、お兄ちゃんといると笑顔になれるの……えへへ」
				CASE 1
					KSTR:(K++) = 「えへへ……お兄ちゃんと気持ちが通じ合えた気がする……。こういう時間、もっと欲しいな……」
			ENDSELECT
	ENDSELECT
ELSE
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			KSTR:(K++) = 「あ……ユニコーン、お話すること……もうないかも。ごめんなさい……」
		CASE -1
			KSTR:(K++) = 「あぅ……ユニコーン、お話するの、ちょっと苦手で……ごめんなさい……」
		CASE 0
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「えへへ……お話、楽しかったです。……ゆーちゃんも、楽しかったって……」
				CASE 1
					KSTR:(K++) = 「ユニコーン……あんまりお話得意じゃないけど……%CALLNAME:MASTER%さんとなら、楽しいかも……」
			ENDSELECT
		CASEELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「わぁ……%CALLNAME:MASTER%さん、すごくお話が上手なんですね……。ユニコーン、もっとお話してみたいです……」
				CASE 1
					KSTR:(K++) = 「えへへ……%CALLNAME:MASTER%さんとのお話、とっても楽しかった……。また、お話してくれますか……？」
			ENDSELECT
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM301_お茶を淹れる

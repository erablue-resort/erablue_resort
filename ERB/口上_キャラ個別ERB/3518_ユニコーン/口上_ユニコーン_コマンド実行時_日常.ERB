#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「あ……お兄ちゃん、ちょっと熱かったかも……。でも、ユニコーンのために淹れてくれたの、嬉しいよ……」
			CASE 1
				KSTR:(K++) = 「ん……ちょっと苦い……かも。でもね、お兄ちゃんが淹れてくれたから、ユニコーン、全部飲むよ……？」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「わぁ……お兄ちゃん、おいしい……。えへへ、お兄ちゃんのお茶、あったかくて好き……」
			CASE 1
				KSTR:(K++) = 「ありがとう、お兄ちゃん……。ユニコーンね、お兄ちゃんが淹れてくれたお茶、一番好きなの……」
			CASE 2
				KSTR:(K++) = 「えへへ……おいしいよ。ゆーちゃんにも飲ませてあげたいな……あ、ぬいぐるみだから飲めないか……えへへ」
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「わぁ……！　お兄ちゃん、すっごくおいしい……！　ユニコーン、幸せ……えへへ、こんなにおいしいお茶、初めてかも……」
			CASE 1
				KSTR:(K++) = 「お兄ちゃん……このお茶、とってもいい香り……。イラストリアス姉ちゃんのお茶にも負けてないよ……！」
			CASE 2
				KSTR:(K++) = 「おいしい……すごくおいしい……！　お兄ちゃん、ユニコーンにも淹れ方教えてほしいな……。そしたら、今度はユニコーンがお兄ちゃんに淹れてあげるの……」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


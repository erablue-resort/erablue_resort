	;風呂を覗いた時  0:湯船に浸かる姿  1:体を洗う姿
;RFLAG:コマンド結果受渡し変数４
	;野外オナニー時、部位が入る  0:Ｃ 1:Ｖ 2:Ａ 3:Ｂ
@KOJO_COM_3518_404(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 1
		;脱衣所・更衣室から反対側
		SELECTCASE CFLAG:PLAYER:現在位置
			CASE 7, 8
				; 服を脱いでいる様子が見える…
				KSTR:(K++) = ユニコーンがそっと服を脱いでいる。小さな体を隠すように縮こまりながら、ゆーちゃんを抱きしめて何か話しかけている……
				KSTR:(K++) = 「ゆーちゃん、あっち見ててね……。ユニコーン、着替えるから……」
			CASE 9, 11
				IF RFLAG:コマンド結果受渡し変数３
					; 石鹸で体を洗っている様子が見える…
					KSTR:(K++) = ユニコーンが丁寧に体を洗っている。小さな手で泡を立てながら、時折鼻歌を歌っている……
					KSTR:(K++) = 「ふんふーん……♪　えへへ、ゆーちゃん、泡がいっぱいだね……」
				ELSE
					; 裸で湯船に浸かっている様子が見える…
					KSTR:(K++) = ユニコーンが気持ちよさそうにお湯に浸かっている。ほんのり頬を赤らめて、幸せそうに目を細めている……
					KSTR:(K++) = 「はぁ……あったかい……。ゆーちゃんも入りたい……？　あ、ぬいぐるみだからだめか……えへへ」
				ENDIF
			CASE 13, 14
				; 水着に着替えている様子が見える…
				KSTR:(K++) = ユニコーンが水着に着替えようとしている。恥ずかしそうに周りを気にしながら、ゆーちゃんに目隠しをさせている……
				KSTR:(K++) = 「ゆーちゃん、見ちゃだめだよ……ユニコーン、着替えるから……。……あ、えっと、この紐どこに通すの……？」
		ENDSELECT
	CASE 2
		;脱衣所・更衣室に隠れて
		SELECTCASE CFLAG:PLAYER:現在位置
			CASE 7, 8
				KSTR:(K++) = ユニコーンが服を脱いでいるのが見える。恥ずかしそうに体を隠しながら、小さな声でゆーちゃんに話しかけている……
				KSTR:(K++) = 「ユニコーンの体、小さいよね……。イラストリアス姉ちゃんみたいになれたらいいのに……」
			CASE 9, 11
				IF RFLAG:コマンド結果受渡し変数３
					KSTR:(K++) = ユニコーンが体を洗っている。丁寧に泡を立てて、一つ一つ洗っている姿が見える……
					KSTR:(K++) = 「えへへ……いい匂い……。お兄ちゃんにも、いい匂いだねって言ってもらえるかな……」
				ELSE
					KSTR:(K++) = ユニコーンがお湯に身を沈めている。小さく「はぁ」と息をつきながら、のんびりと湯船を楽しんでいる……
					KSTR:(K++) = 「はぁ……お湯、気持ちいい……。お兄ちゃんも一緒に入れたらいいのに……あ、だめだよね……えへへ」
				ENDIF
			CASE 13, 14
				KSTR:(K++) = ユニコーンが水着に着替えている。小さな体に水着を合わせながら、鏡を見て首をかしげている……
				KSTR:(K++) = 「んー……この水着、ちょっとぶかぶかかな……。ユニコーン、もうちょっと大きくなったら似合うかな……」
		ENDSELECT
	CASE 3
		;野外オナニーorゆきずりセックス
		IF IS_野外オナニー中(対象キャラ)
			IF TCVAR:対象キャラ:野外オナニー_絶頂
				;絶頂シーン
				KSTR:(K++) = 「ひぅ゛っ……_H__H_　んぅ゛ぅ゛……っ_H__H__H_　お兄……ちゃ……っ_H_」
				KSTR:(K++) = ユニコーンが小さく体を震わせ、顔をゆーちゃんに埋めながら絶頂を迎えている……
			ELSE
				;オナニーシーン
				IF ABL:対象キャラ:(TCVAR:対象キャラ:野外オナニー_部位) > 4
					KSTR:(K++) = 「んっ……_H_　は゛ぁ……っ_H_　お兄ちゃん……お兄ちゃんの……こと考えたら……止まらないの……っ_H__H_」
					KSTR:(K++) = ユニコーンが息を荒くしながら、お兄ちゃんの名前を繰り返している……
				ELSEIF ABL:対象キャラ:(TCVAR:対象キャラ:野外オナニー_部位) > 2
					KSTR:(K++) = 「ん……_H_　ふ……_H_　変な感じ……お兄ちゃん……_H_　ユニコーン、おかしくなっちゃいそう……_H_」
					KSTR:(K++) = ユニコーンが顔を赤くして、ゆーちゃんを抱きしめながら自分を慰めている……
				ELSE
					KSTR:(K++) = 「ん……これ……なんだか変な気持ち……。お兄ちゃんに触られた時と……似てる……_H_」
					KSTR:(K++) = ユニコーンがおずおずと自分の体に触れている。慣れない手つきで、時折びくっと体を震わせている……
				ENDIF
			ENDIF
		ELSEIF IS_ゆきずりセックス中(対象キャラ)
			;ゆきずりセックスを覗き見
			KSTR:(K++) = 「あ……っ_H_　ん゛……っ_H_　お兄ちゃんじゃないのに……体が……勝手に……_H__H_」
			KSTR:(K++) = ユニコーンが知らない相手に体を許している。潤んだ瞳はどこか虚ろで、時折「お兄ちゃん……」と呟いている……
		ENDIF
	CASE 4
		;温泉施設の覗き用場所で
		SELECTCASE CFLAG:対象キャラ:現在位置
			CASE 702, 802
				; 服を脱いでいる様子が見える…
				KSTR:(K++) = ユニコーンが温泉の脱衣所で服を脱いでいる。小さな体を恥ずかしそうに隠しながら、手早く着替えようとしている……
			CASE 703, 803
				; 石鹸で体を洗っている様子が見える…
				KSTR:(K++) = ユニコーンが丁寧に体を洗っている。泡だらけの手で小さな体を一生懸命洗いながら、楽しそうに鼻歌を歌っている……
			CASE 704, 804
				; 裸で湯船に浸かっている様子が見える…
				KSTR:(K++) = ユニコーンが湯船に肩まで浸かって、幸せそうに目を閉じている。小さな顔がほんのりと桜色に染まっている……
			CASE 705, 805
				; 裸で変わり湯に浸かっている様子が見える…
				KSTR:(K++) = ユニコーンが珍しそうに変わり湯を眺めている。おそるおそる手を入れて、匂いを嗅いだり色を見たりしている……
			CASE 706, 806
				; サウナで汗を流している様子が見える…
				KSTR:(K++) = ユニコーンがサウナで小さくなっている。暑さに耐えきれないのか、頬が真っ赤になってぼんやりしている……
			CASE 707, 807
				; 裸で露天風呂に浸かっている様子が見える…
				KSTR:(K++) = ユニコーンが露天風呂で空を見上げている。湯気に包まれた小さな体が、月明かりに照らされて幻想的に見える……
			CASE 708, 808
				; 裸で壺湯に浸かっている様子が見える…
				KSTR:(K++) = ユニコーンが壺湯にすっぽり収まっている。小さな体にぴったりの大きさなのか、とても居心地がよさそうにしている……
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM405 観察する
;--------------------------------------------------
@KOJO_COM_3518_405(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		;誰も隠密してない
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = ユニコーンがゆーちゃんを抱きしめながら、穏やかに過ごしている。時折ゆーちゃんに話しかけている姿が見える……
			CASE 1
				KSTR:(K++) = ユニコーンがひとりで本を読んでいる。ページをめくるたびにゆーちゃんにも見せてあげているようだ……
		ENDSELECT
	CASE 1
		;誰かが隠密している
		KSTR:(K++) = ユニコーンが少し不安そうにあたりを見回している。ゆーちゃんをぎゅっと抱きしめて、何か気配を感じているようだ……
	CASE 10
		;起床までの残り時間
		;寝言とか言う感じ
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS > 180
				;3時間以上
				KSTR:(K++) = ユニコーンがゆーちゃんを抱きしめてすやすやと眠っている。安らかな寝顔を見せている……
				KSTR:(K++) = 「すぅ……すぅ……ゆーちゃん……おやすみ……」
			CASE IS > 90
				;3時間以下
				KSTR:(K++) = ユニコーンが穏やかに眠っている。時折寝返りを打ちながら、何か夢を見ているようだ……
				KSTR:(K++) = 「んぅ……お兄ちゃん……えへへ……」
			CASE IS > 30
				;90分以下
				KSTR:(K++) = ユニコーンの眠りが少し浅くなってきている。もそもそと動きながら、小さく寝言を呟いている……
				KSTR:(K++) = 「お兄ちゃん……一緒にいて……ね……」
			CASEELSE
				;30分以下
				KSTR:(K++) = ユニコーンがもうすぐ起きそうだ。まぶたがぴくぴくと動いて、小さくあくびをしている……
				KSTR:(K++) = 「んー……ふぁ……あと五分……ゆーちゃん……」
		ENDSELECT
	CASE 11
		;睡眠＋ダウン、スコアの多さで分岐
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS >= 400
				;めちゃくちゃにされてる
				KSTR:(K++) = ユニコーンがぐったりと眠っている。体のあちこちに痕が残り、涙の跡が頬に見える。それでもゆーちゃんだけはしっかり抱きしめている……
			CASE IS >= 20
				;結構がっつり
				KSTR:(K++) = ユニコーンが疲れ切った様子で眠っている。肌が上気して汗ばんでいるが、表情はどこか満ち足りている……
			CASEELSE
				;体力尽きたけど割と穏やか
				KSTR:(K++) = ユニコーンが静かに眠っている。少し疲れた様子だが、穏やかな寝顔を見せている……
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM414 写真を撮る
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数３ 写真のシチュエーション
@KOJO_COM_3518_414(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE 1
		;寝てる、相手は気づいてない
		KSTR:(K++) = ユニコーンが穏やかに眠っている。ゆーちゃんを抱きしめたまま、小さな寝息を立てている。シャッター音にも気づかない深い眠り……
	CASE 2
		;ハメ撮り、相手は気づいている
		IF TCVAR:対象キャラ:前ターン絶頂
			;絶頂直後
			KSTR:(K++) = 「ひぅ……っ_H_　やだ……撮らないで……_H_　ユニコーン……こんな顔……見せたくない……_H__H_」
		ELSE
			KSTR:(K++) = 「え……お兄ちゃん、撮るの……？　やだ……恥ずかしい……_H_　……でも、お兄ちゃんだけだよ……見ていいの……」
		ENDIF
	CASE 3
		;覗き、相手は気づいてない
		;覗きの口上に飛ばす
		TRYCALLFORM KOJO_COM_{NO:対象キャラ}_404(対象キャラ)
		RETURN 0
	CASE 4
		;仕事中、相手は気づいている
		SELECTCASE 現在仕事:対象キャラ:0
			CASE 1
				;雑務
				KSTR:(K++) = 「あ、お兄ちゃん……写真……？　えへへ、ユニコーン、お掃除してるところだよ。ちゃんと頑張ってるよ……？」
			CASE 2
				;常駐業務
				IF GETPLACENAME(CFLAG:対象キャラ:現在マップ種別, CFLAG:対象キャラ:現在位置) == GETPLACENAME(現在仕事:対象キャラ:1 / 10000, 現在仕事:対象キャラ:1 % 10000)
					KSTR:(K++) = 「あ……お兄ちゃん、写真……？　ユニコーン、ちゃんとお仕事してるよ……えへへ、いい子でしょ……？」
				ELSE
					KSTR:(K++) = 「え、写真……？　ユニコーン、今はお仕事のお休み中だよ……。えへへ、ゆーちゃんと一緒に撮って……」
				ENDIF
			CASE 3
				;秘書
				KSTR:(K++) = 「お兄ちゃん……秘書のユニコーンを撮るの……？　えへへ、ちゃんとお仕事できてるか心配だけど……頑張ってるよ……」
			CASE 4
				;宣伝
				KSTR:(K++) = 「あ……宣伝のお仕事中に写真……？　えへへ、ユニコーン、笑顔でいいかな……？　はい、ぴーす……」
			CASE 5
				;訓練
				IF CFLAG:対象キャラ:現在マップ種別 == 0 && CFLAG:対象キャラ:現在位置 == 308
					KSTR:(K++) = 「お兄ちゃん……訓練中だよ……？　えへへ、ユニコーンが頑張ってるところ、撮ってくれるの……？　もっと頑張るね……！」
				ELSE
					KSTR:(K++) = 「あ、お兄ちゃん……訓練のお休み中だけど、写真……？　えへへ、ゆーちゃんも一緒にね……」
				ENDIF
		ENDSELECT
	CASE 5
		;日常のスナップショット、相手は気づいている
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「えっ……お兄ちゃん、急に撮らないで……。えっと……もう一枚撮るなら……ちゃんとポーズするから……えへへ」
			CASE 1
				KSTR:(K++) = 「あ……写真？　えへへ、ゆーちゃんも一緒に撮ろうね。はい、ちーず……。……えへへ、うまく笑えたかな……」
			CASE 2
				KSTR:(K++) = 「お兄ちゃん、ユニコーンの写真……後で見せてね？　ちゃんと可愛く撮れてる……？」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


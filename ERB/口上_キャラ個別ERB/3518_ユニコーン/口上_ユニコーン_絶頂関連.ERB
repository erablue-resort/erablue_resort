@KOJO_ORGASM_通常絶頂_3518(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;NOWEX:対象キャラ:Ｃ絶頂, NOWEX:対象キャラ:Ｖ絶頂, NOWEX:対象キャラ:Ａ絶頂, NOWEX:対象キャラ:Ｂ絶頂, NOWEX:対象キャラ:Ｓ絶頂
	;それぞれの絶頂強度が入っている
	;1:絶頂(10000超え)  2:強絶頂(20000超え)  3:超強絶頂(30000超え)  4:最強絶頂(40000超え)  5:究極絶頂(50000超え)
	;この強度の名前ダサいから変えたい……

;TCVAR:対象キャラ:うふふ中Ｃ絶頂累積, TCVAR:対象キャラ:うふふ中Ｖ絶頂累積, TCVAR:対象キャラ:うふふ中Ａ絶頂累積, TCVAR:対象キャラ:うふふ中Ｂ絶頂累積, TCVAR:対象キャラ:うふふ中Ｓ絶頂累積
;うふふ終了でリセットされる、絶頂回数を累積カウントする変数
;当然非うふふ中のセクハラなどでは変動しないので注意

CALL 口上変数初期化

相手キャラ番号 = 絶頂相手算出(対象キャラ)

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	;多部位同時絶頂判定
	LOCAL:1 = 0
	FOR LOCAL, 0, 5
		SIF NOWEX:対象キャラ:LOCAL
			LOCAL:1 += 1
	NEXT
	SELECTCASE LOCAL:1
		CASE 2
			;2部位同時絶頂
			SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「ひゃっ……！？_H_　ふ、ふたつ一緒にっ_H_　きちゃった……っ_H_　お兄ちゃ……っ_H_　ユニコーンっ_H_　もうだめ……っ_H_」
			CASE 1
				KSTR:(K++) = 「あっ_H_　あっ_H_　あっ_H_　いっぺんにっ_H_　きもちいのがっ_H_　ぶわって……っ_H_　おにぃちゃん……っ_H_」
			CASE 2
				KSTR:(K++) = 「ふぁっ……！_H_　やだっ_H_　同時にっ_H_　二つもっ_H_　とろけちゃ……っ_H_　あ、あたまっ_H_　まっしろ……っ_H_」
			ENDSELECT
		CASE 3
			;3部位同時絶頂
			SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「あっ_H_　むりっ_H_　むりぃっ_H_　ぜんぶっ_H_　いっぺんにっ_H_　きちゃってっ_H_　ユニコーン……こわれ……っ_H__H_」
			CASE 1
				KSTR:(K++) = 「ひっ……あっ……！_H_　おにぃちゃっ_H_　からだぜんぶっ_H_　きもちよすぎっ_H_　とまんない……っ_H_　イくっ……！_H__H_」
			ENDSELECT
		CASE 4
			;4部位同時絶頂
			SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「っ……！？_H_　あっ_H_　あっ_H_　あっ_H_　あっ_H_　なにもっ_H_　わかんなく……なっ……て……っ_H__H_　お兄……ちゃ……_H__H_」
			CASE 1
				KSTR:(K++) = 「ぁ……っ_H__H_　もう……っ_H_　ユニ……コーン……っ_H_　きもちよすぎて……っ_H_　おかしく……なっちゃう……っ_H__H__H_」
			ENDSELECT
		CASE 5
			;全部位同時絶頂、理論上は存在しうる
			KSTR:(K++) = 「っ……！_H__H_　――――_H__H__H_　…………っ_H__H__H_　ゆー……ちゃ……おにぃ……ちゃ……_H__H__H__H_」
		CASEELSE
			;1部位絶頂
			IF NOWEX:対象キャラ:Ｃ絶頂
				SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ぁっ_H_　くるっ_H_　あたまの中がっ_H_　ぱぁって……っ_H_　お兄ちゃん……ユニコーン……イっちゃう……っ_H__H_」
				CASE 1
					KSTR:(K++) = 「おにぃちゃっ_H_　イくっ_H_　イくのっ_H_　きもちよくて……っ_H_　あっ_H_　あっ……だめ……っ_H__H_」
				CASE 2
					KSTR:(K++) = 「ひぁっ_H_　だめっ_H_　おかしくなっちゃ……っ_H_　イくっ_H_　きもちよすぎてっ_H_　イっちゃう……っ_H__H_」
				ENDSELECT
			ELSEIF NOWEX:対象キャラ:Ｖ絶頂
				SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ふぁっ_H_　なかっ_H_　なかがっ_H_　きゅーってっ_H_　なかイっちゃ……っ_H_　お兄ちゃん……っ_H__H_」
				CASE 1
					KSTR:(K++) = 「おにぃちゃんっ_H_　おまんこがっ_H_　とろとろになって……っ_H_　きもちよすぎっ_H_　あっ……あっ……っ_H__H_」
				CASE 2
					KSTR:(K++) = 「やだっ_H_　お兄ちゃんのでっ_H_　なかがっ_H_　とけちゃ……っ_H_　イっちゃうっ_H_　おちんちんでイっちゃう……っ_H__H_」
				ENDSELECT
			ELSEIF NOWEX:対象キャラ:Ａ絶頂
				SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ひぅっ_H_　おしりっ_H_　おしりでっ_H_　イっちゃ……っ_H_　だめなのにっ_H_　きもちいの……っ_H__H_」
				CASE 1
					KSTR:(K++) = 「やっ_H_　おしりなのにっ_H_　きもちいっ_H_　なんで……っ_H_　ユニコーンっ_H_　おしりでイく……っ_H__H_」
				CASE 2
					KSTR:(K++) = 「あっ_H_　うしろがっ_H_　へんっ_H_　なにかっ_H_　でちゃ……っ_H_　おしりで……イっちゃう……っ_H__H_」
				ENDSELECT
			ELSEIF NOWEX:対象キャラ:Ｂ絶頂
				SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「あっ_H_　あぁっ_H_　おむね……ちっちゃいのにっ_H_　きもちよくなっちゃっ……っ_H_　イくぅ……っ_H__H_」
				CASE 1
					KSTR:(K++) = 「ひゃぁっ_H_　ちくびっ_H_　だめっ_H_　おっぱいがっ_H_　じんじんしてっ_H_　とけちゃう……っ_H__H_」
				CASE 2
					KSTR:(K++) = 「やぁっ_H_　こんなっ_H_　おむねだけでっ_H_　ユニコーンっ_H_　イかされちゃう……っ_H__H_」
				ENDSELECT
			ELSEIF NOWEX:対象キャラ:Ｓ絶頂
				SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「ぁ……っ_H_　さわられただけで……っ_H_　からだがびくびくってっ_H_　とまんない……っ_H__H_」
				CASE 1
					KSTR:(K++) = 「ひぅっ_H_　お肌がっ_H_　ぴりぴりしてっ_H_　イっちゃうっ_H_　さわるだけで……っ_H__H_」
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)


				KSTR:(K++) = 平らなおなかの上でとろりと流れる精液を%CALLNAME:対象キャラ%はぼんやりと見つめている。子宮のある場所に精液がかかっているのを、まだ理解していないようだった……
			ENDSELECT
		CASE 7
			;背中
			SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ひゃっ_H_　せなかにっ……_H_　お兄ちゃん、うしろに出したの……？_H_　ぬるぬるがせすじを伝ってる……_H_」
				KSTR:(K++) = 背骨に沿って流れ落ちる精液のぬめりに、%CALLNAME:対象キャラ%は小さく身をよじった。見えない場所に出された不安と、背中を汚される羞恥に耳まで赤くなっている……
			CASE 1
				KSTR:(K++) = 「あぅ……_H_　背中がぬるぬる……_H_　お兄ちゃんの……こんなにいっぱい……_H_　拭いてくれないと……動けないよぅ……_H_」
				KSTR:(K++) = 華奢な背中に散った精液を、%CALLNAME:対象キャラ%は手の届かないまま困ったように首を傾げた。うつ伏せのまま%CALLNAME:MASTER%に助けを求める姿が、庇護欲を掻き立てる……
			ENDSELECT
		CASE 30
			IF CFLAG:対象キャラ:うふふ
				;うふふ中汎用射精
				SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「ぁ……っ_H_　お兄ちゃん……出したの……？_H_　いっぱい……でたね……_H_」
				CASE 1
					KSTR:(K++) = 「ん……っ_H_　あったかい……_H_　お兄ちゃん……きもちよかった……？_H_　えへへ……_H_」
				ENDSELECT
			ELSE
				;非うふふ時の射精、逆セクハラなど
				SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「ひゃっ！？_H_　お、お兄ちゃんっ！？_H_　なにが……え……これ……精液……？」
				CASE 1
					KSTR:(K++) = 「えっ……_H_　お兄ちゃん……こんなところで……？_H_　ユニコーン……びっくりしちゃったよ……」
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF


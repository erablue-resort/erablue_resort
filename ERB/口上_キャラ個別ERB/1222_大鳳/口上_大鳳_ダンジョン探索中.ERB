;****************************************
;ダンジョン探索中に表示される文章
;****************************************
;・使い方
;「1222」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;メッセージ欄に表示されるため、一行を短めにしている
;****************************************

;--------------------------------------------------
;「仲間と会話」ボタン押下時
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_1222(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル

;簡単に何度も見られるので、条件分岐やランダム化で複数パターンの登録を推奨

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE 関係レベル
	CASE IS < 関係閾値:2
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「何か？　探索中の無駄口は感心しませんわね」
			CASE 1
				KSTR:(K++) = 「付き合って差し上げているのですから、足手まといにならないでくださいね」
			CASE 2
				KSTR:(K++) = 「この辺り、嫌な匂いがしますわ。気をつけて」
		ENDSELECT
	CASE IS < 関係閾値:4
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「疲れていません？　少し休憩しましょうか」
			CASE 1
				KSTR:(K++) = 「後ろは任せてください。こう見えて、敵の気配には敏感なんです」
			CASE 2
				KSTR:(K++) = 「なかなか頼もしいじゃありませんか。見直しましたわ」
		ENDSELECT
	CASEELSE
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の背中は大鳳が守りますわ。誰にも触れさせませんから_H_」
			CASE 1
				KSTR:(K++) = 「うふふ、%CSTR:対象キャラ:二人称%と一緒なら、ダンジョンも旅行みたいなものですわ～」
			CASE 2
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%に傷ひとつでもつけたら……相手が誰でも、許しませんわよ？」
		ENDSELECT
ENDSELECT

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0,,対象キャラ)


;--------------------------------------------------
;奥義発動時
;--------------------------------------------------
@KOJO_DUNGEON_奥義発動時_1222(対象キャラ, 使用奥義名)
#DIMS 使用奥義名
#DIM 対象キャラ
;「（キャラ名）の奥義：（奥義名）！」よりも前に表示される

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

SELECTCASE RAND:3
	CASE 0
		KSTR:(K++) = 「薙ぎ払って差し上げますわ！」
	CASE 1
		KSTR:(K++) = 「大鳳の本気、とくとご覧なさい！」
	CASE 2
		KSTR:(K++) = 「散りなさい、大鳳の翼の下で！」
ENDSELECT

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0,,対象キャラ)


;--------------------------------------------------
;トドメ時
;--------------------------------------------------
@KOJO_DUNGEON_トドメ時_1222(対象キャラ)
#DIM 対象キャラ

;行動の結果（◯◯は倒れた！など）の後に表示される
;複数攻撃時は一人でも倒していれば表示される
;口上用トドメフラグ には倒した敵の数が入っている

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

IF 口上用トドメフラグ > 1
	KSTR:(K++) = 「うふふ、まとめて片付きましたわね」
ELSE
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「海の藻屑にでもおなりなさい！」
		CASE 1
			KSTR:(K++) = 「良い手応えですわ」
		CASE 2
			KSTR:(K++) = 「邪魔ですわ。そこをおどきなさい」
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ, , , , 対象キャラ)



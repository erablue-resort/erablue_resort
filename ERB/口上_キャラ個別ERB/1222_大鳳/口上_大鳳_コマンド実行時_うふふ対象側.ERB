;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「1222」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************

;--------------------------------------------------
;COM6_胸愛撫
;--------------------------------------------------
;取得快楽：Ｂ
;大鳳はＢ感度-1（鈍感）
@KOJO_COM_1222_6(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	;初回実行（コマンド初回フラグ はされた側の記録。コマンド終了後に保存されるので、初回はまだ含まれていない）
	IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-6-") < 0 && (TALENT:対象キャラ:恋慕 || TALENT:対象キャラ:セフレ)
		KSTR:(K++) = 「でしょうね～。いつもいつも、触りたそうにこっちを見ていましたものね～」
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は呆れ顔のまま、自分から胸を%CALLNAME:MASTER%の手のひらへ押し付けてきた。
		KSTR:(K++) = 「はいはい、どうぞ。お待ちかねの大鳳の胸ですわよ？_H_」
	ELSEIF TALENT:対象キャラ:恋慕
		SELECTCASE CUP:対象キャラ:快Ｂ
			;各部位の累積が10000で絶頂
			CASE IS > 10000
				;即絶頂
				KSTR:(K++) = 「胸、だけで……いっちゃ、う……っ_H_」
			CASE IS > 6000
				;かなり感じている
				KSTR:(K++) = 「ん、ぁ……%CSTR:対象キャラ:二人称%の手、なんだか……熱い、ですわ……_H_」
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 「うふふ、手からこぼれてしまいますわよ？　両手で、しっかり_H_」
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 「ん……くすぐったいですわ。大鳳の胸、鈍いって言いましたでしょう？」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		KSTR:(K++) = 「そんなに夢中になって。本当に単純な男ですこと」
	ELSE
		;言いなり・特殊言いなり
		IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
			KSTR:(K++) = 「触るだけなら、好きになさい。何も感じませんから」
		ELSE
			;性交渉をお願いする（COM353）で仕方なく応じている時など
			KSTR:(K++) = 「好きなだけ触ればいいですわ。どうせ、ずっとそうしたかったんでしょう？」
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

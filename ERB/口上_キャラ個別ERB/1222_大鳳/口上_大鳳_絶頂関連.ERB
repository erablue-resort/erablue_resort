;****************************************
;キャラの絶頂後、あなたの射精への反応など
;****************************************
;・使い方
;「1222」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;通常絶頂時
;--------------------------------------------------
@KOJO_ORGASM_通常絶頂_1222(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;NOWEX:対象キャラ:Ｃ絶頂, NOWEX:対象キャラ:Ｖ絶頂, NOWEX:対象キャラ:Ａ絶頂, NOWEX:対象キャラ:Ｂ絶頂, NOWEX:対象キャラ:Ｓ絶頂
	;それぞれの絶頂強度が入っている
	;1:絶頂(10000超え)  2:強絶頂(20000超え)  3:超強絶頂(30000超え)  4:最強絶頂(40000超え)  5:究極絶頂(50000超え)

CALL 口上変数初期化

相手キャラ番号 = 絶頂相手算出(対象キャラ)

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	;多部位同時絶頂判定
	LOCAL:1 = 0
	FOR LOCAL, 0, 5
		SIF NOWEX:対象キャラ:LOCAL
			LOCAL:1 += 1
	NEXT
	SELECTCASE LOCAL:1
		CASE 2
			;2部位同時絶頂
			KSTR:(K++) = 「あっ、あぁっ……！　いっぺんに、なんて……ずるい、ですわ……っ_H_」
		CASE 3 TO 5
			;3部位以上同時絶頂
			KSTR:(K++) = 「ひぁっ、だめ、ぜんぶ、ぜんぶきちゃ……っ！_H_」
			KSTR:(K++) = 　%CALLNAME:対象キャラ%の長い髪が乱れ、白い背中が大きく反り返った。
		CASEELSE
			;1部位絶頂
			IF NOWEX:対象キャラ:Ｃ絶頂
				KSTR:(K++) = 「んっ……！　あ、はぁ……そこ、弱いんですの……_H_」
			ELSEIF NOWEX:対象キャラ:Ｖ絶頂
				KSTR:(K++) = 「あっ、あぁぁっ……！　奥、奥まで……っ_H_」
			ELSEIF NOWEX:対象キャラ:Ａ絶頂
				KSTR:(K++) = 「そっちは、ちが……っ、あぁっ！？_H_」
			ELSEIF NOWEX:対象キャラ:Ｂ絶頂
				KSTR:(K++) = 「胸、だけで……？　うそ、鈍いはずなのに……っ_H_」
			ELSEIF NOWEX:対象キャラ:Ｓ絶頂
				KSTR:(K++) = 「全身が、しびれて……っ、あぁ……_H_」
			ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;調教者の射精時
;--------------------------------------------------
@KOJO_ORGASM_被射精_1222(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;RFLAG:フィニッシュ場所
	;どこに出されたか
;RCVAR:対象キャラ:被射精絶頂の強度
	;１以上だと射精された時にキャラも絶頂
	;現状はフィニッシュ場所が0～3の時しか起こらない
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		;恋慕
		SELECTCASE RFLAG:フィニッシュ場所
			CASE 0
				;膣内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					KSTR:(K++) = 「あっ、なか、熱いの……っ、大鳳も、いっしょに……っ_H_」
				ELSE
					KSTR:(K++) = 「ん……たくさん出ましたわね。うふふ、全部大鳳のものですわ_H_」
				ENDIF
			CASE 1
				;腸内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					KSTR:(K++) = 「お尻に、熱いの……っ、うそ、こんなので……っ_H_」
				ELSE
					KSTR:(K++) = 「そっちに出すなんて……本当に、しょうのない方ですわね」
				ENDIF
			CASE 2
				;口
				IF RCVAR:対象キャラ:精飲フラグ > 1
				;喜んで飲む
					IF RCVAR:対象キャラ:被射精絶頂の強度
						;射精による快楽で絶頂した時
						KSTR:(K++) = 「んくっ、んっ……ぷは。……飲んだだけで、なんて……_H_」
					ELSE
						KSTR:(K++) = 「んっ……こく。うふふ、ごちそうさまでした_H_」
					ENDIF
				ELSEIF RCVAR:対象キャラ:精飲フラグ
				;なんとか飲み込む
					IF RCVAR:対象キャラ:被射精絶頂の強度
						;射精による快楽で絶頂した時
						KSTR:(K++) = 「んぐっ……！　っ、はぁ……飲み込んだら、体が……っ」
					ELSE
						KSTR:(K++) = 「んっ……く。苦いですわ。次は、出す前に言ってくださいな」
					ENDIF
				ELSEIF ABL:対象キャラ:技巧 > 2
				;ティッシュに吐き出す
					KSTR:(K++) = 　%CALLNAME:対象キャラ%は慣れた手つきで口元を押さえ、ティッシュにそっと吐き出した。
					KSTR:(K++) = 「予告もなしに出すなんて、躾がなっていませんわね」
				ELSE
				;吐き出してむせる
					KSTR:(K++) = 「けほっ、こほっ……！　い、いきなり出すなんて……！」
				ENDIF
			CASE 3
				;乳内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					KSTR:(K++) = 「胸の中で、びくびくって……っ、あ、大鳳まで……っ_H_」
				ELSE
					KSTR:(K++) = 「あらあら、谷間がどろどろ。……出しすぎですわよ？_H_」
				ENDIF
			CASE 5
				;顔
				KSTR:(K++) = 「きゃっ……！　もう、人様の顔にこんなに……」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は頬を伝うものを指先で拭いながら、ぶつぶつと文句を並べはじめた。
				KSTR:(K++) = 「毎朝小一時間かけてお化粧しているの、ご存じ？　一応、あなたに見せるためでもあるんですけれど？
				KSTR:(K++) = 　本っ当に、相変わらず常識がないというかなんというか……」
				KSTR:(K++) = 　ぷいとそっぽを向いた%CALLNAME:対象キャラ%の機嫌を取るのに、%CALLNAME:MASTER%はあの手この手を尽くす羽目になった……。
			CASE 6
				;腹
				KSTR:(K++) = 「お腹の上、熱いですわ……。うふふ、いっぱい出ましたわね」
			CASE 7
				;背中
				KSTR:(K++) = 「背中に……？　もう、見えないところに出すなんて」
			CASE 30
				IF CFLAG:対象キャラ:うふふ
					;うふふ中汎用射精
					KSTR:(K++) = 「あら、もう出してしまいましたの？　うふふ、まだまだこれからですわよ？」
				ELSE
					;非うふふ時の射精、逆セクハラなど
					KSTR:(K++) = 「こんなところで出してしまうなんて。……後始末は、ご自分でなさいね？」
				ENDIF
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		;セフレ
		SELECTCASE RFLAG:フィニッシュ場所
			CASE 0
				;膣内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					KSTR:(K++) = 「んっ、あ……っ、中で、なんて……っ、練習だって、言ってますのに……っ_H_」
				ELSE
					KSTR:(K++) = 「はいはい、中ですのね。……後の面倒は、ちゃんと見てくださいね？」
				ENDIF
			CASE 1
				;腸内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					KSTR:(K++) = 「お尻で、なんて……っ、練習にしては、やりすぎ、ですわ……っ_H_」
				ELSE
					KSTR:(K++) = 「はいはい、そっちもですの。……本当に、欲張りな犬ですこと」
				ENDIF
			CASE 2
				;口
				IF RCVAR:対象キャラ:精飲フラグ > 1
				;喜んで飲む
					IF RCVAR:対象キャラ:被射精絶頂の強度
						;射精による快楽で絶頂した時
						KSTR:(K++) = 「んくっ……ぷは。飲んだだけで、なんて……っ、どうなってますの、この体……_H_」
					ELSE
						KSTR:(K++) = 「んっ……こく。はいはい、飲んで差し上げましたわよ」
					ENDIF
				ELSEIF RCVAR:対象キャラ:精飲フラグ
				;なんとか飲み込む
					IF RCVAR:対象キャラ:被射精絶頂の強度
						;射精による快楽で絶頂した時
						KSTR:(K++) = 「んぐっ……！　飲み込んだだけで、こんな……っ」
					ELSE
						KSTR:(K++) = 「んっ……く。苦い。これも練習のうち、ですわね」
					ENDIF
				ELSEIF ABL:対象キャラ:技巧 > 2
				;ティッシュに吐き出す
					KSTR:(K++) = 　%CALLNAME:対象キャラ%は手慣れた様子でティッシュを取り、さっさと吐き出した。
					KSTR:(K++) = 「はい、おしまい。口をゆすいできますわね」
				ELSE
				;吐き出してむせる
					KSTR:(K++) = 「けほっ……！　もう、出すなら出すと言いなさいな」
				ENDIF
			CASE 3
				;乳内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					KSTR:(K++) = 「胸の中で、びくびくって……っ、なんで、大鳳まで……っ_H_」
				ELSE
					KSTR:(K++) = 「はいはい、谷間にたっぷり。……拭くの、手伝ってくださいね？」
				ENDIF
			CASE 5
				;顔
				KSTR:(K++) = 「きゃっ……！　はあ、また顔ですの？　お化粧が台無しですわ」
				KSTR:(K++) = 「拭いてくださるまで、許しませんからね」
			CASE 6
				;腹
				KSTR:(K++) = 「はいはい、お腹の上に。いっぱい出ましたわね、ワンちゃん」
			CASE 7
				;背中
				KSTR:(K++) = 「背中に……？　まったく、どこに出していますの」
			CASE 30
				IF CFLAG:対象キャラ:うふふ
					;うふふ中汎用射精
					KSTR:(K++) = 「あら、もう？　まだ練習の途中ですわよ？」
				ELSE
					;非うふふ時の射精、逆セクハラなど
					KSTR:(K++) = 「こんなところで出してしまうなんて。……後始末は、ご自分でなさいね？」
				ENDIF
		ENDSELECT
	ELSEIF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
		;言いなり・特殊言いなり（未作成）
		SELECTCASE RFLAG:フィニッシュ場所
			CASE 0
				;膣内
			CASE 1
				;腸内
			CASE 2
				;口
			CASE 3
				;乳内
			CASE 5
				;顔
			CASE 6
				;腹
			CASE 7
				;背中
			CASE 30
				;汎用
		ENDSELECT
	ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
		;泥酔・トランス（未作成）
		SELECTCASE RFLAG:フィニッシュ場所
			CASE 0
				;膣内
			CASE 1
				;腸内
			CASE 2
				;口
			CASE 3
				;乳内
			CASE 5
				;顔
			CASE 6
				;腹
			CASE 7
				;背中
			CASE 30
				;汎用
		ENDSELECT
	ELSE
		;非陥落（性交渉をお願いする（COM353）で仕方なく応じている時など）
		SELECTCASE RFLAG:フィニッシュ場所
			CASE 0
				;膣内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					KSTR:(K++) = 「ちょっ、中は、駄目って……っ、あぁっ！_H_」
				ELSE
					KSTR:(K++) = 「……中に出しましたわね？　いい度胸ですこと」
				ENDIF
			CASE 1
				;腸内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					KSTR:(K++) = 「な、何してくれてますの……っ、お尻で、なんて……っ」
				ELSE
					KSTR:(K++) = 「そっちに出すなんて、どういう神経をしていますの？　はあ、この犬は」
				ENDIF
			CASE 2
				;口
				IF RCVAR:対象キャラ:精飲フラグ
				;飲み込む
					KSTR:(K++) = 「んぐっ……！　……飲ませるなんて、聞いていませんわよ。苦い……」
				ELSEIF ABL:対象キャラ:技巧 > 2
				;ティッシュに吐き出す
					KSTR:(K++) = 　%CALLNAME:対象キャラ%は眉をひそめて口元を押さえ、ティッシュに吐き出した。
					KSTR:(K++) = 「お口に出していいなんて、ひとことも言っていませんけれど？」
				ELSE
				;吐き出してむせる
					KSTR:(K++) = 「けほっ、こほっ……！　ちょっと、何を考えていますの……！」
				ENDIF
			CASE 3
				;乳内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					KSTR:(K++) = 「胸の中で、びくびくって……っ、な、なんで私まで……っ」
				ELSE
					KSTR:(K++) = 「谷間がべとべと。……出すなら出すと、先に言いなさいな」
				ENDIF
			CASE 5
				;顔
				KSTR:(K++) = 「きゃっ……！　ちょっと、顔はやめなさいと……！」
				KSTR:(K++) = 「本当に、躾のなっていない犬ですこと」
			CASE 6
				;腹
				KSTR:(K++) = 「お腹の上に……。拭くのは、ご自分でやってくださいね」
			CASE 7
				;背中
				KSTR:(K++) = 「背中に……？　見えないところで好き勝手して。はあ、もう」
			CASE 30
				IF CFLAG:対象キャラ:うふふ
					;うふふ中汎用射精
					KSTR:(K++) = 「もう出しましたの？　うふふ、情けない男ですこと～」
				ELSE
					;非うふふ時の射精、逆セクハラなど
					KSTR:(K++) = 「こんなところで出してしまうなんて。……後始末は、ご自分でなさいね？」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;・使い方
;「1222」をキャラクター番号に置換し、それぞれの関数に処理を入れる

;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_1222(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
;口上と同じ感覚で使う為に書式を統一しているが、通常時の画面で表示されるので
;基本的にWAIT系列は使わないことを推奨
;また、一行のみの表示を想定。二行以上は基本的に禁止
;※うふふ中には表示されません

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = 「いらっしゃいませ～。お部屋のご案内でしたら、私が」
		CASE 2
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「何になさいます？　甘いものでしたら、少し自信がありますわ」
		CASE 3
			;図書室で司書中
			KSTR:(K++) = 「お静かに。お探しの本があれば、題名だけ仰ってくださいな」
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 「あまり遠くへ行かないでくださいね～。……はあ、退屈な仕事ですわね」
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = 「網の繕いなら任せてください。……魚のほうは、あまり自信ありませんけど」
		CASE 6
			;遊覧船・海底散歩でシーガイド中
			KSTR:(K++) = 「足元にお気をつけて。海の上は、思ったより揺れますわ」
		CASE 100 TO 199
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 100):0}(現在仕事:対象キャラ:1 - 100)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「何か入り用ですか？　ひととおりは揃っていますわ」
				CASE "土産物屋"
					KSTR:(K++) = 「重桜のお土産は……さすがに置いていませんね」
				CASE "食事処"
					KSTR:(K++) = 「本日のおすすめは甘味です。私が決めました」
				CASE "装飾品店"
					KSTR:(K++) = 「手縫いの髪飾りも、少しだけ置かせてもらっていますの」
				CASE "直売所"
					KSTR:(K++) = 「今朝採れたばかりですって。匂いでわかりますわ」
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;状況で分岐
IF CFLAG:対象キャラ:飲み会
	;飲み会中
	KSTR:(K++) = 「お酒ですか？　ええ、ほどほどにいただきますわ」
ELSEIF CFLAG:対象キャラ:睡眠
	;ダウン・睡眠中
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「……無理をするものでは、ありませんわね……」
	ELSE
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は長い髪を丁寧にまとめたまま、静かな寝息を立てている。
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中
	;デートの相手のキャラ番号 + 100が入っている
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	IF CFLAG:対象キャラ:デート == MASTER + 100
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「今日は、どこへ連れて行ってくださるの？」
			CASE 1
				KSTR:(K++) = 「旅先で誰かと並んで歩くのも、悪くないものですね」
		ENDSELECT
	ELSE
		KSTR:(K++) = 「ごめんなさい、今は連れがいますので」
	ENDIF
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	;一緒に遊ぶ中
	KSTR:(K++) = 「負けるのは性に合いませんの。本気でいきますわよ？」
ELSEIF CFLAG:対象キャラ:同行
	;同行中
	IF CFLAG:対象キャラ:好感度レベル >= 関係閾値:3
		KSTR:(K++) = 「私の隣、すっかり%CSTR:対象キャラ:二人称%の定位置になりましたね」
	ELSE
		KSTR:(K++) = 「ええ、ご一緒しますわ。どちらへ？」
	ENDIF
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;一緒に隠密中
	KSTR:(K++) = 「気配を消すのは得意ですの。理由？　聞いたらどうなっても知りませんわよ？」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	;あなたが隠れていて、キャラはあなたに気づいていない
	KSTR:(K++) = 　%CALLNAME:対象キャラ%はふと顔を上げ、何かの匂いを探すように辺りを見回した。
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%_H_　今日も、ずっとご一緒しますわよね？」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。お散歩ですか？」
			CASEELSE
				KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。何かご用？」
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%が決めたことなら、大鳳はついていきますわ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「お困りごとでしたら、手伝いますよ？」
			CASEELSE
				KSTR:(K++) = 「ご用がないのでしたら、散歩の続きに戻りますわね」
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%～_H_　こっちを向いてくださいませ。うふふ、呼んでみただけですわ～」
					CASE 1
						KSTR:(K++) = 「大鳳のお顔、見に来てくださったのでしょう？　ほら、もっと近くで_H_」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「……あら、また目が合いましたね」
			CASEELSE
				KSTR:(K++) = 「じろじろ見ないでくださいます？」
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「そんなに見つめて……今夜は大鳳を、どうなさるおつもり？_H_」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「視線がどこに向いているか、ちゃんと分かっていますわよ」
			CASEELSE
				KSTR:(K++) = 「視線、隠せていませんわよ？」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_1222(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
;口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;基本的にWAIT系列は使わないことを推奨

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「重桜の大鳳です。あなたがこの島の、オーナー様？」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「休暇中ですので、あまり構わないでくださると助かりますわ」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%とは、よく顔を合わせますね」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「旅先で知り合いができるのは、嬉しいものですね」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%には、なんでも話してしまいそうで怖いですわ」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「この島も%CSTR:対象キャラ:二人称%も、もう大鳳の帰る場所ですわ～_H_」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_信頼
;--------------------------------------------------
@口上_ステータス画面_信頼コメント_1222(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE CFLAG:対象キャラ:信頼度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「今のところ、あなたを信頼する理由がひとつも見当たりませんが？」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「口約束なら誰にでもできますわ。守るかどうか、見させていただきます」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「約束の時間に、ちゃんと来てくださるのね」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;知己
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%は嘘をつきませんね。それだけで、ずいぶん気が楽ですわ」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;相棒
		KSTR:(K++) = 「背中を預けてもいい方だと、そう思っています」
	CASEELSE
		;水魚の交わり
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%のお言葉なら、理由はいりませんわ。全部信じます_H_」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_恋心
;--------------------------------------------------
@口上_ステータス画面_恋心コメント_1222(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE CFLAG:対象キャラ:恋心度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「あなたと恋なんて語っても、しょうがないですわ～」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「……妙な想像、しないでくださいます？」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%とは知り合い。ただの、知り合いですわよ。知り合い」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;気になる人
		KSTR:(K++) = 「最近、%CSTR:対象キャラ:二人称%のことばかり考えますの。……おかしいですわね」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;想い人
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%？　ええ、あの方の次に好きですけど？　何か問題でも？」
	CASEELSE
		;最愛の人
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%_H_　大鳳だけを、ずーっと見ていてくださいませ_H_」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_性愛
;--------------------------------------------------
@口上_ステータス画面_性愛コメント_1222(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE CFLAG:対象キャラ:性愛度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「……ちょっと。どこを見ていらっしゃるの？」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「不躾な方ですこと。見物料でもいただこうかしら」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「この服、やっぱり少し開きすぎかしら。まあ、直しませんけど」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;性癖に合う
		KSTR:(K++) = 「別に、見られるのは嫌ではありません。特に%CSTR:対象キャラ:二人称%になら」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;自慰の対象
		KSTR:(K++) = 「ええ、%CSTR:対象キャラ:二人称%は一人遊びにちょうどいいですわ。何か文句でも？」
	CASEELSE
		;肉欲の虜
		KSTR:(K++) = 「毎晩体が疼いて仕方ありませんの。責任、取ってくださいますわね？_H_」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ, 1)


;--------------------------------------------------
;ステータス画面一言口上_恋慕
;--------------------------------------------------
@口上_ステータス画面_恋慕コメント_1222(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
PRINTL
SELECTCASE CFLAG:対象キャラ:恋慕レベル
	CASE IS == 0
		;脈ナシ
		KSTR:(K++) = 「ご冗談でしょう？　私、そんなに安く見えます？」
	CASE IS <= 関係閾値:1
		;ちょっと気になる
		KSTR:(K++) = 「論外ではない、というだけですわ。調子に乗らないでくださいね？」
	CASE IS <= 関係閾値:2
		;なんかいいかも
		KSTR:(K++) = 「まあ、天地がひっくり返ってもありえない、とまでは言いませんけれど」
	CASE IS <= 関係閾値:3
		;好意を自覚
		KSTR:(K++) = 「……いや、いやいやいや。それはありません。あーりーまーせーん」
	CASE IS <= 関係閾値:4
		;ラブラブ
		KSTR:(K++) = 「ここまで大鳳を誑かすなんて。どうなっても構わないのですわね？」
	CASEELSE
		;最愛の人
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%は大鳳だけの%CSTR:対象キャラ:二人称%。誰にも渡しませんわ～_H_」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ, 1)


;--------------------------------------------------
;キャラについての解説
;--------------------------------------------------
@口上_ステータス画面_キャラ解説_1222(対象キャラ)
#DIM 対象キャラ
;EXキャラの出典を解説したり、キャラの設定・背景を解説するもの

KSTR:(K++) = 　「アズールレーン」より、重桜所属の装甲空母。
KSTR:(K++) = 　膝まで届く黒髪のツインテールと、驚くほど恵まれたスタイルが特徴。
KSTR:(K++) = 　想いを寄せる相手には並々ならぬ執着を見せて付きまとう、いわゆるヤンデレ気質。
KSTR:(K++) = 　その一方で平時は意外に世話焼きで、家事や仕事をそつなくこなす。
KSTR:(K++) = 　先輩の赤城とは犬猿の仲で、名前を聞くのも嫌がるほど。
KSTR:(K++) = 　趣味は裁縫・手芸など、苦手なことは徹夜。

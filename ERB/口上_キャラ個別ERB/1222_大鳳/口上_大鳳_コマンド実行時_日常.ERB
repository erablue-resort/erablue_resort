;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「1222」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************
;関係レベル
;	好感度レベルと恋慕レベルの高い方。陥落済みなら 関係閾値:5 扱い
;	段の境目は 関係閾値 = 0,10,20,50,80,100
;****************************************

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_1222_300(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「まだ何か？　話すことがないのでしたら、無理に引き留めないでくださいます？」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「……話題が尽きてしまいましたね。黙って海でも眺めてみます？」
			CASEELSE
				KSTR:(K++) = 「あら、もうお話はおしまい？　でしたら、%CSTR:対象キャラ:二人称%のお顔を眺めていますわ～_H_」
		ENDSELECT
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「はあ。それ、私に聞かせる必要ありました？」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%はにこやかなまま、もう視線を海のほうへ戻していた。
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「そのお話、正直あまり面白くありませんわ。次はもう少し練ってきてくださいな」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「あら、今のは冗談でしたの？　ごめんなさい、笑いどころを逃してしまいました」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「……聞いていませんでした。いえ、違うんです。%CSTR:対象キャラ:二人称%のお話がつまらなかったわけではなくて」
			CASEELSE
				KSTR:(K++) = 「ごめんなさい、%CSTR:対象キャラ:二人称%のお顔ばかり見ていて、お話が入ってきませんでしたわ_H_」
				KSTR:(K++) = 「もう一回、最初からお願いします～」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:8
					CASE 0
						KSTR:(K++) = 「ごきげんよう、%CSTR:対象キャラ:二人称%。ご用件は手短にお願いしますね」
					CASE 1
						KSTR:(K++) = 「重桜の大鳳です。休暇中ですので、お仕事のお話でしたら他を当たってくださいな」
					CASE 2
						KSTR:(K++) = 「せっかくの休暇ですもの。静かに過ごさせていただけると嬉しいのですけれど」
					CASE 3
						KSTR:(K++) = 「いいお天気ですね。こういう日は、海沿いを歩くに限りますわ」
					CASE 4
						KSTR:(K++) = 「この島、思っていたより広いんですね。まだ半分も見て回れていませんわ」
					CASE 5
						KSTR:(K++) = 「旅行は好きなんです。知らない土地の空気は、それだけで気分が変わりますもの」
					CASE 6
						KSTR:(K++) = 「私には指揮官様という、心に決めた方がおりますの。余計なご期待はなさらないでくださいね」
					CASE 7
						KSTR:(K++) = 「指揮官様ほど素敵な方は、どの海を探してもいらっしゃいませんわ」
						KSTR:(K++) = 「あら、あなたと比べたわけではありませんわよ？　比べるまでもありませんもの」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:8
					CASE 0
						KSTR:(K++) = 「この島、潮の匂いに混じって甘い匂いがしますね」
						KSTR:(K++) = 「……あら、%CSTR:対象キャラ:二人称%からではありませんわよ？　あなたはもう少し汗臭いですもの」
					CASE 1
						KSTR:(K++) = 「あずき饅頭を置いているお店、ご存じありません？　……そうですか、役に立ちませんわねぇ」
					CASE 2
						KSTR:(K++) = 「針仕事？　得意ですけれど……%CSTR:対象キャラ:二人称%の分まで繕って差し上げる義理はありませんわね。今のところは」
					CASE 3
						KSTR:(K++) = 「このあたりの食事処、どこがおすすめかしら。甘いものがあると嬉しいのですけれど」
					CASE 4
						KSTR:(K++) = 「朝は早いほうなんです。人の少ない時間の浜辺は、静かでいいですわよ」
					CASE 5
						KSTR:(K++) = 「髪ですか？　ええ、手入れは毎日。長いと、それなりに手間がかかりますの」
					CASE 6
						KSTR:(K++) = 「このお土産、指揮官様に似合うかしら。……あら、%CSTR:対象キャラ:二人称%に聞いても仕方ありませんわね」
					CASE 7
						KSTR:(K++) = 「指揮官様、今ごろ私がいなくて寂しがっていないかしら」
						KSTR:(K++) = 「いえ、寂しがっているに決まっていますわ。うふふ」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%は、もう少しご自分の身なりに気を配ったほうがよろしいわ。……ほら、ここ、ほつれています」
					CASE 1
						KSTR:(K++) = 「旅のお話ですか？　ええ、いくらでも。あちこち行きましたから」
					CASE 2
						KSTR:(K++) = 「……%CSTR:対象キャラ:二人称%、昨夜は遅かったでしょう？　目の下でわかります」
						KSTR:(K++) = 「忙しくても夜更かしはいけませんよ、夜更かしは」
					CASE 3
						KSTR:(K++) = 「指揮官様のお話？　ええ、いくらでもできますわよ。%CSTR:対象キャラ:二人称%が退屈でなければ、ですけれど」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「不思議ですね。指揮官様以外の方と、こんなに長くお喋りするなんて」
					CASE 1
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の匂い、覚えてしまいました。……変な意味ではありませんわ。人を見分けるのに、匂いのほうが確かなだけです」
					CASE 2
						KSTR:(K++) = 「ここにいると、急いで帰らなくてもいい気がしてくるんです。……いけない休暇の過ごし方かしら」
					CASE 3
						KSTR:(K++) = 「お茶を淹れましょうか？　……うふふ、ちょうど二人分、用意があるんです」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:6
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%～？　今日はまだ、大鳳とお話ししてくださっていませんわよ？」
					CASE 1
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%のお仕事、大鳳にも少し分けてくださいな。二人でやれば、そのぶん早く一緒にいられますから_H_」
					CASE 2
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の足音なら、どこにいても聞き分けられますわ。うふふ、便利でしょう？」
					CASE 3
						KSTR:(K++) = 「さっき、あの子と楽しそうにお話ししていましたわね？」
						KSTR:(K++) = 「いえいえ、いいえ～？　怒ってなんていませんわ～。%CSTR:対象キャラ:二人称%がどなたとお話ししていようと、怒る理由がどこにありますの？」
					CASE 4
						KSTR:(K++) = 「困ったことがあったら、真っ先に大鳳に言ってくださいね？　他の子を頼られるのは……少し妬けますもの♪」
					CASE 5
						KSTR:(K++) = 「ええ、指揮官様も%CSTR:対象キャラ:二人称%も、大鳳の大切な方ですわ。どちらかを選ぶ理由なんて、どこにありますの？」
				ENDSELECT
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%にしては面白いお話でしたわ。少しだけ見直しました」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「ふふっ、そんなお話、初めて聞きましたわ。……続き、聞かせてくださいます？」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は椅子を少しだけ引き寄せ、話の続きを待っている。
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「うふっ、あははははっ！　%CSTR:対象キャラ:二人称%ったら可笑しい～。大鳳、笑いすぎてお腹が痛いですわ♪」
					CASE 1
						KSTR:(K++) = 「今日のお話、ぜーんぶ覚えておきますね_H_　一言残らず、ですわよ？」
				ENDSELECT
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM301_お茶を淹れる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;あなたがお茶を淹れて振る舞う。成功率はあなたの料理人知識で変わる

@KOJO_COM_1222_301(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「薄いですわね。お湯に色がついているだけではなくて？」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「あら、少し渋いですわね。次は蒸らす時間を短くしてみては？」
			CASEELSE
				KSTR:(K++) = 「うふふ、ちょっと渋いですわ。今度、大鳳が淹れ方を教えて差し上げますね_H_」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「いただきます。……ええ、普通においしいですわ」
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「悪くありませんわね。お茶請けがあれば、もっとよかったのですけれど」
					CASE 1
						KSTR:(K++) = 「ありがとうございます。ちょうど喉が渇いていましたの」
				ENDSELECT
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「ほっとする味ですね。旅先でこういうお茶をいただけるのは、嬉しいものです」
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の淹れるお茶、だんだん私好みの味になってきましたわね」
					CASE 1
						KSTR:(K++) = 「次は私がお茶請けを用意しますね。あずき饅頭、自分で作ってみたんです」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%が淹れてくださったお茶ですもの。どんな高級品より上等ですわ_H_」
					CASE 1
						KSTR:(K++) = 「熱いですから、ふーふーして差し上げましょうか？　うふふ、遠慮なさらずに～」
				ENDSELECT
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「あら、おいしい。%CSTR:対象キャラ:二人称%、お茶だけはお上手ですのね」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「おいしい……！　これ、どうやって淹れましたの？　今度、教えてくださいな」
			CASEELSE
				KSTR:(K++) = 「おいしいですわ～_H_　毎朝このお茶で起こしてもらえたら、大鳳、幸せすぎてどうにかなりそう」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM302_スキンシップ
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功

@KOJO_COM_1222_302(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「汚い手で気安く触らないでくださいます？　そういうことは、相手を選んでなさるものですわ」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は笑顔を崩さないまま、触れられた場所を指先で払った。
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「あら、まだ早いですわ。もう少し仲良くなってからにしましょう？」
			CASEELSE
				KSTR:(K++) = 「もう、人前ですわよ？　続きは二人きりの時に、たっぷり……ね？_H_」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「何か付いていました？　付いていないのでしたら、手をどけてくださいな」
						KSTR:(K++) = 　%CALLNAME:対象キャラ%は礼儀正しく、けれどはっきりと、半歩だけ距離を取った。
					CASE 1
						KSTR:(K++) = 「あら、握手ですか？　ええ、よろしくお願いしますね」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「スキンシップ、ですか。まあ、減るものでもありませんし。少しだけですわよ」
					CASE 1
						KSTR:(K++) = 「肩に糸くずが？　あら、ありがとうございます」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の手、思っていたより大きいんですね」
					CASE 1
						KSTR:(K++) = 「あら、今日はずいぶん人懐っこいんですのね」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ふふ、くすぐったい。もう、そんなところを触って、何がしたいんですの？」
					CASE 1
						KSTR:(K++) = 　%CALLNAME:対象キャラ%は触れられた腕をそっと引き寄せ、そのまま指を絡めた。
						KSTR:(K++) = 「こうしたほうが、落ち着きますの」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「うふふ、遠慮なさらなくても。どうぞ、お好きなだけ触っていいんですよ？」
					CASE 1
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の手、あったかい……大鳳、このまま離しませんわよ？」
					CASE 2
						KSTR:(K++) = 「こういうこと、他の子にはしていませんわよね？　もししていたら……うふふ、少しお仕置きですわ_H_」
				ENDSELECT
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あら、意外と手慣れていらっしゃるのね。どこで覚えたのかは、聞かないでおきますわ」
						KSTR:(K++) = 　褒め言葉なのか皮肉なのか、判断のつかない微笑みだった。
					CASE 1
						KSTR:(K++) = 「触れ方が丁寧なんですのね。そういう方は、嫌いではありませんわ」
				ENDSELECT
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「ひゃっ！　い、今のはナシです。忘れてくださいな」
			CASEELSE
				KSTR:(K++) = 「あんっ_H_　%CSTR:対象キャラ:二人称%ったら、急にそんな……」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は%CALLNAME:MASTER%の胸元に顔をうずめ、深く息を吸い込んだ。
				KSTR:(K++) = 「すぅ……はぁ……%CSTR:対象キャラ:二人称%の匂い、大好きですわ～_H_」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM303_口説く
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-2:話題切れで大失敗  -1:失敗  0:通常成功  1:大成功  2:トランス状態（恋慕持ちには発生しない）
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_1222_303(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;話題切れ
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「その口説き文句、さっきも聞きましたわ。もう品切れですの？」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「ふふ、同じ褒め言葉ばかり。ネタ切れですか？」
			CASEELSE
				KSTR:(K++) = 「もう言うことがないんですの？　では、今度は大鳳の番ですわね_H_」
		ENDSELECT
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「はあ。そういうことは、指揮官様以外から言われても響きませんの」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「お上手ですこと。どなたにでも同じことを言っていそうですけれど」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「……どうも。社交辞令として受け取っておきますわ」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「そういうのは、もう少し雰囲気のある時に言ってくださいな」
			CASEELSE
				KSTR:(K++) = 「今のはちょっと安っぽいですわ。やり直しを要求します」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あら、お世辞がお上手ですこと。でも、私には効きませんわよ？」
					CASE 1
						KSTR:(K++) = 「褒めていただけるのは嬉しいですけれど。それ以上は期待なさらないでね」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「その手の言葉には慣れていますの。聞き流しますわね」
					CASE 1
						KSTR:(K++) = 「まあ、悪い気はしませんけれど」
				ENDSELECT
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%もそういうことをおっしゃるのね。意外ですわ」
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「もう、からかわないでくださいな。顔が熱くなってきたじゃありませんか」
					CASE 1
						KSTR:(K++) = 「そういうこと、誰にでも言っているんじゃありませんわよね？」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0

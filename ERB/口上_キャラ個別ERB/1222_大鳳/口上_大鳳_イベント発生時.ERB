	SELECTCASE 関係レベル
		CASE IS < 関係閾値:2
			KSTR:(K++) = 「あら、先ほどはお楽しみでしたわね」
			KSTR:(K++) = 「……いえ、別に。私には関係のないことですもの」
		CASE IS < 関係閾値:4
			KSTR:(K++) = 「さっきの、見てしまいましたわ」

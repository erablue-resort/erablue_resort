;****************************************
;ターン開始時や一日開始時・終了時に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「1222」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;初対面時
;--------------------------------------------------
;リゾート内で初めてTARGETにした時に一度だけ呼ばれる（場所は問わない）
@KOJO_EVENT_初対面_1222(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = 　長い黒髪を二つに結った女が、こちらに気づいて足を止めた。
WSTR:(K++) = 　膝まで届く髪が、潮風に遅れて揺れる。
KSTR:(K++) = 　
WSTR:(K++) = 「あら。……あなたがこのリゾートの、オーナー様？」
KSTR:(K++) = 　
WSTR:(K++) = 「重桜の大鳳と申します。しばらくの間、こちらでお休みをいただくことになりました」
KSTR:(K++) = 　
KSTR:(K++) = 　丁寧な一礼。だが、あまりに大きく実った乳房はそれだけで大きく波打ち、深い谷間が目の前にさらされる。
WSTR:(K++) = 　揺れが収まるまで、%CALLNAME:MASTER%の目はしっかりとそれを追ってしまった。
KSTR:(K++) = 　
WSTR:(K++) = 「…………ふむ」
KSTR:(K++) = 　
WSTR:(K++) = 　大鳳は気にした様子もなく顔を上げると、むしろ赤い瞳で%CALLNAME:MASTER%を上から下へと値踏みする。
KSTR:(K++) = 　
WSTR:(K++) = 「（……指揮官様とは、比べるまでもないわね）」
KSTR:(K++) = 　
WSTR:(K++) = 　……そして、ふいと視線が外れた。どうやら、彼女のお眼鏡にはかなわなかったらしい。
KSTR:(K++) = 　
WSTR:(K++) = 「ご心配なく。旅先で面倒を起こすような真似はいたしませんわ」
KSTR:(K++) = 　
KSTR:(K++) = 「ここなら、口うるさい先輩の顔を見ずに済みますし？　うふふ」

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_1222(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE TIME
	;朝　5時～11時
	CASE 5*60 TO 11*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。朝から何かご用？」
					CASE 1
						KSTR:(K++) = 「おはようございます。いい朝ですね」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。朝は早いほうですのね。私ほどではありませんけれど」
					CASE 1
						KSTR:(K++) = 「おはようございます。朝の潮風は気持ちいいですわね」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。寝癖、ついていますわよ？」
					CASE 1
						KSTR:(K++) = 「おはようございます。早起きは得意なんです。そのぶん、夜は早く寝ますけれど」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。朝ごはん、まだでしたらご一緒しません？」
					CASE 1
						KSTR:(K++) = 「あら、朝いちばんに%CSTR:対象キャラ:二人称%に会えるなんて。今日はいい日になりそうですね」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%_H_　大鳳、ずっと待っていましたわ～」
					CASE 1
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%～、おはようございます！　昨夜はよく眠れました？」
						KSTR:(K++) = 「大鳳は%CSTR:対象キャラ:二人称%の夢を見ましたわ_H_」
					CASE 2
						KSTR:(K++) = 「おはようございます。ほら、襟が曲がっていますわよ。……はい、これで完璧です_H_」
				ENDSELECT
		ENDSELECT
	;昼　11時～18時
	CASE 11*60 TO 18*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ごきげんよう、%CSTR:対象キャラ:二人称%」
					CASE 1
						KSTR:(K++) = 「こんにちは。お仕事中かしら？　でしたら、お構いなく」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。こんなに暑いのに、その格好で平気ですの？」
					CASE 1
						KSTR:(K++) = 「こんにちは。お昼はもう召し上がりました？　いえ、聞いてみただけですわ」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんにちは、%CSTR:対象キャラ:二人称%。ちょうど甘いものが欲しくなっていたところなんです」
					CASE 1
						KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。お散歩ですか？　私もです」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんにちは、%CSTR:対象キャラ:二人称%。午後のお茶、ご一緒しません？」
					CASE 1
						KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。なんとなく、今日は会えそうな気がしていましたわ」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%_H_　見つけましたわ～。どこにいたって、大鳳にはすぐわかるんですから」
					CASE 1
						KSTR:(K++) = 「こんにちは、%CSTR:対象キャラ:二人称%。お昼、作りすぎてしまったんです」
						KSTR:(K++) = 「わざとではありませんわよ？_H_」
					CASE 2
						KSTR:(K++) = 「あら、%CSTR:対象キャラ:二人称%。さっきまでどなたとご一緒でしたの？」
						KSTR:(K++) = 「うふふ、ちょっと気になっただけですわ～」
				ENDSELECT
		ENDSELECT
	;夕方～宵　18時～21時（大鳳は早寝なので21時以降を夜更けとして分ける）
	CASE 18*60 TO 21*60-1
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。夕食はもうお済みかしら」
					CASE 1
						KSTR:(K++) = 「ごきげんよう。今日はもう、あまり構わないでくださいね？」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。夕焼け、綺麗でしたわね」
					CASE 1
						KSTR:(K++) = 「あら、こんばんは。お風呂上がりなので、あまり近寄らないでくださいな」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。今日は一日、何をしていらしたの？」
					CASE 1
						KSTR:(K++) = 「夕食、何にしようかしら。%CSTR:対象キャラ:二人称%は、もう召し上がりました？」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。今日のうちに会えて、よかったですわ」
					CASE 1
						KSTR:(K++) = 「こんばんは。寝るまでのあいだ、少しだけお付き合いくださいな」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%～、こんばんは_H_　今日もちゃんと、大鳳のところに来てくださいましたわね」
					CASE 1
						KSTR:(K++) = 「お夕食、ご一緒にいかが？　%CSTR:対象キャラ:二人称%の好きなもの、作っておきましたわ_H_」
					CASE 2
						KSTR:(K++) = 「こんばんは。今夜は早めに休みますけれど……%CSTR:対象キャラ:二人称%も一緒に、ね？_H_」
				ENDSELECT
		ENDSELECT
	;夜更け　21時以降～5時
	CASEELSE
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。夜更かしは感心しませんわね」
					CASE 1
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。私はそろそろ休みますので」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。こんな時間までうろうろしているなんて、よほどお暇ですのね」
					CASE 1
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。夜の海は、昼とは違う匂いがしますわね」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。徹夜なんてしたら駄目ですよ？」
					CASE 1
						KSTR:(K++) = 「こんばんは。今日も一日、お疲れさまでした」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。眠る前に顔を見られて、よかったですわ」
					CASE 1
						KSTR:(K++) = 「ふぁ……こんばんは。ごめんなさい、この時間はもう、頭が回りませんの」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%～、こんばんは_H_　今夜は大鳳だけの%CSTR:対象キャラ:二人称%でいてくださいます？」
					CASE 1
						KSTR:(K++) = 「こんばんは。大鳳、眠いのを我慢して待っていましたのよ？　褒めてくださいな」
					CASE 2
						KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。夜は冷えますわ。ほら、もっとこっちに寄って_H_」
				ENDSELECT
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------

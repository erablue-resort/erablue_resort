;--------------------------------------------------
;うふふ終了時
;--------------------------------------------------
@KOJO_EVENT_うふふ終了_1222(対象キャラ, 終了原因)
#DIM 対象キャラ
#DIMS 終了原因
CALL 口上変数初期化

IF CFLAG:対象キャラ:体力限界
	;終了時にダウンしている
	IF 終了原因 == "全員ダウン"
		;全員ダウン時
		KSTR:(K++) = 「もう、動けませんわ……。あなたも、でしょう……？」
	ELSE
		;他に生き残りがいる時
		KSTR:(K++) = 「大鳳は、ここで……脱落、ですわ……。あとは、お好きに……」
	ENDIF
ELSE
	;終了時にダウンしていない
	SELECTCASE 終了原因
		CASE "通常終了"
			;逢引終了ボタンでの終了。最も一般的
			;21時以降・5時前は夜更かし扱い（大鳳は早寝）
			IF TIME >= 21*60 || TIME < 5*60
				IF TALENT:対象キャラ:恋慕
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「ふぁ……。うふふ、今日はもう、このまま%CSTR:対象キャラ:二人称%の腕の中で寝ますわ……_H_」
						CASE 1
							KSTR:(K++) = 　%CALLNAME:対象キャラ%は小さくあくびをすると、%CALLNAME:MASTER%の胸に額を押し付けてきた。
							KSTR:(K++) = 「こんな時間まで……。明日寝坊したら、%CSTR:対象キャラ:二人称%のせいですからね……」
					ENDSELECT
				ELSEIF TALENT:対象キャラ:セフレ
					KSTR:(K++) = 「ふぁ……。練習にしては、遅くまで付き合わせすぎですわ。夜更かしは苦手だと言いましたのに」
				ELSE
					KSTR:(K++) = 「……眠いので、帰ります。こんな時間まで、まったく」
				ENDIF
			ELSE
				IF TALENT:対象キャラ:恋慕
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「うふふ、今日もたくさん愛していただきましたわ_H_」
						CASE 1
							KSTR:(K++) = 「もう終わりですの？　仕方ありませんわね。続きは、また今度」
					ENDSELECT
				ELSEIF TALENT:対象キャラ:セフレ
					KSTR:(K++) = 「はい、練習はおしまい。ちゃんと体を拭いてから出ていってくださいね？」
				ELSE
					KSTR:(K++) = 「……終わりましたわね。では、私はこれで」
				ENDIF
			ENDIF
		CASE "目撃される"
			;陥落していないキャラにうふふが目撃された
			KSTR:(K++) = 「見られましたわね……。はあ、明日から顔を合わせづらいったら」
		CASE "サウナ限界"
			;サウナ内でうふふ中、熱気ゲージがたまりすぎた時
			KSTR:(K++) = 「あ、暑……。さすがに、ここでは無理がありましたわ……」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)



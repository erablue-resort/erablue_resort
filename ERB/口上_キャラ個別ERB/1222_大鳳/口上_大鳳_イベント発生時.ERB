		CASEELSE
			KSTR:(K++) = 「見ましたわよ？　%CALLNAME:相手%さんと、ずいぶん仲がよろしいのね」
			KSTR:(K++) = 「……いえいえ、怒ってなんて――」
			WSTR:(K++) = 「怒っているに決まっているでしょうが！！」
			KSTR:(K++) = 　
			KSTR:(K++) = 「今夜は大鳳の番です。拒否権はありませんからね！」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)



;--------------------------------------------------
;この場おやすみ口上（キャラが現在いる場所で寝る時
;--------------------------------------------------
;あなたが同じ場所にいる時だけ呼ばれる
;自室で寝る場合、陥落チェックが0（未陥落）だとこの後あなたは部屋から追い出される
@KOJO_EVENT_この場おやすみ_1222(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

IF CFLAG:対象キャラ:現在位置 == 303 && CFLAG:対象キャラ:現在マップ種別 == 0
	;メインテントで寝る
	IF 陥落チェック(対象キャラ)
		KSTR:(K++) = 「テントで雑魚寝なんてのも、旅らしくて悪くないですわね。……隣、空いていますわよ？_H_」
	ELSE
		KSTR:(K++) = 「もう寝ますわ。……寝顔を覗いたりしたら、承知しませんからね」
	ENDIF
ELSEIF CFLAG:対象キャラ:現在マップ種別 == 999
	;部屋で寝る
	IF TALENT:対象キャラ:恋慕
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ふぁ……もう限界ですわ。%CSTR:対象キャラ:二人称%、今夜はこのまま泊まっていきます？_H_」
			CASE 1
				KSTR:(K++) = 「おやすみなさいませ、%CSTR:対象キャラ:二人称%。明日の朝も、一番に顔を見せてくださいね」
		ENDSELECT
	ELSEIF 陥落チェック(対象キャラ)
		KSTR:(K++) = 「寝ますわ。……泊まっていくのでしたら、いびきはかかないでくださいね」
	ELSE
		;この後追い出される
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「私、もう寝ますので。さっさと出ていってくださいます？」
			CASEELSE
				KSTR:(K++) = 「そろそろ休みますわ。……ほら、おやすみなさい。また明日」
		ENDSELECT
	ENDIF
ELSE
	KSTR:(K++) = 「ふぁ……今日はここで休みますわ。おやすみなさい」
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;移動おやすみ口上（キャラがどこかに移動して寝る時
;--------------------------------------------------
;あなたが同じ場所にいる時だけ呼ばれる。呼ばれた時点ではまだ移動前の場所にいる
@KOJO_EVENT_移動おやすみ_1222(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE 関係レベル
	CASE IS < 関係閾値:2
		KSTR:(K++) = 「もうこんな時間。私は休みますので、ごきげんよう」
	CASE IS < 関係閾値:4
		KSTR:(K++) = 「ふぁ……ごめんなさい、眠くて。お先に失礼しますわね。おやすみなさい」
	CASEELSE
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「大鳳はもうおねむですわ～。%CSTR:対象キャラ:二人称%も、夜更かししないでくださいね？_H_」
			CASE 1
				KSTR:(K++) = 「おやすみなさいませ。……夢の中でも、会いに行きますからね？」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

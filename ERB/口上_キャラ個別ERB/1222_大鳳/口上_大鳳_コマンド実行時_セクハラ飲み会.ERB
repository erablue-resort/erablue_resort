;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「1222」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************

;--------------------------------------------------
;COM321_胸を揉む
;--------------------------------------------------
;取得快楽：Ｂ
;RFLAG:コマンド結果受渡し変数
	;1:拒絶  2:受け入れ  3:喜び
;大鳳はＢ感度-1（鈍感）
@KOJO_COM_1222_321(対象キャラ)
#DIM 対象キャラ

CALL 口上変数初期化

IF TALENT:対象キャラ:恋慕
	SELECTCASE CUP:対象キャラ:快Ｂ
		;各部位の累積が10000で絶頂
		CASE IS > 10000
			;即絶頂
			KSTR:(K++) = 「んっ、あ……！　胸だけで、なんて……大鳳の胸、鈍いはずなのに……っ_H_」
		CASE IS > 6000
			;かなり感じている
			KSTR:(K++) = 「あ、ん……%CSTR:対象キャラ:二人称%に揉まれると、なんだか変な感じ、ですわ_H_」
		CASE IS > 3000
			;人並みに感じている
			KSTR:(K++) = 　指がどこまでも沈み込み、手のひらから柔らかな肉がこぼれ出す。
			KSTR:(K++) = 「うふふ、重たいでしょう？　好きなだけ揉んでくださいな_H_」
		CASEELSE
			;まだ快楽に慣れていない
			KSTR:(K++) = 「あら、くすぐったいだけですわよ？　大鳳の胸、案外鈍いんですの」
	ENDSELECT
ELSEIF TALENT:対象キャラ:セフレ
	KSTR:(K++) = 「はいはい、好きなだけどうぞ。……本当に胸がお好きなんですから」
ELSE
	IF RFLAG:コマンド結果受渡し変数 == 1
		;拒絶
		KSTR:(K++) = 「どこを触っているんですの？　その手、へし折られたいのかしら」
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は笑顔のまま、%CALLNAME:MASTER%の手首をぎりぎりと捻り上げた。
	ELSEIF RFLAG:コマンド結果受渡し変数 == 2
		;受け入れ
		KSTR:(K++) = 「減るものでもありませんし。でも、あまり調子に乗らないでくださいね？」
	ELSE
		;喜び
		KSTR:(K++) = 「あら、大胆ですこと。……少しだけなら、許して差し上げますわ」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM350_押し倒す
;--------------------------------------------------
;実行条件：陥落チェック_性的＋疑似恋慕（恋慕・セフレ・疑似恋慕）か、言いなり・特殊言いなり
@KOJO_COM_1222_350(対象キャラ)
#DIM 対象キャラ
;取得快楽：なし

CALL 口上変数初期化

IF TALENT:対象キャラ:恋慕
	IF TCVAR:対象キャラ:初うふふフラグ
		;初体験時
		KSTR:(K++) = 「あら。ついに、ですのね」
		WSTR:(K++) = 「こういうことは初めてですけれど……%CSTR:対象キャラ:二人称%になら、全部差し上げますわ」
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は頬を染めながらも、自分から%CALLNAME:MASTER%の首に腕を回した。
		KSTR:(K++) = 「優しくしてくださらないと、死ぬまで根に持ちますわよ？_H_」
	ELSE
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「はいはい、またですね？　もう、%CSTR:対象キャラ:二人称%ったら仕方のない方……」
				KSTR:(K++) = 　口ではそう言いながら、%CALLNAME:対象キャラ%はもう自分から帯を解き始めていた。
			CASE 1
				KSTR:(K++) = 「今日も一日お疲れさまでした。さ、ご褒美の時間ですわよ？_H_」
			CASE 2
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%……」
				KSTR:(K++) = 　それ以上の言葉はなかった。%CALLNAME:対象キャラ%は目を閉じ、そっと唇を重ねてくる。
			CASE 3
				KSTR:(K++) = 「大鳳も、ちょうど%CSTR:対象キャラ:二人称%が欲しかったところですの。ね、早く_H_」
		ENDSELECT
	ENDIF
ELSEIF TALENT:対象キャラ:セフレ || TALENT:対象キャラ:疑似恋慕
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「勘違いなさらないでくださいね？　これは、あの方にご奉仕する時のための練習ですから」
		CASE 1
			KSTR:(K++) = 「溜まっているのはお互いさまですもの。性欲処理でしたら、付き合って差し上げますわ」
		CASE 2
			KSTR:(K++) = 「あら、今日も練習台になってくださるの？　あくまで練習、ですわよ？」
	ENDSELECT
ELSE
	;言いなり・特殊言いなり
	KSTR:(K++) = 「体が、言うことを聞きませんわ……。覚えていらっしゃい」
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM352_告白する
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;1:成功  0:失敗  -1:既に関係性恋慕が確定済み
;RFLAG:コマンド結果受渡し変数３（成功時）
	;1:浮気を得た（恋人持ち等）  2:想い人を失った  0:どちらも関係ない
@KOJO_COM_1222_352(対象キャラ)
#DIM 対象キャラ
;取得快楽：なし

CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 1
		;成功時
		WSTR:(K++) = 「……はあ。とうとう言いましたわね、あなた」
		KSTR:(K++) = 　
		WSTR:(K++) = 「ええ、ええ。認めますわよ。この大鳳が、%CSTR:対象キャラ:二人称%ごときに惚れてしまったことを」
		KSTR:(K++) = 　
		WSTR:(K++) = 　%CALLNAME:対象キャラ%はぷいと顔を背けたが、その耳は真っ赤に染まっていた。
		KSTR:(K++) = 　
		WSTR:(K++) = 「言っておきますけれど、指揮官様への想いが消えたわけではありませんわよ？」
		WSTR:(K++) = 「それでも構わないと言うのなら――大鳳の全部、受け取ってくださいまし」
		KSTR:(K++) = 　
		KSTR:(K++) = 「……もう、二度と離しませんから_H_」
	CASE 0
		;失敗
		KSTR:(K++) = 「……は？　何を寝ぼけたことを。顔を洗って出直してらっしゃい」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM353_性交渉をお願いする
;--------------------------------------------------
@KOJO_COM_1222_353(対象キャラ)
#DIM 対象キャラ
;取得快楽：なし
;RFLAG:コマンド結果受渡し変数
	;1:成功  0:失敗
;RFLAG:コマンド結果受渡し変数２
	;今回でどのくらい成功度が蓄積したかを表す  蓄積の累計値が100を越えたら成功
	;16未満だと拒否度が高い扱いで、失敗時の好感度低下が大きくなる
;CFLAG:対象キャラ:お願いックス蓄積値
	;現在どのくらい成功度が蓄積しているかを表す  蓄積の累計値が100を越えたら成功
;BASE:対象キャラ:酩酊 >= 500 で泥酔扱い、TCVAR:対象キャラ:トランス残り時間 > 0 でトランス扱い（本体の判定に準拠）
;CFLAG:対象キャラ:お願いックス回数
	;泥酔以外（トランス時を含む）で成功した回数。成功時点で加算済み。泥酔時は 泥酔ックス回数 に加算される

CALL 口上変数初期化

IF RFLAG:コマンド結果受渡し変数
	;成功
	IF TCVAR:対象キャラ:初うふふフラグ
		;初体験時
		IF BASE:対象キャラ:酩酊 >= 500
			WSTR:(K++) = 「んぅ……指揮官様ぁ……？　やっと、大鳳のところに来てくださったのね……_H_」
			KSTR:(K++) = 　
			WSTR:(K++) = 　とろんとした赤い瞳は、%CALLNAME:MASTER%の顔を見ているようで、たぶん見ていない。
			KSTR:(K++) = 　
			WSTR:(K++) = 「……あら？　指揮官様、少しお顔が違うような……」
			KSTR:(K++) = 　
			WSTR:(K++) = 「まあ、いいですわ……。今夜は、大鳳を好きにしてくださいませ……_H_」
			KSTR:(K++) = 　
			KSTR:(K++) = 　酔いに任せて首に絡みついてきた腕は、驚くほど熱かった。
		ELSEIF TCVAR:対象キャラ:トランス残り時間 > 0
			WSTR:(K++) = 「あ、れ……？　私、どうして……こんな……」
			KSTR:(K++) = 　
			KSTR:(K++) = 　%CALLNAME:対象キャラ%はぼうっとした目のまま、自分から%CALLNAME:MASTER%の胸に身を預けてきた。
		ELSE
			WSTR:(K++) = 「ああもう、わかりました、わかりましたわ」
			KSTR:(K++) = 　
			WSTR:(K++) = 「何度断っても尻尾を振って寄ってきて……本当に、しつこいワンちゃんみたいな方ですわね」
			KSTR:(K++) = 　
			WSTR:(K++) = 　%CALLNAME:対象キャラ%は大げさにため息をつくと、仕方ないという顔で%CALLNAME:MASTER%に身を寄せてきた。
			KSTR:(K++) = 　
			WSTR:(K++) = 「もういいですわ。そこまで言うなら、お相手をして差し上げます」
			KSTR:(K++) = 　
			KSTR:(K++) = 「こっちだって初めてなんですから、優しくできますわね？　いい子にしていられたら、ご褒美ですわよ？」
		ENDIF
	ELSEIF TALENT:対象キャラ:セフレ
		;セフレ獲得時
		WSTR:(K++) = 「もう、何度目ですの？　……わかりました、わかりましたわ」
		KSTR:(K++) = 　
		WSTR:(K++) = 「言っておきますけれど、大鳳の一番は指揮官様。そこは譲りませんわよ？」
		KSTR:(K++) = 　
		WSTR:(K++) = 「でも、体の相性くらいは認めて差し上げます」
		KSTR:(K++) = 　
		KSTR:(K++) = 「今日から%CSTR:対象キャラ:二人称%を、大鳳の性欲処理係に任命しますわ_H_　光栄に思ってくださいね？」
	ELSEIF BASE:対象キャラ:酩酊 >= 500
		;泥酔時
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「んふふ……%CSTR:対象キャラ:二人称%ぁ……今夜も、指揮官様の代わり、してくださるの……？_H_」
			CASE 1
				KSTR:(K++) = 「あら、また酔わせて……。悪い方ですこと……でも、許して差し上げますわ……_H_」
		ENDSELECT
	ELSEIF TCVAR:対象キャラ:トランス残り時間 > 0
		;トランス時
		KSTR:(K++) = 「ずるい、ですわ……。頭が、ふわふわして……断れません……」
	ELSEIF CFLAG:対象キャラ:お願いックス回数 == 1
		;初体験が泥酔時などで、泥酔・トランス以外で応じるのが初めての時
		WSTR:(K++) = 「この前のは、その場の勢いです。……なのに、またおねだりですの？」
		KSTR:(K++) = 　
		WSTR:(K++) = 「はいはい、わかりました。そんな目で見上げないでくださいな。まるで捨て犬ですわ」
		KSTR:(K++) = 　
		KSTR:(K++) = 「今度は素面で、ちゃんと面倒を見て差し上げます。いい子にしているんですよ？」
	ELSE
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「はいはい、またですの？　本当にしつこい犬みたいな方ですわね。……おいでなさい」
			CASE 1
				KSTR:(K++) = 「そんなに物欲しそうな顔をして。仕方ありませんわね、少しだけ構って差し上げます」
			CASE 2
				KSTR:(K++) = 「まったく、しょうのない方。……ほら、今日も面倒を見て差し上げますわ」
		ENDSELECT
	ENDIF
ELSE
	;失敗
	IF BASE:対象キャラ:酩酊 >= 500
		KSTR:(K++) = 「んん……だめ、ですわ……大鳳は、指揮官様の……」
		KSTR:(K++) = 　呂律も怪しいのに、そこだけは譲らないらしい。
	ELSEIF RFLAG:コマンド結果受渡し変数２ < 16
		KSTR:(K++) = 「寝言は寝てから言ってくださいます？」
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は、道端のゴミでも見るような目で%CALLNAME:MASTER%を一瞥した。
	ELSEIF CFLAG:対象キャラ:お願いックス蓄積値 >= 50
		KSTR:(K++) = 「今日は、駄目です。……今日は」
	ELSE
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「お断りしますわ。そういうことは、指揮官様以外とする予定はありませんの」
			CASE 1
				KSTR:(K++) = 「大鳳の体は、指揮官様にお仕えするためのもの。あなたに差し上げる分はありませんわ」
			CASE 2
				KSTR:(K++) = 「そういうお誘いは、もう少しご自分を磨いてからにしてくださいます？」
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

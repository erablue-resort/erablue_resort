;****************************************
;コマンド実行後に表示される文章
;モードを開始したり削除したりするものを記載
;****************************************
;・使い方
;「1222」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************

;--------------------------------------------------
;COM82_パイズリ
;--------------------------------------------------
;取得快楽：Ｂ
;キャラがパイズリする方
@KOJO_COM_1222_82(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF MODE_存在判定_プレイヤー側("パイズリフェラ", 対象キャラ)
		;フェラ中はパイズリフェラに派生
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「谷間から顔を出しているの、可愛いですわね。はみ出したところは、お口で……んむ_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			KSTR:(K++) = 「胸だけでは足りませんの？　欲張りですこと。……んっ」
		ELSE
			;言いなり・特殊言いなり
			IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
				KSTR:(K++) = 「んむっ……こんな、ところまで……」
			ELSE
				;性交渉をお願いする（COM353）で仕方なく応じている時など
				KSTR:(K++) = 「欲張りですこと。今日だけ、お口も使って差し上げます。……んむ」
			ENDIF
		ENDIF
	ELSE
		;通常パイズリ
		IF TALENT:対象キャラ:恋慕
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 　%CALLNAME:対象キャラ%は豊かな乳房を両手で寄せ、%CALLNAME:MASTER%のものをすっぽり包み込んだ。
					KSTR:(K++) = 「うふふ、見えなくなってしまいましたわね。このまま、たっぷり可愛がって差し上げます_H_」
				CASE 1
					KSTR:(K++) = 「そうですわよね～？　%CSTR:対象キャラ:二人称%なら絶対に言うと思って、ずーっと待っていましたの_H_」
					KSTR:(K++) = 　%CALLNAME:対象キャラ%は待ってましたとばかりにたぷんと乳房を持ち上げ、自分から%CALLNAME:MASTER%の肉棒へ寄せてきた。
			ENDSELECT
		ELSEIF TALENT:対象キャラ:セフレ
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「こういうのがお好きなんでしょう？　顔に書いてありますわ」
					KSTR:(K++) = 　重たい乳房がずっしりと覆いかぶさり、先端すら見えなくなる。
				CASE 1
					KSTR:(K++) = 「ほら、やっぱり。そろそろ言い出す頃だと思っていましたわ」
					KSTR:(K++) = 「さっきから胸ばかり見ているんですもの。わかりやすい人ですこと」
			ENDSELECT
		ELSE
			;言いなり・特殊言いなり
			IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
				KSTR:(K++) = 「どうして私が、こんなこと……」
				KSTR:(K++) = 　不本意そうな顔とは裏腹に、%CALLNAME:対象キャラ%の胸は%CALLNAME:MASTER%のものをまるごと呑み込んでいた。
			ELSE
				;性交渉をお願いする（COM353）で仕方なく応じている時など
				KSTR:(K++) = 「まったく、胸がお好きなワンちゃんですこと。ほら、挟んで差し上げますわ」
				KSTR:(K++) = 　呆れ顔とは裏腹に、%CALLNAME:対象キャラ%の胸は%CALLNAME:MASTER%のものをまるごと呑み込んでしまった。
			ENDIF
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM84_縦パイズリ
;--------------------------------------------------
;取得快楽：Ｂ
;キャラがパイズリする方、フェラ時には使用出来ないためパイズリフェラには派生しない
@KOJO_COM_1222_84(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 　正面から谷間に押し込まれたものが、柔らかな肉の奥へずぶずぶと沈んでいく。
				KSTR:(K++) = 「うふふ、奥まで入ってしまいましたわね。大鳳の胸、そんなに気持ちいいんですの？_H_」
			CASE 1
				KSTR:(K++) = 「うふふ……大鳳のおっぱいとまぐわうのがそんなに楽しいですか～？_H_」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		KSTR:(K++) = 「胸に突っ込んで、腰を振りたいって……品のないこと。……まあ、お好きにどうぞ」
		KSTR:(K++) = 　深い谷間は、突き入れられたものを根元まですっぽりと呑み込んでしまった。
	ELSE
		;言いなり・特殊言いなり
		IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
			KSTR:(K++) = 「胸に、そんな……っ。な、何を考えているんですの……！」
		ELSE
			;性交渉をお願いする（COM353）で仕方なく応じている時など
			KSTR:(K++) = 「胸にそのまま、ですの？　はいはい、お好きにどうぞ。今日だけですわよ」
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM60_Ｖ挿入する、体位を変える
;--------------------------------------------------
;取得快楽：Ｖ
;RFLAG:コマンド結果受渡し変数
	;体位の種類  0:正常位  1:後背位  2:寝バック  3:対面座位  4:背面座位  5:騎乗位  6:側位  7:屈曲位  8:駅弁  9:背面駅弁  10:対面立位  11:立ちバック
@KOJO_COM_1222_60(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		IF RFLAG:コマンド結果受渡し変数 == 5
			;騎乗位
			KSTR:(K++) = 「うふふ、今日は大鳳が上ですわ。%CSTR:対象キャラ:二人称%は、そこで見ていてくださいな_H_」
		ELSE
			SELECTCASE CUP:対象キャラ:快Ｖ
				;各部位の累積が10000で絶頂
				CASE IS > 10000
					;即絶頂
					KSTR:(K++) = 「あっ、あぁっ……！　入れられた、だけで……っ、だめ、ですわ……っ_H_」
				CASE IS > 6000
					;かなり感じている
					KSTR:(K++) = 「んっ、奥まで……%CSTR:対象キャラ:二人称%で、いっぱい、ですわ……_H_」
				CASE IS > 3000
					;人並みに感じている
					KSTR:(K++) = 「うふふ、入ってきましたわね。ちゃんと、大鳳のナカの味を覚えてくださいね？_H_」
				CASEELSE
					;まだ快楽に慣れていない
					KSTR:(K++) = 「んっ……ゆっくり、ですわよ？　まだ、慣れていないんですから」
			ENDSELECT
		ENDIF
	ELSEIF TALENT:対象キャラ:セフレ
		IF RFLAG:コマンド結果受渡し変数 == 5
			KSTR:(K++) = 「私が好きにやらせてもらいますので。大人しく寝ていなさい」
		ELSE
			KSTR:(K++) = 「練習ですから、手加減は無用ですわよ？　……んっ」
		ENDIF
	ELSE
		;言いなり・特殊言いなり
		IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
			KSTR:(K++) = 「っ、こんな、の……。覚えて、いらっしゃい……」
		ELSE
			;性交渉をお願いする（COM353）で仕方なく応じている時など
			KSTR:(K++) = 「はいはい、入れていいですわよ。……まったく、しょうのない子ですこと」
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;****************************************
;縁結び系の処理に使う特殊関数
;****************************************
;・使い方
;「1385」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;「<スタイル名>」を任意のスタイル名に変更する
;****************************************

;--------------------------------------------------
;スタイル変更基礎関数
;--------------------------------------------------
@スタイル変更_1385(対象キャラ, 動作モード)
#DIM 対象キャラ
#DIMS 動作モード
;この関数はいくつ別スタイル作ってもキャラ毎に一個
;必須関数、スタイル変更を追加する場合、必ず作成すること

SELECTCASE 動作モード
	CASE "スタイル名取得"
        ;ここは触らない
		VARSET RESULTS
		RESULTS:0 = %NAME:対象キャラ%
		RESULTS:10 = ノーマル

		;RESULTS:Xに名前全体を、RESULTS:X+10にリミテッドや水着など通称(？)を入れる
        ;例：
		; RESULTS:1 = [強化状態二つ名]テスト太郎
		; RESULTS:11 = 強化スタイル
		RESULTS:1 = [日向一族の落ちこぼれ]日向ヒナタ
		RESULTS:11 = 下忍の姿

		;スタイル変更の条件を付けたい場合、RESULTSを条件分岐の中にいれる。
		;以下はキャラの陥落を条件にする場合の条件分岐
		; IF 陥落チェック(対象キャラ)
		; 	RESULTS:1 = <スタイル名>
		; 	RESULTS:11 = <スタイルのカテゴリ>
		; ENDIF
        
		; 複数スタイルを作りたい場合はRESULTS:2、RESULTS:12のように数字をふやしていく
        
	CASE @"スタイル解説_%NAME:対象キャラ%"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += @"■%NAME:対象キャラ%<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "うずまきナルトと結ばれた現代の姿。<br>"
		TSTR:スタイル解説 += "<br>"
        ;このCALLはそのままで良い
		CALL スタイル奥義アビ表示_汎用文章(対象キャラ, NAME:対象キャラ)
	CASE "スタイル解説_[日向一族の落ちこぼれ]日向ヒナタ"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += "■[日向一族の落ちこぼれ]日向ヒナタ<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "変化の術で下忍時代の頃を再現した姿。<br>"
		TSTR:スタイル解説 += "元の姿に比べるといろいろ小さいが、当時の年齢を考えると胸は大きめ。<br>"
		TSTR:スタイル解説 += "奥義・アビリティの変更はなし。<br>"
		TSTR:スタイル解説 += "<br>"
	CASE "変更後処理"
		;CSTR:対象キャラ:スタイル管理文字列をキーにして処理を実行
		;一人称や二人称、素質の変化などの調教側ステータスの変更を想定
        ;戦闘ステータスは別の関数
		SELECTCASE CSTR:対象キャラ:スタイル管理文字列
			CASE ""
                ;通常時に戻す処理
				TALENT:対象キャラ:バストサイズ = 2
				BASE:対象キャラ:年齢 = 32
				TALENT:対象キャラ:体型 = 2
				TALENT:対象キャラ:体格 = 0
				TALENT:対象キャラ:下半身 = 1
				TALENT:対象キャラ:母乳体質 = 1
				CALLNAME:対象キャラ = ヒナタ
				
				CALL SET_BODYSIZE_HEIGHT(対象キャラ)
			CASE "[日向一族の落ちこぼれ]日向ヒナタ"
                ;スタイル変更時の処理
				TALENT:対象キャラ:バストサイズ = 0
				BASE:対象キャラ:年齢 = 13
				TALENT:対象キャラ:体型 = 1
				TALENT:対象キャラ:体格 = -1
				TALENT:対象キャラ:下半身 = 0
				TALENT:対象キャラ:母乳体質 = 0
				CALLNAME:対象キャラ = ヒナタ（下忍）

				MAXBASE:対象キャラ:身長 = 1483
				BASE:対象キャラ:身長 = MAXBASE:対象キャラ:身長
		ENDSELECT
		CALL SET_BODYSIZE_BUST(対象キャラ)
		CALL SET_BODYSIZE_WAIST(対象キャラ)
		CALL SET_BODYSIZE_HIP(対象キャラ)

		CSTR:対象キャラ:フォルダ判定キー '= CALLNAME:対象キャラ
		SWAP CSTR:対象キャラ:画像フォルダ, CSTR:対象キャラ:スタイル変更前画像フォルダ
		CSTR:対象キャラ:画像フォルダ '= GET_RESOURCES_BASE_FOLDER(対象キャラ)
ENDSELECT



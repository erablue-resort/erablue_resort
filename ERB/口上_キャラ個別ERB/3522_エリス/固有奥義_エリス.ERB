@固有奥義_3522(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 65
	奥義名 = 光の太刀
	奥義威力 = 650
	表示用奥義威力 = 650
ELSE
	奥義名 = 無音の太刀
	奥義威力 = 500
	表示用奥義威力 = 500
ENDIF

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		詳細文文字列受け渡し変数 = 奥義威力：{表示用奥義威力}％<br>
		詳細文文字列受け渡し変数 += "発動前、自身の命中率［50％］UP（通常枠・1ターン）。<br>"
		詳細文文字列受け渡し変数 += "［30％］（通常枠・3ターン）のストレングス効果を与える<br>"
		IF 奥義名 == "光の太刀"
			詳細文文字列受け渡し変数 += "敵単体に［650％］のダメージ（敵の防御力を70％無視）。"
		ELSE
			詳細文文字列受け渡し変数 += "敵単体に［500％］のダメージ。"
		ENDIF
		RETURN 奥義威力
	CASE "奥義説明文_詳細"
		詳細文文字列受け渡し変数 = 奥義威力：{表示用奥義威力}％<br>
		詳細文文字列受け渡し変数 += "発動前、自身の命中率［50％］UP（通常枠・1ターン）。<br>"
		詳細文文字列受け渡し変数 += "［30％］（通常枠・3ターン）のストレングス効果を与える<br>"
		IF 奥義名 == "光の太刀"
			詳細文文字列受け渡し変数 += "敵単体に［650％］のダメージを与える。攻撃時、対象の防御力を［70％］無視する。"
		ELSE
			詳細文文字列受け渡し変数 += "敵単体に［500％］のダメージを与える。"
		ENDIF
	CASE "奥義前効果"
		; 奥義ダメージ発動前：自身に命中率+30%のバフを付与
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用文字列:バフ・デバフ枠 = 命中率
		アビ汎用文字列:バフ・デバフ対象能力 = 命中率
		アビ汎用変数:効果量 = 50
		アビ汎用変数:持続ターン = 1
		CALL アビテンプレート_有利効果_バフ効果セット

		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = ストレングス
		アビ汎用文字列:バフ・デバフ対象能力 = ストレングス
		アビ汎用変数:効果割合 = 30
		アビ汎用変数:持続ターン = 3
		; アビ汎用変数:特殊表示オプション = 1
		CALL アビテンプレート_有利効果_バフ効果セット

		; 強化後の「光の太刀」の場合、敵の防御力を70%無視するオプションを設定
		IF 奥義名 == "光の太刀"
			アビ汎用変数:防御無視オプション_割合 = 70
		ENDIF
	CASE "奥義追加効果"
		; 奥義ダメージ計算後の追加効果が必要な場合はここに記述
ENDSELECT
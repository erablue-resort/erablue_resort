
;=================================================
; アビリティ1：ボレアスパンチ
;=================================================
@固有アビ_3522_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ

消費ＭＰ = 15

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = ボレアスパンチ
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵単体に［150％］のダメージ。<br>
		詳細文文字列受け渡し変数 += "［75％］の確率で麻痺効果を付与（1ターン）。"
		RETURN 消費ＭＰ
	CASE "アビ説明文_詳細"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵単体に［150％］のダメージを与える。<br>
		詳細文文字列受け渡し変数 += "基本成功確率［75％］で対象に麻痺効果（1ターン）を付与する。"
	CASE "アビ効果"
		;-------------------------------------------------
		; 1. ダメージ処理（自属性）
		;-------------------------------------------------
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_敵単体
		アビ汎用変数:効果割合 = 150
		CALL アビテンプレート_ダメージ処理_自属性

		;-------------------------------------------------
		; 2. 不利効果（麻痺デバフ）処理
		;-------------------------------------------------
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 麻痺
		アビ汎用文字列:バフ・デバフ対象能力 = 麻痺
		アビ汎用変数:効果割合 = 100
		アビ汎用変数:持続ターン = 1
		アビ汎用変数:基礎成功確率 = 75
		CALL アビテンプレート_不利効果_デバフ効果セット
ENDSELECT


;=================================================
; パッシブ①：ターン開始時の闘気バフ更新
;=================================================
@固有行動開始時処理_キャラ_3522
#DIM キャラ番号
#DIM 現在MP割合
#DIM 攻撃力上昇量
#DIM クリティカル上昇量
#DIM 連続攻撃上昇量
#DIM 隊列番号
#DIM 追撃上昇量

キャラ番号 = GETCHARA(3522)
隊列番号 = キャラ隊列検索(キャラ番号)

; 残りMP割合の計算 (0～100%)
IF BATTLE_STATE:隊列番号:最大ＭＰ > 0
	現在MP割合 = BATTLE_STATE:隊列番号:ＭＰ * 100 / BATTLE_STATE:隊列番号:最大ＭＰ
ELSE
	現在MP割合 = 0
ENDIF


; MP割合に応じた倍率計算（最大時：攻撃力100%、会心率100%、连击率50%）
攻撃力上昇量 = 100 * 現在MP割合 / 100
クリティカル上昇量 = 100 * 現在MP割合 / 100
連続攻撃上昇量 = 50 * 現在MP割合 / 100
追撃上昇量 = 30 * 現在MP割合 / 100

; アビ汎用変数のリセット
CALL アビ対象選択テンプレート_自己のみ
CALL アビ汎用変数文字列リセット
; 闘気によるステータス上昇バフを付与/更新
アビ汎用文字列:バフ・デバフ枠 = 闘気
アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
アビ汎用変数:効果割合 = 攻撃力上昇量
アビ汎用変数:特殊表示オプション = 1
アビ汎用変数:消去不可オプション = 1
アビ汎用変数:持続ターン = 1
CALL アビテンプレート_有利効果_バフ効果セット

; クリティカル率UP
CALL アビ汎用変数文字列リセット
アビ汎用文字列:バフ・デバフ枠 = 闘気クリティカル率
アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
アビ汎用変数:効果量 = クリティカル上昇量
アビ汎用変数:持続ターン = 1
CALL アビテンプレート_有利効果_付随バフ効果セット("闘気")

; 連続攻撃率UP
CALL アビ汎用変数文字列リセット
アビ汎用文字列:バフ・デバフ枠 = 闘気連続攻撃率
アビ汎用文字列:バフ・デバフ対象能力 = 連続攻撃率
アビ汎用変数:効果量 = 連続攻撃上昇量
アビ汎用変数:持続ターン = 1
CALL アビテンプレート_有利効果_付随バフ効果セット("闘気")

CALL アビ汎用変数文字列リセット
アビ汎用文字列:バフ・デバフ枠 = 闘気追撃
アビ汎用文字列:バフ・デバフ対象能力 = 追撃
アビ汎用変数:効果割合 = 30
アビ汎用変数:持続ターン = 1
CALL アビテンプレート_有利効果_付随バフ効果セット("闘気")
;=================================================
; 闘気バフの特殊表示処理
;=================================================
@バフ・デバフ特殊表示_闘気(隊列番号, バフ・デバフ行数)
#DIM キャラ番号
#DIM 隊列番号
#DIM バフ・デバフ行数
#DIM 現在MP割合
#DIM 攻撃力上昇量
#DIM クリティカル上昇量
#DIM 連続攻撃上昇量
#DIM 追撃上昇量

VARSET LOCAL
キャラ番号 = GETCHARA(3522)
隊列番号 = キャラ隊列検索(キャラ番号)
; 隊列番号のリアルタイム戦闘状態から残りMP割合を算出
IF BATTLE_STATE:隊列番号:最大ＭＰ > 0
	現在MP割合 = BATTLE_STATE:隊列番号:ＭＰ * 100 / BATTLE_STATE:隊列番号:最大ＭＰ
ELSE
	現在MP割合 = 0
ENDIF

攻撃力上昇量 = 100 * 現在MP割合 / 100
クリティカル上昇量 = 100 * 現在MP割合 / 100
連続攻撃上昇量 = 50 * 現在MP割合 / 100
追撃上昇量 = 30 * 現在MP割合 / 100

PRINTL 闘気
HTML_PRINT @"攻撃力+{攻撃力上昇量}％、クリティカル率+{クリティカル上昇量}％、連続攻撃率+{連続攻撃上昇量}％ 追撃+{追撃上昇量}％"
PRINTL



@固有通常攻撃後処理_キャラ_3522(全滅フラグ, 連撃数)
#DIM 連撃数
#DIM 全滅フラグ
#DIM バフ・デバフ行数
#DIM 隊列番号
#DIM 消費MP_X

SIF 全滅フラグ
	RETURN 0

隊列番号 = キャラ隊列検索(GETCHARA(3522))

消費MP_X = BATTLE_STATE:隊列番号:ＭＰ * 1 / 400
SIF 消費MP_X < 1
	消費MP_X = 1

IF 連撃数 == 3
    BATTLE_STATE:隊列番号:ＭＰ -= 消費MP_X * 4
ELSEIF 連撃数 == 2
    BATTLE_STATE:隊列番号:ＭＰ -= 消費MP_X * 3
ELSE
    BATTLE_STATE:隊列番号:ＭＰ -= 消費MP_X * 2
ENDIF

;=================================================
; パッシブ②：被ダメージ時のMP消費＆バリア生成処理
;=================================================
@固有行動直後処理_キャラ_3522
#DIM 全滅フラグ
#DIM キャラ番号
#DIM 隊列番号
#DIM MP閾値
#DIM 消費MP_X
#DIM バリア耐久値

キャラ番号 = GETCHARA(3522)

隊列番号 = キャラ隊列検索(キャラ番号)

; 戦闘不能時または受击伤害<=0则不触发
SIF BATTLE_STATE:隊列番号:ＨＰ <= 0
	RETURN 0

; 残りMPが30%以上か判定
MP閾値 = BATTLE_STATE:隊列番号:最大ＭＰ * 30 / 100

IF BATTLE_STATE:隊列番号:ＭＰ >= MP閾値
	; 残りMPの1%をXとして計算（最低1点）
	消費MP_X = BATTLE_STATE:隊列番号:ＭＰ * 3 / 200
	SIF 消費MP_X < 1
		消費MP_X = 1
	
	; 実際に消費するMP（戦闘中のリアルタイムMPを減算）
	BATTLE_STATE:隊列番号:ＭＰ -= 消費MP_X
	
	; バリア耐久値 100 * X を計算
	バリア耐久値 = 25 * 消費MP_X
	
	; 自身にバリア効果を付与
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_自己のみ
	アビ汎用文字列:バフ・デバフ枠 = バリア
	アビ汎用文字列:バフ・デバフ対象能力 = バリア
	アビ汎用変数:効果量 = バリア耐久値
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_バフ効果セット
	VARSET アビテンプレート用_表示メッセージ格納:0:0
ENDIF



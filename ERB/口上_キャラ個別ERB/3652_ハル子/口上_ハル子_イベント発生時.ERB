;--------------------------------------------------
;うふふ終了時
;--------------------------------------------------
@KOJO_EVENT_うふふ終了_3652(対象キャラ, 終了原因)
#DIM 対象キャラ
#DIMS 終了原因
CALL 口上変数初期化

IF CFLAG:対象キャラ:体力限界
	;終了時にダウンしている
	KSTR:(K++) = 「はぁ、はぁ……絶倫すぎっしょ……
	IF 終了原因 == "全員ダウン"
		;全員ダウン時
		KSTR:(K++) = そのうちお客さん全員食いそうな勢いじゃん……」
	ELSE
		;他に生き残りがいる時
		KSTR:(K++) = もう時間？くっそぅ、最後まで立っていたかったぜい……」
	ENDIF
ELSE
	;終了時にダウンしていない
	SELECTCASE 終了原因
		CASE "通常終了"
			;逢引終了ボタンでの終了。最も一般的
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「ん、オシマイ？まだヤれそうって顔だけど……お仕事があるか。
					KSTR:(K++) = 　それとも、別のヤツに唾つけに行く？ ほどほどにしときなよ～」
				CASE 1
					KSTR:(K++) = 「あいよ、今日はここまでね。まだヤりたりないけどな～……
					KSTR:(K++) = 　いつでも声かけてよね」
					KSTR:(K++) = ハル子は_主人公_の耳元にキスをしてその場を後にした。
			ENDSELECT
		CASE "目撃される"
			;陥落していないキャラにうふふが目撃された
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……見られちった？ あーあ、せっかくの雰囲気が台無しじゃん……
					KSTR:(K++) = 部屋で続きでもする？」
				CASE 1
					KSTR:(K++) = 「おっと、誰か来た。いやー、間が悪いねぇ。
					KSTR:(K++) = 　見せつけたい？ トラブっても知らないよ？」
			ENDSELECT
		CASE "サウナ限界"
			;サウナ内でうふふ中、熱気ゲージがたまりすぎた時
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「あっつ……死ぬ死ぬ、さすがに死ぬ。
					KSTR:(K++) = 　続きはまた今度かねぇ」
				CASE 1
					KSTR:(K++) = 「だー、もう無理。あっついって！ お姉さん干からびちゃう。
					KSTR:(K++) = 　ほら、外に出よ。まずは水、冷たい水～」
			ENDSELECT
		CASE "あなた泥酔"
			;あなたが酔いすぎにより終了。"現在発生しないはず"
		CASE "不機嫌"
			;キャラが怒って終了。"現在発生しないはず"
	ENDSELECT
ENDIF


CALL 口上変数表示(対象キャラ, 0)


;****************************************
;ターン開始時や一日開始時・終了時に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「3652」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_3652(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 陥落チェック(対象キャラ)
	;陥落後
	SELECTCASE TIME
		CASE 5*60 TO 11*60
			;朝
			KSTR:(K++) = 「おはよ～。今日もお姉さんに会えて嬉しいっしょ？」
			KSTR:(K++) = 「_一人称_？ そりゃまあ……嬉しくなきゃ、わざわざ寄ってこねーって」
		CASE 11*60 TO 18*60
			;昼
			;KSTR:(K++) = 
		CASEELSE
			;夜
			;KSTR:(K++) = 
	ENDSELECT
ENDIF

IF K == 0
	;陥落前、または陥落後の本文が未記入の場合
	;挨拶の時間・内容は地の文では言及されないので適宜変更してもOK
	SELECTCASE TIME
		;朝　5時～11時
		CASE 5*60 TO 11*60
			LOCALS = 「おはよ～
		;昼　11時～18時
		CASE 11*60 TO 18*60
			LOCALS = 「ちわ。今日の調子はどぉ？
		;夜　それ以外
		CASEELSE
			LOCALS = 「この辺は夜風が涼しくていいね。
	ENDSELECT

	KSTR:(K++) = お姉さんの顔が見れて嬉しいっしょ？」
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;次のキャラの一文と区別したい場合は、下のコメントアウトを外すこと
;SIF K > 0
;	DRAWLINE


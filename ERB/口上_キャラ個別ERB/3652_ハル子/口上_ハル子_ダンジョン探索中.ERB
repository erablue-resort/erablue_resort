;--------------------------------------------------
;「仲間と会話」ボタン押下時
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_3652(対象キャラ)
#DIM 対象キャラ

;簡単に何度も見られるので、条件分岐やランダム化で複数パターンの登録を推奨

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)
SELECTCASE ダンジョン名
	CASE "名前を亡くした遺跡"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「古っくせえとこだなぁ。お宝でもあるといいけどサ」
				CASE 1
					KSTR:(K++) = 「_二人称_はこーゆー考古学とかに興味ある？ _一人称_には歴史のロマンとかはよく分からんね」
				CASE 2
					KSTR:(K++) = 「見通し悪いな～、壁とか全部ぶっ壊しながら進んじゃダメ？」
			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「古っくせえとこだなぁ。お宝でもなきゃやってらんないよ？」
				CASE 1
					KSTR:(K++) = 「_一人称_には歴史のロマンとかはよく分かんないな」
				CASE 2
					KSTR:(K++) = 「見通し悪いな～、壁とか全部ぶっ壊しながら進んじゃダメ？」
			ENDSELECT
		ENDIF
	CASE "バルツ地下廃工場"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ガッシャンガッシャンうるせ～……道はこっちであってんの？」
				CASE 1
					KSTR:(K++) = 「あち～……」
					KSTR:(K++) = ハル子は暑いと言いながら%CALLNAME:PLAYER%とベタベタ触れ合っている。
				CASE 2
					KSTR:(K++) = 「暑いところと涼しいところの寒暖差で風邪引きそ。
					KSTR:(K++) = 　オーナー様ぁん、あっちの涼しかった部屋でもうちょい休みましょうよぉん」
			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「ガッシャンガッシャンうるせ～……うちらって迷子じゃないよね？」
				CASE 1
					KSTR:(K++) = 「あち～……」
					KSTR:(K++) = ハル子は手を団扇のようにして自らに風を送っている。
				CASE 2
					KSTR:(K++) = 「暑いところと涼しいところの寒暖差で風邪引きそ。
					KSTR:(K++) = 　ねえ、水ってまだある？ 全部飲んでいい？」
			ENDSELECT
		ENDIF
	CASE "深海の古戦場跡"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「海の中を歩くってなんか変な感じすんね。ふぅん、ほぉん」
					KSTR:(K++) = ハル子はそばを泳ぐ魚をじっと眺めている。
				CASE 1
					KSTR:(K++) = 「突然息できなくなったらどうする？ なはは、冗談だって」
				CASE 2
					KSTR:(K++) = 「やぁん、おっきいお魚こわ～い_H_ サメとか_H_」
					KSTR:(K++) = ハル子はわざとらしく%CALLNAME:PLAYER%の腕にへばりついている。
			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「海の中を歩くってなんか変な感じすんね」
				CASE 1
					KSTR:(K++) = 「突然息できなくなったらどうする？ なはは、冗談だって」
				CASE 2
					KSTR:(K++) = 「財宝って本当に眠ってるのかい？ 骨折り損じゃなけりゃいいけど」
			ENDSELECT
		ENDIF
	CASE "風遊ぶ渓谷の参道"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = ハル子は山道を軽快に登っていく。
					KSTR:(K++) = 「ハイキングとか割と好きなんだよねー。アウトドア姉さんって呼んでくれや」
				CASE 1
					KSTR:(K++) = 「けっこう登ってきたね。休憩しなくて大丈夫？」
				CASE 2
					KSTR:(K++) = 「山小屋あんじゃん。どう？ ちょっと『休憩』していく？ ふふ……」
			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 意外にもハル子は山道を軽快に登っていく。
					KSTR:(K++) = 「ハイキングとか割と好きなんだよねー。アウトドア姉さんって呼んでくれや」
				CASE 1
					KSTR:(K++) = 「けっこう登ってきたね。休憩しなくて大丈夫？」
				CASE 2
					KSTR:(K++) = 「山小屋あんじゃん。どう？ ちょっと『休憩』していく？ なんつって」
			ENDSELECT
		ENDIF
	CASE "奈落の大空洞", "異界と化した洞窟"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「島にこんなどデケえ洞窟があったとはね。涼しいし、夏なら悪くないかも……
					KSTR:(K++) = 　いや、魔物いるから無理だわ」
				CASE 1
					KSTR:(K++) = 「やっほー……おー、すげえ反響してる」
				CASE 2
					KSTR:(K++) = 「けっこう魔物もいるね。前に出すぎないでよ、怪我するから」
			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「島にこんなどデケえ洞窟があったとはね。涼しいし、夏なら悪くないかも……

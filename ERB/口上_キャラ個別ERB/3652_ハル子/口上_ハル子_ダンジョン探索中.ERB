		ENDIF
	CASE "困りごと解決"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「こうやってウロウロしてると、仕事だって忘れそうになんねぇ。
					KSTR:(K++) = 　このままお姉さんとデートせんかな？ ダメ？ ちぇ」
				CASE 1
					KSTR:(K++) = 「みんな色々困ってんだねぇ。解決頑張れ、オーナーさん」
				CASE 2
					KSTR:(K++) = 「%CALLNAME:PLAYER%ってばお人好しなんだから。もっと部屋でイチャイチャさせろよ～」
			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0

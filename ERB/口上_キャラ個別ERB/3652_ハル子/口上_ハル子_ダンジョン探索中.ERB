				CASE 2
					KSTR:(K++) = 「くぁ……その辺で昼寝してから追いつくからさ、先行っといて……ぐぅ」
			ENDSELECT
		ENDIF
	CASE "薬草の群生地"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「虫がうっとおしいな～。オーナーさんはへーき？」
				CASE 1
					KSTR:(K++) = 「桜でも咲いてたら一杯やりたいとこだにゃあ。お酌してくれる？」
				CASE 2
					KSTR:(K++) = 「薬草～薬草や～い。呼んだら向こうから来てくれんかな」
			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「虫がうっとおしいな～。オーナーさん、なんか飛んできたら盾になってよ」
				CASE 1

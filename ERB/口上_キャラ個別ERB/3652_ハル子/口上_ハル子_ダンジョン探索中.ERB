			ENDSELECT
		ELSE
			;未陥落
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「開拓なんて工事現場の人の仕事じゃないの？ 人手がいないって大変だねぇ」
				CASE 1
					KSTR:(K++) = 「ちょっくらＢＢＱしてから行かない？」
				CASE 2
					KSTR:(K++) = 「たまには島をぶらぶらすんのも悪くないね」
			ENDSELECT
		ENDIF
	CASEELSE
		;その他の探索先
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「冒険なんてほっぽりだしてさ、その辺でお姉さんと不健全なことしない？」

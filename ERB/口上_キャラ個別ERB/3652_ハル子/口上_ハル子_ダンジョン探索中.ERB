				CASE 2
					KSTR:(K++) = 「薬草～薬草や～い。呼んだら向こうから来てくれんかな」
			ENDSELECT
		ENDIF
	CASE "リゾート島開拓作業"
		IF 口上_陥落判定_3652(対象キャラ, PLAYER)
			;陥落済み
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「開拓なんて工事現場の人にやらしゃあいいでしょぉ？ 後で埋め合わせ頼むわ」
				CASE 1

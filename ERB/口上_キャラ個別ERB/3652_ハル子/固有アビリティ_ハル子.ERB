; ハルハラ ハル子（キャラ番号3652）固有アビリティ・ファズ補充パッシブ
; 戦闘用の仮実装。効果量は実戦確認後に調整する。
; ファズは消去不可の独自刻印。最大3、戦闘終了で消える。
; 数値は仮設定。コスプレ技の毒ダメージと魅了の行動阻害率も調整対象。
; 2026-09-26: ターン開始時のファズ補充、スイングの段階強化・複数解除を追加。
; 戦闘中カウント:（ハル子の隊列）:自由枠１は、パッシブの判定済みターンに使用。

@固有アビ_3652_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 隊列番号
#DIM ファズ数
#DIM 効果数値１
#DIM 効果数値２
#DIM 効果数値３
#DIM 効果数値４
#DIMS アビ名

SELECTCASE 基礎BATTLE_STATE:キャラ番号:Lv
	CASE IS >= 20
		アビ名 = 無茶振りセッション＋＋
		消費ＭＰ = 40
		効果数値１ = 20
		効果数値２ = 12
		効果数値３ = 5
		効果数値４ = 25
	CASE IS >= 8
		アビ名 = 無茶振りセッション＋
		消費ＭＰ = 35
		効果数値１ = 15
		効果数値２ = 10
		効果数値３ = 4
		効果数値４ = 20
	CASE IS >= 1
		アビ名 = 無茶振りセッション
		消費ＭＰ = 30
		効果数値１ = 10
		効果数値２ = 5
		効果数値３ = 2
		効果数値４ = 15
	CASEELSE
		アビ名 =
		消費ＭＰ = 0
ENDSELECT
隊列番号 = キャラ隊列検索(キャラ番号)

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>自身のファズを1増やす（最大3）。追加効果は増加後のファズ数で判定する。
		詳細文文字列受け渡し変数 += @"<br>味方全体の攻撃力UP［{効果数値１}％/Ｂ枠/3ターン］、命中率UP［{効果数値２}％/Ｂ枠/3ターン］。"
		詳細文文字列受け渡し変数 += @"<br>◇ファズ1以上の時、更に弱体付与成功率UP［{効果数値２}％/Ｂ枠/3ターン］を追加。"
		詳細文文字列受け渡し変数 += @"<br>◇ファズ2以上の時、更にDA率UP［{効果数値２}％/Ｂ枠/3ターン］を追加。"
		詳細文文字列受け渡し変数 += @"<br>◇ファズ3の時、更にTA率UP［{効果数値３}％/Ｂ枠/3ターン］、クリティカル率UP［{効果数値４}％/Ｂ枠/3ターン］を追加。"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用文字列:バフ・デバフ対象能力 = ファズ
		アビ汎用変数:累積上限_固定値 = 3
		アビ汎用変数:特殊表示オプション = 1
		CALL アビテンプレート_刻印追加(1)
		ファズ数 = 刻印現在数確認("ファズ", 隊列番号)

		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方全体_生者のみ
		アビ汎用文字列:バフ・デバフ枠 = 攻撃力B
		アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
		アビ汎用変数:効果割合 = 効果数値１
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_バフ効果セット

		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 命中率B
		アビ汎用文字列:バフ・デバフ対象能力 = 命中率
		アビ汎用変数:効果量 = 効果数値２
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_バフ効果セット

		IF ファズ数 >= 1
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 弱体成功率B
			アビ汎用文字列:バフ・デバフ対象能力 = 弱体成功率
			アビ汎用変数:効果量 = 効果数値２
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF

		IF ファズ数 >= 2
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = DA率B
			アビ汎用文字列:バフ・デバフ対象能力 = DA率
			アビ汎用変数:効果量 = 効果数値２
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF

		IF ファズ数 >= 3
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = TA率B
			アビ汎用文字列:バフ・デバフ対象能力 = TA率
			アビ汎用変数:効果量 = 効果数値３
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット

			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = クリティカル率B
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
			アビ汎用変数:効果量 = 効果数値４
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
ENDSELECT


@固有アビ_3652_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 隊列番号
#DIM ファズ数
#DIM 防御低下率
#DIM 毒威力
#DIM 毒成功率
#DIM 魅了成功率
#DIM 魅了阻害率
#DIM スロウ成功率
#DIMS アビ名

SELECTCASE 基礎BATTLE_STATE:キャラ番号:Lv
	CASE IS >= 28
		アビ名 = コスプレショー＋＋
		消費ＭＰ = 40
		毒威力 = 100
		毒成功率 = 100
		魅了成功率 = 60
		スロウ成功率 = 100
	CASE IS >= 16
		アビ名 = コスプレショー＋
		消費ＭＰ = 35
		毒威力 = 75
		毒成功率 = 80
		魅了成功率 = 40
		スロウ成功率 = 90
	CASE IS >= 8
		アビ名 = コスプレショー
		消費ＭＰ = 30
		毒威力 = 50
		毒成功率 = 60
		魅了成功率 = 20
		スロウ成功率 = 80
	CASEELSE
		アビ名 =
		消費ＭＰ = 0
ENDSELECT
防御低下率 = 20
魅了阻害率 = 40
隊列番号 = キャラ隊列検索(キャラ番号)
ファズ数 = 刻印現在数確認("ファズ", 隊列番号)

SIF ファズ数 <= 0
	アビテンプレート用_アビ封印用フラグ = 1

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>ファズ1以上で使用可能。敵単体の防御力を{防御低下率}％下げる（Ｂ枠/3ターン/基礎成功率100％）<br>ファズを1消費。追加効果は消費前のファズ数で判定する。
		詳細文文字列受け渡し変数 += @"<br>◇ファズ1以上の時、毒［基礎成功率{毒成功率}％/3ターン］を追加。"
		詳細文文字列受け渡し変数 += @"<br>◇ファズ2以上の時、魅了［基礎成功率{魅了成功率}％/2ターン］を追加。"
		詳細文文字列受け渡し変数 += @"<br>◇ファズ3の時、スロウ［基礎成功率{スロウ成功率}％］を追加。"
		RETURN 消費ＭＰ
	CASE "アビ効果"
		IF アビ名 == "" || ファズ数 <= 0
			アビテンプレート用_キャンセルフラグ = 1
			RETURN
		ENDIF
		CALL アビ対象選択テンプレート_敵単体
		SIF アビテンプレート用_キャンセルフラグ
			RETURN

		アビ汎用文字列:バフ・デバフ枠 = 防御力B
		アビ汎用文字列:バフ・デバフ対象能力 = 防御力
		アビ汎用変数:効果割合 = 防御低下率
		アビ汎用変数:持続ターン = 3
		アビ汎用変数:基礎成功確率 = 100
		CALL アビテンプレート_不利効果_デバフ効果セット

		IF ファズ数 >= 1
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 毒
			アビ汎用文字列:バフ・デバフ対象能力 = 毒
			CALL バフ込み数値算出("攻撃力")
			アビ汎用変数:効果量 = RESULT * 毒威力 / 100
			アビ汎用変数:持続ターン = 3
			アビ汎用変数:基礎成功確率 = 毒成功率
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF

		IF ファズ数 >= 2
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 魅了
			アビ汎用文字列:バフ・デバフ対象能力 = 魅了
			アビ汎用変数:効果割合 = 魅了阻害率
			アビ汎用変数:持続ターン = 2
			アビ汎用変数:基礎成功確率 = 魅了成功率
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF

		IF ファズ数 >= 3
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果量 = 1
			アビ汎用変数:基礎成功確率 = スロウ成功率
			CALL アビテンプレート_不利効果_スロウ
		ENDIF

		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用文字列:バフ・デバフ対象能力 = ファズ
		CALL アビテンプレート_刻印減少(1)
ENDSELECT


@固有アビ_3652_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 隊列番号
#DIM 攻撃対象
#DIM ファズ数
#DIM 技倍率
#DIM ファズ毎属性強化
#DIM 属性強化量
#DIM 解除回数
#DIMS アビ名
#DIMS 自属性

; 技倍率: アビリティの強化段階ごとに固定。ファズ数では変化しない。
; ファズ毎属性強化: 消費ファズ1個につき加算する自属性強化（固定ポイント）。
; ファズによる火力変化は属性強化だけで表現する。解除回数も消費ファズ数を参照。
; ＋＋・ファズ3・他の属性強化なし: 350 * (100 + 30 * 3) / 100 = 665％相当。
SELECTCASE 基礎BATTLE_STATE:キャラ番号:Lv
	CASE IS >= 32
		アビ名 = ホームランスイング＋＋
		消費ＭＰ = 40
		技倍率 = 350
		ファズ毎属性強化 = 30
	CASE IS >= 24
		アビ名 = ホームランスイング＋
		消費ＭＰ = 30
		技倍率 = 300
		ファズ毎属性強化 = 25
	CASE IS >= 12
		アビ名 = ホームランスイング
		消費ＭＰ = 25
		技倍率 = 250
		ファズ毎属性強化 = 20
	CASEELSE
		アビ名 =
		消費ＭＰ = 0
		技倍率 = 0
		ファズ毎属性強化 = 0
ENDSELECT
隊列番号 = キャラ隊列検索(キャラ番号)
ファズ数 = 0
IF INRANGE(隊列番号, 0, 3)
	ファズ数 = MIN(3, MAX(0, 刻印現在数確認("ファズ", 隊列番号)))
ENDIF
属性強化量 = ファズ毎属性強化 * ファズ数

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵単体に自属性の［{技倍率}％］ダメージを1回与える。
		詳細文文字列受け渡し変数 += @"<br>ファズをすべて消費。攻撃前に、消費したファズ1につき自身の現在属性の攻撃を［{ファズ毎属性強化}％/独自枠/1ターン］強化"
		詳細文文字列受け渡し変数 += @"<br>攻撃前に、敵の解除可能な強化効果を［消費ファズ数］だけ解除する。"
		詳細文文字列受け渡し変数 += @"<br>ファズ0でも使用可能。"
		IF ダンジョン表示モード == "戦闘画面" && INRANGE(隊列番号, 0, 3)
			詳細文文字列受け渡し変数 += @"<br>現在のファズ：{ファズ数}／属性強化：＋{属性強化量}ポイント／強化解除：最大{ファズ数}個。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		IF アビ名 == "" || !INRANGE(隊列番号, 0, 3)
			アビテンプレート用_キャンセルフラグ = 1
			RETURN
		ENDIF
		CALL アビ対象選択テンプレート_敵単体
		SIF アビテンプレート用_キャンセルフラグ
			RETURN
		攻撃対象 = アビテンプレート用_対象保存:0

		IF ファズ数 > 0
			; 対象決定後に支払う。キャンセル時は消費しない。
			; 使用時のファズ数は保存済みなので、消費後も同じ値で属性強化量・解除回数を決める。
			; 撃破・反射などで後続処理が止まっても、支払いだけが抜けないよう先に消費する。
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ対象能力 = ファズ
			CALL アビテンプレート_刻印減少(ファズ数)

			自属性 '= 属性数値文字列変換(BATTLE_STATE:隊列番号:属性)
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = ホームランスイング_属性強化
			アビ汎用文字列:バフ・デバフ対象能力 = %自属性%強化
			アビ汎用変数:効果量 = 属性強化量
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット

			; 標準の1個解除をファズ数ぶん実行する。
			; 回数制のディスペルガードは各解除を防ぎ、そのたびに通常どおり回数を消費する。
			FOR 解除回数, 0, ファズ数
				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_指定(攻撃対象)
				CALL アビテンプレート_不利効果_バフ消去()
			NEXT
		ENDIF

		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_指定(攻撃対象)
		アビ汎用変数:効果割合 = 技倍率
		CALL アビテンプレート_ダメージ処理_自属性
ENDSELECT


@バフ・デバフ特殊表示_ファズ(隊列番号, バフ・デバフ行数)
#DIM 隊列番号
#DIM バフ・デバフ行数

LOCALS '= @"ファズ：{DT_CELL_GET("戦闘効果データベース", バフ・デバフ行数, "効果量_固定値")}／3（消去不可）<br>セッションや味方を巻き込むパッシブで高まる勢い。コスプレショーで1、ホームランスイングで全消費。奥義では消費しない。"
HTML_PRINT LOCALS


@探索欄表示_キャラ_3652(レイヤー番号, 隊列番号)
#DIM レイヤー番号
#DIM 隊列番号

GDRAWTEXT レイヤー番号, "ファズ：", 120, 90
GSETBRUSH レイヤー番号, 属性数値文字色変換_透明度込(BATTLE_STATE:隊列番号:属性)
GDRAWTEXT レイヤー番号, @"{刻印現在数確認("ファズ", 隊列番号)}/3", 200, 90

; ----------------------------------------------------------------------
; ファズ補充パッシブ「流れ星に乗って」
; 初回は戦闘開始時、2ターン目以降はターン開始時の標準フックから呼ぶ。
; 判定済みターンはハル子の戦闘中カウント:自由枠１で管理する。
; 本体の戦闘開始処理で戦闘中カウントが0にリセットされるため、戦闘をまたいで残らない。
; ----------------------------------------------------------------------
@固有戦闘開始時処理_キャラ_3652()
CALL ハル子_ターン開始時ファズ補充()
RETURN 0


@固有ターン開始時処理_キャラ_3652()
CALL ハル子_ターン開始時ファズ補充()
RETURN 0

@ハル子_ターン開始時ファズ補充()
#DIM 隊列番号
#DIM 検索隊列
#DIM 候補数
#DIM 味方候補, 4
#DIM 対象隊列
#DIM ファズ数
#DIM 発動率

SIF ダンジョン表示モード != "戦闘画面"
	RETURN 0

; 標準のキャラ別フックでは、戦闘行動キャラにそのキャラの隊列が入っている。
隊列番号 = 戦闘行動キャラ
SIF !INRANGE(隊列番号, 0, 3)
	RETURN 0
SIF BATTLE_STATE:隊列番号:キャラ登録番号 < 1
	RETURN 0
SIF NO:(BATTLE_STATE:隊列番号:キャラ登録番号) != 3652
	RETURN 0
SIF BATTLE_STATE:隊列番号:ＨＰ < 1
	RETURN 0

; 不発・対象なしの場合も、そのターンの判定は終了。同一ターンに再抽選しない。
SIF 戦闘中カウント:隊列番号:自由枠１ == 現在ターン数
	RETURN 0
戦闘中カウント:隊列番号:自由枠１ = 現在ターン数

候補数 = 0
VARSET 味方候補, -1
FOR 検索隊列, 0, 4
	SIF 検索隊列 == 隊列番号
		CONTINUE
	SIF BATTLE_STATE:検索隊列:キャラ登録番号 < 1
		CONTINUE
	SIF BATTLE_STATE:検索隊列:ＨＰ < 1
		CONTINUE
	味方候補:候補数 = 検索隊列
	候補数 += 1
NEXT

; 自分だけなら発動抽選もファズ追加も行わない。控えメンバーは対象に含めない。
SIF 候補数 == 0
	RETURN 0

ファズ数 = MIN(3, MAX(0, 刻印現在数確認("ファズ", 隊列番号)))
SELECTCASE ファズ数
	CASE 0
		発動率 = 50
	CASE 1
		発動率 = 30
	CASE 2
		発動率 = 15
	CASEELSE
		RETURN 0
ENDSELECT

SIF RAND:100 >= 発動率
	RETURN 0

; 他の生存戦闘メンバーから均等ランダム。2種類の低下は必ず同じ味方に付与する。
対象隊列 = 味方候補:(RAND:候補数)

CALL アビ汎用変数文字列リセット
アビテンプレート用_アビ名 = 流れ星に乗って
アビ汎用文字列:実行時メッセージ１ = %戦闘キャラ名前取得(隊列番号)%の「流れ星に乗って」！%戦闘キャラ名前取得(対象隊列)%を振り回し、調子を上げた！

;--------------------------------------------------
;一日終了時の夜這い失敗時
;--------------------------------------------------
@KOJO_夜這い失敗時_3652(対象キャラ, 相手キャラ)
#DIM 対象キャラ
#DIM 相手キャラ
CALL 口上変数初期化

SELECTCASE CSTR:対象キャラ:夜這い口上渡し_記録文字列
	CASE "まごまご"
		;夜這い経験が少なくてまごまごして帰っちゃった
		KSTR:(K++) = 「うーん、なんか気分乗らんしな……帰るか」
	CASE "不在"
		;相手が別の場所で寝てるなどで不在
		KSTR:(K++) = 「おーい、いないのー？ ったく、どこで寝てんのかね」
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;一日終了時の夜這い実行時
;--------------------------------------------------
@KOJO_夜這い実行時_3652(対象キャラ, 相手キャラ, 対象キャラZP, 相手キャラZP)
#DIM 対象キャラ
#DIM 相手キャラ
#DIM 対象キャラZP
#DIM 相手キャラZP
CALL 口上変数初期化

;この口上は夜這いの一番最後に表示される
;キャラのセリフや画像の表示はこちらを利用することを推奨

;対象キャラZPは本人が夜這いで得たZPの量、相手キャラZPは相手が夜這いで得たZPの量
;あんまり分岐の参考にはならないかもしれないけど一応

;また、RCVAR:対象キャラ:破瓜やRCVAR:対象キャラ:Ａ童貞喪失などはこのタイミングで使用可能

IF 相手キャラ == MASTER
	IF RCVAR:対象キャラ:破瓜
		KSTR:(K++) = 
	ELSE
		KSTR:(K++) = 「はぁー、はぁー……_H_ つっかれた……でも大満足～ってカンジ。
		KSTR:(K++) = 　片付け？ 明日でいいっしょ。じゃ、おやすみ……」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;夜這い時プレイ別口上
;--------------------------------------------------

;****************************************
;こちらは特定のプレイが発生した時、表示するメッセージを書き換えるための口上
;表示位置は一番上。プレイ別口上＞EXPやZPの入手＞夜這い実行時口上、と表示される
;基本的に自分と相手の両方が表示される

;長くても３行くらいで留めることを推奨、画像の表示は非推奨

;引数の快楽基礎値は、受けている快楽の大きさを判定するためのもの
;計算式は「自分の快楽基礎値 = 1 + ABL:夜這い相手:技巧 + ABL:夜這い相手:指テク + ABL:夜這い相手:舌技」
;性交系のプレイだとさらにABL:夜這い相手:腰使いが加算される

;要するに技巧は最大１０，他は最大５なのでどれだけ育成しても26が最大値
;普通は10前後くらいで考えると良い
;****************************************

;--------------------------------------------------
;夜這い_基本愛撫
;--------------------------------------------------
@KOJO_夜這い時プレイ_基本愛撫_3652(対象キャラ, 相手キャラ, 対象キャラ_快楽基礎値, 相手キャラ_快楽基礎値)
#DIM 対象キャラ
#DIM 相手キャラ
#DIM 対象キャラ_快楽基礎値
#DIM 相手キャラ_快楽基礎値
CALL 口上変数初期化

;確実に発動する基本的ないちゃつき

IF 相手キャラ == MASTER
	KSTR:(K++) = 「こうしてイチャつくのも悪くね～だろ？オーナーさんよう」
ELSE
	KSTR:(K++) = 「たまにはこうやってダラつくのも悪くねーだろ？」
ENDIF
KSTR:(K++) = ハル子は%CALLNAME:相手キャラ%の手を取り、自らの身体に引き寄せた。

;表示処理は大元で組んでいるため、口上変数表示を呼ぶ必要はない


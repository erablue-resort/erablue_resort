;・使い方
;キャラクター番号は3652に設定済み。各関数に処理を入れる
;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_3652(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、通常時の画面で表示されるので
;基本的にWAIT系列は使わないことを推奨
;また、一行のみの表示を想定。二行以上は基本的に禁止
;※うふふ中には表示されません

;以下は分岐の例
;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	KSTR:(K++) = 
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = 「はいはい、受付はこっちだぜ。泊まるの？　遊ぶの？」
		CASE 2
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「バーテンって思ったより楽しくねえな……」
		CASE 3
			;図書室で司書中
			KSTR:(K++) = 「本探してんの？　司書サマにタイトルくらい教えなって」
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 「走んなよー。溺れたら監視員サマの仕事が増えるだろ」
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = 「……あん？ なんでリゾートで漁師やってんだ？」
		CASE 6
			;遊覧船・海底散歩でシーガイド中
			KSTR:(K++) = 
		CASE 100 TO 199
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 100):0}(現在仕事:対象キャラ:1 - 100)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「道具屋は営業中。欲しいモンあるならそこから選びな」
				CASE "土産物屋"
					KSTR:(K++) = 「土産ならこっちこっち。帰ってから話のタネになるヤツは～……」
				CASE "食事処"
					KSTR:(K++) = 「食事処はこっちだぜ。腹減ってんなら座って待ってな」
				CASE "装飾品店"
					KSTR:(K++) = 「アクセ探してんの？ アタシが似合うの見繕ってやるよ」
				CASE "直売所"
					KSTR:(K++) = 「産地直送の直売所だぜぃ。今日入ったヤツから持ってきな、鮮度は保証する」
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置
;状況で分岐

IF CFLAG:対象キャラ:飲み会
	;飲み会中
	KSTR:(K++) = 「がっはっは、もう一杯持ってこんかぁーい！」
ELSEIF CFLAG:対象キャラ:睡眠
	;ダウン・睡眠中
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「も、無理……死……」
;	ELSEIF 陥落チェック_性的(対象キャラ) && RAND:3
;		;寝言で甘えさせたい場合
;		KSTR:(K++) = 
	ELSE
		KSTR:(K++) = 「zzz……」
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中
	;デートの相手のキャラ番号 + 100が入っている
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	KSTR:(K++) = 「次はどこ行くよ。え、_一人称_が行きたいところ？ カッコつけやがって……」
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	;一緒に遊ぶ中
	KSTR:(K++) = 「ういー！ _一人称_の勝っちぃ！ 次も負けねえぞぉ？」
ELSEIF CFLAG:対象キャラ:同行
	;同行中
	KSTR:(K++) = 「お、あっちに面白そうなもんあんじゃん。ほらついてきなよ」
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;一緒に隠密中
	KSTR:(K++) = 「木に変装するんなら任せな！」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	;あなたが隠れていて、キャラはあなたに気づいていない
	KSTR:(K++) = 「んー……？この辺であいつ見た気がしたんだけどな……」
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;キャラの野外オナニー中
	KSTR:(K++) = 
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「今日はあいつと何して遊ぼっかな～と……」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「今日は何して遊ぼっかな～と……」
			CASEELSE
				KSTR:(K++) = 「リゾート最高～、ずっとここに住んでてぇな……」
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「ま、たまにはあいつの顔を立てて真面目に働きますかね」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「真面目に仕事なんて、_一人称_もヤキが回ってきたか？」
			CASEELSE
				KSTR:(K++) = 「昼寝でもするかねぇ」
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「まさか_一人称_がここまでゾッコンになるとはな……」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「気になってる？ _一人称_が？ あいつを？」
			CASEELSE
				KSTR:(K++) = 「テキトーにからかってやろっと」
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				KSTR:(K++) = 「……身体が火照ってしゃーねえ。絶対あいつのせいだろ……」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				KSTR:(K++) = 「ねんごろってのも悪くないか。あとは後腐れさえなければ……」
			CASEELSE
				KSTR:(K++) = 「むふふ、お姉さんの魅力にやられちまったかぃ？」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)



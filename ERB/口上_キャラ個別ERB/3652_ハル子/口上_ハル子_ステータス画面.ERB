@口上_ステータス画面_友情コメント_3652(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;基本的にWAIT系列は使わないことを推奨

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「なーんも知らんもん」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「ギリ判別できるくらいかな」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「フツーに知り合い？」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「リゾ友？ へっ、ガラじゃないって」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「まぁ、退屈はしないかな」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「まだまだ知らないこと教えてよ」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


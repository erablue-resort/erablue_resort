;RFLAG:コマンド結果受渡し変数２ に実際の料金が入る

;各種性処理の_非口上時メッセージを参考に記述すると良い
;--------------------------------------------------
;選択肢前
;--------------------------------------------------
@KOJO_COM_3652_315_BEFORE(対象キャラ)
#DIM 対象キャラ

CALL 口上変数初期化

IF 口上_関係性判定_3652(対象キャラ, PLAYER, "恋慕")
	;恋慕
	KSTR:(K++) = 「え～、イメプ？ イイけどさ……」
ELSEIF 口上_関係性判定_3652(対象キャラ, PLAYER, "セフレ")
	;セフレ
	KSTR:(K++) = 「普通にヤるだけじゃ物足りないってか？ いいよ、なんなら着替えようか？」
ELSE
	;陥落なし・その他
	KSTR:(K++) = 「性処理業務ぅ？ オーナーさんってばハル子さんのフェロモンにアテられちゃったぁ？
	KSTR:(K++) = 　ま、いいよ。おっぱじめようぜぃ」
ENDIF


CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;振り分け処理
;--------------------------------------------------
@KOJO_COM_3652_315(対象キャラ)

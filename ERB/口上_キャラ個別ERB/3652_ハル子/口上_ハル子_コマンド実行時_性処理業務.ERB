;仕様上、性処理業務は全て同じコマンド扱いなのでここで分岐させる
;この関数は編集しないことを推奨
SELECTCASE RSTR:コマンド結果受渡し文字列
	CASE "手コキ処理"
		TRYCALLFORM KOJO_性処理_3652_手コキ処理(対象キャラ)
	CASE "パイズリ処理"
		TRYCALLFORM KOJO_性処理_3652_パイズリ処理(対象キャラ)
	CASE "フェラチオ処理"
		TRYCALLFORM KOJO_性処理_3652_フェラチオ処理(対象キャラ)
	CASE "手マン処理"
		TRYCALLFORM KOJO_性処理_3652_手マン処理(対象キャラ)
	CASE "クンニ処理"
		TRYCALLFORM KOJO_性処理_3652_クンニ処理(対象キャラ)
	CASE "セックス処理"
		TRYCALLFORM KOJO_性処理_3652_セックス処理(対象キャラ)
	CASE "被セックス処理"
		TRYCALLFORM KOJO_性処理_3652_被セックス処理(対象キャラ)
	CASE "アナルセックス処理"
		TRYCALLFORM KOJO_性処理_3652_アナルセックス処理(対象キャラ)
	CASE "被アナルセックス処理"
		TRYCALLFORM KOJO_性処理_3652_被アナルセックス処理(対象キャラ)
ENDSELECT


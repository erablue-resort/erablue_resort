;--------------------------------------------------
;COM405 観察する
;--------------------------------------------------
@KOJO_COM_3652_405(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		;誰も隠密してない
		KSTR:(K++) = 「ん？キョロキョロしてどしたん？」
	CASE 1
		;誰かが隠密している
		KSTR:(K++) = 「なんか物音するよね。誰かいた？」
		;正直0と1はキャラの観察結果としては分けなくていいかも
	CASE 10
		;起床までの残り時間
		;寝言とか言う感じかな？
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS > 180
				;3時間以上
				KSTR:(K++) = 「zzz……」
			CASE IS > 90
				;3時間以下
				KSTR:(K++) = 「んぐぉ……アトムスク……」
			CASE IS > 30
				;90分以下
				KSTR:(K++) = 「そんな飲めんて……スペースシャトル……」
			CASEELSE
				;30分以下
				KSTR:(K++) = 「んー……ん……たっく……？」
		ENDSELECT
	CASE 11
		;睡眠＋ダウン、スコアの多さで分岐
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS >= 400
				;めちゃくちゃにされてる
				KSTR:(K++) = 「……………………_H_」
			CASE IS >= 20
				;結構がっつり
				KSTR:(K++) = 「うっ、ん、ぉ……_H_」
			CASEELSE
				;体力付きたけど割と穏やか、あんまり来ないかも
				KSTR:(K++) = 「うへへ……すぴー……」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


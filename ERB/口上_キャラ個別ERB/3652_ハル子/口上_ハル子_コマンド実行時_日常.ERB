				KSTR:(K++) = 「……次も、暇だったら呼んで」
			CASE 3
				KSTR:(K++) = 「んじゃ、今日はここまでね」
				KSTR:(K++) = ハル子はいつもの調子で笑いながら、一歩だけ後ろへ下がった。
				KSTR:(K++) = 「……あんま見んなって。なんか調子狂う。
				KSTR:(K++) = 　ほら、またな」
		ENDSELECT
	ELSE
		;未恋慕・セフレ
		SELECTCASE RAND:6
			CASE 0
				KSTR:(K++) = 「えー、もう終わり？
				KSTR:(K++) = 　お姉さんまだ遊べるんですケドぉ。
				KSTR:(K++) = 　ま、いっか。次はもうちょい長めでよろしく～」
			CASE 1
				KSTR:(K++) = 「はい解散ね。お疲れさーん。
				KSTR:(K++) = 　結構楽しかったじゃん。次どこ行くか考えといてよ」
			CASE 2
				KSTR:(K++) = 「ん、今日はこんなもん？
				KSTR:(K++) = 　じゃ次はもっと変なとこ行こうぜ。普通のデートとか飽きるし。
				KSTR:(K++) = 　面白そうなの見つけたら連絡よろ～」
			CASE 3
				KSTR:(K++) = 「もう帰んの？ 体力ねぇなぁ」
				KSTR:(K++) = ハル子はからかうように笑いながら、_主人公_の肩を軽く叩いた。
				KSTR:(K++) = 「ま、楽しかったよ。ごくろーさん」
			CASE 4
				KSTR:(K++) = 「もう終わり？ _一人称_ってば疲れちゃってぇ……どこかで休憩していかない？」
				KSTR:(K++) = 普通は立場が逆ではないだろうか。
			CASE 5
				KSTR:(K++) = 「えー、もうお開き？ お姉さんまだ遊べるんですケドぉ。
				KSTR:(K++) = 　しゃーないか。次はもーちょいのんびりしたやつ、頼むよな」
		ENDSELECT
	ENDIF
ELSE
	;通常の同行終了
	IF 陥落チェック_恋慕系(対象キャラ)
		;恋慕後
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「ん、ここで別れる？
				KSTR:(K++) = 　じゃ……まあ、またあとで」
				KSTR:(K++) = ハル子は一度歩き出してから、振り返るでもなく軽く手を上げた。
			CASE 1
				KSTR:(K++) = 「はいはい、今日はここまでね。
				KSTR:(K++) = 　……なんだよ。別にすぐまた会うっしょ」
				KSTR:(K++) = そう言う割に、ハル子はなかなかその場を離れようとしなかった。
			CASE 2
				KSTR:(K++) = 「じゃ、_一人称_はこっち行くわ」
				KSTR:(K++) = 数歩進んだところで、ハル子はふと足を止めた。
				KSTR:(K++) = 「……またなんかあったら呼んで。暇なら行くから」
			CASE 3
				KSTR:(K++) = 「んじゃーね」
				KSTR:(K++) = ハル子はいつものように軽く手を振った。
				KSTR:(K++) = 「……あー、いや。なんでもない。
				KSTR:(K++) = 　ほら、行った行った」
		ENDSELECT
	ELSE
		;未恋慕・セフレ
		SELECTCASE RAND:5
			CASE 0
				KSTR:(K++) = 「ん、今日はここまで？
				KSTR:(K++) = 　じゃーね。また暇だったら呼んでよ」

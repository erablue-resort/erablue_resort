			KSTR:(K++) = 「……で、デートなんだよね。これ」
		CASE 2
			KSTR:(K++) = 「今日？
			KSTR:(K++) = 　……まあ、暇だし。別に予定もないし。
			KSTR:(K++) = 　だからそんな嬉しそうな顔すんなって。調子狂うじゃん」
		CASE 3
			KSTR:(K++) = 「あー……そういうの、ちゃんと誘うんだ。
			KSTR:(K++) = 　……いいよ。行こ」
			KSTR:(K++) = ハル子はそれ以上何も言わず、少しだけ視線を逸らした。
		CASE 4
			KSTR:(K++) = 「デートぉ？
			KSTR:(K++) = 　……ったく。そういう顔で言われると断りづらいっつーの。
			KSTR:(K++) = 　お、おらぁ！さっさと行くぞぉ！」
	ENDSELECT
ELSE
	;恋慕前・セフレ
	SELECTCASE RAND:5
		CASE 0
			KSTR:(K++) = 「デート？ いいぜぇ、楽しませてくれるんだろ？
			KSTR:(K++) = 　退屈させたら途中で帰るから、そのつもりで～」
		CASE 1
			KSTR:(K++) = 「お、デートのお誘い？
			KSTR:(K++) = 　いいねいいね。飯？ 遊び？ それとも両方？
			KSTR:(K++) = 　とりあえず腹減ったから、なんか食おうぜ」
		CASE 2
			KSTR:(K++) = 「へぇ～、_二人称_からデートに誘ってくんだ。
			KSTR:(K++) = 　なになに、ついにハル子さんを口説き落とす気になった？
			KSTR:(K++) = 　なはは。冗談冗談。行こーぜ」
		CASE 3
			KSTR:(K++) = 「いいよ。ちょうど暇してたし。
			KSTR:(K++) = 　あ、でも行き先は任せるからね。ハズレだったら文句言うけど。
			KSTR:(K++) = 　ほら、エスコートよろしくぅ」
		CASE 4
			KSTR:(K++) = 「デートねぇ。いいじゃん。
			KSTR:(K++) = 　せっかくだし、普段行かないとこ行こうぜ。
			KSTR:(K++) = 　なんか面白いもん見つけたら寄り道な。予定？ 知らん知らん」
	ENDSELECT
ENDIF


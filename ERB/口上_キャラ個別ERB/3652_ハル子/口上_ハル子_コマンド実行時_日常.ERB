;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「3652」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
	;-2の場合は会話出来なかった扱いなので何も言わないのがいいかも
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_3652_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 陥落チェック(対象キャラ)
	;陥落後
	IF TALENT:対象キャラ:恋慕
	;恋慕
		SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			;大失敗
			;KSTR:(K++) = 
		CASE -1
			;失敗
			;KSTR:(K++) = 
		CASE 0
			;通常成功
			SELECTCASE RAND:4
				CASE 0
					KSTR:(K++) = 「んで、今日は何してたん？
					KSTR:(K++) = 　いや、別に監視とかじゃねーって。ちょっと聞きたいだけ」
				CASE 1
					KSTR:(K++) = 「へぇ。それでそれで？」
					KSTR:(K++) = ハル子は珍しく茶々を入れず、興味深そうに_主人公_の話を聞いている。
				CASE 2
					KSTR:(K++) = 「今日はそっちが喋れよ。お姉さん聞く側やるから
					KSTR:(K++) = 　……たまにはいいじゃん。_二人称_のこと知んのもさ」
				CASE 3
					KSTR:(K++) = 「あ、そういや昨日の話どうなった？」
					KSTR:(K++) = _主人公_が聞き返すと、ハル子は少し眉を上げた。
					KSTR:(K++) = 「覚えてるに決まってんじゃん。聞いてたっつーの」
			ENDSELECT
		CASEELSE
			;大成功
			KSTR:(K++) = 「んで？ その話の続きは？
			KSTR:(K++) = 　あー、仕事？ そんなの後でいいって。今いいとこなんだからさ」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ && RAND:2
	;セフレかつ50%
			SELECTCASE RAND:6
			CASE 0
				KSTR:(K++) = 「そういやさぁ、昨日あのあとちゃんと寝れた？
				KSTR:(K++) = 　お姉さん？ ぐっすり。運動した後はよく眠れるねぇ」
			CASE 1
				KSTR:(K++) = 「ねえ、前から聞こうと思ってたんだけどさ……
				KSTR:(K++) = 　_二人称_って、ベッドだと妙に欲張りになるよね？」
			CASE 2
				KSTR:(K++) = 「あー、なんか腰だる……」
				KSTR:(K++) = ハル子はこちらを見て、にまにましながら当てつけのように腰を擦っている。
			CASE 3
				KSTR:(K++) = 「今だから聞けるけど、_二人称_ってどこまでならアリなん？ＮＧとかあんの？
				KSTR:(K++) = 　いやいや、純粋な興味。今後の参考ってやつ？」
			CASE 4
				KSTR:(K++) = 「こういう話、普通の相手にはしづらいじゃん？
				KSTR:(K++) = 　その点_二人称_は楽でいいわ。今さら取り繕っても仕方ねーし」
			CASE 5
				KSTR:(K++) = 「んー……今夜ヒマ？
				KSTR:(K++) = 　なんでって……そりゃ、言わせんなよ。察しろって」
		ENDSELECT
	ELSE
	ENDIF
ENDIF

IF K == 0
	;陥落前、または陥落後の本文が未記入の場合
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
			KSTR:(K++) = 「ねー、他の連中とも話してみたら？_一人称_とばっか喋ってたら、他の連中が嫉妬しちゃうかもよ」
		CASE -1
			;失敗
			SELECTCASE RAND:13
				CASE 0
					KSTR:(K++) = 「全てが氷のリゾート、こおリゾート」
				CASE 1
					KSTR:(K++) = 「お茶に感謝、かん茶」
				CASE 2
					KSTR:(K++) = 「シュールなプール、プールレアリズム」
				CASE 3
					KSTR:(K++) = 「薬草を取ってくる約束、やくそぅく」
				CASE 4
					KSTR:(K++) = 「遺跡のいー席取っといて」
				CASE 5
					KSTR:(K++) = 「エルーンが増えるーん」
				CASE 6
					KSTR:(K++) = 「短剣持って探検」
				CASE 7
					KSTR:(K++) = 「斧におののく」
				CASE 8
					KSTR:(K++) = 「鎌を構えてみた」
				CASE 9
					KSTR:(K++) = 「団長の断腸の思い」
				CASE 10
					KSTR:(K++) = 「商人の承認欲求」
				CASE 11
					KSTR:(K++) = 「槍を持ってやりたい放題」
				CASE 12
					KSTR:(K++) = 「岸にいる騎士」
			ENDSELECT
			KSTR:(K++) = 油断していたらハル子につまらないオヤジギャグを言われてしまった。
		CASE 0
			;通常成功
			SELECTCASE RAND:6
				CASE 0
					KSTR:(K++) = 「ふっ、あはは！ そんなことある？ フツー！」
				CASE 1
					KSTR:(K++) = 「んー、腹減った。なんか食いに行こーぜ。
					KSTR:(K++) = 　あ、_二人称_の奢りね。誘ったのはあたしだけどさ」
					KSTR:(K++) = ハル子は当然みたいにそう言って、_主人公_の背中をばんばん叩いた。
				CASE 2
					KSTR:(K++) = 「ねえ、ここの客って夜中に何してんの？ まさか寝てんの？
					KSTR:(K++) = 　もったいなー。夜中の二時くらいが、一番くだらねーこと思いつく時間じゃん。
					KSTR:(K++) = 　今度なんかやろうぜ。怒られたら、オーナー権限で適当に揉み消してよ」
				CASE 3
					KSTR:(K++) = ハル子は話の途中で_主人公_の肩に腕を乗せ、そのまま遠慮なく体重を預けてきた。
					KSTR:(K++) = 「ん？ 重いって？
					KSTR:(K++) = 　細けぇなあ。ほら、こんな美人に引っ付かれるなんて役得っしょ？」
					KSTR:(K++) = そう言って気だるげに笑うと、ハル子は何事もなかったように話を続けた。
				CASE 4
					KSTR:(K++) = 「そういやさ、_二人称_。あたしのベスパ、ちょっと興味ありげ？
					KSTR:(K++) = 　今度後ろ乗せたげよっか。振り落とされても、まあ知らんけど。
					KSTR:(K++) = 　怖かったらちゃんと掴まっとけよ？ ……あたしじゃなくて車体にな。勘違いすんなよ」
				CASE 5
					KSTR:(K++) = 「_二人称_って、案外ヒマだよね。よく_一人称_の話なんかに付き合ってられるわ。」
					KSTR:(K++) = ハル子はそう言いながら、_主人公_の肩を軽く小突いた。
					KSTR:(K++) = 「まあ、悪くないけどさ。こういうどーでもいい話すんの」
			ENDSELECT
		CASEELSE
			;大成功
			KSTR:(K++) = 「_二人称_と話してると、なーんか時間忘れちゃうわ」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM301_お茶を淹れる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;その場にいる全員が対象だが、口上は対面している相手のみ

@KOJO_COM_3652_301(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「あっつ！ 大将、こりゃあちょっと熱すぎるぜぃ……」
			CASE 1
				KSTR:(K++) = 「あっつ……舌やけどしたじゃん。
				KSTR:(K++) = 　責任取ってなんか冷たいもん持ってきてよ」
			CASE 2
				KSTR:(K++) = 「にっが……これお茶だよね？ 薬じゃないよね？
				KSTR:(K++) = 　まあ飲むけどさ。せっかく淹れてくれたし」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「うむ、苦しゅうない……なんてね。ありがと」
			CASE 1
				KSTR:(K++) = 「お、気が利くじゃん。ちょうど喉乾いてたんだよね。
				KSTR:(K++) = 　ついでになんか甘いもんない？」
			CASE 2
				KSTR:(K++) = 「さんきゅ。こういうの勝手に出てくんの、いい生活だねぇ……
				KSTR:(K++) = 　ここ住み着いたら毎日やってくれんの？」
			CASE 3
				KSTR:(K++) = ハル子は受け取った茶を一口すすり、満足そうに息を吐いた。
				KSTR:(K++) = 「ん、悪くない。
				KSTR:(K++) = 　こういう何でもない時に飲むのが一番うまいんだよね」
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「美味し……こいつぁお茶っ葉がいいのか、それとも腕がいいのかな？」
			CASE 1
				KSTR:(K++) = 「お、うま。ちゃんとしてんじゃん。
				KSTR:(K++) = 　これ毎日やってくんない？ ハル子さん、味にはうるさいよ～？」
			CASE 2
				KSTR:(K++) = 「ほぉん、これ茶屋でもできる出来じゃなーいー？
				KSTR:(K++) = 　じゃ、ハル子さん常連第一号ってことで。ツケといて」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


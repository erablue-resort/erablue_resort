;--------------------------------------------------
;COM402 就寝
;--------------------------------------------------
;あなたが寝る時、一緒にいるキャラが喋る
@KOJO_COM_3652_402(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF CFLAG:対象キャラ:睡眠 == 0
	;寝てない時に喋る
	IF 陥落チェック_恋慕系(対象キャラ)
		;恋慕後
		SELECTCASE RAND:5
			CASE 0
				KSTR:(K++) = 「もう寝る？
				KSTR:(K++) = 　……ん。じゃ、おやすみ」
				KSTR:(K++) = ハル子は何か言いかけたようだったが、そのまま軽く手を振った。
			CASE 1
				KSTR:(K++) = 「眠そうだねぇ。さっさと寝な。
				KSTR:(K++) = 　……ちゃんと布団かぶれよ。風邪引いても知らんぞ。
				KSTR:(K++) = 　いや、別に心配してるとかじゃ……あー、もういい。おやすみ」
			CASE 2
				KSTR:(K++) = 「んじゃ、あたし邪魔になる前に退散しますか。
				KSTR:(K++) = 　……なに。前は居座ってたじゃん、とか言うなよ。
				KSTR:(K++) = 　今日はそういう気分なの。ほら寝ろ寝ろ」
			CASE 3
				KSTR:(K++) = 「もう寝ちゃうカンジ？
				KSTR:(K++) = 　……そっか」
				KSTR:(K++) = ハル子は少しだけ名残惜しそうに_主人公_を見たあと、すぐいつもの調子で笑った。
				KSTR:(K++) = 「んじゃ、おやすみ。また明日な」
			CASE 4
				KSTR:(K++) = 「もう寝ちゃうカンジ？ ……寝てる間に、ちょっと触ってもいい？」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		;セフレ
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「もう寝ちゃうの？
				KSTR:(K++) = 　身体が火照った_一人称_をうっちゃっておくなんて～……なんてな。
				KSTR:(K++) = 　はいはい、おやすみ」
			CASE 1
				KSTR:(K++) = 「寝る前になんか忘れてない？」
				KSTR:(K++) = ハル子は意味ありげに笑ってから、すぐ肩をすくめた。
				KSTR:(K++) = 「なはは。冗談だって。いい夢見ろよ～」
			CASE 2
				KSTR:(K++) = 「もう店じまい？ 健康的だねぇ。
				KSTR:(K++) = 　ま、夜更かしして明日ヘロヘロになられても困るか。
				KSTR:(K++) = 　おやすみ、オーナーさん」
			CASE 3
				KSTR:(K++) = 「はいはい、おねんねの時間ね。
				KSTR:(K++) = 　添い寝でもしてほしい？ 別料金だけど。
				KSTR:(K++) = 　……その顔やめろ。ホントに請求すんぞ」
		ENDSELECT
	ELSE
		;未恋慕
		SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 「あー、寝るカンジ？
				KSTR:(K++) = 　あい、おやすみ～。明日起きなかったら蹴り起こすから」
			CASE 1
				KSTR:(K++) = 「もう寝んの？ 早くね？
				KSTR:(K++) = 　まあいいや。_一人称_はもうちょい起きてるわ。
				KSTR:(K++) = 　なんか面白いこと思いついたら起こすね」
			CASE 2
				KSTR:(K++) = 「お、就寝ですかオーナー殿。
				KSTR:(K++) = 　ではハル子さんがありがたーい子守唄を……
				KSTR:(K++) = 　……いらない？ ちぇ。おやすみ」
			CASE 3
				KSTR:(K++) = 「眠そうな顔してんなぁ」
				KSTR:(K++) = ハル子は_主人公_の頭を軽くわしゃわしゃと撫でた。
				KSTR:(K++) = 「ほら、さっさと寝ろ。いい子いい子。
				KSTR:(K++) = 　なはは。怒んなって。おやすみ～」
		ENDSELECT
	ENDIF
ENDIF


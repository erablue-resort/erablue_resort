	;11,料理人  12,歴史知識  13,経営知識  14,水泳技能  15,農業知識
;知識素質:(RFLAG:コマンド結果受渡し変数２)でキャラの知識のLv値が得られる
	;教えられるのは「そのキャラが持っている知識素質が、あなたよりLvが高い時のみ」なので、持っていない知識に関して記述する必要はない

@KOJO_COM_3652_304(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RAND:2
	CASE 0
		KSTR:(K++) = 「_一人称_から勉強を教わりたいぃ？本気？
		KSTR:(K++) = 　オーナー命令ってんならしゃーないか。じゃあ淫乱な家庭教師の服に着替えてくるから」
	CASE 1
		KSTR:(K++) = 「どれどれ、お姉さんに教わりたいって？ いい心がけじゃーん。
		KSTR:(K++) = 　先にメガネ取ってこよ。こういうの、カッコから入らないとねぇ」
ENDSELECT

;ここから先で専用口上が追加されたか確認するため、現在のKを保存
LOCAL = K

SELECTCASE RFLAG:コマンド結果受渡し変数２
	CASE 1
		;調合知識
	CASE 2
		;魔法知識
	CASE 3
		;機械知識
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE -1
				;失敗
				KSTR:(K++) = 「あーあー、そこ無理やり回すなって。ネジ山ナメるぞ」
				KSTR:(K++) = ハル子は_主人公_の手から工具を取り上げると、慣れた手つきで部品を外してみせた。
				KSTR:(K++) = 「ほら、力じゃなくて順番。壊して覚えるにも限度ってもんがあんの」
			CASE 0
				;通常成功
				KSTR:(K++) = 「そうそう。そこ押さえながら、こっち回して……お、できんじゃん」
				KSTR:(K++) = ハル子は覗き込むように手元を確認すると、満足そうに頷いた。
				KSTR:(K++) = 「これならベスパ弄る時、工具くらい任せてもいいかもね」
			CASEELSE
				;大成功
				KSTR:(K++) = 「へぇ、やるじゃん。そこ気づくとは思わなかったわ」
				KSTR:(K++) = ハル子は_主人公_の組み上げた部品をしげしげと眺め、軽く指で弾いた。
				KSTR:(K++) = 「よし。今度ベスパ開ける時、助手一号に任命したげる。光栄に思えよぉ？」
		ENDSELECT
	CASE 4
		;錬金知識
	CASE 5
		;魔物知識
	CASE 6
		;絵師
	CASE 7
		;高貴
	CASE 8
		;釣り好き
	CASE 9
		;踊り子
	CASE 10
		;歌唱技能
	CASE 11
		;料理人
	CASE 12
		;歴史知識
	CASE 13
		;経営知識
	CASE 14
		;水泳技能
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE -1
				;失敗
				KSTR:(K++) = 「ちょっ、力入りすぎ力入りすぎ。そんなんじゃ沈むって」
				KSTR:(K++) = ハル子は水の中でもがく_主人公_の腕を掴み、ぐいっと身体を引き上げた。
				KSTR:(K++) = 「はい一回脱力。泳ぐ前に溺れる練習してどーすんの」
			CASE 0
				;通常成功
				KSTR:(K++) = 「おー、いいじゃん。そのままそのまま」
				KSTR:(K++) = ハル子は隣を泳ぎながら、時折_主人公_の姿勢を手で直してくる。
				KSTR:(K++) = 「ちゃんと前進んでるし合格。あとは変なとこに力入れなきゃいーよ」
			CASEELSE
				;大成功
				KSTR:(K++) = 「おっ、速い速い。やるじゃんオーナーさん」
				KSTR:(K++) = ハル子は競うように横へ並ぶと、にやりと笑ってさらに速度を上げた。
				KSTR:(K++) = 「そこまで泳げんなら授業終わり。こっから競争な。負けた方がなんか奢り！」
		ENDSELECT
	CASE 15
		;農業知識
ENDSELECT

;知識ごとの専用口上がなければ共通口上を表示
IF K == LOCAL
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -1
			;失敗
			KSTR:(K++) = 「あー、そこ違う違う。ちょい貸してみ。
			KSTR:(K++) = 　ま、最初はそんなもんっしょ。もう一回やってみ？」
		CASE 0
			;通常成功
			KSTR:(K++) = 「そうそう、そんな感じ。意外と飲み込み早いじゃん。
			KSTR:(K++) = 　よーし、じゃ次いってみよっか」
		CASEELSE
			;大成功
			KSTR:(K++) = 「おっ、やるじゃん。そこまで分かれば上出来上出来。
			KSTR:(K++) = 　なはは、教えた甲斐あったわ。えらいえらい」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM313_ハグする
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功

@KOJO_COM_3652_313(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 陥落チェック(対象キャラ)
	;陥落後
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -1
			;失敗
			;KSTR:(K++) = 
		CASE 0
			;通常成功
			SELECTCASE RAND:4
				CASE 0
					KSTR:(K++) = 「ん。どした？」
					KSTR:(K++) = ハル子は何の抵抗もなく_主人公_の背中へ腕を回した。
					KSTR:(K++) = 「……まあ、好きなだけこうしてりゃいいんじゃね」
				CASE 1
					KSTR:(K++) = 「はいはい、ぎゅーっとね」
					KSTR:(K++) = ハル子は軽い調子で抱き返したものの、しばらく経っても腕を解こうとしない。
					KSTR:(K++) = 「……なに。もう終わり？」
				CASE 2
					KSTR:(K++) = 「急だなぁ」
					KSTR:(K++) = そう言いながら、ハル子は_主人公_の肩へ顎を乗せた。
					KSTR:(K++) = 「……ま、たまにはいっか」
				CASE 3
					KSTR:(K++) = 「おー、よしよし」
					KSTR:(K++) = ハル子はいつものように軽く背中を叩いていたが、やがてその手を止めた。
					KSTR:(K++) = 「……もうちょい、このままな」
			ENDSELECT
		CASEELSE
			;大成功
			KSTR:(K++) = 「ん……よしよし。そんなにお姉さんが好きかぁ？
			KSTR:(K++) = 　……おい、まだ離せとは言ってねーぞ」
	ENDSELECT
ENDIF

IF K == 0
	;陥落前、または陥落後の本文が未記入の場合
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -1
			;失敗
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 勢いよく抱きつくと、ハル子の頭が_主人公_にぶつかってしまった。
					KSTR:(K++) = 「うおっとぉ。ちょっとちょっと、お姉さんの色香にやられたからってちょっと落ち着きなって」
				CASE 1
					KSTR:(K++) = ハル子に肩を押さえられ、抱きつく勢いを止められてしまった。
					KSTR:(K++) = 「おっとぉ、突進してくんなって。お姉さんごとひっくり返す気かよ～」
			ENDSELECT
		CASE 0
			;通常成功
			SELECTCASE RAND:4
				CASE 0
					KSTR:(K++) = 「なんだぁ、ひと肌恋しくなっちゃった系？」
					KSTR:(K++) = ハル子は笑いながら_主人公_の背中に腕を回した。
					KSTR:(K++) = 「ほれほれ。存分にあったまってけ～」
				CASE 1
					KSTR:(K++) = 「お、来た来た」
					KSTR:(K++) = ハル子は特に驚く様子もなく、_主人公_をそのまま抱き返した。
					KSTR:(K++) = 「どした？ 疲れた？ ハル子さん成分が足んなくなった？」
				CASE 2
					KSTR:(K++) = 「はいはい、ぎゅーっとね」
					KSTR:(K++) = ハル子は_主人公_の背中をぽんぽんと叩きながら、適当にあやすように抱きしめ返した。
					KSTR:(K++) = 「よーしよし。これで満足？」
				CASE 3
					KSTR:(K++) = 「ん？ ハグ？」
					KSTR:(K++) = ハル子は_主人公_の腰に腕を回し、そのままぐっと引き寄せた。
					KSTR:(K++) = 「やるならもっとちゃんとやれって。ほら」
			ENDSELECT
		CASEELSE
			;大成功
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「おー……今日は随分くっつくねぇ」
					KSTR:(K++) = ハル子は楽しそうに笑うと、_主人公_を抱く腕に力を込めた。
					KSTR:(K++) = 「ま、いいけど。もうちょいこのままな」
				CASE 1
					KSTR:(K++) = 「んー……」
					KSTR:(K++) = ハル子は_主人公_の肩に頬を預けたまま、離れようとしない。
					KSTR:(K++) = 「こうしてるとラクだね。なんか立ったまま寝れそう」
				CASE 2
					KSTR:(K++) = 「……ん。もうちょい強くてもいいよ」
					KSTR:(K++) = ハル子も負けじと_主人公_の身体をぎゅっと抱きしめ返した。
					KSTR:(K++) = 「なはは。なんだこれ、力比べ？」
			ENDSELECT
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)


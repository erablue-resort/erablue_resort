			SELECTCASE RAND:6
				CASE 0
					KSTR:(K++) = 「なになに、ハル子さんの魅力にやられちゃった？」
				CASE 1
					KSTR:(K++) = 「お、ちょうどいいところにいた」
					KSTR:(K++) = ハル子は横から_主人公_の首に腕を回すと、そのままぐでっと体重を預けてきた。
					KSTR:(K++) = 「ちょい充電させて。動くなよー、コンセント」
				CASE 2
					SELECTCASE DAY % 120 / 30
						CASE 0
							;春
							KSTR:(K++) = 「春ってなんでこんな眠くなんだろーね。ふぁ……」
							KSTR:(K++) = ハル子は_主人公_の肩を抱くと、そのまま頭をもたれかけてきた。
							KSTR:(K++) = 「ちょっと枕貸して。寝たらその辺まで運んどいて」
						CASE 1
							;夏
							KSTR:(K++) = 「あっつ～……あ、いいこと思いついた」
							KSTR:(K++) = ハル子は汗ばんだ身体で、わざと_主人公_にべったりと抱きついてきた。
							KSTR:(K++) = 「なはは、暑い？ 暑いよなぁ。道連れ道連れ。
							KSTR:(K++) = 　逃げんなって。一緒に蒸されようぜ～」
						CASE 2, 3
							;秋・冬
							KSTR:(K++) = 「さむ。暖房みーっけ」
							KSTR:(K++) = ハル子は有無を言わせず背中から_主人公_に抱きつき、両腕を腹の前で回した。
							KSTR:(K++) = 「おー、あったけぇ。しばらくこのままな。
							KSTR:(K++) = 　逃げんな逃げんな。暖房に拒否権はありませーん」
					ENDSELECT
				CASE 3
					KSTR:(K++) = 「なんか今日、撫でやすそうな頭してんな。
					KSTR:(K++) = 　ほれほれほれほれ」
					KSTR:(K++) = ハル子は_主人公_の髪を両手でぐしゃぐしゃにかき回すと、そのまま頭を抱え込んだ。
					KSTR:(K++) = 「なはは、すげー頭。鳥でも飼えそう」
				CASE 4
					KSTR:(K++) = 「つーかまえたっ」
					KSTR:(K++) = ハル子は突然_主人公_に抱きつくと、逃がすまいとでもいうように腕へ力を込めた。
					KSTR:(K++) = 「はい、ハル子さんに捕まったので十秒動けませーん。
					KSTR:(K++) = 　いーち、にーい……あ、数えんのめんどくさ。もうちょいこのままでいいや」
				CASE 5
					KSTR:(K++) = 「よーしよしよし。今日もよく働いてるねえ、オーナー君」
					KSTR:(K++) = ハル子は_主人公_の肩を抱き寄せ、犬でも可愛がるように頭をわしゃわしゃと撫で回した。
					KSTR:(K++) = 「ご褒美にハル子さんが可愛がってあげよう。

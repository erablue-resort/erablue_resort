			CASE 2
				KSTR:(K++) = 「もういいの？ じゃ、_一人称_その辺ぶらついてくるわ。
				KSTR:(K++) = 　なんかあったら適当に捕まえて」
			CASE 3
				KSTR:(K++) = 「んじゃ、またあとで～。
				KSTR:(K++) = 　付き添い料金は今度メシでいいからね」
				KSTR:(K++) = ハル子は冗談めかしてそう言うと、さっさと歩いていった。
			CASE 4
				KSTR:(K++) = 「もっとあちこち行っても良かったけど、今日はここまでか。んじゃーにー」
		ENDSELECT
	ENDIF
ENDIF


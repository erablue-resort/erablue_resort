				KSTR:(K++) = 「じゃ……またな」
			CASE 1
				KSTR:(K++) = 「今日はありがと」
				KSTR:(K++) = ハル子は珍しく素直に礼を言うと、すぐに視線を逸らした。
				KSTR:(K++) = 「……なに。そういう顔すんなって。帰りづらいじゃん」
			CASE 2
				KSTR:(K++) = 「あー……終わりか。

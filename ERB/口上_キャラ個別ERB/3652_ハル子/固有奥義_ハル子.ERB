; ハルハラ ハル子（キャラ番号3652）固有奥義
; ファズは消費せず、現在数に応じて追加攻撃を行う。

@固有奥義_3652(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIM 追加攻撃威力
#DIM ファズ数
#DIM 攻撃回数
#DIMS 奥義名

追加攻撃威力 = 120
SELECTCASE 基礎BATTLE_STATE:キャラ番号:Lv
	CASE IS >= 26
		奥義名 = もうギンギンじゃんかよ＋＋
		奥義威力 = 300
	CASE IS >= 14
		奥義名 = もうギンギンじゃんかよ＋
		奥義威力 = 250
	CASEELSE
		奥義名 = もうギンギンじゃんかよ
		奥義威力 = 200
ENDSELECT

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		詳細文文字列受け渡し変数 = 奥義威力：{奥義威力}％<br>敵単体に自属性ダメージ。ファズ1につき、自属性の［{追加攻撃威力}％］追加攻撃を1回行う（最大3回）。<br>追加攻撃は生存中の敵から毎回ランダムに選ぶ。ファズは消費しない。
		RETURN 奥義威力
	CASE "奥義追加効果"
		ファズ数 = MIN(3, 刻印現在数確認("ファズ", 戦闘行動キャラ))
		FOR 攻撃回数, 0, ファズ数
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:ダメージ種類 = 奥義ダメージ
			CALL アビ対象選択テンプレート_敵ランダムＸ体(1)
			IF RESULT == -1
				BREAK
			ENDIF
			アビ汎用変数:効果割合 = 追加攻撃威力
			CALL アビテンプレート_ダメージ処理_自属性
		NEXT
ENDSELECT

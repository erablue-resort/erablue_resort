;==================================================
;固有特性 特殊表示
;==================================================
@口上_ステータス画面_固有特性解説_2845(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = □ 特性：『護国の盾として』 □-----------------------------------------------------------------
;KSTR:(K++) = 戦闘機械獣ゾイドの中でも群を抜いて強力かつ狂暴なオメガレックス。
;KSTR:(K++) = 彼女は軍人の矜持にかけて、その力を祖国と民を護るために使うことを誓った。
;KSTR:(K++) = だが、心せよ――獣の本能は、常に牙を剥く機会を窺っている。
;KSTR:(K++) = 　
KSTR:(K++) = ハンナ・メルビルのゾイドライダーとしての、そして軍人としての矜持の証明。
KSTR:(K++) = オメガレックスの闘争本能が高まるたび、固有刻印《WILD》を獲得する（最大5）。
KSTR:(K++) = 　
KSTR:(K++) = □ 特性：『暗黒の破壊要塞』 □-----------------------------------------------------------------
KSTR:(K++) = Z-Oバイザーによって抑制されたオメガレックスの闘争本能。
KSTR:(K++) = WILDが増加するほどに、本来の性能が段階的に解放される。
KSTR:(K++) = WILD最大時、奥義が『兵器解放・荷電粒子砲』に変化する。
KSTR:(K++) = 　
CALL 口上変数表示(対象キャラ, 1)
RETURN 0

;==================================================
; WILD獲得処理
;==================================================

@固有WILD獲得処理_キャラ_2845
#DIM WILD数
#DIM 隊列番号
CALL アビ汎用変数文字列リセット
隊列番号 = 戦闘行動キャラ
WILD数 = 刻印現在数確認("WILD", 隊列番号)
WILD数 += 1

;==================================================
; 護国の盾として
; WILD加算時に口上判定
; WILD5到達時は必ず口上、それ以外はランダム分岐
;==================================================

IF WILD数 >= 5

	;WILD最大時は必ず口上
	アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("真っ赤")%'>【WILD最大！】</font>
	アビ汎用文字列:テンプレ代替メッセージ２ = <font color='#%カラーパレット_HTML("真っ赤")%'>双眸から紅い光を漲らせ、オメガレックスは大地を揺るがす咆哮を上げた！</font>

ELSEIF WILD数 == 1

	SELECTCASE RAND:3

		CASE 0
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("緑")%'>【WILD1】</font>Z-Oバイザーの奥で、瞳が一瞬鋭く光を放つ……

		CASE 1
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("緑")%'>【WILD1】</font>オメガレックスの様子がおかしい……
			アビ汎用文字列:テンプレ代替メッセージ２ = 「オメガレックス、どうしたの？」
		CASE 2
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("緑")%'>【WILD1】</font>WILDを1獲得した！

	ENDSELECT

ELSEIF WILD数 == 2

	SELECTCASE RAND:3

		CASE 0
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("黄")%'>【WILD2】</font>オメガレックスの唸りが低く響く……

		CASE 1
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("黄")%'>【WILD2】</font>ハンナ・メルビルはオメガレックスの異変に気付いた……
			アビ汎用文字列:テンプレ代替メッセージ２ = 「オメガレックス、落ち着いて！」

		CASE 2
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("黄")%'>【WILD2】</font>WILDを1獲得した！

	ENDSELECT

ELSEIF WILD数 == 3

	SELECTCASE RAND:3

		CASE 0
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("黄")%'>【WILD3】</font>Z-Oバイザーの眼部から禍々しい光が漏れ出す……

		CASE 1
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("黄")%'>【WILD3】</font>オメガレックスの挙動がおかしい……
			アビ汎用文字列:テンプレ代替メッセージ２ = 「よりによってこんなときに……！」

		CASE 2
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("黄")%'>【WILD3】</font>WILDを1獲得した！
			
	ENDSELECT

ELSEIF WILD数 == 4

	SELECTCASE RAND:4

		CASE 0
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("赤")%'>【WILD4】</font>機体統合管制AIのレッドアラートが鳴り響く……！

		CASE 1
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("赤")%'>【WILD4】</font>機体統合管制AIのレッドアラートが鳴り響く……！
			アビ汎用文字列:テンプレ代替メッセージ２ = 「くっ……Z-Oバイザーの抑制限界が近いっていうの……！？」
			
		CASE 2
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("赤")%'>【WILD4】</font>オメガレックスの唸り声がコクピット越しにも伝わる……！
			アビ汎用文字列:テンプレ代替メッセージ２ = 「オメガレックス、お願い！　言うことを聞いて！」

		CASE 2
			アビ汎用文字列:テンプレ代替メッセージ１ = <font color='#%カラーパレット_HTML("赤")%'>【WILD4】</font>ハンナ・メルビルは覚悟を決めた！
			アビ汎用文字列:テンプレ代替メッセージ２ = 「こうなったら腹を括るしか……！」
			
		CASE 3
			アビ汎用文字列:テンプレ代替メッセージ１ = 【WILD4】WILDを1獲得した！

	ENDSELECT

ENDIF

; WILDを1加算

CALL アビ対象選択テンプレート_自己のみ

アビ汎用文字列:バフ・デバフ対象能力 = WILD
アビ汎用変数:累積上限_固定値 = 5

CALL アビテンプレート_刻印追加(1)

;==================================================
; WILD付随バフ登録（戦闘開始時に一度だけ）
;==================================================

; 与ダメージ　(WILD×3％)
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = WILD_与ダメージ
アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_通常攻撃ダメージ
アビ汎用変数:付随割合 = 3
CALL アビテンプレート_有利効果_付随バフ効果セット("WILD")

; 与ダメージ　(WILD×3％)
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = WILD_与ダメージ
アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_アビリティダメージ
アビ汎用変数:付随割合 = 2
CALL アビテンプレート_有利効果_付随バフ効果セット("WILD")

; 与ダメージ　(WILD×3％)
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = WILD_与ダメージ
アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
アビ汎用変数:付随割合 = 1
CALL アビテンプレート_有利効果_付随バフ効果セット("WILD")

; 被ダメージ　(WILD×-5％)
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = WILD_被ダメージ
アビ汎用文字列:バフ・デバフ対象能力 = 被ダメージ
アビ汎用変数:付随割合 = -5
CALL アビテンプレート_有利効果_付随バフ効果セット("WILD")

; 敵対心　(WILD×15)
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = WILD_敵対心
アビ汎用文字列:バフ・デバフ対象能力 = 敵対心
アビ汎用変数:付随量 = 15
CALL アビテンプレート_有利効果_付随バフ効果セット("WILD")

; 弱体耐性　(WILD×20％)
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = WILD_弱体耐性
アビ汎用文字列:バフ・デバフ対象能力 = 弱体耐性
アビ汎用変数:付随割合 = 20
CALL アビテンプレート_有利効果_付随バフ効果セット("WILD")


;----------------------------------------
; 攻撃が回避された
;----------------------------------------

@固有行動直後処理_キャラ_2845(全滅フラグ)
#DIM 全滅フラグ
#DIM 隊列番号
#DIM WILD数

;キラーバイティングによる反撃は対象外
SIF 戦闘中カウント:戦闘行動キャラ:自由枠２
	RETURN 0

SIF 回避反応者:0 < 0
	RETURN 0

隊列番号 = 戦闘行動キャラ

WILD数 = 刻印現在数確認("WILD", 隊列番号)

SIF WILD数 <= 0
	RETURN 0

;50％でWILD減少
SIF RAND:100 >= 50
	RETURN 0

;敵の攻撃回避によるWILD減
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_自己のみ

アビ汎用文字列:バフ・デバフ対象能力 = WILD
アビ汎用変数:累積上限_固定値 = 5

SELECTCASE RAND:3
	CASE 0
		アビ汎用文字列:実行時メッセージ１ = オメガレックスは苛立たしげに牙を鳴らす……
	CASE 1
		アビ汎用文字列:実行時メッセージ１ = オメガレックスは忌々しげに敵を睨んでいる……
	CASE 2
		アビ汎用文字列:実行時メッセージ１ = 「オメガレックス、深追いはダメよ！」
		アビ汎用文字列:実行時メッセージ２ = ゾイドは不服げに唸りながら、ライダーの指示に従った……
	ENDSELECT

	CALL アビテンプレート_刻印減少(1)

RETURN 0

;==================================================
; 暗黒の破壊要塞
;==================================================
; 与ダメージ
@固有バフ・デバフ処理_キャラ_2845_与ダメージ(隊列番号, ダメージ値)
#DIM 隊列番号
#DIM ダメージ値
#DIM WILD数

WILD数 = 刻印現在数確認("WILD", 隊列番号)

RETURN ダメージ値 * (100 + WILD数 * 3) / 100


;--------------------------------------------------
; 被ダメージ
;--------------------------------------------------

@固有バフ・デバフ処理_キャラ_2845_被ダメージ(隊列番号, 特殊補正後数値)
#DIM 隊列番号
#DIM 特殊補正後数値
#DIM WILD数

WILD数 = 刻印現在数確認("WILD", 隊列番号)

特殊補正後数値 = 特殊補正後数値 * (100 - WILD数 * 5) / 100

RETURN 特殊補正後数値


;--------------------------------------------------
; 敵対心
;--------------------------------------------------

@固有バフ・デバフ処理_キャラ_2845_敵対心(隊列番号, 補正前数値)
#DIM 隊列番号
#DIM 補正前数値
#DIM WILD数

WILD数 = 刻印現在数確認("WILD", 隊列番号)

RETURN 補正前数値 + WILD数 * 15


;--------------------------------------------------
; 弱体耐性
;--------------------------------------------------

@固有バフ・デバフ処理_キャラ_2845_弱体耐性(隊列番号, 補正前数値)
#DIM 隊列番号
#DIM 補正前数値
#DIM WILD数

WILD数 = 刻印現在数確認("WILD", 隊列番号)

RETURN 補正前数値 + WILD数 * 20


;==================================================
; キラーバイティング（反撃）
;==================================================

@固有被ダメ時処理_キャラ_2845(全滅フラグ)
#DIM 全滅フラグ
#DIM 隊列番号
#DIM キャラ番号
#DIM WILD数

#DIM 威力数値
#DIM バフ消去数
#DIM ループ用

SIF 全滅フラグ
	RETURN 0

隊列番号 = 戦闘行動キャラ
キャラ番号 = BATTLE_STATE:隊列番号:キャラ登録番号

WILD数 = 刻印現在数確認("WILD", 隊列番号)

SIF RAND:100 >= (20 + WILD数 * 10)
	RETURN 0

; キラーバイティング発動
; 反撃時はMP消費・WILD増減なし

戦闘中カウント:隊列番号:自由枠２ = 1

SELECTCASE RAND:3
	CASE 0
		アビ汎用文字列:実行時メッセージ１ = オメガレックスは反撃の牙を剥いた！
	CASE 1
		アビ汎用文字列:実行時メッセージ１ = オメガレックスが本能のままに反撃する！
	CASE 2
		アビ汎用文字列:実行時メッセージ１ = オメガレックスのキラーバイティング！
ENDSELECT

;==========================================
; キラーバイティング自動発動
;==========================================

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 40
	威力数値 = 250
	バフ消去数 = 1
ELSE
	威力数値 = 150
	バフ消去数 = 1
ENDIF

;------------------------------------------
; アビ名表示
;------------------------------------------
アビテンプレート用_アビ名 = キラーバイティング
アビテンプレート用_アビ名表示済フラグ = 0

;------------------------------------------
; ダメージ
;------------------------------------------
CALL アビ対象選択テンプレート_指定(戦闘行動対象)

アビ汎用変数:効果割合 = 威力数値
CALL アビテンプレート_ダメージ処理_自属性

;------------------------------------------
; バフ消去
;------------------------------------------
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_指定(アビテンプレート用_対象保存:0)

アビ汎用変数:基礎成功確率 = 100

FOR ループ用, 0, バフ消去数
	CALL アビテンプレート_不利効果_バフ消去
NEXT

戦闘中カウント:隊列番号:自由枠２ = 0

RETURN 0

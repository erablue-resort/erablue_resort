;****************************************
;キャラの絶頂後、あなたの射精への反応など
;****************************************
;・使い方
;「453」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;通常絶頂時
;--------------------------------------------------
@KOJO_ORGASM_通常絶頂_453(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;NOWEX:対象キャラ:Ｃ絶頂, NOWEX:対象キャラ:Ｖ絶頂, NOWEX:対象キャラ:Ａ絶頂, NOWEX:対象キャラ:Ｂ絶頂, NOWEX:対象キャラ:Ｓ絶頂
;	それぞれの絶頂強度が入っている
;	1:絶頂(10000超え)  2:強絶頂(20000超え)  3:超強絶頂(30000超え)  4:最強絶頂(40000超え)  5:究極絶頂(50000超え)

CALL 口上変数初期化

相手キャラ番号 = 絶頂相手算出(対象キャラ)

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
		;言いなり・特殊言いなり（未作成）
	ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
		;泥酔・トランス（未作成）
	ELSEIF TALENT:対象キャラ:恋慕 == 0 && CFLAG:対象キャラ:好感度レベル <= 関係閾値:4
		;無二の友未満（未作成）
	ELSE
		;多部位同時絶頂判定
		LOCAL:1 = 0
		FOR LOCAL, 0, 5
			SIF NOWEX:対象キャラ:LOCAL
				LOCAL:1 += 1
		NEXT
		SELECTCASE LOCAL:1
			CASE 2
				;2部位同時絶頂
				KSTR:(K++) = 「っ、あ……いっぺんに、なんて……反則、だよ……っ_H_」
			CASE 3 TO 5
				;3部位以上同時絶頂
				KSTR:(K++) = 「ひ、あっ……だめ、ぜんぶ、来る……っ！_H_」
				KSTR:(K++) = 　長い金髪が寝台に広がり、%CALLNAME:対象キャラ%の背中が大きく反り返った。
			CASEELSE
				;1部位絶頂
				IF NOWEX:対象キャラ:Ｃ絶頂
					KSTR:(K++) = 「んっ……！　そこ、は……っ_H_」
				ELSEIF NOWEX:対象キャラ:Ｖ絶頂
					KSTR:(K++) = 「あっ、あぁ……奥、だめ……っ_H_」
				ELSEIF NOWEX:対象キャラ:Ａ絶頂
					KSTR:(K++) = 「そっち、で……？　うそ、でしょ……っ」
				ELSEIF NOWEX:対象キャラ:Ｂ絶頂
					KSTR:(K++) = 「胸、だけで……っ。……今のは、見なかったことにして」
				ELSEIF NOWEX:対象キャラ:Ｓ絶頂
					KSTR:(K++) = 「全身、しびれて……っ、何、これ……」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;調教者の射精時
;--------------------------------------------------
@KOJO_ORGASM_被射精_453(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;RFLAG:フィニッシュ場所
;	どこに出されたか
;RCVAR:対象キャラ:被射精絶頂の強度
;	１以上だと射精された時にキャラも絶頂
;	現状はフィニッシュ場所が0～3の時しか起こらない
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
		;言いなり・特殊言いなり（未作成）
	ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
		;泥酔・トランス（未作成）
	ELSEIF TALENT:対象キャラ:恋慕 == 0 && CFLAG:対象キャラ:好感度レベル <= 関係閾値:4
		;無二の友未満（未作成）
	ELSE
		SELECTCASE RFLAG:フィニッシュ場所
			CASE 0
				;膣内
				IF CFLAG:対象キャラ:発情期フラグ < 0
					;発情期（-1:危険日 -2:超危険日。強制発情でも-1になる）
					IF RCVAR:対象キャラ:被射精絶頂の強度
						;射精による快楽で絶頂した時
						;体位  0:正面（正常位・屈曲位・対面座位・駅弁・対面立位・側位）  1:後ろ（後背位・寝バック・立ちバック・背面座位・背面駅弁）  2:騎乗位  3:挿入歩き（COM358）  4:それ以外
						IF MODE_存在判定_完全一致("正常位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("屈曲位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("対面座位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("駅弁", MASTER, 対象キャラ) || MODE_存在判定_完全一致("対面立位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("側位", MASTER, 対象キャラ)
							LOCAL = 0
						ELSEIF MODE_存在判定_完全一致("後背位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("寝バック", MASTER, 対象キャラ) || MODE_存在判定_完全一致("立ちバック", MASTER, 対象キャラ) || MODE_存在判定_完全一致("背面座位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("背面駅弁", MASTER, 対象キャラ)
							LOCAL = 1
						ELSEIF MODE_存在判定_完全一致("騎乗位", MASTER, 対象キャラ)
							LOCAL = 2
						ELSEIF MODE_存在判定_完全一致("挿入歩きＶ", MASTER, 対象キャラ)
							LOCAL = 3
						ELSE
							LOCAL = 4
						ENDIF
						SELECTCASE LOCAL
							CASE 0
								SELECTCASE RAND:3
									CASE 0
										KSTR:(K++) = 「あ、ぁ……っ_H_　なか、だめ、あつ……っ_H_」
										KSTR:(K++) = 　快感に悶えながら、%CALLNAME:対象キャラ%は本能のまま手脚で%CALLNAME:MASTER%に必死でしがみついてきた。
										KSTR:(K++) = 　腰に絡んだ脚が、もっと奥へと言わんばかりに%CALLNAME:MASTER%を引き寄せ、最後まで離そうとしない。
									CASE 1
										KSTR:(K++) = 「あっ、なか、熱……っ。だめ、今の時期にそれは……っ_H_」
										KSTR:(K++) = 　言葉とは裏腹に、%CALLNAME:対象キャラ%の脚は%CALLNAME:MASTER%の腰に絡みついて離れない。
									CASE 2
										KSTR:(K++) = 「ひ、ぁ……っ_H_　あ、ぁ……っ！_H_」
										KSTR:(K++) = 　奥に押し付けたまま精を放つと、%CALLNAME:対象キャラ%は脚で宙をかくように身悶えた。
								ENDSELECT
							CASE 1
								SELECTCASE RAND:2
									CASE 0
										KSTR:(K++) = 「あ、ぁっ、奥……っ、だめ、なのに……っ_H_」
										KSTR:(K++) = 　口ではそう言いながら、%CALLNAME:対象キャラ%は悶えるように腰を揺らし、本能のまま尻を%CALLNAME:MASTER%へ押し付けてきた。
										KSTR:(K++) = 　%CALLNAME:MASTER%はその腰を両手で抱え込み、奥にぴたりと密着させたまま、長々と射精した。
										KSTR:(K++) = 「う゛ぅーーっ_H_　ううう゛ーー……っ_H_」
										KSTR:(K++) = 　最後の一滴まで受け止めようとするように、%CALLNAME:対象キャラ%の尻は押し付けられたまま離れなかった。
									CASE 1
										KSTR:(K++) = 「～～――っ_H_　お゛ぉーー……_H_」
										KSTR:(K++) = 　%CALLNAME:対象キャラ%は喉の奥から、心地よさそうに濁った長いため息を漏らした。
								ENDSELECT
							CASE 2
								SELECTCASE RAND:3
									CASE 2
										KSTR:(K++) = 「う、ぁ……っ_H_　ん゛、ぅ……っ_H_　ふーー……っ_H_」
										KSTR:(K++) = 　%CALLNAME:対象キャラ%は呻きながらも自分から深く腰を落とし、注がれるものを奥へ奥へと押し付けた。
										KSTR:(K++) = 　焦点の合わない目でぼんやりと宙を仰ぎ、陶酔したように小さく身を震わせている。
									CASE 0
										KSTR:(K++) = 「あ、っ……なか、熱……っ_H_　だめ、腰、止まらな……っ_H_」
										KSTR:(K++) = 　%CALLNAME:対象キャラ%は%CALLNAME:MASTER%の上で背をしならせ、深く腰を沈めたまま動けなくなった。
									CASE 1
										KSTR:(K++) = 「～～――っ_H_　お゛ぉーー……_H_」
										KSTR:(K++) = 　%CALLNAME:対象キャラ%は%CALLNAME:MASTER%の胸に両手をついたまま、長い金髪を垂らしてがくがくと震えた。
								ENDSELECT
							CASE 3
								SELECTCASE RAND:2
									CASE 0
										KSTR:(K++) = 「っ、こんな、ところで……っ_H_　だめ、立って、られな……っ_H_」
										KSTR:(K++) = 　%CALLNAME:対象キャラ%は膝を震わせ、%CALLNAME:MASTER%にしがみついたまま一歩も動けなくなった。
									CASE 1
										KSTR:(K++) = 「ふーっ……_H_　ふーっ……_H_」
										KSTR:(K++) = 「……歩きながら、出すなんて……。誰かに見られたら、どうするつもり……_H_」
								ENDSELECT
							CASEELSE
								KSTR:(K++) = 「～～――っ_H_　お゛ぉーー……_H_」
								KSTR:(K++) = 　%CALLNAME:対象キャラ%は喉の奥から、心地よさそうに濁った長いため息を漏らした。
						ENDSELECT
					ELSE
						SELECTCASE RAND:2
							CASE 0
								KSTR:(K++) = 「ふーっ……_H_　ふーっ……_H_」
								KSTR:(K++) = 「……出した、ね……。今が、どういう時期か……わかってるよね_H_」
							CASE 1
								KSTR:(K++) = 「は、ぁ……_H_　お腹の奥、熱……っ_H_」
						ENDSELECT
					ENDIF
				ELSEIF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					IF (MODE_存在判定_完全一致("後背位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("寝バック", MASTER, 対象キャラ) || MODE_存在判定_完全一致("立ちバック", MASTER, 対象キャラ) || MODE_存在判定_完全一致("背面座位", MASTER, 対象キャラ) || MODE_存在判定_完全一致("背面駅弁", MASTER, 対象キャラ)) && RAND:2
						;後ろからの体位（後背位・寝バック・立ちバック・背面座位・背面駅弁）
						KSTR:(K++) = 「あ、ぁっ、待っ……奥、だめ……っ_H_」
						KSTR:(K++) = 　%CALLNAME:対象キャラ%が無意識に逃れようとしたので、
						KSTR:(K++) = 　%CALLNAME:MASTER%は腰を抱き寄せるようにして、長々と射精した。
						KSTR:(K++) = 「う゛ぅーーっ_H_　ううう゛ーー……っ_H_」
						KSTR:(K++) = 　文句を言いたそうに呻いてはいるが、快感に悶えて動けない%CALLNAME:対象キャラ%に、
						KSTR:(K++) = 　%CALLNAME:MASTER%はそのまま最後まで注ぎ込んだ。
					ELSE
						KSTR:(K++) = 「あ、なか、熱……っ、私も、いっしょに……っ_H_」
					ENDIF
				ELSE
					KSTR:(K++) = 「……ん。たくさん出たね。……全部、受け取ったよ」
				ENDIF
			CASE 1
				;腸内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					KSTR:(K++) = 「お尻に、熱いの……っ、こんなので、なんて……っ」
				ELSE
					KSTR:(K++) = 「……そっちに出すんだ。きみ、案外こだわりがあるね」
				ENDIF
			CASE 2
				;口
				IF RCVAR:対象キャラ:精飲フラグ > 1
				;喜んで飲む
					IF RCVAR:対象キャラ:被射精絶頂の強度
						;射精による快楽で絶頂した時
						KSTR:(K++) = 「んくっ……ぷは。……飲んだだけで、なんて……」
					ELSE
						KSTR:(K++) = 「ん……こく。……味の感想は、控えておくよ」
					ENDIF
				ELSEIF RCVAR:対象キャラ:精飲フラグ
				;なんとか飲み込む
					IF RCVAR:対象キャラ:被射精絶頂の強度
						;射精による快楽で絶頂した時
						KSTR:(K++) = 「んぐっ……っ、はぁ……飲み込んだら、体が……」
					ELSE
						KSTR:(K++) = 「……っ、く。苦い。次は、出す前に言って」
					ENDIF
				ELSEIF ABL:対象キャラ:技巧 > 2
				;ティッシュに吐き出す
					KSTR:(K++) = 　%CALLNAME:対象キャラ%は表情ひとつ変えずに口元を押さえ、ティッシュにそっと吐き出した。
					KSTR:(K++) = 「……うぇ。まったく。断りもなく出すなんて、礼儀に欠けるね」
				ELSE
				;吐き出してむせる
					KSTR:(K++) = 「けほっ、こほっ……！　い、いきなり、出さないで……！」
				ENDIF
			CASE 3
				;乳内
				IF RCVAR:対象キャラ:被射精絶頂の強度
					KSTR:(K++) = 「胸の中で、びくびくって……っ、私まで……っ」
				ELSE
					KSTR:(K++) = 「……胸、べとべと。……そんなに気持ちよかった？　これ」
				ENDIF
			CASE 5
				;顔
				KSTR:(K++) = 「……っ。顔に、出したね？」
				KSTR:(K++) = 「……まあ、いい。きみが拭くなら、許してあげる」
			CASE 6
				;腹
				KSTR:(K++) = 「お腹の上、熱いね。……たくさん出たね」
			CASE 7
				;背中
				KSTR:(K++) = 「背中に……？　見えないところに出すのは、ずるいよ」
			CASE 30
				IF CFLAG:対象キャラ:うふふ
					;うふふ中汎用射精
					KSTR:(K++) = 「もう？　ふふ、夜はまだ長いよ」
				ELSE
					;非うふふ時の射精、逆セクハラなど
					KSTR:(K++) = 「こんなところで出して。……後始末は、きみがやってね」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

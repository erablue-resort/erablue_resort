;--------------------------------------------------
;初対面時
;--------------------------------------------------
;リゾート内で初めてTARGETにした時に一度だけ呼ばれる（場所は問わない）
@KOJO_EVENT_初対面_453(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = 　ふわりと長い金髪を風に靡かせ、白と緑のゆったりとした衣装を纏った女性が、
KSTR:(K++) = 　静かにリゾートの遠景を見つめていた。
KSTR:(K++) = 　
KSTR:(K++) = 　エルーン特有の長い耳は柔らかく下を向き、
KSTR:(K++) = 　背後には、淡い光を帯びた輪の装飾が浮かんでいる。
KSTR:(K++) = 　
WSTR:(K++) = 　こちらが近づくと、彼女は気配もなく振り返り、感情の読めない穏やかな瞳を向けてきた。
KSTR:(K++) = 　
WSTR:(K++) = 「……やあ。きみがこの島の管理者――オーナーだね」
KSTR:(K++) = 　
WSTR:(K++) = 「私は十三仏の『薬師の座』、バイシュラだよ。休暇ついでに、しばらく泊まらせてもらう」
KSTR:(K++) = 　
WSTR:(K++) = 「星晶獣と結託して、これほど大規模な歓楽施設を築き上げている者がいると聞いてね」
KSTR:(K++) = 　
KSTR:(K++) = 「……それだけなら、民の娯楽で済むかもしれない。
WSTR:(K++) = 　だが、十二神将の子達が招かれることもあるとなれば、話は別だ」
KSTR:(K++) = 　
WSTR:(K++) = 　%CALLNAME:対象キャラ%は静かに視線を巡らせ、淡々とした、だがどこか底知れない声で告げる。
KSTR:(K++) = 　
KSTR:(K++) = 「十二神将を監督する立場として、この島が良からぬ企みの温床になっていないか……
WSTR:(K++) = 　そして、あの子達に不埒な手出しがなされていないか、私の目で直接見極めさせてもらうよ」
KSTR:(K++) = 　
WSTR:(K++) = 「……安心するといい。ただちに瑠璃光を降らせたりはしないさ。今のところは、ね」
KSTR:(K++) = 　
KSTR:(K++) = 　感情の起伏こそ薄いものの、その佇まいからは並々ならぬ実力と警戒心が滲み出ていた。

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
;関係閾値:4の段は未作成のため、関係閾値:3〜4を同じ台詞で扱っている。CASEELSE は関係閾値:5（陥落済みを含む）
@KOJO_EVENT_挨拶_453(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5
SIF 初体験日:対象キャラ:恋慕自覚
	関係レベル = 関係閾値:5

SELECTCASE TIME
	CASE 5*60 TO 11*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「……おはよう。今日も見させてもらうよ」
					CASE 1
						KSTR:(K++) = 「おはよう。朝から島を歩いてみた。
						KSTR:(K++) = 　……星晶獣の気配が、地面にまで薄く染みているね」
					CASE 2
						KSTR:(K++) = 「おはよう、%CSTR:対象キャラ:二人称%。朝の巡回かい？　感心だね」
						KSTR:(K++) = 「……私のことは気にせず仕事を続けてくれて構わないよ。ただの『観察』だからね」
					CASE 3
						KSTR:(K++) = 「やあ。朝から精力的なことだね」
						KSTR:(K++) = 「この島をどう動かしているのか、今日も隅々まで見させてもらうよ」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「おはよう。……昨日も遅くまで働いていたね。見ていたよ」
					CASE 1
						KSTR:(K++) = 「おはよう。客の顔色、昨日と変わらないね。……今のところは」
					CASE 2
						KSTR:(K++) = 「おはよう。朝露に濡れた石は、光の通り方が違ってきれいなんだ」
						KSTR:(K++) = 「……興味なさそうだね。いいよ、私だけで楽しむから」
					CASE 3
						KSTR:(K++) = 「おはよう。昨日のきみの行動、ひと通り見ていたよ。特に問題なし」
						KSTR:(K++) = 「……問題がないのも、それはそれで退屈だね」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「おはよう。朝ごはんはおいしかったよ。……毒見の必要はなかった」
					CASE 1
						KSTR:(K++) = 「おはよう。今日は浜のほうを歩いてくる。……ついてくるなら、勝手にどうぞ」
					CASE 2
						KSTR:(K++) = 「おはよう。甘いものを持ってきたよ。朝に食べると頭が働く」
						KSTR:(K++) = 「遠慮はいらない。……毒も入っていないよ。薬師だからね」
					CASE 3
						KSTR:(K++) = 「やあ、おはよう」
						KSTR:(K++) = 「今日はいい石が見つかりそうな気がする。根拠は勘。私の勘はよく当たるんだ」
				ENDSELECT
			CASE IS < 関係閾値:5
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「おはよう、%CSTR:対象キャラ:二人称%。今日もきみの仕事ぶりを見ているよ。
						KSTR:(K++) = 　……前ほど意地の悪い目では、ないつもりだけど」
					CASE 1
						KSTR:(K++) = 「おはよう。……寝ぐせ。そこ。……オーナーがそれでは、客に示しがつかないよ」
					CASE 2
						KSTR:(K++) = 「おはよう、%CSTR:対象キャラ:二人称%。ふふ、今日も元気そうだね」
						KSTR:(K++) = 「朝の挨拶をしにわざわざ来てくれたのかい？　律儀なところは嫌いじゃないよ」
					CASE 3
						KSTR:(K++) = 「おはよう。これでも育ち盛りだからね、朝食はしっかり摂りたいところだ」
						KSTR:(K++) = 「……ふふ、笑うところだよ？」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:4
					CASE 0
						IF TALENT:対象キャラ:恋慕
							KSTR:(K++) = 「おはよう、%CSTR:対象キャラ:二人称%。今日も休暇を一日延ばした。理由？　言わないとわからない？」
						ELSE
							KSTR:(K++) = 「おはよう。今日も休暇を延ばしてしまった。
							KSTR:(K++) = 　……総空神宮から苦情が来たら、きみが謝ってね」
						ENDIF
					CASE 1
						KSTR:(K++) = 「おはよう。……寝ぐせ。直してあげるから、じっとしていて」
					CASE 2
						IF TALENT:対象キャラ:恋慕
							KSTR:(K++) = 「おはよう、%CSTR:対象キャラ:二人称%。今日の予定は？」
							KSTR:(K++) = 「……ふうん。じゃあ私も同行する。もう決めたから、相談じゃないよ」
						ELSE
							KSTR:(K++) = 「おはよう、%CSTR:対象キャラ:二人称%。遅かったね」
							KSTR:(K++) = 「……待っていたわけじゃないよ。たまたまここに立っていただけ」
						ENDIF
					CASE 3
						KSTR:(K++) = 「やあ、おはよう。お茶を淹れておいたよ。二人分」
						KSTR:(K++) = 「一人で飲むより、おいしい気がする。……まだ検証中だけどね」
				ENDSELECT
		ENDSELECT
		;昼　11時～18時
	CASE 11*60 TO 18*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「やあ。今の客、ずいぶん楽しそうだったね。……きみの星晶獣は、ああいうのが好きなの？」
					CASE 1
						KSTR:(K++) = 「やあ。業務は順調かい？」
						KSTR:(K++) = 「星晶獣の手綱、ちゃんと握れている？　……見ているからね」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「やあ。きみの所の従業員に、少し話を聞かせてもらった。答え合わせは、まだこれから」
					CASE 1
						KSTR:(K++) = 「やあ。何をしているのかって？　石探しと、きみの観察」
						KSTR:(K++) = 「どっちも休暇中の趣味みたいなものだよ。……片方は趣味じゃないけど」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「やあ。浜辺は今日も賑わっているね。……賑わいすぎている気もするけど」
					CASE 1
						KSTR:(K++) = 「やあ、お疲れ様。お昼はもう済ませたかい？」
						KSTR:(K++) = 「まだなら、少し付き合って。一人で食べるのは味気ないから」
				ENDSELECT
			CASE IS < 関係閾値:5
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「やあ、%CSTR:対象キャラ:二人称%。少し休憩したら？　私も、ちょうど甘いものが欲しかったところだ」
					CASE 1
						KSTR:(K++) = 「やあ、%CSTR:対象キャラ:二人称%。ちょうどいい。休憩にしよう」
						KSTR:(K++) = 「……私が決めた。きみに拒否権はないよ」
				ENDSELECT
			CASEELSE
				IF TALENT:対象キャラ:恋慕
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「やあ、%CSTR:対象キャラ:二人称%。お昼はまだでしょ。軽く食べられるもの、二人分用意しておいたよ」
						CASE 1
							KSTR:(K++) = 「やあ。来ると思っていたよ。私の読みは外れないから」
							KSTR:(K++) = 「午後は空けておいた。きみの分も」
					ENDSELECT
				ELSE
					KSTR:(K++) = 「やあ、%CSTR:対象キャラ:二人称%。お昼はまだでしょ。軽く食べられるもの、二人分用意しておいたよ」
				ENDIF
		ENDSELECT
		;夜　18時～
	CASEELSE
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。夜も客を入れているんだね。……夜のほうが、きみの星晶獣は喜びそうだ」
					CASE 1
						KSTR:(K++) = 「こんばんは。夜は静かでいい。……良からぬことをするにも、ちょうどいい時間だけど」
						KSTR:(K++) = 「私、気配を消すのは得意なんだ。覚えておいて」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。夜の島も見て回ったよ。妙なものは見つかっていない。……今のところはね」
					CASE 1
						KSTR:(K++) = 「こんばんは。今日も一日、問題なし」
						KSTR:(K++) = 「……何も起きなさすぎるのも、かえって怪しいんだけどね」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。一杯やっていたところだ。……きみに注ぐ分はないよ。まだね」
					CASE 1
						KSTR:(K++) = 「こんばんは。夜風が冷えてきたね」
						KSTR:(K++) = 「温かいお茶、余っているよ。飲むなら注ぐけど」
				ENDSELECT
			CASE IS < 関係閾値:5
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「こんばんは。今日もお疲れさま。……一杯くらいなら、付き合ってあげてもいい」
					CASE 1
						KSTR:(K++) = 「やあ、こんばんは、%CSTR:対象キャラ:二人称%。今日もよく働いたね」
						KSTR:(K++) = 「夜は頭を休める時間だよ。……きみがよければ、少し膝でも貸してあげようか？」
						KSTR:(K++) = 「……いや、やっぱりやめた。膝が疲れそうだ」
				ENDSELECT
			CASEELSE
				IF TALENT:対象キャラ:恋慕
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「こんばんは。今日もお疲れさま。……一杯付き合って。今日は私が注ぐから」
						CASE 1
							KSTR:(K++) = 「こんばんは。待っていたよ」
							KSTR:(K++) = 「……待っていたと素直に言えるようになった。我ながら成長したと思う」
					ENDSELECT
				ELSE
					KSTR:(K++) = 「こんばんは。今日もお疲れさま。……一杯付き合って。今日は私が注ぐから」
				ENDIF
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)



;--------------------------------------------------
;一日終了時のオナニー実行時
;--------------------------------------------------
;RCVAR:対象キャラ:オナニー結果保存
;	1:通常オナニー
;	-1（無知）と 3（覚えたて）は、性知識が0未満などで自慰を知らないキャラだけ。2（母乳搾り）は母乳体質の時だけ。どちらも書いていない
@KOJO_一日終了時オナニー_453(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RCVAR:対象キャラ:オナニー結果保存
	CASE 1
		;通常オナニー
		IF TALENT:対象キャラ:恋慕
			;恋人
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……今日は、会えた時間が短かったからね。これは仕方のない処置だ」
					KSTR:(K++) = 　思い浮かべるのは、昼間に握った%CALLNAME:MASTER%の手の温度だった。
				CASE 1
					KSTR:(K++) = 「……まったく。あの人はもっと、恋人に構うべきだと思う」
					KSTR:(K++) = 　枕を抱えて文句を言いながら、%CALLNAME:対象キャラ%は今日の分の不満を指先で晴らしていった。
			ENDSELECT
		ELSEIF 初体験日:対象キャラ:恋慕自覚
			;片想い
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……違う。これは、たまたま。たまたま今日、そういう気分だっただけで」
					KSTR:(K++) = 　終わったあと枕に顔を埋めて漏らした名前は、本人も聞かなかったことにした。
				CASE 1
					KSTR:(K++) = 「……今日は、あの人のことは考えない。考えないと決めたから、考えない」
					KSTR:(K++) = 　……そう決めた三秒後には、もう考えていた。
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「溜めこむのは、体に良くない。……薬師の座が言うんだから、間違いない」
					KSTR:(K++) = 　処方箋でも読み上げるような口調のまま、%CALLNAME:対象キャラ%は静かに熱を逃がしていった。
				CASE 1
					KSTR:(K++) = 「っ……ふぅ」

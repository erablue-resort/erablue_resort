;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「453」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************

;--------------------------------------------------
;COM321_胸を揉む
;--------------------------------------------------
;取得快楽：Ｂ
;RFLAG:コマンド結果受渡し変数
;	1:拒絶  2:受け入れ  3:喜び
;バイシュラはＢ感度+1（敏感）
@KOJO_COM_453_321(対象キャラ)
#DIM 対象キャラ

CALL 口上変数初期化

IF RFLAG:コマンド結果受渡し変数 == 1
	;拒絶（未作成）
ELSEIF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
	;言いなり・特殊言いなり（未作成）
ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
	;泥酔・トランス（未作成）
ELSEIF TALENT:対象キャラ:恋慕 == 0 && CFLAG:対象キャラ:好感度レベル <= 関係閾値:4
	;無二の友未満（未作成）
ELSE
	SELECTCASE CUP:対象キャラ:快Ｂ
		;各部位の累積が10000で絶頂
		CASE IS > 10000
			;即絶頂
			KSTR:(K++) = 「んっ……！　ちょ、胸だけで、なんて……っ。……今のは、なかったことに」
		CASE IS > 3000
			;感じている
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「……っ、ふ……。そこばかり、触らないで。……変な声が出る」
				CASE 1
					KSTR:(K++) = 「そんなに珍しい？　大きくもないのに。……まあ、好きにするといい」
			ENDSELECT
		CASEELSE
			;まだ快楽に慣れていない
			KSTR:(K++) = 「……くすぐったい。というか、それ、楽しい？」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM350_押し倒す
;--------------------------------------------------
;実行条件：陥落チェック_性的＋疑似恋慕（恋慕・セフレ・疑似恋慕）か、言いなり・特殊言いなり
@KOJO_COM_453_350(対象キャラ)
#DIM 対象キャラ
;取得快楽：なし

CALL 口上変数初期化

IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
	KSTR:(K++) = 「……体が、勝手に。これも星晶獣の仕業か」
	KSTR:(K++) = 「覚えておいて。終わったら、きみごと瑠璃光で撃ち抜くから」
ELSE
	IF TCVAR:対象キャラ:初うふふフラグ
		;初体験時
		KSTR:(K++) = 「……っ」
		WSTR:(K++) = 　腰を深く抱き寄せられた瞬間、%CALLNAME:対象キャラ%の肩がびくりと跳ねた。
		KSTR:(K++) = 　
		KSTR:(K++) = 「そ、そうか……そうだよね。
		WSTR:(K++) = 　そりゃ、私に興味があるから口説いたんだよね。そういう流れになるよね」
		KSTR:(K++) = 　
		WSTR:(K++) = 「わわ、わかった、うん。わかってる。大人だからね、わかってるよ」
		KSTR:(K++) = 　
		KSTR:(K++) = 　口では『わかった』を繰り返しているのに、視線はあちこちに泳ぎ、
		WSTR:(K++) = 　長い金髪の隙間から覗く頬は、真っ赤に染まっていた。
		KSTR:(K++) = 　
		WSTR:(K++) = 「……ちょ、ちょっと、準備するから待ってね」
		KSTR:(K++) = 　
		KSTR:(K++) = 　そう言って%CALLNAME:対象キャラ%は腕の中から半歩離れると、どこからか櫛を取り出して髪を梳かし始めた。
		KSTR:(K++) = 　毛先を整え、髪飾りの位置を直し、また同じ場所の毛先を整える。
		WSTR:(K++) = 　どう見ても、必要な準備ではない。
		KSTR:(K++) = 　
		KSTR:(K++) = 　それを承知のうえで、%CALLNAME:MASTER%は黙って待った。
		WSTR:(K++) = 　……。
		KSTR:(K++) = 　
		KSTR:(K++) = 　無意味に髪を梳かし続けるのも気まずくなったのか、
		WSTR:(K++) = 　%CALLNAME:対象キャラ%は、やけにゆっくりとした手つきで櫛をしまった。
		KSTR:(K++) = 　
		KSTR:(K++) = 　こちらを振り返って顔を見る。あらぬ方向を見る。また顔を見る。
		WSTR:(K++) = 　……妙な間が、しばらく続いた。
		KSTR:(K++) = 　
		WSTR:(K++) = 　やがて%CALLNAME:対象キャラ%は、ようやくさっきの距離まで戻ってくると、小さく口を開いた。
		KSTR:(K++) = 　
		WSTR:(K++) = 「……その。わかってると思うけど、こういうことは初めてで……この歳まで、何もなくて……」
		KSTR:(K++) = 　
		WSTR:(K++) = 「……優しくしてね。私の手加減は、あまり当てにならないから」
	ELSE
		IF CFLAG:対象キャラ:発情期フラグ < 0
			;発情期（-1:危険日 -2:超危険日。強制発情でも-1になる）
			SELECTCASE RAND:5
				CASE 0
					KSTR:(K++) = 「……遅い。ずっと待っていたんだけど」
					KSTR:(K++) = 　押し倒されるより先に、%CALLNAME:対象キャラ%のほうから%CALLNAME:MASTER%の腕を引き、寝台へ倒れ込んできた。
				CASE 1
					KSTR:(K++) = 「今日は、体の奥がずっと落ち着かなくて……。分析は後。今は、早く」
				CASE 2
					KSTR:(K++) = 　%CALLNAME:対象キャラ%は無言で%CALLNAME:MASTER%の首に腕を回すと、そのまま唇を押し付けてきた。
					KSTR:(K++) = 「……ん。説明は省略。わかるでしょ」
				CASE 3
					KSTR:(K++) = 「薬師として言うけど、これは時期的なものだよ。……だから仕方ない。仕方ないから、たくさんして……_H_」
				CASE 4
					KSTR:(K++) = 「……っ、ふ……。まだ触られてもいないのに、こうなってる」
					KSTR:(K++) = 　熱っぽく潤んだ目で見上げながら、%CALLNAME:対象キャラ%は自分から帯に手をかけた。
			ENDSELECT
		ELSE
			SELECTCASE RAND:8
				CASE 0
					KSTR:(K++) = 「また？　……ふふ、いいよ。きみは本当に、私のことが好きだね」
				CASE 1
					KSTR:(K++) = 「押し倒す角度、前より上手くなったね。……練習した？　誰で？」
				CASE 2
					KSTR:(K++) = 「%CSTR:対象キャラ:二人称%……」
					KSTR:(K++) = 　それ以上は何も言わず、%CALLNAME:対象キャラ%は無表情のまま両腕を伸ばしてきた。
					KSTR:(K++) = 　……垂れた耳だけが、正直に揺れている。
				CASE 3
					KSTR:(K++) = 「一つ提案。今日は私が上。……年長者の言うことは聞くものだよ」
				CASE 4
					KSTR:(K++) = 「今日も一日、よく働いたね。……じゃあ次は、私のために働いて」
				CASE 5
					KSTR:(K++) = 「性欲の処理、ね。……いいよ。お互い大人だから、そういうこともある」
				CASE 6
					KSTR:(K++) = 「勘違いしないでほしい。これは十三仏としての……いや、特に理由はないな。
					KSTR:(K++) = 　したいだけだ」
				CASE 7
					KSTR:(K++) = 「また？　……若い人は元気だね。私の体力にも、少しは配慮してほしいんだけど」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM353_性交渉をお願いする
;--------------------------------------------------
;実行条件：陥落チェック_性的＋疑似恋慕（恋慕・セフレ・疑似恋慕）を持っていない時のみ
@KOJO_COM_453_353(対象キャラ)
#DIM 対象キャラ
;取得快楽：なし
;RFLAG:コマンド結果受渡し変数
	;1:成功  0:失敗
;RFLAG:コマンド結果受渡し変数２
	;今回でどのくらい成功度が蓄積したかを表す  蓄積の累計値が100を越えたら成功
	;16未満だと拒否度が高い扱いで、失敗時の好感度低下が大きくなる
;CFLAG:対象キャラ:お願いックス蓄積値
	;現在どのくらい成功度が蓄積しているかを表す  蓄積の累計値が100を越えたら成功
;CFLAG:対象キャラ:お願いックス回数
	;泥酔以外（トランス時を含む）で成功した回数。成功時点で加算済み。泥酔時は 泥酔ックス回数 に加算される

CALL 口上変数初期化

IF RFLAG:コマンド結果受渡し変数
	;成功
	IF TCVAR:対象キャラ:初うふふフラグ
		;初体験時
		IF BASE:対象キャラ:酩酊 >= 500
			WSTR:(K++) = 「んー……？　ああ、またその話……。いいよ、もう。今日は気分がいいから、特別」
			KSTR:(K++) = 　
			WSTR:(K++) = 　頬を赤くした%CALLNAME:対象キャラ%は、ふらりと%CALLNAME:MASTER%の肩にもたれかかってきた。
			KSTR:(K++) = 　
			KSTR:(K++) = 「……ふふ。明日の私が何て言うかは、知らないけどね」
		ELSEIF TCVAR:対象キャラ:トランス残り時間 > 0
			WSTR:(K++) = 「……あれ。断る理由、何だったっけ……」
			KSTR:(K++) = 　
			KSTR:(K++) = 　%CALLNAME:対象キャラ%はぼんやりとした目のまま、%CALLNAME:MASTER%の袖をつまんだ。
		ELSE
			WSTR:(K++) = 「……はあ。わかった、わかったよ。きみの粘り強さには負けた」
			KSTR:(K++) = 　
			WSTR:(K++) = 　%CALLNAME:対象キャラ%は、わざとらしく肩をすくめてみせた。
			KSTR:(K++) = 　
			WSTR:(K++) = 「そこまで頼まれて断り続けるのも、大人げないからね。いいよ、相手をしてあげる」
			KSTR:(K++) = 　
			WSTR:(K++) = 「年長者の余裕というものを、見せてあげよう」
			KSTR:(K++) = 　
			KSTR:(K++) = 　余裕たっぷりに言い放つと、%CALLNAME:対象キャラ%は自分から寝台に腰を下ろした。
			WSTR:(K++) = 　……下ろしたまま、動かない。
			KSTR:(K++) = 　
			KSTR:(K++) = 　膝の上で揃えた指が、落ち着きなく組み替えられている。
			WSTR:(K++) = 　こちらを見る。目を逸らす。また見る。
			KSTR:(K++) = 　
			WSTR:(K++) = 「……知識はあるよ、知識は。ただ、実地が初めてというだけで……」
			KSTR:(K++) = 　
			KSTR:(K++) = 　長い金髪の隙間から覗く首筋が、みるみる赤く染まっていく。
			WSTR:(K++) = 　やがて観念したのか、開き直ったようにこちらをまっすぐ見据えてきた。
			KSTR:(K++) = 　
			WSTR:(K++) = 「ごめん、やっぱ余裕ない」
			KSTR:(K++) = 　
			KSTR:(K++) = 「年長者にリードしてもらうんじゃなくて、
			WSTR:(K++) = 　年長者を労るつもりで優しく、丁寧にしてほしい」
			KSTR:(K++) = 　
			WSTR:(K++) = 「……わかったね？　乱暴にしたら、あとで怖いよ」
		ENDIF
	ELSEIF TALENT:対象キャラ:セフレ
		;セフレ獲得時
		WSTR:(K++) = 「また？　……もう何度目かな、このやりとり」
		KSTR:(K++) = 　
		WSTR:(K++) = 「いいよ。ここまで来ると、断るほうが面倒だ。今後は、いちいち頼まなくていい」
		KSTR:(K++) = 　
		KSTR:(K++) = 「ただし、恋人ごっこは無し。そこは線を引いておくよ」
	ELSEIF BASE:対象キャラ:酩酊 >= 500
		;泥酔時
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「……また酔わせて。きみ、それが一番成功率が高いって気づいてるでしょ」
			CASE 1
				KSTR:(K++) = 「ん……いいよ。今夜は、細かいことを考えるのが面倒」
		ENDSELECT
	ELSEIF TCVAR:対象キャラ:トランス残り時間 > 0
		;トランス時
		KSTR:(K++) = 「……頭がぼうっとする。断る言葉が、出てこない……」
	ELSEIF CFLAG:対象キャラ:お願いックス回数 == 1
		;初体験が泥酔時などで、泥酔・トランス以外で応じるのが初めての時
		WSTR:(K++) = 「この前のは、お酒のせい。……なのに、またお願い？」
		KSTR:(K++) = 　
		KSTR:(K++) = 「……はあ。素面で頼まれると、かえって断りにくいね。いいよ」
	ELSE
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「またその顔。……わかったよ。そこまで頼まれたら、応えるのが大人というものだ」
			CASE 1
				KSTR:(K++) = 「きみも飽きないね。……いいよ。私の寛大さに感謝すること」
			CASE 2
				KSTR:(K++) = 「はいはい、今日も根負けしてあげる。……私も、甘くなったものだね」
		ENDSELECT
	ENDIF
ELSE
	;失敗
	IF BASE:対象キャラ:酩酊 >= 500
		KSTR:(K++) = 「んー……だめ。今日は、もう眠い……」
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は半分閉じた目のまま、ひらひらと手を振ってみせた。
	ELSEIF RFLAG:コマンド結果受渡し変数２ < 16
		KSTR:(K++) = 「……一応聞くけど、本気で言ってる？　なら、なおさらお断りだね」
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は、珍しい虫でも見るような目で%CALLNAME:MASTER%を見た。
	ELSEIF CFLAG:対象キャラ:お願いックス蓄積値 >= 50
		KSTR:(K++) = 「……考えておく。今日のところは、それで勘弁して」
	ELSE
		SELECTCASE RAND:3
			CASE 0
				KSTR:(K++) = 「お断り。そういうことは、もう少し段階を踏んでから言うものだよ」
			CASE 1
				KSTR:(K++) = 「却下。きみ、私を何歳だと思ってるの。そう簡単には靡かないよ」
			CASE 2
				KSTR:(K++) = 「残念。今日の私は、そういう気分じゃない」
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

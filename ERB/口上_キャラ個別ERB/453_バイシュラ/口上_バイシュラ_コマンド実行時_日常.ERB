;--------------------------------------------------
;COM303_口説く
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
;	-2:話題切れで大失敗  -1:失敗  0:通常成功  1:大成功  2:トランス状態（遊び人Lv5以上で発生、恋慕持ちには発生しない）
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_453_303(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5
SIF 初体験日:対象キャラ:恋慕自覚
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;話題切れ
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「その口説き文句、さっきも聞いたよ。……在庫はそれだけ？」
			CASE IS < 関係閾値:5
				KSTR:(K++) = 「ネタ切れかな。同じ台詞を三回聞くと、さすがに覚えてしまうね」
			CASEELSE
				KSTR:(K++) = 「もう品切れ？　……じゃあ、さっきのをもう一回。今度はもっと感情を込めて」
		ENDSELECT
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「……星晶獣の入れ知恵？　口が上手いのは、商売柄かな」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「その手の言葉は、客にも言っているんだろう？」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「……今のは、口説き文句として成立している？　判定が難しいね」
			CASE IS < 関係閾値:5
				KSTR:(K++) = 「ふふ。言い慣れていないのが丸わかりだよ。……嫌いではないけど」
			CASEELSE
				IF TALENT:対象キャラ:恋慕
					KSTR:(K++) = 「……雑。言い直し。ほら、もう一回」
				ELSE
					KSTR:(K++) = 「……ん、なんて？　よく聞こえなかったな」
				ENDIF
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「褒めても何も出ないよ。……瑠璃光なら出るけど」
					CASE 1
						KSTR:(K++) = 「そういう台詞は、十二神将の子達には言わないでね。……言っていないよね？」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ふうん。きみは、誰にでもそういうことを言う人？」
					CASE 1
						KSTR:(K++) = 「……今のは、何かの探り？　だとしたら、少し下手だね」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ふふ。悪い気はしないね。……悪い気がしないのが、困るんだけど」
					CASE 1
						KSTR:(K++) = 「この歳になると、褒められる機会も減っていてね。……もっと言ってくれてもいいよ」
				ENDSELECT
			CASE IS < 関係閾値:5
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「……ふ、ふふ。そういうのは、急に言うものじゃないよ」
						KSTR:(K++) = 　平静を装っているが、垂れた耳の先がわずかに揺れていた。
					CASE 1
						KSTR:(K++) = 「……今のは、心にしまっておくことにする。二度と言わなくていい。
						KSTR:(K++) = 　……いや、たまには言って」
				ENDSELECT
			CASEELSE
				IF TALENT:対象キャラ:恋慕
					;恋人（TALENT:恋慕 1:恋人 2:結婚）
					SELECTCASE RAND:7
						CASE 0
							KSTR:(K++) = 「知ってる。……私も、きみのことをそう思っているよ」
						CASE 1
							KSTR:(K++) = 「もっと言って。……今日はまだ、規定の回数に届いていないから」
						CASE 2
							KSTR:(K++) = 「ふふ。じゃあ、お返しに。……好きだよ。はい、次はきみの番」
						CASE 3
							KSTR:(K++) = 「面と向かって言われると、やっぱりちょっと照れるね」
							KSTR:(K++) = 「……でも、表情には出ていないはず。……出てた？　うそ。どこに出てたの」
						CASE 4
							KSTR:(K++) = 「きみって、口説く時だけ急に大人びた顔をするよね」
							KSTR:(K++) = 「……年上として、少しやりづらい。やりづらいけど、すごくときめく」
						CASE 5
							KSTR:(K++) = 「嬉しいよ。……きみが思っているより、ずっとね」
							KSTR:(K++) = 「ご褒美に、頭を撫でてあげようか。……それとも、きみに撫でてもらおうかな」
						CASE 6
							KSTR:(K++) = 「可愛い……？　私が？　……ふ、ふふ。よく恥ずかしげもなく言えるね」
							KSTR:(K++) = 「いつもはあの子達を愛でる側だったから、自分が言われると変な汗が出るよ」
							KSTR:(K++) = 「……でも、きみに言われるのは嬉しい。もう一回言って。今度は覚えるから」
					ENDSELECT
				ELSEIF 初体験日:対象キャラ:恋慕自覚
					;片想い
					SELECTCASE RAND:4
						CASE 0
							KSTR:(K++) = 「……っ。そ、そういうことを、軽々しく言うものではないよ」
							KSTR:(K++) = 　顔を背けたが、髪から覗く頬はすっかり赤くなっていた。
						CASE 1
							KSTR:(K++) = 「……今のは、聞かなかったことにする。……念のため、もう一回言ってくれる？」
						CASE 2
							KSTR:(K++) = 「……そういう甘い台詞は、本命の子にだけ言うものだよ」
							KSTR:(K++) = 「……え？　私が本命？　…………」
							KSTR:(K++) = 「あーー……もう、きみは。心臓に悪いから、そういう冗談はやめてほしい」
						CASE 3
							KSTR:(K++) = 「……きみ、口説きの才能があるね。減点しようがない」
							KSTR:(K++) = 「悔しいから、今の台詞は手帳にメモしておくよ」
					ENDSELECT
				ELSE
					KSTR:(K++) = 「ありがとう。……今日は素直に受け取っておくよ」
				ENDIF
		ENDSELECT
	CASE 1
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「……今のは、なかなかだった。少しだけ、ぐらっときたよ。少しだけ」
			CASE IS < 関係閾値:5
				KSTR:(K++) = 「……ずるいね、きみは。そういうことを、そういう顔で言う」
			CASEELSE
				IF TALENT:対象キャラ:恋慕
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「……満点。……ちょっと、こっちを見ないで。
							KSTR:(K++) = 　今、顔が大変なことになっているから」
						CASE 1
							KSTR:(K++) = 「あ、うん……うん……」
							KSTR:(K++) = 　頭が茹で上がってしまった%CALLNAME:対象キャラ%は、
							KSTR:(K++) = 　返事もできずに%CALLNAME:MASTER%の言葉を頭の中で反芻し続けた……
						CASE 2
							KSTR:(K++) = 「……今の、もう一回言って。……いや、やっぱり言わないで。心臓が持たない」
					ENDSELECT
				ELSE
					KSTR:(K++) = 「……ずるいね、きみは。そういうことを、そういう顔で言う」
				ENDIF
		ENDSELECT
	CASE 2
		;トランス状態
		KSTR:(K++) = 「……あれ。おかしいな。きみの声が、やけに甘く聞こえる」
		KSTR:(K++) = 「……星晶獣の術？　……いや、違う。これは、ただ酔っているだけか」
ENDSELECT


;****************************************
;コマンド実行後に表示される文章
;モードを開始したり削除したりするものを記載
;****************************************
;・使い方
;「453」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************

;--------------------------------------------------
;COM80_手コキ
;--------------------------------------------------
;取得快楽：なし
;キャラが手コキをする方
@KOJO_COM_453_80(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
		;言いなり・特殊言いなり（未作成）
	ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
		;泥酔・トランス（未作成）
	ELSEIF TALENT:対象キャラ:恋慕 == 0 && CFLAG:対象キャラ:好感度レベル <= 関係閾値:4
		;無二の友未満（未作成）
	ELSE
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「こう？　……ふうん、こうするとこう動くのか。面白いね」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は興味深そうに、手の中のものの反応をじっと観察している。
			CASE 1
				KSTR:(K++) = 「何事も勉強だからね。どこが良いのか、ちゃんと口で言って」
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM81_フェラチオ
;--------------------------------------------------
;取得快楽：なし
;キャラがフェラチオをする方
@KOJO_COM_453_81(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF MODE_存在判定_プレイヤー側("パイズリフェラ", 対象キャラ)
		;パイズリ中はパイズリフェラに派生（未作成）
	ELSEIF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
		;言いなり・特殊言いなり（未作成）
	ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
		;泥酔・トランス（未作成）
	ELSEIF TALENT:対象キャラ:恋慕 == 0 && CFLAG:対象キャラ:好感度レベル <= 関係閾値:4
		;無二の友未満（未作成）
	ELSE
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ん……む。……顎が疲れる。きみ、もう少し小さくならない？」
			CASE 1
				KSTR:(K++) = 「ちゅ……。ふふ、きみのその顔、観察しがいがあるね」
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM60_Ｖ挿入する、体位を変える
;--------------------------------------------------
;取得快楽：Ｖ
;RFLAG:コマンド結果受渡し変数
;	体位の種類  0:正常位  1:後背位  2:寝バック  3:対面座位  4:背面座位  5:騎乗位  6:側位  7:屈曲位  8:駅弁  9:背面駅弁  10:対面立位  11:立ちバック
@KOJO_COM_453_60(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
		;言いなり・特殊言いなり（未作成）
	ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
		;泥酔・トランス（未作成）
	ELSEIF TALENT:対象キャラ:恋慕 == 0 && CFLAG:対象キャラ:好感度レベル <= 関係閾値:4
		;無二の友未満（未作成）
	ELSE
		IF RFLAG:コマンド結果受渡し変数 == 5
			;騎乗位
			KSTR:(K++) = 「上から見下ろすのも、悪くないね。……きみの顔が、よく見える」
		ELSE
			SELECTCASE CUP:対象キャラ:快Ｖ
				;各部位の累積が10000で絶頂
				CASE IS > 10000
					;即絶頂
					KSTR:(K++) = 「っ、あ……入れた、だけで……っ。待って、今、動かないで……_H_」
				CASE IS > 3000
					;感じている
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「ん……奥まで、きみでいっぱいだ。……変な感じ。嫌じゃない」
						CASE 1
							KSTR:(K++) = 「ふふ……入ったね。ゆっくりでいいよ。夜は長いから」
					ENDSELECT
				CASEELSE
					;まだ快楽に慣れていない
					KSTR:(K++) = 「……っ。ゆっくり、ね。……まだ、慣れていないんだから」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

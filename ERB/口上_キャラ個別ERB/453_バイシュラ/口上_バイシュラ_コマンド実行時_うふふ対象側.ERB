;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「453」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************

;--------------------------------------------------
;COM6_胸愛撫
;--------------------------------------------------
;取得快楽：Ｂ
;バイシュラはＢ感度+1（敏感）
@KOJO_COM_453_6(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TCVAR:対象キャラ:言いなり || TCVAR:対象キャラ:特殊言いなり
		;言いなり・特殊言いなり（未作成）
	ELSEIF BASE:対象キャラ:酩酊 >= 500 || TCVAR:対象キャラ:トランス残り時間 > 0
		;泥酔・トランス（未作成）
	ELSEIF TALENT:対象キャラ:恋慕 == 0 && CFLAG:対象キャラ:好感度レベル <= 関係閾値:4
		;無二の友未満（未作成）
	ELSEIF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-6-") < 0
		;初回実行（コマンド初回フラグ はされた側の記録。コマンド終了後に保存されるので、初回はまだ含まれていない）
		KSTR:(K++) = 「……触るの？　どうぞ。……期待されるほどの大きさじゃないけどね」
	ELSE
		SELECTCASE CUP:対象キャラ:快Ｂ
			;各部位の累積が10000で絶頂
			CASE IS > 10000
				;即絶頂
				KSTR:(K++) = 「あ、っ……だめ、そこ、弱……っ_H_」
			CASE IS > 3000
				;感じている
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ん……きみの手、熱いね。……私の胸、こんなに敏感だったかな」
					CASE 1
						KSTR:(K++) = 「ふふ、真剣な顔。何かの研究でもしているの？」
				ENDSELECT
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 「……ん。悪くはないよ。まだ、ちょっとくすぐったいけど」
		ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

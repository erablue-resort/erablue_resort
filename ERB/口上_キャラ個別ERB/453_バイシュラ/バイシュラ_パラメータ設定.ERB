;****************************************
;キャラの初期パラメータを口上側で制御するためのファイル
;****************************************
;・使い方
;「453」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;初期パラメータ変更
;--------------------------------------------------
@口上側初期パラメータ変更_453
;NEWGAME時に呼ばれる関数、ロード時には呼ばれないことに注意
;TALENTをONOFFしたり、EXPの取得や初期ABLの変更などをここに記述すること
LOCAL = GETCHARA(453)

;キャラクターが自分を指す際の呼び方
CSTR:LOCAL:一人称 = 私

;キャラクターがあなたを指す際の呼び方
CSTR:LOCAL:二人称 = オーナー

CSTR:LOCAL:キャラ固有好感度要素 =


;--------------------------------------------------
;ロード時パラメータ変更
;--------------------------------------------------
@口上側LOADENDパラメータ変更_453
;ロード時に呼ばれる関数。NEWGAME時に呼ばれないことに注意
LOCAL = GETCHARA(453)

IF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = 私
ENDIF

IF CSTR:LOCAL:二人称 == ""
	CSTR:LOCAL:二人称 = オーナー
ENDIF


;--------------------------------------------------
;弱点コマンド制御
;--------------------------------------------------
@弱点コマンド変更_453
;各変数にコマンド番号を入れること
LOCAL = GETCHARA(453)

; 0・1はセクハラ、2・3はうふふ、4はランダム
; 弱点コマンド枠:LOCAL:0 =
; 弱点コマンド枠:LOCAL:1 =

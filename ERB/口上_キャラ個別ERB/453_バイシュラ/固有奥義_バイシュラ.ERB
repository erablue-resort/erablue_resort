@固有奥義_453(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
奥義威力 = 450
SIF 基礎BATTLE_STATE:キャラ番号:Lv >= 40
	奥義威力 = 500
SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = 薬師瑠璃光法雨
	CASE "奥義説明文"
		詳細文文字列受け渡し変数 = 奥義威力：{奥義威力}％<br>除病安楽の効果が発動する（MP消費なし）。
		詳細文文字列受け渡し変数 += @"<br>自分の奥義ゲージを20上昇させる。"
		RETURN 奥義威力
	CASE "奥義追加効果"
		アビテンプレート用_アビ名 = 除病安楽
		CALL バイシュラ_除病安楽
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用変数:効果量 = 20
		CALL アビテンプレート_有利効果_奥義ゲージUP
ENDSELECT

;--------------------------------------------------
;COM10_乳首吸い（サラがTARGETの乳首を吸う）
;--------------------------------------------------
@KOJO_COMPLAYER_130_10(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TARGET == MASTER
	KSTR:(K++) = 「%CALLNAME:MASTER%さんのここ……吸ってもいいですか……？　ちゅっ……」
	KSTR:(K++) = サラが恥ずかしそうに%CALLNAME:MASTER%の胸に唇を寄せた。小さな唇が乳首を吸い始めると、おずおずと舌先で転がすように舐め始める……
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM10_1強く吸う
;--------------------------------------------------
@KOJO_COMPLAYER_130_10_1(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TARGET == MASTER
	KSTR:(K++) = 「んっ……ちゅうぅっ……強く吸ったら……気持ちいいですか……？」
	KSTR:(K++) = サラが頬をへこませて強く吸い上げた。一生懸命に吸うその姿は赤ん坊の授乳のようでいて、けれどその瞳は%CALLNAME:MASTER%の反応を窺う色気を帯びていた……
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM10_2乳首甘噛み
;--------------------------------------------------
@KOJO_COMPLAYER_130_10_2(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TARGET == MASTER
	KSTR:(K++) = 「あむっ……噛んだら痛いですか……？　ごめんなさい……でも、ちょっとだけ……」
	KSTR:(K++) = 小さな歯が乳首を甘く噛んだ。加減がわからないのか、おっかなびっくり歯を立てている。その健気な仕草がかえって%CALLNAME:MASTER%の興奮を煽った……
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM10_3頭を撫でる（サラがTARGETの頭を撫でる）
;--------------------------------------------------
@KOJO_COMPLAYER_130_10_3(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TARGET == MASTER
	KSTR:(K++) = 「えへへ……%CALLNAME:MASTER%さんの頭……撫でちゃいます。いつもは撫でてもらう側なのに……なんだか不思議な気持ちです」
	KSTR:(K++) = サラの小さな手が%CALLNAME:MASTER%の髪を優しく梳いている。普段とは逆の立場に照れながらも、母性のような温かさがその指先から伝わってきた……

;--------------------------------------------------
;●黄金の騎士口上＠erablue_resort用
;　――固有奥義
;--------------------------------------------------

;--------------------------------------------------
;●ライセンス/更新履歴/概要/使用フラグ
;--------------------------------------------------
;　いずれも黄金の騎士口上_readme.txt記載に従う
;--------------------------------------------------

@固有奥義_1576(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 奥義実威力
#DIM 奥義実威力_グラビティ
#DIM 地震対象

	IF 0
	ELSEIF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 40
		奥義名 = 降臨：地のオパートス
		奥義実威力 = 300
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 40
		奥義名 = 地神の寝返り
		奥義実威力 = 250
	ELSE
		奥義名 = 地神のいびき
		奥義実威力 = 200
	ENDIF

	;行動速度低下状態なら威力増加、2倍。
	奥義実威力_グラビティ = 奥義実威力 * 2

	;特殊処理を行う奥義なのでここはゼロ
	奥義威力 = 0

	;実行時メッセージ
	;２行目はランダムで１行出るよ
	アビ汎用文字列:実行時メッセージ１ = どこからともなく、雄々しい男神の声が響く！
	STRDATA アビ汎用文字列:実行時メッセージ２
		DATAFORM 『フハハハ！　間もなく、この地に変動が起こるであろう！』
		DATAFORM 『フハァッハハハハハハ！　愉快愉快！』
		DATAFORM 『ファハハハハハハハハハハハハハー！　フワハァー！』
		DATAFORM 『フフッフフッフハハハハハ！』
		DATAFORM 『フッハッハハー！』
		DATAFORM 『フゥーハハハァー！』
	ENDDATA

	SELECTCASE ARGS
		CASE "奥義名"
			TSTR:コマンド名受渡 = %奥義名%
		CASE "奥義説明文"
			詳細文文字列受け渡し変数 = 奥義威力：{奥義実威力}％
			詳細文文字列受け渡し変数 += @"<br>敵全体に土属性の奥義ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>対象に行動速度低下効果が付与されている場合、代わりに、威力［{奥義実威力_グラビティ}％］の土属性の奥義ダメージを与える。"

			RETURN 奥義威力
		CASE "奥義前効果"
			;対象決定の後、ダメージよりも前に発生する効果。基本の奥義ダメージ部分は記載する必要はない。
			;奥義威力が0だとここの部分もスキップされる

			;処理の都合上、ここから奥義ダメージまでにリセットを噛ませてないため
			;必要な場合を除きここでリセット
			CALL アビ汎用変数文字列リセット
		CASE "奥義追加効果"
			;ここに奥義効果を記述する。基本の奥義ダメージ部分は記載する必要はない。
			;基本的にアビテンプレートの関数を使用すること
			;テンプレート使用の例は固有アビリティ_キャラ名.ERBに記載

			;この攻撃は、敵の行動速度が低下している場合に強力になる

			;敵全体で回す
			FOR 地震対象, 10, 20
				;対象がいなかったら次
				SIF 敵BATTLE_STATE_STR:(地震対象 - 10):エネミー名 == ""
					CONTINUE
				;既に撃破されてたら次
				SIF 敵BATTLE_STATE:(地震対象 - 10):ＨＰ <= 0
					CONTINUE

				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_指定(地震対象)
				アビ汎用文字列:ダメージ種類 = 奥義ダメージ

				IF バフ・デバフ効果検索("デバフ", "能力", "行動速度", 地震対象) >= 0
					アビ汎用変数:効果割合 = 奥義実威力_グラビティ
				ELSE
					アビ汎用変数:効果割合 = 奥義実威力
				ENDIF

				CALL アビテンプレート_ダメージ処理_土属性
			NEXT


	ENDSELECT




;--------------------------------------------------
;●黄金の騎士口上＠erablue_resort用
;　――固有アビリティ
;--------------------------------------------------

;--------------------------------------------------
;●ライセンス/更新履歴/概要/使用フラグ
;--------------------------------------------------
;　いずれも黄金の騎士口上_readme.txt記載に従う
;--------------------------------------------------


;--------------------------------------------------
;●スキルに関するメモ
;--------------------------------------------------
;戦闘中の表示について：
;　アビリティ名の文字数は全角で12文字くらいまで。
;　固有アビに使える行は３行
;　１行に表示するアビリティは３つ
;　ただし「じゃあ最大９アビまで表示が崩れないのか？」というとちょっと違って
;　/
;　[100] 通常攻撃
;　[110] なまえのなが～いアビリティいち～～～[111] アビリティ２
;　[112] アビリティ３
;　[120] アビリティ４　[121] アビリティ５
;　（証アビ行）
;　/
;　……と、本来は[110]と同じ行に表示されるべき[112]が改行されて表示されちゃう場合がある。
;　
;　アビリティの解説文についても、それなりの長さで切らないとウィンドウからハミでる。
;　「イルヴァの地において、ギャルのパンティーとは、神に願われるものであり、楽器であり、強力な投擲武器である。」
;　この文章は、「楽器であり」あたりで切れちゃう。
;　適度に改行するなどが必要。
;--------------------------------------------------


;--------------------------------------------------
;●スキル仕様
;--------------------------------------------------
;・アビ１：突進
;　自属性・単体攻撃。
;　敵の後列を対象にするとき、ダメージが上昇する。
;　/
;　敵に近づきながら攻撃するアビリティ。
;　本当は２マス以上距離が開いていなければ使用できないのだが……
;・アビ２：挑発→英雄の魔法
;　自身に敵対心向上を付与する。
;　→さらに、攻撃力、命中率を上昇させる。
;　/
;　攻撃系自己強化魔法、『英雄』の魔法。
;　Elonaの大地の大槌の発動魔法は『英雄』。
;　英雄の魔法に敵対心向上の効果はないけど、まあ……
;　挑発単品ではあまり使う意味はないかも。
;・アビ３：自然の包容の魔法
;　味方単体に（→味方全体に）リジェネを付与する。
;・アビ４：パンティー投擲
;　自属性・単体攻撃。
;　相手を混乱させることがある。
;　/
;　『革の黄金の騎士のパンティー』を投擲する。
;　→『☆黄金に輝く黄金の騎士のパンティー』を投擲する。
;・アビ５：★大地の大槌
;　土属性・単体攻撃。
;　その後、追撃で、敵全体に土属性攻撃を発生させることがある。
;　この追撃は、『行動速度低下』があると威力が上昇する。
;　/
;　大地の神、『地のオパートス』より賜る神器。
;　装備すると『HPが２倍になる』という超強力な効果を持つ。
;　攻撃時追加効果で地震の魔法を発動することがある（約16％らしい）。
;　その他、防御面を向上する効果なども付与されているが、ひとまず再現はこのくらいで……
;・アビ６：地震の魔法
;　土属性・全体攻撃、大ダメージ。
;　消費が大きい。
;　この攻撃は、『行動速度低下』があると威力が上昇する。
;　/
;　トップクラスの威力を誇る、自分中心・広範囲・大ダメージの魔法。
;　浮遊状態の敵には威力が下がり、グラビティ状態の敵にはさらに大ダメージを与える。
;
;・奥義：降臨・地のオパートス
;　敵全体に土属性の大ダメージを与える。
;　この攻撃は、『行動速度低下』があると威力が上昇する。
;　フゥーハハハァー。
;　/
;　「フハハハ！間もなく、この地に変動が起こるであろう！」
;　「フハァッハハハハハハ！愉快愉快！」
;　「ファハハハハハハハハハハハハハー！フワハァー！」
;　「フフッフフッフハハハハハ！」
;　「フッハッハハー！」
;
;・パッシブ１：大地の力
;　ドロップ率上昇。
;　防御力が上昇。
;　/
;　原作的には、「重いものを持てる、何でも文句を言わずに持つ、攻撃に重力を付与」というもの。
;　なんでも持ち帰れる……ということで、敵のドロップ率を上昇させるということで。
;　防御力上昇は、地のオパートスを信仰した際の加護。原作ではもっと強力だけどね。
;・パッシブ２：大地の重圧
;　全ての攻撃行動に『行動速度低下』が付与される。
;　/
;　原作的には、パッシブ『大地の力』の効果の一部。
;　相手に「グラビティ」状態を付与する。
;　「グラビティ」状態は、相手の速度を下げ、浮遊している敵を撃ち落とし、「地震」の魔法の威力を大幅に上昇させるもの。
;・パッシブ３：致命傷防御
;　戦闘開始時、低倍率の自動復活が付与される。
;　/
;　原作では、「最大HPの10％以上のダメージを受ける時、大幅にダメージを減算する」という効果である。
;　Elinではオートアタック中に死なずに食いしばるシステムがあるので……
;--------------------------------------------------


;--------------------------------------------------
;〇突進
;--------------------------------------------------
@固有アビ_1576_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 威力値
#DIM 総合威力値
#DIM 後列ダメージ加算
#DIM 対象隊列位置

	;2マス以上離れた敵に突撃し、一気に距離を詰めるアビリティ。
	;本当は密着した相手には使えないのだが……

	;Lv1から習得
	IF 0
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
		アビ名 = 突進＋＋
		威力値 = 150
		後列ダメージ加算 = 50
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
		アビ名 = 突進＋
		威力値 = 140
		後列ダメージ加算 = 40
	ELSE
		アビ名 = 突進
		威力値 = 130
		後列ダメージ加算 = 30
	ENDIF

	総合威力値 = 威力値 + 後列ダメージ加算

	;消費量は固定
	消費ＭＰ = 5

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += @"<br>敵単体に［{威力値}％］の自属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>攻撃対象が後列の場合、威力が上昇する（威力が［{総合威力値}％］となる）"
			RETURN 消費ＭＰ
		CASE "アビ説明文_詳細"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += @"<br>敵単体に［{威力値}％］の自属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>攻撃対象が後列の場合、威力が上昇する（威力が［{総合威力値}％］となる）"
		CASE "アビ効果"

			;敵単体を選択
			CALL アビ対象選択テンプレート_敵単体
			;威力をセット
			アビ汎用変数:効果割合 = 威力値

			;対象が後列にいるかをチェック
			;敵が後列にいるかは、「敵の位置（＝アビテンプレート用_対象保存:0）が10.12.14.16.18であるか」をチェックすればよい。
			対象隊列位置 = アビテンプレート用_対象保存:0
			対象隊列位置 = 対象隊列位置 % 2
			;２で割った余りがゼロなら＝対象位置が偶数であるなら＝敵の位置が「10.12.14.16.18」であるなら、敵が後列にいると取り、上昇した威力をセット
			SIF 対象隊列位置 == 0
				アビ汎用変数:効果割合 = 総合威力値

			;自属性攻撃
			CALL アビテンプレート_ダメージ処理_自属性

	ENDSELECT



;--------------------------------------------------
;〇挑発→英雄の魔法
;--------------------------------------------------
@固有アビ_1576_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM バフ値_敵対心
#DIM バフ値_攻撃バフ
#DIM バフ値_命中バフ
#DIM バフ値_持続ターン

	;挑発は、Elinでは「周囲の味方への攻撃をかばうことがある」というものなのだが、こちらではシンプルに敵対心バフ
	;英雄の魔法は、攻撃力、命中率に主に影響する魔法
	;英雄の魔法はオパ子は使えないが、Elonaにおける大地の大槌の追加発動魔法だった。

	;Lv1から習得
	IF 0
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
		アビ名 = 英雄の魔法
		バフ値_敵対心 = 100
		バフ値_攻撃バフ = 20
		バフ値_命中バフ = 10
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
		アビ名 = 挑発＋
		バフ値_敵対心 = 75
		バフ値_攻撃バフ = 0
		バフ値_命中バフ = 0
	ELSE
		アビ名 = 挑発
		バフ値_敵対心 = 50
		バフ値_攻撃バフ = 0
		バフ値_命中バフ = 0
	ENDIF

	;消費量とバフ持続
	消費ＭＰ = 10
	バフ値_持続ターン = 3

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += @"<br>自身に［{バフ値_敵対心}％］（A枠・3ターン）の敵対心上昇効果を与える。"
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
				詳細文文字列受け渡し変数 += @"<br>自身に［{バフ値_攻撃バフ}％］（B枠・3ターン）の攻撃力上昇効果を与える。"
				詳細文文字列受け渡し変数 += @"<br>自身に［{バフ値_命中バフ}％］（B枠・3ターン）の命中率上昇効果を与える。"
			ENDIF
			RETURN 消費ＭＰ
		CASE "アビ効果"
			;対象は自身のみ
			CALL アビ対象選択テンプレート_自己のみ

			;敵対心上昇
			アビ汎用文字列:バフ・デバフ枠 = 敵対心A
			アビ汎用文字列:バフ・デバフ対象能力 = 敵対心
			アビ汎用変数:効果割合 = バフ値_敵対心
			アビ汎用変数:持続ターン = バフ値_持続ターン
			CALL アビテンプレート_有利効果_バフ効果セット

			;攻撃、命中上昇
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
				CALL アビ汎用変数文字列リセット
				アビ汎用文字列:バフ・デバフ枠 = 攻撃力B
				アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
				アビ汎用変数:効果割合 = バフ値_攻撃バフ
				アビ汎用変数:持続ターン = バフ値_持続ターン
				CALL アビテンプレート_有利効果_バフ効果セット

				CALL アビ汎用変数文字列リセット
				アビ汎用文字列:バフ・デバフ枠 = 命中率B
				アビ汎用文字列:バフ・デバフ対象能力 = 命中率
				アビ汎用変数:効果割合 = バフ値_命中バフ
				アビ汎用変数:持続ターン = バフ値_持続ターン
				CALL アビテンプレート_有利効果_バフ効果セット
			ENDIF

	ENDSELECT



;--------------------------------------------------
;〇自然の包容の魔法
;--------------------------------------------------
@固有アビ_1576_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM バフ値_再生
#DIM バフ値_持続ターン

	;リジェネを付与するタイプの魔法
	;効果は地味だが、黄金の騎士は頑丈なので相対的に強力

	;Lv10から習得
	;＋＋になると全体化
	IF 0
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
		アビ名 = 自然の包容の魔法＋＋
		バフ値_再生 = 10
		バフ値_持続ターン = 5
		;本来は全体化すると人数分倍になるが……
		消費ＭＰ = 25
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
		アビ名 = 自然の包容の魔法＋
		バフ値_再生 = 10
		バフ値_持続ターン = 5
		消費ＭＰ = 10
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
		アビ名 = 自然の包容の魔法
		バフ値_再生 = 10
		バフ値_持続ターン = 3
		消費ＭＰ = 10
	;10未満なら覚えない
	ELSE
		アビ名 = 
	ENDIF

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
				詳細文文字列受け渡し変数 += @"<br>味方全体に［回復力✕{バフ値_再生}％］（独自枠・{バフ値_持続ターン}ターン）の再生効果を与える。"
			ELSE
				詳細文文字列受け渡し変数 += @"<br>味方単体に［回復力✕{バフ値_再生}％］（独自枠・{バフ値_持続ターン}ターン）の再生効果を与える。"
			ENDIF
			RETURN 消費ＭＰ
		CASE "アビ効果"
			;対象はLv30以上で全体化
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
				CALL アビ対象選択テンプレート_味方全体_生者のみ
			ELSE
				CALL アビ対象選択テンプレート_味方単体_生者のみ
			ENDIF

			;再生を付与
			アビ汎用文字列:バフ・デバフ枠 = 自然の包容
			アビ汎用文字列:バフ・デバフ対象能力 = 再生
			CALL バフ込み数値算出("回復力")
			アビ汎用変数:効果量 = RESULT * バフ値_再生 / 100
			アビ汎用変数:持続ターン = バフ値_持続ターン
			CALL アビテンプレート_有利効果_バフ効果セット

	ENDSELECT



;--------------------------------------------------
;〇パンティー投擲
;--------------------------------------------------
@固有アビ_1576_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 威力値
#DIM 混乱_効果率
#DIM 混乱_付与率
#DIM 混乱_効果ターン

	;Lv15から習得
	;Elinの世界、イルヴァのノースティリス地方においては、パンティーは強力な投擲武器であり、楽器であり、神に願われるものである。
	;相手に投げると幻惑属性のダメージを与え、混乱させることができる。
	;なぜか投げても戻ってくる。
	;/
	;陥落するとパンティーがパワーアップするので、こちらもパワーアップ
	;文字数的に、「☆黄金に輝く黄金の騎士のパンティー」はオーバーしてしまうので、「黄金の騎士の」部分はカット
	IF 0
	ELSEIF GETBIT(陥落チェック(キャラ番号), 0)
		アビ名 = ☆黄金に輝くパンティー
		;接頭辞「黄金に輝く」＝素材がゴールデン、金なんだけど……金は武器性能としてはイマイチ
		;まあ革よりはよっぽど強いが……
		威力値 = 200
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
		アビ名 = 革のパンティー
		威力値 = 150
	;15未満なら覚えない
	ELSE
		アビ名 = 
	ENDIF

	;混乱付与
	混乱_効果率 = 30
	混乱_付与率 = 30
	混乱_効果ターン = 3
	;パンティー投擲はノーコストの通常攻撃なので、コストはかなり低い設定に
	消費ＭＰ = 3

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += @"<br>敵単体に［{威力値}％］の自属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>［{混乱_効果率}％］の混乱効果を与える。成功率{混乱_付与率}％。"
			;「……パンティー！？」ってなるかもなのでここは解説
			IF GETBIT(陥落チェック(キャラ番号), 0)
				詳細文文字列受け渡し変数 += @"<br>アーティファクト、☆黄金に輝く黄金の騎士のパンティーを誇らしげに構えて投擲する。"
			ELSE
				詳細文文字列受け渡し変数 += @"<br>黄金の騎士のパンティー（革製）を投擲する。"
			ENDIF
			RETURN 消費ＭＰ
		CASE "アビ説明文_詳細"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += @"<br>敵単体に［{威力値}％］の自属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>［{混乱_効果率}％］の混乱効果を与える。成功率{混乱_付与率}％。"
			;「……パンティー！？」ってなるかもなのでここは解説
			IF GETBIT(陥落チェック(キャラ番号), 0)
				詳細文文字列受け渡し変数 += @"<br>アーティファクト、☆黄金に輝く黄金の騎士のパンティーを誇らしげに構えて投擲する。"
			ELSE
				詳細文文字列受け渡し変数 += @"<br>黄金の騎士のパンティー（革製）を投擲する。"
			ENDIF
			詳細文文字列受け渡し変数 += @"<br>イルヴァの地において、ギャルのパンティーとは、神に願われるものであり、楽器であり、強力な投擲武器である。"
			詳細文文字列受け渡し変数 += @"<br>……投げてもなぜか即座に手元に戻ってくる。"


		CASE "アビ効果"
			;攻撃自体はふつーのやつ
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用変数:効果割合 = 威力値
			CALL アビテンプレート_ダメージ処理_自属性

			;混乱を付与
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 混乱
			アビ汎用文字列:バフ・デバフ対象能力 = 混乱
			アビ汎用変数:効果割合 = 混乱_効果率
			アビ汎用変数:持続ターン = 混乱_効果ターン
			アビ汎用変数:基礎成功確率 = 混乱_付与率
			CALL アビテンプレート_不利効果_デバフ効果セット

	ENDSELECT



;--------------------------------------------------
;〇大地の大槌
;--------------------------------------------------
@固有アビ_1576_5(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 威力値
#DIM 追加攻撃_威力値
#DIM 追加攻撃_発動率
#DIM 追加攻撃_特効威力値
#DIM 地震対象

	;地のオパートスより賜る神器、固定アーティファクト
	;装備するだけでHPが２倍、攻撃時たまに地震の魔法を発動などの強力な効果を持つ。
	;さらに、この槌を地のオパートスの信仰者が持っていると、同じ勢力の味方全体に筋力バフの効果などが付与される。
	;……が、このリゾートでは再現しないこととします。同じ勢力ではないしな……

	;Lv20から習得
	IF 0
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 40
		アビ名 = ★《大地の大槌》
		威力値 = 200
		追加攻撃_発動率 = 32
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
		アビ名 = ★大地の大槌＋
		威力値 = 175
		追加攻撃_発動率 = 24
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
		アビ名 = ★大地の大槌
		威力値 = 150
		;16、なのは原作の追加効果発動率から
		追加攻撃_発動率 = 16
	;20未満なら覚えない
	ELSE
		アビ名 = 
	ENDIF

	;追加攻撃の地震の威力は変わらず、としておく
	追加攻撃_威力値 = 100
	追加攻撃_特効威力値 = 200

	;これもぶっちゃけ通常攻撃なのだが……
	消費ＭＰ = 20

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += @"<br>敵単体に［{威力値}％］の土属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>［{追加攻撃_発動率}％］の確率で、敵全体に［{追加攻撃_威力値}％］の土属性ダメージを与える追加攻撃を行う。"
			詳細文文字列受け渡し変数 += @"<br>対象に行動速度低下効果が付与されている場合、代わりに、"
			詳細文文字列受け渡し変数 += @"<br>［{追加攻撃_特効威力値}％］の土属性ダメージを与える追加攻撃を行う。"
			RETURN 消費ＭＰ
		CASE "アビ効果"
			;攻撃自体はふつーのやつ
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用変数:効果割合 = 威力値
			CALL アビテンプレート_ダメージ処理_土属性

			;当たった場合のみ、追加攻撃がランダムで発動
			IF !アビテンプレート用_回避フラグ && RAND:100 < 追加攻撃_発動率
				;この攻撃は、敵の行動速度が低下している場合に強力になる。
				;……なので、敵を１体１体見る必要があるんじゃないかな……

				;敵全体で回す
				FOR 地震対象, 10, 20
					;対象がいなかったら次
					SIF 敵BATTLE_STATE_STR:(地震対象 - 10):エネミー名 == ""
						CONTINUE
					;既に撃破されてたら次
					SIF 敵BATTLE_STATE:(地震対象 - 10):ＨＰ <= 0
						CONTINUE

					CALL アビ汎用変数文字列リセット
					CALL アビ対象選択テンプレート_指定(地震対象)
					IF バフ・デバフ効果検索("デバフ", "能力", "行動速度", 地震対象) >= 0
						アビ汎用変数:効果割合 = 追加攻撃_特効威力値
					ELSE
						アビ汎用変数:効果割合 = 追加攻撃_威力値
					ENDIF
					CALL アビテンプレート_ダメージ処理_土属性
				NEXT
			ENDIF

	ENDSELECT



;--------------------------------------------------
;〇地震の魔法
;--------------------------------------------------
@固有アビ_1576_6(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 威力値
#DIM 特効威力値
#DIM 地震対象
#DIM 混乱_効果率
#DIM 混乱_付与率
#DIM 混乱_効果ターン

	;Lv30から習得
	;Elin原作では、「衝撃属性の、周囲全体の広範囲に、味方も巻き込む可能性のある極大ダメージの魔法」という具合。
	;衝撃属性は当てると相手を朦朧とさせる効果があり、耐性持ちがほとんどおらず通りもいい、非常に強力な属性。
	;……それがフレンドリーファイアありで全方位広範囲に極大ダメージ……なので、普段はわりと使いづらかったりはする。
	;味方の巻き込みは技能で防ぐことができるが……流石に味方も巻き込むのはカット。

	IF 0
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 50
		アビ名 = 地震の魔法＋＋
		威力値 = 300
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 40
		アビ名 = 地震の魔法＋
		威力値 = 275
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 30
		アビ名 = 地震の魔法
		威力値 = 250
	;30未満なら覚えない
	ELSE
		アビ名 = 
	ENDIF

	;威力の上昇値は固定としておく
	;実際には、倍くらいになるんだけども……
	特効威力値 = 威力値 + 150

	;消費は重い
	消費ＭＰ = 100

	;混乱付与
	混乱_効果率 = 20
	混乱_付与率 = 20
	混乱_効果ターン = 3

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += @"<br>敵全体に［{威力値}％］の土属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>対象に行動速度低下効果が付与されている場合、代わりに、［{特効威力値}％］の土属性ダメージを与える。"
			詳細文文字列受け渡し変数 += @"<br>［{混乱_効果率}％］の混乱効果を与える。成功率{混乱_付与率}％。"
			RETURN 消費ＭＰ
		CASE "アビ効果"

			;この攻撃は、敵の行動速度が低下している場合に強力になる

			;敵全体で回す
			FOR 地震対象, 10, 20
				;対象がいなかったら次
				SIF 敵BATTLE_STATE_STR:(地震対象 - 10):エネミー名 == ""
					CONTINUE
				;既に撃破されてたら次
				SIF 敵BATTLE_STATE:(地震対象 - 10):ＨＰ <= 0
					CONTINUE

				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_指定(地震対象)

				IF バフ・デバフ効果検索("デバフ", "能力", "行動速度", 地震対象) >= 0
					アビ汎用変数:効果割合 = 特効威力値
				ELSE
					アビ汎用変数:効果割合 = 威力値
				ENDIF

				CALL アビテンプレート_ダメージ処理_土属性

				;混乱を付与
				CALL アビ汎用変数文字列リセット
				アビ汎用文字列:バフ・デバフ枠 = 混乱
				アビ汎用文字列:バフ・デバフ対象能力 = 混乱
				アビ汎用変数:効果割合 = 混乱_効果率
				アビ汎用変数:持続ターン = 混乱_効果ターン
				アビ汎用変数:基礎成功確率 = 混乱_付与率
				CALL アビテンプレート_不利効果_デバフ効果セット
			NEXT

	ENDSELECT




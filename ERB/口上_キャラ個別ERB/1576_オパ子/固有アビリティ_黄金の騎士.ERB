;--------------------------------------------------
;大地の力３：グラビティ付与
;--------------------------------------------------
@固有行動直後処理_バフ・デバフ_大地の重圧(効果番号)
#DIM 効果番号
#DIM キャラ番号
#DIM 対象隊列位置
#DIM 対象ナンバー

	キャラ番号 = GETCHARA(1576)

	;対象チェック
	対象隊列位置 = アビテンプレート用_対象保存:0
	対象ナンバー = 対象隊列位置 - 10
	
	;対象がいない場合は帰る
	SIF 対象隊列位置 == -1
		RETURN 0
	;対象が10～20（敵の位置）の範囲外なら＝対象が敵でないなら、帰る
	SIF !INRANGE(対象隊列位置, 10, 20)
		RETURN 0
	;敵が居ないマスはスキップ
	SIF 敵BATTLE_STATE_STR:対象ナンバー:エネミー名 == ""
		RETURN 0
	;死んでたらスキップ
	SIF 敵BATTLE_STATE:対象ナンバー:ＨＰ < 1
		RETURN 0

	;敵であった場合、そいつに独自デバフ『グラビティ』を付与
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_指定(対象隊列位置)
	アビテンプレート用_アビ名 = 大地の重圧
	アビ汎用文字列:バフ・デバフ枠 = グラビティ
	アビ汎用文字列:バフ・デバフ対象能力 = 行動速度
	アビ汎用変数:効果割合 = 20
	アビ汎用変数:持続ターン = 3
	;原作だと抵抗不能なはずだけど、ままま、ここはね。
	アビ汎用変数:基礎成功確率 = 30
	CALL アビテンプレート_不利効果_デバフ効果セット



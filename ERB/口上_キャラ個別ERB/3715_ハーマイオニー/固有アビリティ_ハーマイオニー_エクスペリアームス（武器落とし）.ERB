
;アビエディタによる生成関数
@固有アビ_3715_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM Lv_習得
#DIM Lv_プラス
#DIM Lv_プラプラ
#DIM キャラレベル
#DIM 威力値
#DIM デバフ_攻撃力減少率
#DIM デバフ_攻撃力減少ターン

	;習得レベルなど設定
	Lv_習得 = 15
	Lv_プラス = 25
	Lv_プラプラ = 40
	キャラレベル = 基礎BATTLE_STATE:キャラ番号:Lv

	IF キャラレベル >= Lv_プラプラ
;		アビ名 = エクスペリ゛ア゛ァ゛ッ！！！
		;文字数的に半角にする
		アビ名 = ｴ゛ｸｽﾍﾟﾘｧ゛ｱ゛ｯｯｯ！！！
		消費ＭＰ = 75
		威力値 = 300
		デバフ_攻撃力減少率 = 100
		デバフ_攻撃力減少ターン = 5
	ELSEIF キャラレベル >= Lv_プラス
		アビ名 = エクスペリアームス（武器落とし）＋
		消費ＭＰ = 25
		威力値 = 10
		デバフ_攻撃力減少率 = 50
		デバフ_攻撃力減少ターン = 3
	ELSEIF キャラレベル >= Lv_習得
		アビ名 = エクスペリアームス（武器落とし）
		消費ＭＰ = 20
		威力値 = 10
		デバフ_攻撃力減少率 = 50
		デバフ_攻撃力減少ターン = 1
	ELSE
		;アビ名を空欄にすると習得しない
		アビ名 = 
	ENDIF

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += "<br>敵単体に［{威力値}％］の<font color='#C0C0C0'>無属性</font>ダメージを与える。"
			詳細文文字列受け渡し変数 += "<br>［{デバフ_攻撃力減少率}％］（Ａ枠・{デバフ_攻撃力減少ターン}ターン）の攻撃力減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［{デバフ_バフ消去値}］のバフ消去効果を与える。"
			詳細文文字列受け渡し変数 += "<br>武装解除の魔法。魔法使いの間で決闘に使われる、ポピュラーな魔法。"
			SIF キャラレベル >= Lv_プラプラ
				詳細文文字列受け渡し変数 += "<br>凄まじい叫びとともに繰り出される斬撃は、武器を落とさせるために敵の腕を切断する。"
		CASE "アビ効果"
			;対象は敵単体
			CALL アビ対象選択テンプレート_敵単体

			;攻撃部分
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 威力値
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			CALL アビテンプレート_ダメージ処理_無属性

			;攻撃デバフ
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力A
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:効果割合 = デバフ_攻撃力減少率
			アビ汎用変数:持続ターン = デバフ_攻撃力減少ターン
			CALL アビテンプレート_不利効果_デバフ効果セット

			;バフ消去
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_バフ消去
	ENDSELECT




;アビエディタによる生成関数
@固有アビ_3715_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM Lv_習得
#DIM Lv_プラス
#DIM Lv_プラプラ
#DIM キャラレベル
#DIM バフ_攻撃力上昇値
#DIM デバフ_攻撃力減少値

	;習得レベルなど設定
	;デフォルト習得
	Lv_習得 = 1
	Lv_プラス = 10
	Lv_プラプラ = 25
	キャラレベル = 基礎BATTLE_STATE:キャラ番号:Lv

	IF キャラレベル >= Lv_プラプラ
		アビ名 = マグヌス・クレモル（猿叫）＋＋
		バフ_攻撃力上昇値 = 35
		デバフ_攻撃力減少値 = 15
	ELSEIF キャラレベル >= Lv_プラス
		アビ名 = マグヌス・クレモル（猿叫）＋
		バフ_攻撃力上昇値 = 35
		デバフ_攻撃力減少値 = 10
	ELSEIF キャラレベル >= Lv_習得
		アビ名 = マグヌス・クレモル（猿叫）
		バフ_攻撃力上昇値 = 30
		デバフ_攻撃力減少値 = 10
	ELSE
		;アビ名を空欄にすると習得しない
		アビ名 = 
	ENDIF

	;消費MPは共通
	消費ＭＰ = 20

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += "<br>味方単体に［{バフ_攻撃力上昇値}％］（Ａ枠・3ターン）の攻撃力上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>敵全体に［{デバフ_攻撃力減少値}％］（Ａ枠・3ターン）の攻撃力減少効果を与える。"
			詳細文文字列受け渡し変数 += "<br>ハーマイオニーが習得する様子のおかしい魔法。"
			詳細文文字列受け渡し変数 += "<br>マグヌス・クレモル（大きい声）の名の通り、凄まじい大声の詠唱で味方を鼓舞し敵を圧倒する。"
		CASE "アビ効果"
			;味方単体の攻撃力上昇
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方単体
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力A
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:効果割合 = バフ_攻撃力上昇値
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット

			;敵攻撃力減少
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力A
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:効果割合 = デバフ_攻撃力減少値
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_不利効果_デバフ効果セット
	ENDSELECT



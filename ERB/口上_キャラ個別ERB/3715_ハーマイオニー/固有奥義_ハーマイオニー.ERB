 
 
 
@固有奥義_3715(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名
#DIM 表示用奥義威力

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
	奥義名 = ウィンガーディアム・レビオーサ+（かち上げ+）
	奥義威力 = 350
ELSEIF 1
	奥義名 = ウィンガーディアム・レビオーサ（かち上げ）
	奥義威力 = 300
ENDIF

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
			詳細文文字列受け渡し変数 = 奥義威力：350　自属性
			詳細文文字列受け渡し変数 += "<br>"
			詳細文文字列受け渡し変数 += "<br>（Ａ枠・2ターン）の恐怖効果を与える。"
			詳細文文字列受け渡し変数 += "<br>自身に［50％］（Ａ枠・3ターン）のゲージ上昇効率上昇効果を与える。"
		ELSEIF 1
			詳細文文字列受け渡し変数 = 奥義威力：300　自属性
			詳細文文字列受け渡し変数 += "<br>"
			詳細文文字列受け渡し変数 += "<br>（Ａ枠・2ターン）の恐怖効果を与える。"
		ENDIF
	CASE "奥義前効果"
	CASE "奥義追加効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_奥義対象()
			アビ汎用文字列:バフ・デバフ枠 = 恐怖A
			アビ汎用文字列:バフ・デバフ対象能力 = 恐怖
			アビ汎用変数:持続ターン = 2
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = ゲージ上昇効率A
			アビ汎用文字列:バフ・デバフ対象能力 = ゲージ上昇効率
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 1
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_奥義対象()
			アビ汎用文字列:バフ・デバフ枠 = 恐怖A
			アビ汎用文字列:バフ・デバフ対象能力 = 恐怖
			アビ汎用変数:持続ターン = 2
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF
ENDSELECT


 

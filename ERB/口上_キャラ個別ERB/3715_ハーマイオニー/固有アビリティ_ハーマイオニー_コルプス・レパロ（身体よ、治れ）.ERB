;アビエディタによる生成関数
@固有アビ_3715_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM Lv_習得
#DIM Lv_プラス
#DIM Lv_プラプラ
#DIM キャラレベル
#DIM 回復力反映率
#DIM 奥義ゲージ回復値

	;習得レベルなど設定
	Lv_習得 = 5
	Lv_プラス = 15
	Lv_プラプラ = 30
	キャラレベル = 基礎BATTLE_STATE:キャラ番号:Lv

	IF キャラレベル >= Lv_プラプラ
		アビ名 = コルプス・レパロ（身体よ、治れ）＋＋
		回復力反映率 = 100
		奥義ゲージ回復値 = 50
	ELSEIF キャラレベル >= Lv_プラス
		アビ名 = コルプス・レパロ（身体よ、治れ）＋
		回復力反映率 = 100
		奥義ゲージ回復値 = 40
	ELSEIF キャラレベル >= Lv_習得
		アビ名 = コルプス・レパロ（身体よ、治れ）
		回復力反映率 = 100
		奥義ゲージ回復値 = 30
	ELSE
		;アビ名を空欄にすると習得しない
		アビ名 = 
	ENDIF

	;消費MPは共通
	消費ＭＰ = 40

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}
			詳細文文字列受け渡し変数 += "<br>自身に［{奥義ゲージ回復値}］の奥義ゲージUP効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［回復力✕{回復力反映率}％］のＨＰ回復を与える。"
			詳細文文字列受け渡し変数 += "<br>ハーマイオニーは刀傷の治癒がとても上手である。"
			詳細文文字列受け渡し変数 += "<br>日常的に使い慣れた魔法のようだ。どういう日常なのか。"
			詳細文文字列受け渡し変数 += "<br>あと、血を見るとちょっと興奮するらしい。"
		CASE "アビ効果"
			;対象は自身のみ
			CALL アビ対象選択テンプレート_自己のみ

			;奥義ゲージUP
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果量 = 奥義ゲージ回復値
			CALL アビテンプレート_有利効果_奥義ゲージUP

			;自己回復
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 回復力反映率
			アビ汎用文字列:回復側使用能力値 = 回復力
			CALL アビテンプレート_回復処理_MAXでも回復
	ENDSELECT


 

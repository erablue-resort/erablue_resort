;--------------------------------------------------
;ドンキホーテ（1389）・サンチョスタイルの固有アビリティ、奥義、パッシブ「硬血」
;仕様：project-files「サンチョ_戦闘仕様書.md」
;updated: 2026-10-12
;status: 数値は仮。Emuera実戦未確認
;
;仕様書で未定だった項目は、次の値を仮に置いた（変える場合は サンチョ技値_1389 を直す）。
;　倍率　　：血の歓喜 100％×3、硬血11式 280％（防御無視）、亜流硬血15式の反撃 100％、
;　　　　　　硬血2式 60％×6、奥義 130％×4
;　MP消費　：固定値＋最大MP×消費硬血×1％（血の歓喜20、硬血11式25、亜流硬血15式30、硬血2式35、奥義0）
;　亜流硬血15式：発動時の硬血消費なし。反撃ごとに硬血1を消費し、消費できたときだけ累積強化が付く
;　　　　　　　　（上限5回＝各＋50）。硬血0でも反撃は続く。反撃ごとに硬血の回収を処理する
;　硬血2式　：クリティカル率＋20（3ターン）。バリアは3ターン、再使用で上書き
;　硬血11式 ：防御力ダウンの判定は独自に行い、付与は弱体耐性の判定に任せる。敵のバフを1つ消す
;　奥義　　：与ダメージの20％を回復（上限は最大HPの50％）。MPが足りないときは持っている分だけ払う
;　端数　　：すべて切り捨て
;
;硬血の数は戦闘中カウント自由枠1で持つ（上限30。刻印は使わない）。能力上昇は 固有バフ・デバフ処理_キャラ_1389_* で足す。
;硬血の表示は @探索欄表示_キャラ_1389（奥義ゲージの下の行に数字とバー）。
;クリティカルは本体の仕様どおり、有利属性のときだけ発生する。
;
;戦闘中カウント自由枠（サンチョ中の1389の隊列のみ。ドンキホーテのアビは使われない）
;　0　亜流硬血15式を再使用できる絶対ターン
;　1　硬血の数（0～30）
;　2　奥義前の敵HP合計（奥義の回復量の計算用）
;　5　行動前に生きていた敵（ビット）
;　6　通常攻撃のDA・TAの回収待ち回数
;　7　亜流硬血15式の累積強化の回数
;　9　回収済みのクリティカル回数
;　※8はドンキホーテの行動開始時処理が毎回書き換えるので使わない
;--------------------------------------------------

;--------------------------------------------------
;調整用データ
;項目 0 MP固定値 / 1 消費硬血1あたりの最大MP％ / 2 消費硬血の上限 / 3 倍率％ / 4 CT
;番号 1～4 アビ、5 奥義
;--------------------------------------------------
@サンチョ技値_1389(番号, 項目)
#FUNCTION
#DIM 番号
#DIM 項目
SELECTCASE 番号 * 10 + 項目
	;血の歓喜
	CASE 10
		RETURNF 20
	CASE 11
		RETURNF 1
	CASE 12
		RETURNF 5
	CASE 13
		RETURNF 100
	;硬血11式
	CASE 20
		RETURNF 25
	CASE 21
		RETURNF 1
	CASE 22
		RETURNF 7
	CASE 23
		RETURNF 280
	;亜流硬血15式
	CASE 30
		RETURNF 30
	CASE 33
		RETURNF 100
	CASE 34
		RETURNF 4
	;硬血2式
	CASE 40
		RETURNF 35
	CASE 41
		RETURNF 1
	CASE 42
		RETURNF 8
	CASE 43
		RETURNF 60
	;奥義
	CASE 51
		RETURNF 1
	CASE 52
		RETURNF 15
	CASE 53
		RETURNF 130
ENDSELECT
RETURNF 0

@サンチョ技名_1389(番号)
#FUNCTIONS
#DIM 番号
SELECTCASE 番号
	CASE 1
		RETURNF "血の歓喜"
	CASE 2
		RETURNF "硬血11式"
	CASE 3
		RETURNF "亜流硬血15式"
	CASE 4
		RETURNF "硬血2式"
	CASE 5
		RETURNF "ドンキホーテ亜流サンチョ2式-ラ・サングレ"
ENDSELECT
RETURNF ""

;--------------------------------------------------
;共通部品
;--------------------------------------------------
;戦闘中のこの隊列が、サンチョのスタイルのドンキホーテか
@サンチョ隊列_1389(隊列)
#FUNCTION
#DIM 隊列
#DIM キャラ
SIF 隊列 < 0 || 隊列 > 3
	RETURNF 0
SIF ダンジョン表示モード != "戦闘画面"
	RETURNF 0
キャラ = BATTLE_STATE:隊列:キャラ登録番号
SIF キャラ < 1 || キャラ >= CHARANUM
	RETURNF 0
SIF NO:キャラ != 1389
	RETURNF 0
RETURNF サンチョ中_1389(キャラ)

@サンチョ硬血数_1389(隊列)
#FUNCTION
#DIM 隊列
;戦闘中以外は0（能力表示画面で呼ばれた時の対策。前回の戦闘の値が残っているため）
SIF ダンジョン表示モード != "戦闘画面"
	RETURNF 0
SIF 隊列 < 0 || 隊列 > 3
	RETURNF 0
RETURNF 戦闘中カウント:隊列:1

;能力上昇に使う硬血（0～20）
@サンチョ硬血有効値_1389(隊列)
#FUNCTION
#DIM 隊列
RETURNF MIN(サンチョ硬血数_1389(隊列), 20)

;亜流硬血15式の累積強化（カウンター中だけ有効）
@サンチョ反撃累積_1389(隊列)
#FUNCTION
#DIM 隊列
SIF バフ番号取得_枠("サンチョ_亜流硬血15式", 隊列) < 0
	RETURNF 0
RETURNF 戦闘中カウント:隊列:7

;技で実際に消費する硬血の数
@サンチョ消費硬血数_1389(隊列, 上限)
#FUNCTION
#DIM 隊列
#DIM 上限
SIF 隊列 < 0 || 隊列 > 3
	RETURNF 0
RETURNF MIN(サンチョ硬血数_1389(隊列), 上限)

;技のMP消費（消費硬血はその時点の所持数で決める）
@サンチョ消費MP_1389(隊列, 番号)
#FUNCTION
#DIM 隊列
#DIM 番号
#DIM 消費硬血
#DIM 最大MP
消費硬血 = サンチョ消費硬血数_1389(隊列, サンチョ技値_1389(番号, 2))
最大MP = 0
SIF 隊列 >= 0 && 隊列 <= 3
	最大MP = BATTLE_STATE:隊列:最大ＭＰ
RETURNF サンチョ技値_1389(番号, 0) + 最大MP * 消費硬血 * サンチョ技値_1389(番号, 1) / 100

@サンチョ通知_1389(本文)
#DIMS 本文
SIF A_M_NUM:システムメッセージ番号 >= メッセージ格納最大行数
	RETURN 0
アビテンプレート用_表示メッセージ格納:システムメッセージ番号:(A_M_NUM:システムメッセージ番号++) '= 本文
RETURN 0

@サンチョ取消_1389(本文)
#DIMS 本文
CALL 口上変数初期化
WSTR:(K++) '= 本文
CALL メッセージ欄表示用関数(,,,0)
アビテンプレート用_キャンセルフラグ = 1
RETURN -1

;硬血を消費し、HPを払う。RESULTは消費した硬血の数
@サンチョ硬血支払い_1389(隊列, 上限)
#DIM 隊列
#DIM 上限
#DIM 消費硬血
#DIM 消費HP
消費硬血 = サンチョ消費硬血数_1389(隊列, 上限)
SIF 消費硬血 <= 0
	RETURN 0
戦闘中カウント:隊列:1 = MAX(0, 戦闘中カウント:隊列:1 - 消費硬血)
消費HP = BATTLE_STATE:隊列:最大ＨＰ * 消費硬血 * 5 / 100
消費HP = MIN(消費HP, MAX(0, BATTLE_STATE:隊列:ＨＰ - 1))
BATTLE_STATE:隊列:ＨＰ -= 消費HP
CALL サンチョ通知_1389(@"硬血を{消費硬血}消費し、HPを{消費HP}支払った。")
RETURN 消費硬血

;硬血5を獲得する処理を回数ぶん行う。回復ありのときは1回ごとにHP15％・MP10％回復
@サンチョ硬血獲得_1389(隊列, 回数, 回復あり = 1)
#DIM 隊列
#DIM 回数
#DIM 回復あり
#DIM 回復HP
#DIM 回復MP
SIF 回数 <= 0
	RETURN 0
SIF 隊列 < 0 || 隊列 > 3
	RETURN 0
SIF BATTLE_STATE:隊列:ＨＰ < 1
	RETURN 0
戦闘中カウント:隊列:1 = MIN(30, 戦闘中カウント:隊列:1 + 5 * 回数)
SIF !回復あり
	RETURN 0
回復HP = MIN(BATTLE_STATE:隊列:最大ＨＰ * 15 * 回数 / 100, MAX(0, BATTLE_STATE:隊列:最大ＨＰ - BATTLE_STATE:隊列:ＨＰ))
回復MP = MIN(BATTLE_STATE:隊列:最大ＭＰ * 10 * 回数 / 100, MAX(0, BATTLE_STATE:隊列:最大ＭＰ - BATTLE_STATE:隊列:ＭＰ))
BATTLE_STATE:隊列:ＨＰ += 回復HP
BATTLE_STATE:隊列:ＭＰ += 回復MP
CALL サンチョ通知_1389(@"硬血を回収した（{回数}回）。HPが{回復HP}、MPが{回復MP}回復した。")
RETURN 0

;生きている敵をビットで返す
@サンチョ生存敵_1389()
#FUNCTION
#DIM 番号
#DIM 結果
結果 = 0
FOR 番号, 0, 10
	SIF 敵BATTLE_STATE_STR:番号:エネミー名 == ""
		CONTINUE
	SIF 敵BATTLE_STATE:番号:ＨＰ > 0
		SETBIT 結果, 番号
NEXT
RETURNF 結果

;記録時に生きていて、今は倒れている敵の数
@サンチョ撃破数_1389(記録)
#FUNCTION
#DIM 記録
#DIM 番号
#DIM 結果
結果 = 0
FOR 番号, 0, 10
	SIF !GETBIT(記録, 番号)
		CONTINUE
	SIF 敵BATTLE_STATE:番号:ＨＰ < 1 || 敵BATTLE_STATE_STR:番号:エネミー名 == ""
		結果 += 1
NEXT
RETURNF 結果

;クリティカル・DA/TA・撃破の記録をまとめて回収する
@サンチョ回収処理_1389(隊列, 生存記録)
#DIM 隊列
#DIM 生存記録
#DIM 回数
回数 = MAX(0, 戦闘中カウント:隊列:クリティカル回数 - 戦闘中カウント:隊列:9)
戦闘中カウント:隊列:9 = 戦闘中カウント:隊列:クリティカル回数
回数 += 戦闘中カウント:隊列:6
戦闘中カウント:隊列:6 = 0
回数 += サンチョ撃破数_1389(生存記録)
CALL サンチョ硬血獲得_1389(隊列, 回数)
RETURN 0

;同じ敵に複数回の攻撃
@サンチョ単体連撃_1389(対象, 回数, 倍率, 攻撃種類, 必中 = 0)
#DIM 対象
#DIM 回数
#DIM 倍率
#DIMS 攻撃種類
#DIM 必中
#DIM 番号
CALL アビ汎用変数文字列リセット
FOR 番号, 0, 回数
	CALL アビ対象選択テンプレート_指定(対象, 番号)
NEXT
アビテンプレート用_全体フラグ = 0
アビテンプレート用_回避フラグ = 0
アビ汎用文字列:ダメージ種類 '= 攻撃種類
アビ汎用文字列:攻撃側使用能力値 = 攻撃力
アビ汎用変数:効果割合 = 倍率
SIF 必中
	アビ汎用変数:命中率補正値 = 999
CALL アビテンプレート_ダメージ処理_自属性
RETURN RESULT

@サンチョ強化_1389(対象, 枠, 能力, 割合, 固定値, ターン)
#DIM 対象
#DIMS 枠
#DIMS 能力
#DIM 割合
#DIM 固定値
#DIM ターン
CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_指定(対象)
アビ汎用文字列:バフ・デバフ枠 '= 枠
アビ汎用文字列:バフ・デバフ対象能力 '= 能力
アビ汎用変数:効果割合 = 割合
アビ汎用変数:効果量 = 固定値
SIF ターン != 0
	アビ汎用変数:持続ターン = ターン
CALL アビテンプレート_有利効果_バフ効果セット
RETURN RESULT

;--------------------------------------------------
;固有アビ（サンチョ中だけ表示。ドンキホーテのアビはサンチョ中は隠れる）
;--------------------------------------------------
@固有アビ_1389_11(ARGS, キャラ番号)
#DIM DYNAMIC キャラ番号
CALL サンチョアビ_1389(ARGS, キャラ番号, 1)
RETURN RESULT

@固有アビ_1389_12(ARGS, キャラ番号)
#DIM DYNAMIC キャラ番号
CALL サンチョアビ_1389(ARGS, キャラ番号, 2)
RETURN RESULT

@固有アビ_1389_13(ARGS, キャラ番号)
#DIM DYNAMIC キャラ番号
CALL サンチョアビ_1389(ARGS, キャラ番号, 3)
RETURN RESULT

@固有アビ_1389_14(ARGS, キャラ番号)
#DIM DYNAMIC キャラ番号
CALL サンチョアビ_1389(ARGS, キャラ番号, 4)
RETURN RESULT

@サンチョアビ_1389(L_MODE, L_CHARA, L_SLOT)
#DIMS DYNAMIC L_MODE
#DIM DYNAMIC L_CHARA
#DIM DYNAMIC L_SLOT
#DIM DYNAMIC L_SELF
#DIM DYNAMIC L_TARGET
#DIM DYNAMIC L_MP
#DIM DYNAMIC L_RATE
#DIM DYNAMIC L_CAP
#DIM DYNAMIC L_P
#DIM DYNAMIC L_CD
#DIM DYNAMIC L_USED
#DIM DYNAMIC L_TMP
#DIMS DYNAMIC L_NAME

IF !サンチョ中_1389(L_CHARA)
	SIF L_MODE == "アビ名"
		TSTR:コマンド名受渡 =
	RETURN 0
ENDIF

L_MP = サンチョ技値_1389(L_SLOT, 0)
L_RATE = サンチョ技値_1389(L_SLOT, 1)
L_CAP = サンチョ技値_1389(L_SLOT, 2)
L_P = サンチョ技値_1389(L_SLOT, 3)
L_CD = サンチョ技値_1389(L_SLOT, 4)
L_NAME '= サンチョ技名_1389(L_SLOT)

L_SELF = -1
SIF ダンジョン表示モード == "戦闘画面" && L_CHARA > 0
	L_SELF = キャラ隊列検索(L_CHARA)

SELECTCASE L_MODE
	CASE "アビ名"
		TSTR:コマンド名受渡 '= L_NAME
		RETURN 0

	CASE "アビ説明文", "アビ説明文_詳細"
		IF L_RATE > 0
			詳細文文字列受け渡し変数 '= @"消費MP：{L_MP}＋最大MP×消費硬血×{L_RATE}％<br>"
			詳細文文字列受け渡し変数 += @"硬血を最大{L_CAP}消費し、消費1につき最大HPの5％を払う（HPは1残る）。<br>"
		ELSE
			詳細文文字列受け渡し変数 '= @"消費MP：{L_MP}<br>"
		ENDIF
		SELECTCASE L_SLOT
			CASE 1
				詳細文文字列受け渡し変数 += @"自身の攻撃力と防御力を20％アップ（5ターン）した後、敵単体に［{L_P}％］の3回攻撃。"
			CASE 2
				詳細文文字列受け渡し変数 += @"敵単体に防御無視の［{L_P}％］ダメージ。"
				詳細文文字列受け渡し変数 += "<br>消費した硬血×20％の確率で防御力30％ダウン（5ターン）。敵のバフを1つ消す。"
			CASE 3
				詳細文文字列受け渡し変数 += @"自身にカウンター効果（4ターン）。被ダメージ時に［{L_P}％］で反撃する。"
				詳細文文字列受け渡し変数 += "<br>反撃ごとに硬血1を消費し、クリティカル率・DA率・TA率が10ずつ上がる（最大5回、カウンター終了で解除）。"
				詳細文文字列受け渡し変数 += "<br>カウンター中は再使用できない。"
			CASE 4
				詳細文文字列受け渡し変数 += @"自身のクリティカル率を20アップ（3ターン）した後、敵からランダムに［{L_P}％］の6回攻撃。"
				詳細文文字列受け渡し変数 += "<br>攻撃後、自身に最大HPの10％のバリア（3ターン）。"
		ENDSELECT
		IF L_CD > 0
			IF L_MODE == "アビ説明文"
				詳細文文字列受け渡し変数 += @"<br>CT:{L_CD}ターン"
			ELSE
				詳細文文字列受け渡し変数 += @"<br>再使用：{L_CD}ターン（使用ターンを含む）"
			ENDIF
		ENDIF

		IF L_SELF >= 0 && L_SELF <= 3
			IF L_RATE > 0
				L_TMP = サンチョ消費硬血数_1389(L_SELF, L_CAP)
				詳細文文字列受け渡し変数 += @"<br>現在の硬血：{サンチョ硬血数_1389(L_SELF)}（消費{L_TMP}）"
			ENDIF
			IF L_SLOT == 3
				IF バフ番号取得_枠("サンチョ_亜流硬血15式", L_SELF) >= 0
					詳細文文字列受け渡し変数 += "<br>カウンター中は使用できません。"
					アビテンプレート用_アビ封印用フラグ = 1
				ELSEIF 戦闘中カウント:L_SELF:0 > 現在ターン数
					詳細文文字列受け渡し変数 += @"<br>あと{戦闘中カウント:L_SELF:0 - 現在ターン数}ターン使用不可"
					アビテンプレート用_アビ封印用フラグ = 1
				ENDIF
			ENDIF
			RETURN サンチョ消費MP_1389(L_SELF, L_SLOT)
		ENDIF
		RETURN L_MP

	CASE "アビ効果"
		;下へ
	CASEELSE
		RETURN 0
ENDSELECT

IF L_SELF < 0 || L_SELF > 3 || L_SELF != 戦闘行動キャラ
	CALL サンチョ取消_1389("サンチョの戦闘中の行動から使用してください。")
	RETURN -1
ENDIF

IF L_SLOT == 3
	IF バフ番号取得_枠("サンチョ_亜流硬血15式", L_SELF) >= 0
		CALL サンチョ取消_1389("カウンター中は使用できません。")
		RETURN -1
	ENDIF
	IF 戦闘中カウント:L_SELF:0 > 現在ターン数
		CALL サンチョ取消_1389("このアビリティはクールダウン中です。")
		RETURN -1
	ENDIF
ENDIF

;対象選択（キャンセルの確認後に支払う）
CALL アビ汎用変数文字列リセット
SELECTCASE L_SLOT
	CASE 1, 2
		CALL アビ対象選択テンプレート_敵単体
	CASEELSE
		CALL アビ対象選択テンプレート_自己のみ
ENDSELECT
SIF アビテンプレート用_キャンセルフラグ
	RETURN -1
L_TARGET = アビテンプレート用_対象保存:0

;硬血とHPの支払い（MPは本体がアビ効果の後に引く）
CALL サンチョ硬血支払い_1389(L_SELF, L_CAP)
L_USED = RESULT

SELECTCASE L_SLOT
	CASE 1
		;血の歓喜
		CALL サンチョ強化_1389(L_SELF, "攻撃力A", "攻撃力", 20, 0, 5)
		CALL サンチョ強化_1389(L_SELF, "防御力A", "防御力", 20, 0, 5)
		CALL サンチョ単体連撃_1389(L_TARGET, 3, L_P, "アビリティダメージ")

	CASE 2
		;硬血11式
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_指定(L_TARGET)
		アビテンプレート用_全体フラグ = 0
		アビテンプレート用_回避フラグ = 0
		アビ汎用文字列:ダメージ種類 = アビリティダメージ
		アビ汎用文字列:攻撃側使用能力値 = 攻撃力
		アビ汎用変数:効果割合 = L_P
		アビ汎用変数:防御無視オプション_割合 = 100
		CALL アビテンプレート_ダメージ処理_自属性
		IF L_TARGET >= 10 && L_TARGET < 20
			IF 敵BATTLE_STATE:(L_TARGET - 10):ＨＰ > 0
				IF L_USED > 0 && RAND:100 < L_USED * 20
					CALL アビ汎用変数文字列リセット
					CALL アビ対象選択テンプレート_指定(L_TARGET)
					アビ汎用文字列:バフ・デバフ枠 = サンチョ_硬血11式_防御力
					アビ汎用文字列:バフ・デバフ対象能力 = 防御力
					アビ汎用変数:効果割合 = 30
					アビ汎用変数:持続ターン = 5
					アビ汎用変数:基礎成功確率 = 100
					CALL アビテンプレート_不利効果_デバフ効果セット
				ENDIF
				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_指定(L_TARGET)
				CALL アビテンプレート_不利効果_バフ消去
			ENDIF
		ENDIF

	CASE 3
		;亜流硬血15式
		戦闘中カウント:L_SELF:7 = 0
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_指定(L_SELF)
		アビ汎用文字列:バフ・デバフ枠 = サンチョ_亜流硬血15式
		アビ汎用文字列:バフ・デバフ対象能力 = 特殊反応_被ダメ時
		アビ汎用変数:効果割合 = L_P
		アビ汎用変数:持続ターン = 4
		CALL アビテンプレート_有利効果_バフ効果セット
		戦闘中カウント:L_SELF:0 = 現在ターン数 + L_CD

	CASE 4
		;硬血2式
		CALL サンチョ強化_1389(L_SELF, "サンチョ_硬血2式_クリティカル率", "クリティカル率", 0, 20, 3)
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_敵ランダムＸ体(6)
		アビテンプレート用_全体フラグ = 0
		アビテンプレート用_回避フラグ = 0
		アビ汎用文字列:ダメージ種類 = アビリティダメージ
		アビ汎用文字列:攻撃側使用能力値 = 攻撃力
		アビ汎用変数:効果割合 = L_P
		CALL アビテンプレート_ダメージ処理_自属性
		CALL サンチョ強化_1389(L_SELF, "バリア", "バリア", 0, BATTLE_STATE:L_SELF:最大ＨＰ * 10 / 100, 3)
ENDSELECT

SIF アビテンプレート用_キャンセルフラグ
	RETURN -1
RETURN 0

;--------------------------------------------------
;亜流硬血15式の反撃
;本体の被ダメ時特殊反応から呼ばれる。戦闘行動キャラは反撃する側（サンチョ）
;--------------------------------------------------
@特殊反応_被ダメ時_サンチョ_亜流硬血15式(バフ番号, 攻撃者隊列, 被ダメ記録順)
#DIM バフ番号
#DIM 攻撃者隊列
#DIM 被ダメ記録順
#DIM L_SELF
#DIM 生存記録
#DIM 保存対象

L_SELF = 戦闘行動キャラ
SIF !サンチョ隊列_1389(L_SELF)
	RETURN 0
SIF BATTLE_STATE:L_SELF:ＨＰ < 1
	RETURN 0
SIF 攻撃者隊列 < 10 || 攻撃者隊列 >= 20
	RETURN 0
SIF 敵BATTLE_STATE:(攻撃者隊列 - 10):ＨＰ < 1
	RETURN 0

生存記録 = サンチョ生存敵_1389()
;同じ被弾で続く特殊反応のために、攻撃者（戦闘行動対象）を最後に戻す
保存対象 = 戦闘行動対象

;硬血1を消費できたときだけ累積強化
IF サンチョ硬血数_1389(L_SELF) > 0
	戦闘中カウント:L_SELF:1 -= 1
	SIF 戦闘中カウント:L_SELF:7 < 5
		戦闘中カウント:L_SELF:7 += 1
ENDIF

CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_指定(攻撃者隊列)
アビテンプレート用_アビ名 = 亜流硬血15式
アビ汎用文字列:ダメージ種類 = アビリティダメージ
アビ汎用文字列:攻撃側使用能力値 = 攻撃力
アビ汎用変数:効果割合 = DT_CELL_GET("戦闘効果データベース", バフ番号, "効果量_割合")
CALL アビテンプレート_ダメージ処理_自属性

CALL サンチョ回収処理_1389(L_SELF, 生存記録)
戦闘行動対象 = 保存対象
RETURN 0

@バフ固有説明文_サンチョ_亜流硬血15式(バフ・デバフ効果量, バフ・デバフ効果割合)
#DIM バフ・デバフ効果量
#DIM バフ・デバフ効果割合
PRINTL ダメージを受けたとき、反撃を行います。
PRINTL 反撃ごとに硬血1を消費し、クリティカル率・DA率・TA率が10ずつ上がります（最大5回）。
RETURN 0

;--------------------------------------------------
;奥義（固有奥義_1389 からサンチョ中に呼ばれる）
;本体の奥義ダメージ1回に、奥義追加効果で3回を足して4回攻撃にする
;--------------------------------------------------
@サンチョ奥義_1389(ARGS, キャラ番号)
#DIM キャラ番号
#DIM L_SELF
#DIM L_TARGET
#DIM L_USED
#DIM L_MP
#DIM L_DEALT
#DIM L_HEAL
#DIM L_I
#DIM L_ACTION_TARGET
#DIM L_TARGETS, アビ対象最大数
#DIM L_RATE
#DIM L_CAP
#DIM L_P

L_RATE = サンチョ技値_1389(5, 1)
L_CAP = サンチョ技値_1389(5, 2)
L_P = サンチョ技値_1389(5, 3)

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 '= サンチョ技名_1389(5)
	CASE "奥義説明文", "奥義説明文_詳細"
		詳細文文字列受け渡し変数 '= @"奥義威力：{L_P}％×4<br>硬血を最大{L_CAP}消費し、消費1につき最大HPの5％とMP（最大MP×消費硬血×{L_RATE}％）を払う。"
		詳細文文字列受け渡し変数 += "<br>自身のクリティカルダメージ率を50アップ（3ターン）した後、敵単体に必中の4回攻撃。"
		詳細文文字列受け渡し変数 += "<br>攻撃後、与えたダメージの20％ぶんHPを回復する（最大HPの50％まで）。"
		RETURN L_P
	CASE "奥義前効果"
		L_SELF = キャラ隊列検索(キャラ番号)
		SIF !サンチョ隊列_1389(L_SELF)
			RETURN 0
		L_ACTION_TARGET = 戦闘行動対象
		;消費MPは支払い前の硬血で決める
		L_MP = MIN(サンチョ消費MP_1389(L_SELF, 5), BATTLE_STATE:L_SELF:ＭＰ)
		CALL サンチョ硬血支払い_1389(L_SELF, L_CAP)
		BATTLE_STATE:L_SELF:ＭＰ -= L_MP
		SIF L_MP > 0
			CALL サンチョ通知_1389(@"MPを{L_MP}支払った。")
		CALL サンチョ強化_1389(L_SELF, "サンチョ_亜流2式_クリティカルダメージ率", "クリティカルダメージ率", 0, 50, 3)
		戦闘中カウント:L_SELF:2 = 0
		FOR L_I, 0, 10
			戦闘中カウント:L_SELF:2 += MAX(0, 敵BATTLE_STATE:L_I:ＨＰ)
		NEXT
		戦闘行動対象 = L_ACTION_TARGET
		;本体の奥義ダメージへ引き継ぐ
		CALL アビ汎用変数文字列リセット
		アビ汎用変数:命中率補正値 = 999
	CASE "奥義追加効果"
		L_SELF = キャラ隊列検索(キャラ番号)
		SIF !サンチョ隊列_1389(L_SELF)
			RETURN 0
		SIF BATTLE_STATE:L_SELF:ＨＰ < 1
			RETURN 0
		ARRAYCOPY "アビテンプレート用_対象保存", "L_TARGETS"
		L_ACTION_TARGET = 戦闘行動対象
		L_TARGET = 奥義対象指定先

		IF L_TARGET >= 10 && L_TARGET < 20
			IF 敵BATTLE_STATE:(L_TARGET - 10):ＨＰ > 0
				CALL サンチョ単体連撃_1389(L_TARGET, 3, L_P, "奥義ダメージ", 1)
			ENDIF
		ENDIF

		L_DEALT = 戦闘中カウント:L_SELF:2
		FOR L_I, 0, 10
			L_DEALT -= MAX(0, 敵BATTLE_STATE:L_I:ＨＰ)
		NEXT
		L_HEAL = MIN(MAX(0, L_DEALT) * 20 / 100, BATTLE_STATE:L_SELF:最大ＨＰ * 50 / 100)
		L_HEAL = MIN(L_HEAL, MAX(0, BATTLE_STATE:L_SELF:最大ＨＰ - BATTLE_STATE:L_SELF:ＨＰ))
		IF L_HEAL > 0
			BATTLE_STATE:L_SELF:ＨＰ += L_HEAL
			CALL サンチョ通知_1389(@"%戦闘キャラ名前取得(L_SELF)%のHPが{L_HEAL}回復した。")
		ENDIF

		ARRAYCOPY "L_TARGETS", "アビテンプレート用_対象保存"
		戦闘行動対象 = L_ACTION_TARGET
ENDSELECT
RETURN 0

;--------------------------------------------------
;パッシブ「硬血」のフック（ドンキホーテ側の既存フックからも呼ぶ）
;--------------------------------------------------
@固有戦闘開始時処理_キャラ_1389
#DIM L_SELF
L_SELF = 戦闘行動キャラ
SIF !サンチョ隊列_1389(L_SELF)
	RETURN 0
戦闘中カウント:L_SELF:0 = 0
戦闘中カウント:L_SELF:1 = 0
戦闘中カウント:L_SELF:6 = 0
戦闘中カウント:L_SELF:7 = 0
戦闘中カウント:L_SELF:9 = 戦闘中カウント:L_SELF:クリティカル回数
;戦闘開始時の硬血5には回復を付けない
CALL サンチョ硬血獲得_1389(L_SELF, 1, 0)
RETURN 0

@固有ターン終了時処理_キャラ_1389
#DIM L_SELF
L_SELF = 戦闘行動キャラ
SIF !サンチョ隊列_1389(L_SELF)
	RETURN 0
SIF 現在ターン数 < 1 || 現在ターン数 % 5 != 0
	RETURN 0
CALL サンチョ硬血獲得_1389(L_SELF, 1)
RETURN 0

;ドンキホーテの 固有行動開始時処理_キャラ_1389 から呼ぶ
@サンチョ行動開始時_1389(L_SELF)
#DIM L_SELF
SIF !サンチョ隊列_1389(L_SELF)
	RETURN 0
戦闘中カウント:L_SELF:5 = サンチョ生存敵_1389()
戦闘中カウント:L_SELF:6 = 0
RETURN 0

;ドンキホーテの 固有行動直後処理_キャラ_1389 から呼ぶ
@サンチョ行動直後_1389(L_SELF)
#DIM L_SELF
SIF !サンチョ隊列_1389(L_SELF)
	RETURN 0
CALL サンチョ回収処理_1389(L_SELF, 戦闘中カウント:L_SELF:5)
戦闘中カウント:L_SELF:5 = 0
RETURN 0

;通常攻撃のDA・TAを記録（連撃数 2=DA、3=TA）
@固有通常攻撃後処理_キャラ_1389(全滅フラグ, 連撃数)
#DIM 全滅フラグ
#DIM 連撃数
SIF !サンチョ隊列_1389(戦闘行動キャラ)
	RETURN 0
SIF 連撃数 >= 2
	戦闘中カウント:戦闘行動キャラ:6 += 1
RETURN 0

;--------------------------------------------------
;硬血による能力上昇（h＝min(硬血, 20)）
;--------------------------------------------------
@固有バフ・デバフ処理_キャラ_1389_攻撃力(隊列番号, 数値)
#DIM 隊列番号
#DIM 数値
SIF !サンチョ隊列_1389(隊列番号)
	RETURN 数値
RETURN 数値 * (110 + 4 * サンチョ硬血有効値_1389(隊列番号)) / 100

@固有バフ・デバフ処理_キャラ_1389_DA率(隊列番号, 数値)
#DIM 隊列番号
#DIM 数値
SIF !サンチョ隊列_1389(隊列番号)
	RETURN 数値
RETURN 数値 + 30 + 3 * サンチョ硬血有効値_1389(隊列番号) + 10 * サンチョ反撃累積_1389(隊列番号)

@固有バフ・デバフ処理_キャラ_1389_TA率(隊列番号, 数値)
#DIM 隊列番号
#DIM 数値
SIF !サンチョ隊列_1389(隊列番号)
	RETURN 数値
RETURN 数値 + (2000 + 275 * サンチョ硬血有効値_1389(隊列番号)) / 100 + 10 * サンチョ反撃累積_1389(隊列番号)

@固有バフ・デバフ処理_キャラ_1389_クリティカル率(隊列番号, 数値)
#DIM 隊列番号
#DIM 数値
SIF !サンチョ隊列_1389(隊列番号)
	RETURN 数値
RETURN 数値 + 40 + 3 * サンチョ硬血有効値_1389(隊列番号) + 10 * サンチョ反撃累積_1389(隊列番号)

;--------------------------------------------------
;硬血の表示（奥義ゲージの下の行。DUNGEON_MAP.ERB の @DUNGEON_キャラ描画 から呼ばれる）
;イナホ（1025）のFEVER表示と同じ位置・大きさ。サンチョ中の戦闘画面だけ描く
;--------------------------------------------------
@探索欄表示_キャラ_1389(レイヤー番号, 隊列番号)
#DIM レイヤー番号
#DIM 隊列番号
#DIM L_NUM
SIF ダンジョン表示モード != "戦闘画面"
	RETURN 0
SIF !サンチョ隊列_1389(隊列番号)
	RETURN 0
L_NUM = サンチョ硬血数_1389(隊列番号)
GDRAWTEXT レイヤー番号, @"硬血:{L_NUM, 2}/30", 120, 90
GSETBRUSH レイヤー番号, 0xFF808080
GFILLRECTANGLE レイヤー番号, 231, 98, 147, 8
GSETBRUSH レイヤー番号, 0xFFB4B4B4
GFILLRECTANGLE レイヤー番号, 233, 99, 143, 6
IF L_NUM > 0
	GSETBRUSH レイヤー番号, 0xFFC00020
	GFILLRECTANGLE レイヤー番号, 233, 100, MAX(143 * L_NUM / 30, 1), 4
ENDIF
GSETBRUSH レイヤー番号, 0xFFC0C0C0
RETURN 0

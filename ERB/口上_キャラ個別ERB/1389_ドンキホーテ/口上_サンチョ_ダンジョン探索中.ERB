;--------------------------------------------------
;サンチョ（1389のスタイル「[第二眷属]サンチョ」）用のダンジョン探索中口上。
;構成は 口上_ドンキホーテ_ダンジョン探索中.ERB と同じ。関数名はドンキホーテ版の末尾に _サンチョ を付ける。
;ドンキホーテ版の各関数の先頭で、サンチョ中かつ _サンチョ 版がある時だけこちらを呼ぶ。
;_サンチョ 版がない場面は今までどおり（汎用文・無言・ドンキホーテ版の処理）。
;空の関数でもあると「ある」扱いになり、ドンキホーテ側の代わりの処理が止まるので、
;本文を書く関数だけコメントを外して有効にすること。
;ドンキホーテ版に口上以外の処理（フラグ・数値の変更など）がある関数は、必要な処理もこちらに写すこと。
;--------------------------------------------------
;2026-10-12：全関数を記入。好感度で変わる台詞は、ドンキホーテと同じく恋慕・セフレ（陥落判定）・未陥落で分ける（ユーザー指示）。ユーザー決定：恋慕陥落後に解禁されるので最初から好感度が高い。です・ます調で丁寧だが、たまにイタズラっぽさや茶目っ気を出す。
;ドンキホーテの恋慕時の台詞は「サンチョがドンキホーテらしく喋っている台詞」として扱う。一人称「私」、二人称は %二人称_サンチョ_1389()%。
;血鬼の本能（血や戦いへの渇き）は言葉の端や地の文に少しにじませる程度にする。
;2026-10-12：加筆（ユーザー指示）。仲間と会話はドンキホーテと同じ5か所のダンジョン別に3案ずつ、共通を12案に。奥義・チェンバ・トドメ・戦闘勝利・全滅・逃走も案を増やした。

;--------------------------------------------------
;「仲間と会話」ボタン押下時
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

;ダンジョン別の会話。対応するダンジョンでは半分の確率でこちらを出し、残りは下の共通の会話
LOCAL:3 = 0
IF RAND:2 == 0
	LOCAL:3 = 1
	SELECTCASE ダンジョン名
		CASE "名前を亡くした遺跡"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「名を失くした遺跡、ですか。……名前を失くしても、ここに在ったことまでは消えません。
					WSTR:(K++) = 　少し、親近感が湧きますね」
				CASE 1
					WSTR:(K++) = 「この壁画、普段の私なら騎空艇だと言い張るのでしょうね。
					WSTR:(K++) = 　……私には、手をつないだ二人に見えます。%二人称_サンチョ_1389()%には、何に見えますか？」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「足元の石がゆるんでいます。%二人称_サンチョ_1389()%、私の足跡の上だけを歩いてください。
						WSTR:(K++) = 　……ええ、ぴったり後ろについて。そのくらい近い方が、私も安心です」
					ELSE
						WSTR:(K++) = 「罠の仕掛けがありますね。古いものほど、意地が悪いのです。
						WSTR:(K++) = 　%二人称_サンチョ_1389()%は、私が踏んだ場所だけを踏んでください」
					ENDIF
			ENDSELECT
		CASE "バルツ地下廃工場"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「機械の音がうるさいですね。……普段の私は、これに負けじと声を張り上げるのですけれど。
					WSTR:(K++) = 　今日は静かにまいります。耳がもちませんので」
				CASE 1
					WSTR:(K++) = 「暑いですね……。火のそばは、どうも苦手です。
					WSTR:(K++) = 　早く抜けてしまいましょう。私が干からびる前に」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「%二人称_サンチョ_1389()%、頬に煤がついていますよ。……動かないでください。
						WSTR:(K++) = 　はい、取れました。指で拭いたのか、それ以外で拭いたのかは、ご想像にお任せします」
					ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
						WSTR:(K++) = 「汗だくですね、%二人称_サンチョ_1389()%。帰ったら、一緒に湯浴みでもいかがです？
						WSTR:(K++) = 　……背中を流すだけですよ。たぶん」
					ELSE
						WSTR:(K++) = 「歯車に袖を巻き込まれないよう、お気をつけて。
						WSTR:(K++) = 　ここの機械は、人を待ってはくれませんから」
					ENDIF
			ENDSELECT
		CASE "深海の古戦場跡"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「古戦場には、古い血の匂いが染みついているものですが……ここは水に洗われて、すっかり静かですね。
					WSTR:(K++) = 　ええ、残念だなどとは申しておりませんよ」
				CASE 1
					WSTR:(K++) = 「海の底は、どこまでも青くて暗いのですね。……落ち着きます。
					WSTR:(K++) = 　日の光がほとんど届かない場所は、私にとって居心地がいいのです」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「あの二匹の魚、ずっと寄り添って泳いでいますね。
						WSTR:(K++) = 　……普段の私なら、ここで口ごもるところです。私は口ごもりませんよ。私たちのようですね、%二人称_サンチョ_1389()%」
					ELSE
						WSTR:(K++) = 「錆びた槍が、まだ砂に刺さったままですね。
						WSTR:(K++) = 　持ち主は、ここで何を守ろうとしたのでしょう。……少しだけ、黙祷を」
					ENDIF
			ENDSELECT
		CASE "風遊ぶ渓谷の参道"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「風が強いですね。髪がまとまらなくて困ります。
					WSTR:(K++) = 　……%二人称_サンチョ_1389()%、笑いましたね？ 今、私の頭がどうなっているのか、正直に教えてください」
				CASE 1
					WSTR:(K++) = 「見晴らしがいいのはありがたいのですが、隠れる日陰が少ないのは困りものです。
					WSTR:(K++) = 　……%二人称_サンチョ_1389()%の影に入らせてください。ちょうどいい大きさなので」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「いい景色ですね。今だけは、この渓谷を二人で貸し切りです。
						WSTR:(K++) = 　……魔物も遠慮してくれたら、もっといいのですけれど」
					ELSE
						WSTR:(K++) = 「この参道の先には、何が祀られているのでしょうね。
						WSTR:(K++) = 　普段の私なら、伝説の槍だと信じて駆け出すところです。私は、まず足元を確かめますけれど」
					ENDIF
			ENDSELECT
		CASE "奈落の大空洞", "異界と化した洞窟"
			SELECTCASE RAND:3
				CASE 0
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「暗いのは好都合です。私の目は、こういう場所の方がよく利きますので。
						WSTR:(K++) = 　ですから%二人称_サンチョ_1389()%、はぐれないよう手を。……ふふ、危ないからですよ？ 他意はありません」
					ELSE
						WSTR:(K++) = 「暗いのは好都合です。私の目は、こういう場所の方がよく利きますので。
						WSTR:(K++) = 　%二人称_サンチョ_1389()%は、私の後ろを離れないでくださいね」
					ENDIF
				CASE 1
					WSTR:(K++) = 「底が見えませんね。……普段の私なら、ここで大声を出して、こだまを数えるのでしょう。
					WSTR:(K++) = 　やりませんよ。魔物を呼び寄せるだけですから」
				CASE 2
					WSTR:(K++) = 「ここは、空気そのものが違いますね。
					WSTR:(K++) = 　……%二人称_サンチョ_1389()%、気分が悪くなったら、すぐに仰ってください。我慢は、帰ってからいくらでもできますので」
			ENDSELECT
		CASEELSE
			LOCAL:3 = 0
	ENDSELECT
ENDIF

;共通の会話
IF LOCAL:3 == 0
	SELECTCASE RAND:12
		CASE 0
			WSTR:(K++) = 「普段の騒がしいほうがお好みでしたら、いつでも戻りますよ？
			WSTR:(K++) = 　『%二人称_1389(-1, 1)%！ 正義は必ず勝つのだ！』……ふふ、似ていました？」
		CASE 1
			WSTR:(K++) = 「%二人称_サンチョ_1389()%、そちらの通路は崩れかけています。右へ。
			WSTR:(K++) = 　……おや、素直ですね。いつもの口調で言っていたら、私が真っ先に突っ込んでいたでしょうに」
		CASE 2
			WSTR:(K++) = 「次に宝箱を見つけたら、開ける役は%二人称_サンチョ_1389()%にお譲りしますね。中身が空でも、%二人称_サンチョ_1389()%のせいにはしませんよ。
			WSTR:(K++) = 　宝箱のせいにはするかもしれませんが」
		CASE 3
			WSTR:(K++) = 「近くに魔物がいますね。数は三つ……いえ、四つ。
			WSTR:(K++) = 　どうか先に行かせてください。久しぶりに、少しばかり血が騒いでいるのです」
			WSTR:(K++) = %CALLNAME:対象キャラ%は穏やかに微笑んだが、その口元からは小さな牙がのぞいていた。
		CASE 4
			WSTR:(K++) = 「%二人称_サンチョ_1389()%、お疲れではありませんか？ 顔色が少し優れないようです。
			WSTR:(K++) = 　休める場所を探しましょう。%二人称_サンチョ_1389()%が倒れては、私が困りますから」
		CASE 5
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				WSTR:(K++) = 「こうして素の声でお話しするのは、まだ少し照れますね。
				WSTR:(K++) = 　……%二人称_サンチョ_1389()%、今、顔が赤くなりました？ ふふ、暗くてよく見えませんけれど」
			ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
				WSTR:(K++) = 「暗がりにいると、つい余計なことをしたくなりますね。
				WSTR:(K++) = 　……ここでは我慢します。続きは、帰ってからにいたしましょう」
			ELSE
				WSTR:(K++) = 「静かな場所ですね。普段の私なら、ここで大声を出して、こだまを確かめるのでしょう。
				WSTR:(K++) = 　……やりませんよ？ 期待したお顔をされても」
			ENDIF
		CASE 6
			LOCAL:2 = GETCHARA(1384)
			IF LOCAL:2 > -1 && キャラ隊列検索(LOCAL:2) > -1
				WSTR:(K++) = 「%二人称_サンチョ_1389(LOCAL:2)%、いつも騒がしい私のお相手をしてくださって、ありがとうございます」
				NSTR:(K++) = ++++
				切り替え名前:0 = %CALLNAME:(LOCAL:2)%
				切り替え顔グラリソース:0 = 探索用_{キャラ隊列検索(LOCAL:2)}_顔
				WSTR:(K++) = 「……調子が狂う。いつもの騒がしい方を出せ。そっちの方がまだ描きやすい」
			ELSE
				IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
					WSTR:(K++) = 「足音が、私たちのものだけになりましたね。
					WSTR:(K++) = 　……%二人称_サンチョ_1389()%の足音は、少し速くなりましたか？ ふふ、気のせいでしょうか」
				ELSE
					WSTR:(K++) = 「足音が、私たちのものだけになりましたね。……魔物も、息をひそめているようです」
				ENDIF
			ENDIF
		CASE 7
			WSTR:(K++) = 「普段の私が持ってきたパンが、鞄の底でぺしゃんこになっていました。
			WSTR:(K++) = 　……半分こしましょうか、%二人称_サンチョ_1389()%。形はともかく、味は変わりませんので」
		CASE 8
			WSTR:(K++) = 「あそこで震えているスライム、普段の私なら『迷子だ』と言って助けに行くのでしょうね。
			WSTR:(K++) = 　……私は、もう少しよく見てから決めます。ほら、あれは迷子ではなく、待ち伏せです」
		CASE 9
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				WSTR:(K++) = 「%二人称_サンチョ_1389()%の背中は、私が守ります。……ですから、たまには振り返ってくださいね。
				WSTR:(K++) = 　守っている相手に見てもらえると、それだけで力が湧くものなのです」
			ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
				WSTR:(K++) = 「戦ったあとは、どうも体が火照ってしまって。
				WSTR:(K++) = 　……帰ったら、その責任は%二人称_サンチョ_1389()%に取っていただきますね」
			ELSE
				WSTR:(K++) = 「後ろは私にお任せください。背中を預けていただけるのは、光栄なことですから」
			ENDIF
		CASE 10
			WSTR:(K++) = 「この探索が終わったら、何がしたいですか？
			WSTR:(K++) = 　私は、静かな場所でお茶を一杯。……%二人称_サンチョ_1389()%がご一緒なら、なお結構です」
		CASE 11
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				WSTR:(K++) = 「%二人称_サンチョ_1389()%、首筋に擦り傷がありますね。……血がにじんでいます。
				WSTR:(K++) = 　手当てをしましょう。……ええ、手当てですよ。舐めたりはしません。今は」
			ELSE
				WSTR:(K++) = 「%二人称_サンチョ_1389()%、手の甲に擦り傷がありますよ。手当てをしましょう。
				WSTR:(K++) = 　……血の匂いには敏いのです。小さな傷でも、すぐに分かりますので」
			ENDIF
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0)

;--------------------------------------------------
;奥義発動時
;--------------------------------------------------
@KOJO_DUNGEON_奥義発動時_1389_サンチョ(対象キャラ, 使用奥義名)
#DIMS 使用奥義名
#DIM 対象キャラ
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

SELECTCASE RAND:6
	CASE 0
		KSTR:(K++) = 「これが、私の血の在り方です。どうか、目に焼きつけてください」
	CASE 1
		KSTR:(K++) = 「血よ、形を成しなさい。……さあ、踊りましょうか」
	CASE 2
		KSTR:(K++) = 「少々、はしたない姿をお見せします。どうか、お許しを」
	CASE 3
		KSTR:(K++) = 「普段の私の槍とは、少し違いますよ。……いただいた分は、お返しします」
	CASE 4
		KSTR:(K++) = 「喉が渇いてまいりました。……ええ、遠慮なくいただきます」
	CASE 5
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、見ていてください。……私の本気は、貴重ですよ」
		ELSE
			KSTR:(K++) = 「皆様、少し下がっていてください。……血が飛びますので」
		ENDIF
ENDSELECT

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0)

;--------------------------------------------------
;チェンバースト発動時
;--------------------------------------------------
@KOJO_DUNGEON_チェンバ発動時_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

LOCAL:2 = GETCHARA(1384)
IF LOCAL:2 > -1 && キャラ隊列検索(LOCAL:2) > -1 && RAND:3 == 0
	;良秀が同じ隊列にいる時の掛け合い（33％）
	KSTR:(K++) = 「%二人称_サンチョ_1389(LOCAL:2)%、合わせていただけますか？ 赤い色は、お好きでしょう？」
	NSTR:(K++) = ++++
	切り替え名前:0 = %CALLNAME:(LOCAL:2)%
	切り替え顔グラリソース:0 = 探索用_{キャラ隊列検索(LOCAL:2)}_顔
	KSTR:(K++) = 「……ふん。いい色を出せたら、絵の具にしてやる」
ELSE
	SELECTCASE RAND:4
		CASE 0
			KSTR:(K++) = 「皆様、私に合わせてください。拍子は私が取りましょう」
		CASE 1
			KSTR:(K++) = 「ああ……心地よい高揚です。皆様、どうか遅れずについてきてくださいね」
		CASE 2
			KSTR:(K++) = 「一、二の、三で参りましょう。……普段の私なら、一で飛び出していますね」
		CASE 3
			KSTR:(K++) = 「皆様の力、少しお借りします。……ええ、血ではありませんよ。今日のところは」
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ)

;--------------------------------------------------
;トドメ時（口上用トドメフラグ＝倒した敵の数）
;--------------------------------------------------
@KOJO_DUNGEON_トドメ時_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

IF 口上用トドメフラグ >= 2
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「まとめて、おやすみなさい」
		CASE 1
			KSTR:(K++) = 「順番を待つのは退屈でしょうから。……ご一緒にどうぞ」
		CASE 2
			KSTR:(K++) = 「おや、ずいぶん静かになりましたね」
	ENDSELECT
ELSE
	SELECTCASE RAND:6
		CASE 0
			KSTR:(K++) = 「失礼。少し、強く撫でてしまいましたね」
		CASE 1
			KSTR:(K++) = 「ごちそうさまでした。……いえ、こちらの話です」
		CASE 2
			KSTR:(K++) = 「お疲れさまでした。もう、休んでよろしいですよ」
		CASE 3
			KSTR:(K++) = 「次の方、どうぞ」
		CASE 4
			KSTR:(K++) = 「手応えはありました。……少し、名残惜しいくらいに」
		CASE 5
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				KSTR:(K++) = 「%二人称_サンチョ_1389()%に、指一本触れさせるつもりはありませんので」
			ELSE
				KSTR:(K++) = 「静かにお眠りください。……夜は、私の時間ですので」
			ENDIF
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ)

;--------------------------------------------------
;戦闘勝利時
;--------------------------------------------------
@KOJO_DUNGEON_戦闘勝利時_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL メッセージ欄表示用関数(,,,0)
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

SELECTCASE RAND:7
	CASE 0
		KSTR:(K++) = 「終わりましたね。皆様、お怪我はありませんか？」
	CASE 1
		KSTR:(K++) = 「ふう……少し、はしゃぎすぎました。今のは見なかったことにしてくださいね」
	CASE 2
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、ご無事で何よりです。……それだけが、私の戦果ですから」
		ELSE
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、ご無事ですね。何よりです」
		ENDIF
	CASE 3
		KSTR:(K++) = 「普段の私なら、ここで『正義は必ず勝つ！』と叫ぶところですね。……代わりに、私は一礼を」
	CASE 4
		KSTR:(K++) = 「血の巡りが、すっかりよくなりました。……顔が赤いのは、そのせいですよ」
	CASE 5
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、褒めてくださってもいいのですよ？ ……頭を撫でる方式で、お願いします」
		ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)

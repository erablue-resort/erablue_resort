		RETURN 0
	TRYCALLFORM KOJO_EVENT_マッサージ終了_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
;「マッサージを終える」ボタンを押した時のみ
;うふふに移行するパターンや体力０で終えた場合は呼び出されない

;TCVAR:対象キャラ:エロマッサージ施術フラグ が１の時、そのマッサージ中にエロマッサージを行った扱い
;０ならエロしてない

CALL 口上変数初期化

IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
	;恋慕
	IF TCVAR:対象キャラ:エロマッサージ施術フラグ
		KSTR:(K++) = ドンキホーテは乱れた服を直しながら、%CALLNAME:PLAYER%の耳元に顔を寄せた。
		KSTR:(K++) = 「次の予約も、%二人称_1389()%でお願いいたします……る」
	ELSE
		KSTR:(K++) = 「ふへぇ……体が軽いのだ。_一人称_には、%二人称_1389()%の手がやはり一番ですな」
	ENDIF
ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
	;恋慕以外の陥落
	IF TCVAR:対象キャラ:エロマッサージ施術フラグ
		IF 知識素質:対象キャラ:性知識 < 0
			KSTR:(K++) = 「途中から妙な揉み方でありましたが、体中ぽかぽかなのだ！ 近ごろのマッサージは奥が深いですな！」
		ELSE
			KSTR:(K++) = 「いやはや、極楽でありました！ 特に後半のコースは、店の看板にすべきですぞ！」
		ENDIF
	ELSE
		KSTR:(K++) = 「うむ、すっきりした！ ほれ、%二人称_1389()%も肩が凝っておるでしょう。お返しに揉んでしんぜよう！」
		KSTR:(K++) = ドンキホーテは返事も待たずに%CALLNAME:PLAYER%の背中に回り込み、力任せに肩を揉み始めた。
	ENDIF
ELSE
	;未陥落
	IF TCVAR:対象キャラ:エロマッサージ施術フラグ
		IF 知識素質:対象キャラ:性知識 < 0
			KSTR:(K++) = 「な、なにやら体がふわふわするのだ……。マッサージとは、かくも効くものでありましたか……」
		ELSE
			KSTR:(K++) = 「今のは、マッサージの範囲を少々越えておりませぬか？
			KSTR:(K++) = 　まあ、気持ちは良かったので、今回は不問にいたしまする！」
		ENDIF
	ELSE
		KSTR:(K++) = 「ふぅ、すっきりした！ これで明日も槍を存分に振るえまする！ かたじけない！」
	ENDIF
ENDIF


CALL 口上変数表示(対象キャラ, 0)



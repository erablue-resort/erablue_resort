;--------------------------------------------------
;拒否時
;　RETURN 0以外でデフォルト文章をスキップ
;--------------------------------------------------
@KOJO_EVENT_寝取らせ夜這い_拒否_1389(主導キャラ, 献上品キャラ)
#DIM 主導キャラ
#DIM 献上品キャラ
;サンチョ中は _サンチョ 版があればそちらを使う（口上_サンチョ_*.ERB）
IF サンチョ中_1389(主導キャラ) && EXISTFUNCTION("KOJO_EVENT_寝取らせ夜這い_拒否_1389_サンチョ")
	TRYCALLFORM KOJO_EVENT_寝取らせ夜這い_拒否_1389_サンチョ(主導キャラ, 献上品キャラ)
	RETURN RESULT
ENDIF
SIF CSTR:主導キャラ:スタイル管理文字列 == "[第二眷属]サンチョ"
	RETURN 0

CALL 口上変数初期化

IF 口上_関係性判定_1389(主導キャラ, PLAYER, "恋慕")
	KSTR:(K++) = 「左様でありますか。……ふふっ、そう仰ると思っておりました」
	KSTR:(K++) = 断られたというのに、ドンキホーテはどこか満足げに目を細めた。
	KSTR:(K++) = 「では、%二人称_1389(献上品キャラ)%は_一人称_がお部屋まで送り届けまする！ おやすみなさいませ！」
ELSE
	KSTR:(K++) = 「むむ、断られてしまったのだ。
	KSTR:(K++) = 　%二人称_1389(献上品キャラ)%、すまぬ！ 今宵は_一人称_が代わりに添い寝してしんぜよう！」
ENDIF

CALL 口上変数表示(主導キャラ, 0)
RETURN 0

;--------------------------------------------------
;終了時の主導キャラの自慰テキスト
;　RETURN 0以外でデフォルト文章をスキップ
;--------------------------------------------------
@KOJO_EVENT_寝取らせ夜這い_寝取られオナニー口上_1389(オナニーキャラ, 寝取られキャラ)
#DIM オナニーキャラ
#DIM 寝取られキャラ
;サンチョ中は _サンチョ 版があればそちらを使う（口上_サンチョ_*.ERB）
IF サンチョ中_1389(オナニーキャラ) && EXISTFUNCTION("KOJO_EVENT_寝取らせ夜這い_寝取られオナニー口上_1389_サンチョ")
	TRYCALLFORM KOJO_EVENT_寝取らせ夜這い_寝取られオナニー口上_1389_サンチョ(オナニーキャラ, 寝取られキャラ)
	RETURN RESULT
ENDIF
SIF CSTR:オナニーキャラ:スタイル管理文字列 == "[第二眷属]サンチョ"
	RETURN 0

CALL 口上変数初期化

IF 口上_関係性判定_1389(オナニーキャラ, PLAYER, "恋慕")
	;恋慕：見届けると言った手前、自分の熱を認めたくない
	KSTR:(K++) = 「はぁ……っ、%二人称_1389()%……_H_」
	KSTR:(K++) = 二人の寝息が聞こえ始めたころ、ドンキホーテは椅子の上で膝を抱え、乱れた息を押し殺していた。
	KSTR:(K++) = 「見届け役が、これでは……示しが、つかぬのだ……っ」
ELSEIF 知識素質:オナニーキャラ:性知識 < 0
	;無知：自分の体に何が起きているのか分からない
	KSTR:(K++) = 「な、なにやら体が熱くて、眠れぬのだ……。番をしていただけなのに、なぜ……」
	KSTR:(K++) = ドンキホーテは訳も分からないまま、もぞもぞと太ももをすり合わせている。
	KSTR:(K++) = 「んっ……こ、ここを押さえると、少し楽になるような……ふぁ……_H_」
ELSE
	;性知識あり：恥じらいなく楽しんだ
	KSTR:(K++) = 「ふぅ……_H_　いやはや、見ているだけでこうも昂るとは！ 見物も立派な修練でありましたな！」
	KSTR:(K++) = ドンキホーテは汗をぬぐいながら、すっきりした顔で寝台の二人に親指を立てた。
ENDIF

CALL 口上変数表示(オナニーキャラ, 0)
RETURN 0


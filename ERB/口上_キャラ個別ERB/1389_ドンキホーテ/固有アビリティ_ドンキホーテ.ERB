; =====================================================================
; 潜入の解除。敵の反撃を含む攻撃がHPに届いた場合のみ、攻撃完了後に解除する。
; 被ダメ時反応は特殊反撃で省略されるため、計算時に確認用の無効果バフを置く。
; そのバフは攻撃テンプレート末尾で消費され、実際の被ダメ合計を確認できる。
; =====================================================================
@固有バフ・デバフ処理_キャラ_1389_被ダメージ(L_SELF, L_VALUE)
#DIM DYNAMIC L_SELF
#DIM DYNAMIC L_VALUE
#DIM DYNAMIC L_ROW
SIF L_SELF < 0 || L_SELF > 3
    RETURN L_VALUE
SIF 戦闘行動キャラ < 10 || 戦闘行動キャラ >= 20
    RETURN L_VALUE
SIF バフ番号取得_枠("ドンキ_潜入_回避率", L_SELF) < 0 && バフ番号取得_枠("ドンキ_潜入_クリティカル率", L_SELF) < 0
    RETURN L_VALUE

L_ROW = バフ番号取得_枠("ドンキ_潜入被弾確認", 戦闘行動キャラ)
; 多段攻撃でも、同じ攻撃の最初の計算より前の値を保持する。
IF L_ROW < 0 || 戦闘中カウント:L_SELF:4 != 戦闘行動キャラ + 1
    戦闘中カウント:L_SELF:3 = 戦闘中カウント:L_SELF:被ダメ合計
    戦闘中カウント:L_SELF:4 = 戦闘行動キャラ + 1
ENDIF
IF L_ROW < 0
    ; カウンターではダメージ種類が空になるため、ダメージ補正_も有効な確認先。
    {
    DT_ROW_ADD "戦闘効果データベース", "効果名", "", "バフ・デバフフラグ", "バフ",
        "適用範囲", @"{戦闘行動キャラ}", "効果枠", "ドンキ_潜入被弾確認",
        "対象能力", @"ダメージ補正_%アビ汎用文字列:ダメージ種類%",
        "効果量_割合", 0, "効果量_固定値", 0,
        "持続ターン", 0, "持続回数", 1, "持続行動回数", 0, "持続被ダメ回数", 0,
        "消去不可フラグ", 1, "特殊表示オプション", -1
    }
ENDIF
RETURN L_VALUE


@バフ消滅時処理_ドンキ_潜入被弾確認
#DIM DYNAMIC L_SELF
#DIM DYNAMIC L_ROW
FOR L_SELF, 0, 4
    SIF BATTLE_STATE:L_SELF:キャラ登録番号 < 1
        CONTINUE
    SIF NO:(BATTLE_STATE:L_SELF:キャラ登録番号) != 1389
        CONTINUE
    SIF 戦闘中カウント:L_SELF:4 != 戦闘行動キャラ + 1
        CONTINUE
    IF 戦闘中カウント:L_SELF:被ダメ合計 > 戦闘中カウント:L_SELF:3
        ; 外側の戦闘効果削除へ再帰しない。潜入には独自の消滅処理がない。
        L_ROW = バフ番号取得_枠("ドンキ_潜入_回避率", L_SELF)
        SIF L_ROW >= 0
            DT_ROW_REMOVE "戦闘効果データベース", DT_CELL_GET("戦闘効果データベース", L_ROW, "id")
        L_ROW = バフ番号取得_枠("ドンキ_潜入_クリティカル率", L_SELF)
        SIF L_ROW >= 0
            DT_ROW_REMOVE "戦闘効果データベース", DT_CELL_GET("戦闘効果データベース", L_ROW, "id")
    ENDIF
    戦闘中カウント:L_SELF:3 = 0
    戦闘中カウント:L_SELF:4 = 0
NEXT
RETURN 0

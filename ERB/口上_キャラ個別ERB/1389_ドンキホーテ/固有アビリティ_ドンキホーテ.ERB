; =====================================================================
; 過度な熱情
; 11種から等確率。全て非累積。同じ効果を引くと同枠を更新する。
;
;  0 攻撃力 +25%
;  1 防御力 +30%
;  2 行動速度 +25%
;  3 DA率 +40pt
;  4 TA率 +20pt
;  5 ゲージ上昇効率 +30%
;  6 命中率 +30pt
;  7 回避率 +20pt
;  8 クリティカル率 +30pt
;  9 ストレングス 30%
; 10 逆境 30%
; =====================================================================
@ドンキ試作_熱情バフ(L_SELF, L_RAND, L_TURN, L_MSG)
#DIM DYNAMIC L_SELF
#DIM DYNAMIC L_RAND
#DIM DYNAMIC L_TURN
#DIMS DYNAMIC L_MSG

SELECTCASE L_RAND
    CASE 0
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_攻撃力", "攻撃力", 25, 0, L_TURN, 0, 0, L_MSG)
    CASE 1
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_防御力", "防御力", 30, 0, L_TURN, 0, 0, L_MSG)
    CASE 2
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_行動速度", "行動速度", 25, 0, L_TURN, 0, 0, L_MSG)
    CASE 3
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_DA率", "DA率", 0, 40, L_TURN, 0, 0, L_MSG)
    CASE 4
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_TA率", "TA率", 0, 20, L_TURN, 0, 0, L_MSG)
    CASE 5
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_ゲージ上昇効率", "ゲージ上昇効率", 30, 0, L_TURN, 0, 0, L_MSG)
    CASE 6
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_命中率", "命中率", 0, 30, L_TURN, 0, 0, L_MSG)
    CASE 7
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_回避率", "回避率", 0, 20, L_TURN, 0, 0, L_MSG)
    CASE 8
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_クリティカル率", "クリティカル率", 0, 30, L_TURN, 0, 0, L_MSG)
    CASE 9
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_ストレングス", "ストレングス", 30, 0, L_TURN, 0, 0, L_MSG)
    CASE 10
        CALL ドンキ試作_強化(L_SELF, "ドンキ_熱情_逆境", "逆境", 30, 0, L_TURN, 0, 0, L_MSG)
ENDSELECT
RETURN 0



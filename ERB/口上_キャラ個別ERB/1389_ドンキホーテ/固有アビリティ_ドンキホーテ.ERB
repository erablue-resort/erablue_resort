; =====================================================================
; メカニック「機関停止」
; 2ターン中のエネルギー獲得を、行動開始前の値まで巻き戻す。
; 自分の行動で発生するエナジーゲイン／整備などをまとめて0化する。
; =====================================================================
@固有行動開始時処理_キャラ_1389
#DIM DYNAMIC L_SELF
L_SELF = 戦闘行動キャラ
SIF L_SELF < 0 || L_SELF > 3
    RETURN 0
戦闘中カウント:L_SELF:8 = 刻印現在数確認("エネルギー_メカニック", L_SELF)
RETURN 0


@固有行動直後処理_キャラ_1389
#DIM DYNAMIC L_SELF
#DIM DYNAMIC L_BEFORE
#DIM DYNAMIC L_NOW
#DIM DYNAMIC L_GAIN

L_SELF = 戦闘行動キャラ
SIF L_SELF < 0 || L_SELF > 3
    RETURN 0
SIF デバフ番号取得_枠("ドンキ_機関停止", L_SELF) < 0
    RETURN 0

L_BEFORE = 戦闘中カウント:L_SELF:8
L_NOW = 刻印現在数確認("エネルギー_メカニック", L_SELF)
L_GAIN = MAX(0, L_NOW - L_BEFORE)
IF L_GAIN > 0
    CALL アビ汎用変数文字列リセット
    CALL アビ対象選択テンプレート_指定(L_SELF)
    アビ汎用文字列:バフ・デバフ対象能力 = エネルギー_メカニック
    CALL アビテンプレート_刻印減少(L_GAIN)
    CALL ドンキ試作_通知(@"機関停止：エネルギー{L_GAIN}の獲得が無効化された。")
ENDIF
RETURN 0



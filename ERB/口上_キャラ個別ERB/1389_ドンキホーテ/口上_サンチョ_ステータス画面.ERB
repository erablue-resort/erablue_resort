;--------------------------------------------------
;サンチョ（1389のスタイル「[第二眷属]サンチョ」）用のステータス画面口上。
;構成は 口上_ドンキホーテ_ステータス画面.ERB と同じ。関数名はドンキホーテ版の末尾に _サンチョ を付ける。
;ドンキホーテ版の各関数の先頭で、サンチョ中かつ _サンチョ 版がある時だけこちらを呼ぶ。
;_サンチョ 版がない場面は今までどおり（汎用文・無言・ドンキホーテ版の処理）。
;空の関数でもあると「ある」扱いになり、ドンキホーテ側の代わりの処理が止まるので、
;本文を書く関数だけコメントを外して有効にすること。
;ドンキホーテ版に口上以外の処理（フラグ・数値の変更など）がある関数は、必要な処理もこちらに写すこと。
;--------------------------------------------------

;--------------------------------------------------
;通常画面一言口上。一行のみの表示を想定（二行以上は基本的に禁止）。うふふ中には表示されない
;構成はドンキホーテ版と同じ（絶頂→仕事中→状況→最も多い好感度要素）
@口上_INFO画面_一言コメント_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	KSTR:(K++) = 「はぁ……少し、息を整えさせてください」
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = 「いらっしゃいませ。ご用件は私が承ります」
		CASE 2
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「何になさいますか？ 赤いお酒でしたら、私も少しだけ詳しいですよ」
		CASE 3
			;図書室で司書中
			KSTR:(K++) = 「お静かに。……英雄譚の棚なら、普段の私がいちばん散らかしたところです」
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 「日陰から失礼します。目は良いので、見落としはしませんよ」
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = 「網は私が引きます。見た目より、ずっと力はありますので」
		CASE 6
			;遊覧船・海底散歩でシーガイド中
			KSTR:(K++) = 「左手をご覧ください。……ふふ、ガイドらしく見えますか？」
		CASE 100 TO 199
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 100):0}(現在仕事:対象キャラ:1 - 100)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「旅の道具でしたらこちらです。日除けの外套も、お勧めですよ」
				CASE "土産物屋"
					KSTR:(K++) = 「お土産をお探しですか？ 普段の私なら、きっと徽章を勧めるのでしょうね」
				CASE "食事処"
					KSTR:(K++) = 「ご注文をどうぞ。お肉は、少し赤いくらいがお勧めです」
				CASE "装飾品店"
					KSTR:(K++) = 「この赤い石の首飾り、よくお似合いになりますよ」
				CASE "直売所"
					KSTR:(K++) = 「採れたてです。この熟れた実など、いかがですか？」
			ENDSELECT
	ENDSELECT
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;状況で分岐
IF CFLAG:対象キャラ:飲み会
	;飲み会中
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「もう一杯いただけますか？ 酔った私を見られるのは、今夜だけですよ」
		CASE 1
			KSTR:(K++) = 「普段の私の失敗談でしたら、いくらでもお話しできますけれど」
	ENDSELECT
ELSEIF CFLAG:対象キャラ:睡眠
	;ダウン・睡眠中
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「少し……休ませてください。日が沈めば、すぐに戻りますから……」
	ELSEIF 陥落チェック_性的(対象キャラ) && RAND:3
		KSTR:(K++) = 「ん……行かないで、ください……」
	ELSE
		KSTR:(K++) = 「すぅ……」
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中（デートの相手のキャラ番号 + 100が入っている）
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「次はどちらへ？ 日陰の多い道だと、うれしいのですが」
		CASE 1
			KSTR:(K++) = 「普段の私がはしゃぐのも、少し分かる気がします。楽しいですね」
	ENDSELECT
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	;一緒に遊ぶ中
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「次は手加減しませんよ。普段の私の仇は、私が取ります」
		CASE 1
			KSTR:(K++) = 「ふふ、こういう遊びも悪くありませんね」
	ENDSELECT
ELSEIF CFLAG:対象キャラ:同行
	;同行中
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「お供します。今日は駆け出したりしませんので、ご安心を」
		CASE 1
			KSTR:(K++) = 「どちらへでも。後ろは私が見ておきます」
	ENDSELECT
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;一緒に隠密中
	KSTR:(K++) = 「……静かに。息を潜めるのは、得意ですので」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	;あなたが隠れていて、キャラはあなたに気づいていない
	KSTR:(K++) = 「……今日も、普段の私の後始末ですね。まったく」
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;キャラの野外オナニー中
	KSTR:(K++) = 「誰も来ませんように……少しだけ、ですから……」
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐（あの方＝PLAYER）
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方とお茶をする時間が、いちばん落ち着きます」
					CASE 1
						KSTR:(K++) = 「普段の私だけでなく、私とも仲良くしてくださる方です」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「今日は、あの方とどんな話をしましょうか」
					CASE 1
						KSTR:(K++) = 「あの方のお誘いでしたら、夜でも昼でも参ります」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「静かな場所を探しています。どこか、ご存じありませんか？」
					CASE 1
						KSTR:(K++) = 「普段の私の知り合いに、挨拶をして回らなければ」
				ENDSELECT
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方になら、背中を預けられます」
					CASE 1
						KSTR:(K++) = 「本当の私を知っても変わらずにいてくれる、得がたい方です」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方は、約束を守る方ですね」
					CASE 1
						KSTR:(K++) = 「任された仕事は、きちんと片付けておきましょう」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ここの決まりは、一通り覚えておかなければ」
					CASE 1
						KSTR:(K++) = 「普段の私が勝手をしないよう、見張っておきます」
				ENDSELECT
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方のことを考えると、冷たいはずの胸が温かくなるのです」
					CASE 1
						KSTR:(K++) = 「さっき会ったばかりなのに、もう会いたいなんて。困りましたね」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方は、今どちらにいらっしゃるのでしょう」
					CASE 1
						KSTR:(K++) = 「あの方の声が聞こえると、つい振り向いてしまいます」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方とも、ゆっくりお話ししてみたいものです」
					CASE 1
						KSTR:(K++) = 「普段の私が懐いている方ですね。覚えておきます」
				ENDSELECT
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「あの方の首筋を見ていると、喉が渇いて仕方ありません」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「あの方の手は温かいですね。……もう少し、触れていたい」
			CASEELSE
				KSTR:(K++) = 「肩が凝りました。普段の私が、昨日も暴れたせいです」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)

;--------------------------------------------------
@口上_ステータス画面_友情コメント_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「まだお話ししたことのない方ですね。まずはご挨拶を」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「お名前は存じています。普段の私が、お世話になっているようで」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「会えばご挨拶をする方です。今度は、お茶にでもお誘いしましょうか」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「あの方と話していると、つい時間を忘れてしまいます」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「普段の私には言えない話も、あの方にならできるのです」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「どちらの私とも笑ってくれる、かけがえのない友人です」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)

;--------------------------------------------------
@口上_ステータス画面_信頼コメント_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:信頼度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「まだよく存じ上げません。どのような方なのでしょう」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「信用するかどうかは、もう少し様子を見てからにします」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「頼んだことを、きちんと覚えていてくださる方ですね」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;知己
		KSTR:(K++) = 「あの方の言葉なら、疑わずに聞けます」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;相棒
		KSTR:(K++) = 「隠しごとをしなくていい相手というのは、楽なものですね」
	CASEELSE
		;水魚の交わり
		KSTR:(K++) = 「本当の私を預けられるのは、あの方だけです」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)

;--------------------------------------------------
@口上_ステータス画面_恋心コメント_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:恋心度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「あの方に胸が騒いだことは、まだありませんね」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「どのような方か、少し気になってはいます」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「あの方の笑い方は、もう覚えてしまいました」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;気になる人
		KSTR:(K++) = 「用もないのに、あの方を探してしまうのです。普段の私の癖が移りましたね」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;想い人
		KSTR:(K++) = 「夜になると、あの方の顔ばかり浮かびます」
	CASEELSE
		;最愛の人
		KSTR:(K++) = 「好きですよ。……普段の私に負けないくらい、ずっと」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)

;--------------------------------------------------
@口上_ステータス画面_性愛コメント_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:性愛度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「まだ、触れたこともない方ですね」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「あの方の手は、温かいのでしょうか」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「肩に手を置かれると、少し落ち着かなくなります」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;性癖に合う
		KSTR:(K++) = 「あの方の手つき、嫌いではありません。……もう少し、触れてほしいくらいです」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;自慰の対象
		KSTR:(K++) = 「眠れない夜は、あの方の体温を思い出してしまいます」
	CASEELSE
		;肉欲の虜
		KSTR:(K++) = 「あの方の肌の味も、脈の速さも、すっかり覚えてしまいました」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ, 1)

;--------------------------------------------------
@口上_ステータス画面_恋慕コメント_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
PRINTL
SELECTCASE CFLAG:対象キャラ:恋慕レベル
	CASE IS == 0
		;脈ナシ
		KSTR:(K++) = 「恋の話ですか？ 私には、まだ縁のないものです」
	CASE IS <= 関係閾値:1
		;ちょっと気になる
		KSTR:(K++) = 「あの方が来ると、少しだけ背筋が伸びます」
	CASE IS <= 関係閾値:2
		;なんかいいかも
		KSTR:(K++) = 「別れたあとで、もう少し話していたかったと思うのです」
	CASE IS <= 関係閾値:3
		;好意を自覚
		KSTR:(K++) = 「好きなのだと、認めることにしました。普段の私は、とっくに気づいていたようですけれど」
	CASE IS <= 関係閾値:4
		;ラブラブ
		KSTR:(K++) = 「顔を見るだけでうれしくなるなんて、私らしくありませんね」
	CASEELSE
		;最愛の人
		KSTR:(K++) = 「明日も、その次の夜も、あの方の隣にいたいのです」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ, 1)

;--------------------------------------------------
;キャラ解説。ドンキホーテ版と同じく基本人物像までに留め、正体や来歴の説明はしない（README のネタバレの線引き）
@口上_ステータス画面_キャラ解説_1389_サンチョ(対象キャラ)
#DIM 対象キャラ

KSTR:(K++) = 　ドンキホーテのスタイル「[第二眷属]サンチョ」の姿。
KSTR:(K++) = 　普段の騒がしさが嘘のように物静かで、丁寧な言葉づかいで話す。ときおり見せるいたずらっぽさは、普段の姿と変わらない。
KSTR:(K++) = 　日差しを避け、夜を好む。普段の自分のことは「普段の私」と呼び、その後始末を引き受けている。

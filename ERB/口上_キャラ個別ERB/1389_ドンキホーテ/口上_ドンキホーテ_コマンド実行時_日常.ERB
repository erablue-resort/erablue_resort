;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_COM_1389_380_3_3_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_COM_1389_380_3_3_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数３
	CASE 1
		;普通に遊ぶ
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				;失敗
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 大波にさらわれ、ドンキホーテは砂浜まで転がされてきた。
						KSTR:(K++) = 「海、手強し……！」
					CASE 1
						KSTR:(K++) = 「波が引いた今なら近づけるぞ！」
						KSTR:(K++) = 駆け寄ったドンキホーテは、次の波に追い返されて砂浜へ戻ってきた。
						KSTR:(K++) = 「むむ、あちらもすぐ構え直すのですな！」
				ENDSELECT
			CASE IS >= 10
				;大成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「%二人称_1389()%、見てくだされ、きれいな貝殻！ 海の宝を手に入れましたぞ！」
					CASE 1
						KSTR:(K++) = 砂を積んでいたドンキホーテは、崩れかけた壁を両手で押さえ直した。
						KSTR:(K++) = 「よし、残った！ 当人の城は、まだ立っておりますぞ！」
						KSTR:(K++) = 小さな砂の城を守れたことに、満足そうに胸を張っている。
				ENDSELECT
			CASEELSE
				;通常成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「寄せては返す波を、ひらりとかわしてみせようぞ！」
						KSTR:(K++) = ドンキホーテは波が来るたびに、きゃあきゃあ言いながら逃げ回っている。
					CASE 1
						KSTR:(K++) = 「ここまでなら、波も穏やかですな！」
						KSTR:(K++) = ドンキホーテは浅い所で水を掛け、戻ってくるしぶきを笑いながら受けた。
				ENDSELECT
		ENDSELECT
	CASE 2
		;泳ぎで競争
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				;失敗
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「海でも泳ぎは……泳ぎは……」
						KSTR:(K++) = ドンキホーテは足の届く所から、一歩も先へ進めずにいる。
					CASE 1
						KSTR:(K++) = ドンキホーテは水をかき始めたものの、顔に掛かった波に驚いて立ち上がった。
						KSTR:(K++) = 「ぶはっ！ 水の方から来られると、息を吸う暇がないぞ！」
				ENDSELECT
			CASE IS >= 10
				;大成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「波に乗ったら進めましたぞ！ これぞ天の助け！」
					CASE 1
						KSTR:(K++) = 何度か足をついて休みながら、ドンキホーテは決めた場所まで泳ぎ着いた。
						KSTR:(K++) = 「着いたぞ！ 遅れはしたが、一度も引き返さなかった！ これは実質、_一人称_の勝ちではありませぬか？」
				ENDSELECT
			CASEELSE
				;通常成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「浅瀬を全力で駆けるのも、立派な競争であろう！」
						KSTR:(K++) = ドンキホーテは泳ぐのを諦め、水の中を走って追いかけてくる。
					CASE 1
						KSTR:(K++) = 「_一人称_は岸に近い方で参ろう！ 波が来たら一度止まるのだ！」
						KSTR:(K++) = 慎重に足元を確かめながら進むうちに競争というより泳ぎの練習になり、気づけば%CALLNAME:PLAYER%が岸で待ちくたびれていた。
				ENDSELECT
		ENDSELECT
	CASE 3
		;浮き輪でのんびり浮かぶ
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				;失敗
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 浮き輪ごと沖へ流されかけ、ドンキホーテは大慌てで手を振っている。
						KSTR:(K++) = 「%二人称_1389()%ーっ！ 戻れませぬーっ！」
					CASE 1
						KSTR:(K++) = 小さな波に浮き輪が持ち上がり、ドンキホーテは輪の縁にしがみついた。
						KSTR:(K++) = 「おおっ！ 今の高さは聞いておらぬぞ！」
						KSTR:(K++) = 次の波が来るまでに、慌てて座り直している。
				ENDSELECT
			CASE IS >= 10
				;大成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = ドンキホーテは浮き輪の上から、水平線をじっと眺めている。
						KSTR:(K++) = 「あの向こうにも、まだ見ぬ冒険があるのでありましょうな！」
					CASE 1
						KSTR:(K++) = 「浮き輪が上がると、遠くまで見えるのですな！」
						KSTR:(K++) = ドンキホーテは波が来るたびに背伸びをして、浮き輪ごと持ち上がった一瞬だけ、得意げに遠くを指さしている。
				ENDSELECT
			CASEELSE
				;通常成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「海に浮かぶのは、プールとはまた違いまするな。揺れが心地よい！」
					CASE 1
						KSTR:(K++) = 「_一人称_も揺れ方が分かってきたぞ！ ここで踏ん張らぬ方が楽なのだな！」
						KSTR:(K++) = ドンキホーテは輪をつかむ手を緩めて波に揺られていたが、緩めすぎて輪からするりと抜けかけ、慌ててしがみついた。
				ENDSELECT
		ENDSELECT
	CASE 4
		;ビーチバレー
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				;失敗
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「アタァーック！」
						KSTR:(K++) = ドンキホーテの渾身の一撃は、自分の顔面に返ってきた。
					CASE 1
						KSTR:(K++) = 「当人に任せよ！ ほっ！」
						KSTR:(K++) = 球へ飛びついたドンキホーテは、砂に足を取られて膝をついた。
						KSTR:(K++) = 球は頭のすぐ上を通り、後ろに落ちた。
				ENDSELECT
			CASE IS >= 10
				;大成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「決まったぁ！ 見ましたか、当人のスパイク！」
						KSTR:(K++) = ドンキホーテは砂だらけのまま、勝利の拳を突き上げている。
					CASE 1
						KSTR:(K++) = 低く飛んだ球へ手を伸ばし、ドンキホーテは砂に転がりながら打ち返した。
						KSTR:(K++) = 「繋がったぞ！ %二人称_1389()%、あとはお願いしよう！」
						KSTR:(K++) = 起き上がるとすぐに膝の砂を払い、次の球に備えた。
				ENDSELECT
			CASEELSE
				;通常成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「拾って、繋いで、打つ！ 仲間との連携こそ勝利の鍵なるぞ！」
					CASE 1
						KSTR:(K++) = 「_一人称_が拾うゆえ、%二人称_1389()%は次の一打を！」
						KSTR:(K++) = ドンキホーテは球を高く上げようとして、思ったより低い球を返した。
						KSTR:(K++) = 「低かった！ 急いでくだされ！」
				ENDSELECT
		ENDSELECT
	CASE 5
		;スイカ割り
		SELECTCASE RFLAG:コマンド結果受渡し変数
			CASE IS < 0
				;失敗
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「右！ もっと右！ ……え、行き過ぎ？」
						KSTR:(K++) = 目隠しのドンキホーテは、スイカの横の砂を力いっぱい叩いた。
					CASE 1
						KSTR:(K++) = 「止まれ、ですな！ しかと聞こえましたぞ！」
						KSTR:(K++) = 返事をしたあとも半歩進んでしまい、振り下ろした棒はスイカの脇の砂へ落ちた。
						KSTR:(K++) = 「足にも聞かせておくべきであった！」
				ENDSELECT
			CASE IS >= 10
				;大成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「成敗っ！」
						KSTR:(K++) = 振り下ろした棒がスイカを見事に割り、ドンキホーテは目隠しのまま勝ち名乗りを上げた。
					CASE 1
						KSTR:(K++) = 「ここであるな！ 参るぞ！」
						KSTR:(K++) = 声を頼りに何度も向きを直したドンキホーテは、ようやくスイカを割った。
						KSTR:(K++) = 「_一人称_だけでは届かなかったぞ！ 案内、かたじけない！」
				ENDSELECT
			CASEELSE
				;通常成功
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「手応えあり！」
						KSTR:(K++) = スイカに少しだけひびが入り、ドンキホーテは満足げにうなずいた。
					CASE 1
						KSTR:(K++) = 棒がスイカに当たり、小さなひびが入った。
						KSTR:(K++) = 「当たった！ 音でも分かりましたぞ！
						KSTR:(K++) = 　次もこの向きでよいのでござるか？」
						KSTR:(K++) = 目隠しをしたまま、ドンキホーテは次の指示を待っている。
				ENDSELECT
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM381_3_3 海水浴場でバーベキューする
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-2:大失敗 -1:失敗  0:通常成功  1:大成功
;RFLAG:コマンド結果受渡し変数２
	;誰が料理したかのキャラ番号が入る（＝その場にいるなかで最も料理人Lvが高い人）（同一値の際はランダム）
;提供食材:0,提供食材:1,提供食材:2
	;提供した食材の番号が入る

@KOJO_COM_1389_381_3_3(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_COM_1389_381_3_3_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_COM_1389_381_3_3_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

;RFLAG:コマンド結果受渡し変数２（焼いたキャラ）で、ドンキホーテ自身・PLAYER・その他を分ける。
;焼き役がPLAYER以外の他人の時は、誰に向けた言葉か地の文で示す。
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;ドンキホーテが焼いた
			KSTR:(K++) = 「海辺の焼き物は当人に任せてくだされ！」
			KSTR:(K++) = 潮風にあおられた火は、網の上の食材をすべて炭に変えた。
			KSTR:(K++) = 「……海の風が、少々強すぎたようでありまする」
		ELSE
			;他の人が焼いた
			KSTR:(K++) = 「真っ黒ではないか！ されど、これも海の騎士の食事！」
			KSTR:(K++) = ドンキホーテは目をつぶって、炭のような肉にかぶりついた。
		ENDIF
	CASE -1
		;失敗
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;ドンキホーテが焼いた
			KSTR:(K++) = 「焦げた！ いや、これは香ばしいと言うのであります！」
		ELSE
			;他の人が焼いた
			KSTR:(K++) = 「少々焦げても、海で食べれば何でも美味いのだ！」
		ENDIF
	CASE 0
		;通常成功
		KSTR:(K++) = 「潮風の中で食べる焼き物は格別であるな！ %二人称_1389()%、こちらも焼けましたぞ！」
	CASEELSE
		;大成功
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;ドンキホーテが焼いた
			KSTR:(K++) = 「_一人称_が焼いたのに、美味しい……！ 海の神の加護でありましょうか！」
		ELSEIF RFLAG:コマンド結果受渡し変数２ == PLAYER
			;PLAYERが焼いた
			KSTR:(K++) = 「%二人称_1389()%の焼いたものは絶品である！ ぜひとも弟子にしてくれませぬか！」
		ELSE
			;その他の人が焼いた
			KSTR:(K++) = ドンキホーテは焼き役の%CALLNAME:(RFLAG:コマンド結果受渡し変数２)%に、目を輝かせて詰め寄った。
			KSTR:(K++) = 「この焼き加減、達人の技であるな！ _一人称_も見習わねば！」
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM382_3_3 海水浴場で水鉄砲で遊ぶ
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;ミニゲームの成果を保存  15以上:ハイレベルな熱戦  10以上:激戦  6以上:水鉄砲バトルとして成立  3以上:カジュアルに楽しむ  2以下:敗北
	;運動が苦手なキャラの場合は15以上や10以上は場合分けせず、6以上に統合してしまうのも手

@KOJO_COM_1389_382_3_3(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_COM_1389_382_3_3_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_COM_1389_382_3_3_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE IS <= 2
		;敗北
		KSTR:(K++) = 波打ち際で足を取られたところに水を浴びせられ、ドンキホーテは砂浜に大の字になった。
		KSTR:(K++) = 「む、無念……」
	CASE IS <= 5
		;カジュアルに楽しむ
		KSTR:(K++) = 「海の水はしょっぱいのだな！ ぺっ、ぺっ！」
	CASE IS <= 9
		;水鉄砲バトルとして成立
		KSTR:(K++) = 「波を盾にするのでござる！」
		KSTR:(K++) = ドンキホーテは波が来るたびに伏せているが、どう見ても余計に濡れている。
	CASE IS <= 14
		;激戦
		KSTR:(K++) = 「砂浜を駆けながらの撃ち合い！ まさに英雄譚の決戦である！」
	CASEELSE
		;ハイレベルな熱戦
		KSTR:(K++) = 「ここまで渡り合えるとは！ %二人称_1389()%、当人の好敵手と認めまする！」
		KSTR:(K++) = 二人は最後の一滴まで撃ち合った。
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)



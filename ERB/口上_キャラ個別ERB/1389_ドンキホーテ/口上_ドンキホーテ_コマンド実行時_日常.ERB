;RFLAG:コマンド結果受渡し変数
	;ミニゲームの種類  1:簡易釣りモード  2:ちゃんと釣りモード
;RFLAG:コマンド結果受渡し変数２
	;どのくらい釣れたか、魚の数が直接入る  10以上で大漁、5以上で上々、0でボウズ

@KOJO_COM_1389_380_0_305(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_COM_1389_380_0_305_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_COM_1389_380_0_305_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数２
	CASE IS >= 10
		;大漁
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「見よ、この釣果！ 渓流の主すら、当人の前にひれ伏したのだ！」
				KSTR:(K++) = 魚籠からあふれた魚が、地面でぴちぴちと跳ねている。
			CASE 1
				KSTR:(K++) = 「帰るまでが釣りである！ こぼさぬよう、当人がしっかり持って参ろう！」
				KSTR:(K++) = 魚籠を持ち上げたドンキホーテは、重さに目を丸くした。
				KSTR:(K++) = 「%二人称_1389()%、取っ手の片方をお願いしてもよいでござるか？」
		ENDSELECT
	CASE IS >= 5
		;上々
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「なかなかの戦果であろう！ 今夜は焼き魚であるぞ！」
			CASE 1
				KSTR:(K++) = 「同じ川から釣ったのに、色も形も違うのですな！
				KSTR:(K++) = 　%二人称_1389()%、帰ったら名前を調べてみませぬか？」
				KSTR:(K++) = ドンキホーテは魚籠を覗き、魚の模様を一匹ずつ見比べている。
		ENDSELECT
	CASE IS > 0
		;普通
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「一匹でも釣れれば勝利！ 胸を張って帰りましょう！」
				KSTR:(K++) = ドンキホーテは小さな魚を高々と掲げている。
			CASE 1
				KSTR:(K++) = 「ようやく食いついた！ ようやくであるぞ！
				KSTR:(K++) = 　_一人称_がじっとしている間、魚もじっとしておったのでござろうか？」
				KSTR:(K++) = ドンキホーテは釣れた魚を見下ろし、辛抱した甲斐があったと何度もうなずいた。
		ENDSELECT
	CASEELSE
		;釣果ゼロ
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「魚たちめ、我らの気迫に恐れをなして隠れてしまったようでありまするな！
				KSTR:(K++) = 　はっはっは……はぁ」
				KSTR:(K++) = ドンキホーテは空の魚籠を覗き込み、肩を落とした。
			CASE 1
				KSTR:(K++) = 「ここなら釣れると思ったのだがなあ。
				KSTR:(K++) = 　_一人称_が場所を移すたびに、魚も移っておるのではありませぬか？」
				KSTR:(K++) = ドンキホーテは空の魚籠を抱え、流れの先を未練がましく見送っている。
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)



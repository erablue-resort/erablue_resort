		;失敗
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;ドンキホーテが焼いた
			KSTR:(K++) = 「あっ、こちらが焦げて……あっ、こちらも！」
			KSTR:(K++) = ドンキホーテは網の上で肉をひっくり返し続けている。
			KSTR:(K++) = 「焦げた面を下にして盛り付ければ、隠し通せ……いや、それは正義に反する……！」
		ELSE
			;他の人が焼いた
			KSTR:(K++) = 「少々焦げておるが、これもまた野営の味というもの！」
			KSTR:(K++) = ドンキホーテは焦げた端をかじりながら、元気よくうなずいた。
		ENDIF
	CASE 0
		;通常成功
		KSTR:(K++) = 「ほっ！ 焼けた！ 焼けましたぞ！ %二人称_1389()%、熱いうちにいただいてくだされ！」
		KSTR:(K++) = ドンキホーテは自分の皿よりも先に、%CALLNAME:PLAYER%の皿に肉を載せている。
	CASEELSE
		;大成功
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;ドンキホーテが焼いた
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「おお……！ _一人称_が焼いたとは思えぬ出来ではないか！」
					KSTR:(K++) = ドンキホーテは自分で焼いた肉を、信じられないものを見るような目で見つめている。
					KSTR:(K++) = 「偶然……いやいや、実力でござる！」
				CASE 1
					KSTR:(K++) = 「今の焼き加減を覚えておけば、次も同じようにできるはず！
					KSTR:(K++) = 　%二人称_1389()%、当人は何回ひっくり返しておりましたか？」
					KSTR:(K++) = 夢中で焼いていたため、自分では回数を覚えていないらしい。
			ENDSELECT
		ELSE
			;他の人が焼いた
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「バービィキュー、最高なのだ！ この焼き加減、まさに職人の技！」
					KSTR:(K++) = ドンキホーテは両手に串を持ち、交互にかぶりついている。
				CASE 1
					KSTR:(K++) = 「おお、これは噛むほど美味い！
					KSTR:(K++) = 　_一人称_も、焼き網の前で待つべきか、皿を持って待つべきか迷いますな！」
					KSTR:(K++) = ドンキホーテは次の一口を頬張ると、結局、皿を持ったまま網のそばへ寄っていった。
				CASE 2
					KSTR:(K++) = 「%二人称_1389()%、まだ皿に入りますか？ こちらもよい匂いですぞ！」
					KSTR:(K++) = ドンキホーテは焼けたものを取り分けながら、自分の皿にもせっせと載せている。
					KSTR:(K++) = 「む、_一人称_の分はもう載せる場所がない！ まずはこちらからいただこう！」
			ENDSELECT

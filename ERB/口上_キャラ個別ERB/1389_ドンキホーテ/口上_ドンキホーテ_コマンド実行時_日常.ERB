@口上_関係性判定_1389(対象キャラ, 相手キャラ, 関係性)
#FUNCTION
#DIM 対象キャラ
#DIM 相手キャラ
#DIMS 関係性

SIF 対象キャラ < 0 || 対象キャラ >= CHARANUM || 相手キャラ < 0 || 相手キャラ >= CHARANUM
	RETURNF 0

IF 相手キャラ == MASTER
	SELECTCASE 関係性
		CASE "恋慕"
			RETURNF TALENT:対象キャラ:恋慕
		CASE "セフレ"
			RETURNF TALENT:対象キャラ:セフレ
	ENDSELECT
	RETURNF 0
ENDIF

RETURNF 関係性チェック(対象キャラ, 相手キャラ, 関係性)


@口上_陥落判定_1389(対象キャラ, 相手キャラ)
#FUNCTION
#DIM 対象キャラ
#DIM 相手キャラ

SIF 対象キャラ < 0 || 対象キャラ >= CHARANUM || 相手キャラ < 0 || 相手キャラ >= CHARANUM
	RETURNF 0

SIF 相手キャラ == MASTER
	RETURNF 陥落チェック(対象キャラ)

RETURNF 口上_関係性判定_1389(対象キャラ, 相手キャラ, "恋慕") || 口上_関係性判定_1389(対象キャラ, 相手キャラ, "セフレ")

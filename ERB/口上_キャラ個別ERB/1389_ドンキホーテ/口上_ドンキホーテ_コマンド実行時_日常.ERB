;--------------------------------------------------
;COM380_3_6 船着き場で釣りをする
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;ミニゲームの種類  1:簡易釣りモード  2:ちゃんと釣りモード
;RFLAG:コマンド結果受渡し変数２
	;どのくらい釣れたか、魚の数が直接入る  10以上で大漁、5以上で上々、0でボウズ

@KOJO_COM_1389_380_3_6(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_COM_1389_380_3_6_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_COM_1389_380_3_6_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数２
	CASE IS >= 10
		;大漁
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「海の主が群れで現れおったぞ！ 大漁、大漁！」
			CASE 1
				KSTR:(K++) = 「見てくだされ、この数！ 当人も数えるのに骨が折れますぞ！」
				KSTR:(K++) = ドンキホーテはバケツの中を指差して数えていたが、魚が跳ねるたびに初めからやり直している。
		ENDSELECT
	CASE IS >= 5
		;上々
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「潮の香りと釣果！ 申し分ありませぬな！」
			CASE 1
				KSTR:(K++) = 「船に乗らずとも、これほど釣れるとは！
				KSTR:(K++) = 　今度ここを通るときも、_一人称_は水の中を覗いてしまいそうだ！」
				KSTR:(K++) = ドンキホーテは竿を片づけながらも、足元の海へちらちらと目を向けている。
		ENDSELECT
	CASE IS > 0
		;普通
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「小さくとも、海の魚は海の魚！ 立派な戦利品でありまする！」
			CASE 1
				KSTR:(K++) = 「おお、光っておる！ 海の魚は鎧を着ているようですな！」
				KSTR:(K++) = ドンキホーテは魚の背をそっと傾けて光る鱗を眺め、「騎士の鎧にも負けぬ輝きである」と満足げにうなずいた。
		ENDSELECT
	CASEELSE
		;釣果ゼロ
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「うぬぬ、船着き場の魚は、_一人称_より一枚上手のようですな」
				KSTR:(K++) = ドンキホーテは空のバケツを覗き込み、肩を落とした。
			CASE 1
				KSTR:(K++) = 「当たりはあったのだ！ 当たりは、確かにあったのだが！」
				KSTR:(K++) = ドンキホーテはむなしい手応えを思い出すように、竿を持つ手をぎゅっと握り直した。
				KSTR:(K++) = 「_一人称_が喜んでおる間に、逃げられてしまったのでござるな」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM402 就寝
;--------------------------------------------------
;あなたが寝る時、一緒にいるキャラが喋る

@KOJO_COM_1389_402(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_COM_1389_402_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_COM_1389_402_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

IF CFLAG:対象キャラ:睡眠 == 0
	;寝てない時に喋る
	IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
		;恋慕後
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「おやすみなさいませ、%二人称_1389()%！ 良い夢を！」
				KSTR:(K++) = 元気よく手を振ったドンキホーテが、ふと声を落とした。

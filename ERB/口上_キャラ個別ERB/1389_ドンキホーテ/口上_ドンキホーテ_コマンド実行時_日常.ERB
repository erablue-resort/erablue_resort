;--------------------------------------------------
;口上用の補助関数
;二人称_1389は、セリフで相手を呼ぶ時に使う。全ての口上ファイルから使う。
;呼び名_1389は、殿を付けずに呼ぶ時（大人の顔の台詞などのレアケース）に使う。
;ゆきずり相手判定_1389はCOM404の野外オナニー・ゆきずり（CASE 3）で使う。CASE 3を有効化する時に一緒に有効化する。
;口上_関係性判定_1389は、PLAYERが主人公なら素質、それ以外なら相手ごとの関係性を見る（本体のCOM351と同じ判定）。
;口上_場所判定_1389は、同じ場所にいる時の場所名（勤務中なら仕事名）を返す。場所の口上をSELECTCASEで分ける時に使う。
;--------------------------------------------------

;--------------------------------------------------
;口上用の場所判定（良秀の口上_場所判定_1384を写したもの。会話などのロケーション分岐用）
;あなたと同じ場所にいない時や、どの場所にも当たらない時は""を返す。
;勤務中の仕事がある場所では、場所名の代わりに仕事名を返す。
;判定は上から順。どの場所にもいない時だけ、警備員・訓練中を返す。
;返す値：
;　ロビー／ロビー受付、食堂／調理師／給仕、プール／プール監視員、海水浴場、船着き場、
;　バーエリア／バーテンダー／ディーラー、温泉浴場、温泉洗い場、温泉脱衣所、温泉ロビー、女子更衣室、サウナ、キャンプファイアー、キャンプ場、
;　知識習得／教師（学校）、図書室／司書、美術館、お祭り、警備員、訓練
;--------------------------------------------------
@口上_場所判定_1389(対象キャラ)
#FUNCTIONS
#DIM 対象キャラ
#DIM 場所マップ
#DIM 場所位置

SIF 対象キャラ < 0 || 対象キャラ >= CHARANUM
	RETURNF ""
SIF CFLAG:PLAYER:現在マップ種別 != CFLAG:対象キャラ:現在マップ種別 || CFLAG:PLAYER:現在位置 != CFLAG:対象キャラ:現在位置
	RETURNF ""

場所マップ = CFLAG:PLAYER:現在マップ種別
場所位置 = CFLAG:PLAYER:現在位置

IF 場所マップ == 0 && 場所位置 == 2
	SIF 常駐業務_勤務中(対象キャラ, "ロビー受付")
		RETURNF "ロビー受付"
	RETURNF "ロビー"
ELSEIF 場所マップ == 0 && 場所位置 == 4
	SIF 常駐業務_勤務中(対象キャラ, "調理師")
		RETURNF "調理師"
	SIF 常駐業務_勤務中(対象キャラ, "給仕")
		RETURNF "給仕"
	RETURNF "食堂"
ELSEIF 場所マップ == 0 && GROUPMATCH(場所位置, 15, 1503, 1504, 1505, 1506)
	;プール・プールサイド・メインプール・ボールプール・流れるプール
	SIF 常駐業務_勤務中(対象キャラ, "プール監視員")
		RETURNF "プール監視員"
	RETURNF "プール"
ELSEIF 場所マップ == 3 && 場所位置 == 3
	RETURNF "海水浴場"
ELSEIF 場所マップ == 3 && 場所位置 == 6
	RETURNF "船着き場"
ELSEIF 場所マップ == 0 && 場所位置 == 503
	;バー・カジノ（実装上は同じバーエリア）
	SIF 常駐業務_勤務中(対象キャラ, "バーテンダー")
		RETURNF "バーテンダー"
	SIF 常駐業務_勤務中(対象キャラ, "ディーラー")
		RETURNF "ディーラー"
	RETURNF "バーエリア"
ELSEIF 場所マップ == 0 && GROUPMATCH(場所位置, 9, 10, 11, 12, 704, 705, 707, 708, 804, 805, 807, 808)
	;温泉の浴場（内風呂、変わり湯、露天風呂、壺湯。改装前の浴場も含む）
	RETURNF "温泉浴場"
ELSEIF 場所マップ == 0 && GROUPMATCH(場所位置, 703, 803)
	RETURNF "温泉洗い場"
ELSEIF 場所マップ == 0 && GROUPMATCH(場所位置, 7, 8, 702, 802)
	;温泉の脱衣所（改装前の男子脱衣所、女子脱衣所も含む）
	RETURNF "温泉脱衣所"
ELSEIF 場所マップ == 0 && GROUPMATCH(場所位置, 701, 801)
	;温泉のロビー（男湯側・女湯側）。浴場ではないので、お茶などはここで出せる
	RETURNF "温泉ロビー"
ELSEIF (場所マップ == 0 && 場所位置 == 14) || (場所マップ == 3 && 場所位置 == 5)
	;女子更衣室（プール／海水浴場）
	RETURNF "女子更衣室"
ELSEIF 場所マップ == 0 && GROUPMATCH(場所位置, 306, 706, 806)
	;サウナ（キャンプ場のサウナテント／温泉のサウナルーム）
	RETURNF "サウナ"
ELSEIF 場所マップ == 0 && 場所位置 == 307
	RETURNF "キャンプファイアー"
ELSEIF 場所マップ == 0 && ((場所位置 == 3 && 施設改造度:3:0 > 0) || GROUPMATCH(場所位置, 302, 303, 304, 305, 308))
	;キャンプ場（改装後の庭を含む。サウナテントとキャンプファイアーは上で別に返す）
	RETURNF "キャンプ場"
ELSEIF 場所マップ == 2 && 場所位置 == 13 && 常駐業務_勤務中(対象キャラ, "知識習得")
	RETURNF "知識習得"
ELSEIF 場所マップ == 2 && 場所位置 == 13 && 常駐業務_勤務中(対象キャラ, "教師")
	RETURNF "教師"
ELSEIF 場所マップ == 0 && 場所位置 == 506
	SIF 常駐業務_勤務中(対象キャラ, "司書")
		RETURNF "司書"
	RETURNF "図書室"
ELSEIF 場所マップ == 2 && 場所位置 == 102
	RETURNF "美術館"
ELSEIF 場所マップ == 100
	;お祭りの特設会場（お花見・夏祭り・歳旦祭）。どの祭りかは開催予定祭り名（例："FESTIVAL_夏祭り"）で分ける
	RETURNF "お祭り"
ELSEIF 常駐業務_勤務中(対象キャラ, "警備員")
	RETURNF "警備員"
ELSEIF 常駐業務_勤務中(対象キャラ, "訓練")
	RETURNF "訓練"
ENDIF

RETURNF ""

;--------------------------------------------------
;セリフ用の二人称。相手の呼び名に「殿」を付ける（例：良秀殿）。
;主人公が名無し（呼び名が「あなた」）の時は「オーナー殿」にする。
;セリフでは %二人称_1389()% と書く。相手キャラを省略するとPLAYER。
;CSVの二人称（貴殿）は、ゲーム側の画面などで使われるため変更しない。
;--------------------------------------------------
@二人称_1389(相手キャラ = -1, ドンキ口調 = 0)
#FUNCTIONS
#DIM 相手キャラ
#DIM ドンキ口調

;サンチョ中はサンチョの二人称（「貴方」「◯◯さん」）を返す（2026-10-12ユーザー指示）。
;サンチョがドンキホーテの口真似をする台詞では、第2引数に1を渡すとドンキホーテの呼び方のまま返す。
SIF !ドンキ口調 && サンチョ中_1389(GETCHARA(1389))
	RETURNF 二人称_サンチョ_1389(相手キャラ)
SIF 相手キャラ < 0
	相手キャラ = PLAYER
SIF 相手キャラ < 0 || 相手キャラ >= CHARANUM
	RETURNF "貴殿"
SIF CALLNAME:相手キャラ == "あなた"
	RETURNF "オーナー殿"
RETURNF CALLNAME:相手キャラ + "殿"

;--------------------------------------------------
;セリフ用の殿なしの呼び名。大人の顔の台詞などのレアケースで使う。
;主人公が名無し（呼び名が「あなた」）の時は「オーナー」にする。
;セリフでは %呼び名_1389()% と書く。相手キャラを省略するとPLAYER。
;--------------------------------------------------
@呼び名_1389(相手キャラ = -1)
#FUNCTIONS
#DIM 相手キャラ

SIF 相手キャラ < 0
	相手キャラ = PLAYER
SIF 相手キャラ < 0 || 相手キャラ >= CHARANUM
	RETURNF "あなた"
SIF CALLNAME:相手キャラ == "あなた"
	RETURNF "オーナー"
RETURNF CALLNAME:相手キャラ


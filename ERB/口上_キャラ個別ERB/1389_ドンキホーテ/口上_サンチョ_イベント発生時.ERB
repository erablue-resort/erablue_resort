;--------------------------------------------------
;サンチョ（1389のスタイル「[第二眷属]サンチョ」）用のイベント発生時口上。
;構成は 口上_ドンキホーテ_イベント発生時.ERB と同じ。関数名はドンキホーテ版の末尾に _サンチョ を付ける。
;ドンキホーテ版の各関数の先頭で、サンチョ中かつ _サンチョ 版がある時だけこちらを呼ぶ。
;_サンチョ 版がない場面は今までどおり（汎用文・無言・ドンキホーテ版の処理）。
;空の関数でもあると「ある」扱いになり、ドンキホーテ側の代わりの処理が止まるので、
;本文を書く関数だけコメントを外して有効にすること。
;ドンキホーテ版に口上以外の処理（フラグ・数値の変更など）がある関数は、必要な処理もこちらに写すこと。
;--------------------------------------------------

;--------------------------------------------------
;挨拶時。一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;サンチョ版は時間帯×関係（恋慕・セフレ・未陥落）で分ける。サンチョは夜に強く、朝は少し弱い
@KOJO_EVENT_挨拶_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE TIME
	CASE 5*60 TO 11*60
		;朝
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「おはようございます、%二人称_サンチョ_1389()%。……朝は苦手なのですけれど、%二人称_サンチョ_1389()%の顔を見ると、少し目が覚めますね」
				CASE 1
					KSTR:(K++) = 「おはようございます。……ふふ、寝癖がついていますよ。直して差し上げますから、少しかがんでください」
					KSTR:(K++) = %CALLNAME:対象キャラ%は背伸びをして、%CALLNAME:PLAYER%の髪をそっと指で梳いた。
			ENDSELECT
		ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
			KSTR:(K++) = 「おはようございます。……眠そうですね。昨夜は、よく眠れなかったのですか？ 私のせいでなければいいのですが」
		ELSE
			KSTR:(K++) = 「おはようございます、%二人称_サンチョ_1389()%。朝の日差しは少しまぶしいので、日陰から失礼しますね」
		ENDIF
	CASE 11*60 TO 18*60
		;昼
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「こんにちは、%二人称_サンチョ_1389()%。……日傘に入っていきませんか？ 二人なら、少し狭いくらいがちょうどいいです」
				CASE 1
					KSTR:(K++) = 「%二人称_サンチョ_1389()%、探しました。……用事ですか？ いいえ、顔が見たかっただけです」
			ENDSELECT
		ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
			KSTR:(K++) = 「こんにちは。昼間から会うのは、なんだか新鮮ですね。……いつもは夜ばかりですから」
		ELSE
			KSTR:(K++) = 「こんにちは、%二人称_サンチョ_1389()%。今日も普段の私が、どこかでご迷惑をおかけしていませんでしたか？」
		ENDIF
	CASEELSE
		;夜
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「こんばんは、%二人称_サンチョ_1389()%。夜は私の時間です。……今夜は、私に付き合ってくださいますね？」
				CASE 1
					KSTR:(K++) = 「こんばんは。月がきれいですね。……%二人称_サンチョ_1389()%と見ると、なおさら」
					KSTR:(K++) = %CALLNAME:対象キャラ%は月を見上げたまま、%CALLNAME:PLAYER%の手にそっと指を絡めた。
			ENDSELECT
		ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
			KSTR:(K++) = 「こんばんは。いい夜ですね。……退屈しのぎのお相手が、ちょうど欲しかったところです」
		ELSE
			KSTR:(K++) = 「こんばんは、%二人称_サンチョ_1389()%。夜は目がよく利くので、遠くからでも%二人称_サンチョ_1389()%だと分かりましたよ」
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;PLAYERがほかの人と情事に及んでいるのを見た後、再び顔を合わせた時
;相手はCFLAG:対象キャラ:情事目撃。セリフでは %二人称_サンチョ_1389(CFLAG:対象キャラ:情事目撃)%、地の文では %CALLNAME:(CFLAG:対象キャラ:情事目撃)%
@KOJO_EVENT_情事目撃_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
	;恋慕：にこやかだが、少しだけ本気の嫉妬がにじむ
	KSTR:(K++) = 「見ましたよ、%二人称_サンチョ_1389()%。%二人称_サンチョ_1389(CFLAG:対象キャラ:情事目撃)%と、ずいぶん仲がよろしいのですね」
	KSTR:(K++) = %CALLNAME:対象キャラ%はにこやかに微笑んでいるが、%CALLNAME:PLAYER%の手首を握る指には、少しだけ力がこもっていた。
	KSTR:(K++) = 「怒ってはいませんよ。……ただ、今夜は私の番です。首筋、空けておいてくださいね」
ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
	KSTR:(K++) = 「先日、%二人称_サンチョ_1389(CFLAG:対象キャラ:情事目撃)%とお楽しみでしたね。……ふふ、なかなかの腰使いでした」
	KSTR:(K++) = %CALLNAME:対象キャラ%は面白そうに目を細めると、%CALLNAME:PLAYER%の耳元で囁いた。
	KSTR:(K++) = 「今度、私にも同じことをしてくださいね」
ELSE
	KSTR:(K++) = 「その……先日、%二人称_サンチョ_1389(CFLAG:対象キャラ:情事目撃)%とご一緒のところを、見てしまいまして」
	KSTR:(K++) = %CALLNAME:対象キャラ%は頬を赤らめ、視線をあちこちに泳がせた。
	KSTR:(K++) = 「誰にも言いません。……普段の私にも、言いませんので」
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;ゲーム側が先に破瓜の地の文を表示する。うふふ・夜這い・性処理業務・むりやりのどれでも起きる
@KOJO_EVENT_処女喪失_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
	KSTR:(K++) = 「……っ、ふふ。血には慣れているつもりでしたけれど、自分のものだと、こんなに熱いのですね」
	KSTR:(K++) = %CALLNAME:対象キャラ%は痛みに眉を寄せながらも、%CALLNAME:PLAYER%の背中にそっと腕を回した。
	KSTR:(K++) = 「大丈夫です。……%二人称_サンチョ_1389()%で、よかった」
ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
	KSTR:(K++) = 「っ……ふふ、痛いですね。私が誰かに血を流させられるなんて、珍しいことです」
	KSTR:(K++) = %CALLNAME:対象キャラ%は小さく息を吐くと、%CALLNAME:PLAYER%に続けるよう目で促した。
ELSE
	KSTR:(K++) = 「く、ぅ……っ」
	KSTR:(K++) = %CALLNAME:対象キャラ%は唇を噛んで、こぼれそうになる声を、じっとこらえていた。
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;うふふ終了時。終了原因は "全員ダウン" "通常終了" "目撃される" "サウナ限界" など
@KOJO_EVENT_うふふ終了_1389_サンチョ(対象キャラ, 終了原因)
#DIM 対象キャラ
#DIMS 終了原因
CALL 口上変数初期化

IF CFLAG:対象キャラ:体力限界
	;終了時にダウンしている
	IF 終了原因 == "全員ダウン"
		KSTR:(K++) = 寝台の上には、精も根も尽き果てた二人が、折り重なるようにして眠っていた。
	ELSE
		KSTR:(K++) = 「すぅ……」
		KSTR:(K++) = すっかり力尽きた%CALLNAME:対象キャラ%は、乱れたシーツにくるまって、静かな寝息を立てている。
	ENDIF
ELSE
	SELECTCASE 終了原因
		CASE "通常終了"
			;逢引終了ボタンでの終了。最も一般的
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				KSTR:(K++) = 「もう終わりですか？ ……ふふ、冗談です。今夜は、このまま腕枕をしてくださいね」
				KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の胸に頬を寄せ、満ち足りたように目を閉じた。
			ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
				KSTR:(K++) = 「ふう……いい汗をかきました。次は、もう少し長く付き合ってくださいね」
			ELSE
				KSTR:(K++) = 「……ありがとうございました。その、いろいろと」
				KSTR:(K++) = %CALLNAME:対象キャラ%は赤い顔でシーツを胸元に引き寄せ、%CALLNAME:PLAYER%から目をそらした。
			ENDIF
		CASE "目撃される"
			;陥落していないキャラにうふふが目撃された。サンチョは羞恥心1なので恥ずかしがる
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				KSTR:(K++) = 「み、見られて……っ！ ……%二人称_サンチョ_1389()%、今すぐ隠してください。私を」
				KSTR:(K++) = %CALLNAME:対象キャラ%は真っ赤になって、%CALLNAME:PLAYER%の背中に顔を埋めた。
			ELSE
				KSTR:(K++) = 「……っ！ し、失礼しました。今のは、どうか忘れていただけると……」
				KSTR:(K++) = %CALLNAME:対象キャラ%はシーツを頭からかぶり、その場で小さく丸くなった。
			ENDIF
		CASE "サウナ限界"
			;サウナ内でうふふ中、熱気ゲージがたまりすぎた時
			KSTR:(K++) = 「はぁ、はぁ……熱いのは、苦手なのです……。少し、涼ませてください……」
			KSTR:(K++) = %CALLNAME:対象キャラ%はふらつく足取りでサウナを出ると、冷たい床にぺたりと座り込んだ。
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;うふふ中に体力が０になった直後、眠る前
@KOJO_EVENT_うふふ体力限界_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RAND:2
	CASE 0
		KSTR:(K++) = 「もう……指一本、動きません……。夜は私の時間のはず、ですのに……」
		KSTR:(K++) = 何度も責め立てられた%CALLNAME:対象キャラ%は、ぐったりと寝台に沈み込み、そのまま寝息を立て始めた。
	CASE 1
		KSTR:(K++) = 「次は……負けません、から……」
		KSTR:(K++) = 悔しそうに呟いたのを最後に、%CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の腕の中で、すとんと眠りに落ちた。
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


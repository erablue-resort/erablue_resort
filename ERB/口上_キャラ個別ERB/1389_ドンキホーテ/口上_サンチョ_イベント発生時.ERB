;--------------------------------------------------
;キャラが現在いる場所で寝る時
@KOJO_EVENT_この場おやすみ_1389_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「おやすみなさい、%二人称_サンチョ_1389()%。……夜の番は私がします。安心して眠ってくださいね」
			KSTR:(K++) = %CALLNAME:対象キャラ%は眠る前に、%CALLNAME:PLAYER%の額にそっと口づけを落とした。
		CASE 1
			KSTR:(K++) = 「おやすみなさい。……%二人称_サンチョ_1389()%の寝息が聞こえる距離で眠れるのは、幸せなことですね」
		CASE 2
			IF DAY % 120 / 30 == 3
				KSTR:(K++) = 「冷えますね。……少しだけ、そちらに寄ってもいいですか？ 冷たくても、文句は言わないでくださいね」
			ELSE
				KSTR:(K++) = 「おやすみなさい。……寝言で私の名前を呼んだら、明日、からかって差し上げますね」
			ENDIF
	ENDSELECT
ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「おやすみなさい。……寝込みを襲われたくなければ、鍵はかけておいたほうがいいですよ。ふふ」
		CASE 1
			KSTR:(K++) = 「おやすみなさい。今夜は大人しくしておきます。……物足りなかったら、起こしてくださって構いませんよ」
	ENDSELECT
ELSE
	IF CFLAG:対象キャラ:現在位置 == 303 && CFLAG:対象キャラ:現在マップ種別 == 0
		;メインテントで寝る
		KSTR:(K++) = 「テントの中は暗くて落ち着きますね。おやすみなさい、%二人称_サンチョ_1389()%」
	ELSEIF CFLAG:対象キャラ:現在マップ種別 == 999
		;部屋で寝る
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「おやすみなさい。カーテンは、しっかり閉めておきますね。朝日は苦手なので」
			CASE 1
				KSTR:(K++) = 「今日もお疲れさまでした。おやすみなさい、%二人称_サンチョ_1389()%。よい夢を」
		ENDSELECT
	ELSE
		;その他の場所
		KSTR:(K++) = 「少し、ここで休みます。おやすみなさい、%二人称_サンチョ_1389()%」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


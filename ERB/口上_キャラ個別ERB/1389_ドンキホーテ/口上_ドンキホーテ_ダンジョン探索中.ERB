;--------------------------------------------------
;ダンジョン探索中に条件を満たしていた時表示される文章
;--------------------------------------------------
;2026-10-12：仲間と会話・チェンバ・逃走を記入し、奥義・トドメ・戦闘勝利・全滅は本体の台詞を残したまま候補を足した。
;サンチョのスタイル中はドンキホーテの台詞を出さない（スタイル設計案の決定）。各関数の先頭で CSTR:スタイル管理文字列 を見て抜ける。

;--------------------------------------------------
;「仲間と会話」ボタン押下時
;簡単に何度も見られるので、条件分岐やランダム化で複数パターンの登録を推奨
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_1389(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使う（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ) && EXISTFUNCTION("KOJO_DUNGEON_仲間と会話_1389_サンチョ")
	TRYCALLFORM KOJO_DUNGEON_仲間と会話_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
;この関数があると汎用口上_仲間と会話が呼ばれないため、サンチョ中は汎用を呼んでから抜ける
IF CSTR:対象キャラ:スタイル管理文字列 == "[第二眷属]サンチョ"
	CALL 汎用口上_仲間と会話(対象キャラ)
	RETURN 0
ENDIF

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

;ダンジョン別の会話（ハル子と同じく ダンジョン名 で分岐）。対応するダンジョンでは半分の確率でこちらを出し、残りは下の共通の会話
LOCAL:3 = 0
IF RAND:2 == 0
	LOCAL:3 = 1
	SELECTCASE ダンジョン名
		CASE "名前を亡くした遺跡"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「名もなき遺跡！ かつてここにも、名だたる騎士が眠っておったやもしれぬのだ！」
				CASE 1
					WSTR:(K++) = 「この壁画、騎空艇に見えませぬか？ む、ただの染み？
					WSTR:(K++) = 　いや、浪漫とは自分で見出すものなのだ！」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「%二人称_1389()%、崩れやすい床がありますゆえ、_一人称_の後ろを歩いてくだされ。
						WSTR:(K++) = 　い、いや、隣でも構いませぬが！」
					ELSE
						WSTR:(K++) = 「罠の気配！ 騎士の勘がそう告げておる！ %二人称_1389()%、下がっておられよ！」
					ENDIF
			ENDSELECT
		CASE "バルツ地下廃工場"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「がしゃん、ごしゃん！ 機械の音が鳴り響いておるのだ！ ロシナンテも負けじと、かしゃん！」
				CASE 1
					WSTR:(K++) = 「あ、あついのだ……。鎧を着ておらぬのが、せめてもの救いであるな……」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「%二人称_1389()%、額に煤がついておりますぞ。ほれ、じっとしていてくだされ」
					ELSE
						WSTR:(K++) = 「あの巨大な歯車！ 騎空艇の心臓部もかくやであるな！ 一つ持って帰れませぬか？」
					ENDIF
			ENDSELECT
		CASE "深海の古戦場跡"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「古戦場！ ここで幾多の勇士が槍を交えたのでありまするな。当人、身が引き締まる思いである！」
				CASE 1
					WSTR:(K++) = 「海の底を歩けるとは！ 騎空士も、ここまでは来ておるまい！ いや、来ておるのだろうか？」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「お魚がたくさん！ %二人称_1389()%、あの二匹、ぴったり寄り添って泳いでおりますぞ。まるで_一人称_と……
						WSTR:(K++) = 　い、いや、何でもないのだ！」
					ELSE
						WSTR:(K++) = 「あの大きな魚の背に乗れば、海の騎士になれるやもしれぬ！ たのもう！ む、逃げられたのだ」
					ENDIF
			ENDSELECT
		CASE "風遊ぶ渓谷の参道"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「風が気持ち良いのだ！ 旗があれば、ここに立てて正義の拠点にするところである！」
				CASE 1
					WSTR:(K++) = 「ロシナンテなら、この程度の坂、ひとっ跳び……ぜぇ、はぁ……。ひ、ひとっ跳びなのだ……」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「%二人称_1389()%、見てくだされ、絶景ですぞ！ 今だけは、我らの貸し切りであるな！」
					ELSE
						WSTR:(K++) = 「この参道の先には、何が祀られておるのでしょうな！ 伝説の槍だったら、当人が抜いてみせまする！」
					ENDIF
			ENDSELECT
		CASE "奈落の大空洞", "異界と化した洞窟"
			SELECTCASE RAND:3
				CASE 0
					WSTR:(K++) = 「やっほー！ おお、こだまが返ってきたのだ！ やっほー！ やっほー！」
				CASE 1
					WSTR:(K++) = 「この深さ、まさに奈落なのだ！ 落ちたら、騎空艇でも拾いに来られぬであろうな！」
				CASE 2
					IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
						WSTR:(K++) = 「暗いですな。%二人称_1389()%、はぐれぬよう、その、手を……！
						WSTR:(K++) = 　せ、正義の味方としての提案である！」
					ELSE
						WSTR:(K++) = 「暗がりから魔物が出てきても、_一人称_が成敗してしんぜよう！ %二人称_1389()%は灯りを頼みますぞ！」
					ENDIF
			ENDSELECT
		CASEELSE
			LOCAL:3 = 0
	ENDSELECT
ENDIF

;共通の会話
IF LOCAL:3 == 0
	SELECTCASE RAND:9
		CASE 0
			WSTR:(K++) = 「この先に宝箱の気配がするのだ！ 騎士の勘である！
			WSTR:(K++) = 　む、昨日もそう言って空っぽだった？ あれは宝箱の方が悪いのだ！」
		CASE 1
			WSTR:(K++) = 「名だたる騎空士たちも、こうして薄暗い洞窟を進んだのでしょうな！
			WSTR:(K++) = 　同じ道を歩いておると思うと、胸が高鳴るのだ！」
		CASE 2
			WSTR:(K++) = 「デェンジョン！ なんと甘美な響きか！ 当人、こういう場所を待っておったのだ！」
		CASE 3
			WSTR:(K++) = 「ロシナンテの調子は上々ですぞ！ 段差も水たまりも、ひとっ飛びなのだ！
			WSTR:(K++) = 　天井が低い所だけは、少々気をつけねばなりませぬが」
		CASE 4
			WSTR:(K++) = 「%二人称_1389()%、腹は減っておりませぬか？ _一人称_はこっそりとパンを持ってきたのだ！
			WSTR:(K++) = 　む？ 鞄の底で、ぺしゃんこになっておる……」
		CASE 5
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				WSTR:(K++) = 「%二人称_1389()%、そこは足元が滑るのだ！ ほれ、手を！
				WSTR:(K++) = 　い、いや、危ないからである！ 他意はありませぬぞ！」
			ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
				WSTR:(K++) = 「%二人称_1389()%、肩に蜘蛛の巣がついておりますぞ。ほれ、取れた！
				WSTR:(K++) = 　ついでに、その寝癖も直してしんぜよう！」
			ELSE
				WSTR:(K++) = 「%二人称_1389()%！ 後ろは_一人称_に任されよ！ 背中を守るのは騎士の務めなのだ！」
			ENDIF
		CASE 6
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				WSTR:(K++) = 「この探索が終わったら、%二人称_1389()%の話を聞かせてくだされ。
				WSTR:(K++) = 　今は騎空士の英雄譚よりも、%二人称_1389()%の話が聞きたいのです」
			ELSE
				WSTR:(K++) = 「帰ったら、騎空士の英雄譚の続きを読むのだ！
				WSTR:(K++) = 　嵐の中を騎空艇が突っ切る場面で止まっておってな！ 続きが気になって、夜も眠れぬのである！」
			ENDIF
		CASE 7
			LOCAL:2 = GETCHARA(1384)
			IF LOCAL:2 > -1 && キャラ隊列検索(LOCAL:2) > -1
				WSTR:(K++) = 「%二人称_1389(LOCAL:2)%！ 見てくだされ、この岩肌！ 絵の題材にいかがですかな！」
				NSTR:(K++) = ++++
				切り替え名前:0 = %CALLNAME:(LOCAL:2)%
				切り替え顔グラリソース:0 = 探索用_{キャラ隊列検索(LOCAL:2)}_顔
				WSTR:(K++) = 「ただの岩だ。……いや、光の当たり方は悪くないな。そこを動くな」
			ELSE
				WSTR:(K++) = 「ふむ、静かですな。静かすぎるのだ。
				WSTR:(K++) = 　これは、強敵が待ち構えておる気配！ 腕が鳴りますぞ！」
			ENDIF
		CASE 8
			WSTR:(K++) = 「%二人称_1389()%！ あそこで迷子のスライムが震えておるのだ！ 正義の味方として放ってはおけぬ！
			WSTR:(K++) = 　え、あれは敵でありまするか？ むむ……せめて向こうから攻撃するまで待っても……」
			WSTR:(K++) = 言い切る前に、ドンキホーテはスライムに追突された。
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0)


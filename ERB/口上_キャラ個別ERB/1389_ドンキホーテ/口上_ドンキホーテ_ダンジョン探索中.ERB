	TRYCALLFORM KOJO_DUNGEON_奥義発動時_1389_サンチョ(対象キャラ, 使用奥義名)
	RETURN RESULT
ENDIF
SIF CSTR:対象キャラ:スタイル管理文字列 == "[第二眷属]サンチョ"
	RETURN 0

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

;CASE 0 は本体にあった台詞
SELECTCASE RAND:3
	CASE 0
		KSTR:(K++) = 「走れロシナンテ！ 正義は勝つ！」
	CASE 1
		KSTR:(K++) = 「ロ～シナンテ、全速前進！ 正義の蹄の音を聞くがよい！」
	CASE 2
		KSTR:(K++) = 「今こそ見せよう、騎士の本懐！ 当人に続けぇ！」
ENDSELECT

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0)

;--------------------------------------------------
;チェンバースト発動時
;「チェインバースト！」（フルチェイン！）よりも前に表示される
;該当キャラが起点になった時（＝ターンで最初に奥義を撃った）にしか呼ばれないので注意
;--------------------------------------------------
@KOJO_DUNGEON_チェンバ発動時_1389(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使う（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ) && EXISTFUNCTION("KOJO_DUNGEON_チェンバ発動時_1389_サンチョ")
	TRYCALLFORM KOJO_DUNGEON_チェンバ発動時_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
SIF CSTR:対象キャラ:スタイル管理文字列 == "[第二眷属]サンチョ"
	RETURN 0

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

;掛け合いの作り方
;ZZZZ = 掛け合い相手のCSVに記載してあるキャラ番号とする
;と記述すると下に一個、掛け合い相手の顔グラと名前が表示されたメッセージ欄を増やせるので、そこで掛け合いを行う
;複数個メッセージ欄を増やす場合、切り替え顔グラリソース:1、切り替え名前:1のように配列番号を１つずつ増やすこと

LOCAL:2 = GETCHARA(1384)
IF LOCAL:2 > -1 && キャラ隊列検索(LOCAL:2) > -1 && RAND:2 == 0
	KSTR:(K++) = 「%二人称_1389(LOCAL:2)%！ 合わせてくだされ！ 正義と芸術の合体技である！」
	NSTR:(K++) = ++++
	切り替え名前:0 = %CALLNAME:(LOCAL:2)%
	切り替え顔グラリソース:0 = 探索用_{キャラ隊列検索(LOCAL:2)}_顔
	KSTR:(K++) = 「勝手に名前を付けるな。……まあいい、合わせてやる」
ELSE
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「皆の者、続くのだ！ 正義の一斉突撃である！」
		CASE 1
			KSTR:(K++) = 「チェェインバァァスト！ 騎空士の皆々も、こうして力を合わせたのだ！」
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ)


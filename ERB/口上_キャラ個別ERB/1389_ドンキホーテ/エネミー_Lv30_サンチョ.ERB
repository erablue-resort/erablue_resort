;--------------------------------------------------
;キャライベント「もう一つの姿」専用の敵：Lv30 サンチョ
;updated: 2026-10-12
;
;数値はLv25とLv35のボス（ヒトミダケ、火霊バルトロメウス）の中間を目安にした仮の値。
;行動はサンチョ_戦闘仕様書.mdの技を簡略化したもの。テストプレイで調整する。
;　戦闘開始：硬血（攻撃力アップ）
;　HP1/2以下：硬血2式（ランダム6回攻撃）
;　チャージ技：亜流2式（単体4回攻撃）
;立ち絵は、サンチョの画像を追加するまでドンキホーテの画像を使う。
;--------------------------------------------------
@敵BATTLE_STATE_Lv30_サンチョ(対象エネミー)
#DIM 対象エネミー
#DIM 対象キャラ
敵BATTLE_STATE:対象エネミー:Lv = 30
敵BATTLE_STATE:対象エネミー:最大ＨＰ = 38000
敵BATTLE_STATE:対象エネミー:ＨＰ = 38000
敵BATTLE_STATE:対象エネミー:攻撃力 = 1050
敵BATTLE_STATE:対象エネミー:防御力 = 950
敵BATTLE_STATE:対象エネミー:回復力 = 0
敵BATTLE_STATE:対象エネミー:行動速度 = 880
敵BATTLE_STATE:対象エネミー:DA率 = 30
敵BATTLE_STATE:対象エネミー:TA率 = 20
敵BATTLE_STATE:対象エネミー:命中率 = 110
敵BATTLE_STATE:対象エネミー:回避率 = 10
;闇属性
敵BATTLE_STATE:対象エネミー:属性 = 5
敵BATTLE_STATE:対象エネミー:所持EXP = 3000
敵BATTLE_STATE:対象エネミー:所持ルピ = 0
敵BATTLE_STATE:対象エネミー:最大チャージターン = 3

敵BATTLE_STATE:対象エネミー:ボスフラグ = 1
敵BATTLE_STATE:対象エネミー:ランダム不許可フラグ = 1

敵BATTLE_STATE_STR:対象エネミー:種族 = 人型

対象キャラ = GETCHARA(1389)
IF 対象キャラ >= 0
	SIF EXIST画像FILE(@"%CSTR:対象キャラ:画像フォルダ%/顔_デフォルト")
		敵BATTLE_STATE_STR:対象エネミー:ボス画像 = %CSTR:対象キャラ:画像フォルダ%/顔_デフォルト
ENDIF

@敵討伐後処理_Lv30_サンチョ(隊列番号)
#DIM 隊列番号
;ドロップなし

;--------------------------------------------------
;セリフ表示（顔グラ付き）
;--------------------------------------------------
@エネミー_サンチョ台詞_1389(台詞)
#DIMS 台詞
#DIM 対象キャラ
対象キャラ = GETCHARA(1389)
CALL 口上変数初期化
WSTR:(K++) = %台詞%
IF 対象キャラ >= 0
	CALLF 顔グラ表示用文字列関数(対象キャラ, 100,,,1,1)
	CALL メッセージ欄表示用関数(立ち絵リソース記録, "サンチョ",,0)
ELSE
	CALL メッセージ欄表示用関数(, "サンチョ",,0)
ENDIF
CALL 口上変数初期化

@敵トリガー行動_Lv30_サンチョ

IF GETBIT(敵BATTLE_STATE:(戦闘行動キャラ - 10):トリガー行動フラグ, 0) == 0
	;初手：硬血
	CALL エネミー_サンチョ台詞_1389("「では、参ります。……お覚悟を」")

	アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%の硬血！
	アビ汎用文字列:実行時メッセージ２ = 凝り固まった力が、全身を巡る……！
	アビテンプレート用_アビ名 = 硬血

	CALL アビ対象選択テンプレート_自己のみ
	アビ汎用変数:特殊表示オプション = 1
	アビ汎用変数:消去不可オプション = 1
	アビ汎用変数:効果割合 = 50
	アビ汎用文字列:バフ・デバフ枠 = 硬血
	アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_バフ効果セット

	SETBIT 敵BATTLE_STATE:(戦闘行動キャラ - 10):トリガー行動フラグ, 0
	RETURN 1
ELSEIF 敵BATTLE_STATE:(戦闘行動キャラ - 10):ＨＰ < 敵BATTLE_STATE:(戦闘行動キャラ - 10):最大ＨＰ / 2 && GETBIT(敵BATTLE_STATE:(戦闘行動キャラ - 10):トリガー行動フラグ, 1) == 0
	;HP1/2以下：硬血2式
	CALL エネミー_サンチョ台詞_1389("「はあ……手加減は、ここまでにいたしましょう」")

	アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%の硬血2式！
	アビテンプレート用_アビ名 = 硬血2式
	;味方からランダムに合計6回
	CALL アビ対象選択テンプレート_味方ランダムＸ体(6)
	アビ汎用変数:効果割合 = 80
	CALL アビテンプレート_ダメージ処理_自属性

	SETBIT 敵BATTLE_STATE:(戦闘行動キャラ - 10):トリガー行動フラグ, 1
	RETURN 1
ENDIF
RETURN 0

@敵チャージ行動_Lv30_サンチョ
#DIM 回数

CALL エネミー_サンチョ台詞_1389("「目を逸らさないでくださいね。一度きりですから」")

アビテンプレート用_アビ名 = 亜流2式
アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%の奥義！
アビ汎用文字列:実行時メッセージ２ = ──亜流2式──

CALL アビ対象選択テンプレート_味方ランダムＸ体(1)
アビ汎用変数:効果割合 = 150
アビ汎用変数:命中率補正値 = 999
FOR 回数, 0, 4
	CALL アビテンプレート_ダメージ処理_自属性
NEXT

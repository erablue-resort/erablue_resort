;--------------------------------------------------
;サンチョ（1389のスタイル「[第二眷属]サンチョ」）用の寝取らせ夜這い関連口上。
;構成は 口上_ドンキホーテ_寝取らせ夜這い関連.ERB と同じ。関数名はドンキホーテ版の末尾に _サンチョ を付ける。
;ドンキホーテ版の各関数の先頭で、サンチョ中かつ _サンチョ 版がある時だけこちらを呼ぶ。
;_サンチョ 版がない場面は今までどおり（汎用文・無言・ドンキホーテ版の処理）。
;空の関数でもあると「ある」扱いになり、ドンキホーテ側の代わりの処理が止まるので、
;本文を書く関数だけコメントを外して有効にすること。
;ドンキホーテ版に口上以外の処理（フラグ・数値の変更など）がある関数は、必要な処理もこちらに写すこと。
;--------------------------------------------------

;--------------------------------------------------
;話しかける相手はPLAYER（%二人称_サンチョ_1389()%）。連れてきた相手を台詞で呼ぶときは %二人称_サンチョ_1389(献上品キャラ)%、地の文は %CALLNAME:献上品キャラ%
;ドンキホーテ版と同じくRETURN 0（デフォルト文章も出す）。サンチョは「知っている側」なので性知識では分けない
@KOJO_EVENT_寝取らせ夜這い_訪問_1389_サンチョ(主導キャラ, 献上品キャラ)
#DIM 主導キャラ
#DIM 献上品キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(主導キャラ, PLAYER, "恋慕")
	;恋慕：いたずらの顔をしながら、%CALLNAME:PLAYER%の反応を確かめている
	KSTR:(K++) = 「夜分に失礼します、%二人称_サンチョ_1389()%。%二人称_サンチョ_1389(献上品キャラ)%が、どうしても眠れないそうで」
	KSTR:(K++) = %CALLNAME:主導キャラ%は%CALLNAME:献上品キャラ%の肩にそっと手を置き、%CALLNAME:PLAYER%の前へ押し出した。
	KSTR:(K++) = 「私は見ているだけです。……%二人称_サンチョ_1389()%が、ほかの人をどう抱くのか。一度、見てみたかったので」
	KSTR:(K++) = 微笑む唇の端から、小さな牙がのぞいていた。
ELSEIF 口上_陥落判定_1389(主導キャラ, PLAYER)
	;セフレなど：割り切って、見物を楽しむつもりでいる
	KSTR:(K++) = 「こんばんは、%二人称_サンチョ_1389()%。今夜は、お客様をお連れしました」
	KSTR:(K++) = 「%二人称_サンチョ_1389(献上品キャラ)%が、%二人称_サンチョ_1389()%と仲良くなりたいそうです。……ふふ、どういう意味かは、もうお分かりですね？」
ELSE
	;未陥落：頼まれて仲を取り持つつもりで来たが、少し落ち着かない
	KSTR:(K++) = 「夜分に申し訳ありません。%二人称_サンチョ_1389(献上品キャラ)%に、どうしてもと頼まれまして」
	KSTR:(K++) = %CALLNAME:主導キャラ%は丁寧に頭を下げたが、%CALLNAME:PLAYER%と目を合わせようとはしなかった。
	KSTR:(K++) = 「その……お二人の邪魔にならないよう、私は隅にいますので」
ENDIF

CALL 口上変数表示(主導キャラ, 0)
RETURN 0

;--------------------------------------------------
@KOJO_EVENT_寝取らせ夜這い_受諾_1389_サンチョ(主導キャラ, 献上品キャラ)
#DIM 主導キャラ
#DIM 献上品キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(主導キャラ, PLAYER, "恋慕")
	KSTR:(K++) = 「ありがとうございます。……では、特等席で」
	KSTR:(K++) = %CALLNAME:主導キャラ%は寝台の脇の椅子に腰かけ、脚を組んだ。
	KSTR:(K++) = 暗がりでもよく利くその目が、%CALLNAME:PLAYER%の一挙一動を、ひとつも逃さず追いかけていた。
ELSEIF 口上_陥落判定_1389(主導キャラ, PLAYER)
	KSTR:(K++) = 「話が早くて助かります。どうぞ、私のことはお気になさらず。……気になっても、構いませんけれど」
	KSTR:(K++) = %CALLNAME:主導キャラ%は寝台の足元に腰を下ろすと、楽しげに頬杖をついた。
ELSE
	KSTR:(K++) = 「承知しました。では、私は……あちらで、静かにしています」
	KSTR:(K++) = %CALLNAME:主導キャラ%は部屋の隅の暗がりに身を引いたが、二人から目をそらしきれずにいるようだった。
ENDIF

CALL 口上変数表示(主導キャラ, 0)
RETURN 0

;--------------------------------------------------
@KOJO_EVENT_寝取らせ夜這い_拒否_1389_サンチョ(主導キャラ, 献上品キャラ)
#DIM 主導キャラ
#DIM 献上品キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(主導キャラ, PLAYER, "恋慕")
	KSTR:(K++) = 「そうですか。……ふふ、そう仰ると思っていました」
	KSTR:(K++) = 断られたというのに、%CALLNAME:主導キャラ%はどこかほっとしたように目を細めた。
	KSTR:(K++) = 「%二人称_サンチョ_1389(献上品キャラ)%は、私がお部屋まで送ります。……戻ってきたら、今度は私の番ですからね」
ELSEIF 口上_陥落判定_1389(主導キャラ, PLAYER)
	KSTR:(K++) = 「おや、残念。%二人称_サンチョ_1389(献上品キャラ)%、今夜は私がお相手しましょうか。……冗談ですよ。半分は」
ELSE
	KSTR:(K++) = 「失礼しました。……%二人称_サンチョ_1389(献上品キャラ)%、帰りましょう。夜道は、私が送りますので」
ENDIF

CALL 口上変数表示(主導キャラ, 0)
RETURN 0

;--------------------------------------------------
;終了時の主導キャラの自慰テキスト。ドンキホーテ版と同じくRETURN 0
;自慰実処理（_サンチョ版）は書かない。ドンキホーテ版と同じくデフォルト処理を使う
@KOJO_EVENT_寝取らせ夜這い_寝取られオナニー口上_1389_サンチョ(オナニーキャラ, 寝取られキャラ)
#DIM オナニーキャラ
#DIM 寝取られキャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(オナニーキャラ, PLAYER, "恋慕")
	;恋慕：見ているだけと言った手前、自分の熱を抑えきれない
	KSTR:(K++) = 「はぁ……っ、%二人称_サンチョ_1389()%……_H_」
	KSTR:(K++) = 二人の寝息が聞こえ始めたころ、%CALLNAME:オナニーキャラ%は椅子の上で身を丸め、乱れた息を押し殺していた。
	KSTR:(K++) = 「見ているだけのつもりでしたのに。……喉が渇いて、仕方ありません……っ」
ELSEIF 口上_陥落判定_1389(オナニーキャラ, PLAYER)
	KSTR:(K++) = 「ふぅ……_H_　見ているだけで、こんなに昂るとは思いませんでした」
	KSTR:(K++) = %CALLNAME:オナニーキャラ%は汗ばんだ髪をかき上げると、寝台の二人に、満足げな流し目を送った。
ELSE
	KSTR:(K++) = 「ん……っ、だめです、こんな……。お二人が、すぐそこにいるのに……_H_」
	KSTR:(K++) = 部屋の隅の暗がりで、%CALLNAME:オナニーキャラ%は口元を押さえたまま、小さく肩を震わせていた。
ENDIF

CALL 口上変数表示(オナニーキャラ, 0)
RETURN 0


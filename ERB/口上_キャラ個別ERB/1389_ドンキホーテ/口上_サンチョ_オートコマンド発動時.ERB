;--------------------------------------------------
;サンチョ（1389のスタイル「[第二眷属]サンチョ」）用のオートコマンド発動時口上。
;構成は 口上_ドンキホーテ_オートコマンド発動時.ERB と同じ。関数名はドンキホーテ版の末尾に _サンチョ を付ける。
;ドンキホーテ版の各関数の先頭で、サンチョ中かつ _サンチョ 版がある時だけこちらを呼ぶ。
;_サンチョ 版がない場面は今までどおり（汎用文・無言・ドンキホーテ版の処理）。
;空の関数でもあると「ある」扱いになり、ドンキホーテ側の代わりの処理が止まるので、
;本文を書く関数だけコメントを外して有効にすること。
;ドンキホーテ版に口上以外の処理（フラグ・数値の変更など）がある関数は、必要な処理もこちらに写すこと。
;--------------------------------------------------

;--------------------------------------------------
;AUTOCOM3_遊びに誘ってくる（RFLAG:コマンド結果受渡し変数 が0以外ならおっぱいポロリ）
@KOJO_AUTOCOM_1389_3_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF RFLAG:コマンド結果受渡し変数
	;おっぱいポロリ時
	IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
		KSTR:(K++) = 「おや」
		KSTR:(K++) = 水着の紐がほどけたことに気づくと、%CALLNAME:対象キャラ%は慌てるでもなく、ゆっくりと胸元を腕で覆った。
		KSTR:(K++) = 「……見ましたね？ %二人称_サンチョ_1389()%以外には見せたくなかったので、まあ、よしとします」
	ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
		KSTR:(K++) = 「おや、ほどけてしまいました。……今さら隠すような仲でもありませんね」
		KSTR:(K++) = %CALLNAME:対象キャラ%は平然と紐を結び直しながら、%CALLNAME:PLAYER%の視線を面白そうに眺めている。
	ELSE
		KSTR:(K++) = 「わっ……！」
		KSTR:(K++) = %CALLNAME:対象キャラ%は小さな悲鳴を上げて水に沈むと、真っ赤な顔だけを水面から出した。
		KSTR:(K++) = 「……お忘れください。今すぐに。お願いですから」
	ENDIF
ELSE
	IF CFLAG:対象キャラ:現在マップ種別 == 0 && GROUPMATCH(CFLAG:対象キャラ:現在位置, 3, 303, 305)
		;庭・キャンプ系列
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、少し外を歩きませんか？ 木陰の道を選んでくださるなら、ですけれど。
			KSTR:(K++) = 　……日差しは、あまり得意ではないので。手を引いてくださると、もっとうれしいです」
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、お暇でしたら付き合ってくださいません？ 体を動かしたい気分なのです。
			KSTR:(K++) = 　……どういう意味で、かはお任せしますけれど」
		ELSE
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、よろしければ少しお散歩でも。
			KSTR:(K++) = 　普段の私のように駆け回ったりはしませんので、ご安心ください」
		ENDIF
	ELSEIF CFLAG:対象キャラ:現在マップ種別 == 0 && GROUPMATCH(CFLAG:対象キャラ:現在位置, 5, 503, 505, 504)
		;遊戯室系列
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「一勝負いかがです？ 負けた方が、勝った方のお願いを一つ聞く、ということで。
			KSTR:(K++) = 　……ふふ、私は何をお願いしましょうか」
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、カードでもいかが？ 賭けるものは……そうですね、今夜の主導権など」
		ELSE
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、お手合わせ願えますか？ こういう頭を使う遊びは、普段の私より得意なのです」
		ENDIF
	ELSEIF CFLAG:対象キャラ:現在マップ種別 == 0 && GROUPMATCH(CFLAG:対象キャラ:現在位置, 15, 1504, 1505, 1506)
		;プール系列
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、一緒に泳ぎませんか？ ……泳ぐのは、実はあまり得意ではないのです。
			KSTR:(K++) = 　ですから、手を離さないでくださいね」
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			KSTR:(K++) = 「せっかくの水着です。じっくり見るだけでなく、一緒に遊んでください」
		ELSE
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、少し水遊びにお付き合いいただけますか？ 一人で浮かんでいるのも、退屈でして」
		ENDIF
	ELSE
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、お手すきですか？ ……いえ、特に用事はありません。一緒にいたいだけです」
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、退屈していませんか？ 私は退屈です。何か、楽しいことをいたしましょう」
		ELSE
			KSTR:(K++) = 「%二人称_サンチョ_1389()%、少しお時間をいただけますか？ 気晴らしに、お付き合いいただければ」
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;AUTOCOM4_管理人を労う（従業員かどうかで分ける）
@KOJO_AUTOCOM_1389_4_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TALENT:対象キャラ:従業員
	IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「お疲れさまです、%二人称_サンチョ_1389()%。肩が凝っていますね。……ほら、じっとして」
				KSTR:(K++) = %CALLNAME:対象キャラ%の冷たい指が首筋に触れ、ゆっくりと凝りをほぐしていく。
				KSTR:(K++) = 「首のここ、脈が速いですよ。……ふふ、私の指のせいでしょうか」
			CASE 1
				KSTR:(K++) = 「働きすぎです。少し休んでください。……休まないのでしたら、膝枕で無理やり寝かせますよ？」
		ENDSELECT
	ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
		KSTR:(K++) = 「%二人称_サンチョ_1389()%、お疲れのようですね。疲れを取る方法でしたら、いくつか心得がありますけれど？」
	ELSE
		KSTR:(K++) = 「お疲れさまです、%二人称_サンチョ_1389()%。お茶を淹れてまいりました。少し休憩なさってください」
	ENDIF
ELSE
	IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
		KSTR:(K++) = 「毎日お忙しそうですね。……たまには、私に甘えてくださってもいいのですよ？」
		KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の頭を、子どもをあやすように優しく撫でた。
	ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
		KSTR:(K++) = 「いつもご苦労さまです。今夜は、私が労って差し上げましょうか。……隅々まで」
	ELSE
		KSTR:(K++) = 「いつもお疲れさまです。このリゾートは居心地がよくて、感謝しているのですよ。普段の私も、私も」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;AUTOCOM5_いちゃつく（恋慕レベルが関係閾値:5未満なら恋心パターン、以上なら恋慕50パターン）
@KOJO_AUTOCOM_1389_5_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF CFLAG:対象キャラ:恋慕レベル < 関係閾値:5
	;恋心パターン
	IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
		KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の隣に座ると、肩が触れる距離まで、そっと身を寄せた。
		KSTR:(K++) = 「……少しだけ、こうしていてもいいですか？ 理由は、聞かないでください」
	ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
		KSTR:(K++) = 「%二人称_サンチョ_1389()%、こちらへ。……いえ、何もしませんよ。今はただ、隣に座っていてほしいだけです」
	ELSE
		KSTR:(K++) = %CALLNAME:対象キャラ%は何か言いたげに%CALLNAME:PLAYER%を見つめたが、目が合うとすぐに視線をそらした。
		KSTR:(K++) = 「……何でもありません。普段の私の癖が、少し移ってしまったようです」
	ENDIF
ELSE
	;恋慕50パターン
	IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = %CALLNAME:対象キャラ%は後ろから%CALLNAME:PLAYER%を抱きしめ、首筋に唇を寄せた。
				KSTR:(K++) = 「……噛みませんよ。今日は、口づけだけ」
				KSTR:(K++) = 冷たい唇が、脈打つ場所を確かめるように、ゆっくりと肌の上をなぞっていった。
			CASE 1
				KSTR:(K++) = 「%二人称_サンチョ_1389()%、知っていました？ 普段の私が%二人称_1389(-1, 1)%を好きなのと同じくらい、私も好きなのですよ。
				KSTR:(K++) = 　……いいえ、少しだけ、私の方が上ですね」
		ENDSELECT
	ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
		KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の膝の上に、当然のように腰を下ろした。
		KSTR:(K++) = 「割り切った関係のつもりでしたのに。……最近、少し欲張りになってしまいました」
	ELSE
		KSTR:(K++) = 「%二人称_サンチョ_1389()%といると、胸の奥がざわつくのです。血が騒ぐのとは、少し違う感じで。
		KSTR:(K++) = 　……これは、何なのでしょうね」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)


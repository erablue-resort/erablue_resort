;--------------------------------------------------
;COM380_3_6 船着き場で釣りをする（RFLAG:コマンド結果受渡し変数 1:簡易釣りモード 2:ちゃんと釣りモード／RFLAG:コマンド結果受渡し変数２ 釣れた数 10以上:大漁 5以上:上々 0:ボウズ）
@KOJO_COM_1389_380_3_6_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数２
	CASE IS >= 10
		;大漁
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「次から次へと、かかりますね。……今日の海は、ずいぶん気前がいいようです」
				KSTR:(K++) = %CALLNAME:対象キャラ%はバケツいっぱいの魚を前に、涼しい顔で竿を上げ続けている。
			CASE 1
				KSTR:(K++) = 「これだけ釣れれば、今夜は皆さんで宴ですね。……%二人称_サンチョ_1389()%、バケツの片側をお願いします」
		ENDSELECT
	CASE IS >= 5
		;上々
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「潮の香りと、ほどよい釣果。……申し分のない一日ですね」
			CASE 1
				KSTR:(K++) = %CALLNAME:対象キャラ%は釣れた魚を一匹ずつ並べ、鱗の色を見比べている。
				KSTR:(K++) = 「海の魚は、川の魚より色が鮮やかですね。……どちらも、焼けば同じ色になりますけれど」
		ENDSELECT
	CASE IS > 0
		;普通
		IF RAND:2
			;季節：0春、1夏、2秋、3冬（1年120日、各30日）
			SELECTCASE DAY % 120 / 30
				CASE 0
					KSTR:(K++) = 「春の海は、穏やかですね。……魚まで、のんびりしているようです」
					KSTR:(K++) = %CALLNAME:対象キャラ%はようやくかかった一匹を、ゆっくりと引き上げた。
				CASE 1
					KSTR:(K++) = 「船着き場の板が、焼けるように熱いですね。……一匹釣れたので、今日はもう日陰に引き上げます」
				CASE 2
					KSTR:(K++) = 「秋は、魚が脂をのせる季節だそうです。……この子も、きっとおいしいですよ」
					KSTR:(K++) = %CALLNAME:対象キャラ%は小ぶりな魚を掲げ、夕日の色に染まる海を背に微笑んだ。
				CASE 3
					KSTR:(K++) = 「冬の海風は、身にしみますね。……私の手は、もともと冷たいので変わりませんけれど」
					KSTR:(K++) = %CALLNAME:対象キャラ%は凍えた様子もなく、釣れた一匹を手早くバケツへ移した。
			ENDSELECT
		ENDIF
		IF K == 0
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「小さくても、海の魚は海の魚です。ありがたくいただきましょう」
				CASE 1
					KSTR:(K++) = 「波の音を聞きながら待つのは、いいものですね。……釣れたのは、おまけのようなものです」
					KSTR:(K++) = %CALLNAME:対象キャラ%は船着き場の端に腰かけ、足をぶらぶらさせながら水面を眺めている。
			ENDSELECT
		ENDIF
	CASEELSE
		;釣果ゼロ
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「今日の海の魚は、私より一枚上手だったようですね」
				KSTR:(K++) = %CALLNAME:対象キャラ%は空のバケツを覗き込んでも、穏やかな表情を崩さなかった。
			CASE 1
				KSTR:(K++) = 「当たりはあったのです。……引き上げる前に、少し見とれてしまいまして」
				KSTR:(K++) = 何に見とれていたのかは言わず、%CALLNAME:対象キャラ%は夕暮れの水平線へ目を向けた。
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


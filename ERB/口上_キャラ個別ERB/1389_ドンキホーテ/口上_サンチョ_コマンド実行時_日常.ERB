			KSTR:(K++) = 「水着のまま酔うのは、さすがに危ないですね。……いろいろと、はだけてしまいそうですので」
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「せっかくですが、私は冷たいお茶をいただきます。日差しの下でお酒は、少し荷が重いので」
					KSTR:(K++) = %CALLNAME:対象キャラ%は海の家のいちばん奥の日陰に座り、グラスの氷を静かに鳴らしている。
				CASE 1
					KSTR:(K++) = 「皆さんでどうぞ。私は、かき氷を少しずついただくことにします。……普段の私のように、一気に食べて頭を抱えたりはしませんよ」
			ENDSELECT
		ENDIF
	CASE 1
		;飲み会を始める場合
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「乾杯。……潮風と、お酒と、%二人称_サンチョ_1389()%。今日は、贅沢な日ですね」
					KSTR:(K++) = %CALLNAME:対象キャラ%は日陰の席で%CALLNAME:PLAYER%に肩を寄せ、ゆっくりと杯を傾けた。
				CASE 1
					KSTR:(K++) = 「日焼けした首筋というのも、なかなか……いえ、お酒の肴の話です」
					KSTR:(K++) = %CALLNAME:対象キャラ%はとぼけた顔で、%CALLNAME:PLAYER%の首元から視線を外した。
			ENDSELECT
		ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
			KSTR:(K++) = 「乾杯。……水着でお酒というのは、いいですね。どこまで酔ったか、肌の色ですぐ分かります」
			KSTR:(K++) = %CALLNAME:対象キャラ%はほんのりと赤らんだ自分の胸元を指でなぞり、%CALLNAME:PLAYER%に目配せした。
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「では、乾杯。……海辺で飲むお酒は、少し塩の味がしますね」
				CASE 1
					KSTR:(K++) = 「普段の私が飲むと、砂浜で騒ぎ出しますからね。今日は私が、静かにいただきます」
					KSTR:(K++) = %CALLNAME:対象キャラ%は海を眺めながら、杯をゆっくりと口に運んだ。
			ENDSELECT

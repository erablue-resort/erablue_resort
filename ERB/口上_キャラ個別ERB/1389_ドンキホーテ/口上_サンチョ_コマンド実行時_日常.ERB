;--------------------------------------------------
;サンチョ（1389のスタイル「[第二眷属]サンチョ」）用のコマンド実行時_日常口上。
;構成は 口上_ドンキホーテ_コマンド実行時_日常.ERB と同じ。関数名はドンキホーテ版の末尾に _サンチョ を付ける。
;ドンキホーテ版の各関数の先頭で、サンチョ中かつ _サンチョ 版がある時だけこちらを呼ぶ。
;_サンチョ 版がない場面は今までどおり（汎用文・無言・ドンキホーテ版の処理）。
;空の関数でもあると「ある」扱いになり、ドンキホーテ側の代わりの処理が止まるので、
;本文を書く関数だけコメントを外して有効にすること。
;ドンキホーテ版に口上以外の処理（フラグ・数値の変更など）がある関数は、必要な処理もこちらに写すこと。
;2026-10-12：COM300～303・305・313・314・351・354～356・402・404・405・414・600・602～604を記入。ドンキホーテと同じく恋慕・セフレ（陥落判定）・未陥落で分ける（ユーザー指示）。
;　です・ます調で丁寧、たまに茶目っ気。ドンキホーテの恋慕時の台詞は「サンチョがドンキらしく喋っている台詞」として扱う（「あの騒がしい私」）。
;2026-10-12：拡充（ユーザー指示）。場所・仕事中・季節での変化を追加し、COM304と遊びのCOM380系も記入。
;　場所と仕事中は サンチョ場所判定_1389／サンチョ勤務中_1389（ファイル末尾）で分ける。同じ場所にいない時や未対応の場所では""が返り、どのCASEにも当たらない。
;　季節は DAY % 120 / 30（0春、1夏、2秋、3冬。1年120日、各30日）。
;　通常成功では、場所・仕事の台詞を80％で選び、なければ季節の台詞を50％で選び、それもなければ今までの汎用の台詞を出す（IF K == 0 で順に落とす）。
;--------------------------------------------------

;--------------------------------------------------
;COM300_会話（-1:失敗 0:通常成功 1:大成功 -2:会話しすぎ）
@KOJO_COM_1389_300_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
			;会話しすぎ。何も言わない
		CASE -1
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「申し訳ありません、少し考えごとをしておりました。
					KSTR:(K++) = 　……ええ、%二人称_サンチョ_1389()%のことではありませんよ。今回は」
				CASE 1
					KSTR:(K++) = 「その話の続きは、また今度にいたしましょう。
					KSTR:(K++) = 　今の私は、少々喉が渇いておりまして。……お茶の話ですよ？」
			ENDSELECT
		CASE 0
			;場所・仕事（80％）
			IF RAND:5
				SELECTCASE サンチョ場所判定_1389(対象キャラ)
					CASE "ロビー受付"
						KSTR:(K++) = 受付台の向こうで、%CALLNAME:対象キャラ%が宿泊名簿から顔を上げた。
						KSTR:(K++) = 「いらっしゃいませ、%二人称_サンチョ_1389()%。ご用件は……私とのおしゃべり、ですね？
						KSTR:(K++) = 　承りました。ほかのお客様がいらっしゃるまで、という条件付きですけれど」
					CASE "ロビー"
						KSTR:(K++) = 「%二人称_サンチョ_1389()%、こちらへどうぞ。日の当たらない、いい席を見つけておきました。
						KSTR:(K++) = 　ロビーは人の出入りが多くて、眺めているだけで飽きませんね。……今は、%二人称_サンチョ_1389()%しか見ていませんけれど」
					CASE "調理師"
						KSTR:(K++) = %CALLNAME:対象キャラ%は鍋をかき混ぜる手を止めずに、%CALLNAME:PLAYER%の方へ小皿を差し出した。
						KSTR:(K++) = 「味見をお願いできますか？ 自分の舌は、あまり信用していないのです。
						KSTR:(K++) = 　……血の味でしたら、誰よりも分かるのですけれど」
					CASE "給仕"
						KSTR:(K++) = 「ご注文はお決まりですか、%二人称_サンチョ_1389()%？
						KSTR:(K++) = 　本日のおすすめは、給仕係とのおしゃべりです。お代は結構ですよ。……今のところは」
					CASE "食堂"
						KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の皿をのぞき込み、くすりと笑った。
						KSTR:(K++) = 「好きなものを最後に取っておく方なのですね。覚えておきます。
						KSTR:(K++) = 　……ええ、%二人称_サンチョ_1389()%のことは、なるべくたくさん覚えておきたいので」
					CASE "プール監視員"
						KSTR:(K++) = 監視台の上の%CALLNAME:対象キャラ%は、日傘の影から少しだけ身を乗り出した。
						KSTR:(K++) = 「お話は伺いますが、目はプールから離せませんので。
						KSTR:(K++) = 　……溺れたふりはやめてくださいね。助けに飛び込んで、二人そろって沈むことになりますから」
					CASE "プール"
						KSTR:(K++) = %CALLNAME:対象キャラ%はプールサイドに腰かけ、足先だけを水に浸している。
						KSTR:(K++) = 「泳がないのか、ですか？ ……今日は眺める日なのです。%二人称_サンチョ_1389()%の泳ぐ姿を。
						KSTR:(K++) = 　決して、泳げないからではありませんよ。決して」
					CASE "海水浴場"
						KSTR:(K++) = %CALLNAME:対象キャラ%は大きなパラソルの下から、一歩も出ようとしない。
						KSTR:(K++) = 「海は好きですよ。眺めるのは。
						KSTR:(K++) = 　……日焼け止めを塗るのを手伝ってくださるなら、少しくらいは出てもいいのですけれど」
					CASE "船着き場"
						KSTR:(K++) = 「船の灯りが、水面に揺れていますね。
						KSTR:(K++) = 　長いあいだ、ああいう灯りを見送るばかりでした。今は隣に%二人称_サンチョ_1389()%がいてくださる。……いい眺めです」
					CASE "バーテンダー"
						KSTR:(K++) = %CALLNAME:対象キャラ%はグラスに赤い液体を注ぎ、%CALLNAME:PLAYER%の前に滑らせた。
						KSTR:(K++) = 「本日の特製です。……ご安心を、ただのベリーのお酒ですよ。
						KSTR:(K++) = 　中身を疑う顔をなさるのは、%二人称_サンチョ_1389()%くらいのものです」
					CASE "ディーラー"
						KSTR:(K++) = %CALLNAME:対象キャラ%は札を配りながら、%CALLNAME:PLAYER%にだけ聞こえる声でささやいた。
						KSTR:(K++) = 「私の顔色から手札を読もうとしても、無駄ですよ。
						KSTR:(K++) = 　……%二人称_サンチョ_1389()%の顔色でしたら、手に取るように分かりますけれど」
					CASE "バーエリア"
						KSTR:(K++) = 「夜のバーは落ち着きますね。昼間よりも、ずっと呼吸が楽です。
						KSTR:(K++) = 　……もう一杯、いかがです？ 酔わせて何をするつもりか、ですか？ ふふ、それは飲んでからのお楽しみです」
					CASE "温泉浴場"
						KSTR:(K++) = 湯けむりの向こうで、%CALLNAME:対象キャラ%が肩まで湯に沈んだ。
						KSTR:(K++) = 「熱いお湯は、血の巡りがよくなりすぎて困ります。……顔が赤いのは、お湯のせいですよ？
						KSTR:(K++) = 　%二人称_サンチョ_1389()%がそんなにじっと見るから、ではありません」
					CASE "温泉洗い場"
						KSTR:(K++) = 「背中、流しましょうか？ ……ええ、背中だけですよ。今のところは」
						KSTR:(K++) = %CALLNAME:対象キャラ%は泡立てた布を手に、楽しそうに%CALLNAME:PLAYER%の後ろへ回り込んだ。
					CASE "温泉脱衣所"
						KSTR:(K++) = 「おや、%二人称_サンチョ_1389()%。……そこで立ち止まられると、帯がほどけないのですが。
						KSTR:(K++) = 　手伝ってくださるのでしたら、話は別ですけれど」
					CASE "温泉ロビー"
						KSTR:(K++) = %CALLNAME:対象キャラ%は湯上がりの髪を手ぬぐいで押さえながら、冷たい牛乳の瓶を二本掲げてみせた。
						KSTR:(K++) = 「一本は%二人称_サンチョ_1389()%の分です。湯上がりにはこれだと、あの騒がしい私が力説していましたので」
					CASE "女子更衣室"
						KSTR:(K++) = 「%二人称_サンチョ_1389()%、この水着の紐を結んでいただけますか？ 背中は手が届かなくて。
						KSTR:(K++) = 　……ええ、ここは更衣室ですね。ですから、早くしないと誰かに見つかってしまいますよ？」
					CASE "サウナ"
						KSTR:(K++) = 「サウナは、我慢比べをする場所なのだそうですね。
						KSTR:(K++) = 　負けた方が、勝った方の言うことを一つ聞く。いかがです？ 私、熱さには強い方ですよ」
					CASE "キャンプファイアー"
						KSTR:(K++) = %CALLNAME:対象キャラ%は炎を見つめたまま、%CALLNAME:PLAYER%の肩にそっと頭を預けた。
						KSTR:(K++) = 「火の粉が、星に混ざっていきますね。……夜更かしの言い訳には、ちょうどいい眺めです」
					CASE "キャンプ場"
						KSTR:(K++) = 「テントを張るのは、%二人称_サンチョ_1389()%は得意ですか？
						KSTR:(K++) = 　あの騒がしい私が張ると、朝には必ず潰れているのです。今夜は二人用を、しっかり張りましょうね」
					CASE "知識習得"
						KSTR:(K++) = %CALLNAME:対象キャラ%は教本から目を上げ、%CALLNAME:PLAYER%に小さく手招きした。
						KSTR:(K++) = 「授業中ですので、小声でお願いします。……分からないところがあるのです。
						KSTR:(K++) = 　あとで、%二人称_サンチョ_1389()%の部屋で教えていただけますか？ 二人きりで、じっくりと」
					CASE "教師"
						KSTR:(K++) = 「%二人称_サンチョ_1389()%、質問は授業のあとで受け付けます。
						KSTR:(K++) = 　……個人授業をご希望でしたら、放課後に。課題は、少し厳しめにいたしますね」
					CASE "司書"
						KSTR:(K++) = 「お探しの本はございますか？ ……はい、図書室ではお静かに。
						KSTR:(K++) = 　ですから、こうして顔を寄せて話すしかありませんね。規則ですので、仕方がありません」
					CASE "図書室"
						KSTR:(K++) = %CALLNAME:対象キャラ%は書架のあいだで、古い本の背表紙を指でなぞっていた。
						KSTR:(K++) = 「古い本の匂いが好きなのです。長い時間が、そのまま閉じ込められているようで。
						KSTR:(K++) = 　……%二人称_サンチョ_1389()%の匂いの次に、ですけれど」
					CASE "美術館"
						KSTR:(K++) = 「この絵、%二人称_サンチョ_1389()%にはどう見えますか？
						KSTR:(K++) = 　私には、描いた人が誰かに恋をしていたように見えるのです。……鏡の中で、近ごろよく見る顔をしていますので」
					CASE "お祭り"
						KSTR:(K++) = 「お祭りの夜は、みんなの顔が明るくて、見ていて楽しいですね。
						KSTR:(K++) = 　はぐれないように、袖をつかんでいてもいいですか？ ……%二人称_サンチョ_1389()%がはぐれないように、ですよ」
					CASE "警備員"
						KSTR:(K++) = 「見回りの途中ですので、歩きながらでよろしければ。
						KSTR:(K++) = 　夜の見回りは得意なのです。暗がりもよく見えますし、怪しい人もすぐ分かります。……たとえば、今ここにいる人とか」
					CASE "訓練"
						KSTR:(K++) = %CALLNAME:対象キャラ%は汗を拭いながら、木剣を下ろした。
						KSTR:(K++) = 「見学ですか？ ……あまり見つめられると、太刀筋が乱れてしまいます。
						KSTR:(K++) = 　いえ、乱れていいのでしたら、いくらでも見ていてください」
					CASE "仕事中"
						KSTR:(K++) = 「%二人称_サンチョ_1389()%、今は仕事中ですよ。……ですが、少しだけでしたら。
						KSTR:(K++) = 　あとで手伝ってくださるなら、ですけれど。ふふ、取引成立ですね」
				ENDSELECT
			ENDIF
			;季節（50％）
			IF K == 0 && RAND:2
				SELECTCASE DAY % 120 / 30
					CASE 0
						KSTR:(K++) = 「春の夜は、空気が甘い気がしますね。花の匂いでしょうか。
						KSTR:(K++) = 　夜桜を見に行きませんか、%二人称_サンチョ_1389()%。昼のお花見は、あの騒がしい私にお任せしますので」
					CASE 1
						KSTR:(K++) = 「夏は苦手です。日は長いし、夜は短いし。
						KSTR:(K++) = 　……ですから、短い夜はなるべく%二人称_サンチョ_1389()%と過ごしたいのです。理屈は通っているでしょう？」
					CASE 2
						KSTR:(K++) = 「秋は、夜が少しずつ長くなっていくでしょう。私の一番好きな季節です。
						KSTR:(K++) = 　読書の秋、食欲の秋……%二人称_サンチョ_1389()%は、何の秋にしますか？ 私は、%二人称_サンチョ_1389()%の秋にしようかと」
					CASE 3
						KSTR:(K++) = %CALLNAME:対象キャラ%は、冷えた指先を%CALLNAME:PLAYER%の首筋にそっと当てた。
						KSTR:(K++) = 「冷たいでしょう？ 冬になると、ますます冷えてしまうのです。
						KSTR:(K++) = 　ですから、温めてくださる人が必要で。……ほかの人には頼めませんので、お願いしますね」
				ENDSELECT
			ENDIF
			IF K == 0
				SELECTCASE RAND:5
					CASE 0
						KSTR:(K++) = 「%二人称_サンチョ_1389()%、今日はどのようなご予定ですか？
						KSTR:(K++) = 　お邪魔でなければ、私もご一緒させてください。……お邪魔でも、ついて行きますけれど」
					CASE 1
						KSTR:(K++) = 「あの騒がしい私と、今の私。%二人称_サンチョ_1389()%はどちらがお好みですか？
						KSTR:(K++) = 　……ふふ、意地悪な質問でしたね。答えなくて結構ですよ。顔に書いてありますから」
					CASE 2
						KSTR:(K++) = %CALLNAME:PLAYER%が最近読んだ本の話をすると、%CALLNAME:対象キャラ%は静かに耳を傾けた。
						KSTR:(K++) = 「英雄譚ばかりでは飽きてしまいますからね。今度、私のおすすめもお貸ししましょう。
						KSTR:(K++) = 　少し、血なまぐさい話ですが」
					CASE 3
						KSTR:(K++) = 「最近、よく眠れていますか？ 目の下に、うっすら影がありますよ。
						KSTR:(K++) = 　……そんなに顔を近づけて見ていたのか、ですか？ ええ、見ていましたとも」
					CASE 4
						KSTR:(K++) = 「『%二人称_1389(-1, 1)%、聞いてくだされ！ 今日は大発見があったのだ！』
						KSTR:(K++) = 　……と、普段の私なら言うところですね。大発見は特にありません。お話ししたかっただけです」
				ENDSELECT
			ENDIF
		CASE 1
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = %CALLNAME:PLAYER%の冗談に、%CALLNAME:対象キャラ%は思わず口元を押さえて吹き出した。
					KSTR:(K++) = 「ふ、ふふっ……失礼しました。こんなに笑ったのは、いつ以来でしょう。
					KSTR:(K++) = 　%二人称_サンチョ_1389()%といると、どうも調子が狂いますね。……悪い意味ではありませんよ」
				CASE 1
					KSTR:(K++) = 話し込むうちに、気づけばずいぶん時間が経っていた。
					KSTR:(K++) = 「おや、もうこんな時間。%二人称_サンチョ_1389()%とお話ししていると、時間を忘れてしまいます。
					KSTR:(K++) = 　長く生きていると、時間など余るほどあるはずなのですけれど」
			ENDSELECT
	ENDSELECT
ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
	;セフレなど（恋慕以外の陥落）
	SELECTCASE RFLAG:コマンド結果受渡し変数
		CASE -2
		CASE -1
			KSTR:(K++) = 「今日はおしゃべりの気分ではないのです。……体の方でしたら、お付き合いしますけれど？」
		CASE 0
			;場所・仕事（80％）
			IF RAND:5
				SELECTCASE サンチョ場所判定_1389(対象キャラ)
					CASE "ロビー受付", "調理師", "給仕", "プール監視員", "バーテンダー", "ディーラー", "教師", "司書", "警備員", "仕事中"
						KSTR:(K++) = 「今は仕事中ですので、お話だけですよ。
						KSTR:(K++) = 　……そんな顔をなさらなくても。終わったら、たっぷりお相手しますから」
					CASE "訓練"
						KSTR:(K++) = 「休憩中でしたら、少しだけ。……体を動かしたあとは、どうも別の運動がしたくなりますね」
					CASE "食堂"
						KSTR:(K++) = 「精のつくものを選んでおきました。……誰のためか、は言わなくても分かりますね？」
						KSTR:(K++) = %CALLNAME:対象キャラ%は山盛りの皿を、%CALLNAME:PLAYER%の前に押しやった。
					CASE "バーエリア"
						KSTR:(K++) = 「一杯どうです？ 酔った%二人称_サンチョ_1389()%は素直で、可愛らしいので。……ええ、褒めていますよ」
					CASE "温泉浴場", "温泉洗い場"
						KSTR:(K++) = %CALLNAME:対象キャラ%は湯の中を滑るように、%CALLNAME:PLAYER%のすぐ隣まで寄ってきた。
						KSTR:(K++) = 「ここでは、何もしませんよ。……ここでは、ですけれど」
					CASE "サウナ"
						KSTR:(K++) = 「暑いですね。……タオル一枚でこんなに近くにいると、変な気分になりませんか？ 私はなります」
					CASE "プール", "海水浴場"
						KSTR:(K++) = 「この水着、どうです？ 少し布が足りない気もしますけれど。
						KSTR:(K++) = 　……%二人称_サンチョ_1389()%の目つきを見る限り、正解だったようですね」
					CASE "キャンプ場", "キャンプファイアー"
						KSTR:(K++) = 「今夜はテントで休むのですか？ ……壁が布一枚というのは、声に気をつけないといけませんね」
					CASE "図書室"
						KSTR:(K++) = 「図書室ではお静かに、ですよ。……ですから、声が出るようなことはなさらないでくださいね？」
				ENDSELECT
			ENDIF
			;季節（50％）
			IF K == 0 && RAND:2
				SELECTCASE DAY % 120 / 30
					CASE 0
						KSTR:(K++) = 「春は、どうも体がうずきますね。季節のせいにできるのは、便利なものです」
					CASE 1
						KSTR:(K++) = 「暑いですね。……薄着の%二人称_サンチョ_1389()%を眺められるのは、夏のいいところですけれど」
					CASE 2
						KSTR:(K++) = 「夜が長くなってきましたね。長い夜の使い道、何かいい案はありますか？ ……ふふ、私には一つしか思いつきません」
					CASE 3
						KSTR:(K++) = 「寒い日は、人肌が恋しくなりますね。……%二人称_サンチョ_1389()%、今夜は空いています？」
				ENDSELECT
			ENDIF
			IF K == 0
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「%二人称_サンチョ_1389()%、昨日はよく眠れました？ 私はぐっすりでした。
						KSTR:(K++) = 　……誰かさんのおかげで、ほどよく疲れていましたので」
					CASE 1
						KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の隣に腰を下ろすと、遠慮なく肩にもたれかかった。
						KSTR:(K++) = 「お話でしたら、この姿勢で伺います。楽なので」
					CASE 2
						KSTR:(K++) = 「あの騒がしい私が、%二人称_サンチョ_1389()%の話をよくしているのですよ。
						KSTR:(K++) = 　何を話しているかは……ふふ、内緒です」
				ENDSELECT
			ENDIF
		CASE 1
			KSTR:(K++) = 気の置けない話にひとしきり笑ったあと、%CALLNAME:対象キャラ%は%CALLNAME:PLAYER%の膝を軽く叩いた。

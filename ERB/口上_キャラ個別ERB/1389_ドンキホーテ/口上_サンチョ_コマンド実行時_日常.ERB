				CASEELSE
					;通常成功
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「拾って、上げて、打つ。……順番を守れば、案外うまくいくものですね」
						CASE 1
							KSTR:(K++) = 「%二人称_サンチョ_1389()%、次は私が上げます。……ええ、打ちやすい所に」
							KSTR:(K++) = %CALLNAME:対象キャラ%の上げた球は、ちょうど打ちやすい高さにふわりと浮いた。
					ENDSELECT
			ENDSELECT
		CASE 5
			;スイカ割り
			SELECTCASE RFLAG:コマンド結果受渡し変数
				CASE IS < 0
					;失敗
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「右、ですか。……もう少し右。……ここですね」
							KSTR:(K++) = 目隠しの%CALLNAME:対象キャラ%が振り下ろした棒は、スイカの隣の砂を静かに叩いた。
						CASE 1
							KSTR:(K++) = 「目隠しをしていても、暗いのは平気なのですけれど。……方向は、別の話のようです」
							KSTR:(K++) = %CALLNAME:対象キャラ%は見当違いの方へ、迷いなく歩いていった。

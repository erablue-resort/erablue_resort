						CASE 0
							KSTR:(K++) = 「……ここです」
							KSTR:(K++) = %CALLNAME:対象キャラ%が迷いなく振り下ろした棒は、スイカを真っ二つに割った。
							KSTR:(K++) = 「音で分かりました。……どこを狙えばいいかは、得意分野ですので」
						CASE 1
							KSTR:(K++) = 声を頼りに何度も向きを直した末、%CALLNAME:対象キャラ%の一振りがスイカをきれいに割った。
							KSTR:(K++) = 「案内、ありがとうございました。……赤い果汁が、きれいですね」
					ENDSELECT

;--------------------------------------------------
;COM381_3_3 海水浴場でバーベキューする（RFLAG:コマンド結果受渡し変数 -2:大失敗 -1:失敗 0:通常成功 1:大成功／RFLAG:コマンド結果受渡し変数２ 焼いたキャラ）
@KOJO_COM_1389_381_3_3_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;RFLAG:コマンド結果受渡し変数２（焼いたキャラ）で、サンチョ自身・PLAYER・その他を分ける。
;焼き役がPLAYER以外の他人の時は、誰に向けた言葉か地の文で示す。
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;サンチョが焼いた
			KSTR:(K++) = 「海辺の火加減は、私が見ておきましょう」
			KSTR:(K++) = 潮風にあおられた炎は、%CALLNAME:対象キャラ%が見ている前で、網の上の食材を残らず炭に変えた。
			KSTR:(K++) = 「……見ているだけでは、だめだったようですね」
		ELSE
			;他の人が焼いた
			KSTR:(K++) = 「これは、ずいぶんと黒いですね。……潮風のせい、ということにしておきましょう」
			KSTR:(K++) = %CALLNAME:対象キャラ%は炭のような肉を一切れ、表情一つ変えずに口へ運んだ。
		ENDIF
	CASE -1
		;失敗
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;サンチョが焼いた
			KSTR:(K++) = 「少し焦げましたね。……香ばしい、と言い換えておきます」
		ELSE
			;他の人が焼いた
			KSTR:(K++) = 「多少焦げていても、海辺で食べると不思議とおいしいものですね」
		ENDIF
	CASE 0
		;通常成功
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「潮風の中で食べる焼き物は、格別ですね。%二人称_サンチョ_1389()%、こちらも焼けましたよ」
			CASE 1
				KSTR:(K++) = 「私は日陰の席でいただきます。焼き網の前は、日差しと炭火で挟み撃ちですので」
				KSTR:(K++) = %CALLNAME:対象キャラ%はパラソルの下から、皿だけをそっと差し出している。
		ENDSELECT
	CASEELSE
		;大成功
		IF RFLAG:コマンド結果受渡し変数２ == 対象キャラ
			;サンチョが焼いた
			KSTR:(K++) = 「……おいしく焼けました。潮風も、たまには味方してくれるのですね」
			KSTR:(K++) = %CALLNAME:対象キャラ%は焼き上がった串を、少しだけ得意げに%CALLNAME:PLAYER%へ差し出した。
		ELSEIF RFLAG:コマンド結果受渡し変数２ == PLAYER
			;PLAYERが焼いた
			IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
				KSTR:(K++) = 「%二人称_サンチョ_1389()%が焼いてくださったものは、どうしてこんなにおいしいのでしょう。
				KSTR:(K++) = 　……毎日焼いていただかないと、もう満足できなくなりそうです」
			ELSE
				KSTR:(K++) = 「%二人称_サンチョ_1389()%が焼いたのですか？ 見事な腕前ですね。……今度、焼き加減のこつを教えてください」
			ENDIF
		ELSE
			;その他の人が焼いた
			KSTR:(K++) = %CALLNAME:対象キャラ%は焼き役の%CALLNAME:(RFLAG:コマンド結果受渡し変数２)%に、丁寧に頭を下げた。
			KSTR:(K++) = 「とてもおいしいです、%二人称_サンチョ_1389(RFLAG:コマンド結果受渡し変数２)%。……普段の私にも、ぜひ教えてあげてください」
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM382_3_3 海水浴場で水鉄砲で遊ぶ（RFLAG:コマンド結果受渡し変数 15以上:ハイレベルな熱戦 10以上:激戦 6以上:バトルとして成立 3以上:カジュアルに楽しむ 2以下:敗北）
@KOJO_COM_1389_382_3_3_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE IS <= 2
		;敗北
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 波打ち際で足を取られたところに水を浴びせられ、%CALLNAME:対象キャラ%は砂浜に座り込んだ。
				KSTR:(K++) = 「……参りました。砂の上では、どうにも分が悪いですね」
			CASE 1
				KSTR:(K++) = 「日差しが眩しくて、狙いが……いえ、言い訳はやめておきます。私の負けです」
		ENDSELECT
	CASE IS <= 5
		;カジュアルに楽しむ
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「海の水は、しょっぱいですね。……口に入ってから気づきました」
			CASE 1
				KSTR:(K++) = %CALLNAME:対象キャラ%はのんびりと水鉄砲を構え、波の音に合わせるように引き金を引いている。
		ENDSELECT
	CASE IS <= 9
		;水鉄砲バトルとして成立
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「波を盾にする、というのはどうでしょう。……ええ、余計に濡れるだけですね」
			CASE 1
				KSTR:(K++) = %CALLNAME:対象キャラ%はパラソルの陰に身を隠し、相手が近づいたところを正確に撃ち抜いた。
				KSTR:(K++) = 「日陰から出たくないだけですよ。作戦ではありません」
		ENDSELECT
	CASE IS <= 14
		;激戦
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「砂浜を駆け回りながらの撃ち合い……思っていたより、ずっと疲れますね」
				KSTR:(K++) = %CALLNAME:対象キャラ%は息を弾ませながらも、構えた銃口だけはぶれていない。
			CASE 1
				KSTR:(K++) = 「今のは効きました。……では、こちらも少し本気で」
		ENDSELECT
	CASEELSE
		;ハイレベルな熱戦
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「ここまで渡り合えるとは思いませんでした。……%二人称_サンチョ_1389()%、いい好敵手ですね」
				KSTR:(K++) = 二人は最後の一滴まで撃ち合い、そろって砂浜に倒れ込んだ。
			CASE 1
				KSTR:(K++) = %CALLNAME:対象キャラ%は空になった水鉄砲を海に浸して補給しながら、楽しそうに笑った。
				KSTR:(K++) = 「海が相手では、弾切れの心配がありませんね。……決着がつくまで、続けましょうか」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;COM402 就寝（あなたが寝る時、一緒にいるキャラが喋る）
@KOJO_COM_1389_402_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
	IF CFLAG:対象キャラ:睡眠 == 0
		IF RAND:2
			;季節（50％）
			SELECTCASE DAY % 120 / 30
				CASE 0
					KSTR:(K++) = 「春の夜は、眠ってしまうのがもったいないくらいですね。
					KSTR:(K++) = 　おやすみなさいませ、%二人称_サンチョ_1389()%。窓は少しだけ開けておきます。花の匂いがしますから」
				CASE 1
					KSTR:(K++) = 「暑くて寝苦しいでしょう？ ……私がそばにいると、少しひんやりしますよ。
					KSTR:(K++) = 　どうぞ、抱き枕にしてください。今夜だけの特別な貸し出しです」
				CASE 2
					KSTR:(K++) = 「夜が長くなりましたね。%二人称_サンチョ_1389()%が眠っているあいだも、私はずっと起きていられます。
					KSTR:(K++) = 　……退屈はしませんよ。寝顔がありますから」
				CASE 3
					KSTR:(K++) = 「冷えますから、毛布をもう一枚。……それとも、私が入りましょうか？
					KSTR:(K++) = 　冷たいので、湯たんぽの代わりにはなりませんけれど。ほかのことでしたら、温めて差し上げられます」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「おやすみなさいませ、%二人称_サンチョ_1389()%。
					KSTR:(K++) = 　夜は私の時間ですから、どうぞ安心してお休みください。……寝顔は、しっかり見張っておきますね」
				CASE 1
					KSTR:(K++) = %CALLNAME:対象キャラ%は寝台の端に腰かけ、%CALLNAME:PLAYER%の髪をゆっくりと撫でた。
					KSTR:(K++) = 「子守唄でも歌いましょうか？ ……それとも、眠れなくなるようなことの方がよろしいですか？」
				CASE 2
					KSTR:(K++) = 「首元が冷えますよ。毛布をきちんと掛けてください。
					KSTR:(K++) = 　……そんなに無防備に首を出していると、悪い血鬼に噛まれてしまいますから」
			ENDSELECT
		ENDIF
	ENDIF
ELSEIF 口上_陥落判定_1389(対象キャラ, PLAYER)
	;セフレなど（恋慕以外の陥落）
	IF CFLAG:対象キャラ:睡眠 == 0
		IF RAND:2 && DAY % 120 / 30 == 3
			KSTR:(K++) = 「もうお休みですか？ こんなに寒い夜に、一人で眠るおつもりで？ ……入れてくださいよ」
		ELSE
			KSTR:(K++) = 「もうお休みですか？ ……まだ夜は長いですよ。眠る前に、もう少し付き合っていただけません？」
		ENDIF
	ENDIF
ELSE
	;未陥落
	IF CFLAG:対象キャラ:睡眠 == 0
		IF RAND:2 && DAY % 120 / 30 == 3
			KSTR:(K++) = 「冷えますので、毛布をもう一枚お持ちしました。では、おやすみなさいませ、%二人称_サンチョ_1389()%」
		ELSE
			KSTR:(K++) = 「おやすみなさいませ、%二人称_サンチョ_1389()%。夜の番は私がいたしますので、ご安心を」
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM404 覗く（覗かれていることには気づいていない。隠れて覗いた時だけ、ときどき気配に勘づく）
;サンチョは羞恥心がドンキホーテより高い（スタイル設計案）ので、一人のときは無防備だが、見られていると気づくと照れる。
@KOJO_COM_1389_404_サンチョ(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 1, 2
		;1:脱衣所・更衣室から反対側を覗く　2:脱衣所・更衣室に隠れて覗く
		IF CFLAG:PLAYER:現在マップ種別 == 3
			LOCAL = 13
		ELSE
			LOCAL = CFLAG:PLAYER:現在位置
		ENDIF
		SELECTCASE LOCAL
			CASE 7, 8
				;服を脱いでいる
				KSTR:(K++) = %CALLNAME:対象キャラ%が、背中の留め具を一つずつ外していく。
				KSTR:(K++) = 脱いだ服を丁寧に畳む指先も、白い背中に落ちる髪の影も、どこか絵画のように静かだった。
			CASE 9, 11
				;浴場。RFLAG:コマンド結果受渡し変数３　0:湯船に浸かる姿　1:体を洗う姿
				IF RFLAG:コマンド結果受渡し変数３ == 0
					KSTR:(K++) = %CALLNAME:対象キャラ%は湯船の縁に頭を預け、目を閉じている。
					KSTR:(K++) = 湯に浮かんだ長い髪がゆらりと揺れ、上気した肌がほんのりと赤く染まっていた。
					KSTR:(K++) = 「……ふう。熱いお湯は、血の巡りがよくなりすぎて困りますね」
				ELSE
					KSTR:(K++) = %CALLNAME:対象キャラ%は泡立てた布で、首筋から肩へとゆっくり肌をなぞっている。
					KSTR:(K++) = 湯気の向こうで、しなやかな背中を一筋のしずくが伝い落ちていった。
				ENDIF

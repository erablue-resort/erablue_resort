; ドンキホーテ（1389）・固有奥義 v1.0.0
; updated: 2026-09-27
; ラ・サングレ・デ・サンチョ
; 敵単体への自属性ダメージ後、自身のHPと奥義ゲージを回復する。
; 威力はLv16で400％から480％、Lv32で520％になる。
; HP回復は回復力の50％。奥義ゲージは基本20％（上昇効率の補正あり）。
; 通常の奥義ダメージとゲージ消費は共通処理に任せる。
; 台詞は既存のKOJO_DUNGEON_奥義発動時_1389を利用する。

@固有奥義_1389(ARGS, キャラ番号)
#DIM キャラ番号
#DIM DYNAMIC 奥義威力
#DIM DYNAMIC L_SELF
#DIM DYNAMIC L_ACTION_TARGET
#DIM DYNAMIC L_TARGETS, アビ対象最大数

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 32
    奥義威力 = 520
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 16
    奥義威力 = 480
ELSE
    奥義威力 = 400
ENDIF

SELECTCASE ARGS
    CASE "奥義名"
        TSTR:コマンド名受渡 = ラ・サングレ・デ・サンチョ
    CASE "奥義説明文", "奥義説明文_詳細"
        詳細文文字列受け渡し変数 '= @"奥義威力：{奥義威力}％<br>敵単体に自属性の［{奥義威力}％］ダメージを与える。"
        詳細文文字列受け渡し変数 += @"<br>攻撃後、自身のHPを［回復力×50％］回復し、奥義ゲージを［20％/上昇効率の補正あり］回復する。"
        RETURN 奥義威力
    CASE "奥義前効果"
        CALL アビ汎用変数文字列リセット
    CASE "奥義追加効果"
        L_SELF = キャラ隊列検索(キャラ番号)
        SIF !INRANGE(L_SELF, 0, 3)
            RETURN 0
        SIF BATTLE_STATE:L_SELF:ＨＰ < 1
            RETURN 0

        ; 耳飾りなどの後続効果が元の奥義対象に適用されるよう保存する。
        ARRAYCOPY "アビテンプレート用_対象保存", "L_TARGETS"
        L_ACTION_TARGET = 戦闘行動対象

        CALL アビ汎用変数文字列リセット
        CALL アビ対象選択テンプレート_指定(L_SELF)
        アビ汎用変数:効果割合 = 50
        ; 満HPでも奥義をキャンセル扱いにしない。
        CALL アビテンプレート_回復処理_MAXでも回復

        CALL アビ汎用変数文字列リセット
        CALL アビ対象選択テンプレート_指定(L_SELF)
        ; 効果割合は現在ゲージに掛かるため、基本20％の加算には効果量を使う。
        アビ汎用変数:効果量 = 20
        CALL アビテンプレート_有利効果_奥義ゲージUP

        ARRAYCOPY "L_TARGETS", "アビテンプレート用_対象保存"
        戦闘行動対象 = L_ACTION_TARGET
ENDSELECT
RETURN 0

;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_EVENT_仕事訪問_1389_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_EVENT_仕事訪問_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
	;恋慕（80％。外れたら下の関係共通へ）。両方の素質がある場合もこちらを優先。
	IF RAND:5
		KSTR:(K++) = 「なるほど、そうすればよいのだな！ さすがは%二人称_1389()%！
		KSTR:(K++) = 　実は、教わるのを口実に顔を見に来たのです。では、持ち場に戻りまする！」
	ENDIF
ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ") && RAND:5
	;恋慕なしのセフレ（80％）。下ネタが悪意なく混ざる。
	KSTR:(K++) = 「なるほど！ %二人称_1389()%は教え方が上手ですな。分からぬことがあったら、また真っ先に聞きに来まする！
	KSTR:(K++) = 　では、当人は持ち場に戻りますゆえ！」
ENDIF

IF K == 0
	;関係共通（恋慕・セフレの枠に外れた時もここ）
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「なるほど、そうすればよいのだな！ さすがは%二人称_1389()%、頼りになりまするな！
			KSTR:(K++) = 　では、当人は持ち場に戻りますゆえ！」
		CASE 1
			KSTR:(K++) = 「そうすればよかったのか！ 教えていただき感謝いたす！ _一人称_、忘れぬうちに書いておきまする！」
			KSTR:(K++) = ドンキホーテは手帳に書き留めると、もう一度頷いて持ち場へ戻った。
		CASE 2
			KSTR:(K++) = 「よし、次に同じことで困ったら試してみまする！ 当人、勢いだけで仕事を進めてはならぬと学んだぞ！」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;うふふお誘い承諾時
;--------------------------------------------------
@KOJO_EVENT_うふふ誘い承諾_1389(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_EVENT_うふふ誘い承諾_1389_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_EVENT_うふふ誘い承諾_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化
;RSTR:コマンド結果受渡し文字列 に着てきた服が入っている
;通常、セクシーランジェリー、裸リボンが該当
;ドンキホーテがPLAYERの部屋に誘いに来て、PLAYERが応じた時。陥落（恋慕・セフレ）していて性欲が溜まっている時に起きる。無知でも起きる。
SELECTCASE RSTR:コマンド結果受渡し文字列
	CASE "セクシーランジェリー"
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「ど、どうでありまするか……？ %二人称_1389()%に見せたくて、その、着てきたのです……」
			KSTR:(K++) = ドンキホーテは上着の前をおずおずと開き、真っ赤な顔で%CALLNAME:PLAYER%の反応をうかがっている。
		ELSEIF 知識素質:対象キャラ:性知識 < 0
			KSTR:(K++) = 「見てくだされ、%二人称_1389()%！ 店の方に『修練にはこれが一番』と勧められたのだ！」
			KSTR:(K++) = ドンキホーテは薄い下着姿のまま、得意げにくるりと回ってみせた。
			KSTR:(K++) = 「動きやすさは、正直いまひとつでありまするが！」
		ELSE
			KSTR:(K++) = 「ふふん、どうです！ 今宵は勝負服で参りましたぞ！」
			KSTR:(K++) = ドンキホーテは下着姿で腰に手を当て、堂々と胸を張った。
		ENDIF
	CASE "裸リボン"
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「贈り物は、心を込めて包むものだと、本に書いてあったので……」
			KSTR:(K++) = 裸の体にリボンだけを巻いたドンキホーテは、もじもじと膝をすり合わせた。
			KSTR:(K++) = 「ほ、ほどくのは、%二人称_1389()%にお任せいたしまする……_H_」
		ELSEIF 知識素質:対象キャラ:性知識 < 0
			KSTR:(K++) = 「本日の贈り物は、当人である！ と言えばよいと、ある方に教わったのだ！」
			KSTR:(K++) = ドンキホーテはリボンを体に巻いただけの格好で、大真面目に胸を張っている。
			KSTR:(K++) = 「して、贈り物とは、このあとどうするのです？」
		ELSE
			KSTR:(K++) = 「贈り物の配達である！ 中身は当人！ 返品は受け付けませぬぞ！」
		ENDIF
	CASEELSE
		;通常
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			KSTR:(K++) = 「よ、よかった……。断られたらどうしようかと、扉の前で三回も引き返したのです」
			KSTR:(K++) = ドンキホーテはほっとしたように笑うと、%CALLNAME:PLAYER%の袖をきゅっとつまんだ。
		ELSEIF 知識素質:対象キャラ:性知識 < 0
			KSTR:(K++) = 「では、今宵も修練をお願いいたしまする！ _一人称_、日々の鍛錬は欠かさぬ主義なのだ！」
			KSTR:(K++) = ドンキホーテの言う修練とは、裸で抱き合うあれのことだ。本人は今でも、体を鍛える稽古の一つだと信じている。
		ELSE
			KSTR:(K++) = 「話が早いですな！ 今宵は体がうずいて、眠れそうになかったのだ！」
			KSTR:(K++) = ドンキホーテは返事もそこそこに、%CALLNAME:PLAYER%の手を引いて寝台へ向かうと、自分からさっさと服を脱ぎ始めた。
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


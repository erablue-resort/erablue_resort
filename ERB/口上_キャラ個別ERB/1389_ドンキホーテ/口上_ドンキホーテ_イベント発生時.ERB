	SIF !EXISTFUNCTION("KOJO_一日終了時オナニー_1389_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_一日終了時オナニー_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

;一日の終わりに一人で。独り言として書く。恋慕なら主人公（MASTER）のことを思い浮かべる。
SELECTCASE RCVAR:対象キャラ:オナニー結果保存
	CASE -1
		;無知ゆえにオナニーがわからず悶々としている
		KSTR:(K++) = 「むむ、体の奥が、なにやらむずむずするのだ」
		KSTR:(K++) = ドンキホーテは寝台の上で、何度も寝返りを打っている。
		KSTR:(K++) = 「風邪、ではないな。熱はない。ええい、英雄譚でも読んで気を紛らわせるとしよう！」
	CASE 1
		;通常オナニー
		IF 口上_関係性判定_1389(対象キャラ, MASTER, "恋慕")
			KSTR:(K++) = 「ん……っ、%二人称_1389(MASTER)%……」
			KSTR:(K++) = 布団にくるまったドンキホーテの口から、小さな声が漏れた。
			KSTR:(K++) = 「い、今のは寝言である。誰も聞いておらぬな？」
		ELSE
			KSTR:(K++) = 「ふう。これも明日の英気を養うための、立派な修練なのだ」
			KSTR:(K++) = ドンキホーテは誰にともなく言い訳をしながら、布団の中で身じろぎした。
		ENDIF
	CASE 2
		;母乳搾りオナニー
		KSTR:(K++) = 「胸が張って眠れぬのだ。少し、絞っておかねば」
		KSTR:(K++) = ドンキホーテは顔を赤くしながら、そっと胸元に手を伸ばした。
	CASE 3
		;覚えたてオナニー
		KSTR:(K++) = 「こ、この新しく覚えた修練、どうにもやめどきが分からぬのだ」
		KSTR:(K++) = 布団の中で、ドンキホーテは今夜もこっそりと、覚えたばかりの行為にふけっていた。
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)



;--------------------------------------------------
;ドンキホーテ（1389）のスタイル変化
;第2スタイル「[第二眷属]サンチョ」を登録する。
;設計：project-files「サンチョ_スタイルチェンジ設計案.md」（2026-10-12確定）
;updated: 2026-10-12
;
;解禁条件：キャライベント「サンチョ」で、Lv30のサンチョに勝利する
;　（キャライベント_サンチョ.ERB）。一度解禁すれば自由に切り替えられる。
;
;特定状況口上用フラグ:1389の使い方（0～99は口上側で自由に使える枠）
;　0　　　サンチョ解禁済み（1で解禁）
;　1　　　退避の状態　bit0：ドンキホーテ側を退避済み　bit1：サンチョ側の初期値を設定済み
;　10～37 ドンキホーテ側の値の退避先
;　40～67 サンチョ側の値の退避先
;
;切り替える値は、切り替えのたびに現在値を退避して戻す。
;プレイ中に変わった値も、それぞれのスタイルで保たれる。
;サンチョの初期値はここに直書きするため、サンチョのCSV（1518）を消しても動く。
;
;サンチョ専用のアビリティ・奥義・パッシブ「硬血」は 固有アビリティ_ドンキホーテ_サンチョ.ERB。
;--------------------------------------------------

;--------------------------------------------------
;スタイル名の定数と判定
;--------------------------------------------------
@サンチョスタイル名_1389()
#FUNCTIONS
RETURNF "[第二眷属]サンチョ"

@サンチョ中_1389(対象キャラ)
#FUNCTION
#DIM 対象キャラ
SIF 対象キャラ < 0 || 対象キャラ >= CHARANUM
	RETURNF 0
RETURNF CSTR:対象キャラ:スタイル管理文字列 == サンチョスタイル名_1389()

@サンチョ解禁済み_1389(対象キャラ)
#FUNCTION
#DIM 対象キャラ
SIF 対象キャラ < 0 || 対象キャラ >= CHARANUM
	RETURNF 0
RETURNF 特定状況口上用フラグ:対象キャラ:0 == 1

;--------------------------------------------------
;サンチョのセリフ用の二人称
;2026-10-12ユーザー指示：名無しの主人公（呼び名が「あなた」）は「貴方」、それ以外は「呼び名＋さん」。
;ドンキホーテの %二人称_1389()% もサンチョ中はこの関数を返す。
;相手キャラを省略するとPLAYER。セリフでは %二人称_サンチョ_1389(相手)% と書く。
;--------------------------------------------------
@二人称_サンチョ_1389(相手キャラ = -1)
#FUNCTIONS
#DIM 相手キャラ

SIF 相手キャラ < 0
	相手キャラ = PLAYER
SIF 相手キャラ < 0 || 相手キャラ >= CHARANUM
	RETURNF "貴方"
SIF CALLNAME:相手キャラ == "あなた"
	RETURNF "貴方"
RETURNF CALLNAME:相手キャラ + "さん"

;--------------------------------------------------
;サンチョ用の画像フォルダ（resources/1389サンチョ）があるか
;画像を追加するまでは、ドンキホーテの画像を使う（2026-10-12ユーザー決定）。
;--------------------------------------------------
@サンチョ画像あり_1389(対象キャラ)
#FUNCTION
#DIM 対象キャラ
RETURNF EXIST画像FILE(@"{NO:対象キャラ}サンチョ/顔_デフォルト")

;--------------------------------------------------
;スタイル変更基礎関数
;--------------------------------------------------
@スタイル変更_1389(対象キャラ, 動作モード)
#DIM 対象キャラ
#DIMS 動作モード

SELECTCASE 動作モード
	CASE "スタイル名取得"
		VARSET RESULTS
		RESULTS:0 = %NAME:対象キャラ%
		RESULTS:10 = ノーマル

		IF サンチョ解禁済み_1389(対象キャラ)
			RESULTS:1 = [第二眷属]サンチョ
			RESULTS:11 = サンチョ
		ENDIF

		;ダンジョン内では最大HPが変わる切り替えをさせない。今のスタイルだけを一覧に出す（2026-10-12 ユーザー指示）
		;ダンジョン表示モードはイベント戦闘のあと拠点でも残るので、ダンジョン名で判定する
		IF ダンジョン名 != ""
			IF サンチョ中_1389(対象キャラ)
				RESULTS:0 =
				RESULTS:10 =
			ELSE
				RESULTS:1 =
				RESULTS:11 =
			ENDIF
		ENDIF
	CASE @"スタイル解説_%NAME:対象キャラ%"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += @"■%NAME:対象キャラ%<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "通常のスタイル。闇属性。得意武器は槍。<br>"
		TSTR:スタイル解説 += "装備したジョブの証に応じて、第2・第3アビリティが変化する。<br>"
		TSTR:スタイル解説 += "<br>"
		CALL スタイル奥義アビ表示_汎用文章(対象キャラ, NAME:対象キャラ)
	CASE "スタイル解説_[第二眷属]サンチョ"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += "■[第二眷属]サンチョ<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "落ち着いた物腰の、もう一つの姿。闇属性。得意武器は槍と格闘。<br>"
		TSTR:スタイル解説 += "最大ＨＰは通常の75％。<br>"
		TSTR:スタイル解説 += "ダンジョン内ではスタイルを切り替えられない。<br>"
		TSTR:スタイル解説 += "性格・体格・好みが切り替わる。知識・能力・関係性は共有する。<br>"
		TSTR:スタイル解説 += "<br>"
		CALL スタイル奥義アビ表示_汎用文章(対象キャラ, "[第二眷属]サンチョ")
	CASE "変更後処理"
		;メニューで選んだ後、スタイル管理文字列は既に新しい値になっている
		IF サンチョ中_1389(対象キャラ)
			CALL サンチョ切り替え_1389(対象キャラ)
		ELSE
			CALL ドンキホーテ切り替え_1389(対象キャラ)
		ENDIF
ENDSELECT

;--------------------------------------------------
;スタイル変更時、戦闘ステータス変動
;装備再計算時に呼ばれる。補正は加算式。
;--------------------------------------------------
@スタイルステータス補正_第二眷属_サンチョ(対象キャラ)
#DIM 対象キャラ

;最大ＨＰは素のステータスの75％（装備で増えた分は減らさない。2026-10-12ユーザー決定）
装備ステータス補正保存:対象キャラ:最大ＨＰ -= 基礎BATTLE_STATE:対象キャラ:最大ＨＰ / 4

;属性はドンキホーテと同じ闇のため変更しない

;--------------------------------------------------
;切り替える素質の一覧（退避枠の順番）
;--------------------------------------------------
@サンチョ切り替え素質名_1389(番号)
#FUNCTIONS
#DIM 番号
SELECTCASE 番号
	CASE 0
		RETURNF "羞恥心"
	CASE 1
		RETURNF "態度"
	CASE 2
		RETURNF "早寝"
	CASE 3
		RETURNF "早起き"
	CASE 4
		RETURNF "マイペース"
	CASE 5
		RETURNF "会話資質"
	CASE 6
		RETURNF "精神的余裕"
	CASE 7
		RETURNF "無関心"
	CASE 8
		RETURNF "プライド"
	CASE 9
		RETURNF "自制心"
	CASE 10
		RETURNF "感情乏しい"
	CASE 11
		RETURNF "陽気／陰気"
	CASE 12
		RETURNF "目立ちたがり"
	CASE 13
		RETURNF "一線越えない"
	CASE 14
		RETURNF "楽観的"
	CASE 15
		RETURNF "感情的"
	CASE 16
		RETURNF "情熱的"
	CASE 17
		RETURNF "豪快"
	CASE 18
		RETURNF "戦闘好き"
	CASE 19
		RETURNF "献身的"
	CASE 20
		RETURNF "汚臭耐性"
	CASE 21
		RETURNF "薬毒耐性"
	CASE 22
		RETURNF "酒に強い"
	CASE 23
		RETURNF "年齢層"
	CASE 24
		RETURNF "外見年齢"
	CASE 25
		RETURNF "体格"
ENDSELECT
RETURNF ""

;サンチョの初期値（サンチョCSV 1518 の値）
@サンチョ初期素質_1389(番号)
#FUNCTION
#DIM 番号
SELECTCASE 番号
	CASE 0
		;羞恥心
		RETURNF 1
	CASE 5
		;会話資質
		RETURNF -1
	CASE 7
		;無関心
		RETURNF 1
	CASE 8
		;プライド
		RETURNF 1
	CASE 9
		;自制心
		RETURNF 2
	CASE 10
		;感情乏しい
		RETURNF 1
	CASE 11
		;陽気／陰気
		RETURNF -1
	CASE 13
		;一線越えない
		RETURNF 1
	CASE 14
		;楽観的
		RETURNF -1
	CASE 15
		;感情的
		RETURNF -1
	CASE 16
		;情熱的
		RETURNF -1
	CASE 20
		;汚臭耐性
		RETURNF -1
	CASE 21
		;薬毒耐性
		RETURNF 1
	CASE 22
		;酒に強い
		RETURNF -1
	CASE 23
		;年齢層
		RETURNF 16
	CASE 24
		;外見年齢
		RETURNF 11
ENDSELECT
RETURNF 0

;--------------------------------------------------
;退避と適用
;枠の並び：素質26個、身長、得意武器（計28枠）
;--------------------------------------------------
@サンチョ値退避_1389(対象キャラ, 先頭)
#DIM 対象キャラ
#DIM 先頭
#DIM 番号
FOR 番号, 0, 26
	特定状況口上用フラグ:対象キャラ:(先頭 + 番号) = TALENT:対象キャラ:(GETNUM(TALENT, サンチョ切り替え素質名_1389(番号)))
NEXT
特定状況口上用フラグ:対象キャラ:(先頭 + 26) = BASE:対象キャラ:身長
特定状況口上用フラグ:対象キャラ:(先頭 + 27) = 基礎BATTLE_STATE:対象キャラ:得意武器

@サンチョ値適用_1389(対象キャラ, 先頭)
#DIM 対象キャラ
#DIM 先頭
#DIM 番号
FOR 番号, 0, 26
	TALENT:対象キャラ:(GETNUM(TALENT, サンチョ切り替え素質名_1389(番号))) = 特定状況口上用フラグ:対象キャラ:(先頭 + 番号)
NEXT
SIF 特定状況口上用フラグ:対象キャラ:(先頭 + 26) > 0
	BASE:対象キャラ:身長 = 特定状況口上用フラグ:対象キャラ:(先頭 + 26)
SIF 特定状況口上用フラグ:対象キャラ:(先頭 + 27) > 0
	基礎BATTLE_STATE:対象キャラ:得意武器 = 特定状況口上用フラグ:対象キャラ:(先頭 + 27)

;--------------------------------------------------
;ドンキホーテ → サンチョ
;--------------------------------------------------
@サンチョ切り替え_1389(対象キャラ)
#DIM 対象キャラ
#DIM 番号

;ドンキホーテ側の現在値を退避する
CALL サンチョ値退避_1389(対象キャラ, 10)
SETBIT 特定状況口上用フラグ:対象キャラ:1, 0

;初めての切り替えでは、サンチョ側の初期値を作る
IF GETBIT(特定状況口上用フラグ:対象キャラ:1, 1) == 0
	FOR 番号, 0, 26
		特定状況口上用フラグ:対象キャラ:(40 + 番号) = サンチョ初期素質_1389(番号)
	NEXT
	特定状況口上用フラグ:対象キャラ:66 = 1600
	;得意武器：槍・格闘
	特定状況口上用フラグ:対象キャラ:67 = 0
	SETBIT 特定状況口上用フラグ:対象キャラ:67, 得意武器文字列数値変換("槍")
	SETBIT 特定状況口上用フラグ:対象キャラ:67, 得意武器文字列数値変換("格闘")
	SETBIT 特定状況口上用フラグ:対象キャラ:1, 1
ENDIF
CALL サンチョ値適用_1389(対象キャラ, 40)

CALLNAME:対象キャラ = サンチョ
CSTR:対象キャラ:二人称 = オーナー
CSTR:対象キャラ:服名称 = 従者の服
CSTR:対象キャラ:特殊種族 = 血鬼
CSTR:対象キャラ:プレゼント好み = 実用品
CSTR:対象キャラ:固有素質0 = 
CSTR:対象キャラ:固有素質1 = 

;画像：サンチョ用の画像フォルダがあるときだけ切り替える
IF サンチョ画像あり_1389(対象キャラ)
	CSTR:対象キャラ:スタイル変更前画像フォルダ '= CSTR:対象キャラ:画像フォルダ
	CSTR:対象キャラ:フォルダ判定キー = サンチョ
	CSTR:対象キャラ:画像フォルダ '= GET_RESOURCES_BASE_FOLDER(対象キャラ)
ENDIF

;--------------------------------------------------
;サンチョ → ドンキホーテ
;--------------------------------------------------
@ドンキホーテ切り替え_1389(対象キャラ)
#DIM 対象キャラ

;サンチョから戻るときだけ処理する（退避がなければ何もしない）
SIF GETBIT(特定状況口上用フラグ:対象キャラ:1, 0) == 0
	RETURN 0

CALL サンチョ値退避_1389(対象キャラ, 40)
CALL サンチョ値適用_1389(対象キャラ, 10)
CLEARBIT 特定状況口上用フラグ:対象キャラ:1, 0

CALLNAME:対象キャラ = %CSVCALLNAME(NO:対象キャラ)%
CSTR:対象キャラ:二人称 = %CSVCSTR(NO:対象キャラ, GETNUM(CSTR, "二人称"))%
CSTR:対象キャラ:服名称 = %CSVCSTR(NO:対象キャラ, GETNUM(CSTR, "服名称"))%
CSTR:対象キャラ:特殊種族 = %CSVCSTR(NO:対象キャラ, GETNUM(CSTR, "特殊種族"))%
CSTR:対象キャラ:プレゼント好み = %CSVCSTR(NO:対象キャラ, GETNUM(CSTR, "プレゼント好み"))%
CSTR:対象キャラ:固有素質0 = %CSVCSTR(NO:対象キャラ, GETNUM(CSTR, "固有素質0"))%
CSTR:対象キャラ:固有素質1 = %CSVCSTR(NO:対象キャラ, GETNUM(CSTR, "固有素質1"))%

IF CSTR:対象キャラ:フォルダ判定キー == "サンチョ"
	CSTR:対象キャラ:フォルダ判定キー '= CALLNAME:対象キャラ
	CSTR:対象キャラ:画像フォルダ '= GET_RESOURCES_BASE_FOLDER(対象キャラ)
	CSTR:対象キャラ:スタイル変更前画像フォルダ = 
ENDIF

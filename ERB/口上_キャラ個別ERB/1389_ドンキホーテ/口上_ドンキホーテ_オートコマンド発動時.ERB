@KOJO_AUTOCOM_1389_3(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("KOJO_AUTOCOM_1389_3_サンチョ")
		RETURN 0
	TRYCALLFORM KOJO_AUTOCOM_1389_3_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
;友人以上（好感度レベル２０以上）かつ友情度が最も高いキャラと、遊ぶ系の場所にいると発動
;場所の詳細は@ENJOYROOMを参照
;プール系、及び爆乳以上だとぽろりチャンス
;２時間に１回のみ発動
;おっぱいポロリ時
;通常時
;庭・キャンプ系列
;遊戯室系列
;プール系列
CALL 口上変数初期化

IF RFLAG:コマンド結果受渡し変数
	IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
		SELECTCASE RAND:1
			CASE 0
				KSTR:(K++) = ドンキホーテの水着の肩紐がずれて、胸がこぼれかけた。
				KSTR:(K++) = 「わわっ！ み、見ましたな！？」
				KSTR:(K++) = 慌てて胸元を押さえたドンキホーテは、%CALLNAME:PLAYER%の顔を見るなり、小さく笑った。
				KSTR:(K++) = 「%二人称_1389()%なら、まあ、よいのです」
		ENDSELECT
	ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
		SELECTCASE RAND:1
			CASE 0
				KSTR:(K++) = 胸がこぼれ出ているのも気にせず、ドンキホーテは浮き輪を抱えてはしゃいでいる。
				KSTR:(K++) = 「む？ ああ、ずれておりましたか！ どうせ%二人称_1389()%には見慣れたものでしょう！」
				KSTR:(K++) = ドンキホーテは笑いながら、片手で適当に水着を引っぱり上げた。
		ENDSELECT
	ELSE
		SELECTCASE RAND:1
			CASE 0
				KSTR:(K++) = 「おおっと！ 泳ぐのに夢中で、水着がずれてしまったようですな！」
				KSTR:(K++) = ドンキホーテは胸元を隠しもせず、堂々と水着を直した。恥じらいというものを、どこかに置き忘れているらしい。
		ENDSELECT
	ENDIF
ELSE
	IF CFLAG:対象キャラ:現在マップ種別 == 0 && GROUPMATCH(CFLAG:対象キャラ:現在位置, 3, 303, 305)
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「%二人称_1389()%、見てくだされ！ 花が咲いておるぞ！ %二人称_1389()%にも見せたかったのだ！」
					KSTR:(K++) = 一緒に花を眺めるうちに、ドンキホーテの目は、いつの間にか花ではなく%CALLNAME:PLAYER%の横顔に向いていた。
				CASE 1
					KSTR:(K++) = 「%二人称_1389()%、少し歩きませぬか？ 話したいことが、山ほどあるのです」
					KSTR:(K++) = 歩きながら話すうちに、ドンキホーテはいつの間にか%CALLNAME:PLAYER%の手を握っていた。気づいていないのか、気づかないふりをしているのか、手は最後まで離れなかった。
			ENDSELECT
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「その枝の先まで、どちらが先に着くか勝負ですぞ！ 合図は_一人称_が出す！ よーい、どん！」
					KSTR:(K++) = 合図と同時に、ドンキホーテはもう走り出していた。
					KSTR:(K++) = 「わははは！ 合図を出す者が一番に飛び出す、これぞ兵法である！」
				CASE 1
					KSTR:(K++) = 「あちらの茂みに、ちょうどよい日陰ができておる！ 少し休んでいきませぬか？ 人目もありませぬし！」
					KSTR:(K++) = 何をする気なのかと%CALLNAME:PLAYER%が尋ねると、ドンキホーテはきょとんとした。
					KSTR:(K++) = 「昼寝ですぞ？ %二人称_1389()%は、何を想像したのです？」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「%二人称_1389()%！ こちらの木から、あちらの木まで競走せぬか！ 当人、走りたくて仕方がないのだ！」
					KSTR:(K++) = 競走を始めると、ドンキホーテは自分で決めたゴールの木を、勢いよく通り過ぎていった。
				CASE 1
					KSTR:(K++) = 「%二人称_1389()%、葉の形を見比べに行きませぬか？ 騎空艇にそっくりな葉を見つけたのだ！」
					KSTR:(K++) = 一緒に見に行ってみると、ドンキホーテの指す葉が騎空艇に見えるには、少々想像力が必要だった。
			ENDSELECT
		ENDIF
	ELSEIF CFLAG:対象キャラ:現在マップ種別 == 0 && GROUPMATCH(CFLAG:対象キャラ:現在位置, 5, 503, 505, 504)
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「%二人称_1389()%、一勝負いかがですかな！ 負けた方は、勝った方の隣に一日座っていること！」
					KSTR:(K++) = どちらが勝っても隣に座ることになると%CALLNAME:PLAYER%が気づいたのは、勝負が終わってからだった。
				CASE 1
					KSTR:(K++) = 「勝ったら、_一人称_を褒めてくだされ！ 負けたら、慰めてくだされ！」
					KSTR:(K++) = 何戦か付き合ううちに、ドンキホーテは勝っても負けても、%CALLNAME:PLAYER%に頭を差し出してくるようになった。
			ENDSELECT
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「空いておるぞ！ %二人称_1389()%、一戦どうですかな？ 負けた方が、勝った方の肩を揉む、で！」
					KSTR:(K++) = ドンキホーテは返事も待たずに%CALLNAME:PLAYER%の隣へ椅子を寄せ、札を配り始めた。
				CASE 1
					KSTR:(K++) = 「さっきの手は覚えましたぞ！ 同じ手では、もう当人を破れぬ！」
					KSTR:(K++) = 意気込んで挑んだドンキホーテは、別の手にあっさり引っかかった。
					KSTR:(K++) = 「むむむ～！ %二人称_1389()%は、いつも搦め手ばかりですな！」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「次の一戦、_一人称_の相手をしてくれませぬか！ 今度こそ、規則は覚えましたぞ！」
					KSTR:(K++) = 対戦が始まると、ドンキホーテはさっそく手番を間違えた。
				CASE 1
					KSTR:(K++) = 「%二人称_1389()%、勝負である！ この一戦に勝てば、当人も英雄へ一歩近づけるはず！ いざ、尋常に！」
					KSTR:(K++) = 大仰な名乗りから始まった勝負は、終わる頃には二人とも笑いっぱなしだった。
			ENDSELECT
		ENDIF
	ELSEIF CFLAG:対象キャラ:現在マップ種別 == 0 && GROUPMATCH(CFLAG:対象キャラ:現在位置, 15, 1504, 1505, 1506)
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「%二人称_1389()%、手を引いてくだされ！ 浅いところでも、%二人称_1389()%と一緒なら安心なのです」
					KSTR:(K++) = 手をつないで浅瀬を歩くあいだ、ドンキホーテは一度も浮き輪の方を見なかった。
				CASE 1
					KSTR:(K++) = 「あっ、浮き輪が！ %二人称_1389()%、取ってきてくだされ！」
					KSTR:(K++) = 流された浮き輪を取って戻ると、ドンキホーテは礼を言いながら、浮き輪ではなく%CALLNAME:PLAYER%の腕につかまった。
					KSTR:(K++) = 「こちらの方が、沈みにくいのです！」
			ENDSELECT
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「浮き輪をこちらへ！ 二人で一つにつかまれば、ぴったりくっつけますな！」
					KSTR:(K++) = 浮き輪を挟んで、ドンキホーテは遠慮なく体を押しつけてきた。
				CASE 1
					KSTR:(K++) = 「水を掛けますぞ！ 防ぐ用意はよいか！ それっ！」
					KSTR:(K++) = 返り討ちに遭ったドンキホーテは、笑いながら%CALLNAME:PLAYER%に抱きついた。
					KSTR:(K++) = 「水着越しでも、%二人称_1389()%の体は温かいですな！」
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「見てくだされ！ 浮き輪があれば、当人も水上を進めるぞ！ さあ、%二人称_1389()%も一緒に！」
					KSTR:(K++) = 浮き輪につかまったドンキホーテは、ばた足で盛大に水しぶきを上げながら、ほとんど同じ場所にとどまっている。
				CASE 1
					KSTR:(K++) = 「%二人称_1389()%、水遊びをしませぬか！ 深いところへは行かぬゆえ！ 絶対に行かぬゆえ！」
					KSTR:(K++) = 浅いところで水を掛け合うと、ドンキホーテは顔に水がかかるたびに大声で笑った。
			ENDSELECT
		ENDIF
	ELSE
		IF 口上_関係性判定_1389(対象キャラ, PLAYER, "恋慕")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「%二人称_1389()%、遊んでくだされ！ 何をするかは、一緒に決めたいのです」
					KSTR:(K++) = ドンキホーテはあれこれと遊びを挙げ始めた。どの案にも、二人で並んでするものばかりが選ばれていた。
				CASE 1
					KSTR:(K++) = 「%二人称_1389()%！ 今日は_一人称_に、一刻だけくだされ！ 一刻だけでよいのです！」
					KSTR:(K++) = 結局、一刻では済まなかった。別れ際、ドンキホーテはなぜか得意げだった。
					KSTR:(K++) = 「やはり一刻では足りませなんだな！ 次からは二刻にいたしましょう！」
			ENDSELECT
		ELSEIF 口上_関係性判定_1389(対象キャラ, PLAYER, "セフレ")
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「ちょうどよいところに！ %二人称_1389()%、遊びませぬか？ 一人で球を蹴っておっても、張り合いがないのだ！」
					KSTR:(K++) = ドンキホーテは球を小脇に抱えたまま、%CALLNAME:PLAYER%の袖をぐいぐいと引っぱった。
				CASE 1
					KSTR:(K++) = 「こちらへ来てくだされ！ 新しい遊びを見つけたのだ！ 二人でないとできぬ遊びである！」
					KSTR:(K++) = ドンキホーテは隣を空けると、得意げに遊び方を教えてくれた。
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「%二人称_1389()%！ _一人称_と遊びませぬか？ 面白いことを探すなら、二人の方がよかろう！」
					KSTR:(K++) = 誘いに乗ると、ドンキホーテは目についたものを次々と指さし、片っ端から遊び始めた。
				CASE 1
					KSTR:(K++) = 「少しだけお付き合い願いたい！ 当人、ここで遊んでみたかったのだ！」
					KSTR:(K++) = 少しだけのつもりが、ドンキホーテに付き合っているうちに、すっかり長居してしまった。
			ENDSELECT
		ENDIF
	ENDIF
ENDIF


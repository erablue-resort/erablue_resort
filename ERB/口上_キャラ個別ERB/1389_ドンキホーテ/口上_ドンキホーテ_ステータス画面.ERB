;--------------------------------------------------
;ドンキホーテ（1389）用の口上ひな形。
;良秀・ハル子と同じファイル分類で、ゲーム本体の口上テンプレートVer0.116を使用。
;通常画面、好感度、恋慕、キャラ解説の7関数を記入。未実装関数はコメントアウトしている。
;空の関数でも存在判定によって汎用処理が省略される場合があるため、この状態を維持する。
;本文を記入した関数だけ、必要な宣言と処理を有効にする。元からの説明コメントは解除しない。
;未記入の KSTR / WSTR / NSTR / WNSTR はコメントのまま残す。
;TRYCALLFORM の振り分け先・共有関数も、呼び出し先を実装してから必要な範囲だけ有効にする。
;人物像・ネタバレ範囲・カタカナ発音の使用条件は、このフォルダの README.md を参照。
;--------------------------------------------------

;・使い方
;キャラクター番号は1389に設定済み。実装する関数に処理を入れる
;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_1389(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("口上_INFO画面_一言コメント_1389_サンチョ")
		RETURN 0
	TRYCALLFORM 口上_INFO画面_一言コメント_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、通常時の画面で表示されるので
;基本的にWAIT系列は使わないことを推奨
;また、一行のみの表示を想定。二行以上は基本的に禁止
;※うふふ中には表示されません

;以下は分岐の例
;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	KSTR:(K++) = 「ふへぇ……少し、息を整えさせてくだされ」
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = 「ようこそ！ ご用件は_一人称_が伺いますぞ！」
		CASE 2
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「飲み物はいかがですかな？ 混ぜる前に、分量を確かめねば！」
		CASE 3
			;図書室で司書中
			KSTR:(K++) = 「英雄譚の棚はこちらですぞ！ おおっと、声を落とさねばな」
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 「そこは走ってはならぬぞ！ _一人称_も、ここから見守ろう！」
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = 「むむ、網が重い！ 当人、まだ引けますぞ！」
		CASE 6
			;遊覧船・海底散歩でシーガイド中
			KSTR:(K++) = 「ご覧ぜよ！ 魚が群れで泳いでおるぞ！」
		CASE 100 TO 199
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 100):0}(現在仕事:対象キャラ:1 - 100)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					KSTR:(K++) = 「旅の道具はこちらですぞ！ 当人も、この品が気になっておった！」
				CASE "土産物屋"
					KSTR:(K++) = 「記念の品はいかがですかな？ _一人称_なら、この徽章を選びますぞ！」
				CASE "食事処"
					KSTR:(K++) = 「お腹が空きましたかな？ ご注文を伺おう！」
				CASE "装飾品店"
					KSTR:(K++) = 「この飾り、騎空士の徽章に似ておりますな！」
				CASE "直売所"
					KSTR:(K++) = 「採れたてですぞ！ _一人称_も、一つ味を見たくなるのだ！」
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置
;状況で分岐

IF CFLAG:対象キャラ:飲み会
	;飲み会中
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「もう一杯！ それから、_一人称_の話も聞いてくだされ！」
		CASE 1
			KSTR:(K++) = 「騎空士の武勇伝とな！ 当人、その続きを聞きたいぞ！」
	ENDSELECT
ELSEIF CFLAG:対象キャラ:睡眠
	;ダウン・睡眠中
	IF CFLAG:対象キャラ:体力限界
		;ダウン中
		KSTR:(K++) = 「ふへぇ……もう動けぬ。_一人称_、少し休もう……」
	ELSEIF 陥落チェック_性的(対象キャラ) && RAND:3
;		;寝言で甘えさせたい場合
		KSTR:(K++) = 「ん……もう少し、そばに……」
	ELSE
		KSTR:(K++) = 「すぅ……ロシナンテ……」
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	;デート中
	;デートの相手のキャラ番号 + 100が入っている
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「次はどちらへ行きますかな？ _一人称_、まだまだ見て回りたいぞ！」
		CASE 1
			KSTR:(K++) = 「二人で出かけると、見慣れた場所も楽しくなるのですな！」
	ENDSELECT
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	;一緒に遊ぶ中
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「もう一勝負！ 当人、次こそは負けぬぞ！」
		CASE 1
			KSTR:(K++) = 「_一人称_もやってみたい！ 順番を代わってくだされ！」
	ENDSELECT
ELSEIF CFLAG:対象キャラ:同行
	;同行中
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「_一人称_も参りますぞ！ 面白いものがあれば、教えてくだされ！」
		CASE 1
			KSTR:(K++) = 「ロシナンテよ、行くぞ！ 置いて行かれぬよう、ついて行こう！」
	ENDSELECT
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;一緒に隠密中
	KSTR:(K++) = 「しぃっ……当人、声を落としておるぞ……」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	;あなたが隠れていて、キャラはあなたに気づいていない
	KSTR:(K++) = 「この徽章は、こちらへ。む、_一人称_の襟には多すぎるか？」
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;キャラの野外オナニー中
	IF 知識素質:対象キャラ:性知識 < 0
		KSTR:(K++) = 「むむ……身体が落ち着かぬ。少し、ここで休もう」
	ELSE
		KSTR:(K++) = 「誰も来ぬうちに……少しだけ、ここにいよう」
	ENDIF
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方に、今日の話を聞いてもらいたいのだ！」
					CASE 1
						KSTR:(K++) = 「_一人称_の話を、最後まで聞いてくれる方なのです」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方も誘って、遊びに行こうではないか！」
					CASE 1
						KSTR:(K++) = 「今日は何をして遊びましょうな！」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「この島にも、面白い話を知る方がおりましょうな！」
					CASE 1
						KSTR:(K++) = 「当人、まだ行っておらぬ場所を見て回るぞ！」
				ENDSELECT
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方に話せば、_一人称_と一緒に考えてくださるはず！」
					CASE 1
						KSTR:(K++) = 「困ったときには、あの方を頼ってもよいのですな」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方は、約束を忘れぬ方ですな！」
					CASE 1
						KSTR:(K++) = 「_一人称_も、任されたことをやり遂げたいのだ！」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ここの決まりを、もう一度聞いておこう」
					CASE 1
						KSTR:(K++) = 「勝手に突っ走る前に、確かめねばな！」
				ENDSELECT
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方の顔を見ると、_一人称_まで笑ってしまうのだ」
					CASE 1
						KSTR:(K++) = 「また会いたいぞ。さっき話したばかりなのに」
				ENDSELECT
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方は、今どちらにおられるのでしょうな？」
					CASE 1
						KSTR:(K++) = 「_一人称_、あの方を見つけると嬉しくなるのです」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あの方の名前は覚えましたぞ！」
					CASE 1
						KSTR:(K++) = 「また話す機会もありましょうな！」
				ENDSELECT
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				;好感度レベル80以上
				IF 知識素質:対象キャラ:性知識 < 0
					KSTR:(K++) = 「あの方といると、身体までそわそわするのだ。何ゆえでしょうな？」
				ELSE
					KSTR:(K++) = 「あの方の手を思い出すと、また触れてほしくなるのだ」
				ENDIF
			CASE IS >= 経験値テーブル:(関係閾値:2)
				;好感度レベル20以上
				IF 知識素質:対象キャラ:性知識 < 0
					KSTR:(K++) = 「あの方に近づくと、なんだか落ち着かぬぞ」
				ELSE
					KSTR:(K++) = 「あの方と、もう少し触れ合っていたいのだ」
				ENDIF
			CASEELSE
				KSTR:(K++) = 「む、肩がこっておりますな。少し身体を動かそう！」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情

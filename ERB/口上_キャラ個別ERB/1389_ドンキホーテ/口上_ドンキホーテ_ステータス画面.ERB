@口上_ステータス画面_友情コメント_1389(対象キャラ)
#DIM 対象キャラ
;サンチョ中は _サンチョ 版があればそちらを使い、なければドンキホーテの台詞は出さない（口上_サンチョ_*.ERB）
IF サンチョ中_1389(対象キャラ)
	SIF !EXISTFUNCTION("口上_ステータス画面_友情コメント_1389_サンチョ")
		RETURN 0
	TRYCALLFORM 口上_ステータス画面_友情コメント_1389_サンチョ(対象キャラ)
	RETURN RESULT
ENDIF
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;基本的にWAIT系列は使わないことを推奨

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「まだ話したことのない方ですな。まずは挨拶から！」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「お名前は覚えましたぞ。どのような話がお好きですかな？」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「会えば挨拶を交わす方ですぞ！ 今度は、一緒に遊びたいのだ！」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「あの方と話すと、当人もつい長居してしまうのだ！」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「嬉しいことがあったら、あの方にも真っ先に話したいぞ！」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「_一人称_の話を笑って聞いてくれる、かけがえのない友なのです」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)



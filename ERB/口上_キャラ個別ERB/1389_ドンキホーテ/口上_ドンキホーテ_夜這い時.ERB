	RETURN 0

CALL 口上変数初期化

SELECTCASE CSTR:対象キャラ:夜這い口上渡し_記録文字列
	CASE "まごまご"
		;夜這い経験が少なくてまごまごして帰っちゃった
		IF 口上_関係性判定_1389(対象キャラ, 相手キャラ, "恋慕")
			KSTR:(K++) = ドンキホーテは%CALLNAME:相手キャラ%の部屋の前まで来たものの、扉に手をかけては離すのを、何度も繰り返している。
			KSTR:(K++) = 「こ、今宵はこれくらいにしておくのだ。明日、明日こそ……」
			KSTR:(K++) = 結局、ドンキホーテは赤い顔のまま自分の部屋へ引き返していった。
		ELSEIF 知識素質:対象キャラ:性知識 < 0
			KSTR:(K++) = 「夜討ち朝駆けは兵法の基本！ いざ、%二人称_1389(相手キャラ)%の部屋へ！
			KSTR:(K++) = 　む？ よく考えると夜這いと討ち入りは違うものなのでありましょうか？」
			KSTR:(K++) = 扉の前で首をひねっているうちに眠くなったのか、ドンキホーテはあくびをしながら帰っていった。
		ELSE
			KSTR:(K++) = 「いざ、夜這いである！ して、部屋に入った後は、何から始めればよいのだ？」
			KSTR:(K++) = 段取りを考えあぐねたまま、ドンキホーテは自分の部屋に戻っていった。
		ENDIF
	CASE "不在"
		;相手が別の場所で寝てるなどで不在
		IF 口上_関係性判定_1389(対象キャラ, 相手キャラ, "恋慕")
			KSTR:(K++) = 誰もいない寝台を前に、ドンキホーテは頬をふくらませた。
			KSTR:(K++) = 「%二人称_1389(相手キャラ)%め、どこで寝ておられるのだ。明日、たっぷり文句を言ってやるのである」
			KSTR:(K++) = そう言いながら、ドンキホーテは%CALLNAME:相手キャラ%の枕をしばらく抱えていた。
		ELSE
			KSTR:(K++) = 「たのもう！ む、もぬけの殻ではないか！
			KSTR:(K++) = 　%二人称_1389(相手キャラ)%め、騎士の夜討ちを見抜いておられたか！ 敵ながらあっぱれである！」
		ENDIF
ENDSELECT


@固有奥義_2800(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIM ＭＰ威力
#DIMS 奥義名
#DIM 表示用奥義威力

IF 陥落チェック(キャラ番号)
	奥義名 = 初音ミクの祝福＋
	奥義威力 = 0
	表示用奥義威力 = 100
ELSEIF 1
	奥義名 = 初音ミクの祝福
	奥義威力 = 0
	表示用奥義威力 = 100
ENDIF

SELECTCASE ARGS
	CASE "奥義名"
		TSTR:コマンド名受渡 = %奥義名%
	CASE "奥義説明文"
		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 39
			詳細文文字列受け渡し変数 += "味方全体に［回復力×39％］のＨＰ回復を与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［Lv×5］のＭＰ回復を与える。"
			詳細文文字列受け渡し変数 += @"<br>味方全体に［累積39％/最大150％］（独自枠・消去不可）の攻撃力上昇効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>味方全体に［累積39％/最大150％］（独自枠・消去不可）の防御力上昇効果を与える。"
			詳細文文字列受け渡し変数 += "<br>［1］のデバフ消去効果を与える。"
		ELSEIF 1
			詳細文文字列受け渡し変数 += "味方全体に［回復力×39％］のＨＰ回復を与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［Lv×5］のＭＰ回復を与える。"
			詳細文文字列受け渡し変数 += @"<br>味方全体に［累積25％/最大150％］（独自枠・消去不可）の攻撃力上昇効果を与える。"
			詳細文文字列受け渡し変数 += @"<br>味方全体に［累積25％/最大150％］（独自枠・消去不可）の防御力上昇効果を与える。"
		ENDIF
	CASE "奥義前効果"

	CASE "奥義追加効果"
		ＭＰ威力 = 基礎BATTLE_STATE:キャラ番号:Lv * 5
		IF 陥落チェック(キャラ番号)
			;HP回復
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果割合 = 39
			アビ汎用文字列:回復側使用能力値 = 回復力
			CALL アビテンプレート_回復処理_MAXでも回復
			;MP回復
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果量 = ＭＰ威力
			CALL アビテンプレート_ＭＰ回復処理_MAXでも回復
			CALL アビ汎用変数文字列リセット
			;固有攻撃バフ
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力_初音ミクの祝福
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:効果割合 = 39
			アビ汎用変数:累積上限_割合 = 150
			アビ汎用変数:持続ターン = -1
			アビ汎用変数:消去不可オプション = 1
			CALL アビテンプレート_有利効果_累積バフ効果セット
			;固有防御バフ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = 防御力_初音ミクの祝福
			アビ汎用文字列:バフ・デバフ対象能力 = 防御力
			アビ汎用変数:効果割合 = 39
			アビ汎用変数:累積上限_割合 = 150
			アビ汎用変数:持続ターン = -1
			アビ汎用変数:消去不可オプション = 1
			CALL アビテンプレート_有利効果_累積バフ効果セット
			;クリア効果
			CALL アビ汎用変数文字列リセット
			CALL アビテンプレート_有利効果_デバフ消去
		ELSEIF 1
			;HP回復
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
			アビ汎用変数:効果割合 = 39
			アビ汎用文字列:回復側使用能力値 = 回復力
			CALL アビテンプレート_回復処理_MAXでも回復
			;MP回復
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果量 = ＭＰ威力
			CALL アビテンプレート_ＭＰ回復処理_MAXでも回復
			CALL アビ汎用変数文字列リセット
			;固有攻撃バフ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力_初音ミクの祝福
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:効果割合 = 25
			アビ汎用変数:累積上限_割合 = 150
			アビ汎用変数:持続ターン = -1
			アビ汎用変数:消去不可オプション = 1
			CALL アビテンプレート_有利効果_累積バフ効果セット
			;固有防御バフ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = 防御力_初音ミクの祝福
			アビ汎用文字列:バフ・デバフ対象能力 = 防御力
			アビ汎用変数:効果割合 = 25
			アビ汎用変数:累積上限_割合 = 150
			アビ汎用変数:持続ターン = -1
			アビ汎用変数:消去不可オプション = 1
			CALL アビテンプレート_有利効果_累積バフ効果セット
		ENDIF
ENDSELECT


 

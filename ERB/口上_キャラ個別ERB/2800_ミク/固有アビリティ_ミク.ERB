;アビエディタによる生成関数
@固有アビ_2800_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 39
	アビ名 = 初音ミクの歌声＋＋＋＋
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
	アビ名 = 初音ミクの歌声＋＋＋
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
	アビ名 = 初音ミクの歌声＋＋
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
	アビ名 = 初音ミクの歌声＋
ELSEIF 1
	アビ名 = 初音ミクの歌声
ENDIF
	消費ＭＰ = 390


SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 39
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>味方全体に［39］の奥義ゲージUP効果を与える。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>味方全体に［30］の奥義ゲージUP効果を与える。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>味方全体に［25］の奥義ゲージUP効果を与える。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>味方全体に［20］の奥義ゲージUP効果を与える。"
		ELSEIF 1
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>味方全体に［10］の奥義ゲージUP効果を与える。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方全体_生者のみ
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 39
			アビ汎用変数:効果量 = 39
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
			アビ汎用変数:効果量 = 30
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
			アビ汎用変数:効果量 = 25
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
			アビ汎用変数:効果量 = 20
		ELSEIF 1
			アビ汎用変数:効果量 = 10
		ENDIF
		CALL アビテンプレート_有利効果_奥義ゲージUP
ENDSELECT

@固有アビ_2800_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 10 && 陥落チェック(キャラ番号)
	アビ名 = チューニング＋
	消費ＭＰ = 390
ELSEIF 陥落チェック(キャラ番号)
	アビ名 = チューニング
	消費ＭＰ = 390
ELSE
	アビ名 = 
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 10 && 陥落チェック(キャラ番号)
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>自身に［30％］（Ａ枠・3ターン）のゲージ上昇効率上昇効果を与える。"
		ELSEIF 陥落チェック(キャラ番号)
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>自身に［20％］（Ａ枠・3ターン）のゲージ上昇効率上昇効果を与える。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_自己のみ
		アビ汎用文字列:バフ・デバフ枠 = ゲージ上昇効率A
		アビ汎用文字列:バフ・デバフ対象能力 = ゲージ上昇効率
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 10 && 陥落チェック(キャラ番号)
			アビ汎用変数:効果割合 = 30
		ELSEIF 陥落チェック(キャラ番号)
			アビ汎用変数:効果割合 = 20
		ENDIF
		アビ汎用変数:持続ターン = 3
		CALL アビテンプレート_有利効果_バフ効果セット
ENDSELECT

@固有アビ_2800_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 陥落チェック(キャラ番号)
	アビ名 = バーチャルライブ
	消費ＭＰ = 390
ELSE
	アビ名 = 
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 陥落チェック(キャラ番号)
			詳細文文字列受け渡し変数 = 消費ＭＰ：390
			詳細文文字列受け渡し変数 += "<br>敵全体に［1］のバフ消去効果を与える。"
			詳細文文字列受け渡し変数 += "<br>味方全体に［1］（Ａ枠・5ターン）のテンション効果を与える。"
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		IF 陥落チェック(キャラ番号)
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵全体_生者のみ
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_バフ消去
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
			アビ汎用文字列:バフ・デバフ枠 = テンションA
			アビ汎用文字列:バフ・デバフ対象能力 = テンション
			アビ汎用変数:効果量 = 1
			アビ汎用変数:持続ターン = 5
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
ENDSELECT


@固有ターン終了時処理_キャラ_2800
#DIM キャラ番号

CALL アビ汎用変数文字列リセット
CALL アビ対象選択テンプレート_味方全体_生者のみ
	IF 基礎BATTLE_STATE:キャラ番号:Lv >= 39
		アビ汎用変数:効果量 = 39
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
		アビ汎用変数:効果量 = 30
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 15
		アビ汎用変数:効果量 = 25
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
		アビ汎用変数:効果量 = 20
	ELSEIF 1
		アビ汎用変数:効果量 = 10
	ENDIF
CALL アビテンプレート_有利効果_奥義ゲージUP



;--------------------------------------------------
;戦闘能力画面に表示されるキャラごとの固有処理説明
;--------------------------------------------------
;・使い方
;「XXXX」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;　口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;　基本的にWAIT系列は使わないことを推奨
;--------------------------------------------------
@口上_ステータス画面_固有特性解説_2800(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = □ 特性：『Project DIVA』 □------------------------------------------------------------
KSTR:(K++) = 　攻撃力と連続攻撃率が非常に低いがターン終了時に初音ミクの歌声が発動
KSTR:(K++) = 　初期ＨＰ・ＭＰが多く、攻撃力と連続攻撃率は成長しない
CALL 口上変数表示(対象キャラ, 1)

 

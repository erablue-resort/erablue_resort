;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「130」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;****************************************
;関係レベル
;	好感度レベルと恋慕レベルの高い方。陥落済みなら 関係閾値:5 扱い
;	段の境目は 関係閾値 = 0,10,20,50,80,100
;****************************************

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
;	-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_別人版_130_300(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

;初回実行（コマンド初回フラグはコマンド終了後に保存されるので、初回はまだ含まれていない）
IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-300-") < 0 && RFLAG:コマンド結果受渡し変数 >= 0
	KSTR:(K++) = 「あ、はい！　えっと……お話、ですか？」
	KSTR:(K++) = 　%CALLNAME:対象キャラ%は少し慌てたように居住まいを正し、ちらりと後ろのグラフォスを振り返った。
	KSTR:(K++) = 「すみません、こういうの慣れてなくて。でも、声をかけてもらえて嬉しいです」
	KSTR:(K++) = 「改めまして、サラです。故郷の島では……巫女のようなことをしていました」
	KSTR:(K++) = 「今は……その、いろいろありまして。団長さんの船に乗せてもらって、グラフォスと一緒にあちこち旅をしているところなんです」
	KSTR:(K++) = 「この島のこと、まだ全然知らないんです。よかったら、色々教えてください」
	GOTO 表示位置
ENDIF

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「あの……えっと……。な、何を話せばいいか、分からなくなっちゃいました……」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「ふふ、なんだか言葉が途切れちゃいましたね。……静かに海を見るのも、好きです」
			CASEELSE
				KSTR:(K++) = 「お話しなくても大丈夫ですよ。その、私は%CSTR:対象キャラ:二人称%のお顔を見てるだけでも……_H_」
		ENDSELECT
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「え……？　あの、何てお返事したらいいか……」
				KSTR:(K++) = 　会話が噛み合わず、気まずい沈黙が流れてしまった。
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「……？　あ、あの……笑うところ、でしたか？　すみません、よく分からなくて……」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「……。あ、えっと……面白い……です？　うん、面白いお話、ですね……」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は気を遣って笑おうとしてくれたが、明らかに目が泳いでいる。
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「あはは……%CSTR:対象キャラ:二人称%って、たまにすごく変なお話しますよね」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は苦笑いを浮かべ、何事もなかったかのように視線を海へ戻した。
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あはは……%CSTR:対象キャラ:二人称%って、たまにすごく変なお話しますよね」
						KSTR:(K++) = 　%CALLNAME:対象キャラ%は苦笑いを浮かべ、何事もなかったかのように視線を海へ戻した。
					CASE 1
						KSTR:(K++) = 「……いまのお話、全然面白くなかったですよ？」
						KSTR:(K++) = 「グラフォスもあきれてます。もう、次はもっとちゃんとしたお話にしてくださいね」
				ENDSELECT
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「私の故郷は砂ばかりだったので……水や緑がいっぱいの場所って、未だに新鮮です」
					CASE 1
						KSTR:(K++) = 「初めて海を見た時は、見渡す限りお水で……大きすぎて怖くて、ボレミアにしがみついちゃいました」
						KSTR:(K++) = 「でも今は、海を眺めるのも、静かな波の音を聞くのも大好きです」
					CASE 2
						KSTR:(K++) = 「グラフォスは私の大切な友達です。ちょっと大きくてびっくりさせちゃうかもしれませんけど……」
					CASE 3
						KSTR:(K++) = 「お手伝いできることがあれば何でも言ってください。力仕事ならグラフォスにお願いできますから」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:5
					CASE 0
						KSTR:(K++) = 「ボレミアは……私の自慢のお姉さんなんです」
						KSTR:(K++) = 「あっ、本当のお姉さんってわけじゃないんですけど……でも、強くて優しくて、私もあんな風になりたいなって思います」
					CASE 1
						KSTR:(K++) = 「この島のごはん、とっても美味しいですね。グラフォスもいつも喜んでます。ふふっ」
					CASE 2
						KSTR:(K++) = 「朝早く目が覚めた時、お庭のお花にお水をあげるのが好きなんです」
						KSTR:(K++) = 「以前も旅先でアサガオのお世話をしたことがあって……綺麗な花が咲いた時、すごく嬉しかったなぁ」
					CASE 3
						KSTR:(K++) = 「船に大きな穴が空いて留め具が足りなかった時、グラフォスが砂で木を支えて修理を手伝ったことがあるんです」
						KSTR:(K++) = 「砂の力って、戦う以外にも色んな役に立つんですよ」
					CASE 4
						KSTR:(K++) = 「海図を見るの、すごく好きなんです。まだ行ったことのない島がたくさんあって……わくわくしちゃいます」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「私の故郷には、薄い生地を何十枚も重ねて作る伝統のお菓子があるんです」
						KSTR:(K++) = 「とっても手間がかかるんですけど、この前みんなで作って……今度、%CSTR:対象キャラ:二人称%にも作ってあげたいな」
					CASE 1
						KSTR:(K++) = 「ふふっ、%CSTR:対象キャラ:二人称%とお話ししてると、なんだか心が軽くなります」
					CASE 2
						KSTR:(K++) = 「グラフォスが教えてくれるんです。%CSTR:対象キャラ:二人称%はとっても優しい人だって。……私も、そう思います」
					CASE 3
						KSTR:(K++) = 「知らない言葉を教えてもらったり、本を読んだりする時間はすごく好きです。知らないことを知るのって、楽しいですね」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:4
					CASE 0
						KSTR:(K++) = 「私ね、以前は自分が生き残ってよかったのかなって……悩んだこともあったんです」
						KSTR:(K++) = 「でも、みんながいてくれたから……今は、生きてて本当によかったって、心から思えるようになりました」
					CASE 1
						KSTR:(K++) = 「昔は海が怖くて、向こうに流されちゃったらどうしようって思ってました」
						KSTR:(K++) = 「でも……誰かに手をぎゅって握ってもらえたら、不思議と怖くなくなるんです」
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%と手を繋いでる時も、同じ安心がします」
					CASE 2
						KSTR:(K++) = 「もっと私のこと、知ってほしいです。……それと、%CSTR:対象キャラ:二人称%の好きなことも、たくさん教えてほしいな」
					CASE 3
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%と過ごす時間、一日があっという間に過ぎちゃいます。もっと一緒にいたいな……」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:8
					CASE 0
						KSTR:(K++) = 「大好きです、%CSTR:対象キャラ:二人称%_H_　えへへ、口に出すと胸が温かくなります」
					CASE 1
						KSTR:(K++) = 「私の未来は、私が選ぶって決めました。……誰かに言われたからじゃなくて、私が%CSTR:対象キャラ:二人称%の隣にいたいから、ここにいるんです」
					CASE 2
						KSTR:(K++) = 「ほら、手……恋人繋ぎ、してもいいですか？　%CSTR:対象キャラ:二人称%の温もりを感じてると、すごく安心するんです_H_」
					CASE 3
						KSTR:(K++) = 　サラとグラフォスが話しているのを眺めていると、何やらサラの顔が赤く染まってきた。
						KSTR:(K++) = 「え、そ、そんなぁ。もう、グラフォスったら……！　ち、違うもん……そんなこと考えてないもん……っ_H_」
						KSTR:(K++) = 「……あ、ううん、何でもないです！　な、何でもないですからね、%CSTR:対象キャラ:二人称%……っ」
					CASE 4
						KSTR:(K++) = 「ルリアちゃんと、ボレミアと、お菓子を作ったんです。少し形が違うけど、どれもちゃんと焼けました」
						KSTR:(K++) = 「ルリアちゃんと味見してみたら、二人ともなかなか止まらなくて……ボレミアの分まで食べちゃうところでした」
					CASE 5
						KSTR:(K++) = 「借りてきた本を読んで、分からない言葉を紙に書いていたんですけど……気がついたら、紙がいっぱいになっちゃいました」
						KSTR:(K++) = 「でも、前に教えてもらった言葉も出てきたんです。そこは一人で読めたから、嬉しくて……♪」
						KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、今日はこの言葉を教えてもらってもいいですか？」
					CASE 6
						KSTR:(K++) = 「今朝、お庭のお花につぼみがついていたんです。昨日までは、葉っぱばかりだったのに……！」
						KSTR:(K++) = 「グラフォスにも見せたら、咲くまでそこにいようとするんです。まだ時間がかかるよって言ったんですけど……」
						KSTR:(K++) = 「ふふ、私も気になります。明日の朝は、少し早く見に行こうかな」
					CASE 7
						KSTR:(K++) = 「お部屋に砂が落ちていて、グラフォスに汚しちゃ駄目だよって言ったんです」
						KSTR:(K++) = 「でも、よく見たら私の服から落ちた砂で……外で遊んだ時についてたみたいです」
						KSTR:(K++) = 「ちゃんと謝って、一緒にお掃除しました……あはは……」
				ENDSELECT
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「わあ……！　そんなお話、初めて聞きました！　空の世界って、本当に広いんですね」
				KSTR:(K++) = 　%CALLNAME:対象キャラ%は目を輝かせて、楽しそうに話に聞き入っている。
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「ふふっ、あはははっ！　%CSTR:対象キャラ:二人称%ってお話し上手ですね！　笑いすぎて、お腹が痛くなっちゃいました」
			CASEELSE
				KSTR:(K++) = 「ふふっ、%CSTR:対象キャラ:二人称%といると、本当に楽しくて……幸せで胸がいっぱいです_H_」
		ENDSELECT
ENDSELECT

$表示位置
CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM301_お茶を淹れる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
;	-1:失敗  0:通常成功  1:大成功

@KOJO_COM_別人版_130_301(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「あ……少し渋いかもしれません。でも、淹れてくれてありがとうございます」
			CASEELSE
				KSTR:(K++) = 「ふふ、ちょっとだけ苦いですね。お砂糖を入れたら美味しく飲めますよ」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「いただきます。……温かくて、とっても美味しいです」
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「ほっとしますね……。お茶のいい香りがして、すごく落ち着きます」
					CASE 1
						KSTR:(K++) = 「美味しい……！　あ、グラフォスも嬉しそうに頷いてます」
						KSTR:(K++) = 「私が美味しいって思うと、グラフォスにも伝わるんですよ。ふたりでごちそうになってます」
				ENDSELECT
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「お茶請けのお菓子、半分こしましょうか？　%CSTR:対象キャラ:二人称%と一緒だと、もっと美味しいです」
			CASEELSE
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%が淹れてくれたお茶、世界で一番好きです_H_　心まで温かくなります」
				KSTR:(K++) = 「グラフォスも満足そうに目を細めてます。ふふ、ふたりで幸せな気分です」
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「すごく美味しいです……！　こんなに香り高いお茶、飲んだことありません」
			CASEELSE
				KSTR:(K++) = 「美味しい……！　なんだか体中の力が抜けて、ふわふわした気持ちになっちゃいます_H_」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM302_スキンシップ
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
;	-1:失敗  0:通常成功  1:大成功

@KOJO_COM_別人版_130_302(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「ひゃっ……！　あ、ごめんなさい、急に触られたのでびっくりしちゃって……」
			CASEELSE
				KSTR:(K++) = 「あ……くすぐったいです。えへへ……」
		ENDSELECT
	CASE 0
		;通常成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 　そっと頭を撫でてやると、%CALLNAME:対象キャラ%は少し驚いたように身を縮めたが、
				KSTR:(K++) = 　すぐに大人しく撫でられたまま、静かに息をついた。
				KSTR:(K++) = 「……%CSTR:対象キャラ:二人称%の手、とっても温かいですね」
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「子供扱い……ですか？　……ううん、嫌じゃないです。なんだか安心します」
					CASE 1
						KSTR:(K++) = 　耳元に触れられた%CALLNAME:対象キャラ%は、くすぐったそうに身をすくめた。
						KSTR:(K++) = 「あ……耳たぶですか？　ふふ、お菓子の生地と同じ柔らかさって言いますよね」
				ENDSELECT
			CASE IS < 関係閾値:3
				KSTR:(K++) = 　%CALLNAME:対象キャラ%の手をそっと握ると、小さな指がぎゅっと握り返してきた。
				KSTR:(K++) = 「手、繋いでると……心が繋がってるみたいで、すごく嬉しいです」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 　頭を撫でてやると、%CALLNAME:対象キャラ%はくすぐったそうに目を細め、身を寄せてきた。
				KSTR:(K++) = 「えへへ……もっと撫でてください。%CSTR:対象キャラ:二人称%に触れてもらえるの、大好きです」
			CASEELSE
				KSTR:(K++) = 　そっと抱き寄せると、%CALLNAME:対象キャラ%は小さな腕を%CALLNAME:MASTER%の背中に回してぎゅっと抱きついてきた。
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の匂い……すごく落ち着きます。ずっとこうしていたいです_H_」
		ENDSELECT
	CASEELSE
		;大成功
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「あ……あったかい……。なんだか、とっても優しい気持ちになれます」
			CASEELSE
				KSTR:(K++) = 「ん……%CSTR:対象キャラ:二人称%……_H_　えへへ、幸せすぎてとろけちゃいそうです」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;COM314_プレゼントを渡す
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
;	0:通常  1:好みの品  2:キャラ固有の特殊反応（プレゼント特殊反応_CHARAEVENT_別人版_130 がある時のみ）

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		KSTR:(K++) = 「私にプレゼント……ですか？　ありがとうございます！　大切にしますね」
	CASEELSE
		;好みの品・特殊反応
		KSTR:(K++) = 「わあ……！　これ、ずっと欲しかったんです！　すっごく嬉しいです、%CSTR:対象キャラ:二人称%！」

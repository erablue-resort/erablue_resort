;光属性SSRサラ。技の解放LvとMP・バリア量はera側の戦闘規模に合わせています。
;戦闘中カウントの自由枠：0=鉄槌Lv、1=そのターンの反撃回数、2=反撃回数を記録したターン。

@固有アビ_別人版_130_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
	消費ＭＰ = 55
	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = アフェクティオ
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>味方全体に［60％］（1ターン）の闇属性耐性上昇効果を与える。
			RETURN 消費ＭＰ
		CASE "アビ効果"
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用文字列:バフ・デバフ枠 = 闇耐性_アフェクティオ
			アビ汎用文字列:バフ・デバフ対象能力 = 闇耐性
			アビ汎用変数:効果量 = 60
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
	ENDSELECT

@固有アビ_別人版_130_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
	アビ名 =
	消費ＭＰ = 75
	SIF 基礎BATTLE_STATE:キャラ番号:Lv >= 5
		アビ名 = トニトルア
	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>敵全体に［400％］の光属性ダメージを与える。
			詳細文文字列受け渡し変数 += @"<br>砂神グラフォスの鉄槌Lvが1上昇（最大5）。"
			詳細文文字列受け渡し変数 += @"<br>自身以外の味方全体に、自身の回復力［100％］分のバリアを与える。鉄槌Lv5では［200％］分。"
			RETURN 消費ＭＰ
		CASE "アビ効果"
			SIF アビ名 == ""
				RETURN -1
			CALL サラ_トニトルア
	ENDSELECT

@固有アビ_別人版_130_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
	アビ名 =
	消費ＭＰ = 40
	SIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
		アビ名 = アローザル
	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>自身に（1ターン）の単体かばう効果を与える。
			詳細文文字列受け渡し変数 += @"<br>使用時に鉄槌Lvが3以上なら、さらに［50％］（独自枠・1ターン）の攻撃力上昇効果を与える。"
			RETURN 消費ＭＰ
		CASE "アビ効果"
			SIF アビ名 == ""
				RETURN -1
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = 単体かばう
			アビ汎用文字列:バフ・デバフ対象能力 = 単体かばう
			アビ汎用変数:持続ターン = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			IF 戦闘中カウント:戦闘行動キャラ:0 >= 3
				CALL アビ汎用変数文字列リセット
				アビ汎用文字列:バフ・デバフ枠 = 攻撃力_アローザル
				アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
				アビ汎用変数:効果割合 = 50
				アビ汎用変数:持続ターン = 1
				CALL アビテンプレート_有利効果_バフ効果セット
			ENDIF
	ENDSELECT

	;手動使用と奥義追加効果で共用。MP消費は手動使用時の共通処理に任せます。
@サラ_トニトルア
#DIM バリア量
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_敵全体_生者のみ
	アビ汎用変数:効果割合 = 400
	アビ汎用文字列:ダメージ種類 = アビリティダメージ
	CALL アビテンプレート_ダメージ処理_光属性

	;Lv4からの使用でも、この使用でLv5になれば強化バリアになります。
	CALL サラ_鉄槌Lv上昇
	CALL バフ・デバフ測定(戦闘行動キャラ, "回復力")
	バリア量 = MAX(1, RESULT)
	SIF 戦闘中カウント:戦闘行動キャラ:0 >= 5
		バリア量 *= 2

	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_味方全体_生者のみ_自己以外
	SIF アビテンプレート用_対象保存:0 < 0
		RETURN
	アビ汎用文字列:バフ・デバフ枠 = バリア
	アビ汎用文字列:バフ・デバフ対象能力 = バリア
	アビ汎用変数:効果量 = バリア量
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_バフ効果セット

@固有戦闘開始時処理_キャラ_別人版_130
	戦闘中カウント:戦闘行動キャラ:0 = 0
	戦闘中カウント:戦闘行動キャラ:1 = 0
	戦闘中カウント:戦闘行動キャラ:2 = 現在ターン数

	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_自己のみ
	アビ汎用文字列:バフ・デバフ枠 = 砂神グラフォスの鉄槌_反撃
	アビ汎用文字列:バフ・デバフ対象能力 = 特殊反応_被ダメ時
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_パッシブバフ効果セット

	CALL アビ汎用変数文字列リセット
	アビ汎用文字列:バフ・デバフ枠 = ゲージ上昇効率_砂神グラフォスの鉄槌
	アビ汎用文字列:バフ・デバフ対象能力 = ゲージ上昇効率
	アビ汎用変数:効果割合 = -25
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_パッシブバフ効果セット

	;被ダメージ時にも通常のゲージ上昇効率が乗るため、被ダメ時専用枠には重ねません。

@特殊反応_被ダメ時_砂神グラフォスの鉄槌_反撃(バフ番号, 攻撃者隊列, 被ダメ記録順)
#DIM バフ番号
#DIM 攻撃者隊列
#DIM 被ダメ記録順
	;毒などの継続ダメージや、既に倒れた敵には反撃しません。
	SIF 攻撃者隊列 < 10 || 攻撃者隊列 >= 20
		RETURN
	SIF 敵BATTLE_STATE:(攻撃者隊列 - 10):ＨＰ <= 0
		RETURN
	IF 戦闘中カウント:戦闘行動キャラ:2 != 現在ターン数
		戦闘中カウント:戦闘行動キャラ:1 = 0
		戦闘中カウント:戦闘行動キャラ:2 = 現在ターン数
	ENDIF
	SIF 戦闘中カウント:戦闘行動キャラ:1 >= 2
		RETURN
	戦闘中カウント:戦闘行動キャラ:1 += 1
	アビテンプレート用_アビ名 = 砂神グラフォスの鉄槌
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_指定(攻撃者隊列)
	アビ汎用変数:効果割合 = 100
	アビ汎用文字列:ダメージ種類 = アビリティダメージ
	CALL アビテンプレート_ダメージ処理_光属性
	CALL サラ_鉄槌Lv上昇

@サラ_鉄槌Lv上昇
#DIM 鉄槌Lv
	SIF 戦闘中カウント:戦闘行動キャラ:0 >= 5
		RETURN
	戦闘中カウント:戦闘行動キャラ:0 += 1
	鉄槌Lv = 戦闘中カウント:戦闘行動キャラ:0
	CALL アビ汎用変数文字列リセット
	CALL アビ対象選択テンプレート_自己のみ
	アビ汎用文字列:バフ・デバフ枠 = 防御力_砂神グラフォスの鉄槌
	アビ汎用文字列:バフ・デバフ対象能力 = 防御力
	アビ汎用変数:効果割合 = 鉄槌Lv * 20
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_パッシブバフ効果セット

	CALL アビ汎用変数文字列リセット
	アビ汎用文字列:バフ・デバフ枠 = 弱体耐性_砂神グラフォスの鉄槌
	アビ汎用文字列:バフ・デバフ対象能力 = 弱体耐性
	アビ汎用変数:効果量 = 鉄槌Lv * 20
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_パッシブバフ効果セット

	CALL アビ汎用変数文字列リセット
	アビ汎用文字列:バフ・デバフ枠 = 敵対心_砂神グラフォスの鉄槌
	アビ汎用文字列:バフ・デバフ対象能力 = 敵対心
	アビ汎用変数:効果割合 = 鉄槌Lv * 100
	アビ汎用変数:持続ターン = -1
	CALL アビテンプレート_有利効果_パッシブバフ効果セット

@口上_ステータス画面_固有特性解説_別人版_130(対象キャラ)
#DIM 対象キャラ
	PRINTL 【砂神グラフォスの鉄槌】
	PRINTL 　被ダメージ時、1ターンに2回まで光属性100％の反撃を行います。
	PRINTL 　反撃・トニトルアで鉄槌Lvが1上昇（最大5・戦闘終了まで持続）。
	PRINTL 　Lvごとに防御力＋20％、弱体耐性＋20％、敵対心＋100％（各消去不可）。
	PRINTL 　奥義ゲージ上昇効率－25％。


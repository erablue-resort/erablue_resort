;****************************************
;ステータス画面・INFO画面での台詞
;****************************************
;・使い方
;「130」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_別人版_130(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			;ロビーで受付中
			KSTR:(K++) = 「いらっしゃいませ。……えっと、お部屋はこちらになります」
		CASE 2
			;バーエリア
			KSTR:(K++) = 「甘いジュースなら、私でも作れます。飲んでみますか？」
		CASE 3
			;図書室で司書中
			KSTR:(K++) = 「静かに本を読む時間……とても好きです」
		CASE 4
			;プールで監視員中
			KSTR:(K++) = 「滑りやすいので気をつけてくださいね。グラフォスも見てますから」
		CASE 5
			;漁船団で漁師中
			KSTR:(K++) = 「網を引っ張るのも、グラフォスと一緒なら大丈夫です」
		CASE 6
			;遊覧船・シーガイド中
			KSTR:(K++) = 「海の上を渡る風……すごく気持ちいいですね」
		CASE 100 TO 199
			;店舗
			KSTR:(K++) = 「いらっしゃいませ。なにかお探しのものはありますか？」
	ENDSELECT
ENDIF

SIF KSTR:0 != ""
	GOTO 表示位置

;状況で分岐
IF CFLAG:対象キャラ:睡眠
	IF CFLAG:対象キャラ:体力限界
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は疲れ切った様子で、小さな胸を上下させて眠っている。
	ELSE
		KSTR:(K++) = 　%CALLNAME:対象キャラ%は穏やかな寝息を立てている。安心しきった寝顔だ。
	ENDIF
ELSEIF CFLAG:対象キャラ:デート == MASTER + 100
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%と一緒だと、見たことのない景色ばかりで楽しいです」
		CASE 1
			KSTR:(K++) = 「次はどこに行きますか？　私、どこへでもついていきます」
	ENDSELECT
ELSE
	;通常時
	関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
	SIF 陥落チェック(対象キャラ) >= 1
		関係レベル = 関係閾値:5

	SELECTCASE 関係レベル
		CASE IS < 関係閾値:1
			KSTR:(K++) = 「何か、私にお手伝いできることはありますか……？」
		CASE IS < 関係閾値:2
			KSTR:(K++) = 「この島には、私の知らないものがたくさんあって……毎日驚いてばかりです」
		CASE IS < 関係閾値:3
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%！　あ、その……お話しできて嬉しいです」
		CASE IS < 関係閾値:4
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%と一緒にいると、胸の奥がぽかぽかしてきます」
		CASEELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の隣が、私の一番安心できる場所です_H_」
				CASE 1
					KSTR:(K++) = 「もう迷ったりしません。私は、%CSTR:対象キャラ:二人称%と一緒に生きていきたいです」
			ENDSELECT
	ENDSELECT
ENDIF

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)


;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_別人版_130(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「サラと言います。……迷惑にならないようにしますから」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「えっと……私、変なこと言ってないでしょうか？」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、こんにちは。今日もいいお天気ですね」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「友達……って呼んでもいいですか？　私、すごく嬉しいです」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%には、なんでも相談したくなっちゃいます」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%は、私にとってかけがえのない大切な人です」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_信頼
;--------------------------------------------------
@口上_ステータス画面_信頼コメント_別人版_130(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE CFLAG:対象キャラ:信頼度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「何かあったら、グラフォスを呼んでください。私、戦えますから」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「私を……危ない目には遭わせないって、そう言ってくれるんですね」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%の言葉は、ちゃんと心に届きます」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;知己
		KSTR:(K++) = 「グラフォスも言ってます。%CSTR:対象キャラ:二人称%は信じられる人だって」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;相棒
		KSTR:(K++) = 「背中を預けてください。どんな魔物が来ても、私が絶対守ります」
	CASEELSE
		;水魚の交わり
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%と一緒なら、どんな困難だって乗り越えられます」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;ステータス画面一言口上_恋心
;--------------------------------------------------
@口上_ステータス画面_恋心コメント_別人版_130(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE CFLAG:対象キャラ:恋心度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「こ、恋……？　そういうのは、私にはまだよく分からなくて……」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「えっと……そんなに見つめられると、なんだか恥ずかしいです」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「%CSTR:対象キャラ:二人称%のお顔を見ると、なんだか胸がドキドキします……」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;気になる人
		KSTR:(K++) = 「お姉ちゃん以外で、こんなに誰かのことばかり考えるの……初めてです」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;想い人
		KSTR:(K++) = 「私……%CSTR:対象キャラ:二人称%の特別な存在になりたいです」
	CASEELSE
		;恋人・最愛
		KSTR:(K++) = 「大好きです、%CSTR:対象キャラ:二人称%……ずっと、私の手を離さないでくださいね_H_」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ)


;--------------------------------------------------
;キャラ解説
;--------------------------------------------------
@口上_ステータス画面_キャラ解説_別人版_130(対象キャラ)
#DIM 対象キャラ
;初期化と表示は呼び出し元（口上_キャラ解説表示 等）が行うので、ここではKSTRに入れるだけ

KSTR:(K++) = 　サブル島において、かつて砂神グラフォスの力を宿す「砂神の巫女」として育てられた少女。
KSTR:(K++) = 　雨神マナウィダン封印の儀式において命を捧げる宿命を背負わされていたが、
KSTR:(K++) = 　仲間たちとの出会いを経て生き残り、自分自身の生きる道を模索し始めた。
KSTR:(K++) = 　
KSTR:(K++) = 　生還後も偏見やグラフォスの力の暴走、島の理不尽な要求に苦しめられたが、
KSTR:(K++) = 　護衛であり姉と慕うボレミアや大切な仲間たちに支えられ、自らの強い意志で理不尽な犠牲を拒絶。
KSTR:(K++) = 　グラフォスと共に命を支え合い、自分の意志で未来を歩む「黎明の巫女」として成長を遂げた。
KSTR:(K++) = 　
KSTR:(K++) = 　控えめで礼儀正しいが、芯には決して折れない強さと他者を思いやる優しさを持つ。
KSTR:(K++) = 　リゾートでの平穏な日常やお菓子、未知の世界への好奇心に瞳を輝かせる等身大の少女でもある。

@固有奥義_別人版_130(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIM デバフあり
#DIM デバフ行
	奥義威力 = 450
	SIF 基礎BATTLE_STATE:キャラ番号:Lv >= 40
		奥義威力 = 500
	SELECTCASE ARGS
		CASE "奥義名"
			TSTR:コマンド名受渡 = コル・イーオン
		CASE "奥義説明文"
			詳細文文字列受け渡し変数 = 奥義威力：{奥義威力}％<br>自身の弱体効果を全て回復する（消去不可・特殊範囲の効果を除く）。
			詳細文文字列受け渡し変数 += @"<br>弱体効果がない場合、代わりにトニトルアが追加発動する（MP消費なし）。"
			RETURN 奥義威力
		CASE "奥義追加効果"
			;弱体を消してから判定すると常に追加攻撃になるため、消去前に確認します。
			デバフあり = 0
			FOR デバフ行, 0, DT_ROW_LENGTH("戦闘効果データベース")
				IF バフ・デバフ効果適用判定_行指定(デバフ行, "デバフ", "ALL", 戦闘行動キャラ)
					デバフあり = 1
					BREAK
				ENDIF
			NEXT
			IF デバフあり
				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_自己のみ
				CALL アビテンプレート_有利効果_デバフ全て消去
			ELSE
				アビテンプレート用_アビ名 = トニトルア
				CALL サラ_トニトルア
			ENDIF
	ENDSELECT


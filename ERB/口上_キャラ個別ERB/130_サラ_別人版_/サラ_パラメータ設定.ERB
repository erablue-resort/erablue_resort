;****************************************
;キャラの初期パラメータを口上側で制御するためのファイル
;****************************************
;・使い方
;「130」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;初期パラメータ変更
;--------------------------------------------------
@口上側初期パラメータ変更_別人版_130
;NEWGAME時に呼ばれる関数、ロード時には呼ばれないことに注意
;TALENTをONOFFしたり、EXPの取得や初期ABLの変更などをここに記述すること
LOCAL = GETCHARA(130)

;キャラクターが自分を指す際の呼び方
CSTR:LOCAL:一人称 = 私

;キャラクターがあなたを指す際の呼び方
IF SAVESTR:あなたスタイル == "グランくんスタイル"
	CSTR:LOCAL:二人称 = グランさん
ELSEIF SAVESTR:あなたスタイル == "ジータちゃんスタイル"
	CSTR:LOCAL:二人称 = ジータさん
ELSE
	CSTR:LOCAL:二人称 = オーナーさん
ENDIF

CSTR:LOCAL:キャラ固有好感度要素 = 

;プレゼントの好み（CSV設定済みだが、口上特有の設定があれば記述）
;CSTR:LOCAL:プレゼント好み = お菓子/日用品

;身長やバストの数値を指定する・変更する場合（黎明の巫女版：136cm）
BASE:LOCAL:身長 = 1360
BASE:LOCAL:バスト = 610


;--------------------------------------------------
;ロード時パラメータ変更
;--------------------------------------------------
@口上側LOADENDパラメータ変更_別人版_130
;ロード時に呼ばれる関数。NEWGAME時に呼ばれないことに注意
LOCAL = GETCHARA(130)

IF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = 私
ENDIF

IF CSTR:LOCAL:二人称 == ""
	IF SAVESTR:あなたスタイル == "グランくんスタイル"
		CSTR:LOCAL:二人称 = グランさん
	ELSEIF SAVESTR:あなたスタイル == "ジータちゃんスタイル"
		CSTR:LOCAL:二人称 = ジータさん
	ELSE
		CSTR:LOCAL:二人称 = オーナーさん
	ENDIF
ENDIF


;--------------------------------------------------
;弱点コマンド制御
;--------------------------------------------------
@弱点コマンド変更_別人版_130
;各変数にコマンド番号を入れること
LOCAL = GETCHARA(130)

; 0・1はセクハラ、2・3はうふふ、4はランダム

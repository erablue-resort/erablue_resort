;****************************************
;ターン開始時や一日開始時・終了時に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「130」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;初対面時
;--------------------------------------------------
;リゾート内で初めてTARGETにした時に一度だけ呼ばれる（場所は問わない）
@KOJO_EVENT_初対面_別人版_130(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = 　ふわりと波打つ暗いオレンジの髪に、大きな黒いリボンをつけた小柄な少女が、
WSTR:(K++) = 　物珍しそうにリゾートの景色を見渡している。
KSTR:(K++) = 　
KSTR:(K++) = 　その背後には、砂を固めて作られたゴーレムのような存在が、
WSTR:(K++) = 　彼女を護るかのように寄り添っていた。
KSTR:(K++) = 　
WSTR:(K++) = 　こちらに気づいた少女は、胸の前できゅっと手を握りしめ、ぺこりと頭を下げてくる。
KSTR:(K++) = 　
WSTR:(K++) = 「あ、初めまして……サラ、と言います」
KSTR:(K++) = 　
WSTR:(K++) = 「この子はグラフォス。見た目はちょっと怖いかもしれませんけど……暴れたりしませんから」
KSTR:(K++) = 　
WSTR:(K++) = 「えっと、迷惑にならないようにしますので……よろしくお願いします、%CSTR:対象キャラ:二人称%」
KSTR:(K++) = 　
KSTR:(K++) = 　控えめな印象の少女だが、その青い瞳の奥からは芯の強さを感じた。

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_別人版_130(対象キャラ)
#DIM 対象キャラ
#DIM 関係レベル
CALL 口上変数初期化

関係レベル = MAX(CFLAG:対象キャラ:好感度レベル, CFLAG:対象キャラ:恋慕レベル)
SIF 陥落チェック(対象キャラ) >= 1
	関係レベル = 関係閾値:5

SELECTCASE TIME
	;朝　5時～11時
	CASE 5*60 TO 11*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。……今日もいいお天気ですね」
					CASE 1
						KSTR:(K++) = 「おはようございます。朝の空気、涼しくて気持ちいいです」
				ENDSELECT
			CASE IS < 関係閾値:2
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます。私、早起きは得意なんです。何かお手伝いしましょうか？」
					CASE 1
						KSTR:(K++) = 「あ、%CSTR:対象キャラ:二人称%。おはようございます。朝ごはん、もう食べましたか？」
				ENDSELECT
			CASE IS < 関係閾値:3
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%！　今日も一日、一緒に頑張りましょうね」
					CASE 1
						KSTR:(K++) = 「ふふ、おはようございます。朝一番に%CSTR:対象キャラ:二人称%のお顔が見られて、嬉しいです」
				ENDSELECT
			CASE IS < 関係閾値:4
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%。ふふ、寝癖が少しついてますよ？　直してあげますね」
					CASE 1
						KSTR:(K++) = 「おはようございます！　今日はどこに行きますか？　私、ずっと楽しみに待ってたんです」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「おはようございます、%CSTR:対象キャラ:二人称%_H_　えへへ、ずっと待ってました！」
					CASE 1
						KSTR:(K++) = 「おはようございます。……あの、今日もずっと、私の側にいてくれますか……？」
				ENDSELECT
		ENDSELECT
	;昼　11時～18時
	CASE 11*60 TO 18*60
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「こんにちは、%CSTR:対象キャラ:二人称%。お仕事、お疲れ様です」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「こんにちは。日差しが暖かくて、お散歩するのにぴったりですね」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「あ、%CSTR:対象キャラ:二人称%。ちょうどお昼休憩ですか？　もしよかったら、少しお話ししませんか？」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「こんにちは！　%CSTR:対象キャラ:二人称%を見かけると、なんだか足が勝手にそっちに向かっちゃいます」
			CASEELSE
				KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、こんにちは_H_　ふふ、お昼も一緒に過ごせたら嬉しいなって思ってました」
		ENDSELECT
	;夜　18時～
	CASEELSE
		SELECTCASE 関係レベル
			CASE IS < 関係閾値:1
				KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。夜の海も、静かで綺麗ですね」
			CASE IS < 関係閾値:2
				KSTR:(K++) = 「こんばんは。私、夜はあまり夜更かししないようにしてるんです」
			CASE IS < 関係閾値:3
				KSTR:(K++) = 「こんばんは。今日もお疲れ様でした。星がとっても綺麗ですよ」
			CASE IS < 関係閾値:4
				KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%。一日が終わっちゃうの、少し名残惜しいですね……」
			CASEELSE
				KSTR:(K++) = 「こんばんは、%CSTR:対象キャラ:二人称%……。おやすみするまで、もう少しだけ一緒にいたいです_H_」
		ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;恋慕自覚

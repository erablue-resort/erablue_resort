;口上テンプレートVer0.116/口上_キャラ名_ダンジョン探索中.ERBをコピーして作成。
;黎明の巫女後のサラ：旅への好奇心と、自分も仲間も生きて帰る意思を軸にしています。
;原作戦闘ボイスの出典は、ユーザー提供のstories/fate/サラ_黎明の巫女_フェイト.md。
;その他の台詞は、このゲームの探索状況に合わせたオリジナルです。

;****************************************
;ダンジョン探索中に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「130」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;「仲間と会話」ボタン押下時
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_別人版_130(対象キャラ)
#DIM 対象キャラ

;簡単に何度も見られるので、条件分岐やランダム化で複数パターンの登録を推奨

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)
SIF LOCAL < 0
	RETURN

IF BATTLE_STATE:LOCAL:ＨＰ <= 0
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「ごめんなさい……今は、うまく立てなくて……」
			KSTR:(K++) = 「少し休ませてもらっても、いいですか……？」
		CASE 1
			KSTR:(K++) = 「……グラフォス、私は大丈夫。皆さんのそばにいてあげて……」
	ENDSELECT
ELSEIF BATTLE_STATE:LOCAL:ＨＰ * 3 <= BATTLE_STATE:LOCAL:最大ＨＰ
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「……あの、少しだけ休憩してもいいですか？」
			KSTR:(K++) = 「無理をして、皆さんにもっと心配をかけるのは……嫌なんです」
		CASE 1
			KSTR:(K++) = 「痛いのは、少し怖いです。でも……ちゃんと言います」
			KSTR:(K++) = 「私も、グラフォスも、一緒に帰りたいから……」
		CASE 2
			KSTR:(K++) = 「グラフォス、そんな顔をしないで。隠したりしないから……」
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、傷の手当てをお願いしてもいいですか？」
	ENDSELECT
ELSEIF BATTLE_STATE:LOCAL:最大ＭＰ > 0 && BATTLE_STATE:LOCAL:ＭＰ * 4 <= BATTLE_STATE:LOCAL:最大ＭＰ
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「少し、力を使いすぎちゃったみたいです……」
			KSTR:(K++) = 「グラフォスにも休んでもらいたいので、ここでひと息つきませんか？」
		CASE 1
			KSTR:(K++) = 「次に皆さんを守る時、力が足りなかったら困るから……」
			KSTR:(K++) = 「先に進む前に、準備をしておきたいです」
		CASE 2
			KSTR:(K++) = 「大丈夫、グラフォス？　……うん、私も少し疲れたの」
			KSTR:(K++) = 「今日は無理をしないで、二人でちゃんと相談しよう？」
	ENDSELECT
ELSE
	SELECTCASE RAND:12
		CASE 0
			KSTR:(K++) = 「地図で見ていた場所を、自分の足で歩けるなんて……不思議です」
			KSTR:(K++) = 「まだ知らない景色が、この先にもあるんですね。ふふ、楽しみです」
		CASE 1
			KSTR:(K++) = 「グラフォスも、周りを気にしているみたいです」
			KSTR:(K++) = 「危ないものがあったら教えてね。……うん、頼りにしてるよ」
		CASE 2
			KSTR:(K++) = 「あの、足元には気をつけてください。慌てて歩くと、転んじゃうから……」
			KSTR:(K++) = 「私も、ボレミアに何度も言われたんです。ちゃんと覚えています」
		CASE 3
			KSTR:(K++) = 「初めての場所って、少しどきどきします」
			KSTR:(K++) = 「でも、怖いだけじゃなくて……来てよかったって思うことも、たくさんあるんです」
		CASE 4
			KSTR:(K++) = 「戻ったら、ルリアちゃんに今日のことを話したいです」
			KSTR:(K++) = 「一緒にお菓子を食べながら……ふふ。何から話そうかな」
		CASE 5
			KSTR:(K++) = 「ボレミアに、ちゃんと周りを見て歩くようにって言われています」
			KSTR:(K++) = 「……お姉ちゃん、帰ったらきっと、いっぱい質問すると思います」
		CASE 6
			KSTR:(K++) = 「グラフォスの声ですか？　私には、ちゃんと聞こえるんです」
			KSTR:(K++) = 「今は……皆さんとはぐれないように、って。ふふ、心配性ですよね」
		CASE 7
			KSTR:(K++) = 「前は、自分がどこへ行きたいかなんて、考えたこともなくて……」
			KSTR:(K++) = 「だから今、皆さんと相談して道を選べるのが、嬉しいです」
		CASE 8
			KSTR:(K++) = 「疲れたら、言ってください。私も、ちゃんとお伝えしますから」
			KSTR:(K++) = 「誰か一人が我慢するんじゃなくて、みんなで帰れたらいいなって……」
		CASE 9
			KSTR:(K++) = 「帰り道も覚えておかないと……ええっと、ここはさっき通ったところで……」
			KSTR:(K++) = 「……グラフォスも覚えてくれてるの？　ありがとう。でも、私も頑張るね」
		CASE 10
			KSTR:(K++) = 「旅先で見たことを、ジンさんにお話しすると、いつも楽しそうに聞いてくれるんです」
			KSTR:(K++) = 「今度は私も、ジンさんの旅のお話を聞いてみたいです」
		CASE 11
			KSTR:(K++) = 「%CSTR:対象キャラ:二人称%、次はどちらへ行きますか？」
			KSTR:(K++) = 「私も地図を見ていいですか？　……一緒に考えたいです」
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0,,対象キャラ)



;--------------------------------------------------
;固有スキル発動時
;--------------------------------------------------
@KOJO_DUNGEON_固有アビ発動時_別人版_130_1(対象キャラ, 使用アビ名)
#DIMS 使用アビ名
#DIM 対象キャラ
;「（キャラ名）の（アビ名）！」よりも前に表示される
;汎用アビや衣装アビだと発動しないので注意

;YYYYを固有アビ関数の「@固有アビ_別人版_130_1」のYYYYと同じに変更する
;使用したアビリティの名前は「使用アビ名」に入ってくる

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)
SIF LOCAL < 0
	RETURN

;ユーザー提供「サラ_黎明の巫女_フェイト.md」の戦闘ボイスを一部使用。
SELECTCASE RAND:3
	CASE 0
		KSTR:(K++) = 「皆さんのことを、私が守ります！」
	CASE 1
		KSTR:(K++) = 「グラフォス、お願い。みんなを包んで……！」
	CASE 2
		KSTR:(K++) = 「大丈夫です。私達の後ろにいてください！」
ENDSELECT

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ, , , , 対象キャラ)


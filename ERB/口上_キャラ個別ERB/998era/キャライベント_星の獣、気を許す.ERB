	PRINTBUTTONLC "[0] 視聴する", 0
	PRINTBUTTONLC "[1] 視聴せず戻る", 1
	PRINTL
	PRINTL
	BINPUT
	IF RESULT == 1
		RETURN 0
	ENDIF
ENDIF


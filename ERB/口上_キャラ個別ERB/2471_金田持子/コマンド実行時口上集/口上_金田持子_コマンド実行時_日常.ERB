;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「2471」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
	;-2の場合は会話出来なかった扱いなので何も言わないのがいいかも
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_2471_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗、会話系コマンドを連打しすぎて話題が尽きてしまったパターン
		KSTR:(K++) = 　
		KSTR:(K++) = 「いい加減、同じ話題ばかりで飽きましたわ……」
		KSTR:(K++) = 「自分が何を話したかくらい覚えておいてくれません？」
	CASE -1
		;失敗
		KSTR:(K++) = 　
		KSTR:(K++) = 「おーほっほっほっ‼」
		KSTR:(K++) = （%CALLNAME:MASTER%が何を言っているのか、分かりませんわ……）
		KSTR:(K++) = どうやら、_CALLNAME_の高笑いで話が聞こえなかったようだ。
	CASE 0
		;通常成功
		KSTR:(K++) = 「おーほっほっほっ‼　ワタクシの方がすごいですわーっ‼」
		KSTR:(K++) = 「明日また来なさい。セレブの力、見せてあげますわーっ」
		KSTR:(K++) = _CALLNAME_がよく分からないマウントをとってくる。
	CASEELSE
		;大成功
		KSTR:(K++) = 「おーほっほっほっ‼　おーほっほっほっ‼」
		KSTR:(K++) = 「所詮庶民ですわーっ‼　ワタクシの方が”上”なことが証明されてしまいましたわーっ‼」
		KSTR:(K++) = 高笑いの声量が普段の三割増しになっている。 _CALLNAME_はマウントを取れて満足なようだ。
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM301_お茶を淹れる
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功
;その場にいる全員が対象だが、口上は対面している相手のみ

;可能なら大成功で体力回復とか入れたい

@KOJO_COM_2471_301(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = _CALLNAME_がカップを持ち上げ、鼻に近づける
					KSTR:(K++) = （……えっ……何ですの、これ……）
					KSTR:(K++) = （香りも立っていないし……色のついた液体……？　肌に優しい系の美容オイル……？）
					KSTR:(K++) = （庶民はこんなものを飲むんですの……？）
				CASE 1
					KSTR:(K++) = _CALLNAME_が音を立てずにカップを傾けた。
					KSTR:(K++) = 「オエエエエ‼　何ですのこの色も味も悪い汁は……」
					KSTR:(K++) = セバスチャンは_CALLNAME_の吐瀉物をバケツで受けとめている。
			ENDSELECT
	CASE 0
		;通常成功
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「オホホ、庶民の紅茶はこんなものなんですのね～」
					KSTR:(K++) = 「セバス、シュタインタール茶園のスペシャル・ファイネスト・ティッピー・ゴールデン・フラワリー・オレンジ・ペコー１を淹れなさい」
					KSTR:(K++) = 聞き取れなかったが、何かの詠唱か？
				CASE 1
					KSTR:(K++) = 「へぇ～、身体を健やかにするお茶ですのね」
					KSTR:(K++) = 「ワタクシが淹れれば、からだハイパーすこやか茶２ＸTURBOですわーっ‼」
				CASE 2
					KSTR:(K++) = 「おーほっほっほ、茶柱が立っていますわーっ‼」
				ENDSELECT
	CASEELSE
		;大成功
		;認めるほどおいしかったから優位を取り返そうとしているイメージ
		KSTR:(K++) = 「庶民の癖に、なかなかやりますわね……」
		KSTR:(K++) = 「ですが、この程度で勝ったと思うだなんて浅い‼　浅すぎますわーっ‼」
		KSTR:(K++) = 「セバスチャン、セレブとの差を見せてあげなさい‼」
		KSTR:(K++) = 目の前で、茶会の会場が高速で設えられていく。
		KSTR:(K++) = 　
			SELECTCASE RAND:3
				CASE 0
				;体力回復とかつけたいね
					KSTR:(K++) = 「やっぱり、ティータイムにはティースタンドは欠かせませんわーっ」
					KSTR:(K++) = 三層に分けられ皿の上には、様々な菓子や軽食が並んでいる。
					KSTR:(K++) = 上部には色とりどりのマカロン、中段にはクラシックなスコーン、下段には塩気の効いたサンドイッチが揃えられている。
					KSTR:(K++) = そのどれもが%CALLNAME:MASTER%の淹れた茶と調和している。
					KSTR:(K++) = 「お茶しか飲まないなんて、実に庶民ですわーっ‼」
				CASE 1
				;野点が伝わるか不安
				;交流が普段より深まったようなボーナスつけたいね
					KSTR:(K++) = 急遽置かれた真っ赤な野点傘の下、_CALLNAME_と並んで毛氈に腰を下ろす。
					KSTR:(K++) = さっと漆塗りの小皿と菓子切りがセバスチャンから差し出された。
					KSTR:(K++) = その上には、鮮やかな彩をした上生菓子が置かれている。
					KSTR:(K++) = 「シチュエーションに気を配れないなんて、実に庶民ですわーっ‼」
				CASE 2
				;中国茶が伝わるか不安。無理そうならカット予定
				;パフォーマンスを見てその場にいるキャラとの交流も深まるボーナスつけたいね
					KSTR:(K++) = 「中国茶なのに、茶藝が足りませんわーっ。セバス、やりなさい」
					KSTR:(K++) = セバスチャンが%CALLNAME:MASTER%の目の前で新しい茶を淹れ始める。
					KSTR:(K++) = 小さな茶碗の中に茶葉を直接入れ、そこにお湯を投入した。
					KSTR:(K++) = 　
					KSTR:(K++) = 待ち時間も退屈させまいと、セバスチャンは茶碗の蓋を弄び始めた。
					KSTR:(K++) = 回転した蓋が茶碗の縁を滑り、そのまま彼の腕へ上る。
					KSTR:(K++) = そして、肩、反対の腕まで渡り、最後は元の茶碗の上へと戻り、すっぽりはまった。
					KSTR:(K++) = 茶器が傷つかないのは勿論、一切の水滴すら飛び散らせない絶技に見入ってしまう。
					KSTR:(K++) = 　
					KSTR:(K++) = 結局、追加で何煎もいただいてしまった。
					KSTR:(K++) = 「カフェインの摂り過ぎで、身体の震えが止まりませんわーっ‼　助けて下さいまし‼」
				ENDSELECT
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


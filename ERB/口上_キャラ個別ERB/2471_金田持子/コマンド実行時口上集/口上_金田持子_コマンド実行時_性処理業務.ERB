;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「2471」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;RFLAG:コマンド結果受渡し変数 = 1 だと恋慕のため基礎料金が無料である
;RFLAG:コマンド結果受渡し変数２ に実際の料金が入る

;各種性処理の_非口上時メッセージを参考に記述すると良い
;--------------------------------------------------
;選択肢前
;--------------------------------------------------
@KOJO_COM_2471_315_BEFORE(対象キャラ)
#DIM 対象キャラ

CALL 口上変数初期化
;このコマンドを頻繁に使うのか分からない。人によるだろうから、初回以外は短めに
;癖だけど、恋慕からは１ルピでいいからお金を払いたい。それとどの選択をしても事後描写を入れたい
IF TALENT:恋慕
	KSTR:(K++) = 「……はぁ。……_2nd_は意気地なしですのね」
	KSTR:(K++) = 「こんな形を取ることでしか、ワタクシに直接言い出せないんですの？」
	KSTR:(K++) = 　
	KSTR:(K++) = 「それとも、お金を渡すことでワタクシと対等になったつもりですの？」
	KSTR:(K++) = 「それなら、許して差し上げますわ_H_」
ELSE
	IF STRFIND(コマンド初回フラグ_PLAYER:2741:0, @"-315-") < 0
	; 315が初めて
		KSTR:(K++) = 「はぁ⁉　もう一度言って下さる⁉」
		KSTR:(K++) = 「このセレブの権化、むしろセレブそのものと言っても過言ではないワタクシが売春⁉」
		KSTR:(K++) = 「なんでそんな要求が通ると思ったんですの⁉　お金で道理を蹴っ飛ばすのはワタクシの専売特許ですわーっ‼」
		KSTR:(K++) = 　
		KSTR:(K++) = そうは言うものの、それ程ルピは持っていないんだろう？
		KSTR:(K++) = 毎回宝石を物々交換していては面倒だろう？
		KSTR:(K++) = 少しくらい現金を持っていてもいいんじゃないか？
		KSTR:(K++) = 　
		KSTR:(K++) = 「それは……そうですが……」
		KSTR:(K++) = 　
		KSTR:(K++) = _CALLNAME_の世界の住民にとって、異世界のリゾートなんて庶民には到底来れない場所だろう。
		KSTR:(K++) = この時点でセレブしか候補は残らない。
		KSTR:(K++) = だが、そんな場所でパパ活をするなんて並の金持ちは考えつかないはずだ。
		KSTR:(K++) = つまり、セレブを超えたセレブにしか許されない行為なんだぞ。
		KSTR:(K++) = 　
		KSTR:(K++) = 「……そうなんですの……?　何か……おかしいような?」
		KSTR:(K++) = 　
		KSTR:(K++) = このリゾートではパパ活くらいみんなやってるぞ。
		KSTR:(K++) = ここの従業員だって業務の一部として当然受け入れている。
		KSTR:(K++) = セレブっていうのは、意外と臆病なのか？　それとも、やり方も分からないのかな？
		KSTR:(K++) = 自信が無いのなら、無理しなくていいんだぞ。
		KSTR:(K++) = 　
		KSTR:(K++) = 「オーホッホッホ‼　このワタクシにマウントを取れるだなんて、思い上がりも甚だしいですわーっ‼」
		KSTR:(K++) = 「パパっと終わらせてしまいますわーっ‼」
		KSTR:(K++) = 「ところで、どんなことをするんですの？」
	ENDIF
	KSTR:(K++) = 「またですの⁉　またこのセレブなワタクシを買うつもりですの⁉」
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;振り分け処理
;--------------------------------------------------
@KOJO_COM_2471_315(対象キャラ)
#DIM 対象キャラ

;仕様上、性処理業務は全て同じコマンド扱いなのでここで分岐させる
;この関数は編集しないことを推奨
SELECTCASE RSTR:コマンド結果受渡し文字列
	CASE "手コキ処理"
		TRYCALLFORM KOJO_性処理_2471_手コキ処理(対象キャラ)
	CASE "パイズリ処理"
		TRYCALLFORM KOJO_性処理_2471_パイズリ処理(対象キャラ)
	CASE "フェラチオ処理"
		TRYCALLFORM KOJO_性処理_2471_フェラチオ処理(対象キャラ)
	CASE "手マン処理"
		TRYCALLFORM KOJO_性処理_2471_手マン処理(対象キャラ)
	CASE "クンニ処理"
		TRYCALLFORM KOJO_性処理_2471_クンニ処理(対象キャラ)
	CASE "セックス処理"
		TRYCALLFORM KOJO_性処理_2471_セックス処理(対象キャラ)
	CASE "被セックス処理"
		TRYCALLFORM KOJO_性処理_2471_被セックス処理(対象キャラ)
	CASE "アナルセックス処理"
		TRYCALLFORM KOJO_性処理_2471_アナルセックス処理(対象キャラ)
	CASE "被アナルセックス処理"
		TRYCALLFORM KOJO_性処理_2471_被アナルセックス処理(対象キャラ)
ENDSELECT


#DIM 対象キャラ
#DIM 実行キャラ番号
#DIM 対象キャラ番号
;モード解除は相手がPLAYERやTARGETとは限らないので別で渡す

;キャラが吸う方の口上
;取得快楽：Ｂ
CALL 口上変数初期化

IF 対象キャラ番号 == MASTER
	;相手があなたの時
	IF TALENT:実行キャラ番号:恋慕
		KSTR:(K++) = 「あら、ワタクシのを吸いたくなったんですの_H_
		KSTR:(K++) = 「_2nd_のを吸うのも良かったですわ_H_　ご馳走様_H_」
		KSTR:(K++) = _CALLNAME_は最後に甘噛みで形の良い歯形を残した。

	ELSEIF TALENT:実行キャラ番号:セフレ
		KSTR:(K++) = 
	ELSE
		KSTR:(K++) = 
	ENDIF
ENDIF

CALL 口上変数表示(実行キャラ番号, 0)


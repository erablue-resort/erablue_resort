;COM1_キス（むりやり）
;--------------------------------------------------
@KOJO_COM_むりやり_3798_1(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE IS < 0
		KSTR:(K++) = 「んっ……！　いきなり……ダメよ……！」
		PRINTL
		KSTR:(K++) = ぷいっと顔を背けるゲルダ。──でも、横目でちらっと%CALLNAME:MASTER%を見ている。次のキスを待っている目だった。
	CASEELSE
		IF TALENT:対象キャラ:妊娠
			IF TALENT:対象キャラ:淫乱
				KSTR:(K++) = 「んっ……！　おなかに赤ちゃんいるのに……むりやりなんて……んちゅっ……_H_」
				PRINTL
				KSTR:(K++) = 拒絶の声をあげながら、自分から舌を絡ませている。膨らんだおなかが%CALLNAME:MASTER%に押しつけられて、その奥で赤ちゃんがぽこりと動いた。
				PRINTL
				KSTR:(K++) = 「んぅ……赤ちゃんにキスの味、伝わっちゃうかしら……えへへ……でもやめない……_H_」
			ELSE
				KSTR:(K++) = 「んっ……もう……おなか大きいのに……急にしないでよ……」
				PRINTL
				KSTR:(K++) = 文句を言いながらも、ゲルダは唇を離さなかった。ちゅっ、と甘い音が漏れる。
				KSTR:(K++) = 膨らんだおなかが邪魔で、うまく体を寄せられない。──それがもどかしそうだった。
			ENDIF
		ELSEIF TALENT:対象キャラ:淫乱
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「んーっ！　むりやりキスなんて……んちゅ……っ……」
					PRINTL
					KSTR:(K++) = 抵抗しようとしたのに、唇が触れた瞬間に体の力が抜けた。自分から舌を絡めてきている。
					PRINTL
					KSTR:(K++) = 「……はぁ……もう。嫌って言ったのに……体が勝手に……ちゅぷ……んっ……_H_」
				CASEELSE
					KSTR:(K++) = 「やだっ……やめて……もう……んむっ……」
					PRINTL
					KSTR:(K++) = %CALLNAME:MASTER%の手が後頭部を掴んで強引に唇を重ねた。ゲルダが暴れるフリをする──が、瞳はとろんと蕩けている。
					PRINTL
					KSTR:(K++) = 「んぅ……むりやりされると……胸がどきどきして止まらないの……いじわる……_H_」
			ENDSELECT
		ELSEIF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「んっ……！　もう……急にしないでよ……」
			PRINTL
			KSTR:(K++) = 文句を言いながらも──唇を離さないゲルダ。ちゅっ、と甘い音が漏れた。
			PRINTL
			KSTR:(K++) = 「……嫌じゃないけど……せめて、声くらいかけてくれたらいいのに……ばか」
		ELSE
			KSTR:(K++) = 「んっ……！」
			PRINTL
			KSTR:(K++) = 不意打ちのキスにゲルダの全身が硬直した。目を白黒させて──それから、頬をぽっと赤く染めた。
			PRINTL
			KSTR:(K++) = 「……も、もう。びっくりしたわ。……でも……もう一回……いいの？」
		ENDIF
ENDSELECT


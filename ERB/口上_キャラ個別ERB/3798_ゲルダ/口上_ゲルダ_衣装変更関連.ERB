;--------------------------------------------------
;COM404_覗く
;--------------------------------------------------
@KOJO_COM_3798_404(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TALENT:対象キャラ:淫乱
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = ゲルダは鼻歌を歌いながら花に水をやっている。
			KSTR:(K++) = ふと振り返って、茂みに潜む%CALLNAME:MASTER%と目が合った。
			PRINTL
			KSTR:(K++) = 「あ、見つけた。……覗き？　いいわよ、もっと見ていて？　_H_」
			PRINTL
			KSTR:(K++) = わざとスカートの裾をひらりと持ち上げてみせた。
		CASEELSE
			KSTR:(K++) = ゲルダが窓際で髪を梳いている。指先が金色の毛先を流すたび、白いうなじが覗く。
			PRINTL
			KSTR:(K++) = 「……ふふ、気配でわかるのよ？　あたし、あなたの匂い、覚えちゃったから……_H_」
	ENDSELECT
ELSEIF TALENT:対象キャラ:恋慕
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = ゲルダが花壇の前にしゃがみ込んで、一つ一つの花に話しかけている。
			PRINTL
			KSTR:(K++) = 「大きくなってね……あたしが毎日お水あげるから……」
			PRINTL
			KSTR:(K++) = その横顔を%CALLNAME:MASTER%はそっと見守った。
		CASEELSE
			KSTR:(K++) = ゲルダが厨房で何かを作っている。鍋をかき混ぜる手つきは慣れたものだ。
			PRINTL
			KSTR:(K++) = 「♪～♪～」
			PRINTL
			KSTR:(K++) = 味見をして、満足そうに頷いた。──%CALLNAME:MASTER%の分も作っているのだろう。
	ENDSELECT
ELSE
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = ゲルダが島の地図を広げて首を傾げている。
			PRINTL
			KSTR:(K++) = 「ここが島で……ここがあたしが来たところで……うーん、こっちは何があるのかしら」
			PRINTL
			KSTR:(K++) = 集落の外の世界が広すぎて、まだ全部は把握できていないようだ。
		CASEELSE
			KSTR:(K++) = ゲルダが砂浜でぴょんぴょん跳ねている。
			PRINTL
			KSTR:(K++) = 「せーの……ぴょーん！」
			PRINTL
			KSTR:(K++) = 着地して、砂に足跡がついたのを見て嬉しそうに笑った。──跳んでも、ちゃんと戻ってこられる。
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM405_観察する
;--------------------------------------------------
@KOJO_COM_3798_405(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;%CALLNAME:MASTER%は周囲を見渡した（本体側で表示済み）
IF TALENT:対象キャラ:淫乱
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の視線に気づいて、にっこり笑った。
			PRINTL
			KSTR:(K++) = 「あたしのこと見てるの？　えへへ……何回見ても飽きない？　_H_」
			PRINTL
			KSTR:(K++) = 小首を傾げて、わざと上目遣いに見つめ返す。
		CASEELSE
			KSTR:(K++) = %CALLNAME:MASTER%の視線を感じて、ゲルダはくすりと笑った。
			PRINTL
			KSTR:(K++) = 「そんなに見つめられたら……期待しちゃうわよ？　_H_」
			PRINTL
			KSTR:(K++) = ケープの端を指先でくるくる弄びながら、頬を赤く染めた。
	ENDSELECT
ELSEIF TALENT:対象キャラ:恋慕
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の視線に気づいて、頬を赤くした。
			PRINTL
			KSTR:(K++) = 「な、なに……？　あたしの顔に何かついてる……？」
			PRINTL
			KSTR:(K++) = 慌てて頬を両手で擦る仕草が、集落の子どもそのものだった。
		CASEELSE
			KSTR:(K++) = 金色の髪が潮風に揺れている。日差しの中で、青緑の瞳が宝石のように光る。
			PRINTL
			KSTR:(K++) = 「……あなたに見てもらえると、なんだか嬉しいわ」
			PRINTL
			KSTR:(K++) = 照れくさそうに前髪を耳にかけた。
	ENDSELECT
ELSE
	SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = ゲルダが%CALLNAME:MASTER%を不思議そうに見つめ返した。
			PRINTL
			KSTR:(K++) = 「あたしのこと、珍しい？　集落の服が変なのかしら……」
			PRINTL
			KSTR:(K++) = 毛皮のケープをぎゅっと掴んで、きょとんとした顔をしている。
		CASEELSE
			KSTR:(K++) = ゲルダはちょうど花の手入れの最中だった。
			PRINTL
			KSTR:(K++) = 「あ、見てて！　この花ね、昨日より少し大きくなったの！」
			PRINTL
			KSTR:(K++) = 嬉しそうに指差すゲルダ。──花の成長を毎日記録しているらしい。
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;集落服に戻した時
;--------------------------------------------------
@KOJO_COM_3798_402(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RAND:2
	CASE 0
		KSTR:(K++) = 「あ……いつものお洋服ね。やっぱりこれが一番落ち着くわ」
		PRINTL
		KSTR:(K++) = 毛皮のケープに袖を通して、ゲルダはほっとした表情を見せた。──南国では暑いけれど、集落の匂いがする服が一番安心するのだ。
	CASEELSE
		KSTR:(K++) = 「集落のお洋服……ふふ、懐かしいわね。ケープがもこもこして、暑いけど」
		PRINTL
		KSTR:(K++) = ブローチを留めながら、ゲルダは少しだけ遠い目をした。──でもすぐに笑って、くるりと回ってみせた。
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;メイド服 / エプロン
;--------------------------------------------------
@KOJO_COM_3798_414(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TALENT:対象キャラ:淫乱
	KSTR:(K++) = 「あ、エプロン！　お料理用ね……って、スカートが短い……これ……お料理用じゃない……？　_H_」
	PRINTL
	KSTR:(K++) = フリルのついたメイド服を不思議そうに引っ張ってみる。しゃがむとスカートの中が丸見えだと気づいて──困るどころか、頬を染めて笑った。
	PRINTL
	KSTR:(K++) = 「えへへ……でもいいわ。あなたに見せるためのエプロンなのね……_H_」
ELSEIF TALENT:対象キャラ:恋慕
	KSTR:(K++) = 「これ……お料理のお手伝い用の服？　えっと……でも、ちょっとひらひらしすぎない……？」
	PRINTL
	KSTR:(K++) = 袖口のフリルを不思議そうに触るゲルダ。集落の実用的な服とはまるで違う──でも、鏡に映った自分を見て、少し嬉しそうだった。
	PRINTL
	KSTR:(K++) = 「あなた……似合ってる？　このお洋服で……パン焼いてもいい……？」
ELSE
	KSTR:(K++) = 「これがメイドっていうお仕事のお洋服なのね！　あたし、お手伝いなら得意よ」
	PRINTL
	KSTR:(K++) = 張り切ってエプロンの紐を結ぶゲルダ。──メイド服の本来の用途を、まだ知らなかった。
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;着替え完了（汎用）
;--------------------------------------------------
@KOJO_COM_3798_着替え完了(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RAND:2
	CASE 0
		KSTR:(K++) = 「えへへ……どう？　似合ってる……？」
		PRINTL
		KSTR:(K++) = くるりと一回転して見せるゲルダ。金色の髪が弧を描いた。──慣れない服にそわそわしながらも、その笑顔は花のように明るかった。
	CASEELSE
		KSTR:(K++) = 「お着替え完了！　ふふ、集落では一着しか服がなかったから……何着もあるって、すごいことよね」
		PRINTL
		KSTR:(K++) = 袖を通した新しい服を、ゲルダは嬉しそうに撫でた。
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)


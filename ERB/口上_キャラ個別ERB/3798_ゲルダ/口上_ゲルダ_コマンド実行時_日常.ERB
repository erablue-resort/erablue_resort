;****************************************
;ゲルダ（FGO 2部2章／北欧異聞帯・第23集落）Chara3798 コマンド実行時_日常
;****************************************

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
@KOJO_COM_3798_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		;大失敗：話題が尽きた
		KSTR:(K++) = ゲルダは口を開きかけて、けれど次の言葉が出てこないのか、眉をハの字にして小さく唸った。
		PRINTL
		KSTR:(K++) = 「えっと……あたし、何を話そうとしてたんだっけ……」
		PRINTL
		KSTR:(K++) = 金色の編み込みをいじりながら、困ったように首を傾げる。集落では話し相手が限られていたから、会話を広げるのがまだ得意ではないようだった。
	CASE -1
		;失敗
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「あ……あたし、また変なこと言っちゃったかしら……？」
			PRINTL
			KSTR:(K++) = 青緑の瞳がおずおずと%CALLNAME:MASTER%を見上げる。島に来てからたくさんのことを覚えたが、会話の機微はまだ難しい。指先でスカートの裾をぎゅっと握りしめていた。
		ELSE
			KSTR:(K++) = 「…………」
			PRINTL
			KSTR:(K++) = ゲルダは黙り込んでしまった。白い頬がわずかに赤い。──言葉を探しているのか、それとも恥ずかしいのか。毛皮のケープの下で肩が小さく震えていた。
		ENDIF
	CASE 0
		;成功
		IF TALENT:対象キャラ:妊娠
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「あのね……今日、この子がすごく動くの。ぽこぽこって」
					PRINTL
					KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の手を取って、膨らんだおなかに当てた。
					KSTR:(K++) = 服の下で、とくん、とくん、と小さな蹴りが伝わってくる。
					PRINTL
					KSTR:(K++) = 「あたしね……この子に、島のこと全部教えてあげたいの」
					KSTR:(K++) = 「海のこと、お花のこと、お魚のスープの作り方……」
					KSTR:(K++) = 「集落では誰もあたしに教えてくれなかったこと、あたしはこの子に全部教えてあげるの」
				CASE 1
					KSTR:(K++) = 「あなた……最近ね、あたし、夜中に目が覚めちゃうの」
					PRINTL
					KSTR:(K++) = 「この子がお腹の中で動くたびに、嬉しくなって……」
					KSTR:(K++) = 「集落ではね、赤ちゃんが動くとか、そういうこと誰も話さなかったわ」
					KSTR:(K++) = 「だからあたし、全部が新しくて……全部が嬉しいの」
				CASEELSE
					KSTR:(K++) = 「ねえ、この子は男の子かしら、女の子かしら」
					PRINTL
					KSTR:(K++) = ゲルダはおなかに頬を寄せるように前屈みになった。
					PRINTL
					KSTR:(K++) = 「どっちでもいいわ。……だってね、この子はあたしが選んだ人との子どもだもの」
					KSTR:(K++) = 「定められた子じゃないの。あたしたちが望んだ子よ」
			ENDSELECT
		ELSEIF TALENT:対象キャラ:淫乱
			SELECTCASE TIME
				CASE 5*60 TO 11*60
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「あ……おはよう。あのね、今朝は早く起きちゃったの。なんだか体がぽかぽかして……」
							PRINTL
							KSTR:(K++) = もじもじと太腿を擦り合わせながら、ゲルダは%CALLNAME:MASTER%の袖をきゅっと掴んだ。頬がほんのり上気して、青緑の瞳が潤んでいる。
							PRINTL
							KSTR:(K++) = 「集落にいたときは、こんな気持ちにならなかったのに……あなたの顔を見ると、おなかの奥がきゅうってなるの……_H_」
						CASE 1
							KSTR:(K++) = 「おはよう……あたし、また変な夢を見ちゃったわ。あなたが出てくる夢……えへへ、ないしょ……_H_」
							PRINTL
							KSTR:(K++) = 金色の髪を揺らしながら照れくさそうに笑う。スカートの下で両脚をもぞもぞさせている。──朝からどんな夢を見ていたのやら。
						CASEELSE
							KSTR:(K++) = 「おはよう……あのね、お花に水をあげてたら、あなたのこと考えちゃって……」
							PRINTL
							KSTR:(K++) = ゲルダはじょうろを両手で持ったまま、ぼんやりと%CALLNAME:MASTER%を見つめていた。白い指がじょうろの取っ手を握る力が、微かに震えている。
							PRINTL
							KSTR:(K++) = 「お花のつぼみが開くの、見てたら……あたしの体も、ぱぁって開いちゃいたくなって……変よね……？　_H_」
					ENDSELECT
				CASE 11*60 TO 18*60
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「あっ、見つけた！　あたし、さっきからずっとあなたのこと探してたのよ」
							PRINTL
							KSTR:(K++) = ぱたぱたと駆け寄ってきたゲルダの頬は、日差しのせいだけではなく赤い。%CALLNAME:MASTER%の手をぎゅっと握ると、指を絡めてきた。
							PRINTL
							KSTR:(K++) = 「あのね、あたし……今日はずっと、体がむずむずするの。あなたに触ってほしいの……ダメ……？　_H_」
						CASE 1
							KSTR:(K++) = 「あなた……えへへ、つかまえた。今日のお昼ごはん、一緒に食べてくれる？」
							PRINTL
							KSTR:(K++) = バスケットを差し出しながら、ゲルダはにっこりと笑った。──が、そのバスケットの中身が気になった。サンドイッチの他に、なぜか替えの下着が入っている。
							PRINTL
							KSTR:(K++) = 「あ……それは……お昼のあと……えっと……ふたりきりになれるところ、知ってるの……_H_」
						CASEELSE
							KSTR:(K++) = 「あなた……あたし、お昼なのに眠くなっちゃって……」
							PRINTL
							KSTR:(K++) = %CALLNAME:MASTER%の腕にもたれかかって、ゲルダは甘えるように目を細めた。うとうとしているように見えて、腰はそわそわと落ち着きがない。
							PRINTL
							KSTR:(K++) = 「お昼寝……一緒にしてくれない？　……ただ寝るだけじゃ、つまらないわ……_H_」
					ENDSELECT
				CASEELSE
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「こんばんは……あなた。今日の夜空、すごく綺麗なのよ。……でもね、あたし、星よりもあなたの方を見ちゃうの……_H_」
							PRINTL
							KSTR:(K++) = ゲルダの青緑の瞳に星明りが映る。その瞳はとろんと蕩けて、%CALLNAME:MASTER%だけを見つめていた。白い指が%CALLNAME:MASTER%の手に絡みつく。
						CASE 1
							KSTR:(K++) = 「あなた……夜の風って、あったかいのね。集落では夜は凍えるものだったのに」
							PRINTL
							KSTR:(K++) = 南国の夜風に髪をなびかせながら、ゲルダは%CALLNAME:MASTER%に身を寄せた。薄い服越しに伝わってくる体温が、やけに熱い。
							PRINTL
							KSTR:(K++) = 「……でもね、今いちばんあったかいのは……あなたのとなりにいるとき……だから今夜も……そばにいて……_H_」
						CASEELSE
							KSTR:(K++) = 「あなた……あたし、今夜はぜんぜん眠れそうにないの。だって、体がこんなに火照ってるのに……」
							PRINTL
							KSTR:(K++) = 白い頬を真っ赤にして、ゲルダは%CALLNAME:MASTER%の手を自分の胸元に押し当てた。薄い服の下で、小さな心臓がどきどきと跳ねている。
							PRINTL
							KSTR:(K++) = 「ね……一緒に寝て……？　あたしのこの気持ち、どうにかしてほしいの……_H_」
					ENDSELECT
			ENDSELECT
		ELSEIF TALENT:対象キャラ:恋慕
			SELECTCASE TIME
				CASE 5*60 TO 11*60
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「おはよう！　あなた、今日はいいお天気よ！　……集落ではね、こんなに晴れた日は年に何度もなかったの」
							PRINTL
							KSTR:(K++) = まぶしそうに空を見上げるゲルダの横顔が、朝の光に照らされて輝いていた。金髪のほつれが風に遊んでいる。
							PRINTL
							KSTR:(K++) = 「ふふ、島に来てから、あたし晴れの日が大好きになったわ。……あなたが隣にいるから、かもしれないけど」
						CASE 1
							KSTR:(K++) = 「おはよう、あなた！　あのね、今朝パンを焼いたの。あなたの分もあるわ！」
							PRINTL
							KSTR:(K++) = 湯気の立つ焼きたてパンを両手で差し出す。香ばしい匂いがふわりと広がった。ゲルダは目をきらきらさせて%CALLNAME:MASTER%の反応を待っている。
							PRINTL
							KSTR:(K++) = 「集落のレシピにね、島のバターを混ぜてみたの。……どう？　おいしい？」
						CASEELSE
							KSTR:(K++) = 「おはよう……あなた。えへへ、あたし今日はちょっと寝坊しちゃったの」
							PRINTL
							KSTR:(K++) = まだ少し眠そうな目を擦りながら、ゲルダは%CALLNAME:MASTER%のそばにとことこ歩いてきた。金色の髪に寝ぐせがぴょこんと跳ねている。
							PRINTL
							KSTR:(K++) = 「あたしの集落ではね、寝坊なんてしたことなかったわ。……だって、ここのお布団、ふわふわすぎるんだもの」
					ENDSELECT
				CASE 11*60 TO 18*60
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「あ、あなた！　見て見て、お花が咲いたの！」
							PRINTL
							KSTR:(K++) = ゲルダが嬉しそうに花壇を指差した。色とりどりの南国の花が、太陽の下で誇らしげに咲き誇っている。
							PRINTL
							KSTR:(K++) = 「集落のお花はね、白と薄紫ばっかりだったの。こんなに色がいっぱいあるなんて、あたし初めて知ったわ……素敵ね」
						CASE 1
							KSTR:(K++) = 「あなた、あのね。今日、市場でとっても変な果物を見つけたの。黄色くて、とげとげしてて……」
							PRINTL
							KSTR:(K++) = 両手でパイナップルを抱えたゲルダが、困惑と好奇心の入り混じった顔で%CALLNAME:MASTER%を見上げている。
							PRINTL
							KSTR:(K++) = 「これ、食べられるの？　……えっ、甘いの！？　あたし、食べてみたい！」
						CASEELSE
							KSTR:(K++) = 「あなた、あたしね、海で泳ぐ練習をしてるの。まだ足がつくところまでだけど……」
							PRINTL
							KSTR:(K++) = 砂浜で膝まで海に浸かったゲルダが、両手を広げてバランスを取っている。波が来るたびに小さく「きゃっ」と声を上げていた。
							PRINTL
							KSTR:(K++) = 「集落には泳ぐ場所なんてなかったもの。……でもね、あなたが見ていてくれるなら、もうちょっと深いところに行ってみたいわ」
					ENDSELECT
				CASEELSE
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「こんばんは、あなた。ねえ、お星さまって……あんなにたくさんあるのね」
							PRINTL
							KSTR:(K++) = 夜空を見上げるゲルダの青緑の瞳に、星の光が散りばめられていた。集落では分厚い雲とオーロラに遮られて、星空を見る機会は少なかったらしい。
							PRINTL
							KSTR:(K++) = 「あたしの集落ではね、七色の虹をときどき見たの。でも、満天の星空はお話の中だけだと思ってた。……すごいわ」
						CASE 1
							KSTR:(K++) = 「あなた、あたしね、夜の虫の声がまだ怖いの。集落では夜はしんとしていたから……」
							PRINTL
							KSTR:(K++) = きゅっと%CALLNAME:MASTER%の袖を掴んで、ゲルダは少しだけ体を寄せてきた。頬に触れる夜風が温かい。
							PRINTL
							KSTR:(K++) = 「……でもね、あなたが隣にいると、怖くないの。不思議ね」
						CASEELSE
							KSTR:(K++) = 「こんばんは。あのね、今日はスープをたくさん作ったの。あなたにも飲んでほしいわ」
							PRINTL
							KSTR:(K++) = 土鍋を両手で抱えたゲルダが、得意げに微笑んだ。ふたを開けると、魚と野菜の柔らかな香りが立ち上る。
							PRINTL
							KSTR:(K++) = 「第23集落の味を、島の食材で再現してみたの。……ラウラにも飲ませてあげたかったな」
							PRINTL
							KSTR:(K++) = 一瞬だけ寂しそうな顔をして──でもすぐに笑顔に戻った。
					ENDSELECT
			ENDSELECT
		ELSE
			;非恋慕
			SELECTCASE TIME
				CASE 5*60 TO 11*60
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「おはよう！　今日も暑くなりそうね。……あたし、まだこの暑さには慣れないわ」
							PRINTL
							KSTR:(K++) = ゲルダはパタパタと手で顔を扇ぎながら、それでもどこか楽しそうに笑った。金色の髪が汗でうなじに張り付いている。
						CASEELSE
							KSTR:(K++) = 「おはよう。あのね、今朝は集落のことを思い出してたの」
							PRINTL
							KSTR:(K++) = ゲルダは少しだけ遠い目をして、すぐに首を横に振った。
							PRINTL
							KSTR:(K++) = 「……ううん、大丈夫。今日は何をするの？　あたし、お手伝いできることがあったら何でも言ってね」
					ENDSELECT
				CASE 11*60 TO 18*60
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「あ、こんにちは！　ねえねえ、あのお魚は何ていう名前なの？　青くてぴかぴかしてたわ！」
							PRINTL
							KSTR:(K++) = 目をまん丸くして身振り手振りで説明するゲルダ。島の生き物すべてが、彼女にとっては新鮮な発見だった。
						CASEELSE
							KSTR:(K++) = 「こんにちは。今日は花壇のお手入れをしてたの。南国のお花って、育て方が全然違うのね」
							PRINTL
							KSTR:(K++) = 土で汚れた手を見せながら、ゲルダは少し困ったように微笑んだ。
							PRINTL
							KSTR:(K++) = 「集落ではお花を育てるのは子どもの大事な仕事だったの。……ここでも、あたしにやらせてもらえると嬉しいわ」
					ENDSELECT
				CASEELSE
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「こんばんは。ふふ、夜の風って気持ちいいわね。集落の夜は、外に出たら凍えちゃうから……」
							PRINTL
							KSTR:(K++) = 夜風に髪をなびかせながら、ゲルダは深く息を吸い込んだ。潮の匂いに目を細める。
						CASEELSE
							KSTR:(K++) = 「あ、こんばんは。……あのね、あたし、夜はまだちょっと寂しくなるの」
							PRINTL
							KSTR:(K++) = ゲルダはぽつりとそう言って、すぐに「でも大丈夫よ」と付け足した。強がっているのか、本当に大丈夫なのか──微笑みの奥は読めなかった。
					ENDSELECT
			ENDSELECT
		ENDIF
ENDSELECT
CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM301_褒める
;--------------------------------------------------
@KOJO_COM_3798_301(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		KSTR:(K++) = ゲルダはぱちぱちと瞬きをして、それから困ったように眉を下げた。
		PRINTL
		KSTR:(K++) = 「えっと……褒めてくれてるの？　あたし、ちょっとよくわからなかったわ……」
	CASE -1
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「あ……あたしなんか、褒められるようなことしてないわ」
			PRINTL
			KSTR:(K++) = 照れくさそうに俯いたが、口元がわずかに綻んでいる。嬉しくないわけではないらしい。
		ELSE
			KSTR:(K++) = 「あ、ありがとう……でも、あたし、そんなに褒められること……してないと思うわ」
			PRINTL
			KSTR:(K++) = ゲルダは戸惑ったように首を傾げた。褒められること自体に慣れていないようだった。
		ENDIF
	CASEELSE
		IF TALENT:対象キャラ:淫乱
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「えへへ……褒めてくれるの？　嬉しいわ……あたしのこと、もっと褒めて……？」
					PRINTL
					KSTR:(K++) = 甘えるように%CALLNAME:MASTER%の手を取って、自分の頬に当てた。とろんとした青緑の瞳が、下から%CALLNAME:MASTER%を見上げている。
					PRINTL
					KSTR:(K++) = 「あたしね……あなたに褒められると、体がぽかぽかして……おなかの奥がきゅってなるの……_H_」
				CASEELSE
					KSTR:(K++) = 「んふふ……あたしのこと、好き……？　あたしはね、あなたのこと大好きよ……_H_」
					PRINTL
					KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の腕に抱きついてきた。薄い服越しに、小さな体の温かさが伝わってくる。
					PRINTL
					KSTR:(K++) = 「褒められると……あたし、もっとあなたに褒めてもらえることしたくなっちゃうの……えっちなことでも……_H_」
			ENDSELECT
		ELSEIF TALENT:対象キャラ:恋慕
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「えっ……あ、あたしを褒めてくれるの……？」
					PRINTL
					KSTR:(K++) = 白い頬がみるみるうちに赤く染まる。両手で顔を覆って、指の隙間からちらちらと%CALLNAME:MASTER%を覗き見ていた。
					PRINTL
					KSTR:(K++) = 「……嬉しいわ。すごく嬉しい。あたし、褒められるの……慣れてなくて……でも、あなたに言ってもらえると、特別な気持ちになるの」
				CASE 1
					KSTR:(K++) = 「あ……ありがとう。えへへ、なんだか照れちゃうわね」
					PRINTL
					KSTR:(K++) = 金色の編み込みをいじりながら、ゲルダは嬉しそうにはにかんだ。青緑の瞳が潤んで、きらきらと光っている。
					PRINTL
					KSTR:(K++) = 「あたしね、集落ではみんな同じことをしてたから、褒められることってあんまりなかったの。だから……すごく嬉しい」
				CASEELSE
					KSTR:(K++) = 「あ……ありがとう。あたし……もっと頑張るね！」
					PRINTL
					KSTR:(K++) = ゲルダはぐっと小さな拳を握って、目を輝かせた。褒められたことが素直に嬉しいらしい。尻尾があったら千切れんばかりに振っていただろう。
			ENDSELECT
		ELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「えっ……あ、ありがとう」
					PRINTL
					KSTR:(K++) = ゲルダは一瞬きょとんとして、それからぱっと笑顔になった。
					PRINTL
					KSTR:(K++) = 「あたし、この島に来てから褒められることが増えたわ。集落では当たり前のことでも、ここでは特別なのね」
				CASEELSE
					KSTR:(K++) = 「えへへ……そう？　あたし、頑張ったかしら」
					PRINTL
					KSTR:(K++) = 照れくさそうに鼻の頭を掻きながら、ゲルダは小さく笑った。素朴な喜びが、まっすぐに表情に出る子だった。
			ENDSELECT
		ENDIF
ENDSELECT
CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM302_頭を撫でる
;--------------------------------------------------
@KOJO_COM_3798_302(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		KSTR:(K++) = 「ひゃっ……？　び、びっくりしたわ……」
		PRINTL
		KSTR:(K++) = 不意に頭を触られて、ゲルダは体を強張らせた。まだ警戒が解けていないのかもしれない。
	CASE -1
		KSTR:(K++) = 「あ……」
		PRINTL
		KSTR:(K++) = ゲルダは身を引きかけて、けれど逃げなかった。撫でられるのが嫌なわけではないようだが、どう反応していいのか戸惑っているようだった。
	CASEELSE
		IF TALENT:対象キャラ:淫乱
			SELECTCASE RAND:2
				CASE 0

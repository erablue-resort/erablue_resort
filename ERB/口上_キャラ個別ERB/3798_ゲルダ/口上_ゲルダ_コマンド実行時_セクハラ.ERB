;--------------------------------------------------
;COM307_スカートめくり
;--------------------------------------------------
@KOJO_COM_3798_307(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -2
		KSTR:(K++) = 「きゃあっ！？　ス、スカートめくらないで！」
		PRINTL
		KSTR:(K++) = ゲルダは慌ててスカートを押さえた。くるぶしまであるスカートの裾が一瞬だけ捲り上がって、白い脚がちらりと覗く。
	CASE -1
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「あっ……も、もう……なんでめくるの……」
			PRINTL
			KSTR:(K++) = 恥ずかしそうにスカートの前を押さえるゲルダ。頬が真っ赤に染まっているが、%CALLNAME:MASTER%を睨みつけるような鋭さはない。
		ELSE
			KSTR:(K++) = 「わっ……何するの！？」
			PRINTL
			KSTR:(K++) = 驚いてスカートを掴むゲルダ。集落ではスカートをめくるという概念すらなかったのか、驚きの方が大きい。
		ENDIF
	CASEELSE
		IF TALENT:対象キャラ:淫乱
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「あ……見たいの？　えへへ……いいわよ、見て……_H_」
					PRINTL
					KSTR:(K++) = ゲルダはぱっとスカートの裾を掴んで、自分からふわりと持ち上げた。すべすべの白い太腿の奥に、シンプルな白い木綿の下着が覗く。股布の中央に小さなシミができている。
					PRINTL
					KSTR:(K++) = 「あたしの下着……もう濡れちゃってるの……あなたが見てるだけで……おまた、熱くなっちゃうんだもの……_H_」
				CASEELSE
					KSTR:(K++) = 「んふふ……今日はね、下着はいてないの……見る……？　_H_」
					PRINTL
					KSTR:(K++) = いたずらっぽく笑いながら、ゲルダがスカートをめくった。白い太腿の上には何もなく、ぷっくりとした幼い裂け目がそのまま露わになる。うっすらと愛液で光っていた。
					PRINTL
					KSTR:(K++) = 「えへへ……あなたに見せたくて、今日はわざとはいてこなかったの……いけない子でしょ？　_H_」
			ENDSELECT
		ELSEIF TALENT:対象キャラ:恋慕
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「あ……も、もう……」
					PRINTL
					KSTR:(K++) = めくられたスカートの奥、白い木綿の下着が目に入る。島でもらった素朴なデザインのそれは、ゲルダの清楚さをそのまま映していた。
					PRINTL
					KSTR:(K++) = 「……あなたにだけだからね？　見ていいの。……恥ずかしいけど……嫌じゃないの」
				CASEELSE
					KSTR:(K++) = 「ひゃっ……見ちゃダメ……でも……」
					PRINTL
					KSTR:(K++) = 両手でスカートを押さえるゲルダ。だが押さえる力は弱く、指の隙間からほんのりピンクに色づいた太腿の肌が覗いている。
					PRINTL
					KSTR:(K++) = 「……ちょっとだけなら……見てもいいわ。ちょっとだけよ？」
			ENDSELECT
		ELSE
			KSTR:(K++) = 「ひゃ……！　な、何するのよっ」
			PRINTL
			KSTR:(K++) = あたふたとスカートを押さえるゲルダ。めくられる、という概念に慣れていないらしく、驚きが先に立っている。
			PRINTL
			KSTR:(K++) = 「島の人たちは、スカートをめくるのが普通なの？　……普通じゃないわよね？」
		ENDIF
ENDSELECT
CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------

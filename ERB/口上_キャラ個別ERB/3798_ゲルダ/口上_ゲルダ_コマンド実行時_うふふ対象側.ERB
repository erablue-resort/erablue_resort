@KOJO_COM_3798_3(対象キャラ)

#DIM 対象キャラ

CALL 口上変数初期化



SELECTCASE RFLAG:コマンド結果受渡し変数

	CASE IS < 0

		KSTR:(K++) = 「ひゃっ！？　な、なに!?　そんなところ……舐めちゃダメよ……っ」

		PRINTL

		KSTR:(K++) = ゲルダが慌てて太腿を閉じようとしたが、%CALLNAME:MASTER%の頭を挟む形になってしまい、余計に動けなくなった。

	CASEELSE

		IF STRFIND(コマンド初回フラグ:対象キャラ:0, "@-3-") < 0

			KSTR:(K++) = %CALLNAME:MASTER%がゲルダの太腿の間に顔を埋めた。

			PRINTL

			KSTR:(K++) = 「えっ……ちょっ……そこ……おしっこするところよ……！？　何して──ひゃぁっ！！」

			PRINTL

			KSTR:(K++) = 舌先が割れ目をなぞった瞬間、ゲルダの体が弓なりに反った。薄い花弁のような小陰唇がぴくぴくと震え、透明な蜜がじわりと滲み出す。

			PRINTL

			KSTR:(K++) = 「やぁ……っ、なに……なにこれ……っ、すごい……体が……溶けちゃう……っ」

			PRINTL

			KSTR:(K++) = 金色の髪が乱れ、シーツを握る指が白くなるほど力が入っている。──集落では決して教わることのなかった快感が、小さな体を駆け巡っていた。

		ELSE

			IF TALENT:対象キャラ:淫乱

				SELECTCASE RAND:3

					CASE 0

						KSTR:(K++) = 「あっ……んんっ……舌……そこ……豆みたいなところ……そこがいいの……_H_」

						PRINTL

						KSTR:(K++) = ゲルダが自分で太腿を開いて、%CALLNAME:MASTER%の頭を引き寄せた。薄桃色の粘膜がてらてらと光り、クリトリスが小さく勃起している。

						PRINTL

						KSTR:(K++) = 「じゅるって……吸って……はぁっ……あたしの中から……お汁がとまらない……_H_」

						PRINTL

						KSTR:(K++) = 舌が粘膜を這うたびに、幼い膣口からとろりと愛液が溢れ出す。甘酸っぱい匂いが%CALLNAME:MASTER%の顔を包んだ。

					CASE 1

						KSTR:(K++) = 「ねえ……奥まで舌入れて……？　おまんこの中……ぜんぶ舐めて……_H_」

						PRINTL

						KSTR:(K++) = 細い指で自分の花弁をくぱぁと開いて見せる。内壁がぬるぬると光り、蜜が糸を引いて零れた。

						PRINTL

						KSTR:(K++) = 「んっ……あっ……舌がうねうねする……おなかの中で……何かが……はぁっ……_H_」

					CASEELSE

						KSTR:(K++) = 「あなたの舌……すごいの……あたしのおまんこ……全部知られちゃう……_H_」

						PRINTL

						KSTR:(K++) = %CALLNAME:MASTER%の舌がクリトリスの包皮をめくり上げ、むき出しの豆粒を直接舐め上げた。ゲルダの腰がびくんと跳ねる。

						PRINTL

						KSTR:(K++) = 「ひぁっ……そこダメ……でもやめないで……もっとして……あたし……おかしくなっちゃう……_H_」

						PRINTL

						KSTR:(K++) = 細い脚が%CALLNAME:MASTER%の頭を挟み込む。溢れる愛液が顎を伝い、シーツに染みを広げていた。

				ENDSELECT

			ELSEIF TALENT:対象キャラ:恋慕

				SELECTCASE RAND:2

					CASE 0

						KSTR:(K++) = 「あっ……んっ……舌……あったかい……」

						PRINTL

						KSTR:(K++) = ゲルダが恥ずかしそうに腕で顔を覆った。けれど腰は逃げずに、むしろ小さく押し付けるように揺れている。

						PRINTL

						KSTR:(K++) = 「……こんなところ……汚くないの……？　あたし……嬉しいけど……はずかしいわ……」

					CASEELSE

						KSTR:(K++) = 「ふぁ……っ、あ……」

						PRINTL

						KSTR:(K++) = %CALLNAME:MASTER%の舌が花弁の間をゆっくりと這い上がる。ゲルダの細い腰がぴくん、ぴくんと小刻みに揺れた。

						PRINTL

						KSTR:(K++) = 「あなたの息が……あたしの中に……はぁ……あったかくて……とろけちゃいそう……」

				ENDSELECT

			ELSE

				KSTR:(K++) = 「んっ……あ……っ」

				PRINTL

				KSTR:(K++) = 舌が秘部に触れるたび、ゲルダの体が反射的に跳ねる。何が起きているのか理解が追いつかない──けれど、止めてとは言えなかった。

				PRINTL

				KSTR:(K++) = 「変な感じ……でも……嫌じゃない……なんで……？」

			ENDIF

		ENDIF

ENDSELECT




@KOJO_COM_3798_1(対象キャラ)

#DIM 対象キャラ

CALL 口上変数初期化



SELECTCASE RFLAG:コマンド結果受渡し変数

	CASE -2

		;大失敗

		KSTR:(K++) = ゲルダが慌てて顔を背けた。唇は空を切って、金色の髪をかすめただけ。

		PRINTL

		KSTR:(K++) = 「ご、ごめんなさい……あたし、こういうの……どうしたらいいのかわからなくて……」

		PRINTL

		KSTR:(K++) = 青緑の瞳がおろおろと泳ぐ。集落には口づけの文化がなかったのだろう──戸惑いが体中から滲み出ていた。

	CASE -1

		;失敗

		KSTR:(K++) = 「んっ……あ……」

		PRINTL

		KSTR:(K++) = 唇が触れかけて、ゲルダがぎゅっと目をつぶった。硬くなった肩が小刻みに震えている。

		PRINTL

		KSTR:(K++) = 「……ごめんね。嫌じゃないの。ただ……心臓がどきどきしすぎて、息ができなくなっちゃう」

	CASEELSE

		;成功以上

		;コマンド初回判定

		IF STRFIND(コマンド初回フラグ:対象キャラ:0, "@-1-") < 0

			KSTR:(K++) = %CALLNAME:MASTER%がゆっくりとゲルダの顎に手を添えた。金色のまつ毛がぱちぱちと瞬く。

			PRINTL

			KSTR:(K++) = 「え……なに？　顔、近い──」

			PRINTL

			KSTR:(K++) = 言葉は最後まで続かなかった。柔らかな唇が重なる。ゲルダの青緑の瞳がまんまるに見開かれて──それから、とろんと細められた。

			PRINTL

			KSTR:(K++) = 「……っ、は……」

			PRINTL

			KSTR:(K++) = 唇が離れると、ゲルダは茫然と自分の唇に指を当てた。

			PRINTL

			KSTR:(K++) = 「あたし……知らなかった。口と口をくっつけると……こんなにあったかい気持ちになるのね……」

			PRINTL

			KSTR:(K++) = 「集落では、誰もこんなことしなかったわ。……もう一回、してもいい……？」

		ELSE

			IF TALENT:対象キャラ:淫乱

				SELECTCASE RAND:3

					CASE 0

						KSTR:(K++) = 「ん……ちゅっ……んんっ……_H_」

						PRINTL

						KSTR:(K++) = ゲルダの方から唇を押し付けてきた。小さな舌がぎこちなく、けれど必死に%CALLNAME:MASTER%の唇をなぞる。

						PRINTL

						KSTR:(K++) = 「あなたの唾液……甘いわ……蜂蜜酒みたい……もっとちょうだい……_H_」

						PRINTL

						KSTR:(K++) = 吸いつくように深く口づけながら、ゲルダの細い指が%CALLNAME:MASTER%の服を掴んで離さない。蕩けた瞳の端に、うっすらと涙が光っていた。

					CASE 1

						KSTR:(K++) = ゲルダが背伸びをして、%CALLNAME:MASTER%の唇に自分の唇を押し当てた。

						PRINTL

						KSTR:(K++) = 「んっ……ちゅる……はぁ……舌……からませて……_H_」

						PRINTL

						KSTR:(K++) = 舌と舌が絡み合うと、口の端から透明な唾液がつぅっと糸を引いて顎を伝った。ゲルダの頬がぽっと赤く染まる。

						PRINTL

						KSTR:(K++) = 「あたしの口の中……あなたの味でいっぱい……焼きたてのパンみたいに……あったかいの……_H_」

					CASEELSE

						KSTR:(K++) = 「ねえ……もっと深くして……？　奥まで……舌、入れて……_H_」

						PRINTL

						KSTR:(K++) = 自分から口を大きく開いて、%CALLNAME:MASTER%を誘う。舌を絡めるとびくんと肩が跳ね、甘い吐息が漏れた。

						PRINTL

						KSTR:(K++) = 「んぅ……じゅるっ……はぁ……キスしてると……おなかの奥が……きゅぅってなる……_H_」

				ENDSELECT

			ELSEIF TALENT:対象キャラ:恋慕

				SELECTCASE RAND:2

					CASE 0

						KSTR:(K++) = 「ん……っ」

						PRINTL

						KSTR:(K++) = そっと目を閉じて、ゲルダは%CALLNAME:MASTER%に唇を預けた。指先が%CALLNAME:MASTER%の胸元をきゅっと掴む。

						PRINTL

						KSTR:(K++) = 「……はぁ。あなたとキスすると、胸の奥がぽかぽかするの。集落のみんなは知らなかったけど……あたしは知っちゃった。ふふ」

					CASEELSE

						KSTR:(K++) = ゲルダがつま先立ちになって、ちょん、と%CALLNAME:MASTER%の唇に触れた。

						PRINTL

						KSTR:(K++) = 「えへへ……あたしの方からしちゃった。いいでしょ？」

						PRINTL

						KSTR:(K++) = 照れくさそうに笑って、それからもう一度、今度はゆっくりと唇を重ねる。小さな吐息が二人の間で溶けていった。

				ENDSELECT

			ELSE

				SELECTCASE RAND:2

					CASE 0

						KSTR:(K++) = 「ん……っ」

						PRINTL

						KSTR:(K++) = 唇が触れると、ゲルダの全身がぴくりと強張った。けれど逃げはしない──目をぎゅっとつぶって、息を止めてじっとしている。

						PRINTL

						KSTR:(K++) = 「……はぁ。変な感じ……でも……嫌じゃないの」

					CASEELSE

						KSTR:(K++) = %CALLNAME:MASTER%の唇がそっとゲルダの唇に触れた。小さな体がびくっと震える。

						PRINTL

						KSTR:(K++) = 「あ……あったかい……これが、キス……？」

						PRINTL

						KSTR:(K++) = 青緑の瞳がぱちぱちと瞬く。頬を赤く染めて、ゲルダはおずおずと自分の唇に指を当てた。

				ENDSELECT

			ENDIF

		ENDIF

ENDSELECT




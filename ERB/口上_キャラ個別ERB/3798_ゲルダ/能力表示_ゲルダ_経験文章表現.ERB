;****************************************
;ゲルダ（FGO 2部2章／北欧異聞帯・第23集落）Chara3798 経験文章表現
;****************************************

@能力表示_経験文章表現_3798(対象キャラ, 表示種類, 表示数値)
#DIM 対象キャラ
#DIM 表示種類
#DIM 表示数値

;表示種類: 0=V経験 1=A経験 2=口経験 3=胸経験 4=手経験
;表示数値: 経験値

SELECTCASE 表示種類
	CASE 0
		;V経験
		SELECTCASE 表示数値
			CASE 0
				RESULTS = 花のつぼみ
			CASE IS <= 10
				RESULTS = ほんの少しだけ開いた花
			CASE IS <= 50
				RESULTS = 蕾がほころび始めた花
			CASE IS <= 200
				RESULTS = 甘露を知った花
			CASE IS <= 500
				RESULTS = 蜜を溢れさせる花
			CASEELSE
				RESULTS = 誰かの手がないと枯れてしまう花
		ENDSELECT
	CASE 1
		;A経験
		SELECTCASE 表示数値
			CASE 0
				RESULTS = 未知の場所
			CASE IS <= 10
				RESULTS = 恐る恐る触れた場所
			CASE IS <= 50
				RESULTS = 少しだけ慣れた場所
			CASE IS <= 200
				RESULTS = 新しい遊び場
			CASEELSE
				RESULTS = 秘密の裏口
		ENDSELECT
	CASE 2
		;口経験
		SELECTCASE 表示数値
			CASE 0
				RESULTS = お魚のスープしか知らない口
			CASE IS <= 10
				RESULTS = しょっぱい味を覚えた口
			CASE IS <= 50
				RESULTS = ちゅぱちゅぱが上手になった口
			CASE IS <= 200
				RESULTS = おちんちんの味がわかる口
			CASEELSE
				RESULTS = 精液が大好きな口
		ENDSELECT
	CASE 3
		;胸経験
		SELECTCASE 表示数値
			CASE 0
				RESULTS = まだ膨らみ始めたばかり
			CASE IS <= 10
				RESULTS = 触られるとびくっとする胸
			CASE IS <= 50
				RESULTS = 乳首が敏感になった胸
			CASE IS <= 200
				RESULTS = 揉まれると甘い声が出る胸
			CASEELSE
				RESULTS = 乳首だけでイけちゃう胸
		ENDSELECT
	CASE 4
		;手経験
		SELECTCASE 表示数値
			CASE 0
				RESULTS = パンをこねるのが得意な手
			CASE IS <= 10
				RESULTS = おちんちんの握り方を覚えた手
			CASE IS <= 50
				RESULTS = 上手にしごける手
			CASE IS <= 200
				RESULTS = どこを触ると気持ちいいか知ってる手
			CASEELSE
				RESULTS = 精液まみれが当たり前の手
		ENDSELECT
ENDSELECT



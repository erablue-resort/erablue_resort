;****************************************
;ゲルダ（FGO 2部2章／北欧異聞帯・第23集落）Chara3798 ステータス画面
;一言コメント＋好感度コメント＋キャラ解説
;****************************************

;--------------------------------------------------
;通常画面一言口上（1行のみ、うふふ中は非表示）
;--------------------------------------------------
@口上_INFO画面_一言コメント_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	IF TALENT:対象キャラ:淫乱
		KSTR:(K++) = 「はぁ……もっと……して……_H_」
	ELSE
		KSTR:(K++) = 「ひゃ……あぅ…………」
	ENDIF
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 常駐業務_場所番号変換(現在仕事:対象キャラ:1) && CFLAG:対象キャラ:現在マップ種別 == 部屋検索_マップ種別
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 1
			KSTR:(K++) = 「いらっしゃいませ！ ……で合ってる？」
		CASE 2
			KSTR:(K++) = 「お魚のスープ、作ってるの」
		CASE 3
			KSTR:(K++) = 「昔話の本、読んでるわ」
		CASE 4
			KSTR:(K++) = 「あの水、怖くないのよ？」
		CASE 5
			KSTR:(K++) = 「お魚がいっぱい！ すごいわ！」
		CASE 6
			KSTR:(K++) = 「海の底……綺麗ね……」
		CASE 100 TO 199
			KSTR:(K++) = 「お店番、頑張ってるわ！」
	ENDSELECT
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;状況分岐
IF CFLAG:対象キャラ:飲み会
	KSTR:(K++) = 「蜂蜜酒……じゃないのね、これ」
ELSEIF CFLAG:対象キャラ:睡眠
	IF CFLAG:対象キャラ:体力限界
		KSTR:(K++) = 「すぅ……すぅ…………」
	ELSEIF TALENT:対象キャラ:淫乱
		KSTR:(K++) = 「んん……あなた……すぅ……」
	ELSE
		KSTR:(K++) = 「すぅ……すぅ……」
	ENDIF
ELSEIF CFLAG:対象キャラ:デート
	KSTR:(K++) = 「お散歩、楽しいわ！」
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	KSTR:(K++) = 「一緒に遊ぶの、嬉しい！」
ELSEIF CFLAG:対象キャラ:同行
	KSTR:(K++) = 「あたしもついていくわ」
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	KSTR:(K++) = 「しーっ……だよ……？」
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	KSTR:(K++) = 「あれ……どこにいるの？」
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	KSTR:(K++) = 「ないしょの遊び……ふふ」
ELSEIF TALENT:対象キャラ:妊娠
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「赤ちゃんがぽこぽこしてるわ」
		CASE 1
			KSTR:(K++) = 「あたしのおなか、丸いでしょ？」
		CASEELSE
			KSTR:(K++) = 「この子に何て名前つけようかしら」
	ENDSELECT
ENDIF
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度)
	CASE 0
		;友情度
		SELECTCASE CFLAG:対象キャラ:友情度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「あたしの一番の友達よ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「あなたとお話しするの、楽しいわ」
			CASEELSE
				KSTR:(K++) = 「あたし、ゲルダよ。よろしくね？」
		ENDSELECT
	CASE 1
		;信頼度
		SELECTCASE CFLAG:対象キャラ:信頼度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「あなたのことを信じてるわ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「困ったことがあったら、あなたに聞くわ」
			CASEELSE
				KSTR:(K++) = 「ここのこと、まだよくわからないの」
		ENDSELECT
	CASE 2
		;恋心度
		SELECTCASE CFLAG:対象キャラ:恋心度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「あなたのことが好き……ずっとそばにいたいわ」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「あなたを見てると、胸がきゅってなるの」
			CASEELSE
				KSTR:(K++) = 「あなたのこと……なんだか、気になるの」
		ENDSELECT
	CASE 3
		;性愛度
		SELECTCASE CFLAG:対象キャラ:性愛度
			CASE IS >= 経験値テーブル:(関係閾値:4)
				KSTR:(K++) = 「あなたに触れられると……体が熱くなるの」
			CASE IS >= 経験値テーブル:(関係閾値:2)
				KSTR:(K++) = 「体が……あなたを覚えちゃったみたい」
			CASEELSE
				KSTR:(K++) = 「あなたに触られると……体がぴくってなるの」
		ENDSELECT
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)

;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「あたし、ゲルダよ。第23集落の──えっと、今はここの子ね。よろしくね？」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「あなたのこと、少しずつわかってきたわ。ふふ、面白い人ね」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「あなたとお話しするの、楽しいわ。集落にはいなかったタイプの人なの」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「あなたがいると安心するの。集落のラウラみたいな……ううん、ちょっと違うかな」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「あたしの一番の友達よ。集落の外にも友達ができるなんて、思わなかったわ」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「あなたがいなかったら、あたしはきっとずっと一人ぼっちだったわ。ありがとう──あなたに出会えて、本当によかった」
ENDSELECT

CALL PRINT_STATEコメント表示(対象キャラ)

;--------------------------------------------------
;ステータス画面一言口上_信頼
;--------------------------------------------------
@口上_ステータス画面_信頼コメント_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:信頼度
	CASE IS == 0
		KSTR:(K++) = 「ここのこと、まだよくわからないの。でも、あなたが教えてくれるのよね？」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		KSTR:(K++) = 「あなたが言うなら、きっと大丈夫よね。だってこの島を任されてる人なんだもの」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		KSTR:(K++) = 「困ったことがあったら、あなたに聞くわ。だっていつもちゃんと答えてくれるんだもの」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		KSTR:(K++) = 「あたし、あなたのことを信じてるわ。神さまの言いつけよりも──あなたの言葉の方がずっと温かいの」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		KSTR:(K++) = 「あたし、もう迷わないわ。だってあなたがそばにいてくれるんだもの。御使いがいなくても、ヴァルハラに行けなくても──怖くない」
	CASEELSE
		KSTR:(K++) = 「ねえ、あたしね、自分で考えることを覚えたの。それってとっても素敵なことなのよ。あなたが教えてくれたの──言いつけじゃなくて、自分の気持ちで動いていいんだって」
ENDSELECT

CALL PRINT_STATEコメント表示(対象キャラ)

;--------------------------------------------------
;ステータス画面一言口上_恋心
;--------------------------------------------------
@口上_ステータス画面_恋心コメント_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:恋心度
	CASE IS == 0
		KSTR:(K++) = 「あなたのこと……なんだか、気になるの。へんなの」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		KSTR:(K++) = 「あなたを見てると、胸がきゅってなるの。これって……なんだろう？」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		KSTR:(K++) = 「あなたが他の人とお話ししてると……もやもやするの。変よね、あたし」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		KSTR:(K++) = 「あのね……あたし、あなたのことが好き。集落の昔話に出てくるのとは違うかもしれないけど──好きなのよ」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		KSTR:(K++) = 「集落では結婚って概念がなかったの。でもね、あなたのことを想うと……ずっとそばにいたいって思うの。これが結婚なのかしら」
	CASEELSE
		KSTR:(K++) = 「あたし、あなたに花束を渡したいわ。集落では定めの日に渡すものだったけど──あたしは、一緒に生きるために渡すの」
ENDSELECT

CALL PRINT_STATEコメント表示(対象キャラ)

;--------------------------------------------------
;ステータス画面一言口上_性愛
;--------------------------------------------------
@口上_ステータス画面_性愛コメント_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:性愛度
	CASE IS == 0
		KSTR:(K++) = 「あなたに触られると……体がぴくってなるの。なんでかしら」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		KSTR:(K++) = 「あなたに撫でてもらうと、気持ちいいの……もっとしてほしいなって思っちゃう」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		KSTR:(K++) = 「体が……あなたを覚えちゃったみたい。触ってもらえないと……寂しいの」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		KSTR:(K++) = 「あたしの体、あなたのためにあるの。ね、いっぱい触って……教えて……_H_」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		KSTR:(K++) = 「あなたに抱かれるのが一番幸せ……体も心も、ぜんぶあなたに溶けちゃいそう……_H_」
	CASEELSE
		KSTR:(K++) = 「あたしの体、もうあなたなしじゃダメなの……おまんこが、あなたのこと呼んでるの……_H_」
ENDSELECT

CALL PRINT_STATEコメント表示(対象キャラ, 1)

;--------------------------------------------------
;ステータス画面一言口上_固有要素（ふれあい度）
;--------------------------------------------------
@口上_ステータス画面_キャラ固有好感度要素コメント_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE CFLAG:対象キャラ:キャラ固有好感度
	CASE IS == 0
		KSTR:(K++) = 「……」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		KSTR:(K++) = 「あなたのこと、少しだけ知ったわ」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		KSTR:(K++) = 「あなたと過ごす時間、あたしの宝物よ」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		KSTR:(K++) = 「あなたとのふれあい──集落には無かった温もりだわ」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		KSTR:(K++) = 「あなたに出会えたこと、ラウラに自慢したいの」
	CASEELSE
		KSTR:(K++) = 「ラウラ、聞いて。あたしね、この島で一番大切な人を見つけたのよ」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ, 1)

;--------------------------------------------------
;ステータス画面一言口上_恋慕
;--------------------------------------------------
@口上_ステータス画面_恋慕コメント_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
PRINTL 　
SELECTCASE CFLAG:対象キャラ:恋慕レベル
	CASE IS == 0
		KSTR:(K++) = 「あなたのこと……まだよくわからないの」
	CASE IS <= 関係閾値:1
		KSTR:(K++) = 「あなたのこと……気になるの」
	CASE IS <= 関係閾値:2
		KSTR:(K++) = 「あなたを見てると……胸がぽかぽかするの」
	CASE IS <= 関係閾値:3
		KSTR:(K++) = 「好き。好きよ。もう隠さないわ」
	CASE IS <= 関係閾値:4
		KSTR:(K++) = 「あたしの花束は、あなたのためのものよ」
	CASEELSE
		KSTR:(K++) = 「あなたと一緒に歳を取れるなんて──夢みたい」
ENDSELECT
CALL PRINT_STATEコメント表示(対象キャラ, 1)

;--------------------------------------------------
;キャラ解説
;--------------------------------------------------
@口上_ステータス画面_キャラ解説_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = 【ゲルダ】
PRINTL
KSTR:(K++) = 北欧異聞帯・第23集落出身の少女。
PRINTL
KSTR:(K++) = 異聞帯が消滅する間際、言いつけを破ってひとり外に飛び出したところを春風に浚われ、この島の砂浜に漂着した。
PRINTL
KSTR:(K++) = 明るく好奇心旺盛で、花と料理が得意。パン焼きと魚のスープが自慢。

IF 特定状況口上用フラグ:対象キャラ:13 >= 1
	PRINTL
	PRINTL
	KSTR:(K++) = 集落では25歳が人生の終わりだったため、「お年寄り」や「結婚」といった概念を知らずに育った。
	PRINTL
	KSTR:(K++) = この島での暮らしを通じて、集落にはなかった「時間の続き」を少しずつ学んでいる。
ENDIF

IF 特定状況口上用フラグ:対象キャラ:13 >= 2
	PRINTL
	PRINTL
	KSTR:(K++) = 口癖は「せーの……ぴょーん！」。集落の近くに棲むフォウという動物の跳ねる仕草を真似た遊び。
	PRINTL
	KSTR:(K++) = あの日、跳び上がった瞬間に風に浚われた──だから今は、跳んでも地面に足が着くことを、ひとつずつ確かめている。
ENDIF

IF 特定状況口上用フラグ:対象キャラ:13 >= 3
	PRINTL
	PRINTL
	KSTR:(K++) = 「定めの日」と「花束」──集落では大人が送り出される日に、子どもたちが育てた花を贈る風習があった。
	PRINTL
	KSTR:(K++) = ゲルダにとって花を育てることは、誰かを愛する唯一の方法だった。その意味は、この島で少しずつ変わり始めている。
ENDIF

CALL PRINT_STATEコメント表示(対象キャラ)


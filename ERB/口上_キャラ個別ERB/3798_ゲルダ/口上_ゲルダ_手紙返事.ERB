@KOJO_COM_3798_手紙返事(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF TALENT:対象キャラ:淫乱
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「昨日の夜のこと、まだ体が覚えてるの。朝起きたら太腿がべたべたで、シーツにシミがついてたわ。」
			KSTR:(K++) = 「あたし、もう元には戻れないのかもしれない。でもね、戻りたくないの。」
			KSTR:(K++) = 「今夜も来てね。ゲルダより」
		CASE 1
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「お手紙を書いてたら、あなたのことを思い出して、おなかの奥がきゅうってなっちゃった。」
			KSTR:(K++) = 「お花に水をあげるみたいに、あたしにも水をあげてほしいの。……意味、わかるわよね？」
			KSTR:(K++) = 「待ってるわ。ゲルダ」
		CASEELSE
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「今日、お風呂で自分の体を洗ってたら、あなたに触られたところがぜんぶ反応しちゃった。」
			KSTR:(K++) = 「あたしの体、もうあなた専用になってるみたい。……えへへ。」
			KSTR:(K++) = 「大好きよ。体も心も。ゲルダ」
	ENDSELECT
ELSEIF TALENT:対象キャラ:恋慕
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「今日もお花が綺麗に咲きました。あなたに一番に見せたいって思ったの。」
			KSTR:(K++) = 「集落では花束は別れのためのものだったけど、ここでは、会うためのお花を育ててるわ。」
			KSTR:(K++) = 「大好きです。ゲルダより」
		CASE 1
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「集落ではお手紙なんて書いたことなかったけど、あなたに伝えたい気持ちはたくさんあるの。」
			KSTR:(K++) = 「パンみたいにうまく形にできないけど……焼きたてみたいに、あったかい気持ちだけは伝わったらいいな。」
			KSTR:(K++) = 「今度、パンと一緒に届けるわね。ゲルダ」
		CASEELSE
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「夜、お星さまを見ていたら、あなたのことを考えていました。」
			KSTR:(K++) = 「星の光みたいに、あたしの胸もぽかぽかしています。」
			KSTR:(K++) = 「あしたの朝、おはようって言えるのが楽しみです。ゲルダ」
	ENDSELECT
ELSE
	SELECTCASE RAND:3
		CASE 0
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「今日は新しいパンの焼き方を覚えました。島のフルーツを練り込んだの。」
			KSTR:(K++) = 「集落のパンとは全然違う味になったわ。今度食べてください。ゲルダ」
		CASE 1
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「島の南側に綺麗なお花畑を見つけました。いつか一緒に行きましょう！」
			KSTR:(K++) = 「あたし、集落の花も南国の花も、ぜんぶ好きです。ゲルダ」
		CASEELSE
			KSTR:(K++) = 「あなたへ。」
			KSTR:(K++) = 「今日、海で足をぱちゃぱちゃさせてたら、お魚がぴょんって跳ねたの。」
			KSTR:(K++) = 「あたしもぴょーんって跳ねてみたわ。……砂の上って、跳ねるとふわふわするのね。ゲルダ」
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)


;--------------------------------------------------
;固有子供命名設定
;--------------------------------------------------
@固有子供命名設定_3798(対象キャラ, 子供性別, 子供順番, 案出し回数)
#DIM 対象キャラ
#DIM 子供性別
#DIM 子供順番
#DIM 案出し回数
VARSET RESULTS

;北欧風の名前
IF 子供性別 == 1
	;女の子
	SELECTCASE 案出し回数 % 5
		CASE 0
			RESULTS = ラウラ
		CASE 1
			RESULTS = フレイヤ
		CASE 2
			RESULTS = シグリ
		CASE 3
			RESULTS = アストリッド
		CASE 4
			RESULTS = リーサ
	ENDSELECT
ELSE
	;男の子
	SELECTCASE 案出し回数 % 5
		CASE 0
			RESULTS = エーリク
		CASE 1
			RESULTS = オーラヴ
		CASE 2
			RESULTS = レイフ
		CASE 3
			RESULTS = トール
		CASE 4
			RESULTS = フィン
	ENDSELECT
ENDIF


;--------------------------------------------------
;初期パラメータ変更
;--------------------------------------------------
@口上側初期パラメータ変更_3798
LOCAL = GETCHARA(3798)

;キャラクターが自分を指す際の呼び方
SIF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = あたし

;キャラクターがあなたを指す際の呼び方
SIF CSTR:LOCAL:二人称 == ""
	CSTR:LOCAL:二人称 = あなた

;キャラクターが固有に持つ独自の好感度要素の名前
CSTR:LOCAL:キャラ固有好感度要素 = ふれあい度

;画像フォルダ指定
CSTR:LOCAL:画像フォルダ = 3798ゲルダ

;身長設定（設定資料より推定）
;集落の子どもの中では大人に近い年齢だが、外の世界基準では小柄
BASE:LOCAL:身長 = 140

;フレーバー素質
CSTR:LOCAL:フレーバー素質 = 集落の花守り

;表示奥義設定
CSTR:LOCAL:表示奥義設定 = 花束をあなたに

;陥落奥義設定
CSTR:LOCAL:陥落奥義設定 = 二度目の春風

;--------------------------------------------------
;ロード時パラメータ変更
;--------------------------------------------------
@口上側LOADENDパラメータ変更_3798
LOCAL = GETCHARA(3798)

IF CSTR:LOCAL:一人称 == ""
	CSTR:LOCAL:一人称 = %CSVCSTR(NO:LOCAL, GETNUM(CSTR, "一人称"))%
ENDIF
IF CSTR:LOCAL:二人称 == ""
	CSTR:LOCAL:二人称 = %CSVCSTR(NO:LOCAL, GETNUM(CSTR, "二人称"))%
ENDIF
IF CSTR:LOCAL:キャラ固有好感度要素 == ""
	CSTR:LOCAL:キャラ固有好感度要素 = ふれあい度
ENDIF

;画像フォルダ指定

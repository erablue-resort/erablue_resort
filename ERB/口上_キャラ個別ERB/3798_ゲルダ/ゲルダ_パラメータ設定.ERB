;--------------------------------------------------
;固有好感度設定
;--------------------------------------------------
@キャラ固有好感度関係名_3798(ARG)
SELECTCASE ARG
	CASE IS == 関係閾値:0
		RESULTS = はじめまして
	CASE IS <= 関係閾値:1
		RESULTS = 島のひと
	CASE IS <= 関係閾値:2
		RESULTS = 大切なひと
	CASE IS <= 関係閾値:3
		RESULTS = ぜんぶ教えて
	CASE IS <= 関係閾値:4
		RESULTS = ずっと一緒
	CASE IS <= 関係閾値:5
		RESULTS = あたしの世界
ENDSELECT
RETURN


				PRINTL
				KSTR:(K++) = 「よしよし……えへへ、あなたの髪、さらさらね……」
				PRINTL
				KSTR:(K++) = 撫でるうちに、自分の方がどきどきしてきたらしい。頬が染まって、太腿がもじもじと動いた。
		ENDSELECT
	ELSE
		SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = ゲルダが精一杯背伸びをして、%CALLNAME:MASTER%の頭をぽんぽんと撫でた。
				PRINTL

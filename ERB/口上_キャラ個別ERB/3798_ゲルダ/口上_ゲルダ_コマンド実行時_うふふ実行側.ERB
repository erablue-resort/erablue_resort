;COM52_パイズリ → 体格的に困難
;--------------------------------------------------
@KOJO_COMPLAYER_3798_52(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;ゲルダは胸が小さいので基本的に不可能だが、一応ある
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE IS < 0
		KSTR:(K++) = 「む、むり……挟めないわ……あたし、ぜんぜん胸ないもの……」
		PRINTL
		KSTR:(K++) = ゲルダが悲しそうに自分の薄い胸を見下ろした。
	CASEELSE
		IF TALENT:対象キャラ:淫乱
			KSTR:(K++) = 「あたしの胸じゃ……挟めないけど……こうして寄せると……ちょっとだけ……_H_」
			PRINTL
			KSTR:(K++) = 両手で懸命に薄い胸を寄せるが、とてもペニスを包めるほどではない。ぷにっと押しつぶされた小さな膨らみの間に亀頭がちょこんと顔を出す。
			PRINTL
			KSTR:(K++) = 「えへへ……ごめんね、全然挟めない……でもね、乳首が当たると……すごくびりびりする……_H_」
			PRINTL
			KSTR:(K++) = 乳首にペニスが擦れるたびに、ゲルダの体がぴくぴくと震えた。──胸の大きさはなくても、感度で補っているらしい。
		ELSE
			KSTR:(K++) = 「えっと……こう……？　あたし、これじゃ全然挟めないわね……」
			PRINTL
			KSTR:(K++) = 一生懸命に胸を寄せるが、成果は芳しくない。ペニスが胸の上をすべすべ滑るだけだった。
			PRINTL
			KSTR:(K++) = 「ごめんなさい……もっと大きくなったらできるのかしら……」
		ENDIF
ENDSELECT


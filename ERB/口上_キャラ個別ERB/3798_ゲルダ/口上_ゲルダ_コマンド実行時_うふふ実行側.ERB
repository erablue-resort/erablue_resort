@KOJO_COMPLAYER_3798_50(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE IS < 0
		KSTR:(K++) = 「んぐっ……ごめんなさい……歯が当たっちゃった……？」
		PRINTL
		KSTR:(K++) = 慌てて口を離すゲルダ。%CALLNAME:MASTER%の顔色をおそるおそる窺っている。
		PRINTL
		KSTR:(K++) = 「あたし、まだ上手にできないの……練習させてね……？」
	CASEELSE
		IF STRFIND(コマンド初回フラグ:対象キャラ:0, "@-50-") < 0
			KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の下半身をまじまじと見つめた。
			PRINTL
			KSTR:(K++) = 「これ……口に入れるの……？　おっきいわ……あたしの口に入るのかしら……」
			PRINTL
			KSTR:(K++) = おそるおそる先端に唇を近づけて、ちゅっと吸った。ぴくりと跳ねるペニスに目を丸くする。
			PRINTL
			KSTR:(K++) = 「あっ……動いた。生きてるみたい……味は……しょっぱい……？　海の水と……ちょっと似てる……」
			PRINTL
			KSTR:(K++) = 恐る恐る唇で亀頭を包み込んで──ちゅぱ、ちゅぱと小さな音を立てた。
			PRINTL
			KSTR:(K++) = 「んむ……んちゅ……これで……いい……？　気持ちいい……？」
		ELSE
			IF TALENT:対象キャラ:妊娠
				IF TALENT:対象キャラ:淫乱
					SELECTCASE RAND:2
						CASE 0
							KSTR:(K++) = 「おなか大きくなっちゃったから……下で動くのは難しいの _H_」
							PRINTL
							KSTR:(K++) = 「でもお口なら、いくらでもしてあげるわ……んっ……ちゅぷ…… _H_」
							PRINTL
							KSTR:(K++) = 膨らんだおなかを庇いながら、ゲルダが%CALLNAME:MASTER%の股間に顔を埋めた。
							KSTR:(K++) = むわっと広がる匂いに、とろんと瞳が蕩けていく。
							PRINTL
							KSTR:(K++) = 「んぐ……じゅるっ……赤ちゃんにも、お父さんの味を教えてあげてるの……えへへ _H_」
						CASEELSE
							KSTR:(K++) = 「あたしのおくち……妊娠してからもっと敏感になったみたい…… _H_」
							PRINTL
							KSTR:(K++) = ぺろりと亀頭を舌で包み込むと、ゲルダの唾液が泡立って泡がぷくぷくと溢れた。
							PRINTL
							KSTR:(K++) = 「んちゅっ……れろ……おちんちんの匂い嗅いだら……おまたもじゅんってなっちゃう……赤ちゃんいるのに…… _H_」
					ENDSELECT
				ELSE
					KSTR:(K++) = 「あたし……おなか大きくなっちゃったけど……お口でなら……」
					PRINTL
					KSTR:(K++) = おなかを支えながら、ゲルダが%CALLNAME:MASTER%の前にそっとしゃがんだ。
					KSTR:(K++) = おずおずと先端に唇を近づけて、ちゅっと吸った。
					PRINTL
					KSTR:(K++) = 「ん……ちゅぷ……これなら、赤ちゃんにも無理させないわ」
				ENDIF
			ELSEIF TALENT:対象キャラ:淫乱
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「んっ……ちゅる……じゅるるっ……_H_」
						PRINTL
						KSTR:(K++) = ゲルダが%CALLNAME:MASTER%のペニスを頬張った。小さな口がいっぱいに広がり、唾液が溢れて顎を伝う。
						PRINTL
						KSTR:(K++) = 「はぁ……おちんちん……おっきくなってきた……あたしの口の中で……膨らんでる……_H_」
						PRINTL
						KSTR:(K++) = 舌を使って亀頭の裏筋をちろちろと舐め上げながら、ちゅぱちゅぱと吸い付く。口の端からたらりと唾液が零れた。
						PRINTL
						KSTR:(K++) = 「ねえ……このまま口の中に出して……？　あなたの精液……飲みたい……_H_」
					CASE 1
						KSTR:(K++) = 「ふぁ……先っぽ……おしっこの穴……舌でくるくるすると……びくってするの……知ってるよ……_H_」
						PRINTL
						KSTR:(K++) = 細い指で陰茎をくるりと握り、先端の尿道口を舌先でちろちろと舐め回す。先走りの雫がとろりと舌の上に広がった。
						PRINTL
						KSTR:(K++) = 「んっ……お汁出てきた……透明で……すこし甘い……_H_」
						PRINTL
						KSTR:(K++) = そのまま口を大きく開けて、ずるっと根元まで咥え込んだ。喉の奥がきゅっと締まって亀頭を包む。
					CASEELSE
						KSTR:(K++) = 「あたしのお口……おちんちんの形に慣れちゃったみたい……すっぽり入るの……_H_」
						PRINTL
						KSTR:(K++) = にこにこと笑いながら──ぱくん、と根元まで飲み込んだ。金色の頭がゆっくりと上下する。
						PRINTL
						KSTR:(K++) = 「んぐ……んぐ……じゅるっ……奥に当たると……苦しいけど……それもすき……_H_」
				ENDSELECT
			ELSEIF TALENT:対象キャラ:恋慕
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「あたし……上手にできるようになった……？」
						PRINTL
						KSTR:(K++) = 一生懸命に舌を動かしながら、上目遣いで%CALLNAME:MASTER%を見上げる。ちゅぱ、ちゅぱと健気な音が響いた。
						PRINTL
						KSTR:(K++) = 「んちゅ……気持ちよくなって……あなたが喜んでくれたら……あたしも嬉しい……」
					CASEELSE
						KSTR:(K++) = 「んっ……ちゅっ……」
						PRINTL
						KSTR:(K++) = ゲルダが亀頭にキスをするように、ちゅっちゅっと唇を押し当てる。唾液でてらてらと光るペニスを、両手でそっと包み込んだ。
						PRINTL
						KSTR:(K++) = 「あなたのここ……あったかい。心臓の音が……どくんどくんって伝わってくるわ……」
				ENDSELECT
			ELSE
				KSTR:(K++) = 「んっ……これで……いいの……？」
				PRINTL
				KSTR:(K++) = ぎこちなく口を動かすゲルダ。頬がぱんぱんに膨らんで、目尻に涙が浮かんでいる。
				PRINTL
				KSTR:(K++) = 「んぐ……おっきい……口いっぱいになっちゃう……」
			ENDIF
		ENDIF
ENDSELECT


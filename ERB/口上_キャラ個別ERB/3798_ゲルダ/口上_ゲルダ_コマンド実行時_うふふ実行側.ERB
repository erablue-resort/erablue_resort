@KOJO_COMPLAYER_3798_51(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE IS < 0
		KSTR:(K++) = 「あっ……ごめんなさい、強すぎた……？」
		PRINTL
		KSTR:(K++) = 力加減がわからず、ゲルダがおろおろしている。
	CASEELSE
		IF STRFIND(コマンド初回フラグ:対象キャラ:0, "@-51-") < 0
			KSTR:(K++) = 「これを……手で握るの……？」
			PRINTL
			KSTR:(K++) = 細い指がおそるおそるペニスを包んだ。指先では回りきらない太さに、ゲルダが目を丸くする。
			PRINTL
			KSTR:(K++) = 「あったかい……どくどくって脈打ってる……生きてるみたい……」
			PRINTL
			KSTR:(K++) = 「あたし、パンの生地をこねるのは得意なの。これも……同じように……？」
			PRINTL
			KSTR:(K++) = ゆっくりと上下に動かし始めた。──パンこねとは根本的に違うのだが、妙に丁寧な手つきだった。
		ELSE
			IF TALENT:対象キャラ:妊娠
				IF TALENT:対象キャラ:淫乱
					KSTR:(K++) = 「おなか大きくて……体がうまく動かないの……でもお手てなら _H_」
					PRINTL
					KSTR:(K++) = 膨らんだおなかの横からペニスに手を伸ばして、ぎゅっと握った。
					KSTR:(K++) = 妊娠で体温が上がったゲルダの手のひらが、いつもよりあつい。
					PRINTL
					KSTR:(K++) = 「あたしの手……あったかいでしょ？　赤ちゃんのおかげで体があつくなってるの _H_」
					KSTR:(K++) = 「このあったかい手で……たくさん搾ってあげるわ _H_」
				ELSE
					KSTR:(K++) = 「あたし……おなかが大きくなってきたから、うまく体を動かせないの」
					PRINTL
					KSTR:(K++) = 「でもね、お手てなら……いくらでも触れるわ」
					PRINTL
					KSTR:(K++) = ゲルダが座ったままペニスをそっと握った。おなかの横から手を伸ばす体勢が少し窮屈そうだったが、指先は丁寧に動いている。
				ENDIF
			ELSEIF TALENT:対象キャラ:淫乱
				SELECTCASE RAND:2
					CASE 0
						KSTR:(K++) = 「えへへ……先っぽから……お汁出てきた……_H_」
						PRINTL
						KSTR:(K++) = 指の腹で亀頭をくりくりと撫で回しながら、先走り液を指に絡めてぬるぬると扱く。
						PRINTL
						KSTR:(K++) = 「あなたのおちんちん……あたしの手で……びくびくしてる……もっとこすって……いっぱい出す……？　_H_」
					CASEELSE
						KSTR:(K++) = 「ねえ……両手で包んでいい……？　ぎゅーって……_H_」
						PRINTL
						KSTR:(K++) = 両手でペニスを包み込んで、くるくると捻るように扱き上げる。指の間から先走りがとろりと零れた。
						PRINTL
						KSTR:(K++) = 「んふふ……パンの生地より……やわらかくて……あったかくて……ずっと触っていたい……_H_」
				ENDSELECT
			ELSEIF TALENT:対象キャラ:恋慕
				KSTR:(K++) = 「んっ……こう……？　気持ちいい……？」
				PRINTL
				KSTR:(K++) = ゲルダが一生懸命に手を動かしている。%CALLNAME:MASTER%の表情を窺いながら、強さや速さを調整しようとしていた。
				PRINTL
				KSTR:(K++) = 「あなたが気持ちよさそうな顔してると……あたしも嬉しくなるの。変ね……」
			ELSE
				KSTR:(K++) = 「こ、こう……？」
				PRINTL
				KSTR:(K++) = ぎこちなく手を動かすゲルダ。頬を赤くしながらも、言われたとおりに懸命に動かしている。
			ENDIF
		ENDIF
ENDSELECT


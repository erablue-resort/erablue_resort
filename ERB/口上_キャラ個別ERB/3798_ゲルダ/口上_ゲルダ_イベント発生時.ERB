;****************************************
;ゲルダ（FGO 2部2章／北欧異聞帯・第23集落）Chara3798 イベント発生時
;****************************************

;--------------------------------------------------
;挨拶時
;--------------------------------------------------
@KOJO_EVENT_挨拶_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

SELECTCASE TIME
	CASE 5*60 TO 11*60
		LOCALS = おはよう
	CASE 11*60 TO 18*60
		LOCALS = こんにちは
	CASEELSE
		LOCALS = こんばんは
ENDSELECT

IF TALENT:対象キャラ:恋慕
	IF TALENT:対象キャラ:淫乱
		IF TALENT:対象キャラ:妊娠
			KSTR:(K++) = ゲルダが膨らんだおなかをそっと撫でながら、%CALLNAME:MASTER%のもとへ歩いてきた。
			PRINTL
			KSTR:(K++) = 「%LOCALS%……えへへ、赤ちゃんがね、今日もぽこぽこ動いてるの」
			PRINTL
			KSTR:(K++) = 「あのね、集落じゃ赤ちゃんのことなんて何も教わらなかったわ。……でも、あたしの中に誰かがいるって、とっても不思議で……とっても嬉しいの」
			PRINTL
			KSTR:(K++) = %CALLNAME:MASTER%の手を取って、自分のおなかに当てる。薄い服の下で、小さな命がぴくりと動いた。
			PRINTL
			KSTR:(K++) = 「ふふ……でもね……最近あたし、体がへんなの……ここがね、じんじんして……抱きしめてほしくなっちゃうわ……_H_」
		ELSE
		SELECTCASE TIME
			CASE 5*60 TO 11*60
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「おはよう……えへへ、今日もいいお天気ね」
						PRINTL
						KSTR:(K++) = ゲルダが小走りに駆け寄ってきた。金髪が朝日を浴びてきらきらと輝く。
						PRINTL
						KSTR:(K++) = 「あのね……昨日の夜、あたし全然眠れなかったの……体がぽかぽかして……あなたのこと考えちゃって……_H_」
						PRINTL
						KSTR:(K++) = 頬を染めて、もじもじとスカートの裾をつまむ。集落では知ることのなかった感覚に、ゲルダはまだ名前をつけられないでいた。
					CASE 1
						KSTR:(K++) = 「あっ……おはよう。えへへ、見つけた……」
						PRINTL
						KSTR:(K++) = 嬉しそうに%CALLNAME:MASTER%の腕にしがみついた。南国の朝は暑いのに、ぴったりと体をくっつけてくる。
						PRINTL
						KSTR:(K++) = 「あのね……朝起きたら、下着が濡れてたの……なんでかしら……あなたの夢を見たからかな……_H_」
						PRINTL
						KSTR:(K++) = ──本人はまだ、それが何を意味するのか完全にはわかっていない。ただ、体が%CALLNAME:MASTER%を求めていることだけは理解しているようだった。
					CASEELSE
						KSTR:(K++) = 「おはよ……あなた、まだ寝ぼけてる？　あたしがぱっちり起こしてあげるわ！」
						PRINTL
						KSTR:(K++) = ぴょんと飛び上がって%CALLNAME:MASTER%の頬に唇を寄せた。──不意打ちのキス。
						PRINTL
						KSTR:(K++) = 「えへへ……集落ではこんなことしなかったけど……ここに来てから覚えたの……_H_」
						PRINTL
						KSTR:(K++) = 自分でやっておいて顔を真っ赤にしているゲルダ。だが尻尾があったら千切れんばかりに振っていただろう。
				ENDSELECT
			CASE 11*60 TO 18*60
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「あっ、見つけた！　ねえねえ、今日は何をするの？　あたしも一緒に行きたいわ」
						PRINTL
						KSTR:(K++) = ぱたぱたと駆け寄ってくるゲルダ。南国の日差しに汗ばんだ額が光っていた。
						PRINTL
						KSTR:(K++) = 「……だって、あなたのそばにいると……なんだか胸がどきどきして、すっごく気持ちいいんだもの……_H_」
					CASE 1
						KSTR:(K++) = 「えへへ……あのね、あたし、あなたが通る道を覚えちゃったの」
						PRINTL
						KSTR:(K++) = 花壇のそばでにこにこと待ち構えていたゲルダ。%CALLNAME:MASTER%の顔を見ると、ぱあっと笑顔が咲いた。
						PRINTL
						KSTR:(K++) = 「お花に水をあげてたの……本当よ？　でもあなたが来るのを待ってたのも……本当なの……_H_」
					CASEELSE
						KSTR:(K++) = 「あなた……ねえ、ちょっとだけ……手、繋いでもいい……？」
						PRINTL
						KSTR:(K++) = おずおずと手を差し出してきた。その指先は、かすかに震えている。
						PRINTL
						KSTR:(K++) = 「あたし……最近ね、あなたの手に触れると……お腹の奥がきゅうってなるの……変な病気じゃないわよね……？　……_H_」
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「こんばんは……今夜のお星さま、集落で見てた空より何倍も綺麗だわ……」
						PRINTL
						KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の隣に腰を下ろした。肩がそっと触れ合う。
						PRINTL
						KSTR:(K++) = 「あのね……夜になると、あなたのそばにいたくなるの……ひとりだと……体が寂しくなっちゃって……_H_」
					CASE 1
						KSTR:(K++) = 「あなた……まだ起きてる？　えへへ、よかった……」
						PRINTL
						KSTR:(K++) = 寝巻き姿のゲルダが、もじもじしながら部屋の前に立っていた。金色のまつ毛がふるふると揺れる。
						PRINTL
						KSTR:(K++) = 「あたし……一緒にいたいの……隣で寝るだけでいいから……でも、それだけじゃ済まないかも……_H_」
					CASEELSE
						KSTR:(K++) = 「あのね……お星さまに、お願いしたの」
						PRINTL
						KSTR:(K++) = 窓辺に立つゲルダが、夜空を見上げたまま呟いた。
						PRINTL
						KSTR:(K++) = 「あたしとあなたが……ずっと一緒にいられますようにって……集落では神さまにお祈りしてたけど……ここではお星さまでいいのよね？　……_H_」
				ENDSELECT
		ENDSELECT
		ENDIF
	ELSE
		;恋慕・非淫乱
		IF TALENT:対象キャラ:妊娠
			KSTR:(K++) = ゲルダが丸くなったおなかを両手で包むように支えて、ゆっくりと歩いてきた。
			PRINTL
			KSTR:(K++) = 「%LOCALS%……えへへ、今日もこの子が動いてるの」
			PRINTL
			KSTR:(K++) = 「ねえ……ここ、触ってみて。今、ぽこって……ほら」
			PRINTL
			KSTR:(K++) = %CALLNAME:MASTER%がおなかに手を当てると、布越しにとくん、と小さな蹴りが伝わった。
			KSTR:(K++) = ゲルダの青緑の瞳がうるうると潤む。
			PRINTL
			KSTR:(K++) = 「……あたし、この子のこと考えると、胸がいっぱいになるの」
			KSTR:(K++) = 「あなたとあたしの子ども……あたしが一番ほしかったもの」
		ELSE
		SELECTCASE TIME
			CASE 5*60 TO 11*60
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「おはよう！　ねえ、今日もいいお天気ね！　集落のお空とぜんぜん違うわ」
						PRINTL
						KSTR:(K++) = 金色の髪が朝日にきらめく。ゲルダが弾けるような笑顔で%CALLNAME:MASTER%のもとに駆け寄ってきた。
					CASE 1
						KSTR:(K++) = 「あっ……おはよう。えへへ……あなたの顔を見ると、今日もいい日になりそうだわ」
						PRINTL
						KSTR:(K++) = 恥ずかしそうに、でも嬉しそうに微笑むゲルダ。頬がほんのり薄桃色に染まっていた。
					CASEELSE
						KSTR:(K++) = 「おはよう！　あのね、今朝パンを焼いたの！　あなたにも食べてほしくて……」
						PRINTL
						KSTR:(K++) = 布に包んだ焼きたてのパンを差し出すゲルダ。ほんわりと小麦の香りが漂う。──集落で覚えた腕前は、島でもちゃんと役に立っていた。
				ENDSELECT
			CASE 11*60 TO 18*60
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「あっ、こんにちは！　ねえねえ、あたし今日すごいもの見つけたのよ」
						PRINTL
						KSTR:(K++) = 目をきらきらさせて話しかけてくるゲルダ。島での新しい発見を、真っ先に%CALLNAME:MASTER%に報告したいらしい。
					CASE 1
						KSTR:(K++) = 「えへへ……あなたを見つけると、なんだかほっとするわ」
						PRINTL
						KSTR:(K++) = 花壇のそばに座っていたゲルダが、ぱっと立ち上がった。スカートについた土をぱたぱたと払う。
					CASEELSE
						KSTR:(K++) = 「ねえ、今日は暑いわね……集落では考えられなかったわ。こんなに汗をかくなんて」
						PRINTL
						KSTR:(K++) = 額の汗を拭いながら、ゲルダはけれど楽しそうに笑った。暑さも、ゲルダにとっては新鮮な体験のひとつだった。
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「こんばんは……ねえ、お星さまがすごく綺麗よ。一緒に見ない？」
						PRINTL
						KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の袖をきゅっとつまんで、夜空を指差した。南国の星空は、北の集落で見ていたものとはまるで違っていた。
					CASE 1
						KSTR:(K++) = 「こんばんは。えへへ、今日一日楽しかったわ……あなたのおかげよ」
						PRINTL
						KSTR:(K++) = 一日の終わりに、ゲルダは%CALLNAME:MASTER%の顔を見て安堵の息をつく。誰かに「おかげ」と伝える習慣は、島に来てから身についたものだった。
					CASEELSE
						KSTR:(K++) = 「あのね……夜になると、たまに集落のことを思い出すの」
						PRINTL
						KSTR:(K++) = 窓の外を見つめるゲルダの横顔が、月明かりに照らされていた。
						PRINTL
						KSTR:(K++) = 「……でも、あなたがいるから寂しくないわ。ありがとう」
				ENDSELECT
		ENDSELECT
		ENDIF
	ENDIF
ELSE
	;非恋慕
	IF TALENT:対象キャラ:妊娠
		KSTR:(K++) = ゲルダがおなかを押さえながら、てくてくと%CALLNAME:MASTER%のもとへやってきた。
		PRINTL
		KSTR:(K++) = 「%LOCALS%。あのね、あたしのおなか……最近おっきくなってきたの」
		PRINTL
		KSTR:(K++) = 「集落では気づいたらこうなってたけど……あたしは理由を知ってるわ」
		KSTR:(K++) = 「あなたのおかげよ。……えへへ」
		PRINTL
		KSTR:(K++) = 恥ずかしそうに笑って、ゲルダは膨らんだおなかをそっと撫でた。
	ELSE
	SELECTCASE TIME
		CASE 5*60 TO 11*60
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「おはよう！　今日もお日さまがぽかぽかだわ。集落ではこんなに暖かい朝なんてなかったのよ」
					PRINTL
					KSTR:(K++) = ゲルダが両手を広げて、朝日を全身に浴びていた。まぶしそうに目を細めて、それでも嬉しそうに笑う。
				CASEELSE
					KSTR:(K++) = 「おはよう！　あのね、今朝は早起きしてパンを焼いたのよ。島の小麦粉って、集落のとちょっと違うの」
					PRINTL
					KSTR:(K++) = エプロンにまだ粉がついたまま。ゲルダは料理になると一段と目が輝いた。
			ENDSELECT
		CASE 11*60 TO 18*60
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「こんにちは！　ねえねえ、あそこにすごくきれいなお花が咲いてたの！　見に行かない？」
					PRINTL
					KSTR:(K++) = ゲルダが%CALLNAME:MASTER%の手を引っ張る。好奇心に火がつくと、じっとしていられない性分だった。
				CASEELSE
					KSTR:(K++) = 「あっ、こんにちは。暑いわねえ……でも、暑いのって嫌いじゃないわ。だって、お花がたくさん咲くんだもの」
					PRINTL
					KSTR:(K++) = 花壇の手入れをしていたゲルダが、土まみれの手を振った。北の集落では見られなかった南国の花々に、すっかり夢中らしい。
			ENDSELECT
		CASEELSE
			SELECTCASE RAND:2
				CASE 0
					KSTR:(K++) = 「こんばんは。ねえ、お星さまが見えるわ。集落じゃ雲ばっかりで、こんなに見えなかったの」
					PRINTL
					KSTR:(K++) = 夜空を見上げて、ゲルダは目をまんまるにした。南国の星座は、昔話で聞いたどの星座とも違う形をしていた。
				CASEELSE
					KSTR:(K++) = 「こんばんは。今日も一日おつかれさま。……あたし、ここでちゃんと暮らせてるかしら？」
					PRINTL
					KSTR:(K++) = 少しだけ不安そうに首を傾げるゲルダ。島の暮らしに馴染んでいるように見えて、ときどきこうして心配顔を見せることがあった。
			ENDSELECT
	ENDSELECT
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;初対面
;（導入キャライベント「春風の漂着者」で砂浜での出会い・島への歓迎は済んでいる）
;（ここはその翌日──島での暮らしが始まる場面）
;--------------------------------------------------
@KOJO_EVENT_初対面_3798(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

KSTR:(K++) = 朝。用意してもらった部屋のドアが、おずおずと開いた。
PRINTL
KSTR:(K++) = 「……おはよう。あたし、ちゃんと起きられたわ」
PRINTL
KSTR:(K++) = ゲルダが顔を出した。金色の髪が寝癖でぴょこんと跳ねている。
KSTR:(K++) = 昨日砂浜で泣きじゃくっていた少女は、一晩眠っただけで、もう前を向こうとしていた。
PRINTL
KSTR:(K++) = 「あのね……昨日はごめんなさい。泣いちゃったりして」
KSTR:(K++) = 「でも、朝起きたら……ちゃんと地面があったの。ベッドもあったし、天井もあったし」
KSTR:(K++) = 「風に浚われてなかった。あたし、ちゃんとここにいるのね」
PRINTL
KSTR:(K++) = きょろきょろと辺りを見回す。窓の外には、昨日と同じ青い海。
KSTR:(K++) = 昨日はただ圧倒されるだけだったそれが、今朝は少しだけ親しく見えた。
PRINTL
KSTR:(K++) = 「それと……ほら！」
PRINTL
KSTR:(K++) = ゲルダがぱっと両手を差し出した。
KSTR:(K++) = 皿の上に、こんがりと焼けた小さなパンが乗っている。
PRINTL
KSTR:(K++) = 「昨日、お手伝いするって約束したでしょう？」
KSTR:(K++) = 「だから早起きして、台所をお借りしたの。島の小麦粉は集落のとちょっと違ったけど……うまく焼けたと思うわ」
PRINTL
KSTR:(K++) = 得意げに胸を張って、それからすぐに不安そうに眉を下げた。
PRINTL
KSTR:(K++) = 「……おいしいかしら。食べてみて？」
PRINTL
KSTR:(K++) = %CALLNAME:MASTER%がパンを受け取ってかじると、ゲルダは食い入るように反応を見つめた。
KSTR:(K++) = 表面はかりっと香ばしく、中はふわりと柔らかい。──素朴だけれど、丁寧に作られたパンだった。
PRINTL
KSTR:(K++) = %CALLNAME:MASTER%が頷くと、ゲルダの顔がぱあっと輝いた。
PRINTL
KSTR:(K++) = 「よかった！　えへへ……あたし、この島でもちゃんとパンが焼けるのね」
PRINTL
KSTR:(K++) = 嬉しそうに両手をぎゅっと握りしめて、それから、はにかんだように笑った。
PRINTL
KSTR:(K++) = 「あたし、ゲルダ。第23集落の──ううん、もう集落はないのよね」
KSTR:(K++) = 「……この島のゲルダ。今日から、よろしくお願いします」
PRINTL
KSTR:(K++) = ぺこりと頭を下げる。金色の寝癖がぴょこんと揺れた。
KSTR:(K++) = ──春風が運んできた少女の、島での最初の朝。焼きたてのパンの匂いが、潮風に混じって漂っていた。

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;恋慕自覚
;--------------------------------------------------
